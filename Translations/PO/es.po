#. Text 000 of map 336. The name of the map.
#. German: "GASTHAUS GEMSTONE"
#: AllTexts/3Map_texts.amb/336/000.txt
msgctxt "AllTexts/3Map_texts.amb/336/000"
msgid "GEMSTONE INN"
msgstr "POSADA GEMSTONE"

#. Text 001 of map 336.
#. German: "~INK 30~ EINE HÜBSCHE ZWERGIN LÄCHELT EUCH AN:^ ~INK 31~ SEID GEGRÜßT, REISENDE! WENN IHR ERHOLUNG BENÖTIGT, KANN EUCH DAS GASTHAUS GEMSTONE ERSTKLASSIGE ZIMMER BIETEN. TRAGT EUCH BITTE BEIM EMPFANG DA DRÜBEN EIN."
#: AllTexts/3Map_texts.amb/336/001.txt
msgctxt "AllTexts/3Map_texts.amb/336/001"
msgid "~INK 30~ A PRETTY DWARF LADY SMILES AT YOU:^ ~INK 31~ WELCOME, TRAVELLERS! IF YOU NEED TO REST, YOU CAN RENT FIRST CLASS ROOMS AT THE GEMSTONE INN. PLEASE REGISTER OVER THERE AT RECEPTION."
msgstr "~INK 30~ UNA ENANA MUY GUAPA OS SONRÍE:^ ~INK 31~ ¡SALUDOS, VIAJEROS! SI NECESITÁIS DESCANSO, LA POSADA GEMSTONE OS OFRECE HABITACIONES DE PRIMERA. REGISTRAOS, POR FAVOR, EN LA RECEPCIÓN DE AHÍ AL LADO."

#. Text 002 of map 336.
#. German: "~INK 30~ DIE AUCH FÜR ZWERGENVERHÄLTNISSE STÄMMIG GEBAUTE FRAU DES GASTWIRTS SAGT:^ ~INK 31~ ICH HOFFE, DASS IHR EUCH BEI UNS WOHLFÜHLT!"
#: AllTexts/3Map_texts.amb/336/002.txt
msgctxt "AllTexts/3Map_texts.amb/336/002"
msgid "~INK 30~ THE WIFE OF THE LANDLORD, WELL-BUILT EVEN FOR A DWARF, SAYS:^ ~INK 31~ I HOPE YOU ENJOY YOUR STAY WITH US!"
msgstr "~INK 30~ LA ESPOSA DEL POSADERO, ROBUSTA INCLUSO PARA SER ENANA, DICE:^ ~INK 31~ ¡ESPERO QUE OS SINTÁIS A GUSTO CON NOSOTROS!"

#. Text 003 of map 336.
#. German: "~INK 30~ EIN VERBITTERT AUSSCHAUENDER ZWERG KNURRT:^ ~INK 31~ \"AH, DIE ARMEN NARREN, DIE ES UNS GLEICHGETAN HABEN! WILLKOMMEN AUF DEM KOMPOSTHAUFEN!\""
#: AllTexts/3Map_texts.amb/336/003.txt
msgctxt "AllTexts/3Map_texts.amb/336/003"
msgid "~INK 30~ A BITTER LOOKING DWARF GROWLS:^ ~INK 31~ \"OH, THE POOR FOOLS WHO HAVE DONE THE SAME AS WE! WELCOME TO THE COMPOST-HEAP!\""
msgstr "~INK 30~ UN ENANO DE ASPECTO AMARGADO GRUÑE:^ ~INK 31~ \"¡AH, LOS POBRES NECIOS QUE HAN HECHO LO MISMO QUE NOSOTROS! ¡BIENVENIDOS AL ESTERCOLERO!\""

#. Text 004 of map 336.
#. German: "~INK 30~ DER UNTERSETZTE, ROTNASIGE ZWERG SPRICHT MIT SCHWERER ZUNGE:^ ~INK 31~ \"DIESER UNGLICKSÜLIGE.. UNSELGLÜCKL.. UNGLÜCKSLL.., ACH, SSCHEISS! - MOND IS NUR IMM SUFF SSU ERTRAGEN!\""
#: AllTexts/3Map_texts.amb/336/004.txt
msgctxt "AllTexts/3Map_texts.amb/336/004"
msgid "~INK 30~ THE STOCKY RED-NOSED DWARF SPEAKS WITH A HEAVY TONGUE:^ ~INK 31~ \"THIS UNHIPP... UNHOPP... UNHAPP..., OH, DAMN MOON IS ONLY TOLERABLE WHEN IN A DRUNKEN STUPOR!\""
msgstr "~INK 30~ EL ENANO RECHONCHO DE NARIZ ROJA HABLA CON LA LENGUA PASTOSA:^ ~INK 31~ \"ESTA DESHGRA... DESHDI... DESHDISHA..., ¡AH, MIERDA! - ¡ESTA LUNA SHOLO SHE AGUANTA CON UNA BUENA TRANCA!\""

#. Text 005 of map 336.
#. German: "DER KLEINE SOHN DES WIRTS STARRT EUCH SPRACHLOS AN. OFFENBAR HAT ER NOCH NIE SO GROßE LEUTE GESEHEN."
#: AllTexts/3Map_texts.amb/336/005.txt
msgctxt "AllTexts/3Map_texts.amb/336/005"
msgid "THE LITTLE SON OF THE LANDLORD STARES AT YOU SPEECHLESSLY. APPARENTLY HE HAS NEVER SEEN SUCH GIGANTIC PEOPLE."
msgstr "EL HIJO PEQUEÑO DEL POSADERO OS MIRA SIN PALABRAS. POR LO VISTO, NUNCA HABÍA VISTO GENTE TAN GRANDE."

#. Text 006 of map 336.
#. German: "EURE NEUGIER FÖRDERT EINEN VORRAT AN DAUERBROT ZUTAGE."
#: AllTexts/3Map_texts.amb/336/006.txt
msgctxt "AllTexts/3Map_texts.amb/336/006"
msgid "YOUR CURIOSITY IS REWARDED WITH A STOCK OF RATIONS."
msgstr "VUESTRA CURIOSIDAD SE VE RECOMPENSADA CON UNA PROVISIÓN DE PAN DURADERO."

#. Text 007 of map 336.
#. German: "HIER SIND EINIGE VON DOREB'S BESITZTÜMERN AUFBEWAHRT."
#: AllTexts/3Map_texts.amb/336/007.txt
msgctxt "AllTexts/3Map_texts.amb/336/007"
msgid "SOME OF DOREB'S POSSESSIONS ARE STORED HERE."
msgstr "AQUÍ SE GUARDAN ALGUNAS PERTENENCIAS DE DOREB."

#. Text 009 of map 336.
#. German: "NICHTS BESONDERES."
#: AllTexts/3Map_texts.amb/336/009.txt
msgctxt "AllTexts/3Map_texts.amb/336/009"
msgid "NOTHING SPECIAL."
msgstr "NADA ESPECIAL."

#. Text 010 of map 336.
#. German: "WIE MAN ES IN EINER KNEIPE ERWARTEN KONNTE, ENTHÄLT DAS FASS BIER."
#: AllTexts/3Map_texts.amb/336/010.txt
msgctxt "AllTexts/3Map_texts.amb/336/010"
msgid "AS ONE MIGHT EXPECT IN A BAR, THE BARREL CONTAINS BEER."
msgstr "COMO CABÍA ESPERAR EN UNA TABERNA, EL BARRIL CONTIENE CERVEZA."

#. Text 000 of map 337. The name of the map.
#. German: "KIRE'S RESIDENZ"
#: AllTexts/3Map_texts.amb/337/000.txt
msgctxt "AllTexts/3Map_texts.amb/337/000"
msgid "KIRE'S RESIDENCE"
msgstr "RESIDENCIA DE KIRE"

#. Text 001 of map 337.
#. German: "VOR EUCH LIEGT EIN SAAL, IN DEM DIE PRACHT DES ALTEN ZWERGENREICHS NOCH EINMAL AUFZUBLÜHEN SCHEINT. DIE POLIERTEN STEINPLATTEN DES BODENS SCHILLERN IN ALLEN FARBEN, UND PRÄCHTIGE SÄULEN UND WANDBEHÄNGE ZIEREN DEN RAUM, IN DESSEN MITTE EIN IMPOSANTER THRON STEHT."
#: AllTexts/3Map_texts.amb/337/001.txt
msgctxt "AllTexts/3Map_texts.amb/337/001"
msgid "AHEAD OF YOU IS A HALL IN WHICH THE SPLENDOUR OF THE OLD DWARF KINGDOM APPEARS TO BE BLOSSOMING AGAIN. THE POLISHED STONE FLAGS OF THE FLOOR GLITTER IN MANY COLOURS AND SPLENDID COLUMNS AND WALL-COVERINGS DECORATE THE ROOM IN THE CENTRE OF WHICH STANDS AN IMPOSING THRONE."
msgstr "ANTE VOSOTROS SE ABRE UNA SALA EN LA QUE EL ESPLENDOR DEL ANTIGUO REINO ENANO PARECE FLORECER DE NUEVO. LAS LOSAS PULIDAS DEL SUELO RELUCEN CON TODOS LOS COLORES, Y MAGNÍFICAS COLUMNAS Y TAPICES ADORNAN LA ESTANCIA, EN CUYO CENTRO SE ALZA UN TRONO IMPONENTE."

#. Text 002 of map 337.
#. German: "~INK 30~ DIE UNTERSETZTE ZWERGENWACHE SAGT:^ ~INK 31~ \"PROVOZIERT KIRE NICHT! ER IST OFT ÜBEL GELAUNT.\""
#: AllTexts/3Map_texts.amb/337/002.txt
msgctxt "AllTexts/3Map_texts.amb/337/002"
msgid "~INK 30~ THE STUBBY DWARF GUARD SAYS:^ ~INK 31~ \"DO NOT PROVOKE KIRE! HE IS OFTEN IN A BAD MOOD.\""
msgstr "~INK 30~ EL ACHAPARRADO GUARDIA ENANO DICE:^ ~INK 31~ \"¡NO PROVOQUÉIS A KIRE! A MENUDO ESTÁ DE MAL HUMOR.\""

#. Text 003 of map 337.
#. German: "~INK 30~ EIN KRÄFTIGER ZWERG STEHT HIER WACHE. ER BRUMMT:^ ~INK 31~ \"ES IST UNS NICHT GESTATTET, ZU SPRECHEN.\""
#: AllTexts/3Map_texts.amb/337/003.txt
msgctxt "AllTexts/3Map_texts.amb/337/003"
msgid "~INK 30~ A STRONG DWARF IS ON GUARD HERE. HE GROWLS:^ ~INK 31~ \"WE ARE NOT ALLOWED TO SPEAK.\""
msgstr "~INK 30~ AQUÍ MONTA GUARDIA UN ENANO FORNIDO. REZONGA:^ ~INK 31~ \"NO SE NOS PERMITE HABLAR.\""

#. Text 004 of map 337.
#. German: "~INK 30~ EIN WÜRDIG DREINBLICKENDER ZWERG IN WALLENDEN GEWÄNDERN SPRICHT EUCH AN:^ ~INK 31~ \"WILLKOMMEN IN KIRE'S RESIDENZ! KIRE IST VON 9 BIS 21:30 UHR IM THRONSAAL ANZUTREFFEN.\"^ ~INK 30~ DANN BEUGT ER SICH ZU EUCH VOR UND FLÜSTERT:^ ~INK 31~ \"IM VERTRAUEN GESAGT, ICH WEISS AUCH NICHT, WIE ER ES DIE GANZE ZEIT DA AUSHÄLT. MEIN BRUDER ARND MEINT, ER SEI VIELLEICHT NICHT MEHR SO GANZ..., ABER ERZÄHLT DAS BITTE NICHT WEITER!\""
#: AllTexts/3Map_texts.amb/337/004.txt
msgctxt "AllTexts/3Map_texts.amb/337/004"
msgid "~INK 30~ A SERIOUS LOOKING DWARF IN VOLUMINOUS CLOTHES SPEAKS TO YOU:^ ~INK 31~ \"WELCOME TO KIRE'S RESIDENCE! KIRE IS IN THE THRONE ROOM FROM 9 AM TO 9.30 PM.\"^ ~INK 30~ THEN HE BOWS AND WHISPERS:^ ~INK 31~ \"IN CONFIDENCE, I DO NOT HOW HE CAN BEAR IT THERE THE WHOLE TIME. MY BROTHER ARND THINKS HE MAY NOT BE QUITE RIGHT IN THE HEAD ANY MORE ..., BUT PLEASE DON'T TELL ANYONE!\""
msgstr "~INK 30~ UN ENANO DE ASPECTO SOLEMNE, ENVUELTO EN AMPLIOS ROPAJES, SE DIRIGE A VOSOTROS:^ ~INK 31~ \"¡BIENVENIDOS A LA RESIDENCIA DE KIRE! A KIRE LO ENCONTRARÉIS EN LA SALA DEL TRONO DE 9 A 21:30 H.\"^ ~INK 30~ LUEGO SE INCLINA HACIA VOSOTROS Y SUSURRA:^ ~INK 31~ \"DICHO EN CONFIANZA, NO SÉ CÓMO AGUANTA AHÍ SENTADO TODO EL TIEMPO. MI HERMANO ARND CREE QUE QUIZÁ YA NO ESTÉ DEL TODO..., ¡PERO NO SE LO CONTÉIS A NADIE, OS LO RUEGO!\""

#. Text 005 of map 337.
#. German: "~INK 30~ EIN URALTER ZWERG HUMPELT HIER VOR SICH HIN. ER MEINT:^ ~INK 31~ \"VERFLUCHTES SCHICKSAL, DAS MICH MEINE LETZTEN TAGE AUF DIESEM MODRIGEN KOMPOSTHAUFEN VON EINER WELT VERBRINGEN LÄSST!\""
#: AllTexts/3Map_texts.amb/337/005.txt
msgctxt "AllTexts/3Map_texts.amb/337/005"
msgid "~INK 30~ AN ANCIENT DWARF IS MUMBLING TO HIMSELF. HE SAYS:^ ~INK 31~ \"WHAT AN AWFUL FATE, TO END MY DAYS ON THIS COMPOST-HEAP OF A WORLD!\""
msgstr "~INK 30~ UN ENANO VIEJÍSIMO CAMINA AQUÍ COJEANDO. COMENTA:^ ~INK 31~ \"¡MALDITO DESTINO, QUE ME OBLIGA A PASAR MIS ÚLTIMOS DÍAS EN ESTE ESTERCOLERO MOHOSO DE MUNDO!\""

#. Text 006 of map 337.
#. German: "~INK 30~ DIE STÄMMIGE ZWERGENFRAU MACHT EINEN RESOLUTEN EINDRUCK. SIE SCHEINT KIRE'S HAUSHALT VORZUSTEHEN. LÄCHELND SPRICHT SIE EUCH AN:^ ~INK 31~ \"SEID GEGRÜßT, REISENDE AUS DER HEIMAT! HABT IHR EUCH SCHON MIT KIRE UNTERHALTEN? ER SPRACH IN LETZTER ZEIT OFT VON EUCH.\""
#: AllTexts/3Map_texts.amb/337/006.txt
msgctxt "AllTexts/3Map_texts.amb/337/006"
msgid "~INK 30~ THE WELL-BUILT DWARF WOMAN APPEARS RESOLUTE. IT SEEMS SHE RUNS KIRE'S HOUSEHOLD. SMILING, SHE SPEAKS TO YOU:^ ~INK 31~ \"WELCOME, TRAVELLERS FROM OUR HOME! HAVE YOU ALREADY SPOKEN TO KIRE? HE OFTEN SPEAKS OF YOU.\""
msgstr "~INK 30~ LA ROBUSTA ENANA DA UNA IMPRESIÓN DE GRAN DETERMINACIÓN. PARECE QUE ES ELLA QUIEN GOBIERNA LA CASA DE KIRE. SONRIENDO, OS DICE:^ ~INK 31~ \"¡SALUDOS, VIAJEROS DE NUESTRO HOGAR! ¿YA HABÉIS HABLADO CON KIRE? ÚLTIMAMENTE HABLABA A MENUDO DE VOSOTROS.\""

#. Text 007 of map 337.
#. German: "~INK 30~ IHR SEHT EINE ZWERGENDAME MITTLEREN ALTERS. IHRE KLEIDUNG LÄSST DARAUF SCHLIEßEN, DASS SIE DIE KÖCHIN DER RESIDENZ IST. SIE MEINT:^ ~INK 31~ \"SEID GEGRÜßT, EDLE REISENDE! ENTSCHULDIGT MEINE EILE, ABER ICH HABE NOCH VIEL ZU TUN.\"^ ~INK 30~ MIT DIESEN WORTEN WENDET SIE SICH VON EUCH AB."
#: AllTexts/3Map_texts.amb/337/007.txt
msgctxt "AllTexts/3Map_texts.amb/337/007"
msgid "~INK 30~ YOU SEE A MIDDLE AGED DWARF LADY. FROM HER CLOTHING IT APPEARS SHE IS THE HEAD COOK OF THE RESIDENCE. SHE SAYS:^ ~INK 31~ \"WELCOME, NOBLE TRAVELLERS! PLEASE FORGIVE MY HASTE BUT I HAVE MUCH TO DO.\"^ ~INK 30~ WITH THESE WORDS SHE TURNS AWAY."
msgstr "~INK 30~ VEIS A UNA DAMA ENANA DE MEDIANA EDAD. POR SU ROPA, DIRÍASE QUE ES LA COCINERA DE LA RESIDENCIA. OS DICE:^ ~INK 31~ \"¡SALUDOS, NOBLES VIAJEROS! DISCULPAD MI PRISA, PERO AÚN TENGO MUCHO QUE HACER.\"^ ~INK 30~ DICHO ESTO, OS DA LA ESPALDA."

#. Text 008 of map 337.
#. German: "~INK 30~ VOR EUCH STEHT EIN HELLHAARIGER ZWERG UND SAGT:^ ~INK 31~ \"GRÜßE, LEIDENSGENOSSEN! WENN IHR SPEZIELLE WAFFEN BENÖTIGT, BESUCHT MEINEN SCHWAGER, DEN SCHMIED FERRIN. SEIN HAUS IST IM SÜDWESTEN DER STADT.\""
#: AllTexts/3Map_texts.amb/337/008.txt
msgctxt "AllTexts/3Map_texts.amb/337/008"
msgid "~INK 30~ BEFORE YOU STANDS A BLOND-HAIRED DWARF WHO SAYS:^ ~INK 31~ \"WELCOME, COMRADES! IF YOU NEED ANY SPECIAL WEAPONS, PLEASE VISIT MY BROTHER-IN-LAW, THE BLACKSMITH FERRIN. HIS HOUSE IS IN THE SOUTH WEST PART OF THE TOWN.\""
msgstr "~INK 30~ ANTE VOSOTROS HAY UN ENANO DE PELO CLARO QUE DICE:^ ~INK 31~ \"¡SALUDOS, COMPAÑEROS DE DESGRACIA! SI NECESITÁIS ARMAS ESPECIALES, VISITAD A MI CUÑADO, EL HERRERO FERRIN. SU CASA ESTÁ AL SUROESTE DE LA CIUDAD.\""

#. Text 009 of map 337.
#. German: "DIESE TÜR BESITZT EIN PRÄCHTIG VERZIERTES, ABER DENNOCH STABILES SCHLOSS."
#: AllTexts/3Map_texts.amb/337/009.txt
msgctxt "AllTexts/3Map_texts.amb/337/009"
msgid "THIS DOOR HAS A BEAUTIFULLY DECORATED AND VERY STRONG LOCK."
msgstr "ESTA PUERTA TIENE UNA CERRADURA RICAMENTE ADORNADA, PERO AUN ASÍ MUY RESISTENTE."

#. Text 010 of map 337.
#. German: "KIRE'S SCHLÜSSEL ÖFFNET DAS SCHLOSS MIT LEICHTIGKEIT."
#: AllTexts/3Map_texts.amb/337/010.txt
msgctxt "AllTexts/3Map_texts.amb/337/010"
msgid "KIRE'S KEY OPENS THE LOCK WITHOUT ANY BOTHER."
msgstr "LA LLAVE DE KIRE ABRE LA CERRADURA SIN ESFUERZO."

#. Text 011 of map 337.
#. German: "HIER IST EIN VORRAT GETROCKNETER PILZE UND RÄUCHERFLEISCH ZU FINDEN."
#: AllTexts/3Map_texts.amb/337/011.txt
msgctxt "AllTexts/3Map_texts.amb/337/011"
msgid "YOU FIND A STOCK OF DRIED MUSHROOMS AND SMOKED MEAT."
msgstr "AQUÍ HAY UNA PROVISIÓN DE SETAS SECAS Y CARNE AHUMADA."

#. Text 012 of map 337.
#. German: "DIE TRUHE BEINHALTET DIVERSE ALTE GEGENSTÄNDE."
#: AllTexts/3Map_texts.amb/337/012.txt
msgctxt "AllTexts/3Map_texts.amb/337/012"
msgid "THE CHEST CONTAINS VARIOUS OLD OBJECTS."
msgstr "EL COFRE CONTIENE DIVERSOS OBJETOS ANTIGUOS."

#. Text 013 of map 337.
#. German: "HIER BEFINDEN SICH EINIGE FACKELN UND LATERNEN."
#: AllTexts/3Map_texts.amb/337/013.txt
msgctxt "AllTexts/3Map_texts.amb/337/013"
msgid "HERE YOU FIND SEVERAL TORCHES AND LANTERNS"
msgstr "AQUÍ HAY VARIAS ANTORCHAS Y LINTERNAS."

#. Text 014 of map 337.
#. German: "DAS FASS IST LEDIGLICH MIT BIER GEFÜLLT."
#: AllTexts/3Map_texts.amb/337/014.txt
msgctxt "AllTexts/3Map_texts.amb/337/014"
msgid "THE BARREL IS JUST FULL OF BEER."
msgstr "EL BARRIL SOLO ESTÁ LLENO DE CERVEZA."

#. Text 000 of map 338. The name of the map.
#. German: "EINGANGSBEREICH RUINEN"
#: AllTexts/3Map_texts.amb/338/000.txt
msgctxt "AllTexts/3Map_texts.amb/338/000"
msgid "ENTRANCE TO THE RUINS"
msgstr "ENTRADA A LAS RUINAS"

#. Text 001 of map 338.
#. German: "UNTER DER LAST DER GRUPPE GIBT DER BODEN AN DIESER STELLE NACH. BEVOR JEMAND REAGIEREN KANN, STÜRZT IHR IN DIE TIEFE."
#: AllTexts/3Map_texts.amb/338/001.txt
msgctxt "AllTexts/3Map_texts.amb/338/001"
msgid "THE GROUND AT THIS POINT COLLAPSES UNDER THE WEIGHT OF THE GROUP. BEFORE ANYONE CAN REACT, YOU FALL INTO THE ABYSS. ␀ "
msgstr "EN ESTE PUNTO EL SUELO CEDE BAJO EL PESO DEL GRUPO. ANTES DE QUE NADIE PUEDA REACCIONAR, CAÉIS AL VACÍO."

#. Text 000 of map 339. The name of the map.
#: AllTexts/3Map_texts.amb/339/000.txt
msgctxt "AllTexts/3Map_texts.amb/339/000"
msgid "DOR GRESTIN"
msgstr "DOR GRESTIN"

#. Text 001 of map 339.
#. German: "DER LADENBESITZER LÄSST SICH NICHT IN SEINER RUHE STÖREN: DIE TÜR BLEIBT GESCHLOSSEN."
#: AllTexts/3Map_texts.amb/339/001.txt
msgctxt "AllTexts/3Map_texts.amb/339/001"
msgid "THE SHOP OWNER WILL NOT BE DISTURBED: THE DOOR REMAINS SHUT."
msgstr "EL TENDERO NO SE DEJA MOLESTAR EN SU DESCANSO: LA PUERTA SIGUE CERRADA."

#. Text 002 of map 339.
#. German: "VIEL GLÜCK AUF EUREN WEGEN!"
#: AllTexts/3Map_texts.amb/339/002.txt
msgctxt "AllTexts/3Map_texts.amb/339/002"
msgid "MUCH SUCCESS ON YOUR TRAVELS!"
msgstr "¡MUCHA SUERTE EN VUESTROS CAMINOS!"

#. Text 003 of map 339.
#. German: "~INK 31~ \"DIE SCHÄTZE DES WALDES!^ ~INK 30~ ZU EUREN DIENSTEN VON DER 7. BIS ZUR 20. STUNDE\""
#: AllTexts/3Map_texts.amb/339/003.txt
msgctxt "AllTexts/3Map_texts.amb/339/003"
msgid "~INK 31~ \"THE TREASURES OF THE FOREST!^ ~INK 30~ AT YOUR SERVICE FROM 7 AM TO 8 PM\""
msgstr "~INK 31~ \"¡LOS TESOROS DEL BOSQUE!^ ~INK 30~ A VUESTRO SERVICIO DE 7 A 20 H\""

#. Text 004 of map 339.
#. German: "~INK 30~ AUF DAS SCHILD SIND EIN PAAR ZWERGE IN GEMÜTLICHER RUNDE GEMALT WORDEN. DARUNTER STEHT:^^ ~INK 31~ \"DAS NEST\""
#: AllTexts/3Map_texts.amb/339/004.txt
msgctxt "AllTexts/3Map_texts.amb/339/004"
msgid "~INK 30~ THE PICTURE ON THE SIGN SHOWS A FEW DWARFS CHATTING IN A FRIENDLY CIRCLE. THE TEXT BELOW IT SAYS:^^ ~INK 31~ \"THE NEST\""
msgstr "~INK 30~ EN EL LETRERO HAY PINTADOS UNOS CUANTOS ENANOS EN ANIMADA TERTULIA. DEBAJO PONE:^^ ~INK 31~ \"EL NIDO\""

#. Text 005 of map 339.
#. German: "\"RATSHALLE DOR GRESTIN\""
#: AllTexts/3Map_texts.amb/339/005.txt
msgctxt "AllTexts/3Map_texts.amb/339/005"
msgid "\"THE COUNCIL HALL OF DOR GRESTIN\""
msgstr "\"SALA DEL CONSEJO DE DOR GRESTIN\""

#. Text 006 of map 339.
#. German: "~INK 30~ IHR BEGINNT EIN GESRÄCH MIT DIESEM GUTGELAUNTEN PASSANTEN. ER SAGT:^ ~INK 31~ \"SEHT EUCH UM IN UNSERER STADT, UND IHR WERDET ERKENNEN, DASS DIESE WELT NICHT NUR GEFAHR, SONDERN AUCH VIEL SCHÖNHEIT BEREITHÄLT!\""
#: AllTexts/3Map_texts.amb/339/006.txt
msgctxt "AllTexts/3Map_texts.amb/339/006"
msgid "~INK 30~ YOU BEGIN A CONVERSATION WITH THIS WELL-MANNERED PASSER-BY. HE SAYS:^ ~INK 31~ \"HAVE A LOOK AT OUR TOWN AND YOU WILL SEE THAT THIS WORLD HOLDS NOT ONLY DANGER BUT ALSO GREAT BEAUTY!\""
msgstr "~INK 30~ ENTABLÁIS CONVERSACIÓN CON ESTE TRANSEÚNTE DE BUEN HUMOR. DICE:^ ~INK 31~ \"¡ECHAD UN VISTAZO A NUESTRA CIUDAD Y VERÉIS QUE ESTE MUNDO NO SOLO ENCIERRA PELIGROS, SINO TAMBIÉN MUCHA BELLEZA!\""

#. Text 007 of map 339.
#. German: "~INK 30~ DER ZWERG VOR EUCH STELLT SICH ALS ERFAHRENER WALDKUNDSCHAFTER VOR. ER GIBT EUCH EINEN RAT:^ ~INK 31~ \"ACHTET IN DEN WÄLDERN AUF EURE SCHRITTE! MANCHE RAUBTIERE SIND ERST ZU ENTDECKEN, WENN SIE SICH BEWEGEN, UND DANN KANN ES SCHON ZU SPÄT SEIN. REIST NICHT IN BLINDER HAST!\""
#: AllTexts/3Map_texts.amb/339/007.txt
msgctxt "AllTexts/3Map_texts.amb/339/007"
msgid "~INK 30~ THE DWARF BEFORE YOU INTRODUCES HIMSELF AS AN EXPERIENCED FOREST GUIDE. HE GIVES YOU ADVICE:^ ~INK 31~ \"WATCH YOUR STEP IN THE FORESTS! YOU WILL ONLY DISCOVER MANY WILD ANIMALS WHEN YOU ACTUALLY RUN INTO THEM, AND IT CAN THEN BE TOO LATE. DO NOT TRAVEL IN HASTE!\" ␀ 4"
msgstr "~INK 30~ EL ENANO QUE TENÉIS DELANTE SE PRESENTA COMO UN EXPERIMENTADO EXPLORADOR DE LOS BOSQUES. OS DA UN CONSEJO:^ ~INK 31~ \"¡EN LOS BOSQUES, MIRAD DÓNDE PISÁIS! A ALGUNAS FIERAS SOLO SE LAS DESCUBRE CUANDO SE MUEVEN, Y ENTONCES PUEDE SER DEMASIADO TARDE. ¡NO VIAJÉIS CON PRISAS A CIEGAS!\""

#. Text 008 of map 339.
#. German: "~INK 30~ DIE ZWERGIN WIRFT EINEN PRÜFENDEN BLICK AUF DIE GRUPPE UND MEINT:^ ~INK 31~ \"ICH HOFFE, IHR HATTET EINE GEFAHRLOSE REISE. FALLS EINER VON EUCH AN EINER VERWUNDUNG LEIDET, DENKT DARAN, DASS WIR MIT ASRUB DEN BESTEN HEILER DES ZWERGENVOLKS BEI UNS HABEN. IHR FINDET IHN IN SEINEM PFLANZENHAUS IM NORDWESTEN DER STADT. ER HAT ÜBRIGENS AUSSERDEM EIN HERVORRAGENDES WISSEN ÜBER WERTVOLLE KRÄUTER.\""
#: AllTexts/3Map_texts.amb/339/008.txt
msgctxt "AllTexts/3Map_texts.amb/339/008"
msgid "~INK 30~ THE DWARF LADY GLANCES QUESTIONINGLY AT THE GROUP AND SAYS:^ ~INK 31~ \"I HOPE YOU HAD A SAFE JOURNEY. IF ANYONE IS INJURED, PLEASE REMEMBER THAT WITH ASRUB WE HAVE THE BEST HEALER OF THE DWARF PEOPLE. YOU WILL FIND HIM IN HIS PLANT HOUSE IN THE NORTH WEST PART OF THE TOWN. INCIDENTALLY, HE ALSO HAS EXTRAORDINARY KNOWLEDGE OF VALUABLE HERBS.\""
msgstr "~INK 30~ LA ENANA ECHA UNA MIRADA EXAMINADORA AL GRUPO Y DICE:^ ~INK 31~ \"ESPERO QUE HAYÁIS TENIDO UN VIAJE SIN PELIGROS. SI ALGUNO DE VOSOTROS SUFRE ALGUNA HERIDA, RECORDAD QUE CONTAMOS CON ASRUB, EL MEJOR CURANDERO DEL PUEBLO ENANO. LO ENCONTRARÉIS EN SU INVERNADERO, AL NOROESTE DE LA CIUDAD. POR CIERTO, TAMBIÉN SABE MUCHÍSIMO DE HIERBAS VALIOSAS.\""

#. Text 009 of map 339.
#. German: "~INK 30~ TRAUER VERSCHLEIERT DAS HÜBSCHE GESICHT DIESER ZWERGIN. SIE BERICHTET STOCKEND, DASS IHR GEFÄHRTE KÜRZLICH DEN RAUBTIEREN ZUM OPFER GEFALLEN IST. SIE IST NICHT AN EINEM WEITEREN GESPRÄCH INTERESSIERT, UND IHR ZIEHT EUCH ZURÜCK."
#: AllTexts/3Map_texts.amb/339/009.txt
msgctxt "AllTexts/3Map_texts.amb/339/009"
msgid "~INK 30~ SADNESS MASKS THE PRETTY FACE OF THIS DWARF LADY. SHE REPORTS BREATHLESSLY THAT HER PARTNER RECENTLY FELL VICTIM TO THE WILD ANIMALS. SHE IS NOT INTERESTED IN TALKING ANY MORE AND YOU WITHDRAW."
msgstr "~INK 30~ LA TRISTEZA VELA EL BONITO ROSTRO DE ESTA ENANA. OS CUENTA ENTRECORTADAMENTE QUE SU COMPAÑERO CAYÓ HACE POCO VÍCTIMA DE LAS FIERAS. NO LE INTERESA SEGUIR HABLANDO, ASÍ QUE OS RETIRÁIS."

#. Text 010 of map 339.
#. German: "HIER SPRUDELT AUS EINEM FELSEN EINE MUNTERE QUELLE. DAS KRISTALLKLARE WASSER BILDET EINEN KLEINEN TEICH."
#: AllTexts/3Map_texts.amb/339/010.txt
msgctxt "AllTexts/3Map_texts.amb/339/010"
msgid "A BRIGHT SPRING BABBLES OUT OF THE ROCK. THE CRYSTAL CLEAR WATER FORMS A SMALL POOL."
msgstr "AQUÍ BROTA DE UNA ROCA UN ALEGRE MANANTIAL. EL AGUA CRISTALINA FORMA UN PEQUEÑO ESTANQUE."

#. Text 011 of map 339.
#. German: "~INK 30~ IHR PLAUDERT MIT EINEM BÜRGER DOR GRESTIN'S. ER MEINT:^ ~INK 31~ \"WUNDERT EUCH NICHT ÜBER DIE WANDERPILZE. ULKIGE DINGER. WIR VERSUCHEN SIE IN DER STADT ZU HALTEN, WEIL IHR GERUCH VIELE GEFÄHRLICHE INSEKTEN ABHÄLT.\""
#: AllTexts/3Map_texts.amb/339/011.txt
msgctxt "AllTexts/3Map_texts.amb/339/011"
msgid "~INK 30~ YOU CHAT WITH A MAN FROM DOR GRESTIN. HE SAYS:^ ~INK 31~ \"DO NOT WORRY ABOUT THE WANDERING MUSHROOMS. STRANGE THINGS, THEY ARE. WE TRY TO KEEP THEM IN THE TOWN BECAUSE THEIR ODOUR DRIVES AWAY MANY DANGEROUS INSECTS.\""
msgstr "~INK 30~ CHARLÁIS CON UN VECINO DE DOR GRESTIN. OS DICE:^ ~INK 31~ \"NO OS EXTRAÑÉIS POR LAS SETAS ANDANTES. SON COSAS RARAS. INTENTAMOS TENERLAS EN LA CIUDAD PORQUE SU OLOR AHUYENTA A MUCHOS INSECTOS PELIGROSOS.\""

#. Text 012 of map 339.
#. German: "~INK 30~ EUER GESPRÄCHSPARTNER STELLT SICH ALS BESUCHER AUS DOR KIREDON VOR UND SAGT:^ ~INK 31~ \"DIESE STADT SIEHT AUS WIE EIN RÜBENFELD! UNGLAUBLICH! HOFFENTLICH KANN ICH MEINE EINKÄUFE BALD ERLEDIGEN UND IN DEN SCHUTZ DOR KIREDON'S HEIMKEHREN.\""
#: AllTexts/3Map_texts.amb/339/012.txt
msgctxt "AllTexts/3Map_texts.amb/339/012"
msgid "~INK 30~ THE PERSON YOU ARE TALKING TO INTRODUCES HIMSELF AS A VISITOR FROM DOR KIREDON AND HE SAYS:^ ~INK 31~ \"THIS TOWN LOOKS LIKE A FIELD OF VEGETABLES! UNBELIEVABLE! HOPEFULLY I CAN SOON FINISH MY SHOPPING AND RETURN TO THE SAFETY OF DOR KIREDON.\""
msgstr "~INK 30~ VUESTRO INTERLOCUTOR SE PRESENTA COMO UN VISITANTE DE DOR KIREDON Y DICE:^ ~INK 31~ \"¡ESTA CIUDAD PARECE UN CAMPO DE NABOS! ¡INCREÍBLE! OJALÁ PUEDA TERMINAR PRONTO MIS COMPRAS Y VOLVER A LA SEGURIDAD DE DOR KIREDON.\""

#. Text 013 of map 339.
#. German: "~INK 30~ DIE ZWERGIN IST ETWAS KURZ ANGEBUNDEN UND SAGT LEDIGLICH:^ ~INK 31~ \"GRÜßE, IHR REISENDEN VOM GROßEN VOLK!\""
#: AllTexts/3Map_texts.amb/339/013.txt
msgctxt "AllTexts/3Map_texts.amb/339/013"
msgid "~INK 30~ THE DWARF GIRL IS RATHER BRUSQUE AND SAYS ONLY:^ ~INK 31~ \"GREETINGS, TRAVELLERS FROM THE LARGE PEOPLE!\""
msgstr "~INK 30~ LA ENANA ES ALGO SECA Y SOLO DICE:^ ~INK 31~ \"¡SALUDOS, VIAJEROS DEL PUEBLO GRANDE!\""

#. Text 014 of map 339.
#. German: "IHR HOLT DIE BEWEGLICHEN GEWÄCHSE EIN UND HABT NUN DIE EINZIGARTIGE MÖGLICHKEIT, EUCH IN DEN BESITZ EINES ZAPPELNDEN, STINKENDEN PILZES ZU BRINGEN..."
#: AllTexts/3Map_texts.amb/339/014.txt
msgctxt "AllTexts/3Map_texts.amb/339/014"
msgid "YOU COLLECT THE MOBILE GROWTHS AND NOW HAVE A UNIQUE OPPORTUNITY TO POSSESS A TREMBLING, STINKING MUSHROOM ..."
msgstr "RECOGÉIS LAS PLANTAS ANDARINAS Y AHORA TENÉIS LA OPORTUNIDAD ÚNICA DE HACEROS CON UNA SETA APESTOSA QUE NO PARA DE RETORCERSE..."

#. Text 015 of map 339.
#. German: "~INK 30~ DAS SCHILD VERKÜNDET:^^ ~INK 31~ \"RANDORS ALLERLEI-LÄDCHEN^ VON DER 8. BIS ZUR 20. STUNDE GEÖFFNET\""
#: AllTexts/3Map_texts.amb/339/015.txt
msgctxt "AllTexts/3Map_texts.amb/339/015"
msgid "~INK 30~ THE SIGN SAYS:^^ ~INK 31~ \"RANDOR'S GENERAL STORE^ OPEN FROM 8 AM TO 8 PM\""
msgstr "~INK 30~ EL LETRERO ANUNCIA:^^ ~INK 31~ \"TIENDECITA DE TODO UN POCO DE RANDOR^ ABIERTO DE 8 A 20 H\""

#. Text 016 of map 339.
#. German: "ALS IHR VERSUCHT, DIE LADENTÜR ZU ÖFFNEN, KLINGT GEDÄMPFT DURCH DAS HOLZ EINE STIMME ZU EUCH: \"BITTE BESUCHT MICH ZU DEN ÖFFNUNGSZEITEN!\""
#: AllTexts/3Map_texts.amb/339/016.txt
msgctxt "AllTexts/3Map_texts.amb/339/016"
msgid "AS YOU TRY TO OPEN THE SHOP DOOR YOU HEAR A VOICE INSIDE, SAYING: \"PLEASE COME BACK WHEN I AM OPEN!\""
msgstr "AL INTENTAR ABRIR LA PUERTA DE LA TIENDA, OÍS UNA VOZ AMORTIGUADA A TRAVÉS DE LA MADERA: \"¡VENID A VERME EN HORARIO DE APERTURA, POR FAVOR!\""

#. Text 017 of map 339.
#. German: "\"VIELEN DANK UND EINE ANGENEHME ZEIT NOCH, IHR REISENDEN!\""
#: AllTexts/3Map_texts.amb/339/017.txt
msgctxt "AllTexts/3Map_texts.amb/339/017"
msgid "\"MANY THANKS! HAVE A NICE DAY, TRAVELLERS!\""
msgstr "\"¡MUCHAS GRACIAS Y QUE PASÉIS UN BUEN RATO, VIAJEROS!\""

#. Text 018 of map 339.
#. German: "ERFRISCHT DURCH DEN SCHLAF VERLASST IHR DIE GEMÜTLICHE HERBERGE."
#: AllTexts/3Map_texts.amb/339/018.txt
msgctxt "AllTexts/3Map_texts.amb/339/018"
msgid "REFRESHED BY THE SLEEP YOU LEAVE THE COMFORTABLE PLACE."
msgstr "DESPUÉS DE UN SUEÑO REPARADOR, ABANDONÁIS EL ACOGEDOR ALBERGUE."

#. Text 019 of map 339.
#. German: "\"ICH WÜNSCHE EUCH EINE ANGENEHME RUHE!\""
#: AllTexts/3Map_texts.amb/339/019.txt
msgctxt "AllTexts/3Map_texts.amb/339/019"
msgid "\"I WISH YOU A PLEASANT REST!\""
msgstr "\"¡OS DESEO UN AGRADABLE DESCANSO!\""

#. Text 000 of map 340. The name of the map.
#. German: "FERRIN'S KELLER"
#: AllTexts/3Map_texts.amb/340/000.txt
msgctxt "AllTexts/3Map_texts.amb/340/000"
msgid "FERRIN'S CELLAR"
msgstr "SÓTANO DE FERRIN"

#. Text 001 of map 340.
#. German: "IHR BETRETET EINE STEILE TREPPE, DIE NOCH TIEFER INS ERDREICH FÜHRT."
#: AllTexts/3Map_texts.amb/340/001.txt
msgctxt "AllTexts/3Map_texts.amb/340/001"
msgid "YOU MOVE ONTO A STEEP STAIRCASE LEADING EVEN DEEPER INTO THE GROUND."
msgstr "PISÁIS UNA ESCALERA EMPINADA QUE BAJA AÚN MÁS HACIA LAS PROFUNDIDADES DE LA TIERRA."

#. Text 002 of map 340.
#. German: "DER HAMMER IST FILIGRAN GEFORMT, OFFENBAR EIN SPEZIALWERKZEUG. ER WÄRE FÜR EUCH NICHT VON NUTZEN."
#: AllTexts/3Map_texts.amb/340/002.txt
msgctxt "AllTexts/3Map_texts.amb/340/002"
msgid "THE HAMMER IS MADE OF FILIGRIS, APPARENTLY A SPECIAL TOOL. IT WOULD NOT BE OF USE TO YOU."
msgstr "EL MARTILLO TIENE UNA FORMA DELICADA; POR LO VISTO, ES UNA HERRAMIENTA ESPECIAL. A VOSOTROS NO OS SERVIRÍA DE NADA."

#. Text 003 of map 340.
#. German: "DAS FASS IST LEER."
#: AllTexts/3Map_texts.amb/340/003.txt
msgctxt "AllTexts/3Map_texts.amb/340/003"
msgid "THE BARREL IS EMPTY."
msgstr "EL BARRIL ESTÁ VACÍO."

#. Text 004 of map 340.
#. German: "DIESES FASS IST MIT EINER BEIZFLÜSSIGKEIT GEFÜLLT, DIE EUCH DIE TRÄNEN IN DIE AUGEN TREIBT. KEIN BRAUCHBARER FUND."
#: AllTexts/3Map_texts.amb/340/004.txt
msgctxt "AllTexts/3Map_texts.amb/340/004"
msgid "THIS BARREL IS FULL OF A PICKLING LIQUID WHICH BRINGS TEARS TO YOUR EYES. NOT A USEFUL FIND."
msgstr "ESTE BARRIL ESTÁ LLENO DE UN LÍQUIDO DE ENCURTIR QUE OS HACE LLORAR LOS OJOS. NO ES UN HALLAZGO ÚTIL."

#. Text 005 of map 340.
#. German: "DAS VIELE GEPÖKELTE FLEISCH IN DIESEM FASS BIETET KEINEN VERLOCKENDEN ANBLICK, WÄRE ABER NAHRUNG FÜR LANGE ZEIT."
#: AllTexts/3Map_texts.amb/340/005.txt
msgctxt "AllTexts/3Map_texts.amb/340/005"
msgid "THE LARGE QUANTITY OF PICKLED MEAT IN THIS BARREL DOES NOT LOOK APPETISING BUT IT WOULD BE FOOD FOR A LONG TIME."
msgstr "LA ENORME CANTIDAD DE CARNE EN SALAZÓN DE ESTE BARRIL NO TIENE UN ASPECTO MUY APETECIBLE, PERO DARÍA DE COMER DURANTE MUCHO TIEMPO."

#. Text 006 of map 340.
#. German: "IN DIESEM SCHRANK SIND EINIGE INTERESSANTE DINGE AUFBEWAHRT."
#: AllTexts/3Map_texts.amb/340/006.txt
msgctxt "AllTexts/3Map_texts.amb/340/006"
msgid "SOME INTERESTING THINGS ARE STORED IN THIS CUPBOARD."
msgstr "EN ESTE ARMARIO SE GUARDAN ALGUNAS COSAS INTERESANTES."

#. Text 007 of map 340.
#. German: "EINE GUT ERHALTENE LATERNE LENKT EURE AUFMERKSAMKEIT AUF SICH."
#: AllTexts/3Map_texts.amb/340/007.txt
msgctxt "AllTexts/3Map_texts.amb/340/007"
msgid "A WELL-MAINTAINED LANTERN ATTRACTS YOUR ATTENTION."
msgstr "UNA LINTERNA BIEN CONSERVADA OS LLAMA LA ATENCIÓN."

#. Text 008 of map 340.
#. German: "AUF DIESEM REGAL LIEGEN EINIGE GUT ERHALTENE DIETRICHE UND EIN BRECHEISEN. OFFENBAR BRAUCHT FERRIN SIE FÜR KUNDEN, DIE SICH AUSGESPERRT HABEN."
#: AllTexts/3Map_texts.amb/340/008.txt
msgctxt "AllTexts/3Map_texts.amb/340/008"
msgid "SOME WELL-MAINTAINED LOCKPICKS AND A CROWBAR ARE TO BE FOUND ON THIS SHELF. APPARENTLY FERRIN USES THEM TO HELP CUSTOMERS WHO HAVE LOCKED THEMSELVES OUT."
msgstr "EN ESTE ESTANTE HAY ALGUNAS GANZÚAS BIEN CONSERVADAS Y UNA PATA DE CABRA. POR LO VISTO, FERRIN LAS USA PARA LOS CLIENTES QUE SE HAN QUEDADO FUERA DE CASA."

#. Text 009 of map 340.
#. German: "NEBEN ALTEN LUMPEN FINDEN SICH HIER EINE SCHAUFEL UND EIN SEIL."
#: AllTexts/3Map_texts.amb/340/009.txt
msgctxt "AllTexts/3Map_texts.amb/340/009"
msgid "NEXT TO OLD RAGS YOU FIND A SHOVEL AND A ROPE."
msgstr "JUNTO A UNOS TRAPOS VIEJOS ENCONTRÁIS UNA PALA Y UNA CUERDA."

#. Text 010 of map 340.
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "~LEAD~ DURCHWÜHLT DEN SCHRANK, FINDET ABER NICHTS VON WERT."
#: AllTexts/3Map_texts.amb/340/010.txt
msgctxt "AllTexts/3Map_texts.amb/340/010"
msgid "~LEAD~ FUMBLES AROUND IN THE CUPBOARD BUT FINDS NOTHING OF VALUE."
msgstr "~LEAD~ REVUELVE EL ARMARIO, PERO NO ENCUENTRA NADA DE VALOR."

#. Text 011 of map 340.
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "~LEAD~ WIRFT EINEN BLICK AUF DAS REGAL, ENTDECKT ABER NICHTS INTERESSANTES."
#: AllTexts/3Map_texts.amb/340/011.txt
msgctxt "AllTexts/3Map_texts.amb/340/011"
msgid "~LEAD~ CASTS A GLANCE AT THE SHELF BUT DISCOVERS NOTHING OF INTEREST."
msgstr "~LEAD~ ECHA UN VISTAZO AL ESTANTE, PERO NO DESCUBRE NADA INTERESANTE."

#. Text 012 of map 340.
#. German: "EINE ZANGE MIT KRÄFTIGEN BACKEN. NUR FÜR SCHMIEDE VON PRAKTISCHEM NUTZEN."
#: AllTexts/3Map_texts.amb/340/012.txt
msgctxt "AllTexts/3Map_texts.amb/340/012"
msgid "A PAIR OF PLIERS WITH POWERFUL JAWS. ONLY OF PRACTICAL USE TO A BLACKSMITH."
msgstr "UNAS TENAZAS DE MANDÍBULAS FUERTES. SOLO TIENEN UTILIDAD PRÁCTICA PARA UN HERRERO."

#. Text 013 of map 340.
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "ZU ~LEAD~'S ENTTÄUSCHUNG IST DAS FLÄSCHCHEN LEER."
#: AllTexts/3Map_texts.amb/340/013.txt
msgctxt "AllTexts/3Map_texts.amb/340/013"
msgid "TO ~LEAD~S DISAPPOINTMENT THE FLASK IS EMPTY."
msgstr "PARA DECEPCIÓN DE ~LEAD~, EL FRASQUITO ESTÁ VACÍO."

#. Text 014 of map 340.
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "EIN INTERESSANTER FUND! AUS DEM FLÄSCHCHEN STEIGT ~LEAD~ EIN VERFÜHRERISCHER, STARK ALKOHOLISCHER DUFT ENTGEGEN."
#: AllTexts/3Map_texts.amb/340/014.txt
msgctxt "AllTexts/3Map_texts.amb/340/014"
msgid "AN INTERESTING FIND! A SEDUCTIVE, STRONGLY ALCOHOLIC AROMA RISES TOWARDS ~LEAD~ FROM THE FLASK."
msgstr "¡UN HALLAZGO INTERESANTE! DEL FRASQUITO SUBE HACIA ~LEAD~ UN AROMA SEDUCTOR Y MUY ALCOHÓLICO."

#. Text 015 of map 340.
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "~LEAD~ ZIEHT EINE ROBUSTE SPITZHACKE AUS DEM SCHRANK."
#: AllTexts/3Map_texts.amb/340/015.txt
msgctxt "AllTexts/3Map_texts.amb/340/015"
msgid "~LEAD~ TAKES A STRONG PICKAXE FROM THE CUPBOARD."
msgstr "~LEAD~ SACA DEL ARMARIO UN PICO ROBUSTO."

#. Text 000 of map 341. The name of the map.
#. German: "RATSHALLE"
#: AllTexts/3Map_texts.amb/341/000.txt
msgctxt "AllTexts/3Map_texts.amb/341/000"
msgid "COUNCIL HALL"
msgstr "SALA DEL CONSEJO"

#. Text 001 of map 341.
#. German: "~INK 30~ DAS ZWERGENKIND STAUNT:^ ~INK 31~ \"WARUM SEID IHR SO GROß?\""
#: AllTexts/3Map_texts.amb/341/001.txt
msgctxt "AllTexts/3Map_texts.amb/341/001"
msgid "~INK 30~ THE DWARF CHILD SAYS IN ASTONISHMENT:^ ~INK 31~ \"WHY ARE YOU SO BIG?\""
msgstr "~INK 30~ EL NIÑO ENANO SE ASOMBRA:^ ~INK 31~ \"¿POR QUÉ SOIS TAN GRANDES?\""

#. Text 002 of map 341.
#. German: "~INK 30~ EIN KLEINES ZWERGENMÄDCHEN STEHT VOR EUCH. ES ERSCHRICKT BEI EUREM ANBLICK UND FÄNGT ZU WEINEN AN."
#: AllTexts/3Map_texts.amb/341/002.txt
msgctxt "AllTexts/3Map_texts.amb/341/002"
msgid "~INK 30~ A LITTLE DWARF GIRL STANDS BEFORE YOU. SHE IS FRIGHTENED BY YOUR APPEARANCE AND STARTS CRYING."
msgstr "~INK 30~ UNA NIÑA ENANA PEQUEÑITA ESTÁ DELANTE DE VOSOTROS. SE ASUSTA AL VEROS Y SE ECHA A LLORAR."

#. Text 003 of map 341.
#: AllTexts/3Map_texts.amb/341/003.txt
msgctxt "AllTexts/3Map_texts.amb/341/003"
msgid "X"
msgstr "X"

#. Text 004 of map 341.
#. German: "DER RIESIGE RAUM VOR EUCH BIETET EINEN IMPOSANTEN ANBLICK: INMITTEN KUNSTVOLL ARRANGIERTER STRÄUCHER STEHEN RIESIGE BÄUME WIE STUMME WÄCHTER UM EINEN MÄCHTIGEN, HOLZGESCHNITZTEN THRON."
#: AllTexts/3Map_texts.amb/341/004.txt
msgctxt "AllTexts/3Map_texts.amb/341/004"
msgid "THE HUGE ROOM BEFORE YOU OFFERS AN IMPOSING SIGHT: IN THE CENTRE OF ARTISTICALLY ARRANGED BUSHES THERE ARE HUGE TREES, LIKE SILENT GUARDIANS AROUND A MIGHTY WOODEN CARVED THRONE."
msgstr "LA INMENSA SALA QUE TENÉIS DELANTE OFRECE UNA IMAGEN IMPONENTE: ENTRE ARBUSTOS DISPUESTOS CON ARTE, ÁRBOLES GIGANTESCOS SE ALZAN COMO GUARDIANES MUDOS EN TORNO A UN PODEROSO TRONO DE MADERA TALLADA."

#. Text 005 of map 341.
#. German: "DIES MUSS DIE KÜCHE DES HAUSES SEIN. APPETITLICHE DÜFTE DURCHZIEHEN DEN RAUM."
#: AllTexts/3Map_texts.amb/341/005.txt
msgctxt "AllTexts/3Map_texts.amb/341/005"
msgid "THIS MUST BE THE KITCHEN. APPETISING SMELLS SPREAD THROUGH THE ROOM."
msgstr "ESTA DEBE DE SER LA COCINA DE LA CASA. UNOS OLORES APETITOSOS INUNDAN LA ESTANCIA."

#. Text 006 of map 341.
#. German: "IN DIESEM REGAL SEHT IHR EINIGE PAKETE MIT DAUERWURST UND TROCKENBROT."
#: AllTexts/3Map_texts.amb/341/006.txt
msgctxt "AllTexts/3Map_texts.amb/341/006"
msgid "ON THIS SHELF YOU SEE SOME PACKETS CONTAINING SAUSAGE MEAT AND DRY BREAD."
msgstr "EN ESTE ESTANTE VEIS ALGUNOS PAQUETES CON EMBUTIDO CURADO Y PAN SECO."

#. Text 007 of map 341.
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "~LEAD~'S BLICK FÄLLT AUF EINE DER VON ASRUB BESCHRIEBENEN KRÄUTERSORTEN."
#: AllTexts/3Map_texts.amb/341/007.txt
msgctxt "AllTexts/3Map_texts.amb/341/007"
msgid "~LEAD~ CATCHES SIGHT OF ONE OF THE TYPES OF HERBS DESCRIBED BY ASRUB."
msgstr "LA MIRADA DE ~LEAD~ SE POSA EN UNA DE LAS HIERBAS QUE DESCRIBIÓ ASRUB."

#. Text 000 of map 342. The name of the map.
#. German: "RUINENUNTERGRUND"
#: AllTexts/3Map_texts.amb/342/000.txt
msgctxt "AllTexts/3Map_texts.amb/342/000"
msgid "UNDERGROUND RUINS"
msgstr "SUBSUELO DE LAS RUINAS"

#. Text 001 of map 342.
#. German: "DER LUMPENHAUFEN VOR EUCH ENTPUPPT SICH ALS DAS ÜBEL ZUGERICHTETE SKELETT EINES ZWERGES. UNTER DEN ÜBERRESTEN IST EIN SCHRIFTROLLENBEHÄLTER ZU ERKENNEN."
#: AllTexts/3Map_texts.amb/342/001.txt
msgctxt "AllTexts/3Map_texts.amb/342/001"
msgid "THE PILE OF RAGS BEFORE YOU PROVES TO BE THE HORRIBLY DISTORTED SKELETON OF A DWARF. AMONGST THE REMAINS YOU SEE A SCROLL CONTAINER."
msgstr "EL MONTÓN DE HARAPOS QUE TENÉIS DELANTE RESULTA SER EL ESQUELETO DESTROZADO DE UN ENANO. ENTRE LOS RESTOS SE DISTINGUE UN ESTUCHE PARA PERGAMINOS."

#. Text 002 of map 342.
#. German: "DER BERNSTEIN AKTIVIERT DAS GEHEIMNISVOLLE GERÄT."
#: AllTexts/3Map_texts.amb/342/002.txt
msgctxt "AllTexts/3Map_texts.amb/342/002"
msgid "THE PIECE OF AMBER ACTIVATES THE SECRET UNIT."
msgstr "EL ÁMBAR ACTIVA EL MISTERIOSO APARATO."

#. Text 003 of map 342.
#. German: "DIE TÜR IGNORIERT EURE ÖFFNUNGSVERSUCHE UND BLEIBT GESCHLOSSEN."
#: AllTexts/3Map_texts.amb/342/003.txt
msgctxt "AllTexts/3Map_texts.amb/342/003"
msgid "THE DOOR IGNORES ALL YOUR ATTEMPTS TO OPEN IT AND REMAINS CLOSED."
msgstr "LA PUERTA IGNORA VUESTROS INTENTOS DE ABRIRLA Y SIGUE CERRADA."

#. Text 004 of map 342.
#. German: "EINIGE ZEIT NACHDEM EINE DER KUGELN AN DER TÜR ZULETZT GEDRÜCKT WURDE, SCHIEBEN SICH ZWEI METALLPLATTEN LANGSAM UND KNIRSCHEND ZUR SEITE.^ DIE TÜR IST OFFEN!"
#: AllTexts/3Map_texts.amb/342/004.txt
msgctxt "AllTexts/3Map_texts.amb/342/004"
msgid "SOMETIME AFTER ONE OF THE SPHERES WAS LAST PRESSED AGAINST THE DOOR, TWO METAL PLATES SCREECH SLOWLY TO ONE SIDE.^ THE DOOR IS OPEN!"
msgstr "UN RATO DESPUÉS DE QUE SE PULSARA POR ÚLTIMA VEZ UNA DE LAS ESFERAS DE LA PUERTA, DOS PLACAS METÁLICAS SE DESPLAZAN A UN LADO, LENTAMENTE Y CON UN CHIRRIDO.^ ¡LA PUERTA ESTÁ ABIERTA!"

#. Text 005 of map 342.
#. German: "UNTER DIESEM BIS ZUR UNKENNTLICHKEIT VERROTTETEN HAUFEN FINDET SICH EIN UNBEARBEITETES STÜCK BERNSTEIN."
#: AllTexts/3Map_texts.amb/342/005.txt
msgctxt "AllTexts/3Map_texts.amb/342/005"
msgid "UNDER THIS UNIDENTIFIABLE ROTTEN PILE OF RUBBISH THERE IS A PIECE OF RAW AMBER."
msgstr "BAJO ESTE MONTÓN PODRIDO HASTA SER IRRECONOCIBLE HAY UN TROZO DE ÁMBAR EN BRUTO."

#. Text 006 of map 342.
#. German: "SEIT ÄONEN DEM VERFALL PREISGEGEBEN, ZERFALLEN DIE UNBEKANNTEN GEGENSTÄNDE BEI DER KLEINSTEN BERÜHRUNG ZU STAUB."
#: AllTexts/3Map_texts.amb/342/006.txt
msgctxt "AllTexts/3Map_texts.amb/342/006"
msgid "ALLOWED TO DECAY FOR AGES, THE UNKNOWN OBJECTS FALL TO DUST AT THE SLIGHTEST TOUCH. ␀ "
msgstr "ABANDONADOS A LA RUINA DESDE HACE EONES, LOS OBJETOS DESCONOCIDOS SE DESHACEN EN POLVO AL MÁS MÍNIMO ROCE."

#. Text 000 of map 343. The name of the map.
#: AllTexts/3Map_texts.amb/343/000.txt
msgctxt "AllTexts/3Map_texts.amb/343/000"
msgid "DOR KIREDON"
msgstr "DOR KIREDON"

#. Text 001 of map 343.
#. German: "~INK 30~ IN GESCHWUNGENER SCHRIFT STEHT HIER ZU LESEN:^^ ~INK 31~ \"ERINNERUNGEN AN DIE HEIMAT^ DIE SCHÖNSTEN SCHÄTZE AUS DEM SCHLOSS LYRAMION'S\""
#: AllTexts/3Map_texts.amb/343/001.txt
msgctxt "AllTexts/3Map_texts.amb/343/001"
msgid "~INK 30~ IN ELABORATE LETTERING, THE SIGN SAYS:^^ ~INK 31~ \"MEMORIES OF HOME^ THE MOST BEAUTIFUL TREASURES FROM LYRAMION CASTLE\""
msgstr "~INK 30~ AQUÍ SE LEE, EN LETRA FLOREADA:^^ ~INK 31~ \"RECUERDOS DEL HOGAR^ LOS TESOROS MÁS BELLOS DEL CASTILLO DE LYRAMION\""

#. Text 002 of map 343.
#. German: "SEELENSPIEGEL - DORBA'S MINE, GEFUNDEN 339"
#: AllTexts/3Map_texts.amb/343/002.txt
msgctxt "AllTexts/3Map_texts.amb/343/002"
msgid "MIRROR OF THE SOUL - DORBA'S MINE, FOUND 339"
msgstr "ESPEJO DEL ALMA - MINA DE DORBA, HALLADO EN 339"

#. Text 003 of map 343.
#. German: "FEUERFROST - DÖNNER'S MINE, GEFUNDEN 970"
#: AllTexts/3Map_texts.amb/343/003.txt
msgctxt "AllTexts/3Map_texts.amb/343/003"
msgid "FIRE FROST - DONNER'S MINE, FOUND 970"
msgstr "ESCARCHA DE FUEGO - MINA DE DONNER, HALLADA EN 970"

#. Text 004 of map 343.
#. German: "KRIEGSSTEIN - UNTERE GEMSTONE-MINEN, GEFUNDEN 547"
#: AllTexts/3Map_texts.amb/343/004.txt
msgctxt "AllTexts/3Map_texts.amb/343/004"
msgid "WAR STONE - LOWER GEMSTONE MINES, FOUND 547"
msgstr "PIEDRA DE GUERRA - MINAS INFERIORES DE GEMSTONE, HALLADA EN 547"

#. Text 005 of map 343.
#. German: "BERGSEELE - STEIN DER VORVÄTER"
#: AllTexts/3Map_texts.amb/343/005.txt
msgctxt "AllTexts/3Map_texts.amb/343/005"
msgid "MOUNTAIN SOUL - STONE OF THE FOREFATHERS"
msgstr "ALMA DE LA MONTAÑA - PIEDRA DE LOS ANTEPASADOS"

#. Text 006 of map 343.
#. German: "~INK 30~ UNTER EINEM STILISIERTEN KRUG STEHT GESCHRIEBEN:^^ \"GASTHAUS GEMSTONE\""
#: AllTexts/3Map_texts.amb/343/006.txt
msgctxt "AllTexts/3Map_texts.amb/343/006"
msgid "~INK 30~ UNDER A STYLISED BEER MUG IS WRITTEN:^^ \"GEMSTONE INN\""
msgstr "~INK 30~ BAJO UNA JARRA ESTILIZADA PONE:^^ \"POSADA GEMSTONE\""

#. Text 007 of map 343.
#. German: "~INK 30~ AUF DEM SCHILD IST ZU LESEN:^^ ~INK 31~ \"VERSUCHSMINE DOR KIREDON\""
#: AllTexts/3Map_texts.amb/343/007.txt
msgctxt "AllTexts/3Map_texts.amb/343/007"
msgid "~INK 30~ THE SIGN SAYS:^^ ~INK 31~ \"TEST MINE DOR KIREDON\""
msgstr "~INK 30~ EN EL LETRERO SE LEE:^^ ~INK 31~ \"MINA DE PRUEBAS DE DOR KIREDON\""

#. Text 008 of map 343.
#. German: "~INK 30~ EIN TRAURIGES KOPFSCHÜTTELN BEGLEITET DIE WORTE DES VOR EUCH STEHENDEN ZWERGES:^ ~INK 31~ \"DIE LUFTSCHIFFREISENDEN! NUN SEID AUCH IHR AUF DIESEM VERFLUCHTEN MOND GEFANGEN, DEN WIR FÜR UNSER PARADIES HIELTEN...\""
#: AllTexts/3Map_texts.amb/343/008.txt
msgctxt "AllTexts/3Map_texts.amb/343/008"
msgid "~INK 30~ THE DWARF BEFORE YOU SHAKES HIS HEAD SADLY AND SPEAKS:^ ~INK 31~ \"THE AIRSHIP TRAVELLERS! NOW YOU ARE ALSO IMPRISONED ON THIS DAMNED MOON WHICH WE THOUGHT WAS PARADISE...\""
msgstr "~INK 30~ EL ENANO QUE TENÉIS DELANTE MENEA LA CABEZA CON TRISTEZA MIENTRAS DICE:^ ~INK 31~ \"¡LOS VIAJEROS DE LA AERONAVE! AHORA TAMBIÉN VOSOTROS ESTÁIS ATRAPADOS EN ESTA LUNA MALDITA QUE CREÍMOS NUESTRO PARAÍSO...\""

#. Text 009 of map 343.
#. German: "~INK 30~ EUER GESPRÄCHSPARTNER IST IN EINE SCHWERE RÜSTUNG GEHÜLLT. ER SAGT:^ ~INK 31~ \"GRÜßE, IHR REISENDEN! ICH BIN CLUDKOR, DER WÄCHTER. NICHT, DASS ICH VIELE STREITEREIEN ZU SCHLICHTEN HÄTTE, FÜR MÜßIGGANG IST HIER SCHON MAL ZEIT.^ GEFAHR DROHT JEDOCH VON DEN VERRÜCKTEN BIESTERN UM UNS HERUM. MANCHMAL ÜBERWINDEN SIE SOGAR UNSERE STADTMAUER.\""
#: AllTexts/3Map_texts.amb/343/009.txt
msgctxt "AllTexts/3Map_texts.amb/343/009"
msgid "~INK 30~ THE PERSON YOU ARE TALKING TO IS WEARING HEAVY ARMOUR. HE SAYS:^ ~INK 31~ \"WELCOME, TRAVELLERS! I AM CLUDKOR, THE GUARD. IT IS NOT THAT I HAVE TO SETTLE MANY DISPUTES. THERE IS ALSO OCCASIONALLY TIME FOR REFLECTION.^ BUT DANGER THREATENS FROM THE MAD BEASTS AROUND US. SOMETIMES THEY EVEN CLAMBER OVER THE TOWN WALLS.\""
msgstr "~INK 30~ VUESTRO INTERLOCUTOR VA ENFUNDADO EN UNA PESADA ARMADURA. DICE:^ ~INK 31~ \"¡SALUDOS, VIAJEROS! SOY CLUDKOR, EL GUARDIA. NO ES QUE TENGA QUE ZANJAR MUCHAS RIÑAS; AQUÍ HAY TIEMPO DE SOBRA PARA HOLGAZANEAR.^ PERO EL PELIGRO ACECHA EN LAS BESTIAS ENLOQUECIDAS QUE NOS RODEAN. A VECES INCLUSO SALTAN NUESTRA MURALLA.\""

#. Text 010 of map 343.
#. German: "~INK 30~ IHR SPRECHT MIT EINER ÄLTEREN ZWERGIN. SIE MEINT:^ ~INK 31~ \"BESUCHT UNSEREN KRISTALLGARTEN, REISENDE, UND SEHT, WELCHE SCHÖNHEIT WIR WEGEN UNSERER NAIVEN HOFFNUNGEN FÜR IMMER AUFGEGEBEN HABEN!\""
#: AllTexts/3Map_texts.amb/343/010.txt
msgctxt "AllTexts/3Map_texts.amb/343/010"
msgid "~INK 30~ YOU SPEAK TO AN OLD DWARF LADY. SHE SAYS:^ ~INK 31~ \"VISIT OUR CRYSTAL GARDEN, TRAVELLERS, AND SEE WHAT BEAUTY WE HAVE GIVEN UP FOREVER THROUGH OUR NAIVE HOPES!\""
msgstr "~INK 30~ HABLÁIS CON UNA ENANA ANCIANA. OS DICE:^ ~INK 31~ \"VISITAD NUESTRO JARDÍN DE CRISTAL, VIAJEROS, ¡Y VED QUÉ BELLEZA HEMOS PERDIDO PARA SIEMPRE POR NUESTRAS INGENUAS ESPERANZAS!\""

#. Text 011 of map 343.
#. German: "~INK 30~ DAS SCHILD TRÄGT DIE AUFSCHRIFT:^^ ~INK 31~ \"FERRIN'S WERKSTATT^ WAFFEN UND WERKZEUGE\""
#: AllTexts/3Map_texts.amb/343/011.txt
msgctxt "AllTexts/3Map_texts.amb/343/011"
msgid "~INK 30~ THE SIGN READS:^^ ~INK 31~ \"FERRIN'S WORKSHOP^ WEAPONS AND TOOLS\""
msgstr "~INK 30~ EL LETRERO DICE:^^ ~INK 31~ \"TALLER DE FERRIN^ ARMAS Y HERRAMIENTAS\""

#. Text 012 of map 343.
#. German: "DIES IST EINER DER WENIGEN METALLGEGENSTÄNDE, DEN IHR BISHER AUF DEM WALDMOND GESEHEN HABT. IN FORM EINES MASSIVEN SCHLOSSES VERSPERRT ER EUCH DEN WEG IN DIE MINEN."
#: AllTexts/3Map_texts.amb/343/012.txt
msgctxt "AllTexts/3Map_texts.amb/343/012"
msgid "THIS IS ONE OF THE FEW METAL OBJECTS YOU HAVE SEEN ON THE FOREST MOON. IN THE FORM A MASSIVE LOCK IT BLOCKS YOUR WAY INTO THE MINES."
msgstr "ES UNO DE LOS POCOS OBJETOS DE METAL QUE HABÉIS VISTO HASTA AHORA EN LA LUNA DEL BOSQUE. EN FORMA DE UN CANDADO MACIZO, OS CIERRA EL PASO A LAS MINAS."

#. Text 013 of map 343.
#. German: "MIT EINEM SATTEN KLICKEN ÖFFNET SICH DAS SCHLOSS, UND IHR STEIGT EINE LEITER HERUNTER, DIE DIREKT HINTER DEM EINGANG IN EINEM SCHACHT STEHT."
#: AllTexts/3Map_texts.amb/343/013.txt
msgctxt "AllTexts/3Map_texts.amb/343/013"
msgid "THE LOCK OPENS WITH A SMOOTH CLICK AND YOU CLIMB DOWN A LADDER IN A SHAFT DIRECTLY BEYOND THE INTRANCE."
msgstr "CON UN CLIC SECO, LA CERRADURA SE ABRE Y BAJÁIS POR UNA ESCALERA DE MANO QUE HAY EN UN POZO JUSTO DETRÁS DE LA ENTRADA."

#. Text 014 of map 343.
#. German: "~INK 30~ IHR SPRECHT MIT EINEM WÄCHTER IN SCHWERER RÜSTUNG. ER SAGT:^ ~INK 31~ \"GRÜßE, LUFTSCHIFFREISENDE! EURE LANDUNG HAT EIN WENIG ABWECHSLUNG IN UNSEREN TRISTEN ALLTAG GEBRACHT. TUT MIR LEID, DASS IHR DAFÜR EINEN SO HOHEN PREIS BEZAHLEN MÜSST. DAS EXIL AUF DIESEM ELENDEN MOND IST KEIN ZUCKERSCHLECKEN.\""
#: AllTexts/3Map_texts.amb/343/014.txt
msgctxt "AllTexts/3Map_texts.amb/343/014"
msgid "~INK 30~ YOU SPEAK TO A GUARD WEARING HEAVY ARMOUR. HE SAYS:^ ~INK 31~ \"WELCOME, AIRSHIP TRAVELLERS! YOUR LANDING HAS BROUGHT A LITTLE DISTRACTION TO OUR SAD EXISTENCE. I AM SORRY YOU MUST PAY SUCH A HIGH PRICE. EXILE ON THIS HORRIBLE MOON IS NOT A HAPPY SITUATION.\""
msgstr "~INK 30~ HABLÁIS CON UN GUARDIA CON UNA PESADA ARMADURA. DICE:^ ~INK 31~ \"¡SALUDOS, VIAJEROS DE LA AERONAVE! VUESTRO ATERRIZAJE HA TRAÍDO UN POCO DE VARIEDAD A NUESTRA TRISTE RUTINA. SIENTO QUE TENGÁIS QUE PAGAR UN PRECIO TAN ALTO POR ELLO. EL EXILIO EN ESTA MISERABLE LUNA NO ES PRECISAMENTE UN CAMINO DE ROSAS.\""

#. Text 015 of map 343.
#. German: "~INK 30~ DIES IST EINER VON DOR KIREDON'S WÄCHTERN, DIE OHNE UNTERLASS DURCH DIE STRAßEN PATROULLIEREN. ER GRÜßT EUCH UND MEINT NUR:^ ~INK 31~ \"NEHMT EUCH VOR DEN BIESTERN DER WILDGEWORDENEN NATUR HIER IN ACHT!\""
#: AllTexts/3Map_texts.amb/343/015.txt
msgctxt "AllTexts/3Map_texts.amb/343/015"
msgid "~INK 30~ THIS IS ONE OF DOR KIREDON'S GUARDS WHO CONSTANTLY PATROLS THE STREETS. HE WELCOMES YOU AND SAYS ONLY:^ ~INK 31~ \"BEWARE OF THE WILD BEASTS OF NATURE!\""
msgstr "~INK 30~ ES UNO DE LOS GUARDIAS DE DOR KIREDON, QUE PATRULLAN SIN DESCANSO POR LAS CALLES. OS SALUDA Y SOLO DICE:^ ~INK 31~ \"¡GUARDAOS DE LAS BESTIAS DE ESTA NATURALEZA DESBOCADA!\""

#. Text 016 of map 343.
#. German: "~INK 30~ EIN BÜRGER DOR KIREDON'S SPRICHT MIT EUCH:^ ~INK 31~ \"VERLASST DIE STADT NICHT, OHNE GUT GEWAPPNET ZU SEIN! FERRIN IM SÜDOSTEN DOR KIREDON'S IST EIN MEISTER IN DER HERSTELLUNG RAFFINIERTER WAFFEN.\""
#: AllTexts/3Map_texts.amb/343/016.txt
msgctxt "AllTexts/3Map_texts.amb/343/016"
msgid "~INK 30~ A CITIZEN OF DOR KIREDON SPEAKS TO YOU:^ ~INK 31~ \"DO NOT LEAVE THE TOWN WITHOUT BEING WELL ARMED! FERRIN IN THE SOUTH EAST OF DOR KIREDON IS A MASTER IN THE MANUFACTURE OF CLEVER WEAPONS.\""
msgstr "~INK 30~ UN VECINO DE DOR KIREDON OS DICE:^ ~INK 31~ \"¡NO SALGÁIS DE LA CIUDAD SIN IR BIEN ARMADOS! FERRIN, EN EL SURESTE DE DOR KIREDON, ES UN MAESTRO EN LA FABRICACIÓN DE ARMAS INGENIOSAS.\""

#. Text 017 of map 343.
#. Placeholders: ~SELF~ = the hero (the player character). The gender of these persons is unknown.
#. German: "AUF EINEM PLATZ IN DER NÄHE DER STADTTORE KOMMT ES ZU EINER SPONTANEN VERSAMMLUNG. AUS DUTZENDEN VON AUFGEREGTEN FRAGEN UND ANTWORTEN ERGIBT SICH FÜR EUCH FOLGENDES BILD:^ ALS DAS VOLK DER ZWERGE VOR NUNMEHR ÜBER ZWANZIG JAHREN AUF DIESEM MOND LANDETE, STELLTE SICH SCHNELL HERAUS, DASS ES SOWOHL VON SEINEN AUFTRAGGEBERN ALS AUCH VON DEN EIGENEN TRÄUMEN ÜBEL VERRATEN WORDEN WAR: DAS VERMEINTLICHE PARADIES VOLLER SMARAGDE UND ANDERER EDELSTEINE STELLTE SICH ALS EIN DAMPFENDER DSCHUNGEL FREMDARTIGER PFLANZEN HERAUS. MANGELS WEITERER NAVIGATIONSSTEINE WAR DAS RIESIGE LUFTSCHIFF, MIT DEM DIE ZWERGE HIER ANGEKOMMEN WAREN, NICHT MEHR ZU GEBRAUCHEN.^ DIE ERSTEN JAHRE WAREN HART FÜR DIE GESTRANDETEN. DIE PFLANZEN- UND TIERWELT DES MONDES HATTE EINIGE SPEZIES AUFZUWEISEN, BEI DENEN GASTFREUNDSCHAFT NICHT ZU DEN HERAUSRAGENDSTEN EIGENSCHAFTEN GEHÖRTE. DIE MEISTEN DER RAUBKREATUREN HATTEN DIE KUNST DER TARNUNG BIS ZUR PERFEKTION ENTWICKELT UND GRIFFEN ÄUßERST ÜBERRASCHEND AN. DIE ZWERGE MACHTEN VIELE SCHMERZVOLLE ERFAHRUNGEN UND MUSSTEN VIELE OPFER BEKLAGEN, ABER SIE WUSSTEN BALD, WELCHE TIERE UND PFLANZEN IHNEN ALS NAHRUNG DIENEN KONNTEN UND WELCHE EHER DEN UMGEKEHRTEN VORGANG HERBEIFÜHRTEN.^ NACHDEM DER ERSTE SCHOCK DER ENTTÄUSCHUNG ÜBERWUNDEN WAR, WURDE EINE BEFESTIGTE ANLAGE GEBAUT, AUS DER MIT HILFE ZAHLREICHER HARTHÖLZER DIESE STADT WURDE. TROTZ DES MISSERFOLGS DER REISE BESTAND KIRE, DER ANFÜHRER DER ZWERGE, DARAUF, SOWOHL DIE STADT ALS AUCH DEN MOND NACH SICH ZU BENENNEN. VIELE BÜRGER DOR KIREDON'S BENUTZTEN ALLERDINGS AUSDRÜCKE WIE \"KOMPOSTHAUFEN\" STATT DES OFFIZIELLEN NAMENS \"KIRE'S MOND\".^ DEM VOLK DER ZWERGE WIRD EINE GEWISSE STARRKÖPFIGKEIT NACHGESAGT, UND SO VERSUCHTEN SIE ZUNÄCHST, AUCH UNTER DEN BEDINGUNGEN DER NEUEN WELT IHREN LEBENSSTIL BEIZUBEHALTEN. SOBALD DIE FRAGEN DES TÄGLICHEN ÜBERLEBENS GELÖST WAREN, BEGANN MAN DAMIT, DEN MOND UNTERIRDISCH ZU ERFORSCHEN. DIE ERGEBNISSE WAREN DEPRIMIEREND: KIRE'S MOND ERWIES SICH ALS SEHR METALLARM, UND NUR IN GRÖßEREN TIEFEN WAREN KÜMMERLICHE SPUREN VON EISEN UND MINERALIEN ZU FINDEN.^ NACH UNGEFÄHR ZEHN JAHREN TRAT EINE ENTWICKLUNG EIN, ÜBER DIE SICH DIE MEISTEN DER ZWERGE, DENEN IHR ZUHÖRT, NUR ZÖGERLICH ÄUßERN, ABER SCHLIEßLICH BEKOMMT IHR SOVIEL MIT, DASS SICH ZU DIESER ZEIT STIMMEN ERHOBEN, DIE NICHT MEHR IN DEN CHOR DES JAMMERNS UND KLAGENS ÜBER DAS LEBEN AUF DEM \"KOMPOSTHAUFEN\" EINSTIMMEN WOLLTEN. VIELE, VORNEHMLICH JÜNGERE ZWERGE HATTEN SICH EINGEHENDER MIT DER NATUR DES MONDES BEFASST. SIE GINGEN IN DIE WÄLDER, UM MEHR INFORMATIONEN ÜBER DIE NEUE WELT ZU SAMMELN. DIEJENIGEN, DIE ÜBERLEBTEN, BRACHTEN FAST IMMER NEUE ERKENNTISSE MIT. MANCHE VON IHNEN BLIEBEN IMMER LÄNGER IN DER WILDNIS, UND ES WURDE KLAR, DASS SIE BEGEISTERUNG FÜR DIE PFLANZEN UND TIERE DES MONDES VERSPÜRTEN. EINE GRUPPE DIESER WALDLÄUFER VERTRAT VEHEMENT DIE ANSICHT, MAN SOLLE DIE NATUR DES MONDES NICHT LÄNGER ALS FEIND BETRACHTEN, SONDERN LERNEN, MIT IHR UMZUGEHEN, UM BESSER ZU ÜBERLEBEN.^ FÜR DIE AUF TRADITION BEDACHTEN ZWERGE WAREN SOLCHE GEDANKEN NATÜRLICH NICHT AKZEPTABEL. SO ZOGEN LETZTENDLICH EINIGE DER ZWERGE AUS, UM IHRE EIGENE STADT, DOR GRESTIN, ZU GRÜNDEN, WO SIE NACH IHREN VORSTELLUNGEN LEBEN KONNTEN.^ SOVIEL IHR AUCH ÜBER DIE GESCHICHTE DES ZWERGENVOLKS ERFAHRT, SO VIELE FRAGEN MÜSST IHR AUCH ÜBER EUCH BEANTWORTEN. IHR SCHILDERT DIE SITUATION AUF LYRAMION, UND ~SELF~ BERICHTET VON EINIGEN EURER ABENTEUER. DIE ZWERGE LAUSCHEN GEBANNT UND ZEIGEN SICH SEHR ENTTÄUSCHT DARÜBER, DASS IHR NUR MIT EINEM SO KLEINEN LUFTSCHIFF UNTERWEGS WART, UND EUCH NOCH DAZU NUN IN DER GLEICHEN SITUATION BEFINDET WIE SIE: OHNE EINEN NAVIGATIONSSTEIN FÜR DAS SCHIFF STELLT KIRE'S MOND EIN EXIL FÜR DEN REST EUERES LEBENS DAR.^ AN DIESEM PUNKT DER DISKUSSION KOMMT DAS OBERHAUPT DER ZWERGE, KIRE, PERSÖNLICH HINZU. AUCH ER HEIßT EUCH WILLKOMMEN UND LÄSST SICH KURZ BERICHTEN. DANN ABER LÖST ER DIE VERSAMMLUNG AUF, UND LANGSAM GEHEN DIE ZWERGE IN DISKUTIERENDEN GRÜPPCHEN WIEDER AN IHR TAGWERK ZURÜCK. BEVOR AUCH KIRE SICH WIEDER SEINEN AUFGABEN ZUWENDET, BITTET ER EUCH, IHN MÖGLICHST BALD IN SEINER RESIDENZ IM NORDWESTEN DER STADT ZU BESUCHEN.^ IHR ATMET TIEF DURCH UND SEHT EUCH ZUM ERSTEN MAL BEWUSST DIE STADT AN."
#: AllTexts/3Map_texts.amb/343/017.txt
msgctxt "AllTexts/3Map_texts.amb/343/017"
msgid "A CROWD HAS GATHERED SPONTANEOUSLY ON A SQUARE CLOSE TO THE TOWN GATES. FROM DOZENS OF EXCITED QUESTIONS AND ANSWERS YOU DRAW UP THE FOLLOWING PICTURE:^ AS THE DWARF PEOPLE LANDED ON THIS MOON MORE THAN 20 YEARS AGO TODAY, IT QUICKLY BECAME CLEAR THAT THEY WERE BETRAYED BOTH BY THEIR CUSTOMERS AND THEIR OWN DREAMS. THE PROPOSED PARADISE FULL OF EMERALDS AND OTHER PRECIOUS STONES PROVED TO BE A STEAMILY HUMID JUNGLE OF STRANGE PLANTS. DUE TO A LACK OF MORE NAVIGATION STONES THE HUGE AIRSHIP WITH WHICH THE DWARFS ARRIVED HERE COULD NO LONGER BE USED. THE FIRST YEARS WERE HARD FOR THE STRANDED PEOPLE. THE PLANT AND ANIMAL WORLD ON THE MOON INCLUDED SOME SPECIES WHOSE CHARACTERISTICS DID NOT INCLUDE HOSPITALITY AND FRIENDSHIP. MOST OF THE PREDATORS HAD DEVELOPED THE ART OF CAMOUFLAGE TO PERFECTION AND ATTACKED IN MOST SURPRISING SITUATIONS. THE DWARFS ALL SUFFERED PAINFUL SURPRISES AND MANY OF THEM FELL VICTIM BUT THEY SOON FOUND OUT WHAT ANIMALS AND PLANTS THEY COULD USE AS FOOD AND WHAT OTHERS WOULD REVERSE THAT SITUATION.^ AFTER OVERCOMING THEIR INITIAL DISAPPOINTMENT AND SHOCK, A STRONG CAMP WAS BUILT WHICH WAS GRADUALLY EXTENDED WITH NUMEROUS HARDWOODS TO FORM THIS TOWN. DESPITE THE JOURNEY BEING UNSUCCESSFUL, KIRE, THE LEADER OF THE DWARFS, INSISTED THAT BOTH THE TOWN AND THE MOON SHOULD BE NAMED AFTER HIM. MANY CITIZENS OF DOR KIREDON HOWEVER USE EXPRESSIONS LIKE \"COMPOST HEAP\" INSTEAD OF THE OFFICIAL NAME \"KIRE'S MOON\".^ THE DWARF PEOPLE ARE SAID TO BE THICK-HEADED AND SO THEY INITIALLY TRIED TO MAINTAIN THEIR EXISTING LIFESTYLE IN THE NEW WORLD. AS SOON AS THE QUESTIONS OF DAILY SURVIVAL WERE SOLVED THEY BEGAN TO EXPLORE THE MOON BELOW GROUND LEVEL. THE RESULTS WERE DEPRESSING: KIRE'S MOON PROVED TO BE VERY POOR WITH REGARD TO THE METALS IT CONTAINED AND JUST A FEW TRACES OF IRON AND MINERALS WERE FOUND, AND ONLY AT GREAT DEPTHS.^ AFTER APPROXIMATELY 10 YEARS SOMETHING HAPPENED ABOUT WHICH MOST OF THE DWARFS YOU HEAR SPEAK WITH GREAT RELUCTANCE. HOWEVER, FINALLY YOU GATHER THAT AT THAT TIME SOME VOICES WERE RAISED WHICH WERE NOT JUST COMPLAINING ABOUT LIFE ON THE \"COMPOST HEAP\". MANY, PREDOMINANTLY THE YOUNGER DWARFS, HAD BECOME INVOLVED IN MORE DETAIL WITH THE NATURE OF THE MOON. THEY WENT INTO THE FORESTS TO GATHER MORE INFORMATION ABOUT THE NEW WORLD. THOSE THAT SURVIVED BROUGHT MORE KNOWLEDGE AND INFORMATION BACK WITH THEM. MANY OF THEM STAYED IN THE WILDERNESS FOR LONGER AND LONGER PERIODS AND IT BECAME CLEAR THAT THEY WERE BECOMING EXCITED ABOUT THE PLANTS AND THE ANIMALS ON THE MOON. A GROUP OF THESE FOREST VISITORS EXPRESSED THE VIEW THAT ONE SHOULD NO LONGER CONSIDER THE NATURE OF THE MOON AS AN ENEMY BUT SHOULD LEARN TO HANDLE IT IN ORDER TO SURVIVE BETTER.^ SUCH THOUGHTS WERE NATURALLY UNACCEPTABLE TO MANY OLDER, MORE TRADITIONAL DWARFS. FINALLY SOME OF THE DWARFS MOVED OUT TO ESTABLISH THEIR OWN TOWN, DOR GRESTIN, WHERE THEY COULD LIVE HOW THEY WANTED.^ HOWEVER MUCH YOU LEARN ABOUT THE HISTORY OF THE DWARF PEOPLE, THERE ARE ALWAYS MANY QUESTIONS YOU MUST ANSWER ABOUT YOURSELVES. YOU DESCRIBE THE SITUATION AT LYRAMION AND ~SELF~ REPORTS ABOUT SOME OF YOUR ADVENTURES. THE DWARFS LISTEN INTENTLY AND ARE VERY DISAPPOINTED THAT YOU WERE TRAVELLING ON SUCH A SMALL AIRSHIP AND THAT YOU ARE NOW IN THE SAME SITUATION AS THEY, WITHOUT A NAVIGATION STONE FOR THE SHIP. SO KIRE'S MOON IS NOW ALSO YOUR PLACE OF EXILE FOR THE REST OF YOUR LIFE.^ AT THIS POINT IN THE DISCUSSION THE LEADER OF THE DWARFS, KIRE HIMSELF, ARRIVES. HE ALSO WELCOMES YOU AND LISTENS TO WHAT YOU HAVE TO SAY. BUT THEN HE BREAKS UP THE MEETING AND SLOWLY THE DWARFS RETURN TO THEIR DAILY WORK, CHATTERING IN SMALL GROUPS. BEFORE KIRE RETURNS TO HIS WORK, HE ASKS YOU TO VISIT HIM AS SOON AS POSSIBLE AT THIS HOUSE IN THE NORTH WEST PART OF THE TOWN.^ YOU TAKE A DEEP BREATH AND FOR THE FIRST TIME TAKE A GOOD LOOK AT THE TOWN."
msgstr "EN UNA PLAZA CERCA DE LAS PUERTAS DE LA CIUDAD SE FORMA UNA REUNIÓN ESPONTÁNEA. DE DECENAS DE PREGUNTAS Y RESPUESTAS AGITADAS SACÁIS EN CLARO LO SIGUIENTE:^ CUANDO EL PUEBLO ENANO ATERRIZÓ EN ESTA LUNA, HACE YA MÁS DE VEINTE AÑOS, PRONTO QUEDÓ CLARO QUE LO HABÍAN TRAICIONADO TANTO QUIENES LES HICIERON EL ENCARGO COMO SUS PROPIOS SUEÑOS: EL SUPUESTO PARAÍSO LLENO DE ESMERALDAS Y OTRAS PIEDRAS PRECIOSAS RESULTÓ SER UNA JUNGLA HUMEANTE DE PLANTAS EXTRAÑAS. A FALTA DE MÁS NAVIPIEDRAS, LA GIGANTESCA AERONAVE EN EL QUE HABÍAN LLEGADO LOS ENANOS YA NO SERVÍA DE NADA. LOS PRIMEROS AÑOS FUERON DUROS PARA LOS NÁUFRAGOS. LA FLORA Y LA FAUNA DE LA LUNA CONTABAN CON ALGUNAS ESPECIES ENTRE CUYAS VIRTUDES NO DESTACABA PRECISAMENTE LA HOSPITALIDAD. LA MAYORÍA DE LAS CRIATURAS DEPREDADORAS HABÍAN LLEVADO EL ARTE DEL CAMUFLAJE A LA PERFECCIÓN Y ATACABAN DE LA FORMA MÁS INESPERADA. LOS ENANOS PASARON POR MUCHAS EXPERIENCIAS DOLOROSAS Y TUVIERON QUE LAMENTAR MUCHAS VÍCTIMAS, PERO PRONTO SUPIERON QUÉ ANIMALES Y PLANTAS PODÍAN SERVIRLES DE ALIMENTO Y CUÁLES MÁS BIEN PROVOCABAN EL PROCESO CONTRARIO.^ UNA VEZ SUPERADA LA PRIMERA CONMOCIÓN DE LA DECEPCIÓN, SE CONSTRUYÓ UN RECINTO FORTIFICADO QUE, CON AYUDA DE NUMEROSAS MADERAS DURAS, SE CONVIRTIÓ EN ESTA CIUDAD. PESE AL FRACASO DEL VIAJE, KIRE, EL CABECILLA DE LOS ENANOS, INSISTIÓ EN PONER SU NOMBRE TANTO A LA CIUDAD COMO A LA LUNA. SIN EMBARGO, MUCHOS VECINOS DE DOR KIREDON USABAN EXPRESIONES COMO \"ESTERCOLERO\" EN LUGAR DEL NOMBRE OFICIAL, \"LUNA DE KIRE\".^ AL PUEBLO ENANO SE LE ATRIBUYE CIERTA TOZUDEZ, ASÍ QUE AL PRINCIPIO INTENTARON MANTENER SU FORMA DE VIDA TAMBIÉN EN LAS CONDICIONES DEL NUEVO MUNDO. EN CUANTO RESOLVIERON LAS CUESTIONES DE LA SUPERVIVENCIA DIARIA, EMPEZARON A EXPLORAR EL SUBSUELO DE LA LUNA. LOS RESULTADOS FUERON DESOLADORES: LA LUNA DE KIRE RESULTÓ SER MUY POBRE EN METALES, Y SOLO A GRAN PROFUNDIDAD SE ENCONTRARON ESCASOS RASTROS DE HIERRO Y MINERALES.^ AL CABO DE UNOS DIEZ AÑOS SE PRODUJO UN CAMBIO DEL QUE LA MAYORÍA DE LOS ENANOS QUE ESCUCHÁIS SOLO HABLAN A REGAÑADIENTES, PERO AL FINAL OS ENTERÁIS DE QUE EN AQUELLA ÉPOCA SE ALZARON VOCES QUE YA NO QUERÍAN UNIRSE AL CORO DE LAMENTOS Y QUEJAS SOBRE LA VIDA EN EL \"ESTERCOLERO\". MUCHOS ENANOS, SOBRE TODO JÓVENES, SE HABÍAN OCUPADO A FONDO DE LA NATURALEZA DE LA LUNA. IBAN A LOS BOSQUES PARA REUNIR MÁS INFORMACIÓN SOBRE EL NUEVO MUNDO. LOS QUE SOBREVIVÍAN TRAÍAN CASI SIEMPRE NUEVOS CONOCIMIENTOS. ALGUNOS SE QUEDABAN CADA VEZ MÁS TIEMPO EN LA ESPESURA, Y QUEDÓ CLARO QUE SENTÍAN ENTUSIASMO POR LAS PLANTAS Y LOS ANIMALES DE LA LUNA. UN GRUPO DE ESTOS BATIDORES DEL BOSQUE DEFENDÍA CON VEHEMENCIA QUE NO HABÍA QUE SEGUIR VIENDO LA NATURALEZA DE LA LUNA COMO UNA ENEMIGA, SINO APRENDER A CONVIVIR CON ELLA PARA SOBREVIVIR MEJOR.^ PARA LOS ENANOS APEGADOS A LA TRADICIÓN, NATURALMENTE, TALES IDEAS ERAN INACEPTABLES. ASÍ QUE AL FINAL ALGUNOS ENANOS SE MARCHARON PARA FUNDAR SU PROPIA CIUDAD, DOR GRESTIN, DONDE PODÍAN VIVIR A SU MANERA.^ POR MUCHO QUE APRENDÁIS SOBRE LA HISTORIA DEL PUEBLO ENANO, TAMBIÉN TENÉIS QUE RESPONDER A MUCHAS PREGUNTAS SOBRE VOSOTROS. DESCRIBÍS LA SITUACIÓN EN LYRAMION, Y ~SELF~ RELATA ALGUNAS DE VUESTRAS AVENTURAS. LOS ENANOS ESCUCHAN FASCINADOS Y SE MUESTRAN MUY DECEPCIONADOS DE QUE VIAJARAIS EN UNA AERONAVE TAN PEQUEÑA Y DE QUE, ADEMÁS, AHORA OS ENCONTRÉIS EN SU MISMA SITUACIÓN: SIN UNA NAVIPIEDRA PARA LA NAVE, LA LUNA DE KIRE SERÁ VUESTRO EXILIO PARA EL RESTO DE VUESTRAS VIDAS.^ EN ESTE PUNTO DE LA DISCUSIÓN SE UNE EN PERSONA EL JEFE DE LOS ENANOS, KIRE. ÉL TAMBIÉN OS DA LA BIENVENIDA Y OS PIDE UN BREVE RELATO. PERO LUEGO DISUELVE LA REUNIÓN Y LOS ENANOS VUELVEN POCO A POCO A SUS QUEHACERES, DISCUTIENDO EN CORRILLOS. ANTES DE VOLVER TAMBIÉN A SUS TAREAS, KIRE OS PIDE QUE LO VISITÉIS CUANTO ANTES EN SU RESIDENCIA, AL NOROESTE DE LA CIUDAD.^ RESPIRÁIS HONDO Y, POR PRIMERA VEZ, OBSERVÁIS LA CIUDAD CON ATENCIÓN."

#. Text 018 of map 343.
#. German: "EINE HORDE RAUBTIERE ERKLIMMT DIE STADTMAUER UND STÜRZT SICH AUF EUCH."
#: AllTexts/3Map_texts.amb/343/018.txt
msgctxt "AllTexts/3Map_texts.amb/343/018"
msgid "A HOARD OF VICIOUS ANIMALS RUSHES UP THE TOWN WALLS AND LEAPS AT YOU."
msgstr "UNA HORDA DE FIERAS TREPA POR LA MURALLA Y SE ABALANZA SOBRE VOSOTROS."

#. Text 019 of map 343.
#. German: "EIN BEDROHLICHES SCHWIRREN ERTÖNT ÜBER EUREN KÖPFEN, ALS IHR PLÖTZLICH VON RIESIGEN INSEKTEN BEDROHT WERDET."
#: AllTexts/3Map_texts.amb/343/019.txt
msgctxt "AllTexts/3Map_texts.amb/343/019"
msgid "A THREATENING HUMMING SOUND IS HEARD AND YOU ARE SUDDENLY ATTACKED BY HUGE INSECTS."
msgstr "UN ZUMBIDO AMENAZADOR RESUENA SOBRE VUESTRAS CABEZAS CUANDO, DE REPENTE, OS ATACAN UNOS INSECTOS GIGANTESCOS."

#. Text 020 of map 343.
#. German: "GUT, DASS IHR DEN STINKENDEN PILZ BEI EUCH HABT: EIN SCHWARM VON RIESENINSEKTEN MACHT ANSTALTEN, SICH AUF EUCH ZU STÜRZEN, DREHT ABER AB, ALS ER IN DEN DUNSTKREIS DES PILZES KOMMT."
#: AllTexts/3Map_texts.amb/343/020.txt
msgctxt "AllTexts/3Map_texts.amb/343/020"
msgid "IT IS GOOD THAT YOU HAD THE STINKING MUSHROOM WITH YOU: A SWARM OF HUGE INSECTS APPEAR TO BE ABOUT TO ATTACK YOU BUT TURN AWAY WHEN THEY SMELL THE MUSHROOM."
msgstr "MENOS MAL QUE LLEVÁIS LA SETA APESTOSA: UN ENJAMBRE DE INSECTOS GIGANTES SE DISPONE A ABALANZARSE SOBRE VOSOTROS, PERO DA MEDIA VUELTA AL ENTRAR EN LA NUBE DE OLOR DE LA SETA."

#. Text 000 of map 344. The name of the map.
#. German: "FERRIN'S SCHMIEDE"
#: AllTexts/3Map_texts.amb/344/000.txt
msgctxt "AllTexts/3Map_texts.amb/344/000"
msgid "FERRIN'S SMITHY"
msgstr "HERRERÍA DE FERRIN"

#. Text 001 of map 344.
#. German: "~INK 30~ DER VOR EUCH STEHENDE ZWERG IST UNGLAUBLICH ALT. ER SPRICHT MIT ZITTRIGER STIMME:^ ~INK 31~ \"UND MIR SAGTEN SIE, ICH SOLLE MICH BERUHIGEN. ES SEI NICHTS, SAGTEN SIE. ICH HABE ES JEDE NACHT DORT UNTEN GESPÜRT, WIE SIE SUCHTEN UND SCHNÜFFELTEN. ABER ICH BIN JA ALT. ALT UND VERSCHROBEN...\"^ ~INK 30~ SEINE STIMME VERLIERT SICH IN UNVERSTÄNDLICHEM MURMELN."
#: AllTexts/3Map_texts.amb/344/001.txt
msgctxt "AllTexts/3Map_texts.amb/344/001"
msgid "~INK 30~ THE DWARF STANDING BEFORE YOU IS INCREDIBLY OLD. HE SPEAKS WITH A TREMBLING VOICE:^ ~INK 31~ \"AND THEY TOLD ME I SHOULD CALM DOWN. IT IS NOTHING, THEY SAID. I FELT IT EVERY NIGHT DOWN THERE, HOW THEY SEARCHED ALL AROUND. BUT I AM VERY OLD, OLD AND WORN OUT ...\"^ ~INK 30~ HIS VOICE BECAME LOST IN AN INCOMPREHENSIBLE MUMBLE."
msgstr "~INK 30~ EL ENANO QUE TENÉIS DELANTE ES INCREÍBLEMENTE VIEJO. HABLA CON VOZ TEMBLOROSA:^ ~INK 31~ \"Y ME DIJERON QUE ME CALMARA. QUE NO ERA NADA, DIJERON. YO LO NOTABA CADA NOCHE AHÍ ABAJO, CÓMO BUSCABAN Y HUSMEABAN. PERO CLARO, SOY VIEJO. VIEJO Y CHIFLADO...\"^ ~INK 30~ SU VOZ SE PIERDE EN UN MURMULLO INCOMPRENSIBLE."

#. Text 002 of map 344.
#. German: "~INK 30~ DIE ZAHLREICHEN WERKZEUGE IM GÜRTEL EURES GEGENÜBERS VERRATEN EUCH, DASS ES SICH HIER UM DEN GEHILFEN DES SCHMIEDS HANDELN MUSS. ER UNTERBRICHT SEINE ARBEIT, UM ZU SAGEN:^ ~INK 31~ \"FERRIN, MEIN MEISTER, IST EINER DER GRÖßTEN SCHMIEDE UNSERES VOLKS. ER HAT ES ALS EINZIGER UNTER DEN MEISTERSCHMIEDEN GESCHAFFT, SEINE KUNSTFERTIGKEIT AUCH AUF DIE HÖLZER DIESER WELT AUSZUDEHNEN. HEUTE STELLEN WIR WAHRE WUNDERWERKE AN WAFFEN UND WERKZEUGEN HER, DIE MEISTEN VON IHNEN AUS VEREDELTEM HARTHOLZ. SCHAUT EUCH DIE AUSWAHL AN DER THEKE AN. NORMALERWEISE WÜRDE FERRIN EUCH MIT STOLZ HERUMFÜHREN, ABER SEINE FAMILIE IST IN TRAUER.\""
#: AllTexts/3Map_texts.amb/344/002.txt
msgctxt "AllTexts/3Map_texts.amb/344/002"
msgid "~INK 30~ THE MANY TOOLS IN THE BELT OF THE PERSON OPPOSITE YOU TELL YOU HE MUST BE THE BLACKSMITH'S ASSISTANT. HE STOPS WORKING TO SAY:^ ~INK 31~ \"FERRIN, MY MASTER, IS ONE OF THE GREATEST BLACKSMITHS OUR PEOPLE HAVE EVER HAD. ONLY HE, OF ALL THE MASTER BLACKSMITHS, MANAGED TO EXTEND HIS ARTISTIC SKILLS TO THE WOOD FOUND ON THIS WORLD. TODAY WE PRODUCE TRULY WONDERFUL WEAPONS AND TOOLS, MOST OF THEM OF REFINED HARDWOOD. LOOK AT THE ASSORTMENT ON THE COUNTER. NORMALLY FERRIN WOULD ALSO SHOW YOU ROUND WITH PRIDE BUT HIS FAMILY IS IN MOURNING.\""
msgstr "~INK 30~ LAS NUMEROSAS HERRAMIENTAS QUE LLEVA AL CINTO OS REVELAN QUE DEBE DE SER EL AYUDANTE DEL HERRERO. INTERRUMPE SU TRABAJO PARA DECIR:^ ~INK 31~ \"FERRIN, MI MAESTRO, ES UNO DE LOS MAYORES HERREROS DE NUESTRO PUEBLO. ES EL ÚNICO DE LOS MAESTROS HERREROS QUE HA LOGRADO EXTENDER SU ARTE TAMBIÉN A LAS MADERAS DE ESTE MUNDO. HOY FABRICAMOS VERDADERAS MARAVILLAS EN ARMAS Y HERRAMIENTAS, LA MAYORÍA DE MADERA DURA REFINADA. ECHAD UN VISTAZO AL SURTIDO DEL MOSTRADOR. NORMALMENTE, FERRIN OS LO ENSEÑARÍA TODO CON ORGULLO, PERO SU FAMILIA ESTÁ DE LUTO.\""

#. Text 003 of map 344.
#. German: "~INK 30~ DER VERKÄUFER PREIST FERRIN'S SORTIMENT AN:^ ~INK 31~ \"WERKZEUGE UND WAFFEN AUS HOLZ, WIE SIE DIE MEISTEN NICHT AUS METALL MACHEN KÖNNTEN! KOMMT VOR DIE VERKAUFSTHEKE, UND ICH ZEIGE EUCH UNSERE AUSWAHL!\""
#: AllTexts/3Map_texts.amb/344/003.txt
msgctxt "AllTexts/3Map_texts.amb/344/003"
msgid "~INK 30~ THE SALESMAN CONSIDERS FERRIN'S ASSORTMENT:^ ~INK 31~ \"TOOLS AND WEAPONS MADE OF WOOD, BETTER THAN MOST PEOPLE MAKE OUT OF METAL! COME TO THE COUNTER AND I WILL SHOW YOU WHAT WE HAVE!\""
msgstr "~INK 30~ EL VENDEDOR ALABA EL SURTIDO DE FERRIN:^ ~INK 31~ \"¡HERRAMIENTAS Y ARMAS DE MADERA COMO LA MAYORÍA NO SABRÍA HACERLAS NI DE METAL! ACERCAOS AL MOSTRADOR Y OS ENSEÑARÉ LO QUE TENEMOS.\""

#. Text 004 of map 344.
#. German: "~INK 30~ IHR KOMMT MIT EINEM GRÜNGEKLEIDETEN ZWERG INS GESPRÄCH. ER SAGT:^ ~INK 31~ \"DIESER TAGE HERRSCHT GEDRÜCKTE STIMMUNG IN FERRIN'S HAUS. ICH HABE GEHÖRT, SEINER KLEINEN TOCHTER SOLL ETWAS PASSIERT SEIN. IHR WISST, DASS WIR ZWERGE NICHT GERADE OFT MIT KINDERN GESEGNET WERDEN, UND SO IST DER VERLUST UNBESCHREIBLICH.\""
#: AllTexts/3Map_texts.amb/344/004.txt
msgctxt "AllTexts/3Map_texts.amb/344/004"
msgid "~INK 30~ YOU GET INTO CONVERSATION WITH A DWARF DRESSED IN GREEN. HE SAYS:^ ~INK 31~ \"THERE IS A DEPRESSED ATMOSPHERE IN FERRIN'S HOUSE THESE DAYS. I BELIEVE SOMETHING HAPPENED TO HIS LITTLE DAUGHTER. YOU KNOW THAT WE DWARFS ARE NOT OFTEN BLESSED WITH CHILDREN, SO THE LOSS IS INDESCRIBABLE.\""
msgstr "~INK 30~ OS PONÉIS A CHARLAR CON UN ENANO VESTIDO DE VERDE. DICE:^ ~INK 31~ \"ESTOS DÍAS REINA UN AMBIENTE SOMBRÍO EN CASA DE FERRIN. HE OÍDO QUE LE HA PASADO ALGO A SU HIJA PEQUEÑA. YA SABÉIS QUE A LOS ENANOS NO NOS BENDICEN LOS HIJOS MUY A MENUDO, ASÍ QUE LA PÉRDIDA ES INDESCRIPTIBLE.\""

#. Text 005 of map 344.
#. German: "DAS VERRIEGELTE SCHLOSS AN DIESER TÜR IST AUS HOLZ, ABER VON EINER BEMERKENSWERTEN QUALITÄT."
#: AllTexts/3Map_texts.amb/344/005.txt
msgctxt "AllTexts/3Map_texts.amb/344/005"
msgid "THE LOCK ON THIS DOOR IS MADE OF WOOD BUT IS NEVERTHELESS OF EXCEPTIONAL QUALITY."
msgstr "LA CERRADURA DE ESTA PUERTA ES DE MADERA, PERO DE UNA CALIDAD NOTABLE."

#. Text 006 of map 344.
#. German: "FERRIN'S SCHLÜSSEL PASST ERWARTUNGSGEMÄß PERFEKT. IHR BETRETET DIE DAHINTERLIEGENDE TREPPE UND GELANGT IN DEN KELLER."
#: AllTexts/3Map_texts.amb/344/006.txt
msgctxt "AllTexts/3Map_texts.amb/344/006"
msgid "FERRIN'S KEY FITS PERFECTLY, AS EXPECTED. YOU ENTER THE STAIRCASE AND REACH THE CELLAR."
msgstr "COMO ERA DE ESPERAR, LA LLAVE DE FERRIN ENCAJA A LA PERFECCIÓN. TOMÁIS LA ESCALERA QUE HAY DETRÁS Y LLEGÁIS AL SÓTANO."

#. Text 007 of map 344.
#. German: "\"VIELEN DANK, EDLE REISENDE!\""
#: AllTexts/3Map_texts.amb/344/007.txt
msgctxt "AllTexts/3Map_texts.amb/344/007"
msgid "\"MANY THANKS, NOBLE TRAVELLERS!\""
msgstr "\"¡MUCHAS GRACIAS, NOBLES VIAJEROS!\""

#. Text 008 of map 344.
#. German: "~INK 30~ DIES IST FERRIN'S FRAU. SIE HAT VERQUOLLENE, ROTGERÄNDERTE AUGEN UND SCHÜTTELT NUR DEN KOPF, ALS IHR SIE ANSPRECHT."
#: AllTexts/3Map_texts.amb/344/008.txt
msgctxt "AllTexts/3Map_texts.amb/344/008"
msgid "~INK 30~ THIS IS FERRIN'S WIFE. HER EYES ARE RED AND TEARFUL. SHE SHAKES HER HEAD WHEN SHE SPEAKS."
msgstr "~INK 30~ ES LA ESPOSA DE FERRIN. TIENE LOS OJOS HINCHADOS Y ENROJECIDOS, Y SE LIMITA A NEGAR CON LA CABEZA CUANDO LE HABLÁIS."

#. Text 009 of map 344.
#. German: "\"SEID GEGRÜßT! WENN IHR REPARATURBEDÜRFTIGE DINGE BEI EUCH HABT, KÜMMERN WIR UNS GERNE DARUM. KOMMT VOR DIE THEKE!\""
#: AllTexts/3Map_texts.amb/344/009.txt
msgctxt "AllTexts/3Map_texts.amb/344/009"
msgid "\"WELCOME! IF YOU HAVE ANYTHING NEEDING REPAIR, WE SHALL BE PLEASED TO DO IT FOR YOU. COME TO THE COUNTER!\""
msgstr "\"¡SALUDOS! SI TRAÉIS ALGO QUE NECESITE REPARACIÓN, NOS OCUPAREMOS DE ELLO CON GUSTO. ¡ACERCAOS AL MOSTRADOR!\""

#. Text 010 of map 344.
#. German: "DIES IST EIN AMBOSS AUS HARTEM, GRANITÄHNLICHEM GESTEIN."
#: AllTexts/3Map_texts.amb/344/010.txt
msgctxt "AllTexts/3Map_texts.amb/344/010"
msgid "THIS IS AN ANVIL OF A HARD STONE SIMILAR TO GRANITE."
msgstr "ES UN YUNQUE DE UNA PIEDRA DURA, PARECIDA AL GRANITO."

#. Text 011 of map 344.
#. German: "EINS VON FERRIN'S WERKZEUGEN."
#: AllTexts/3Map_texts.amb/344/011.txt
msgctxt "AllTexts/3Map_texts.amb/344/011"
msgid "ONE OF FERRIN'S TOOLS."
msgstr "UNA DE LAS HERRAMIENTAS DE FERRIN."

#. Text 000 of map 345. The name of the map.
#: AllTexts/3Map_texts.amb/345/000.txt
msgctxt "AllTexts/3Map_texts.amb/345/000"
msgid "MINE"
msgstr "MINA"

#. Text 001 of map 345.
#. German: "HINTER EUCH ERTÖNT EIN KRACHEN, ALS GADRIN DAS TOR WIEDER VERSCHLIEßT."
#: AllTexts/3Map_texts.amb/345/001.txt
msgctxt "AllTexts/3Map_texts.amb/345/001"
msgid "YOU HEAR A CRASH BEHIND YOU AS GADRIN LOCKS THE GATE AGAIN."
msgstr "OÍS UN ESTRÉPITO A VUESTRA ESPALDA CUANDO GADRIN VUELVE A CERRAR LA PUERTA."

#. Text 002 of map 345.
#. Placeholders: ~SELF~ = the hero (the player character). The gender of these persons is unknown.
#. German: "AUF GADRIN IST VERLASS: AUF ~SELF~'S KLOPFEN HIN REIßT ER DAS TOR AUF UND BEGRÜßT EUCH ERFREUT."
#: AllTexts/3Map_texts.amb/345/002.txt
msgctxt "AllTexts/3Map_texts.amb/345/002"
msgid "GADRIN IS RELIABLE: AT ~SELF~S KNOCKING, HE PULLS THE GATE OPEN AND WELCOMES YOU WITH PLEASURE."
msgstr "PODÉIS CONTAR CON GADRIN: EN CUANTO ~SELF~ LLAMA, ABRE LA PUERTA DE UN TIRÓN Y OS RECIBE CON ALEGRÍA."

#. Text 003 of map 345.
#. German: "GADRIN SCHLIEßT DAS TOR EILIG WIEDER."
#: AllTexts/3Map_texts.amb/345/003.txt
msgctxt "AllTexts/3Map_texts.amb/345/003"
msgid "GADRIN CLOSES THE GATE AGAIN QUICKLY."
msgstr "GADRIN VUELVE A CERRAR LA PUERTA A TODA PRISA."

#. Text 004 of map 345.
#. German: "HIER LIEGT EIN BROCKEN BERNSTEIN."
#: AllTexts/3Map_texts.amb/345/004.txt
msgctxt "AllTexts/3Map_texts.amb/345/004"
msgid "THERE IS A PIECE OF AMBER. ␀ "
msgstr "AQUÍ HAY UN TROZO DE ÁMBAR."

#. Text 000 of map 346. The name of the map.
#. German: "DORINA'S HÖHLE"
#: AllTexts/3Map_texts.amb/346/000.txt
msgctxt "AllTexts/3Map_texts.amb/346/000"
msgid "DORINA'S CAVE"
msgstr "CUEVA DE DORINA"

#. Text 001 of map 346.
#. German: "DER BODEN AN DIESER STELLE IST NUR EINE ILLUSION!^ DER STURZ VERLÄUFT GLIMPFLICH UND FÜHRT EUCH IN TIEFERE BEREICHE DER HÖHLE."
#: AllTexts/3Map_texts.amb/346/001.txt
msgctxt "AllTexts/3Map_texts.amb/346/001"
msgid "THE GROUND AT THIS POINT IS JUST AN ILLUSION!^ THE SLOPE IS DARK AND GLOOMY AND LEADS YOU DEEPER INTO THE CAVE."
msgstr "¡EL SUELO EN ESTE PUNTO ES SOLO UNA ILUSIÓN!^ LA CAÍDA NO ES GRAVE Y OS LLEVA A ZONAS MÁS PROFUNDAS DE LA CUEVA."

#. Text 002 of map 346.
#. German: "KEIN KLUGER GEDANKE, IN DIE FLAMMEN ZU LAUFEN! DER SCHMERZ IST UNERTRÄGLICH."
#: AllTexts/3Map_texts.amb/346/002.txt
msgctxt "AllTexts/3Map_texts.amb/346/002"
msgid "IT WAS NOT CLEVER TO RUN INTO THE FLAMES! THE PAIN IS UNBEARABLE."
msgstr "¡NO HA SIDO BUENA IDEA METERSE EN LAS LLAMAS! EL DOLOR ES INSOPORTABLE."

#. Text 003 of map 346.
#. German: "MIT EINEM DUMPFEN KNALL PLATZT DIE BLASENFRUCHT, SOBALD SIE MIT DEN FLAMMEN IN BERÜHRUNG KOMMT. EIN GAS STRÖMT AUS UND LÖSCHT DIE FLAMMEN."
#: AllTexts/3Map_texts.amb/346/003.txt
msgctxt "AllTexts/3Map_texts.amb/346/003"
msgid "THE FRUIT EXPLODES WITH A DULL CRASH AS SOON AS IT COMES INTO CONTACT WITH THE FLAMES. GAS STREAMS OUT AND QUENCHES THE FLAMES."
msgstr "CON UN ESTALLIDO SORDO, EL FRUTO BURBUJA REVIENTA EN CUANTO TOCA LAS LLAMAS. SALE UN GAS QUE APAGA EL FUEGO."

#. Text 004 of map 346.
#. German: "ALS DIE PFLANZE IHRE FARBE WECHSELT, VERSTUMMT EIN LEISES ZISCHEN IN DER FERNE."
#: AllTexts/3Map_texts.amb/346/004.txt
msgctxt "AllTexts/3Map_texts.amb/346/004"
msgid "AS THE PLANT CHANGES ITS COLOUR, A GENTLE HISSING IN THE DISTANCE DIES AWAY."
msgstr "CUANDO LA PLANTA CAMBIA DE COLOR, UN LEVE SILBIDO SE APAGA A LO LEJOS."

#. Text 005 of map 346.
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "DIE KLAUENBEWEHRTE PFLANZE ERWEIST SICH ALS SCHRECKLICHE REALITÄT. VOLLER ENTSETZEN SEHT IHR, WIE SIE BEGINNT, ~LEAD~ FÖRMLICH IN STÜCKE ZU REIßEN."
#: AllTexts/3Map_texts.amb/346/005.txt
msgctxt "AllTexts/3Map_texts.amb/346/005"
msgid "THE PLANT WITH CLAWS PROVES TO BE A HORRIBLE REALITY. TERRIFIED, YOU SEE HOW IT STARTS TO TEAR ~LEAD~ TO PIECES."
msgstr "LA PLANTA ARMADA DE GARRAS RESULTA SER UNA TERRIBLE REALIDAD. HORRORIZADOS, VEIS CÓMO EMPIEZA A HACER LITERALMENTE PEDAZOS A ~LEAD~."

#. Text 006 of map 346.
#. German: "AN DIESER PFLANZE HÄNGEN LEICHTE, BLASENARTIGE FRÜCHTE."
#: AllTexts/3Map_texts.amb/346/006.txt
msgctxt "AllTexts/3Map_texts.amb/346/006"
msgid "BRIGHT COLOURED FRUITS HANG ON THIS PLANT."
msgstr "DE ESTA PLANTA CUELGAN FRUTOS LIGEROS CON FORMA DE BURBUJA."

#. Text 007 of map 346.
#. German: "DAS ZISCHEN ERTÖNT WIEDER."
#: AllTexts/3Map_texts.amb/346/007.txt
msgctxt "AllTexts/3Map_texts.amb/346/007"
msgid "THE HISSING STARTS AGAIN."
msgstr "EL SILBIDO VUELVE A OÍRSE."

#. Text 008 of map 346.
#. German: "AUF EINE LEICHTE BERÜHRUNG HIN ÖFFNET SICH DIE TÜR SOFORT."
#: AllTexts/3Map_texts.amb/346/008.txt
msgctxt "AllTexts/3Map_texts.amb/346/008"
msgid "THE DOOR OPENS IMMEDIATELY AT THE SLIGHTEST TOUCH."
msgstr "AL MÁS LEVE ROCE, LA PUERTA SE ABRE AL INSTANTE."

#. Text 009 of map 346.
#. German: "IRGENDWO IN DER HÖHLE ERTÖNT EIN KNIRSCHEN..."
#: AllTexts/3Map_texts.amb/346/009.txt
msgctxt "AllTexts/3Map_texts.amb/346/009"
msgid "A GRINDING NOISE IS HEARD FROM SOMEWHERE IN THE CAVE"
msgstr "EN ALGÚN LUGAR DE LA CUEVA SE OYE UN CRUJIDO..."

#. Text 000 of map 347. The name of the map.
#. German: "DORINA'S HÖHLE UNTEN"
#: AllTexts/3Map_texts.amb/347/000.txt
msgctxt "AllTexts/3Map_texts.amb/347/000"
msgid "DORINA'S CAVE, BELOW"
msgstr "CUEVA DE DORINA, ABAJO"

#. Text 001 of map 347.
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "DIE KLAUENBEWEHRTE PFLANZE ERWEIST SICH ALS SCHRECKLICHE REALITÄT. VOLLER ENTSETZEN SEHT IHR, WIE SIE BEGINNT, ~LEAD~ FÖRMLICH IN STÜCKE ZU REIßEN."
#: AllTexts/3Map_texts.amb/347/001.txt
msgctxt "AllTexts/3Map_texts.amb/347/001"
msgid "THE PLANT WITH CLAWS PROVES TO BE A HORRIFIC REALITY. FULL OF TERROR YOU SEE HOW IT BEGINS TO TEAR ~LEAD~ APART."
msgstr "LA PLANTA ARMADA DE GARRAS RESULTA SER UNA TERRIBLE REALIDAD. HORRORIZADOS, VEIS CÓMO EMPIEZA A HACER LITERALMENTE PEDAZOS A ~LEAD~."

#. Text 002 of map 347.
#. German: "KEIN KLUGER GEDANKE, IN DIE FLAMMEN ZU LAUFEN! DER SCHMERZ IST UNERTRÄGLICH."
#: AllTexts/3Map_texts.amb/347/002.txt
msgctxt "AllTexts/3Map_texts.amb/347/002"
msgid "IT WAS NOT CLEVER TO RUN INTO THE FLAMES! THE PAIN IS UNBEARABLE."
msgstr "¡NO HA SIDO BUENA IDEA METERSE EN LAS LLAMAS! EL DOLOR ES INSOPORTABLE."

#. Text 003 of map 347.
#. German: "MIT EINEM DUMPFEN KNALL PLATZT DIE BLASENFRUCHT, SOBALD SIE MIT DEN FLAMMEN IN BERÜHRUNG KOMMT. EIN GAS STRÖMT AUS UND LÖSCHT DIE FLAMMEN."
#: AllTexts/3Map_texts.amb/347/003.txt
msgctxt "AllTexts/3Map_texts.amb/347/003"
msgid "THE FRUIT EXPLODES WITH A DULL ROAR AS SOON AS IT COMES INTO CONTACT WITH THE FLAMES. GAS FLOWS OUT AND QUENCHES THE FLAMES."
msgstr "CON UN ESTALLIDO SORDO, EL FRUTO BURBUJA REVIENTA EN CUANTO TOCA LAS LLAMAS. SALE UN GAS QUE APAGA EL FUEGO."

#. Text 004 of map 347.
#. German: "AUF EINE LEICHTE BERÜHRUNG HIN ÖFFNET SICH DIE TÜR SOFORT."
#: AllTexts/3Map_texts.amb/347/004.txt
msgctxt "AllTexts/3Map_texts.amb/347/004"
msgid "THE DOOR OPENS IMMEDIATELY AT THE SLIGHTEST TOUCH."
msgstr "AL MÁS LEVE ROCE, LA PUERTA SE ABRE AL INSTANTE."

#. Text 005 of map 347.
#. German: "EIN LIEBLICHER DUFT STRÖMT EUCH ENTGEGEN. HIER IST EIN GARTEN AUS TOPFPFLANZEN ANGELEGT WORDEN."
#: AllTexts/3Map_texts.amb/347/005.txt
msgctxt "AllTexts/3Map_texts.amb/347/005"
msgid "A DELIGHTFUL AROMA SPREADS AROUND YOU. THIS IS A GARDEN FULL OF POTTED PLANTS."
msgstr "OS ENVUELVE UN AROMA DELICIOSO. AQUÍ HAN PLANTADO UN JARDÍN DE PLANTAS EN MACETAS."

#. Text 006 of map 347.
#. German: "VOR EUCH LIEGT EIN WOHNLICH EINGERICHTETER RAUM. EINE ZWERGIN FÄHRT HERUM UND BLICKT EUCH MIT EINEM AUSDRUCK MAßLOSER ÜBERRASCHUNG AN."
#: AllTexts/3Map_texts.amb/347/006.txt
msgctxt "AllTexts/3Map_texts.amb/347/006"
msgid "BEFORE YOU LIES A COMFORTABLE ROOM. A DWARF LADY WALKS AROUND AND LOOKS AT YOU WITH AN EXPRESSION OF UNFATHOMABLE SURPRISE. ␀ "
msgstr "ANTE VOSOTROS HAY UNA ESTANCIA ACOGEDORA. UNA ENANA SE DA LA VUELTA DE GOLPE Y OS MIRA CON CARA DE INMENSA SORPRESA."

#. Text 000 of map 348. The name of the map.
#. German: "MINE - 2. EBENE"
#: AllTexts/3Map_texts.amb/348/000.txt
msgctxt "AllTexts/3Map_texts.amb/348/000"
msgid "MINE - SECOND LEVEL"
msgstr "MINA - SEGUNDO NIVEL"

#. Text 001 of map 348.
#. German: "EIN TIEFES, HEISERES KNURREN ERTÖNT, ALS DAS TORNAK EUCH ERBLICKT. DAS TIER ENTBLÖßT SEINE FÄNGE, GREIFT ABER NOCH NICHT AN..."
#: AllTexts/3Map_texts.amb/348/001.txt
msgctxt "AllTexts/3Map_texts.amb/348/001"
msgid "YOU HEAR A DEEP THROATY RUMBLE AS THE TORNAK SEES YOU. THE ANIMAL BARES ITS FANGS BUT DOES NOT ATTACK YET ..."
msgstr "EL TORNAK SUELTA UN GRUÑIDO PROFUNDO Y RONCO AL VEROS. LA BESTIA ENSEÑA LOS COLMILLOS, PERO AÚN NO ATACA..."

#. Text 002 of map 348.
#. German: "NACH DEM KAMPF RICHTET SICH EUER BLICK AUF DAS GROßE EI, DAS OFFENBAR VON DER BESTIE BESCHÜTZT WURDE."
#: AllTexts/3Map_texts.amb/348/002.txt
msgctxt "AllTexts/3Map_texts.amb/348/002"
msgid "AFTER THE BATTLE YOU CATCH SIGHT OF A LARGE EGG WHICH WAS APPARENTLY PROTECTED BY THE BEAST."
msgstr "TRAS EL COMBATE, VUESTRA MIRADA SE DIRIGE AL GRAN HUEVO QUE, POR LO VISTO, PROTEGÍA LA BESTIA."

#. Text 003 of map 348.
#. German: "SOWIE IHR DEM EI NAHEKOMMT, STÜRZT SICH DIE BESTIE MIT EINEM OHRENBETÄUBENDEN BRÜLLEN AUF EUCH."
#: AllTexts/3Map_texts.amb/348/003.txt
msgctxt "AllTexts/3Map_texts.amb/348/003"
msgid "AS SOON YOU APPROACH THE EGG THE BEAST HURTLES TOWARDS YOU WITH A DEAFENING ROAR."
msgstr "EN CUANTO OS ACERCÁIS AL HUEVO, LA BESTIA SE ABALANZA SOBRE VOSOTROS CON UN RUGIDO ENSORDECEDOR."

#. Text 004 of map 348.
#. German: "DAS RIESIGE TORNAK SETZT EUCH NICHT NACH, ALS IHR DEN RÜCKZUG ANTRETET."
#: AllTexts/3Map_texts.amb/348/004.txt
msgctxt "AllTexts/3Map_texts.amb/348/004"
msgid "THE GIGANTIC TORNAK DOES NOT FOLLOW YOU AS YOU RETREAT."
msgstr "EL ENORME TORNAK NO OS PERSIGUE CUANDO OS RETIRÁIS."

#. Text 005 of map 348.
#. German: "ETWAS ERSTAUNLICHES PASSIERT: DIE BESTIEN KNURREN UND FAUCHEN ZWAR, GREIFEN JEDOCH NICHT AN. ANSCHEINEND SPÜREN SIE, DASS IHR DAS EI BEI EUCH HABT."
#: AllTexts/3Map_texts.amb/348/005.txt
msgctxt "AllTexts/3Map_texts.amb/348/005"
msgid "SOMETHING ASTONISHING HAPPENS: THE BEASTS GROWL AND SNAP BUT DO NOT ATTACK. YOU THEN REALISE THAT THIS IS BECAUSE YOU HAVE THE EGG WITH YOU."
msgstr "OCURRE ALGO ASOMBROSO: LAS BESTIAS GRUÑEN Y BUFAN, PERO NO ATACAN. AL PARECER, NOTAN QUE LLEVÁIS EL HUEVO CON VOSOTROS."

#. Text 006 of map 348.
#. German: "AUS DEM BEREICH VOR EUCH STEIGT EUCH EIN GRÄSSLICHER GESTANK ENTGEGEN, UND AUCH DIE GERÄUSCHE LASSEN NICHTS GUTES VERMUTEN. IHR ZIEHT DIE AUFMERKSAMKEIT VON ZAHLREICHEN TORNAKS AUF EUCH."
#: AllTexts/3Map_texts.amb/348/006.txt
msgctxt "AllTexts/3Map_texts.amb/348/006"
msgid "A HORRIBLE SMELL COMES FROM THE AREA AHEAD AND THE SOUNDS YOU HEAR ARE QUITE FRIGHTENING. YOU HAVE ATTRACTED THE ATTENTION OF MANY TORNAKS."
msgstr "DE LA ZONA QUE TENÉIS DELANTE OS LLEGA UN HEDOR ESPANTOSO, Y LOS RUIDOS TAMPOCO AUGURAN NADA BUENO. ATRAÉIS LA ATENCIÓN DE NUMEROSOS TORNAKS."

#. Text 007 of map 348.
#. German: "AN DIESER STELLE GIBT DIE HÖHLENWAND UNTER DEN SCHLÄGEN DER SPITZHACKE NACH."
#: AllTexts/3Map_texts.amb/348/007.txt
msgctxt "AllTexts/3Map_texts.amb/348/007"
msgid "AT THIS POINT THE WALL OF THE CAVE GIVES UNDER THE HAMMERING OF THE PICKAXE."
msgstr "EN ESTE PUNTO, LA PARED DE LA CUEVA CEDE BAJO LOS GOLPES DEL PICO."

#. Text 008 of map 348.
#. German: "HIER LIEGT EIN BROCKEN BERNSTEIN."
#: AllTexts/3Map_texts.amb/348/008.txt
msgctxt "AllTexts/3Map_texts.amb/348/008"
msgid "HERE LIES A PIECE OF AMBER."
msgstr "AQUÍ HAY UN TROZO DE ÁMBAR."

#. Text 000 of map 349. The name of the map.
#. German: "RUINENTURM"
#: AllTexts/3Map_texts.amb/349/000.txt
msgctxt "AllTexts/3Map_texts.amb/349/000"
msgid "RUINED TOWER"
msgstr "TORRE EN RUINAS"

#. Text 001 of map 349.
#. German: "UM EUCH HERUM BEFINDEN SICH DIE ÜBERRESTE EINES EINSTMALS PRÄCHTIGEN GEBÄUDES. DIESER TURM MUSS MEHRERE DUTZEND METER HOCH GEWESEN SEIN, BEVOR ER IM LAUF DER JAHRTAUSENDE VERFIEL."
#: AllTexts/3Map_texts.amb/349/001.txt
msgctxt "AllTexts/3Map_texts.amb/349/001"
msgid "ALL AROUND YOU LIE THE REMAINS OF WHAT WAS ONCE A SPLENDID BUILDING. THIS TOWER MUST HAVE BEEN SEVERAL HUNDRED FEET HIGH BEFORE IT COLLAPSED OVER THE OF YEARS."
msgstr "A VUESTRO ALREDEDOR SE ENCUENTRAN LOS RESTOS DE UN EDIFICIO ANTAÑO ESPLÉNDIDO. ESTA TORRE DEBIÓ DE MEDIR VARIAS DECENAS DE METROS DE ALTURA ANTES DE DERRUMBARSE CON EL PASO DE LOS MILENIOS."

#. Text 000 of map 350. The name of the map.
#. German: "EINGANG DER ALTEN RUINEN"
#: AllTexts/3Map_texts.amb/350/000.txt
msgctxt "AllTexts/3Map_texts.amb/350/000"
msgid "ENTRANCE TO THE OLD RUINS"
msgstr "ENTRADA DE LAS VIEJAS RUINAS"

#. Text 001 of map 350.
#. German: "ABERMALS STÜRZT IHR DURCH DAS LOCH IM BODEN. IHR LANDET MIT EINEM HARTEN AUFPRALL EIN STOCKWERK TIEFER."
#: AllTexts/3Map_texts.amb/350/001.txt
msgctxt "AllTexts/3Map_texts.amb/350/001"
msgid "AGAIN YOU FALL THROUGH THE HOLE IN THE FLOOR. YOU CRASH HEAVILY ONTO THE FLOOR ONE LEVEL BELOW."
msgstr "OTRA VEZ CAÉIS POR EL AGUJERO DEL SUELO Y ATERRIZÁIS CON UN FUERTE GOLPE UN PISO MÁS ABAJO."

#. Text 002 of map 350.
#. German: "DIE PLATTE INMITTEN DIESER FREMDARTIGEN VORRICHTUNG SENKT SICH SANFT NACH UNTEN, SOBALD IHR AUF IHR STEHT."
#: AllTexts/3Map_texts.amb/350/002.txt
msgctxt "AllTexts/3Map_texts.amb/350/002"
msgid "THE PANEL IN THE CENTRE OF THIS STRANGE DEVICE MOVES DOWN GENTLY AS SOON AS YOU STAND ON IT."
msgstr "LA PLACA EN EL CENTRO DE ESTE EXTRAÑO DISPOSITIVO DESCIENDE SUAVEMENTE EN CUANTO OS SUBÍS A ELLA."

#. Text 003 of map 350.
#. German: "HIER FÄLLT TAGESLICHT DURCH EIN LOCH IN DER DECKE."
#: AllTexts/3Map_texts.amb/350/003.txt
msgctxt "AllTexts/3Map_texts.amb/350/003"
msgid "DAYLIGHT STREAMS THROUGH A HOLE IN THE CEILING."
msgstr "AQUÍ ENTRA LA LUZ DEL DÍA POR UN AGUJERO DEL TECHO."

#. Text 004 of map 350.
#. German: "GERADE ALS IHR DURCH DIE TÜR GEGANGEN SEID, BRICHT EIN TEIL DER DECKE HERUNTER UND BEGRÄBT DEN DURCHGANG UNTER SICH."
#: AllTexts/3Map_texts.amb/350/004.txt
msgctxt "AllTexts/3Map_texts.amb/350/004"
msgid "JUST AS YOU PASS THROUGH THE DOOR, PART OF THE CEILING COLLAPSES AND BURIES THE PASSAGEWAY."
msgstr "JUSTO DESPUÉS DE CRUZAR LA PUERTA, UNA PARTE DEL TECHO SE DESPLOMA Y SEPULTA EL PASADIZO."

#. Text 000 of map 351. The name of the map.
#. German: "KELLERGEWÖLBE"
#: AllTexts/3Map_texts.amb/351/000.txt
msgctxt "AllTexts/3Map_texts.amb/351/000"
msgid "CELLAR AREA"
msgstr "BÓVEDA DEL SÓTANO"

#. Text 001 of map 351.
#. German: "DER BERNSTEINBROCKEN ERWECKT DIE SELTSAME VORRICHTUNG ZUM LEBEN. LANGSAM SCHLIEßT SICH DER OBERE BEREICH, EIN SUMMEN HÄNGT IN DER LUFT. IHR SEHT, DASS EIN PULSIERENDER STROM VON ENERGIE AUS DEM GERÄT IN DEN BODEN GELEITET WIRD."
#: AllTexts/3Map_texts.amb/351/001.txt
msgctxt "AllTexts/3Map_texts.amb/351/001"
msgid "THE PIECE OF AMBER BRINGS THE STRANGE MACHINE TO LIFE. SLOWLY THE UPPER PART CLOSES AND A HUMMING SOUND FILLS THE AIR. YOU SEE THAT A PULSATING FLOW OF ENERGY SPREADS FROM THE UNIT TO THE GROUND."
msgstr "EL TROZO DE ÁMBAR DA VIDA AL EXTRAÑO DISPOSITIVO. LA PARTE SUPERIOR SE CIERRA LENTAMENTE Y UN ZUMBIDO FLOTA EN EL AIRE. VEIS QUE DEL APARATO SALE UN FLUJO PULSANTE DE ENERGÍA QUE SE CANALIZA HACIA EL SUELO."

#. Text 002 of map 351.
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "~LEAD~ BETRACHTET DAS SELTSAME GERÄT, DAS VOR DER FELSWAND STEHT, GENAU. EINE FUNKTION LÄSST SICH NICHT OHNE WEITERES ERKENNEN, ABER IM STAUB AUF DEM BODEN UNTER DER ANTIKEN VORRICHTUNG SIND KLEINE BERNSTEINKRÜMEL ZU SEHEN."
#: AllTexts/3Map_texts.amb/351/002.txt
msgctxt "AllTexts/3Map_texts.amb/351/002"
msgid "~LEAD~ CAREFULLY EXAMINES THE STRANGE APPARATUS IN FRONT OF THE ROCK FACE. ITS FUNCTION IS UNKNOWN, BUT IN THE FLOOR DUST UNDER THE MACHINE SMALL AMBER FRAGMENTS ARE VISIBLE."
msgstr "~LEAD~ EXAMINA CON ATENCIÓN EL EXTRAÑO APARATO QUE HAY ANTE LA PARED DE ROCA. SU FUNCIÓN NO SALTA A LA VISTA, PERO EN EL POLVO DEL SUELO, BAJO EL ANTIGUO DISPOSITIVO, SE VEN PEQUEÑAS MIGAS DE ÁMBAR."

#. Text 000 of map 352. The name of the map.
#. German: "MINE - 2. EBENE"
#: AllTexts/3Map_texts.amb/352/000.txt
msgctxt "AllTexts/3Map_texts.amb/352/000"
msgid "MINE - SECOND LEVEL"
msgstr "MINA - SEGUNDO NIVEL"

#. Text 001 of map 352.
#. German: "EIN TIEFES, HEISERES KNURREN ERTÖNT, ALS DAS TORNAK EUCH ERBLICKT. DAS TIER ENTBLÖßT SEINE FÄNGE, GREIFT ABER NOCH NICHT AN..."
#: AllTexts/3Map_texts.amb/352/001.txt
msgctxt "AllTexts/3Map_texts.amb/352/001"
msgid "A DEEP HUSKY GROWL IS HEARD AS THE TORNAK SEES YOU. THE ANIMAL BARES ITS FANGS BUT DOES NOT ATTACK YET ..."
msgstr "EL TORNAK SUELTA UN GRUÑIDO PROFUNDO Y RONCO AL VEROS. LA BESTIA ENSEÑA LOS COLMILLOS, PERO AÚN NO ATACA..."

#. Text 002 of map 352.
#. German: "NACH DEM KAMPF RICHTET SICH EUER BLICK AUF DAS GROßE EI, DAS OFFENBAR VON DER BESTIE BESCHÜTZT WURDE."
#: AllTexts/3Map_texts.amb/352/002.txt
msgctxt "AllTexts/3Map_texts.amb/352/002"
msgid "AFTER THE BATTLE YOU CATCH SIGHT OF THE LARGE EGG WHICH WAS APPARENTLY PROTECTED BY THE BEAST."
msgstr "TRAS EL COMBATE, VUESTRA MIRADA SE DIRIGE AL GRAN HUEVO QUE, POR LO VISTO, PROTEGÍA LA BESTIA."

#. Text 003 of map 352.
#. German: "SOWIE IHR DEM EI NAHEKOMMT, STÜRZT SICH DIE BESTIE MIT EINEM OHRENBETÄUBENDEN BRÜLLEN AUF EUCH."
#: AllTexts/3Map_texts.amb/352/003.txt
msgctxt "AllTexts/3Map_texts.amb/352/003"
msgid "AS SOON AS YOU COME CLOSE TO THE EGG, THE BEAST ATTACKS YOU WITH A DEAFENING ROAR."
msgstr "EN CUANTO OS ACERCÁIS AL HUEVO, LA BESTIA SE ABALANZA SOBRE VOSOTROS CON UN RUGIDO ENSORDECEDOR."

#. Text 004 of map 352.
#. German: "DAS RIESIGE TORNAK SETZT EUCH NICHT NACH, ALS IHR DEN RÜCKZUG ANTRETET."
#: AllTexts/3Map_texts.amb/352/004.txt
msgctxt "AllTexts/3Map_texts.amb/352/004"
msgid "THE GIGANTIC TORNAK DOES NOT FOLLOW YOU AS YOU RETREAT."
msgstr "EL ENORME TORNAK NO OS PERSIGUE CUANDO OS RETIRÁIS."

#. Text 005 of map 352.
#. German: "ETWAS ERSTAUNLICHES PASSIERT: DIE BESTIEN KNURREN UND FAUCHEN ZWAR, GREIFEN JEDOCH NICHT AN. ANSCHEINEND SPÜREN SIE, DASS IHR DAS EI BEI EUCH HABT."
#: AllTexts/3Map_texts.amb/352/005.txt
msgctxt "AllTexts/3Map_texts.amb/352/005"
msgid "SOMETHING ASTONISHING HAPPENS: THE BEASTS GROWL AND ROAR BUT DO NOT ATTACK. THEN YOU NOTICE THAT YOU HAVE THE EGG WITH YOU."
msgstr "OCURRE ALGO ASOMBROSO: LAS BESTIAS GRUÑEN Y BUFAN, PERO NO ATACAN. AL PARECER, NOTAN QUE LLEVÁIS EL HUEVO CON VOSOTROS."

#. Text 006 of map 352.
#. German: "AUS DEM BEREICH VOR EUCH STEIGT EUCH EIN GRÄSSLICHER GESTANK ENTGEGEN, UND AUCH DIE GERÄUSCHE LASSEN NICHTS GUTES VERMUTEN. IHR ZIEHT DIE AUFMERKSAMKEIT VON ZAHLREICHEN TORNAKS AUF EUCH."
#: AllTexts/3Map_texts.amb/352/006.txt
msgctxt "AllTexts/3Map_texts.amb/352/006"
msgid "A HORRIBLE STENCH RISES FROM THE AREA AHEAD OF YOU AND THE SOUNDS YOU HEAR ARE QUITE FRIGHTENING. YOU CATCH THE ATTENTION OF NUMEROUS TORNAKS."
msgstr "DE LA ZONA QUE TENÉIS DELANTE OS LLEGA UN HEDOR ESPANTOSO, Y LOS RUIDOS TAMPOCO AUGURAN NADA BUENO. ATRAÉIS LA ATENCIÓN DE NUMEROSOS TORNAKS."

#. Text 007 of map 352.
#. German: "AN DIESER STELLE GIBT DIE HÖHLENWAND UNTER DEN SCHLÄGEN DER SPITZHACKE NACH."
#: AllTexts/3Map_texts.amb/352/007.txt
msgctxt "AllTexts/3Map_texts.amb/352/007"
msgid "AT THIS POINT THE WALL OF THE CAVE GIVES UNDER THE HAMMERING WITH THE PICKAXE."
msgstr "EN ESTE PUNTO, LA PARED DE LA CUEVA CEDE BAJO LOS GOLPES DEL PICO."

#. Text 008 of map 352.
#. German: "HIER LIEGT EIN BROCKEN BERNSTEIN."
#: AllTexts/3Map_texts.amb/352/008.txt
msgctxt "AllTexts/3Map_texts.amb/352/008"
msgid "HERE LIES A PIECE OF AMBER."
msgstr "AQUÍ HAY UN TROZO DE ÁMBAR."

#. Text 000 of map 353. The name of the map.
#. German: "KIRE'S RESIDENZ"
#: AllTexts/3Map_texts.amb/353/000.txt
msgctxt "AllTexts/3Map_texts.amb/353/000"
msgid "KIRE'S RESIDENCE"
msgstr "RESIDENCIA DE KIRE"

#. Text 001 of map 353.
#. German: "VOR EUCH LIEGT EIN SAAL, IN DEM DIE PRACHT DES ALTEN ZWERGENREICHS NOCH EINMAL AUFZUBLÜHEN SCHEINT. DIE POLIERTEN STEINPLATTEN DES BODENS SCHILLERN IN ALLEN FARBEN, UND PRÄCHTIGE SÄULEN UND WANDBEHÄNGE ZIEREN DEN RAUM, IN DESSEN MITTE EIN IMPOSANTER THRON STEHT."
#: AllTexts/3Map_texts.amb/353/001.txt
msgctxt "AllTexts/3Map_texts.amb/353/001"
msgid "AHEAD LIES A HALL IN WHICH THE SPLENDOUR OF THE OLD DWARF ERA APPEARS TO BLOSSOM ONCE AGAIN. THE POLISHED STONE FLAGS ON THE FLOOR SHIMMER IN EVERY COLOUR AND SPLENDID COLUMNS AND WALL-COVERINGS DECORATE THE ROOM IN THE CENTRE OF WHICH STANDS AN IMPOSING THRONE."
msgstr "ANTE VOSOTROS SE ABRE UNA SALA EN LA QUE EL ESPLENDOR DEL ANTIGUO REINO ENANO PARECE FLORECER DE NUEVO. LAS LOSAS PULIDAS DEL SUELO RELUCEN CON TODOS LOS COLORES, Y MAGNÍFICAS COLUMNAS Y TAPICES ADORNAN LA ESTANCIA, EN CUYO CENTRO SE ALZA UN TRONO IMPONENTE."

#. Text 002 of map 353.
#. German: "~INK 30~ DIE UNTERSETZTE ZWERGENWACHE SAGT:^ ~INK 31~ \"DEN GÖTTERN SEI DANK, DASS IHR DORINA ZU KIRE ZURÜCKGEBRACHT HABT. SEINE MISSGELAUNTHEIT IST ENDLICH VON IHM GEWICHEN.\""
#: AllTexts/3Map_texts.amb/353/002.txt
msgctxt "AllTexts/3Map_texts.amb/353/002"
msgid "~INK 30~ THE SHORT DWARF GUARD SAYS:^ ~INK 31~ \"THANKS BE TO THE GODS THAT YOU HAVE BROUGHT DORINA BACK TO KIRE. HIS BAD TEMPER IS FINALLY OVER.\""
msgstr "~INK 30~ EL ACHAPARRADO GUARDIA ENANO DICE:^ ~INK 31~ \"GRACIAS A LOS DIOSES QUE HABÉIS DEVUELTO A DORINA JUNTO A KIRE. POR FIN SE LE HA PASADO EL MAL HUMOR.\""

#. Text 003 of map 353.
#. German: "~INK 30~ EIN KRÄFTIGER ZWERG STEHT HIER WACHE. ER BRUMMT:^ ~INK 31~ \"IST JA KAUM AUSZUHALTEN! FRIEDE, FREUDE, EIERKUCHEN!\""
#: AllTexts/3Map_texts.amb/353/003.txt
msgctxt "AllTexts/3Map_texts.amb/353/003"
msgid "~INK 30~ A POWERFUL DWARF IS STANDING GUARD HERE. HE GROWLS:^ ~INK 31~ \"I CAN HARDLY STAND IT! PEACE, JOY AND PANCAKES!\""
msgstr "~INK 30~ AQUÍ MONTA GUARDIA UN ENANO FORNIDO. REZONGA:^ ~INK 31~ \"¡ESTO NO HAY QUIEN LO AGUANTE! ¡TANTA PAZ, TANTA ALEGRÍA Y TODOS COMIENDO PERDICES!\""

#. Text 004 of map 353.
#. German: "~INK 30~ EIN WÜRDIG DREINBLICKENDER ZWERG IN WALLENDEN GEWÄNDERN SPRICHT EUCH AN:^ ~INK 31~ \"WILLKOMMEN, WILLKOMMEN, IN KIRE'S HAUS, DAS DANK EUCH NUN AUCH WIEDER DORINA'S HEIM IST!\""
#: AllTexts/3Map_texts.amb/353/004.txt
msgctxt "AllTexts/3Map_texts.amb/353/004"
msgid "~INK 30~ A SERIOUS LOOKING DWARF IN VOLUMINOUS CLOTHING SPEAKS TO YOU:^ ~INK 31~ \"WELCOME, WELCOME TO KIRE'S HOUSE, WHICH THANKS TO YOU IS NOW ALSO DORINA'S HOME AGAIN!\""
msgstr "~INK 30~ UN ENANO DE ASPECTO SOLEMNE, ENVUELTO EN AMPLIOS ROPAJES, SE DIRIGE A VOSOTROS:^ ~INK 31~ \"¡BIENVENIDOS, BIENVENIDOS A LA CASA DE KIRE, QUE GRACIAS A VOSOTROS VUELVE A SER TAMBIÉN EL HOGAR DE DORINA!\""

#. Text 005 of map 353.
#. German: "~INK 30~ EIN URALTER ZWERG HUMPELT HIER VOR SICH HIN. ER MEINT:^ ~INK 31~ \"AH, DIE RETTER DES HAUSFRIEDENS! IHR HABT MEINEN SOHN WIEDER GLÜCKLICH GEMACHT.\""
#: AllTexts/3Map_texts.amb/353/005.txt
msgctxt "AllTexts/3Map_texts.amb/353/005"
msgid "~INK 30~ AN ANCIENT DWARF LIMPS AROUND. HE SAYS:^ ~INK 31~ \"AH, THE SAVIOURS OF THE PEACE! YOU HAVE MADE MY SON HAPPY AGAIN.\""
msgstr "~INK 30~ UN ENANO VIEJÍSIMO CAMINA AQUÍ COJEANDO. COMENTA:^ ~INK 31~ \"¡AH, LOS QUE HAN DEVUELTO LA PAZ A ESTA CASA! HABÉIS HECHO FELIZ OTRA VEZ A MI HIJO.\""

#. Text 006 of map 353.
#. German: "~INK 30~ DIE STÄMMIGE ZWERGENFRAU MACHT EINEN RESOLUTEN EINDRUCK. SIE SCHEINT KIRE'S HAUSHALT VORZUSTEHEN. JETZT STRAHLT SIE EUCH GERADEZU AN:^ ~INK 31~ \"GRÜßE, ABENTEURER! AUCH ICH MÖCHTE EUCH IM NAMEN DES GANZEN HAUSHALTS FÜR DIE RÜCKHOLUNG DORINA'S MEINEN DANK AUSSPRECHEN!\""
#: AllTexts/3Map_texts.amb/353/006.txt
msgctxt "AllTexts/3Map_texts.amb/353/006"
msgid "~INK 30~ THE WELL-BUILT DWARF LADY APPEARS RESOLUTE. IT SEEMS SHE MANAGES KIRE'S HOUSEHOLD. SHE BEAMS AT YOU:^ ~INK 31~ \"WELCOME, ADVENTURERS! I, TOO, WOULD LIKE TO THANK YOU ON BEHALF OF THE ENTIRE HOUSEHOLD FOR RETURNING DORINA!\""
msgstr "~INK 30~ LA ROBUSTA ENANA DA UNA IMPRESIÓN DE GRAN DETERMINACIÓN. PARECE QUE ES ELLA QUIEN GOBIERNA LA CASA DE KIRE. AHORA OS DEDICA UNA SONRISA RADIANTE:^ ~INK 31~ \"¡SALUDOS, AVENTUREROS! ¡YO TAMBIÉN QUIERO DAROS LAS GRACIAS EN NOMBRE DE TODA LA CASA POR HABER TRAÍDO DE VUELTA A DORINA!\""

#. Text 007 of map 353.
#. German: "~INK 30~ IHR SEHT EINE ZWERGENDAME MITTLEREN ALTERS. IHRE KLEIDUNG LÄSST DARAUF SCHLIEßEN, DASS SIE DIE KÖCHIN DER RESIDENZ IST. SIE MEINT:^ ~INK 31~ \"SEID GEGRÜßT, EDLE REISENDE! ES MACHT GROßE FREUDE, HIER ZU ARBEITEN, SEIT DORINA WIEDER BEI UNS IST!\""
#: AllTexts/3Map_texts.amb/353/007.txt
msgctxt "AllTexts/3Map_texts.amb/353/007"
msgid "~INK 30~ YOU SEE A DWARF LADY OF MIDDLE AGE. IT SEEMS FROM HER CLOTHING THAT SHE IS THE HEAD COOK OF THE HOUSEHOLD. SHE SAYS:^ ~INK 31~ \"WELCOME, NOBLE TRAVELLERS! IT IS WONDERFUL TO WORK HERE NOW THAT DORINA IS BACK AGAIN!\""
msgstr "~INK 30~ VEIS A UNA DAMA ENANA DE MEDIANA EDAD. POR SU ROPA, DIRÍASE QUE ES LA COCINERA DE LA RESIDENCIA. OS DICE:^ ~INK 31~ \"¡SALUDOS, NOBLES VIAJEROS! ¡DA GUSTO TRABAJAR AQUÍ DESDE QUE DORINA HA VUELTO CON NOSOTROS!\""

#. Text 008 of map 353.
#. German: "~INK 30~ VOR EUCH STEHT EIN HELLHAARIGER ZWERG UND SAGT:^ ~INK 31~ \"DORINA IST DANK EUCH ZURÜCKGEKEHRT! HOFFENTLICH HABEN KIRE'S CHOLERISCHE ANFÄLLE NUN EIN ENDE!\""
#: AllTexts/3Map_texts.amb/353/008.txt
msgctxt "AllTexts/3Map_texts.amb/353/008"
msgid "~INK 30~ BEFORE YOU STANDS A LIGHT-HAIRED DWARF WHO SAYS:^ ~INK 31~ \"THANKS TO YOU, DORINA HAS RETURNED! HOPEFULLY KIRE'S FITS OF ANGER WILL NOW BE AT AN END!\""
msgstr "~INK 30~ ANTE VOSOTROS HAY UN ENANO DE PELO CLARO QUE DICE:^ ~INK 31~ \"¡GRACIAS A VOSOTROS, DORINA HA VUELTO! ¡OJALÁ SE ACABEN AHORA LOS ATAQUES DE CÓLERA DE KIRE!\""

#. Text 009 of map 353.
#. German: "~INK 30~ DIE REISE NACH DOR KIREDON VERLÄUFT FÜR DIE GRUPPE UND DORINA OHNE GRÖßERE ZWISCHENFÄLLE. ENDLICH ERREICHT IHR DIE STADT UND BETRETET KIRE'S RESIDENZ. DORINA STREBT OHNE ZU ZÖGERN DEM THRONSAAL ZU UND LÄUFT FAST IN KIRE HINEIN, DER HINTER EINER SÄULE HERVORTRITT. BEIDE STARREN SICH AN WIE VOM DONNER GERÜHRT. SEKUNDEN VERSTREICHEN UND DEHNEN SICH ZU ENDLOSEN MOMENTEN. KIRE UND DORINA ÖFFNEN DEN MUND GLEICHZEITIG UND SCHLIEßEN IHN WIEDER. MAN SPÜRT FÖRMLICH, WIE BEIDE EINE IM GEISTE VORBEREITETE REDE VERWERFEN.^ DANN GEHT EIN RUCK DURCH DIE BEIDEN LANGE GETRENNTEN LEBENSGEFÄHRTEN, UND SIE SCHLIEßEN SICH WORTLOS IN DIE ARME. ERST NACH EINIGER ZEIT KOMMEN DIE WORTE, UND SCHLIEßLICH REDEN UND LACHEN KIRE UND DORINA, ALS WOLLTEN SIE ZEHN JAHRE SPRACHLOSIGKEIT IN EIN PAAR STUNDEN WIEDER WETTMACHEN. GERADE WOLLT IHR EUCH ZURÜCKZIEHEN, DA WENDET SICH DORINA EUCH ZU UND MEINT:^ ~INK 31~ \"WIR SOLLTEN BEI ALLER FREUDE DOCH NICHT VERGESSEN, WER DIESES WIEDERSEHEN ERST ERMÖGLICHT HAT! KOMMT ZU UNS, MEINE FREUNDE!\""
#: AllTexts/3Map_texts.amb/353/009.txt
msgctxt "AllTexts/3Map_texts.amb/353/009"
msgid "~INK 30~ THE JOURNEY TO DOR KIREDON WAS UNEVENTFUL FOR THE GROUP AND DORINA. FINALLY YOU REACH THE TOWN AND ENTER KIRE'S RESIDENCE. WITHOUT HESITATING, DORINA GOES STRAIGHT TO THE THRONE ROOM AND ALMOST RUNS INTO KIRE, WHO STEPS OUT FROM BEHIND A COLUMN. THEY STARE AT EACH OTHER AS IF FROZEN. SECONDS PASS AND BECOME ENDLESS MOMENTS. KIRE AND DORINA BOTH OPEN THEIR MOUTHS AT THE SAME TIME AND CLOSE THEM AGAIN. IT IS CLEAR THEY ARE BOTH FINDING IT DIFFICULT TO SPEAK.^ THEN, HAVING BEEN APART FOR SUCH A LONG TIME, THEY FINALLY AND SILENTLY TAKE EACH OTHER IN THEIR ARMS. IT TAKES THEM SOME TIME TO FIND THE RIGHT WORDS AND KIRE AND DORINA ARE FINALLY ABLE TO TALK AND LAUGH AS IF MAKING UP FOR TEN YEARS SEPARATION IN JUST A FEW SECONDS. YOU TURN TO WITHDRAW AND DORINA SAYS TO YOU:^ ~INK 31~ \"DESPITE ALL OUR JOY WE SHOULD NOT FORGET WHO HAS MADE THIS POSSIBLE! COME HERE, MY FRIENDS!\""
msgstr "~INK 30~ EL VIAJE A DOR KIREDON TRANSCURRE SIN GRANDES INCIDENTES PARA EL GRUPO Y DORINA. POR FIN LLEGÁIS A LA CIUDAD Y ENTRÁIS EN LA RESIDENCIA DE KIRE. DORINA SE DIRIGE SIN DUDARLO A LA SALA DEL TRONO Y CASI SE CHOCA CON KIRE, QUE SALE DE DETRÁS DE UNA COLUMNA. LOS DOS SE QUEDAN MIRÁNDOSE COMO FULMINADOS POR UN RAYO. LOS SEGUNDOS PASAN Y SE ESTIRAN HASTA PARECER ETERNOS. KIRE Y DORINA ABREN LA BOCA A LA VEZ Y LA VUELVEN A CERRAR. CASI SE NOTA CÓMO AMBOS DESECHAN EL DISCURSO QUE HABÍAN PREPARADO MENTALMENTE.^ ENTONCES, LOS DOS COMPAÑEROS DE VIDA, TANTO TIEMPO SEPARADOS, SE ESTREMECEN Y SE FUNDEN EN UN ABRAZO SIN DECIR PALABRA. SOLO AL CABO DE UN RATO LLEGAN LAS PALABRAS, Y AL FINAL KIRE Y DORINA HABLAN Y RÍEN COMO SI QUISIERAN RECUPERAR EN UNAS HORAS DIEZ AÑOS DE SILENCIO. JUSTO CUANDO IBAIS A RETIRAROS, DORINA SE VUELVE HACIA VOSOTROS Y DICE:^ ~INK 31~ \"¡CON TANTA ALEGRÍA NO DEBEMOS OLVIDAR A QUIENES HAN HECHO POSIBLE ESTE REENCUENTRO! ¡VENID CON NOSOTROS, AMIGOS MÍOS!\""

#. Text 010 of map 353.
#. German: "DIESE KISTE IST LEER."
#: AllTexts/3Map_texts.amb/353/010.txt
msgctxt "AllTexts/3Map_texts.amb/353/010"
msgid "THIS BOX IS EMPTY."
msgstr "ESTA CAJA ESTÁ VACÍA."

#. Text 011 of map 353.
#. German: "NICHTS WEITER ALS ALTE KLEIDUNGSSTÜCKE UND UNNÜTZES ZEUG."
#: AllTexts/3Map_texts.amb/353/011.txt
msgctxt "AllTexts/3Map_texts.amb/353/011"
msgid "NOTHING OTHER THAN OLD CLOTHING AND USELESS BITS AND PIECES."
msgstr "NADA MÁS QUE ROPA VIEJA Y TRASTOS INÚTILES."

#. Text 012 of map 353.
#. German: "EIN LEERES FASS."
#: AllTexts/3Map_texts.amb/353/012.txt
msgctxt "AllTexts/3Map_texts.amb/353/012"
msgid "AN EMPTY BARREL."
msgstr "UN BARRIL VACÍO."

#. Text 013 of map 353.
#. German: "DAS FASS ENTHÄLT BIER. LECKER, ABER FÜR EURE AUFGABE VIELLEICHT EHER HINDERLICH."
#: AllTexts/3Map_texts.amb/353/013.txt
msgctxt "AllTexts/3Map_texts.amb/353/013"
msgid "THE BARREL CONTAINS BEER. DELICIOUS, BUT PROBABLY NOT VERY GOOD FOR THE TASK AHEAD."
msgstr "EL BARRIL CONTIENE CERVEZA. RICA, PERO QUIZÁ NO MUY CONVENIENTE PARA VUESTRA MISIÓN."

#. Text 014 of map 353.
#. German: "DIESES FASS ENTHÄLT EIN WENIG WEIN. WAHRSCHEINLICH EIN LETZTER ÜBERREST AUS LYRAMIONISCHEN ZEITEN."
#: AllTexts/3Map_texts.amb/353/014.txt
msgctxt "AllTexts/3Map_texts.amb/353/014"
msgid "THIS BARREL CONTAINS A LITTLE WINE. PROBABLY FROM THE LYRAMION ERA."
msgstr "ESTE BARRIL CONTIENE UN POCO DE VINO. SEGURAMENTE UN ÚLTIMO RESTO DE LOS TIEMPOS DE LYRAMION."

#. Text 015 of map 353.
#. German: "GOLD UND EDELSTEINE BLITZEN EUCH ENTGEGEN."
#: AllTexts/3Map_texts.amb/353/015.txt
msgctxt "AllTexts/3Map_texts.amb/353/015"
msgid "GOLD AND JEWELS FLASH AT YOU."
msgstr "EL ORO Y LAS PIEDRAS PRECIOSAS RELUCEN ANTE VUESTROS OJOS."

#. Text 016 of map 353.
#. German: "EINE AUSWAHL HOCHWERTIGER RÜSTUNGEN IST HIER GELAGERT."
#: AllTexts/3Map_texts.amb/353/016.txt
msgctxt "AllTexts/3Map_texts.amb/353/016"
msgid "A SELECTION OF HIGH QUALITY EQUIPMENT IS STORED HERE."
msgstr "AQUÍ SE GUARDA UNA SELECCIÓN DE ARMADURAS DE GRAN CALIDAD."

#. Text 017 of map 353.
#. German: "IHR SEHT EINIGE GUT GEPFLEGTE WAFFEN VOR EUCH."
#: AllTexts/3Map_texts.amb/353/017.txt
msgctxt "AllTexts/3Map_texts.amb/353/017"
msgid "YOU SEE SOME VERY WELL-MAINTAINED WEAPONS BEFORE YOU."
msgstr "ANTE VOSOTROS VEIS ALGUNAS ARMAS BIEN CUIDADAS."

#. Text 018 of map 353.
#. German: "HIER FINDET SICH EINE SAMMLUNG VERSCHIEDENER TRÄNKE."
#: AllTexts/3Map_texts.amb/353/018.txt
msgctxt "AllTexts/3Map_texts.amb/353/018"
msgid "YOU FIND A COLLECTION OF DIFFERENT DRINKS."
msgstr "AQUÍ HAY UNA COLECCIÓN DE POCIONES DIVERSAS."

#. Text 019 of map 353.
#. German: "EINE SCHATZTRUHE!"
#: AllTexts/3Map_texts.amb/353/019.txt
msgctxt "AllTexts/3Map_texts.amb/353/019"
msgid "A TREASURE CHEST!"
msgstr "¡UN COFRE DEL TESORO!"

#. Text 020 of map 353.
#. German: "DIESE KISTE BEHERBERGT EIN SAMMELSURIUM VON GEGENSTÄNDEN."
#: AllTexts/3Map_texts.amb/353/020.txt
msgctxt "AllTexts/3Map_texts.amb/353/020"
msgid "THIS BOX HOLDS A MIXTURE OF DIFFERENT ITEMS."
msgstr "ESTA CAJA ALBERGA UN BATIBURRILLO DE OBJETOS."

#. Text 021 of map 353.
#. German: "EIN LEERER SCHRANK."
#: AllTexts/3Map_texts.amb/353/021.txt
msgctxt "AllTexts/3Map_texts.amb/353/021"
msgid "AN EMPTY CUPBOARD."
msgstr "UN ARMARIO VACÍO."

#. Text 022 of map 353.
#. German: "NUR ALTE KLAMOTTEN."
#: AllTexts/3Map_texts.amb/353/022.txt
msgctxt "AllTexts/3Map_texts.amb/353/022"
msgid "JUST OLD CLOTHES."
msgstr "SOLO TRAPOS VIEJOS."

#. Text 023 of map 353.
#. German: "HIER IST EIN VORRAT GETROCKNETER PILZE UND RÄUCHERFLEISCH ZU FINDEN."
#: AllTexts/3Map_texts.amb/353/023.txt
msgctxt "AllTexts/3Map_texts.amb/353/023"
msgid "YOU FIND A STOCK OF DRIED MUSHROOMS AND SMOKED MEAT."
msgstr "AQUÍ HAY UNA PROVISIÓN DE SETAS SECAS Y CARNE AHUMADA."

#. Text 024 of map 353.
#. German: "DIE TRUHE BEINHALTET DIVERSE ALTE GEGENSTÄNDE."
#: AllTexts/3Map_texts.amb/353/024.txt
msgctxt "AllTexts/3Map_texts.amb/353/024"
msgid "THE CHEST CONTAINS VARIOUS OLD ITEMS."
msgstr "EL COFRE CONTIENE DIVERSOS OBJETOS ANTIGUOS."

#. Text 025 of map 353.
#. German: "HIER BEFINDEN SICH EINIGE FACKELN UND LATERNEN."
#: AllTexts/3Map_texts.amb/353/025.txt
msgctxt "AllTexts/3Map_texts.amb/353/025"
msgid "HERE ARE SOME TORCHES AND LANTERNS."
msgstr "AQUÍ HAY VARIAS ANTORCHAS Y LINTERNAS."

#. Text 026 of map 353.
#. German: "DAS FASS IST LEDIGLICH MIT BIER GEFÜLLT."
#: AllTexts/3Map_texts.amb/353/026.txt
msgctxt "AllTexts/3Map_texts.amb/353/026"
msgid "THE BARREL IS ONLY FULL OF BEER. ␀ "
msgstr "EL BARRIL SOLO ESTÁ LLENO DE CERVEZA."

#. Text 000 of map 354. The name of the map.
#. German: "MINE - 3. EBENE"
#: AllTexts/3Map_texts.amb/354/000.txt
msgctxt "AllTexts/3Map_texts.amb/354/000"
msgid "MINE - THIRD LEVEL"
msgstr "MINA - TERCER NIVEL"

#. Text 001 of map 354.
#. German: "DAS ERDREICH AN DIESER STELLE IST WEICH GENUG, ES LÄSST SICH MIT EURER SPITZHACKE BESEITIGEN."
#: AllTexts/3Map_texts.amb/354/001.txt
msgctxt "AllTexts/3Map_texts.amb/354/001"
msgid "THE EARTH AT THIS POINT IS SOFT ENOUGH, YOU CAN REMOVE IT WITH YOUR PICKAXE."
msgstr "LA TIERRA EN ESTE PUNTO ES LO BASTANTE BLANDA COMO PARA RETIRARLA CON VUESTRO PICO."

#. Text 002 of map 354.
#. German: "LANGSAM UND STOCKEND SCHLIEßT SICH DER OBERE TEIL DER APPARATUR ÜBER DEM BERNSTEIN. EIN SIRRENDES GERÄUSCH ERTÖNT, UND DAS ANTIKE GERÄT BEGINNT UNBEKANNTE ENERGIEN ZU ERZEUGEN. IN DER FERNE IST EIN KURZES KNISTERN ZU HÖREN."
#: AllTexts/3Map_texts.amb/354/002.txt
msgctxt "AllTexts/3Map_texts.amb/354/002"
msgid "THE UPPER PART OF THE APPARATUS SLOWLY AND JERKILY CLOSES OVER THE PIECE OF AMBER. YOU HEAR A HAMMERING NOISE AND THE ANTIQUATED UNIT BEGINS TO PRODUCE UNKNOWN SOURCES OF ENERGY. YOU HEAR A SHORT HISSING SOUND IN THE DISTANCE."
msgstr "LENTAMENTE Y A TROMPICONES, LA PARTE SUPERIOR DEL APARATO SE CIERRA SOBRE EL ÁMBAR. SE OYE UN ZUMBIDO Y EL ANTIGUO ARTEFACTO EMPIEZA A GENERAR ENERGÍAS DESCONOCIDAS. A LO LEJOS SE OYE UN BREVE CHISPORROTEO."

#. Text 003 of map 354.
#. German: "STAUB RIESELT AUS DEN FUGEN DER TÜR, ALS SIE SICH ZUM ERSTEN MAL SEIT URZEITEN WIEDER LANGSAM ÖFFNET."
#: AllTexts/3Map_texts.amb/354/003.txt
msgctxt "AllTexts/3Map_texts.amb/354/003"
msgid "DUST TRICKLES OUT FROM THE JOINTS BETWEEN THE DOOR AS IT OPENS SLOWLY FOR THE FIRST TIME FOR AGES."
msgstr "DE LAS JUNTAS DE LA PUERTA CAE UN HILILLO DE POLVO MIENTRAS SE ABRE LENTAMENTE POR PRIMERA VEZ DESDE TIEMPOS INMEMORIALES."

#. Text 004 of map 354.
#. German: "ABGESTANDENE LUFT SCHLÄGT EUCH ENTGEGEN. SIE RIECHT ALT, URALT. MAN SPÜRT, DASS SIE SEIT JAHRTAUSENDEN VON KEINEM LEBEWESEN MEHR GEATMET WURDE."
#: AllTexts/3Map_texts.amb/354/004.txt
msgctxt "AllTexts/3Map_texts.amb/354/004"
msgid "STALE AIR BILLOWS OUT AROUND YOU. IT SMELLS OLD, AGE OLD. IT IS CLEAR IT HAS NOT BEEN BREATHED BY A LIVING BEING FOR THOUSANDS OF YEARS."
msgstr "OS GOLPEA UNA BOCANADA DE AIRE VICIADO. HUELE A VIEJO, A ANTIQUÍSIMO. SE NOTA QUE NINGÚN SER VIVO LO HA RESPIRADO EN MILES DE AÑOS."

#. Text 005 of map 354.
#. German: "NICHTS PASSIERT. DIE TÜR BLEIBT GESCHLOSSEN."
#: AllTexts/3Map_texts.amb/354/005.txt
msgctxt "AllTexts/3Map_texts.amb/354/005"
msgid "NOTHING HAPPENS. THE DOOR STAYS CLOSED. ␀ E"
msgstr "NO PASA NADA. LA PUERTA SIGUE CERRADA."

#. Text 000 of map 355. The name of the map.
#. German: "FERRIN'S LAGERKELLER"
#: AllTexts/3Map_texts.amb/355/000.txt
msgctxt "AllTexts/3Map_texts.amb/355/000"
msgid "FERRIN'S STORAGE CELLAR"
msgstr "ALMACÉN DE FERRIN"

#. Text 001 of map 355.
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "~LEAD~ UNTERSUCHT FERRIN'S ALTE BESITZTÜMER MIT GROßER SORGFALT, MUSS ABER ENTTÄUSCHT FESTSTELLEN, DASS SICH NICHTS WERTVOLLES DARUNTER BEFINDET."
#: AllTexts/3Map_texts.amb/355/001.txt
msgctxt "AllTexts/3Map_texts.amb/355/001"
msgid "~LEAD~ EXAMINES FERRIN'S OLD POSSESSIONS WITH GREAT CARE BUT DISAPPOINTINGLY FINDS THAT THERE IS NOTHING OF VALUE AMONGST THEM."
msgstr "~LEAD~ EXAMINA CON GRAN CUIDADO LAS VIEJAS PERTENENCIAS DE FERRIN, PERO DESCUBRE CON DECEPCIÓN QUE NO HAY NADA DE VALOR ENTRE ELLAS."

#. Text 002 of map 355.
#. German: "DAS FASS IST LEER."
#: AllTexts/3Map_texts.amb/355/002.txt
msgctxt "AllTexts/3Map_texts.amb/355/002"
msgid "THE BARREL IS EMPTY."
msgstr "EL BARRIL ESTÁ VACÍO."

#. Text 003 of map 355.
#. German: "IN DIESEM FASS BEFINDEN SICH EINIGE FACKELN."
#: AllTexts/3Map_texts.amb/355/003.txt
msgctxt "AllTexts/3Map_texts.amb/355/003"
msgid "THERE ARE SOME TORCHES IN THIS BARREL."
msgstr "EN ESTE BARRIL HAY ALGUNAS ANTORCHAS."

#. Text 004 of map 355.
#. German: "EINE UNTERSUCHUNG DES LEINENSACKS BRINGT EIN PAAR STABILE SEILE ZUM VORSCHEIN."
#: AllTexts/3Map_texts.amb/355/004.txt
msgctxt "AllTexts/3Map_texts.amb/355/004"
msgid "AN EXAMINATION OF THE LINEN SACK PRODUCES A FEW PIECES OF STRONG ROPE."
msgstr "AL REGISTRAR EL SACO DE LINO APARECEN UNAS CUANTAS CUERDAS RESISTENTES."

#. Text 005 of map 355.
#. German: "DAS FASS ENTHÄLT EIN ÜBELRIECHENDES ÖL, SICHER IDEAL FÜR ZWECKE DER HOLZVEREDELUNG, ABER NUTZLOS FÜR EUCH."
#: AllTexts/3Map_texts.amb/355/005.txt
msgctxt "AllTexts/3Map_texts.amb/355/005"
msgid "THE BARREL CONTAINS OIL WHICH SMELLS HORRIBLE, CERTAINLY IDEAL FOR TREATING WOOD BUT USELESS TO YOU."
msgstr "EL BARRIL CONTIENE UN ACEITE MALOLIENTE, SIN DUDA IDEAL PARA TRATAR LA MADERA, PERO INÚTIL PARA VOSOTROS."

#. Text 006 of map 355.
#. German: "UNTER EINER STAUBSCHICHT SCHON FAST VERSCHWUNDEN, LIEGT HIER EIN STÜCK BERNSTEIN."
#: AllTexts/3Map_texts.amb/355/006.txt
msgctxt "AllTexts/3Map_texts.amb/355/006"
msgid "A PIECE OF AMBER LIES HERE, ALMOST OBSCURED BY A LAYER OF DUST."
msgstr "AQUÍ HAY UN TROZO DE ÁMBAR, CASI OCULTO BAJO UNA CAPA DE POLVO."

#. Text 007 of map 355.
#. German: "ALS DIE SPITZHACKE DIESEN TEIL DER WAND TRIFFT, DRINGT SIE VERBLÜFFEND LEICHT EIN. EINE NÄHERE UNTERSUCHUNG ZEIGT, DASS DIE STEINE VON EINER ART KLEBRIGEM SPEICHEL ZUSAMMENGEHALTEN WURDEN."
#: AllTexts/3Map_texts.amb/355/007.txt
msgctxt "AllTexts/3Map_texts.amb/355/007"
msgid "AS THE PICKAXE HITS THIS PART OF THE WALL IT PENETRATES IT ASTONISHINGLY EASILY. ON CLOSER INSPECTION IT IS CLEAR THE BRICKS WERE HELD TOGETHER BY A KIND OF GLUEY SALIVA. ␀ "
msgstr "CUANDO EL PICO GOLPEA ESTA PARTE DE LA PARED, PENETRA CON SORPRENDENTE FACILIDAD. AL EXAMINARLA DE CERCA, VEIS QUE LAS PIEDRAS ESTABAN UNIDAS POR UNA ESPECIE DE SALIVA PEGAJOSA."

#. Text 000 of map 356. The name of the map.
#. German: "TORNAK-HÖHLE"
#: AllTexts/3Map_texts.amb/356/000.txt
msgctxt "AllTexts/3Map_texts.amb/356/000"
msgid "TORNAK CAVE"
msgstr "CUEVA DE LOS TORNAKS"

#. Text 001 of map 356.
#. German: "HIER SCHEINT WIEDER EIN GANG VERSCHLOSSEN WORDEN ZU SEIN. DIE SPITZHACKE RÄUMT DAS MATERIAL ZUR SEITE."
#: AllTexts/3Map_texts.amb/356/001.txt
msgctxt "AllTexts/3Map_texts.amb/356/001"
msgid "A CORRIDOR SEEMS TO HAVE BEEN SEALED AGAIN HERE. THE PICKAXE CLEARS THE MATERIAL TO ONE SIDE."
msgstr "AQUÍ PARECE QUE TAMBIÉN HAN TAPIADO UN PASADIZO. EL PICO APARTA EL MATERIAL A UN LADO."

#. Text 002 of map 356.
#. German: "WIE ZU ERWARTEN WAR, IST DIESE HÖHLE BEWOHNT. TORNAKS GREIFEN AN!"
#: AllTexts/3Map_texts.amb/356/002.txt
msgctxt "AllTexts/3Map_texts.amb/356/002"
msgid "AS WAS EXPECTED, THIS CAVE IS INHABITED. TORNAKS ATTACK! ␀ E"
msgstr "COMO ERA DE ESPERAR, ESTA CUEVA ESTÁ HABITADA. ¡LOS TORNAKS ATACAN!"

#. Text 000 of map 357. The name of the map.
#. German: "TORNAK-HÖHLE"
#: AllTexts/3Map_texts.amb/357/000.txt
msgctxt "AllTexts/3Map_texts.amb/357/000"
msgid "TORNAK CAVE"
msgstr "CUEVA DE LOS TORNAKS"

#. Text 001 of map 357.
#. German: "HIER SCHEINT WIEDER EIN GANG VERSCHLOSSEN WORDEN ZU SEIN. DIE SPITZHACKE RÄUMT DAS MATERIAL ZUR SEITE."
#: AllTexts/3Map_texts.amb/357/001.txt
msgctxt "AllTexts/3Map_texts.amb/357/001"
msgid "A CORRIDOR APPEARS TO HAVE BEEN SEALED AGAIN HERE. THE PICKAXE CLEARS THE MATERIAL TO ONE SIDE."
msgstr "AQUÍ PARECE QUE TAMBIÉN HAN TAPIADO UN PASADIZO. EL PICO APARTA EL MATERIAL A UN LADO."

#. Text 002 of map 357.
#. German: "DAS TORNAK-EI TUT SEINE WIRKUNG: DIE BESTIEN BLEIBEN AUF DISTANZ."
#: AllTexts/3Map_texts.amb/357/002.txt
msgctxt "AllTexts/3Map_texts.amb/357/002"
msgid "THE TORNAK EGG HAS AN EFFECT: THE BEASTS KEEP THEIR DISTANCE."
msgstr "EL HUEVO DE TORNAK SURTE EFECTO: LAS BESTIAS SE MANTIENEN A DISTANCIA."

#. Text 000 of map 358. The name of the map.
#. German: "KLEINE HÖHLE"
#: AllTexts/3Map_texts.amb/358/000.txt
msgctxt "AllTexts/3Map_texts.amb/358/000"
msgid "SMALL CAVE"
msgstr "CUEVA PEQUEÑA"

#. Text 001 of map 358.
#. German: "EUREN AUGEN BIETET SICH EIN SCHIER UNGLAUBLICHER ANBLICK:^ FERRIN'S TOCHTER SITZT DORT, UMGEBEN VON EINER GROßEN ZAHL TORNAKS, DIE SICH WIE SCHOßHÜNDCHEN GEBÄRDEN. SIE SPIELT SELIG MIT IHNEN, SCHMUTZIG UND EIN WENIG ABGEMAGERT, ABER OFFENBAR SEHR ZUFRIEDEN.^ EUCH KOMMT NUR EINE ERKLÄRUNG IN DEN SINN: SIE MUSS ÜBER EINE ANGEBORENE FÄHIGKEIT VERFÜGEN, TIERE ZU BEEINFLUSSEN."
#: AllTexts/3Map_texts.amb/358/001.txt
msgctxt "AllTexts/3Map_texts.amb/358/001"
msgid "YOUR EYES SEE AN INCREDIBLE SIGHT HERE:^ FERRIN'S DAUGHTER IS SITTING THERE, SURROUNDED BY A LARGE NUMBER OF TORNAKS, ALL BEHAVING LIKE LITTLE PUPPIES. SHE IS PLAYING HAPPILY WITH THEM, DIRTY AND RATHER THIN BUT APPARENTLY QUITE HAPPY.^ YOU CAN ONLY THINK OF ONE EXPLANATION: SHE MUST HAVE THE ABILITY TO COMMUNICATE WITH ANIMALS."
msgstr "ANTE VUESTROS OJOS SE PRESENTA UNA ESCENA CASI INCREÍBLE:^ LA HIJA DE FERRIN ESTÁ AHÍ SENTADA, RODEADA DE UN GRAN NÚMERO DE TORNAKS QUE SE COMPORTAN COMO PERRITOS FALDEROS. JUEGA CON ELLOS TAN FELIZ, SUCIA Y ALGO DESNUTRIDA, PERO POR LO VISTO MUY CONTENTA.^ SOLO SE OS OCURRE UNA EXPLICACIÓN: DEBE DE TENER UN DON INNATO PARA INFLUIR EN LOS ANIMALES."

#. Text 002 of map 358.
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "UMGEBEN VON DEN TORNAKS NÄHERT IHR EUCH FERRIN'S TOCHTER. ES IST NICHT ZU FASSEN: SIE WILL NICHT MIT EUCH NACH HAUSE KOMMEN! SIE ERZÄHLT MUNTER VON IHREN NEUEN SPIELKAMERADEN UND WIEVIEL SPAß SIE MIT IHNEN HAT. ALS ~LEAD~ NACH IHRER HAND GREIFEN WILL, FANGEN DIE TORNAKS BEDROHLICH ZU KNURREN AN...^ MIT FEUCHTEN HÄNDEN WOLLT IHR DIE WAFFEN ZÜCKEN, DA BEGINNT ~LEAD~, DEM KIND VON SEINEN ELTERN UND VON EINEM GUTEN ESSEN VON MUTTER ZU ERZÄHLEN. DIE WORTE VERFEHLEN IHRE WIRKUNG NICHT. DIE KLEINE BESCHWERT SICH LAUTHALS ÜBER DAS KOMISCHE ESSEN, DAS IHR IHRE FREUNDE GEBRACHT HABEN, UND ERKLÄRT ENTSCHLOSSEN, SIE WOLLE \"NACH HAUSE, SOFORT!\"^ DIE TORNAKS BERUHIGEN SICH SO SCHNELL, ALS WÄREN SIE ABGESCHALTET WORDEN. AUCH AUF EUREM RÜCKWEG WERDET IHR NICHT ANGEGRIFFEN.^ SCHLIEßLICH BETRETET IHR WIEDER FERRIN'S HAUS..."
#: AllTexts/3Map_texts.amb/358/002.txt
msgctxt "AllTexts/3Map_texts.amb/358/002"
msgid "SURROUNDED BY THE TORNAKS, FERRIN'S DAUGHTER COMES TOWARDS YOU. IT IS UNBELIEVABLE: SHE DOES NOT WANT TO COME HOME WITH YOU! SHE TALKS EXCITEDLY ABOUT HER NEW PLAYMATES AND HOW MUCH FUN SHE HAS WITH THEM. AS ~LEAD~ REACHES FOR HER HAND, THE TORNAKS START TO GROWL THREATENINGLY ...^ YOU BEGIN TO DRAW YOUR WEAPONS AND ~LEAD~ STARTS TO TALK TO THE CHILD ABOUT HER PARENTS AND A GOOD MEAL PREPARED BY MUMMY. THE WORDS HAVE AN EFFECT. THE LITTLE GIRL COMPLAINS LOUDLY ABOUT THE STRANGE FOOD WHICH HER FRIENDS HAVE BROUGHT AND DECLARES FIRMLY SHE WANTS TO GO HOME \"RIGHT NOWWWWWW!\"^ THE TORNAKS QUIETEN DOWN SO QUICKLY THAT YOU WOULD THINK SHE HAD SWITCHED THEM OFF. THEY DO NOT ATTACK YOU ON YOUR WAY BACK.^ FINALLY YOU ENTER FERRIN'S HOUSE AGAIN ..."
msgstr "RODEADA DE LOS TORNAKS, LA HIJA DE FERRIN SE OS ACERCA. ¡ES INCREÍBLE: NO QUIERE VOLVER A CASA CON VOSOTROS! OS HABLA ALEGREMENTE DE SUS NUEVOS COMPAÑEROS DE JUEGOS Y DE LO BIEN QUE SE LO PASA CON ELLOS. CUANDO ~LEAD~ INTENTA COGERLA DE LA MANO, LOS TORNAKS EMPIEZAN A GRUÑIR AMENAZADORAMENTE...^ CON LAS MANOS SUDOROSAS, ESTÁIS A PUNTO DE DESENVAINAR LAS ARMAS CUANDO ~LEAD~ EMPIEZA A HABLARLE A LA NIÑA DE SUS PADRES Y DE LA BUENA COMIDA DE SU MADRE. LAS PALABRAS SURTEN EFECTO. LA PEQUEÑA SE QUEJA A VOZ EN GRITO DE LA COMIDA TAN RARA QUE LE TRAEN SUS AMIGOS Y DECLARA, MUY DECIDIDA, QUE QUIERE IR \"¡A CASA, YA MISMO!\"^ LOS TORNAKS SE CALMAN TAN DEPRISA COMO SI LOS HUBIERAN APAGADO. TAMPOCO OS ATACAN EN EL CAMINO DE VUELTA.^ POR FIN ENTRÁIS DE NUEVO EN LA CASA DE FERRIN..."

#. Text 003 of map 358.
#. German: "DIE TORNAKS IN DIESER KAMMER SIND NOCH IMMER GANZ PERPLEX. MANCHE STEHEN APATHISCH HERUM, ANDERE DREHEN SICH SCHNÜFFELND IM KREIS. IHR WERDET NICHT ATTACKIERT."
#: AllTexts/3Map_texts.amb/358/003.txt
msgctxt "AllTexts/3Map_texts.amb/358/003"
msgid "THE TORNAKS IN THIS ROOM ARE STILL VERY PERPLEXED. SOME OF THEM ARE STANDING AROUND APATHETICALLY AND OTHERS SHUFFLE AROUND IN CIRCLES. THEY DO NOT ATTACK YOU."
msgstr "LOS TORNAKS DE ESTA CÁMARA SIGUEN COMPLETAMENTE DESCONCERTADOS. ALGUNOS SE QUEDAN QUIETOS, APÁTICOS, Y OTROS DAN VUELTAS EN CÍRCULO OLFATEANDO. NO OS ATACAN."

#. Text 000 of map 359. The name of the map.
#. German: "FERRIN'S SCHMIEDE"
#: AllTexts/3Map_texts.amb/359/000.txt
msgctxt "AllTexts/3Map_texts.amb/359/000"
msgid "FERRIN'S SMITHY"
msgstr "HERRERÍA DE FERRIN"

#. Text 001 of map 359.
#. German: "~INK 30~ DER VOR EUCH STEHENDE ZWERG IST UNGLAUBLICH ALT. ER SPRICHT MIT ZITTRIGER STIMME:^ ~INK 31~ \"HABT IHR SCHON GEHÖRT: DIE KLEINE IST WIEDER DA!\""
#: AllTexts/3Map_texts.amb/359/001.txt
msgctxt "AllTexts/3Map_texts.amb/359/001"
msgid "~INK 30~ THE DWARF BEFORE YOU IS INCREDIBLY OLD. HE SPEAKS WITH A TREMBLING VOICE:^ ~INK 31~ \"HAVE YOU HEARD: THE LITTLE ONE IS BACK AGAIN!\""
msgstr "~INK 30~ EL ENANO QUE TENÉIS DELANTE ES INCREÍBLEMENTE VIEJO. HABLA CON VOZ TEMBLOROSA:^ ~INK 31~ \"¿OS HABÉIS ENTERADO? ¡LA PEQUEÑA HA VUELTO!\""

#. Text 002 of map 359.
#. German: "~INK 30~ DIE ZAHLREICHEN WERKZEUGE IM GÜRTEL EURES GEGENÜBERS VERRATEN EUCH, DASS ES SICH HIER UM DEN GEHILFEN DES SCHMIEDS HANDELN MUSS. ER UNTERBRICHT SEINE ARBEIT, UM ZU SAGEN:^ ~INK 31~ \"WIE SCHÖN, DASS IHR FERRIN'S KLEINE WIEDER ZURÜCKGEBRACHT HABT! UND WELCH EINE PHANTASTISCHE GESCHICHTE!\""
#: AllTexts/3Map_texts.amb/359/002.txt
msgctxt "AllTexts/3Map_texts.amb/359/002"
msgid "~INK 30~ THE MANY TOOLS IN HIS BELT TELL YOU THAT HE IS THE ASSISTANT OF THE BLACKSMITH. HE INTERRUPTS HIS WORK TO SAY:^ ~INK 31~ \"HOW WONDERFUL THAT YOU HAVE BROUGHT FERRIN'S LITTLE ONE BACK AGAIN! AND WHAT A FANTASTIC STORY!\""
msgstr "~INK 30~ LAS NUMEROSAS HERRAMIENTAS QUE LLEVA AL CINTO OS DICEN QUE DEBE DE SER EL AYUDANTE DEL HERRERO. INTERRUMPE SU TRABAJO PARA DECIR:^ ~INK 31~ \"¡QUÉ BIEN QUE HAYÁIS TRAÍDO DE VUELTA A LA PEQUEÑA DE FERRIN! ¡Y QUÉ HISTORIA TAN FANTÁSTICA!\""

#. Text 003 of map 359.
#. German: "~INK 30~ DER VERKÄUFER PREIST FERRIN'S SORTIMENT AN:^ ~INK 31~ \"WERKZEUGE UND WAFFEN AUS HOLZ, WIE SIE DIE MEISTEN NICHT AUS METALL MACHEN KÖNNTEN! KOMMT VOR DIE VERKAUFSTHEKE, UND ICH ZEIGE EUCH UNSERE AUSWAHL!\""
#: AllTexts/3Map_texts.amb/359/003.txt
msgctxt "AllTexts/3Map_texts.amb/359/003"
msgid "~INK 30~ THE SALESMAN LOOKS AT FERRIN'S ASSORTMENT:^ ~INK 31~ \"TOOLS AND WEAPONS MADE OF WOOD BETTER THEN MOST PEOPLE COULD MAKE OUT OF METAL! COME OVER TO THE SALES COUNTER AND I WILL SHOW YOU WHAT WE HAVE!\""
msgstr "~INK 30~ EL VENDEDOR ALABA EL SURTIDO DE FERRIN:^ ~INK 31~ \"¡HERRAMIENTAS Y ARMAS DE MADERA COMO LA MAYORÍA NO SABRÍA HACERLAS NI DE METAL! ¡ACERCAOS AL MOSTRADOR Y OS ENSEÑARÉ LO QUE TENEMOS!\""

#. Text 004 of map 359.
#. German: "~INK 30~ IHR KOMMT MIT EINEM GRÜNGEKLEIDETEN ZWERG INS GESPRÄCH. ER SAGT:^ ~INK 31~ \"ICH HABE VON DER GESCHICHTE MIT FERRIN'S TOCHTER GEHÖRT. UNGLAUBLICH! WAS MACHT DIESER MOND NUR AUS UNSEREN KINDERN?\""
#: AllTexts/3Map_texts.amb/359/004.txt
msgctxt "AllTexts/3Map_texts.amb/359/004"
msgid "~INK 30~ YOU COME INTO CONVERSATION WITH A DWARF DRESSED IN GREEN. HE SAYS:^ ~INK 31~ \"I HEARD THE STORY OF FERRIN'S DAUGHTER. INCREDIBLE! WHAT IS THIS MOON DOING TO OUR CHILDREN?\""
msgstr "~INK 30~ OS PONÉIS A CHARLAR CON UN ENANO VESTIDO DE VERDE. DICE:^ ~INK 31~ \"ME HE ENTERADO DE LO QUE LE PASÓ A LA HIJA DE FERRIN. ¡INCREÍBLE! ¿QUÉ LES ESTÁ HACIENDO ESTA LUNA A NUESTROS HIJOS?\""

#. Text 005 of map 359.
#. German: "DAS VERRIEGELTE SCHLOSS AN DIESER TÜR IST AUS HOLZ, ABER VON EINER BEMERKENSWERTEN QUALITÄT."
#: AllTexts/3Map_texts.amb/359/005.txt
msgctxt "AllTexts/3Map_texts.amb/359/005"
msgid "THE LOCK ON THIS DOOR IS MADE OF WOOD BUT NEVERTHELESS REMARKABLE QUALITY."
msgstr "LA CERRADURA DE ESTA PUERTA ES DE MADERA, PERO DE UNA CALIDAD NOTABLE."

#. Text 006 of map 359.
#. German: "FERRIN'S SCHLÜSSEL PASST ERWARTUNGSGEMÄß PERFEKT. IHR BETRETET DIE DAHINTERLIEGENDE TREPPE UND GELANGT IN DEN KELLER."
#: AllTexts/3Map_texts.amb/359/006.txt
msgctxt "AllTexts/3Map_texts.amb/359/006"
msgid "FERRIN'S KEY FITS PERFECTLY, AS EXPECTED. YOU STEP ONTO THE STAIRCASE AND REACH THE CELLAR."
msgstr "COMO ERA DE ESPERAR, LA LLAVE DE FERRIN ENCAJA PERFECTAMENTE. BAJÁIS POR LA ESCALERA QUE HAY DETRÁS Y LLEGÁIS AL SÓTANO."

#. Text 007 of map 359.
#. German: "\"VIELEN DANK, EDLE REISENDE!\""
#: AllTexts/3Map_texts.amb/359/007.txt
msgctxt "AllTexts/3Map_texts.amb/359/007"
msgid "\"MANY THANKS, NOBLE TRAVELLERS!\""
msgstr "\"¡MUCHÍSIMAS GRACIAS, NOBLES VIAJEROS!\""

#. Text 008 of map 359.
#. German: "~INK 30~ FERRIN'S FRAU UMARMT JEDEN VON EUCH UND STAMMELT:^ ~INK 31~ \"MIR FEHLEN DIE WORTE, UM MEINEN DANK AUSZUDRÜCKEN, IHR EDLEN ABENTEURER! ICH HATTE NUR NOCH SO WENIG HOFFNUNG. IHR MÖGT GESEGNET SEIN!\""
#: AllTexts/3Map_texts.amb/359/008.txt
msgctxt "AllTexts/3Map_texts.amb/359/008"
msgid "~INK 30~ FERRIN'S WIFE WRAPS HER ARMS AROUND YOU AND STAMMERS:^ ~INK 31~ \"I DO NOT KNOW THE WORDS TO EXPRESS MY THANKS, NOBLE ADVENTURERS! I HAD SUCH LITTLE HOPE. BLESS YOU, BLESS YOU!\""
msgstr "~INK 30~ LA MUJER DE FERRIN OS ABRAZA A TODOS, UNO POR UNO, Y BALBUCEA:^ ~INK 31~ \"¡NO TENGO PALABRAS PARA EXPRESAR MI GRATITUD, NOBLES AVENTUREROS! YA CASI NO ME QUEDABA ESPERANZA. ¡BENDITOS SEÁIS!\""

#. Text 009 of map 359.
#. German: "~INK 30~ DAS KLEINE MÄDCHEN ERKENNT EUCH SOFORT WIEDER UND SAGT:^ ~INK 31~ \"MIR IST LANGWEILIG! KÖNNT IHR MICH NICHT ZU MEINEN FREUNDEN BRINGEN?\""
#: AllTexts/3Map_texts.amb/359/009.txt
msgctxt "AllTexts/3Map_texts.amb/359/009"
msgid "~INK 30~ THE LITTLE GIRL RECOGNISES YOU AGAIN AT ONCE AND SAYS:^ ~INK 31~ \"I AM BORED! CAN'T YOU TAKE ME TO MY FRIENDS?\""
msgstr "~INK 30~ LA NIÑA OS RECONOCE ENSEGUIDA Y DICE:^ ~INK 31~ \"¡ME ABURRO! ¿NO PODÉIS LLEVARME CON MIS AMIGOS?\""

#. Text 010 of map 359.
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "KAUM TRETET IHR AUS DER KELLERTÜR, KOMMEN EUCH FERRIN UND SEINE FRAU ENTGEGENGESTÜRMT. DIE FREUDE DER ELTERN IST UNBESCHREIBLICH; MINUTENLANG LIEGEN SICH ALLE DREI IN DEN ARMEN.^ IHR ERZÄHLT, WAS VORGEFALLEN IST, DASS DIE TORNAKS IHRE GÄNGE MANCHMAL WIEDER VERSCHLIESSEN UND WELCHEN UNHEIMLICHEN EINFLUSS DAS KIND AUF DIE BESTIEN AUSGEÜBT HAT.^ DAS GLÜCKLICHE ELTERNPAAR BEDANKT SICH ÜBERSCHWENGLICH, UND FERRIN WINKT ~LEAD~ ZU SICH HERAN..."
#: AllTexts/3Map_texts.amb/359/010.txt
msgctxt "AllTexts/3Map_texts.amb/359/010"
msgid "YOU HAVE JUST COME OUT OF THE CELLAR WHEN FERRIN AND HIS WIFE RUSH TOWARDS YOU. THE JOY THEY FEEL IS INDESCRIBABLE; THEY TAKE YOU IN THEIR ARMS AND HOLD YOU TIGHT FOR MINUTES.^ YOU EXPLAIN WHAT HAPPENED, THAT THE TORNAKS SOMETIMES SEAL THEIR CORRIDORS AGAIN AND WHAT AN INCREDIBLE INFLUENCE THE CHILD HAD ON THE BEASTS.^ THE HAPPY PARENTS THANK YOU AGAIN AND AGAIN AND FERRIN WAVES ~LEAD~ TO HIM ..."
msgstr "NADA MÁS SALIR POR LA PUERTA DEL SÓTANO, FERRIN Y SU MUJER SE PRECIPITAN HACIA VOSOTROS. LA ALEGRÍA DE LOS PADRES ES INDESCRIPTIBLE; DURANTE MINUTOS, LOS TRES SE FUNDEN EN UN ABRAZO.^ LES CONTÁIS LO QUE HA PASADO, QUE LOS TORNAKS A VECES VUELVEN A TAPIAR SUS GALERÍAS Y LA INQUIETANTE INFLUENCIA QUE LA NIÑA EJERCÍA SOBRE LAS BESTIAS.^ LOS FELICES PADRES OS DAN LAS GRACIAS UNA Y OTRA VEZ, Y FERRIN LE HACE SEÑAS A ~LEAD~ PARA QUE SE ACERQUE..."

#. Text 011 of map 359.
#. German: "SEID GEGRÜßT, HELDENHAFTE REISENDE! FÜR EUCH GIBT ES NATÜRLICH SONDERPREISE! KOMMT ZUR THEKE, WENN WIR ETWAS REPARIEREN SOLLEN!"
#: AllTexts/3Map_texts.amb/359/011.txt
msgctxt "AllTexts/3Map_texts.amb/359/011"
msgid "WELCOME, HEROIC TRAVELLERS! NATURALLY WE HAVE SPECIAL PRICES FOR YOU! COME TO THE COUNTER IF YOU WANT US TO REPAIR ANYTHING!"
msgstr "¡SALUDOS, HEROICOS VIAJEROS! ¡PARA VOSOTROS HAY PRECIOS ESPECIALES, FALTARÍA MÁS! ¡ACERCAOS AL MOSTRADOR SI QUERÉIS QUE OS REPAREMOS ALGO!"

#. Text 012 of map 359.
#. German: "DIES IST EIN AMBOSS AUS HARTEM, GRANITÄHNLICHEM GESTEIN."
#: AllTexts/3Map_texts.amb/359/012.txt
msgctxt "AllTexts/3Map_texts.amb/359/012"
msgid "THIS IS AN ANVIL MADE OF A HARD ROCK LIKE GRANITE."
msgstr "ES UN YUNQUE DE UNA ROCA DURA, PARECIDA AL GRANITO."

#. Text 013 of map 359.
#. German: "EINS VON FERRIN'S WERKZEUGEN."
#: AllTexts/3Map_texts.amb/359/013.txt
msgctxt "AllTexts/3Map_texts.amb/359/013"
msgid "ONE OF FERRIN'S TOOLS."
msgstr "UNA DE LAS HERRAMIENTAS DE FERRIN."

#. Text 000 of map 360. The name of the map.
#. German: "HAUS DES HEILERS ASRUB"
#: AllTexts/3Map_texts.amb/360/000.txt
msgctxt "AllTexts/3Map_texts.amb/360/000"
msgid "HOUSE OF ASRUB THE HEALER"
msgstr "CASA DEL CURANDERO ASRUB"

#. Text 001 of map 360.
#. German: "~INK 30~ DIE ÜPPIG GERUNDETE ZWERGIN WENDET SICH EUCH ZU UND SAGT:^ ~INK 31~ \"DER GUTE ASRUB IST EIN WENIG PENIBEL. WENN IHR HILFE BENÖTIGT, GEHT BITTE VOR DIE THEKE UND LASST EUCH EINSCHREIBEN!\""
#: AllTexts/3Map_texts.amb/360/001.txt
msgctxt "AllTexts/3Map_texts.amb/360/001"
msgid "~INK 30~ THE VOLUPTUOUS DWARF LADY TURNS TO YOU AND SAYS:^ ~INK 31~ \"GOOD OLD ASRUB IS A LITTLE STRICT. IF YOU NEED HELP, PLEASE GO TO THE COUNTER AND REGISTER!\""
msgstr "~INK 30~ LA ENANA, DE FORMAS GENEROSAS, SE VUELVE HACIA VOSOTROS Y DICE:^ ~INK 31~ \"EL BUENO DE ASRUB ES UN POCO QUISQUILLOSO. SI NECESITÁIS AYUDA, ID AL MOSTRADOR Y APUNTAOS, POR FAVOR.\""

#. Text 002 of map 360.
#. German: "~INK 30~ MIT HOHER FISTELSTIMME SPRICHT DIESER VOM ALTER GEKRÜMMTE ZWERG AUF EUCH EIN:^ ~INK 31~ \"OH WEH, OH WEH, OHNE ASRUB WÜRDE MICH MEIN RHEUMA INS GRAB BRINGEN!\""
#: AllTexts/3Map_texts.amb/360/002.txt
msgctxt "AllTexts/3Map_texts.amb/360/002"
msgid "~INK 30~ THIS OLD DWARF, BENT WITH AGE, SPEAKS TO YOU IN A HIGH PITCHED, SHRILL VOICE:^ ~INK 31~ \"OH DEAR, OH DEAR, WITHOUT ASRUB MY RHEUMATISM WOULD SEND ME TO MY GRAVE!\""
msgstr "~INK 30~ ESTE ENANO, ENCORVADO POR LA EDAD, OS HABLA CON UNA VOCECILLA AGUDA Y CHILLONA:^ ~INK 31~ \"¡AY DE MÍ, AY DE MÍ, SIN ASRUB EL REÚMA ME LLEVARÍA A LA TUMBA!\""

#. Text 003 of map 360.
#. German: "~INK 30~ IHR SPRECHT EINE JUNGE, KAUM SECHZIG JAHRE ALTE ZWERGIN AN. SIE ANTWORTET:^ ~INK 31~ \"SEID GEGRÜßT, FREMDE BESUCHER! WISST IHR, ICH BIN SEHR FROH, DASS ASRUB BEI UNS IST. ICH LIEBE DIE NATUR UNSERES MONDES, ABER DIES IST NICHT DER IDEALE ORT FÜR JEMANDEN MIT HÖLLISCHEM HEUSCHNUPFEN!\"^ ~INK 30~ SIE LACHT UND BEKOMMT PROMPT EINEN NIESANFALL."
#: AllTexts/3Map_texts.amb/360/003.txt
msgctxt "AllTexts/3Map_texts.amb/360/003"
msgid "~INK 30~ YOU SPEAK TO A YOUNG DWARF LADY, HARDLY 60 YEARS OLD. SHE ANSWERS:^ ~INK 31~ \"WELCOME, STRANGE VISITORS. DO YOU KNOW, I AM VERY HAPPY THAT ASRUB IS WITH US. I LOVE THE NATURE ON OUR MOON BUT THIS IS NOT THE IDEAL PLACE FOR SOMEONE WITH DREADFUL HAY FEVER!\"^ ~INK 30~ SHE LAUGHS AND PROMPTLY BEGINS TO SNEEZE."
msgstr "~INK 30~ OS DIRIGÍS A UNA ENANA JOVEN, DE APENAS SESENTA AÑOS. OS RESPONDE:^ ~INK 31~ \"¡SALUDOS, FORASTEROS! ¿SABÉIS? ME ALEGRO MUCHO DE QUE ASRUB ESTÉ CON NOSOTROS. ME ENCANTA LA NATURALEZA DE NUESTRA LUNA, PERO NO ES EL LUGAR IDEAL PARA ALGUIEN CON UNA FIEBRE DEL HENO INFERNAL.\"^ ~INK 30~ SE RÍE Y, ACTO SEGUIDO, LE DA UN ATAQUE DE ESTORNUDOS."

#. Text 004 of map 360.
#. German: "EIN STARKER, FRISCHER DUFT NACH PFLANZEN UND KRÄUTERN STEIGT EUCH IM HAUS DES HEILERS IN DIE NASE. HIER FÜHLT MAN SICH SOGAR SCHON NACH EIN PAAR TIEFEN ATEMZÜGEN BESSER."
#: AllTexts/3Map_texts.amb/360/004.txt
msgctxt "AllTexts/3Map_texts.amb/360/004"
msgid "A STRONG FRESH SMELL OF PLANTS AND HERBS SURROUNDS YOU IN THE HOUSE OF THE HEALER. PEOPLE FEEL BETTER HERE AFTER TAKING JUST A FEW DEEP BREATHS."
msgstr "EN LA CASA DEL CURANDERO OS LLEGA UN INTENSO Y FRESCO AROMA A PLANTAS Y HIERBAS. AQUÍ UNO SE SIENTE MEJOR CON SOLO RESPIRAR HONDO UN PAR DE VECES."

#. Text 005 of map 360.
#. German: "IHR SEHT EINE AUFGEROLLTE BAHN SAUBEREN TUCHS. OFFENBAR EIN VERBANDSTOFF."
#: AllTexts/3Map_texts.amb/360/005.txt
msgctxt "AllTexts/3Map_texts.amb/360/005"
msgid "YOU SEE A ROLL OF CLEAN CLOTH. EVIDENTLY A BANDAGE."
msgstr "VEIS UN ROLLO DE TELA LIMPIA. POR LO VISTO, ES PARA HACER VENDAS."

#. Text 006 of map 360.
#. German: "DIES IST OFFENBAR EINS VON ASRUB'S MEDIZINISCHEN INSTRUMENTEN. SCHARF, ABER ZERBRECHLICH, IST ES ZUR BEKÄMPFUNG VON GEGNERN UNGEEIGNET."
#: AllTexts/3Map_texts.amb/360/006.txt
msgctxt "AllTexts/3Map_texts.amb/360/006"
msgid "THIS IS APPARENTLY ONE OF ASRUB'S MEDICAL INSTRUMENTS. SHARP BUT DELICATE, IT IS UNSUITABLE FOR FIGHTING ENEMIES."
msgstr "POR LO VISTO, ES UNO DE LOS INSTRUMENTOS MÉDICOS DE ASRUB. AFILADO PERO FRÁGIL, NO SIRVE PARA LUCHAR CONTRA ENEMIGOS."

#. Text 008 of map 360.
#. German: "DIES IST EIN TRANK, DEN ASRUB ZUR BEHANDLUNG SEINER PATIENTEN BRAUCHT."
#: AllTexts/3Map_texts.amb/360/008.txt
msgctxt "AllTexts/3Map_texts.amb/360/008"
msgid "THIS IS A DRINK WHICH ASRUB USES TO TREAT HIS PATIENTS."
msgstr "ES UNA POCIÓN QUE ASRUB UTILIZA PARA TRATAR A SUS PACIENTES."

#. Text 009 of map 360.
#. German: "EIN MÖRSER ZUR ZERKLEINERUNG VON GETROCKNETEN KRÄUTERN."
#: AllTexts/3Map_texts.amb/360/009.txt
msgctxt "AllTexts/3Map_texts.amb/360/009"
msgid "THIS IS A BOWL FOR BREAKING DOWN DRIED HERBS."
msgstr "UN MORTERO PARA MOLER HIERBAS SECAS."

#. Text 010 of map 360.
#. German: "DIES IST EIN SÄCKCHEN MIT EINEM ÜBELRIECHENDEN PULVER."
#: AllTexts/3Map_texts.amb/360/010.txt
msgctxt "AllTexts/3Map_texts.amb/360/010"
msgid "THIS IS A SMALL BAG CONTAINING A HORRIBLE SMELLING POWDER."
msgstr "ES UNA BOLSITA CON UN POLVO MALOLIENTE."

#. Text 011 of map 360.
#. German: "EIN BÜNDEL GETROCKNETER KRÄUTER. DEM SCHARFEN GERUCH NACH ZU URTEILEN, KÖNNTEN SIE ZUR DESINFEKTION DIENEN."
#: AllTexts/3Map_texts.amb/360/011.txt
msgctxt "AllTexts/3Map_texts.amb/360/011"
msgid "A BUNDLE OF DRIED HERBS. JUDGING BY THE SMELL, THEY COULD BE USED AS A DISINFECTANT."
msgstr "UN MANOJO DE HIERBAS SECAS. A JUZGAR POR SU OLOR PENETRANTE, PODRÍAN SERVIR PARA DESINFECTAR."

#. Text 000 of map 361. The name of the map.
#. German: "GADLON: KELLER 2"
#: AllTexts/3Map_texts.amb/361/000.txt
msgctxt "AllTexts/3Map_texts.amb/361/000"
msgid "GADLON: CELLAR 2"
msgstr "GADLON: SÓTANO 2"

#. Text 001 of map 361.
#. German: "NOCH NIE HAT EINE REISE IN EINEM TELEPORTER SO LANGE GEDAUERT. MIT EINEM ÜBELKEIT ERREGENDEN SCHWINDELGEFÜHL KOMMT IHR WIEDER ZU EUCH."
#: AllTexts/3Map_texts.amb/361/001.txt
msgctxt "AllTexts/3Map_texts.amb/361/001"
msgid "NEVER HAS A JOURNEY IN A TELEPORTER TAKEN SO LONG. YOU RECOVER YOUR SENSES BUT FEEL DIZZY AND UNWELL."
msgstr "NUNCA UN VIAJE EN TELETRANSPORTADOR HABÍA DURADO TANTO. VOLVÉIS EN VOSOTROS CON UN MAREO QUE OS REVUELVE EL ESTÓMAGO."

#. Text 002 of map 361.
#. German: "DIE KISTE IST VÖLLIG LEER."
#: AllTexts/3Map_texts.amb/361/002.txt
msgctxt "AllTexts/3Map_texts.amb/361/002"
msgid "THE BOX IS COMPLETELY EMPTY."
msgstr "LA CAJA ESTÁ COMPLETAMENTE VACÍA."

#. Text 003 of map 361.
#. Placeholders: ~LEAD~ = the active party member; ~SEX2~ = his/her of ~SUBJ~. The gender of these persons is unknown.
#. German: "BEIM VERSUCH, DIE KISTE ZU ÖFFNEN, STICHT EINE VORSCHNELLENDE NADEL ~LEAD~ IN DIE HAND. SEKUNDEN SPÄTER DURCHFLUTET EIN DUMPFER SCHMERZ ~SEX2~N GANZEN ARM."
#: AllTexts/3Map_texts.amb/361/003.txt
msgctxt "AllTexts/3Map_texts.amb/361/003"
msgid "WHEN YOU TRY TO OPEN THE BOX, A NEEDLE SHOOTS INTO ~LEAD~'S HAND. SECONDS LATER, A DULL PAIN SHOOTS THROUGH ~SEX2~ WHOLE ARM."
msgstr "AL INTENTAR ABRIR LA CAJA, UNA AGUJA SALE DISPARADA Y SE CLAVA EN LA MANO DE ~LEAD~. SEGUNDOS DESPUÉS, UN DOLOR SORDO RECORRE TODO ~SEX2~ BRAZO."

#. Text 004 of map 361.
#. German: "DER TELEPORTER, DER EUCH AUSGESPIEN HAT, BLEIBT OHNE WIRKUNG, ALS IHR ERNEUT IN SEIN ENERGIEFELD TRETET."
#: AllTexts/3Map_texts.amb/361/004.txt
msgctxt "AllTexts/3Map_texts.amb/361/004"
msgid "THE TELEPORTER WHICH TIPPED YOU OUT HAS NO EFFECT WHEN YOU RE-ENTER ITS ENERGY FIELD."
msgstr "EL TELETRANSPORTADOR QUE OS HA ESCUPIDO NO SURTE NINGÚN EFECTO CUANDO VOLVÉIS A ENTRAR EN SU CAMPO DE ENERGÍA."

#. Text 005 of map 361.
#. German: "DIE UMGEBUNG WIRKT SELTSAM EINFACH, UND OBWOHL SIE REAL IST, MACHT ALLES AUF EUCH EINEN IRGENDWIE UNVOLLKOMMENEN, UNFERTIGEN EINDRUCK. EIN NICHT GREIFBARES DEJA-VU-GEFÜHL ÜBERKOMMT EUCH FÜR EINEN MOMENT. WOHIN MAG EUCH DER TELEPORTER VERSCHLAGEN HABEN?"
#: AllTexts/3Map_texts.amb/361/005.txt
msgctxt "AllTexts/3Map_texts.amb/361/005"
msgid "THE ENVIRONMENT LOOKS STRANGELY SIMPLE AND ALTHOUGH IT IS REAL, EVERYTHING GIVES THE IMPRESSION OF BEING SOMEHOW INCOMPLETE AND UNFINISHED. AN INEXPLICABLE FEELING OF DEJA VU OVERPOWERS YOU FOR A MOMENT. WHERE HAS THE TELEPORTER BROUGHT YOU?"
msgstr "EL ENTORNO PARECE EXTRAÑAMENTE SIMPLE Y, AUNQUE ES REAL, TODO OS DA UNA IMPRESIÓN DE ALGO IMPERFECTO, INACABADO. DURANTE UN MOMENTO OS INVADE UNA INDEFINIBLE SENSACIÓN DE DEJA VU. ¿ADÓNDE OS HABRÁ LLEVADO EL TELETRANSPORTADOR?"

#. Text 000 of map 362. The name of the map.
#. German: "GADLON: KELLER 1"
#: AllTexts/3Map_texts.amb/362/000.txt
msgctxt "AllTexts/3Map_texts.amb/362/000"
msgid "GADLON: CELLAR 1"
msgstr "GADLON: SÓTANO 1"

#. Text 001 of map 362.
#. Placeholders: ~LEAD~ = the active party member; ~SEX1~ = he/she of ~SUBJ~. The gender of these persons is unknown.
#. German: "~LEAD~ SCHREIT AUF, ALS ~SEX1~ VON EINER VERGIFTETEN NADEL GETROFFEN WIRD."
#: AllTexts/3Map_texts.amb/362/001.txt
msgctxt "AllTexts/3Map_texts.amb/362/001"
msgid "~LEAD~ SCREAMS LOUDLY AS ~SEX1~ IS HIT BY A POISONOUS NEEDLE."
msgstr "~LEAD~ GRITA CON FUERZA: A ~SEX1~ LE HA ALCANZADO UNA AGUJA ENVENENADA."

#. Text 002 of map 362.
#. German: "DIE KISTE IST VÖLLIG LEER."
#: AllTexts/3Map_texts.amb/362/002.txt
msgctxt "AllTexts/3Map_texts.amb/362/002"
msgid "THE BOX IS COMPLETELY EMPTY."
msgstr "LA CAJA ESTÁ COMPLETAMENTE VACÍA."

#. Text 003 of map 362.
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "~LEAD~ LÖST EINE FALLE AUS, DIE EINE KRACHENDE EXPLOSION ZUR FOLGE HAT."
#: AllTexts/3Map_texts.amb/362/003.txt
msgctxt "AllTexts/3Map_texts.amb/362/003"
msgid "~LEAD~ TRIGGERS A TRAP WHICH CAUSES A LOUD EXPLOSION. ␀ "
msgstr "~LEAD~ ACTIVA UNA TRAMPA QUE PROVOCA UNA ESTRUENDOSA EXPLOSIÓN."

#. Text 000 of map 363. The name of the map.
#. German: "GADLON: ERDGESCHOSS"
#: AllTexts/3Map_texts.amb/363/000.txt
msgctxt "AllTexts/3Map_texts.amb/363/000"
msgid "GADLON: GROUND FLOOR"
msgstr "GADLON: PLANTA BAJA"

#. Text 001 of map 363.
#. German: "DIESE KISTE ENTHÄLT LEDIGLICH WERTLOSE KLEIDUNGSSTÜCKE UND ALTES ZEUG."
#: AllTexts/3Map_texts.amb/363/001.txt
msgctxt "AllTexts/3Map_texts.amb/363/001"
msgid "THIS BOX ONLY CONTAINS WORTHLESS ITEMS OF CLOTHING AND OLD RUBBISH."
msgstr "ESTA CAJA SOLO CONTIENE ROPA SIN VALOR Y TRASTOS VIEJOS."

#. Text 002 of map 363.
#. German: "ALLE ÖFFNUNGSVERSUCHE BLEIBEN ERFOLGLOS: DIE TÜR IST FEST VERRIEGELT."
#: AllTexts/3Map_texts.amb/363/002.txt
msgctxt "AllTexts/3Map_texts.amb/363/002"
msgid "ALL ATTEMPTS TO OPEN IT REMAIN UNSUCCESSFUL: THE DOOR IS FIRMLY LOCKED. ␀ "
msgstr "TODOS LOS INTENTOS DE ABRIRLA FRACASAN: LA PUERTA ESTÁ BIEN CERRADA."

#. Text 000 of map 364. The name of the map.
#. German: "GADLON: 1. STOCK"
#: AllTexts/3Map_texts.amb/364/000.txt
msgctxt "AllTexts/3Map_texts.amb/364/000"
msgid "GADLON: FIRST FLOOR"
msgstr "GADLON: PRIMER PISO"

#. Text 001 of map 364.
#. German: "DIESER TURMBEWOHNER IST TIEF IN GEDANKEN VERSUNKEN UND DEMENTSPRECHEND WENIG MITTEILSAM. ER MURMELT UNVERSTÄNDLICHE WORTE VOR SICH HIN UND IST OFFENSICHTLICH BEMÜHT, SICH IRGENDEINEN ZAUBER EINZUPRÄGEN."
#: AllTexts/3Map_texts.amb/364/001.txt
msgctxt "AllTexts/3Map_texts.amb/364/001"
msgid "THIS INHABITANT OF THE TOWER IS DEEP IN THOUGHT AND THEREFORE NOT VERY TALKATIVE. HE MURMURS INCOMPREHENSIBLE WORDS AND IS APPARENTLY TRYING TO LEARN SOME MAGIC. ␀ "
msgstr "ESTE HABITANTE DE LA TORRE ESTÁ ABSORTO EN SUS PENSAMIENTOS Y, POR TANTO, POCO DISPUESTO A CONVERSAR. MASCULLA PALABRAS INCOMPRENSIBLES Y SALTA A LA VISTA QUE INTENTA APRENDERSE DE MEMORIA ALGÚN CONJURO."

#. Text 000 of map 365. The name of the map.
#. German: "GADLON: 2. STOCK"
#: AllTexts/3Map_texts.amb/365/000.txt
msgctxt "AllTexts/3Map_texts.amb/365/000"
msgid "GADLON: SECOND FLOOR"
msgstr "GADLON: SEGUNDO PISO"

#. Text 001 of map 365.
#. German: "~INK 30~ DER GESCHÄFTIG WIRKENDE MANN VOR EUCH LÄSST EUCH GAR NICHT ERST ZU WORT KOMMEN UND SAGT:^ ~INK 31~ \"AH, BESUCHER AUS FREMDEN LANDEN! IHR WOLLT SICHER MIT RINAKLES SPRECHEN. IHR FINDET IHN IN SEINEM ARBEITSZIMMER AM ENDE DES GANGES.\""
#: AllTexts/3Map_texts.amb/365/001.txt
msgctxt "AllTexts/3Map_texts.amb/365/001"
msgid "~INK 30~ THE BUSY-LOOKING MAN BEFORE YOU DOES NOT LET YOU SPEAK AND SAYS:^ ~INK 31~ \"AH, VISITORS FROM A STRANGE COUNTRY! YOU PROBABLY WANT TO SPEAK TO RINAKLES. YOU WILL FIND HIM IN HIS OFFICE AT THE END OF THE CORRIDOR.\""
msgstr "~INK 30~ EL HOMBRE, CON AIRE ATAREADO, NI SIQUIERA OS DEJA ABRIR LA BOCA Y DICE:^ ~INK 31~ \"¡AH, VISITANTES DE TIERRAS EXTRAÑAS! SEGURO QUE QUERÉIS HABLAR CON RINAKLES. LO ENCONTRARÉIS EN SU ESTUDIO, AL FONDO DEL PASILLO.\""

#. Text 002 of map 365.
#. German: "~INK 30~ IN DIESER KISTE BEFINDEN SICH ZAHLREICHE SCHRIFTROLLEN, DIE FÜR EUCH ABER UNVERSTÄNDLICH BLEIBEN. IM HINTERGRUND SAGT RINAKLES:^ ~INK 31~ \"DIES IST MEINE SAMMLUNG ANTIKER ZAUBERSPRÜCHE. ICH WÄRE EUCH VERBUNDEN, WENN IHR SIE IN RUHE LASSEN WÜRDET.\""
#: AllTexts/3Map_texts.amb/365/002.txt
msgctxt "AllTexts/3Map_texts.amb/365/002"
msgid "~INK 30~ THIS BOX CONTAINS NUMEROUS SCROLLS BUT THEY ARE INCOMPREHENSIBLE TO YOU. IN THE BACKGROUND RINAKLES SAYS:^ ~INK 31~ \"THIS IS MY COLLECTION OF ANTIQUE MAGIC SCROLLS. I WOULD BE GRATEFUL IF YOU WOULD LEAVE THEM IN PEACE.\""
msgstr "~INK 30~ EN ESTA CAJA HAY NUMEROSOS PERGAMINOS, PERO NO ENTENDÉIS NADA DE LO QUE PONE. AL FONDO, RINAKLES DICE:^ ~INK 31~ \"ES MI COLECCIÓN DE CONJUROS ANTIGUOS. OS AGRADECERÍA QUE LOS DEJARAIS EN PAZ.\""

#. Text 003 of map 365.
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "~INK 30~ ~LEAD~ ÖFFNET DIE KISTE UND ENTDECKT DORT ZAHLREICHE GEGENSTÄNDE, DEREN FUNKTION EUCH MEIST VERBORGEN BLEIBT: EIN RÖHRENFÖRMIGER METALLSTAB AUS VIER SEGMENTEN, EIN DICKES BUCH, EINE PHIOLE MIT VIOLETTEN PILZEN UND VIELES MEHR. RINAKLES KLINGT LEICHT UNGEHALTEN, ALS ER SAGT:^ ~INK 31~ \"UM EURE NEUGIER ZU BEFRIEDIGEN: DIES SIND ANDENKEN AN MEINE FRÜHEREN ERLEBNISSE.\""
#: AllTexts/3Map_texts.amb/365/003.txt
msgctxt "AllTexts/3Map_texts.amb/365/003"
msgid "~INK 30~ ~LEAD~ OPENS THE BOX AND DISCOVERS MANY ITEMS THERE WHOSE PURPOSE IS MOSTLY UNKNOWN. A TUBULAR METAL ROD WITH FOUR SECTIONS, A THICK BOOK, A PHIAL CONTAINING VIOLET MUSHROOMS AND MANY OTHER THINGS. RINAKLES SEEMS RATHER IMPATIENT AS HE SAYS:^ ~INK 31~ \"TO SATISFY YOUR CURIOUSITY: THESE ARE SOUVENIRS FROM MY EXPERIENCES IN THE PAST.\""
msgstr "~INK 30~ ~LEAD~ ABRE LA CAJA Y DESCUBRE NUMEROSOS OBJETOS CUYA UTILIDAD SE OS ESCAPA CASI SIEMPRE: UNA VARA DE METAL TUBULAR DE CUATRO SEGMENTOS, UN LIBRO GRUESO, UN FRASQUITO CON SETAS VIOLETAS Y MUCHO MÁS. RINAKLES SUENA ALGO MOLESTO CUANDO DICE:^ ~INK 31~ \"PARA SATISFACER VUESTRA CURIOSIDAD: SON RECUERDOS DE MIS AVENTURAS DE ANTAÑO.\""

#. Text 004 of map 365.
#. German: "~INK 30~ NICHTS PASSIERT, ALS IHR IN DAS ENERGIEFELD DES TELEPORTERS TRETET. RINAKLES MEINT:^ ~INK 31~ \"DIESER TELEPORTER DIENT MIR ZUM EXPERIMENTIEREN. ER IST AUGENBLICKLICH NICHT AUF EIN ZIEL JUSTIERT.\""
#: AllTexts/3Map_texts.amb/365/004.txt
msgctxt "AllTexts/3Map_texts.amb/365/004"
msgid "~INK 30~ NOTHING HAPPENS WHEN YOU ENTER THE ENERGY FIELD OF THE TELEPORTER. RINAKLES SAYS:^ ~INK 31~ \"I USE THIS TELEPORTER FOR EXPERIMENTS. IT IS NOT SET TO ANY TARGET AT THE MOMENT.\""
msgstr "~INK 30~ NO PASA NADA CUANDO ENTRÁIS EN EL CAMPO DE ENERGÍA DEL TELETRANSPORTADOR. RINAKLES COMENTA:^ ~INK 31~ \"USO ESTE TELETRANSPORTADOR PARA MIS EXPERIMENTOS. AHORA MISMO NO ESTÁ AJUSTADO A NINGÚN DESTINO.\""

#. Text 005 of map 365.
#. German: "~INK 30~ DER TELEPORTER SUMMT BEDROHLICH, ALS IHR EUCH IHM NÄHERT. DAS ENERGIEFELD IST UNGLAUBLICH STARK, ES REIßT EUCH FÖRMLICH IN SEINEN BEREICH. ALLES WIRD DUNKEL, UND RINAKLES STIMME VERHALLT IM NICHTS ALS ER EUCH NACHRUFT:^ ~INK 31~ \"VIEL GLÜCK!\""
#: AllTexts/3Map_texts.amb/365/005.txt
msgctxt "AllTexts/3Map_texts.amb/365/005"
msgid "~INK 30~ THE TELEPORTER HUMS THREATENINGLY AS YOU APPROACH IT. THE ENERGY FIELD IS INCREDIBLY STRONG. IT DRAGS YOU TOWARDS IT. EVERYTHING GOES DARK AND RINAKLES' VOICE REVERBERATES IN THE ETHER AS HE CALLS AFTER YOU:^ ~INK 31~ \"GOOD LUCK!\""
msgstr "~INK 30~ EL TELETRANSPORTADOR ZUMBA AMENAZADORAMENTE CUANDO OS ACERCÁIS. EL CAMPO DE ENERGÍA ES INCREÍBLEMENTE FUERTE Y OS ARRASTRA LITERALMENTE HACIA ÉL. TODO SE VUELVE OSCURO, Y LA VOZ DE RINAKLES SE PIERDE EN LA NADA MIENTRAS OS GRITA:^ ~INK 31~ \"¡BUENA SUERTE!\""

#. Text 006 of map 365.
#. German: "EIN KRAUSHAARIGER JUNGER MANN FÄHRT HERUM UND HEIßT EUCH WILLKOMMEN."
#: AllTexts/3Map_texts.amb/365/006.txt
msgctxt "AllTexts/3Map_texts.amb/365/006"
msgid "A CURLY-HAIRED YOUNG MAN TURNS ROUND AND WELCOMES YOU. ␀ E"
msgstr "UN JOVEN DE PELO RIZADO SE DA LA VUELTA DE GOLPE Y OS DA LA BIENVENIDA."

#. Text 000 of map 366. The name of the map.
#. German: "ANTIKE ANLAGE 1"
#: AllTexts/3Map_texts.amb/366/000.txt
msgctxt "AllTexts/3Map_texts.amb/366/000"
msgid "ANTIQUE AREA 1"
msgstr "INSTALACIÓN ANTIGUA 1"

#. Text 001 of map 366.
#. German: "DIE BLITZE SIND VON SCHRECKLICHER STÄRKE."
#: AllTexts/3Map_texts.amb/366/001.txt
msgctxt "AllTexts/3Map_texts.amb/366/001"
msgid "THE FLASHES ARE TERRIBLY STRONG."
msgstr "LOS RAYOS SON DE UNA FUERZA TERRIBLE."

#. Text 002 of map 366.
#. German: "AUCH DIESER APPARAT REAGIERT AUF DEN BERNSTEINBROCKEN UND BEGINNT ZU ARBEITEN."
#: AllTexts/3Map_texts.amb/366/002.txt
msgctxt "AllTexts/3Map_texts.amb/366/002"
msgid "THIS APPARATUS, TOO, REACTS TO THE PIECE OF AMBER AND BEGINS TO WORK."
msgstr "TAMBIÉN ESTE APARATO REACCIONA AL TROZO DE ÁMBAR Y SE PONE EN MARCHA."

#. Text 003 of map 366.
#. German: "HIER LIEGEN DIE EINGESTÜRZTEN FELSMASSEN ZU LOCKER, UM DER SPITZHACKE WIDERSTAND LEISTEN ZU KÖNNEN."
#: AllTexts/3Map_texts.amb/366/003.txt
msgctxt "AllTexts/3Map_texts.amb/366/003"
msgid "THE COLLAPSED PILES OF ROCK HERE ARE TOO LOOSE TO WITHSTAND THE PICKAXE."
msgstr "AQUÍ LAS ROCAS DESPRENDIDAS ESTÁN DEMASIADO SUELTAS PARA RESISTIR AL PICO."

#. Text 004 of map 366.
#. German: "DIE TÜR REAGIERT NICHT."
#: AllTexts/3Map_texts.amb/366/004.txt
msgctxt "AllTexts/3Map_texts.amb/366/004"
msgid "THE DOOR DOES NOT RESPOND."
msgstr "LA PUERTA NO REACCIONA."

#. Text 005 of map 366.
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "~LEAD~'S BEMÜHUNGEN SIND ERFOLGREICH: KNIRSCHEND SCHWINGT DIE TÜR AUF."
#: AllTexts/3Map_texts.amb/366/005.txt
msgctxt "AllTexts/3Map_texts.amb/366/005"
msgid "~LEAD~'S ATTEMPTS ARE SUCCESSFUL: THE DOOR CREAKS OPEN."
msgstr "LOS ESFUERZOS DE ~LEAD~ DAN RESULTADO: CON UN CRUJIDO, LA PUERTA SE ABRE."

#. Text 006 of map 366.
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "~LEAD~ FINDET EINEN SELTSAMEN GEGENSTAND IN DEM WANDFACH. ER ERINNERT AM EHESTEN AN EINE ART BUCH."
#: AllTexts/3Map_texts.amb/366/006.txt
msgctxt "AllTexts/3Map_texts.amb/366/006"
msgid "~LEAD~ FINDS A STRANGE OBJECT IN THE COMPARTMENT IN THE WALL. IT REMINDS YOU SOMEHOW OF A KIND OF BOOK. ␀ "
msgstr "~LEAD~ ENCUENTRA UN OBJETO EXTRAÑO EN EL HUECO DE LA PARED. LO MÁS PARECIDO QUE SE OS OCURRE ES UNA ESPECIE DE LIBRO."

#. Text 000 of map 367. The name of the map.
#. German: "ANTIKE ANLAGE 2"
#: AllTexts/3Map_texts.amb/367/000.txt
msgctxt "AllTexts/3Map_texts.amb/367/000"
msgid "ANTIQUE AREA 2"
msgstr "INSTALACIÓN ANTIGUA 2"

#. Text 001 of map 367.
#. German: "DIE WANDERNDEN BLITZE HABEN EUCH ERFASST!"
#: AllTexts/3Map_texts.amb/367/001.txt
msgctxt "AllTexts/3Map_texts.amb/367/001"
msgid "THE WANDERING FLASHES HAVE HIT YOU!"
msgstr "¡LOS RAYOS ERRANTES OS HAN ALCANZADO!"

#. Text 002 of map 367.
#. German: "DIE TÜR REAGIERT NICHT."
#: AllTexts/3Map_texts.amb/367/002.txt
msgctxt "AllTexts/3Map_texts.amb/367/002"
msgid "THE DOOR DOES NOT REACT."
msgstr "LA PUERTA NO REACCIONA."

#. Text 003 of map 367.
#. Placeholders: ~LEAD~ = the active party member; ~SEX2~ = his/her of ~SUBJ~. The gender of these persons is unknown.
#. German: "~LEAD~ REIBT SICH DIE SCHMERZENDEN FINGER NACH DEM UNUNTERBROCHENEN DRÜCKEN AUF DIE KUGELN AN DEM TOR. ABER DER ERFOLG STELLT SICH EIN: DIE TÜR SCHWINGT ÄCHZEND ZUR SEITE."
#: AllTexts/3Map_texts.amb/367/003.txt
msgctxt "AllTexts/3Map_texts.amb/367/003"
msgid "~LEAD~ RUBS ~SEX2~ FINGER IN PAIN AFTER PRESSING THE SPHERES AGAINST THE GATE FOR SUCH A LONG TIME. BUT IT WAS SUCCESSFUL: THE DOOR SWINGS CREAKILY TO ONE SIDE."
msgstr "~LEAD~ SE FROTA LOS DEDOS DOLORIDOS DE ~SEX2~ MANO TRAS PULSAR SIN DESCANSO LAS ESFERAS DEL PORTÓN. PERO HA VALIDO LA PENA: LA PUERTA SE APARTA CON UN GEMIDO."

#. Text 004 of map 367.
#. German: "IHR KÖNNT DIE FUNKTION DIESER EIGENARTIGEN WANDVERZIERUNG NICHT ERGRÜNDEN. ANSCHEINEND SOLLTEN DAMIT EINST IRGENDWELCHE VORGÄNGE ANGEZEIGT WERDEN."
#: AllTexts/3Map_texts.amb/367/004.txt
msgctxt "AllTexts/3Map_texts.amb/367/004"
msgid "YOU CANNOT DETERMINE WHAT THIS STRANGE WALL DECORATION IS FOR. APPARENTLY IT WAS ONCE USED TO SHOW SOMETHING."
msgstr "NO LOGRÁIS AVERIGUAR PARA QUÉ SIRVE ESTE EXTRAÑO ADORNO DE LA PARED. POR LO VISTO, EN SU DÍA SE USABA PARA MOSTRAR ALGÚN TIPO DE PROCESO."

#. Text 005 of map 367.
#. German: "DAS WANDFACH ENTHÄLT NICHTS - AUSSER EINER URALTEN STAUBSCHICHT."
#: AllTexts/3Map_texts.amb/367/005.txt
msgctxt "AllTexts/3Map_texts.amb/367/005"
msgid "THE COMPARTMENT IN THE WALL CONTAINS NOTHING EXCEPT THE DUST OF AGES."
msgstr "EL HUECO DE LA PARED NO CONTIENE NADA, SALVO UNA CAPA DE POLVO ANTIQUÍSIMA."

#. Text 006 of map 367.
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "~LEAD~ FINDET IN DIESEM FACH EIN RÄTSELHAFTES GERÄT."
#: AllTexts/3Map_texts.amb/367/006.txt
msgctxt "AllTexts/3Map_texts.amb/367/006"
msgid "~LEAD~ FINDS A STRANGE APPLIANCE IN THIS COMPARTMENT."
msgstr "~LEAD~ ENCUENTRA EN ESTE HUECO UN APARATO ENIGMÁTICO."

#. Text 007 of map 367.
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "WÄHREND ~LEAD~ NOCH DAS WANDFACH ZU ÖFFNEN VERSUCHT, KNISTERT HINTER EUCH DER TELEPORTER UND SPEIT EINIGE WÄCHTER AUS."
#: AllTexts/3Map_texts.amb/367/007.txt
msgctxt "AllTexts/3Map_texts.amb/367/007"
msgid "WHILE ~LEAD~ IS STILL TRYING TO OPEN THE COMPARTMENT THE TELEPORTER BEHIND YOU CRACKLES INTO LIFE AND SPITS OUT SEVERAL GUARDS."
msgstr "MIENTRAS ~LEAD~ AÚN INTENTA ABRIR EL HUECO DE LA PARED, A VUESTRA ESPALDA EL TELETRANSPORTADOR CHISPORROTEA Y ESCUPE A VARIOS GUARDIANES."

#. Text 008 of map 367.
#. German: "AUCH HIER SIND DIE ALTEN EINRICHTUNGEN ZUM LEBEN ERWACHT. ALLERDINGS SCHEINT NACH SO LANGER ZEIT NICHT MEHR ALLES ZU FUNKTIONIEREN: VOR EUCH TORKELN BLITZE UND EINIGE DER SELTSAMEN WÄCHTER AUS GLAS UND METALL HERUM."
#: AllTexts/3Map_texts.amb/367/008.txt
msgctxt "AllTexts/3Map_texts.amb/367/008"
msgid "HERE, TOO, THE OLD EQUIPMENT HAS BEEN BROUGHT TO LIFE. BUT AFTER SUCH A LONG TIME NOT EVERYTHING SEEMS TO OPERATE CORRECTLY. LIGHT FLASHES AND SOME OF THE STRANGE GUARDS MADE OF GLASS AND METAL STAGGER AROUND YOU DIZZILY."
msgstr "TAMBIÉN AQUÍ LAS VIEJAS INSTALACIONES HAN COBRADO VIDA. SIN EMBARGO, DESPUÉS DE TANTO TIEMPO NO TODO PARECE FUNCIONAR BIEN: ANTE VOSOTROS DAN TUMBOS RAYOS Y ALGUNOS DE LOS EXTRAÑOS GUARDIANES DE CRISTAL Y METAL."

#. Text 009 of map 367.
#. German: "DAS ENERGIEFELD DES TELEPORTERS STÖSST EUCH ZURÜCK, ANSONSTEN PASSIERT NICHTS."
#: AllTexts/3Map_texts.amb/367/009.txt
msgctxt "AllTexts/3Map_texts.amb/367/009"
msgid "THE ENERGY FIELD OF THE TELEPORTER PUSHES YOU BACK BUT OTHERWISE NOTHING HAPPENS. ␀ "
msgstr "EL CAMPO DE ENERGÍA DEL TELETRANSPORTADOR OS REPELE, PERO NO PASA NADA MÁS."

#. Text 000 of map 368. The name of the map.
#. German: "ANTIKE ANLAGE 3"
#: AllTexts/3Map_texts.amb/368/000.txt
msgctxt "AllTexts/3Map_texts.amb/368/000"
msgid "ANTIQUE AREA 3"
msgstr "INSTALACIÓN ANTIGUA 3"

#. Text 001 of map 368.
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "DER TELEPORTER NEBEN EUCH ERWACHT KNISTERND ZUM LEBEN, ALS ~LEAD~ DEN SCHALTER BETÄTIGT."
#: AllTexts/3Map_texts.amb/368/001.txt
msgctxt "AllTexts/3Map_texts.amb/368/001"
msgid "THE TELEPORTER NEXT TO YOU CRACKLES INTO LIFE AS ~LEAD~ PRESSES THE SWITCH."
msgstr "EL TELETRANSPORTADOR QUE TENÉIS AL LADO COBRA VIDA CHISPORROTEANDO CUANDO ~LEAD~ ACCIONA LA PALANCA."

#. Text 002 of map 368.
#. Placeholders: ~LEAD~ = the active party member; ~SEX1~ = he/she of ~SUBJ~. The gender of these persons is unknown.
#. German: "ALS ~LEAD~ DAS SKELETT SORGFÄLTIG ABSUCHT, FINDET SICH EIN UNGEWÖHNLICHER GEGENSTAND."
#: AllTexts/3Map_texts.amb/368/002.txt
msgctxt "AllTexts/3Map_texts.amb/368/002"
msgid "AS ~LEAD~ EXAMINES THE SKELETON CAREFULLY ~SEX1~ FINDS AN UNUSUAL OBJECT."
msgstr "MIENTRAS ~LEAD~ REGISTRA CON CUIDADO EL ESQUELETO, ~SEX1~ ENCUENTRA UN OBJETO INUSUAL."

#. Text 003 of map 368.
#. German: "EISKALT FÄHRT EUCH DER SCHRECKEN DURCH DIE GLIEDER: IHR SEID VOR EINE GANZE HORDE DER GEFÄHRLICHEN WÄCHTER TELEPORTIERT WORDEN! DER GEDANKE AN FLUCHT SCHIEßT EUCH DURCH DEN KOPF..."
#: AllTexts/3Map_texts.amb/368/003.txt
msgctxt "AllTexts/3Map_texts.amb/368/003"
msgid "ICE-COLD HORROR FLOODS THROUGH YOUR VEINS: YOU HAVE BEEN TELEPORTED RIGHT IN FRONT OF A WHOLE CROWD OF DANGEROUS GUARDS! THE IDEA OF FLEEING SHOOTS THROUGH YOUR MIND ... ␀ "
msgstr "UN ESCALOFRÍO DE TERROR OS RECORRE EL CUERPO: ¡OS HAN TELETRANSPORTADO DELANTE DE TODA UNA HORDA DE PELIGROSOS GUARDIANES! LA IDEA DE HUIR OS CRUZA LA MENTE..."

#. Text 000 of map 369. The name of the map.
#. German: "ANTIKE ANLAGE 4"
#: AllTexts/3Map_texts.amb/369/000.txt
msgctxt "AllTexts/3Map_texts.amb/369/000"
msgid "ANTIQUE AREA 4"
msgstr "INSTALACIÓN ANTIGUA 4"

#. Text 001 of map 369.
#. German: "DIESES FACH ENTHÄLT EINE GANZE ANZAHL VON FARBIG GRAVIERTEN, METALLENEN SCHEIBEN."
#: AllTexts/3Map_texts.amb/369/001.txt
msgctxt "AllTexts/3Map_texts.amb/369/001"
msgid "THIS CUPBOARD CONTAINS A LARGE NUMBER OF METAL DISCS ENGRAVED IN COLOURS."
msgstr "ESTE HUECO CONTIENE UN BUEN NÚMERO DE DISCOS METÁLICOS GRABADOS EN COLORES."

#. Text 002 of map 369.
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "~LEAD~'S VERSUCH, DAS WANDFACH ZU ÖFFNEN, WIRD VON DEN GEHEIMNISVOLLEN MASCHINEN DER ANTIKEN ANLAGE REGISTRIERT. WÄCHTER ERSCHEINEN HINTER EUCH."
#: AllTexts/3Map_texts.amb/369/002.txt
msgctxt "AllTexts/3Map_texts.amb/369/002"
msgid "~LEAD~'S ATTEMPT TO OPEN THE WALL-VAULT IS REGISTERED BY THE STRANGE MACHINES IN THE ANTIQUATED SYSTEM. GUARDS APPEAR BEHIND YOU."
msgstr "LAS MISTERIOSAS MÁQUINAS DE LA INSTALACIÓN ANTIGUA DETECTAN EL INTENTO DE ~LEAD~ DE ABRIR EL HUECO DE LA PARED. A VUESTRA ESPALDA APARECEN GUARDIANES."

#. Text 003 of map 369.
#. German: "DAS TELEPORTERFELD BLEIBT OHNE WIRKUNG AUF EUCH."
#: AllTexts/3Map_texts.amb/369/003.txt
msgctxt "AllTexts/3Map_texts.amb/369/003"
msgid "THE TELEPORTER FIELD HAS NO EFFECT ON YOU."
msgstr "EL CAMPO DEL TELETRANSPORTADOR NO SURTE NINGÚN EFECTO EN VOSOTROS."

#. Text 004 of map 369.
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "OBWOHL SICH BEREITS EINE DER GRAVIERTEN SCHEIBEN IN DEM GERÄT BEFINDET, VERSUCHT ~LEAD~, EINE WEITERE HINEINZUSTOßEN. DIE ZWEITE SCHEIBE ZERBRICHT DABEI."
#: AllTexts/3Map_texts.amb/369/004.txt
msgctxt "AllTexts/3Map_texts.amb/369/004"
msgid "ALTHOUGH ONE OF THE ENGRAVED DISCS IS ALREADY IN THE UNIT, ~LEAD~ TRIES TO INSERT ANOTHER. THE SECOND DISC BREAKS APART."
msgstr "AUNQUE YA HAY UNO DE LOS DISCOS GRABADOS DENTRO DEL APARATO, ~LEAD~ INTENTA METER OTRO A LA FUERZA. EL SEGUNDO DISCO SE ROMPE."

#. Text 005 of map 369.
#. German: "DIE SCHEIBE PASST PERFEKT IN DAS GERÄT HINEIN."
#: AllTexts/3Map_texts.amb/369/005.txt
msgctxt "AllTexts/3Map_texts.amb/369/005"
msgid "THE DISC FITS PERFECTLY INTO THE UNIT."
msgstr "EL DISCO ENCAJA PERFECTAMENTE EN EL APARATO."

#. Text 006 of map 369.
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "ZWISCHEN KNOCHEN, DIE DIE HAND DIESES FREMDARTIGEN SKELETTS SEIN KÖNNTEN, FINDET ~LEAD~ EINE ROT GRAVIERTE KUGEL AUS METALL."
#: AllTexts/3Map_texts.amb/369/006.txt
msgctxt "AllTexts/3Map_texts.amb/369/006"
msgid "AMONGST BONES WHICH COULD BE THE HAND OF THIS STRANGE SKELETON ~LEAD~ FINDS A METAL GLOBE ENGRAVED IN RED."
msgstr "ENTRE UNOS HUESOS QUE PODRÍAN SER LA MANO DE ESTE EXTRAÑO ESQUELETO, ~LEAD~ ENCUENTRA UNA ESFERA DE METAL GRABADA EN ROJO."

#. Text 007 of map 369.
#. Placeholders: ~SELF~ = the hero (the player character). The gender of these persons is unknown.
#. German: "~INK 30~ ALS DIE GRUPPE DEN RAUM MIT DER TELEPORTERANLAGE BETRITT, BEGINNT VALDYN ZU SPRECHEN:^ ~INK 31~ \"FREUNDE, DER RUF MEINER HEIMAT UND DIE SEHNSUCHT NACH ILLENE SIND STARK, SEHR STARK SOGAR! ABER ICH HABE MICH ENTSCHLOSSEN, DIE GELBE KUGEL ERST DANN ZUR HEIMREISE ZU BENUTZEN, WENN UNSERE MISSION ABGESCHLOSSEN IST.\"^ ~INK 30~ ~SELF~ LEGT EINE HAND AUF VALDYN'S SCHULTER UND DANKT IHM IM NAMEN ALLER. VALDYN HEBT DIE ARME UND SAGT:^ ~INK 31~ \"BESINGT NICHT MEINEN HELDENMUT! WIR HABEN ZUSAMMEN SO VIELE GEFAHREN ÜBERSTANDEN, DASS ICH WIRKLICH VERDAMMT NEUGIERIG BIN, WIE DIE SACHE AUSGEHEN WIRD.\""
#: AllTexts/3Map_texts.amb/369/007.txt
msgctxt "AllTexts/3Map_texts.amb/369/007"
msgid "~INK 30~ AS THE GROUP ENTERS THE ROOM WITH THE TELEPORTER SYSTEM VALDYN STARTS TO SPEAK:^ ~INK 31~ \"FRIENDS, MY HOMESICKNESS AND LONGING FOR ILLENE ARE STRONG, EVEN VERY STRONG INDEED! BUT I HAVE DECIDED ONLY TO USE THE YELLOW GLOBE TO TRAVEL HOME WHEN OUR MISSION HAS BEEN COMPLETED.\"^ ~INK 30~ ~SELF~ LAYS A HAND ON VALDYN'S SHOULDER AND THANKS HIM ON BEHALF OF EVERYONE. VALDYN RAISES HIS ARMS AND SAYS:^ ~INK 31~ \"DO NOT SING ABOUT MY HEROISM! TOGETHER WE HAVE OVERCOME SO MANY DANGERS THAT I AM JUST VERY CURIOUS TO SEE HOW THE MATTER WILL END.\""
msgstr "~INK 30~ CUANDO EL GRUPO ENTRA EN LA SALA DEL TELETRANSPORTADOR, VALDYN EMPIEZA A HABLAR:^ ~INK 31~ \"AMIGOS, LA LLAMADA DE MI HOGAR Y LA AÑORANZA DE ILLENE SON FUERTES, ¡MUY FUERTES! PERO HE DECIDIDO NO USAR LA ESFERA AMARILLA PARA VOLVER A CASA HASTA QUE NUESTRA MISIÓN HAYA TERMINADO.\"^ ~INK 30~ ~SELF~ LE PONE UNA MANO EN EL HOMBRO A VALDYN Y LE DA LAS GRACIAS EN NOMBRE DE TODOS. VALDYN ALZA LOS BRAZOS Y DICE:^ ~INK 31~ \"¡NO CANTÉIS MI HEROÍSMO! HEMOS SUPERADO JUNTOS TANTOS PELIGROS QUE TENGO UNA CURIOSIDAD ENDIABLADA POR VER CÓMO ACABA TODO ESTO.\""

#. Text 008 of map 369.
#. German: "DIE MASCHINE SCHLIEßT SICH UM DEN BERNSTEINBROCKEN."
#: AllTexts/3Map_texts.amb/369/008.txt
msgctxt "AllTexts/3Map_texts.amb/369/008"
msgid "THE MACHINE CLOSES AROUND THE PIECE OF AMBER."
msgstr "LA MÁQUINA SE CIERRA ALREDEDOR DEL TROZO DE ÁMBAR."

#. Text 009 of map 369.
#. German: "SOWIE IHR AN DAS OBJEKT HERANTRETET, ÖFFNET ES SICH GERÄUSCHLOS UND PRÄSENTIERT - EINEN NAVIGATIONSSTEIN!"
#: AllTexts/3Map_texts.amb/369/009.txt
msgctxt "AllTexts/3Map_texts.amb/369/009"
msgid "JUST AS YOU APPROACH THE OBJECT IT OPENS SILENTLY AND PRESENTS - A NAVIGATION STONE!"
msgstr "EN CUANTO OS ACERCÁIS AL OBJETO, SE ABRE SIN HACER RUIDO Y OS MUESTRA... ¡UNA NAVIPIEDRA!"

#. Text 010 of map 369.
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "~LEAD~ SIEHT IN DEM GERÄT EINEN GELBEN NAVIGATIONSSTEIN."
#: AllTexts/3Map_texts.amb/369/010.txt
msgctxt "AllTexts/3Map_texts.amb/369/010"
msgid "~LEAD~ SEES A YELLOW NAVIGATION STONE IN THE UNIT."
msgstr "~LEAD~ VE UNA NAVIPIEDRA AMARILLA DENTRO DEL APARATO."

#. Text 011 of map 369.
#. German: "EIN GRÜNER NAVIGATIONSSTEIN LIEGT IM INNERN DES GERÄTS."
#: AllTexts/3Map_texts.amb/369/011.txt
msgctxt "AllTexts/3Map_texts.amb/369/011"
msgid "A GREEN NAVIGATION STONE LIES INSIDE THE UNIT."
msgstr "DENTRO DEL APARATO HAY UNA NAVIPIEDRA VERDE."

#. Text 012 of map 369.
#. German: "DAS GERÄT PRÄSENTIERT EUCH EINEN BLAUEN NAVIGATIONSSTEIN."
#: AllTexts/3Map_texts.amb/369/012.txt
msgctxt "AllTexts/3Map_texts.amb/369/012"
msgid "THE UNIT PRESENTS YOU WITH A BLUE NAVIGATION STONE."
msgstr "EL APARATO OS OFRECE UNA NAVIPIEDRA AZUL."

#. Text 013 of map 369.
#. German: "DAS TELEPORTERFELD IST UNGEWÖHNLICH STARK. KURZ BEVOR ALLES UM EUCH HERUM VERSCHWINDET, HÖRT IHR AUS DER RICHTUNG DER MASCHINE, DIE SICH IN DEM RAUM BEFINDET, EIN KNISTERN. VERMUTLICH HAT SICH DIE ROT GRAVIERTE KUGEL AUFGELÖST."
#: AllTexts/3Map_texts.amb/369/013.txt
msgctxt "AllTexts/3Map_texts.amb/369/013"
msgid "THE TELEPORTER FIELD IS UNUSUALLY STRONG. SHORTLY BEFORE EVERYTHING AROUND YOU DISAPPEARS, YOU HEAR A CRACKLING AND HISSING FROM THE DIRECTION OF THE MACHINE IN THE ROOM. THE GLOBE ENGRAVED IN RED HAS PROBABLY DISSOLVED."
msgstr "EL CAMPO DEL TELETRANSPORTADOR ES INUSUALMENTE FUERTE. JUSTO ANTES DE QUE TODO DESAPAREZCA A VUESTRO ALREDEDOR, OÍS UN CHISPORROTEO QUE VIENE DE LA MÁQUINA DE LA SALA. SEGURAMENTE LA ESFERA GRABADA EN ROJO SE HA DESINTEGRADO."

#. Text 015 of map 369.
#. German: "DIE MASCHINE NIMMT DIE GRAVIERTE KUGEL AUF UND AKTIVIERT DEN TELEPORTER AM ENDE DER KETTE AUS LEUCHTKUGELN."
#: AllTexts/3Map_texts.amb/369/015.txt
msgctxt "AllTexts/3Map_texts.amb/369/015"
msgid "THE MACHINE TAKES UP THE ENGRAVED GLOBE AND ACTIVATES THE TELEPORTER AT THE END OF THE CHAIN OF THE SPHERES OF LIGHT."
msgstr "LA MÁQUINA RECIBE LA ESFERA GRABADA Y ACTIVA EL TELETRANSPORTADOR QUE HAY AL FINAL DE LA HILERA DE ESFERAS LUMINOSAS."

#. Text 016 of map 369.
#. German: "~INK 30~ VALDYN SAGT:^ ~INK 31~ \"WENN ICH ES RECHT BEDENKE, FREUNDE, HALTE ICH ES FÜR KEINE GUTE IDEE, DIE GELBE KUGEL ZU BENUTZEN. VON MEINER HEIMAT WIRD ES WOHL KEINE RÜCKKEHR MEHR FÜR EUCH GEBEN, DENN WELTENUMSPANNENDE TELEPORTERVORRICHTUNGEN SIND UNS UNBEKANNT. LASST MICH DEN HEIMWEG ALLEIN ANTRETEN, WENN WIR UNSERE MISSION ERFÜLLT HABEN.\""
#: AllTexts/3Map_texts.amb/369/016.txt
msgctxt "AllTexts/3Map_texts.amb/369/016"
msgid "~INK 30~ VALDYN SAYS:^ ~INK 31~ \"IF I AM RIGHT, FRIENDS, I THINK IT WOULD BE A GOOD IDEA TO USE THE YELLOW GLOBE. YOU WILL PROBABLY NOT BE ABLE TO RETURN AGAIN FROM MY HOME BECAUSE WE DO NOT HAVE ANY TELEPORTER DEVICES WHICH SPAN THE ENTIRE WORLD. LET ME START MY JOURNEY HOME ALONE WHEN WE HAVE FULFILLED OUR MISSION.\" ␀ "
msgstr "~INK 30~ VALDYN DICE:^ ~INK 31~ \"BIEN PENSADO, AMIGOS, NO CREO QUE SEA BUENA IDEA USAR LA ESFERA AMARILLA. DESDE MI HOGAR SEGURAMENTE NO PODRÍAIS VOLVER, PORQUE ALLÍ NO CONOCEMOS NINGÚN TELETRANSPORTADOR QUE ABARQUE MUNDOS ENTEROS. DEJAD QUE EMPRENDA SOLO EL CAMINO DE VUELTA CUANDO HAYAMOS CUMPLIDO NUESTRA MISIÓN.\""

