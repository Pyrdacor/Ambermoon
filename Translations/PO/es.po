msgid "THE GROUP IS BEING ATTACKED! YOU ONLY NOTICE THE BEAUTIFULLY CLAMOUFLAGED BEASTS WHEN YOU ALMOST RUN RIGHT INTO THEM."
msgstr "¡EL GRUPO SUFRE UN ATAQUE! NO VEIS A LAS BESTIAS, MAGNÍFICAMENTE CAMUFLADAS, HASTA QUE CASI OS TOPÁIS CON ELLAS."

#. Text 007 of map 322.
#. German: "DEM SCHLAMMIGEN BODEN ENTSTEIGEN PLÖTZLICH ZAHLREICHE HUNGRIGE SUMPFBEWOHNER."
#: AllTexts/3Map_texts.amb/322/007.txt
msgctxt "AllTexts/3Map_texts.amb/322/007"
msgid "SUDDENLY LOTS OF HUNGRY BOG-DWELLERS CLAMBER OUT OF THE SLUDGY GROUND."
msgstr "DE REPENTE, DEL SUELO FANGOSO SURGEN NUMEROSAS CRIATURAS HAMBRIENTAS DEL PANTANO."

#. Text 008 of map 322.
#. German: "SOBALD IHR DER SELTSAMEN PFLANZE NAHEKOMMT, PEITSCHEN IHRE TENTAKEL AUF EUCH EIN. DIE SPITZEN DER AUSWÜCHSE BRENNEN WIE FEUER."
#: AllTexts/3Map_texts.amb/322/008.txt
msgctxt "AllTexts/3Map_texts.amb/322/008"
msgid "AS SOON AS YOU GET CLOSE TO THE STRANGE PLANT, ITS TENTACLES SHOOT OUT TOWARDS YOU. THE TIPS OF ITS BRANCHES BURN LIKE FIRE. ␀ "
msgstr "EN CUANTO OS ACERCÁIS A LA EXTRAÑA PLANTA, SUS TENTÁCULOS OS AZOTAN. LAS PUNTAS DE SUS BROTES QUEMAN COMO EL FUEGO."

#. Text 000 of map 323. The name of the map.
#. German: "KIRE'S MOND"
#: AllTexts/3Map_texts.amb/323/000.txt
msgctxt "AllTexts/3Map_texts.amb/323/000"
msgid "KIRE'S MOON"
msgstr "LUNA DE KIRE"

#. Text 001 of map 323.
#. German: "DANK ASRUB'S BESCHREIBUNG WERDET IHR AUF EIN AROMATISCH RIECHENDES KRAUT AUFMERKSAM."
#: AllTexts/3Map_texts.amb/323/001.txt
msgctxt "AllTexts/3Map_texts.amb/323/001"
msgid "THANKS TO ASRUB'S DESCRIPTION, YOU ARE ON THE LOOK-OUT FOR AN AROMATIC HERB."
msgstr "GRACIAS A LA DESCRIPCIÓN DE ASRUB, OS FIJÁIS EN UNA HIERBA DE OLOR AROMÁTICO."

#. Text 002 of map 323.
#. German: "DIESE LEUCHTENDEN BLÜTEN SIND VON ASRUB ALS SEHR WIRKUNGSVOLL BESCHRIEBEN WORDEN."
#: AllTexts/3Map_texts.amb/323/002.txt
msgctxt "AllTexts/3Map_texts.amb/323/002"
msgid "THESE BRIGHT FLOWERS WERE DESCRIBED BY ASRUB AS BEING VERY EFFECTIVE."
msgstr "ASRUB OS DESCRIBIÓ ESTAS FLORES LUMINOSAS COMO MUY EFICACES."

#. Text 003 of map 323.
#. German: "EINIGE LÄNGLICHE BLÄTTER WACHSEN HIER. ASRUB ERWÄHNTE SIE ALS WERTVOLL."
#: AllTexts/3Map_texts.amb/323/003.txt
msgctxt "AllTexts/3Map_texts.amb/323/003"
msgid "THERE ARE SOME LONG THIN LEAVES GROWING HERE. ASRUB SAID THEY ARE VALUABLE."
msgstr "AQUÍ CRECEN ALGUNAS HOJAS ALARGADAS. ASRUB LAS MENCIONÓ COMO VALIOSAS."

#. Text 004 of map 323.
#. German: "IHR ERINNERT EUCH AN DIE WORTE VON ASRUB. DIESE BLAUEN HALME KAMEN IN SEINER LEKTION ÜBER BESONDERE KRÄUTER VOR."
#: AllTexts/3Map_texts.amb/323/004.txt
msgctxt "AllTexts/3Map_texts.amb/323/004"
msgid "YOU REMEMBER ASRUB'S WORDS. THESE BLUE STALKS WERE MENTIONED IN HIS LESSON ABOUT SPECIAL HERBS."
msgstr "RECORDÁIS LAS PALABRAS DE ASRUB. ESTOS TALLOS AZULES APARECÍAN EN SU LECCIÓN SOBRE HIERBAS ESPECIALES."

#. Text 005 of map 323.
#. German: "EINIGE KLEINE PILZE FALLEN EUCH DURCH IHR INTENSIVES GLÄNZEN AUF. ASRUB ÄUßERTE SICH IN SEINER LEKTION SEHR POSITIV ÜBER SIE."
#: AllTexts/3Map_texts.amb/323/005.txt
msgctxt "AllTexts/3Map_texts.amb/323/005"
msgid "YOU NOTICE A FEW SMALL MUSHROOMS BECAUSE THEY ARE GLOWING BRIGHTLY. ASRUB SPOKE VERY ENTHUSIASTICALLY ABOUT THEM IN HIS LESSON."
msgstr "UNAS PEQUEÑAS SETAS OS LLAMAN LA ATENCIÓN POR SU INTENSO CENTELLEO. ASRUB HABLÓ MUY BIEN DE ELLAS EN SU LECCIÓN."

#. Text 006 of map 323.
#. German: "DIE GRUPPE WIRD ANGEGRIFFEN! IHR BEMERKT DIE HERVORRAGEND GETARNTEN BESTIEN ERST, ALS IHR FAST IN SIE HINEINLAUFT."
#: AllTexts/3Map_texts.amb/323/006.txt
msgctxt "AllTexts/3Map_texts.amb/323/006"
msgid "THE GROUP IS BEING ATTACKED! YOU ONLY NOTICE THE BEAUTIFULLY CLAMOUFLAGED BEASTS WHEN YOU ALMOST RUN RIGHT INTO THEM."
msgstr "¡EL GRUPO SUFRE UN ATAQUE! NO VEIS A LAS BESTIAS, MAGNÍFICAMENTE CAMUFLADAS, HASTA QUE CASI OS TOPÁIS CON ELLAS."

#. Text 007 of map 323.
#. German: "DEM SCHLAMMIGEN BODEN ENTSTEIGEN PLÖTZLICH ZAHLREICHE HUNGRIGE SUMPFBEWOHNER."
#: AllTexts/3Map_texts.amb/323/007.txt
msgctxt "AllTexts/3Map_texts.amb/323/007"
msgid "SUDDENLY LOTS OF HUNGRY BOG-DWELLERS CLAMBER OUT OF THE SLUDGY GROUND."
msgstr "DE REPENTE, DEL SUELO FANGOSO SURGEN NUMEROSAS CRIATURAS HAMBRIENTAS DEL PANTANO."

#. Text 008 of map 323.
#. German: "SOBALD IHR DER SELTSAMEN PFLANZE NAHEKOMMT, PEITSCHEN IHRE TENTAKEL AUF EUCH EIN. DIE SPITZEN DER AUSWÜCHSE BRENNEN WIE FEUER."
#: AllTexts/3Map_texts.amb/323/008.txt
msgctxt "AllTexts/3Map_texts.amb/323/008"
msgid "AS SOON AS YOU GET CLOSE TO THE STRANGE PLANT, ITS TENTACLES SHOOT OUT TOWARDS YOU. THE TIPS OF ITS BRANCHES BURN LIKE FIRE. ␀ "
msgstr "EN CUANTO OS ACERCÁIS A LA EXTRAÑA PLANTA, SUS TENTÁCULOS OS AZOTAN. LAS PUNTAS DE SUS BROTES QUEMAN COMO EL FUEGO."

