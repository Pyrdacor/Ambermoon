#. Length: the existing texts of this kind have at most 15 characters.
#: AllTexts/NPC_char.amb/070.txt
msgctxt "AllTexts/NPC_char.amb/070"
msgid "RINAKLES"
msgstr ""

#. Dialogue of NPC 001 (GRANDFATHER).
#. German: "DU SIEHST EINEN ALTEN KRANKEN MANN. SEINE WANGEN SIND ASCHFAHL UND EINGEFALLEN. DIE LIDER SEINER AUGEN SIND ZU EINEM SCHLITZ ZUSAMMENGEPRESST UND ZUCKEN LEICHT IM SCHEIN DES KAMINFEUERS. SEIN ATEM GEHT RASSELND UND STOßWEISE."
#: AllTexts/NPC_texts.amb/001/000.txt
msgctxt "AllTexts/NPC_texts.amb/001/000"
msgid "YOU SEE AN OLD SICK MAN. HIS CHEEKS ARE SUNKEN AND AS PALE AS ASH. HIS EYES ARE TIGHTLY SHUT, FLINCHING WITH THE LIGHT OF THE FIRE. HIS BREATH IS LABOURED AND RATTLES IN HIS THROAT."
msgstr ""

#. Dialogue of NPC 001 (GRANDFATHER).
#. Placeholders: ~SELF~ = the hero (the player character). The gender of these persons is unknown.
#. German: "\"HALLO ~SELF~, KOMM BITTE NÄHER ANS BETT, MEIN GELIEBTES ENKELKIND! MEIN KÖRPER IST SCHWACH, UND MEINE STIMME WILL NICHT MEHR SO WIE FRÜHER.\""
#: AllTexts/NPC_texts.amb/001/001.txt
msgctxt "AllTexts/NPC_texts.amb/001/001"
msgid "\"HELLO ~SELF~, PLEASE COME CLOSER TO THE BED, MY BELOVED GRANDCHILD! MY BODY IS WEAK AND MY VOICE IS NOT AS STRONG AS BEFORE.\""
msgstr ""

#. Dialogue of NPC 001 (GRANDFATHER).
#. German: "\"ICH MÖCHTE DIR EINE GESCHICHTE ERZÄHLEN UND DIR DANACH EINE QUESTE ÜBERANTWORTEN.\"^ ALS DU NÄHER ANS BETT TRITTST, UM DEINEN GROßVATER BESSER ZU VERSTEHEN, SIEHST DU, WIE SICH SEIN GESICHT IM SCHMERZ VERZERRT, UND DU MEINST ÜBER SEINEM KOPF DEN GNÄDIGEN SCHATTEN VON BALA ZU SEHEN.^ \"ALS ICH SO ALT WAR WIE DU, HABE ICH EINE GROßE UND SCHWERE QUESTE ZU BESTEHEN GEHABT. DEINE URGROßELTERN WAREN KURZ ZUVOR VON MARODIERENDEN ORKS GETÖTET WORDEN. EIN PAAR TAGE NACH DER BEERDIGUNG TRAF ICH DIE ENTSCHEIDUNG, AUF ABENTEUER ZU GEHEN. MEINE ERSTE AUFGABE HOLTE ICH MIR BEIM LORDKANZLER VON TWINLAKE, DER EIN KLEINES PROBLEM IN SEINEM KANALISATIONSSYSTEM HATTE. ALS DIE AUFGABE ERFOLGREICH ABGESCHLOSSEN WAR, ERZÄHLTE MIR KARWAIN, DER LORDKANZLER, DASS SHANDRA, DER GRAUE MAGIER, EINE AUFGABE HÄTTE UND EINE GRUPPE VON MUTIGEN LEUTEN SUCHE.^ NOCH AM GLEICHEN ABEND MACHTE ICH MICH AUF UND GING ZU SHANDRA. WAS DANN GESCHAH, HAST DU SICHER SCHON IN DEN GESCHICHTEN UND LIEDERN DER BARDEN GEHÖRT. NUR DASS ICH DER GROßE HELD WAR, HABE ICH DIR NIE ERZÄHLT, DENN ICH FINDE, DASS MAN MIT SEINEN TATEN NICHT PRAHLEN SOLL.^ DER GRUND, WARUM ICH DIR DIES JETZT ERZÄHLE, IST, DASS MIR LETZTE NACHT IN MEINEN FIEBERTRÄUMEN SHANDRA ERSCHIEN. DIE NEBELHAFTE ERSCHEINUNG SAGTE MIR, DASS SICH ERNEUT EINE DUNKLE MACHT ÜBER DAS LAND AUSBREITET, DIE DIE VERNICHTUNG LYRAMION'S HERBEIFÜHREN WILL.\"^ EIN HEFTIGER HUSTENANFALL ZWINGT IHN ZU EINER PAUSE. SCHLIEßLICH FÄHRT ER FORT:^ \"ACH, ALS OB DER ABSTURZ DES DRITTEN MONDES NICHT SCHON GENUG QUALEN UND ELEND ÜBER LYRAMION GEBRACHT HÄTTE! DEINE GELIEBTEN ELTERN STARBEN IN DIESER SCHRECKLICHEN KATASTROPHE. NUR DICH KONNTE ICH GERADE NOCH AUS DEM FEUERMEER RETTEN. MEIN GELIEBTES TWINLAKE GING UNTER IN FEUER UND WASSER.^ ABER ICH MERKE, DASS ICH ABSCHWEIFE, UND ICH HABE DAS GEFÜHL, DASS ICH NICHT MEHR VIEL ZEIT HABE. DESHALB WILL ICH MICH BEEILEN, DIR DEN REST ZU ERZÄHLEN.^ ALSO, SHANDRA SAGTE, DASS DAS GUTE IN UNSERER FAMILIE STARK SEI UND ER DICH AUSGESUCHT HABE, UM LYRAMION ERNEUT ZU RETTEN. DU SOLLST DICH AUF DEN WEG MACHEN UND NACH NEWLAKE REISEN, UM MIT IHM ZU SPRECHEN.^ DAS SELTSAME IST NUR, DAS SHANDRA VOR ÜBER VIERZIG JAHREN GESTORBEN IST! BEI MEINER FLUCHT AUS TWINLAKE HABE ICH NOCH GESEHEN, WIE ER EINE GROßE ZAHL VON LEUTEN IN SICHERHEIT TELEPORTIERTE. DANACH BRACH ER DANN VÖLLIG ERSCHÖPFT ZUSAMMEN.^ ENTWEDER HAT IHN DIESE ANSTRENGUNG GETÖTET ODER ABER DER MOND, ALS ER KURZE ZEIT SPÄTER AUF TWINLAKE STÜRZTE. ABER OFFENBAR KANN AUCH DER TOD SEINEM WIRKEN KEIN ENDE SETZEN.^ ICH GLAUBE, DASS DIES KEIN TRAUM IM ÜBLICHEN SINN WAR, UND ICH GLAUBE AUCH, DASS ETWAS FÜRCHTERLICHES IM GANGE IST. DAHER BITTE ICH DICH, DIESE QUESTE ZU ÜBERNEHMEN UND SHANDRA AUFZUSUCHEN. GEH NACH NEWLAKE UND VERSUCH DORT, MIT IHM KONTAKT AUFZUNEHMEN.^ DOCH DU SOLLTEST NICHT UNVORBEREITET GEHEN! MERK DIR DAS WORT >WEIN<, UND GEH HINUNTER IN DEN KELLER. DAS WORT BRAUCHST DU, UM AN DEM ALTEN STEINKOPF VORBEI IN DEN WEINKELLER ZU KOMMEN. IM WEINKELLER BEFINDET SICH EIN SCHALTER, DER EINEN ZUGANG ZU DER HÖHLE IN DEN NORDBERGEN ÖFFNET. IN DEN TIEFEN DIESER HÖHLE HABE ICH MEINE ALTE AUSRÜSTUNG VERSTECKT. ALLES, WAS DU DORT FINDEST, KANNST DU FÜR DEINE QUESTE BENUTZEN, NUR EIN KLEINES STÜCK BERNSTEIN, DAS SHANDRA MIR MIT DEN WORTEN >DER EWIGEN VERBINDUNG< GAB, DAS BRINGST DU ZU MIR!^ NUN GEH, UND SPUTE DICH, DENN ICH SEHE BALA'S REICH SCHON DEUTLICH VOR MIR UND KANN NICHT MEHR ALLZU LANGE WARTEN!^ ACH JA, NIMM DIR EIN MESSER AUS DER KÜCHE MIT, WER WEISS, WAS SICH MITTLERWEILE IN DER HÖHLE EINGENISTET HAT!\""
#: AllTexts/NPC_texts.amb/001/002.txt
msgctxt "AllTexts/NPC_texts.amb/001/002"
msgid "\"I WOULD LIKE TO TELL YOU A STORY AND ASSIGN YOU A QUEST.\"^ AS YOU STEP CLOSER TO THE BED TO LISTEN CAREFULLY TO YOUR GRANDFATHER YOU SEE HOW HIS FACE DISTORTS IN PAIN AND ABOVE HIS HEAD YOU FEEL YOU SEE THE SHADOW OF BALA.^ \"WHEN I WAS JUST YOUR AGE, I HAD A DIFFICULT LIFE. YOUR GREAT-GRANDPARENTS HAD JUST BEEN KILLED BY MARAUDING ORCS. A FEW DAYS AFTER THE FUNERAL I DECIDED TO GO ON AN ADVENTURE. I WAS GIVEN MY FIRST TASK BY THE LORD CHANCELLOR OF TWINLAKE WHO HAD A SMALL PROBLEM WITH HIS DRAINS. WHEN THE TASK WAS COMPLETED SUCCESSFULLY KARWAIN, THE LORD CHANCELLOR, TOLD ME THAT SHANDRA, THE GREY MAGICIAN, HAD SOMETHING HE NEEDED TO DO AND WAS LOOKING FOR A GROUP OF BRAVE PEOPLE.^ THAT VERY EVENING I WENT TO SHANDRA. WHAT THEN HAPPENED IS SOMETHING YOU HAVE CERTAINLY ALREADY HEARD IN THE STORIES AND SONGS OF THE BARDS. BUT THAT I WAS THE GREAT HERO IS SOMETHING I NEVER TOLD YOU BECAUSE I FEEL ONE SHOULD NOT BRAG ABOUT ONE'S DEEDS.^ THE REASON I AM TELLING YOU THIS NOW IS BECAUSE SHANDRA APPEARED TO ME LAST NIGHT IN MY FEVER. THAT MISTY BEING TOLD ME THAT A DARK POWER IS AGAIN SPREADING OVER THE LAND AND INTENDS TO DESTROY LYRAMION.\"^ HE COLLAPSES IN A FIT OF COUGHING. THEN HE CONTINUES:^ \"OH, AS IF THE CATASTROPHE WITH THE THIRD MOON HAD NOT BROUGHT ENOUGH SUFFERING AND PAIN TO LYRAMION! YOUR BELOVED PARENTS DIED IN THAT DREADFUL DISASTER. I ALONE WAS ABLE TO ESCAPE FROM THE SEA OF FIRE. MY BELOVED TWINLAKE WAS DESTROYED BY FIRE AND FLOOD.^ BUT I MUST TRY TO KEEP TO THE POINT BECAUSE I FEEL I HAVE NOT MUCH TIME LEFT. SO I WILL HURRY TO TELL YOU THE REST.^ SO, SHANDRA SAID THAT THE GOOD SIDE OF OUR FAMILY IS OUR STRENGTH AND HE CHOSE YOU TO SAVE LYRAMION AGAIN. YOU SHOULD GET STARTED AND GO TO NEWLAKE TO TALK TO HIM.^ THE STRANGE THING IS JUST THAT SHANDRA DIED MORE THAN 40 YEARS AGO! WHEN I WAS FLEEING FROM TWINLAKE I SAW HOW HE TELEPORTED A LARGE NUMBER OF PEOPLE TO SAFETY. THEN HE COLLAPSED, TOTALLY EXHAUSTED.^ EITHER HE WAS KILLED BY THE ENORMOUS EFFORT HE MADE OR BY THE MOON WHEN IT HURTLED DOWN ONTO TWINLAKE A SHORT TIME LATER. BUT APPARENTLY EVEN DEATH DOES NOT STOP HIS INFLUENCE.^ I BELIEVE THAT THIS IS NO NORMAL DREAM AND I ALSO BELIEVE THAT SOMETHING TERRIBLE IS HAPPENING. FOR THIS REASON I WOULD ASK YOU TO TAKE ON THIS QUEST AND FIND SHANDRA. GO TO NEWLAKE AND TRY TO CONTACT HIM THERE.^ YOU SHOULD MAKE PREPARATIONS BEFORE YOU LEAVE! NOTE THE WORD >WINE< AND GO DOWN INTO THE CELLAR. YOU NEED THE WORD TO GET PAST THE OLD STONE HEAD IN ORDER TO ENTER THE WINE CELLAR. IN THE WINE CELLAR IS A SWITCH WHICH OPENS THE PASSAGEWAY TO THE CAVE IN THE NORTHERN MOUNTAINS. I LEFT MY OLD ARMOUR IN THE DEPTHS OF THIS CAVE. YOU CAN USE EVERYTHING YOU FIND THERE FOR YOUR QUEST. BUT YOU SHOULD BRING ME THE SMALL PIECE OF AMBER WHICH SHANDRA GAVE ME WITH THE WORDS >THE ETERNAL CONNECTION<!^ NOW GO AND HURRY FOR I SEE BALA'S REALMS CLEARLY BEFORE ME AND CANNOT WAIT TOO LONG!^ OH YES, TAKE A KNIFE FROM THE KITCHEN WITH YOU. WHO KNOWS WHAT WILL HAVE MADE A NEST IN THE CAVE BY NOW!\""
msgstr ""

#. Dialogue of NPC 001 (GRANDFATHER).
#. German: "\"ICH BIN ZU SCHWACH, UM MICH WEITER MIT DIR ZU UNTERHALTEN. BITTE, MACH DICH JETZT AUF DEN WEG! HOL MEINE ALTE AUSRÜSTUNG, UND BRING MIR DAS STÜCK BERNSTEIN!\""
#: AllTexts/NPC_texts.amb/001/003.txt
msgctxt "AllTexts/NPC_texts.amb/001/003"
msgid "\"I AM TOO WEAK TO TALK TO YOU ANY LONGER. PLEASE GO NOW! BRING MY OLD ARMOUR AND BRING ME THE PIECE OF AMBER!\""
msgstr ""

#. Dialogue of NPC 001 (GRANDFATHER).
#. German: "ALS DU DEINEM GROßVATER VON DEM EINSTURZ ERZÄHLST, WIRD SEIN TRÜBER BLICK ETWAS KLARER, UND MIT AUFGEREGTER STIMME SAGT ER:^ \"ES HILFT ALLES NICHTS, DU BRAUCHST DIE AUSRÜSTUNG, WENN DU IN DEINER QUESTE ERFOLGREICH SEIN WILLST. AM BESTEN IST ES, WENN DU DIR WERKZEUG BESORGST. GEH NACH SPANNENBERG ZUM STALL VON TOLIMAR, DEM PFERDEHÄNDLER. ER MÜSSTE DAS RICHTIGE WERKZEUG HABEN, UM DIE TRUHE FREIZULEGEN.\""
#: AllTexts/NPC_texts.amb/001/004.txt
msgctxt "AllTexts/NPC_texts.amb/001/004"
msgid "AS YOU TELL YOUR GRANDFATHER ABOUT THE CAVE-IN, HIS EYES BRIGHTEN SOMEWHAT AND IN AN EXCITED VOICE HE SAYS:^ \"IT'S NO USE, YOU NEED THE ARMOUR IF YOU ARE TO BE SUCCESSFUL IN YOUR QUEST. IT WOULD BE BETTER IF YOU GET SOME TOOLS, TOO. GO TO SPANNENBERG, TO THE STABLES OF TOLIMAR, THE HORSE DEALER. HE SHOULD HAVE THE RIGHT TOOLS FOR YOU TO CLEAR THE CHEST.\""
msgstr ""

#. Dialogue of NPC 001 (GRANDFATHER).
#. German: "DER TRÜBE BLICK DEINES GROßVATERS STREIFT DEN SCHIMMERNDEN BERNSTEIN IN DEINER HAND. MIT LEISER STIMME SAGT ER:^"
#: AllTexts/NPC_texts.amb/001/005.txt
msgctxt "AllTexts/NPC_texts.amb/001/005"
msgid "THE PAIN-RIDDEN EYES OF YOUR GRANDFATHER GLANCE OVER THE SHIMMERING AMBER STONE IN YOUR HAND. IN A QUIET VOICE HE SAYS:^ \"I WAS GIVEN THIS A LONG, LONG TIME AGO BY SHANDRA. I NEVER FOUND WHAT ITS PURPOSE IS BUT MANY OF MY FRIENDS FEEL IT HAS A MAGIC AURA. I ALWAYS THOUGHT ABOUT SHANDRA'S WORDS: >THE ETERNAL CONNECTION<.^ PERHAPS YOU MUST USE THE STONE SOMEWHERE IN ORDER TO MAKE CONTACT WITH SHANDRA.\""
msgstr ""

#. Dialogue of NPC 001 (GRANDFATHER).
#. German: "MIT HEISERER STIMME SAGT DEIN GROßVATER: \"NEIN, NEIN, BEHALTE DEN BERNSTEIN!\"^"
#: AllTexts/NPC_texts.amb/001/006.txt
msgctxt "AllTexts/NPC_texts.amb/001/006"
msgid "WITH A HOARSE VOICE YOUR GRANDFATHER SAYS: \"NO, NO, KEEP IT!\"^"
msgstr ""

#. Dialogue of NPC 001 (GRANDFATHER).
#. German: "\"DIESES STÜCK HABE ICH VOR SEHR, SEHR LANGER ZEIT VON SHANDRA BEKOMMEN. ICH HABE NIE HERAUSGEFUNDEN, WELCHEM ZWECK ES DIENT, ABER VIELE MEINER FREUNDE MEINTEN, DASS ES EINE MAGISCHE AURA HÄTTE. AUCH HABE ICH IMMER WIEDER ÜBER SHANDRA'S WORTE NACHGEDACHT: >DER EWIGEN VERBINDUNG<.^ VIELLEICHT MUSST DU DEN STEIN IRGENDWO VERWENDEN, UM MIT SHANDRA IN KONTAKT ZU TRETEN.\""
#: AllTexts/NPC_texts.amb/001/007.txt
msgctxt "AllTexts/NPC_texts.amb/001/007"
msgid "\"I WAS GIVEN THIS A LONG, LONG TIME AGO BY SHANDRA. I NEVER FOUND WHAT ITS PURPOSE IS BUT MANY OF MY FRIENDS FEEL IT HAS A MAGIC AURA. I ALWAYS THOUGHT ABOUT SHANDRA'S WORDS: >THE ETERNAL CONNECTION<.^ PERHAPS YOU MUST USE THE STONE SOMEWHERE IN ORDER TO MAKE CONTACT WITH SHANDRA.\""
msgstr ""

#. Dialogue of NPC 001 (GRANDFATHER).
#. Placeholders: ~SELF~ = the hero (the player character). The gender of these persons is unknown.
#. German: "\"~SELF~, BITTE BEEIL DICH, DENN MEINE ZEIT AUF LYRAMION NEIGT SICH DEM ENDE ZU! ICH WERDE DIR NICHT MEHR HELFEN KÖNNEN, WENN ICH IN BALA'S REICH EINTRETE. SEI BITTE HIER, WENN ES SOWEIT IST!\""
#: AllTexts/NPC_texts.amb/001/008.txt
msgctxt "AllTexts/NPC_texts.amb/001/008"
msgid "\"~SELF~, PLEASE HURRY, FOR MY TIME ON LYRAMION IS COMING TO AN END! I WILL NOT BE ABLE TO HELP YOU ANY LONGER WHEN I ENTER THE REALMS OF BALA. PLEASE BE HERE WHEN THE TIME COMES!\""
msgstr ""

#. Dialogue of NPC 002 (FATHER ANTHONY).
#. German: "DU SIEHST EINEN ALTEN MANN, DER EINE LANGE WEIßE ROBE TRÄGT UND DICH MIT EINEM VORWURFSVOLLEN BLICK ANSIEHT."
#: AllTexts/NPC_texts.amb/002/000.txt
msgctxt "AllTexts/NPC_texts.amb/002/000"
msgid "YOU SEE AN OLD MAN WEARING A LONG WHITE ROBE. HE LOOKS AT YOU RESENTFULLY."
msgstr ""

#. Dialogue of NPC 002 (FATHER ANTHONY).
#. Placeholders: ~SELF~ = the hero (the player character). The gender of these persons is unknown.
#. German: "\"MEINE GÜTE, ~SELF~, WO BIST DU GEWESEN? GERADE IN DER STUNDE, IN DER DEIN GROßVATER DICH SO SEHR GEBRAUCHT HÄTTE, WARST DU NICHT HIER. ICH HABE DICH ÜBERALL GESUCHT UND MIR DIE LUNGE AUS DEM HALS GESCHRIEN.^ NUN IST DEIN GROßVATER OHNE DEINEN BEISTAND IN BALA'S REICH EINGEGANGEN. ICH HOFFE, DASS DU WENIGSTENS SEIN GRAB AUF DEM FRIEDHOF IN SPANNENBERG BESUCHST.^ ACH JA, BEVOR ICH ES VERGESSE, DEIN GROßVATER GAB MIR NOCH EINEN SCHLÜSSEL FÜR DICH. ER SAGTE, ER PASSE ZU DER KOMMODE HIER IN SEINEM SCHLAFGEMACH. ICH HABE IHN AUF DEN TISCH IN DEINEM ZIMMER GELEGT.^ ICH GEHE JETZT WIEDER NACH SPANNENBERG. FALLS DU MICH SUCHST, ICH BIN IM TEMPEL IM HAUS DER HEILER.\"^ MIT DIESEN WORTEN DREHT ER SICH UM UND VERLÄSST DAS HAUS."
#: AllTexts/NPC_texts.amb/002/001.txt
msgctxt "AllTexts/NPC_texts.amb/002/001"
msgid "\"MY WORD, ~SELF~, WHERE HAVE YOU BEEN? JUST WHEN YOUR GRANDFATHER NEEDED YOU SO MUCH, YOU WERE NOT THERE. I LOOKED EVERYWHERE AND CALLED YOUR NAME AS LOUD AS I COULD.^ NOW YOUR GRANDFATHER HAS GONE INTO BALA'S REALMS ALONE. I HOPE THAT YOU WILL AT LEAST VISIT HIS GRAVE AT THE CHURCH IN SPANNENBERG.^ OH YES, BEFORE I FORGET, YOUR GRANDFATHER GAVE ME A KEY FOR YOU. HE SAID IT FITS THE CUPBOARD IN HIS BEDROOM. I HAVE PUT IT ON THE TABLE IN YOUR ROOM.^ I AM NOW GOING BACK TO SPANNENBERG. IF YOU NEED ME, I WILL BE IN THE TEMPLE AT THE HOUSE OF HEALERS.\"^ WITH THESE WORDS, HE TURNS AND LEAVES THE HOUSE."
msgstr ""

#. Dialogue of NPC 002 (FATHER ANTHONY).
#. German: "\"AH, DA KOMMT JA UNSER REUMÜTIGER JUNGER MENSCH!^ ICH HOFFE, DU WARST AM GRAB DEINES GROßVATERS UND HAST IHM DIE LETZTE EHRE ERWIESEN.\""
#: AllTexts/NPC_texts.amb/002/002.txt
msgctxt "AllTexts/NPC_texts.amb/002/002"
msgid "\"AH, HERE IS THE YOUNG PERSON!^ I HOPE YOU HAVE BEEN TO YOUR GRANDFATHER'S GRAVE AND SAID GOODBYE TO HIM.\""
msgstr ""

#. Dialogue of NPC 002 (FATHER ANTHONY).
#. German: "\"FALLS DU AUF DEN FRIEDHOF GEHST, DANN NIMM DICH IN ACHT! ZUR ZEIT HÄLT ES DIE TOTEN NICHT IN IHREN GRÄBERN.\""
#: AllTexts/NPC_texts.amb/002/003.txt
msgctxt "AllTexts/NPC_texts.amb/002/003"
msgid "\"WHEN YOU GO TO THE GRAVEYARD, YOU MUST TAKE CARE. AT THE MOMENT THE DEAD ARE NOT STAYING IN THEIR GRAVES.\""
msgstr ""

#. Dialogue of NPC 002 (FATHER ANTHONY).
#. German: "\"SO SO, DU BRAUCHST EIN GEGENMITTEL GEGEN DAS SUMPFFIEBER. NICHTS EINFACHER ALS DAS, DU MUSST ALLERDINGS VORHER DREI DINGE BESCHAFFEN.^ GEH ZUERST ZUM TURM DES ALCHEMISTEN UND BESORGE DIR EINE LEERE PHIOLE. DU MUSST DAZU NACH NORDWESTEN DURCH DIE WÜSTE UND DANN DEM FLUß NACH WESTEN FOLGEN. NACH KURZER ZEIT WIRST AN DEN TURM GELANGEN. FALLS DICH IM TURM JEMAND FRAGT, WER DICH SCHICKT, DANN NENNE EINFACH MEINEN NAMEN.^ DANACH GEHST DU ZUM SUMPF ÖSTLICH VOM TURM DES ALCHEMISTEN. DORT MUSST DU EINE SUMPFLILIE PFLÜCKEN.^ UND SCHLIEßLICH SUCHST DU DIE QUELLE DES LEBENS AUF. SIE BEFINDET SICH AUF EINEM HOCHPLATEAU AUF DER ÖSTLICHEN BERGKETTE. WANDERE EINFACH IN NÖRDLICHER RICHTUNG AN DER BERKETTE VORBEI, BIS DU EINEN DURCHGANG NACH OSTEN FINDEST. DURCH DIESEN GELANGST DU AN EIN UFER, UND HIER FINDEST DU EINE TÜR. DEN SCHLÜSSEL ZU DIESER TÜR GEBE ICH DIR HIERMIT. DOCH SEI GEWARNT, DIE WÄCHTER DER HÖHLE DES LEBENS LASSEN NUR DEN WÜRDIGEN NACH HARTEN PRÜFUNGEN ZUR QUELLE. AN DER QUELLE FÜLLST DU DANN DIE PHIOLE.^ DANACH KOMMST DU ZU MIR ZURÜCK. ICH WERDE DIR DANN EIN MITTEL GEGEN DAS SUMPFFIEBER BRAUEN KÖNNEN.\""
#: AllTexts/NPC_texts.amb/002/004.txt
msgctxt "AllTexts/NPC_texts.amb/002/004"
msgid "\"SO, YOU NEED SOMETHING TO FIGHT THE SWAMP FEVER. VERY SIMPLE, BUT YOU MUST FIRST DO THREE THINGS.^ FIRST YOU MUST GO TO THE TOWER OF THE ALCHEMIST AND OBTAIN AN EMPTY PHIAL. TO DO THIS, YOU MUST GO TO THE NORTH WEST THROUGH THE DESERT AND THEN FOLLOW THE RIVER TO THE WEST. YOU WILL REACH THE TOWER A SHORT TIME LATER. IF ANYONE AT THE TOWER ASKS WHO HAS SENT YOU, SIMPLY GIVE THEM MY NAME.^ THEN GO TO THE SWAMP TO THE EAST OF THE TOWER OF THE ALCHEMIST. YOU MUST PLUCK A SWAMP LILY.^ AND FINALLY YOU MUST FIND THE SPRING OF LIFE. THIS IS LOCATED ON A HIGH PLATEAU IN THE CHAIN OF MOUNTAINS TO THE EAST. SIMPLY GO IN A NORTHERLY DIRECTION PAST THE CHAIN OF MOUNTAINS UNTIL YOU FIND A PASS LEADING TO THE EAST. GO THROUGH IT AND YOU WILL REACH THE BANK OF A RIVER. THERE YOU WILL FIND A DOOR WHOSE KEY IS THIS. BUT BE WARNED, THE GUARDS IN THE CAVE OF LIFE WILL ONLY ALLOW YOU TO REACH THE SPRING OF LIFE IF YOU ARE WORTHY AND CAN WITHSTAND THEIR SEVERE TESTS. AT THE SPRING YOU WILL THEN FILL THE PHIAL.^ BRING IT TO ME. I WILL THEN BE ABLE TO BREW AN ANTIDOTE TO THE SWAMP FEVER FOR YOU.\""
msgstr ""

#. Dialogue of NPC 002 (FATHER ANTHONY).
#. German: "\"WORAUF WARTEST DU NOCH? GEH UND BESORGE DIE SUMPFLILIE UND DAS WASSER DES LEBENS!\""
#: AllTexts/NPC_texts.amb/002/005.txt
msgctxt "AllTexts/NPC_texts.amb/002/005"
msgid "\"WHAT ARE YOU WAITING FOR? GO AND GET THE SWAMP LILY AND THE WATER OF LIFE!\""
msgstr ""

#. Dialogue of NPC 002 (FATHER ANTHONY).
#. German: "\"JA, GENAU DIESE LILIE BRAUCHE ICH FÜR DAS GEGENMITTEL! ICH HOFFE, DU HAST AUCH DAS WASSER DES LEBENS BESORGT. WENN JA, DANN GIB ES MIR.\""
#: AllTexts/NPC_texts.amb/002/006.txt
msgctxt "AllTexts/NPC_texts.amb/002/006"
msgid "\"YES, PRECISELY THAT LILY IS WHAT I NEED FOR THE ANTIDOTE! I HOPE THAT YOU ALSO GOT THE WATER OF LIFE. IF SO, GIVE IT TO ME.\""
msgstr ""

#. Dialogue of NPC 002 (FATHER ANTHONY).
#. German: "\"JA, DAS SCHEINT WASSER AUS DER QUELLE DES LEBENS ZU SEIN. ICH HOFFE, DU HAST AUCH DIE SUMPFLILIE GEPFLÜCKT. WENN JA, DANN GIB SIE MIR.\""
#: AllTexts/NPC_texts.amb/002/007.txt
msgctxt "AllTexts/NPC_texts.amb/002/007"
msgid "\"YES, THIS SEEMS TO BE WATER FROM THE SPRING OF LIFE. I HOPE YOU ALSO PLUCKED THE SWAMP LILY. IF SO, GIVE IT TO ME.\""
msgstr ""

#. Dialogue of NPC 002 (FATHER ANTHONY).
#. German: "VATER ANTONIUS NIMMT EUCH DIE BLUME UND DAS WASSER DES LEBENS AB UND MISCHT BEIDES UNTER GEBETEN ZUSAMMEN. DANACH GIBT ER EUCH EIN FLÄSCHCHEN UND SAGT:^ \"SO, MIT DIESEM TRANK KÖNNT IHR EINE PERSON VOM SUMPFFIEBER HEILEN.\""
#: AllTexts/NPC_texts.amb/002/008.txt
msgctxt "AllTexts/NPC_texts.amb/002/008"
msgid "FATHER ANTHONY TAKES THE FLOWER AND THE WATER OF LIFE FROM YOU AND MIXES THEM TOGETHER WHILST UTTERING A PRAYER. THEN HE GIVES YOU A FLASK AND SAYS:^ \"SO, WITH THIS DRINK YOU CAN HEAL SOMEONE FROM THE SWAMP FEVER.\""
msgstr ""

#. Dialogue of NPC 002 (FATHER ANTHONY).
#. German: "\"MIT DEM WASSER DES LEBENS ALLEIN KANN ICH KEIN GEGENMITTEL HERSTELLEN!\""
#: AllTexts/NPC_texts.amb/002/009.txt
msgctxt "AllTexts/NPC_texts.amb/002/009"
msgid "\"WITH THE WATER OF LIFE ALONE I CANNOT PRODUCE AN ANTIDOTE!\""
msgstr ""

#. Dialogue of NPC 002 (FATHER ANTHONY).
#. German: "\"ICH BRAUCHE AUCH DAS WASSER AUS DER QUELLE DES LEBENS. OHNE DAS WASSER KANN ICH DAS GEGENMITTEL NICHT HERSTELLEN.\""
#: AllTexts/NPC_texts.amb/002/010.txt
msgctxt "AllTexts/NPC_texts.amb/002/010"
msgid "\"I ALSO NEED THE WATER FROM THE SPRING OF LIFE. WITHOUT THE WATER I CANNOT CREATE THE POTION.\""
msgstr ""

#. Dialogue of NPC 003 (AMAN).
#. German: "DU SIEHST EINEN MANN IN MITTLEREN JAHREN. ER TRÄGT EINEN KURZEN DUNKLEN BART UND SIEHT DICH FRAGEND AN."
#: AllTexts/NPC_texts.amb/003/000.txt
msgctxt "AllTexts/NPC_texts.amb/003/000"
msgid "YOU SEE A MAN OF MIDDLE AGE. HE HAS A SHORT DARK BEARD AND LOOKS AT YOU QUESTIONINGLY."
msgstr ""

#. Dialogue of NPC 003 (AMAN).
#. German: "\"HALLO FREMDE, IHR BESUCHT SPANNENBERG IN EINER SCHLECHTEN ZEIT! WIR HABEN MOMENTAN GROßE PROBLEME IN DER DIEBESGILDE.\""
#: AllTexts/NPC_texts.amb/003/001.txt
msgctxt "AllTexts/NPC_texts.amb/003/001"
msgid "\"HELLO, STRANGER, YOU ARE VISITING SPANNENBERG AT SUCH A BAD TIME! AT THE MOMENT WE HAVE BIG PROBLEMS IN THE GUILD OF THIEVES.\""
msgstr ""

#. Dialogue of NPC 003 (AMAN).
#. German: "\"MÖGE BALA EUCH BESCHÜTZEN UND DARAUF ACHTEN, DASS IHR NICHT IN EINEN HINTERHALT VON BANDITEN GERATET.\""
#: AllTexts/NPC_texts.amb/003/002.txt
msgctxt "AllTexts/NPC_texts.amb/003/002"
msgid "\"MAY BALA PROTECT YOU AND ENSURE THAT YOU ARE NOT OVERPOWERED BY BANDITS.\""
msgstr ""

#. Dialogue of NPC 003 (AMAN).
#. German: "\"MMH, ICH HOFFE, ICH KANN EUCH VERTRAUEN UND IHR GEHÖRT NICHT ZU DIESEN FREMDEN BANDITEN, DIE SICH SEIT KURZEM HIER HERUMTREIBEN.^ DIE GILDE UND DIE TRAINER BEFINDEN SICH IM KELLER DIESER GASTSTÄTTE. ALLERDINGS BENÖTIGT IHR EIN LOSUNGSSWORT, UM AN DEM STEINKOPF VORBEIZUKOMMEN. WENN IHR MIR EINEN BESTIMMTEN GEGENSTAND BRINGT, DANN WILL ICH EUCH DAS WORT SAGEN.\""
#: AllTexts/NPC_texts.amb/003/003.txt
msgctxt "AllTexts/NPC_texts.amb/003/003"
msgid "\"MMH, I HOPE I CAN TRUST YOU AND THAT YOU ARE NOT ONE OF THOSE STRANGE BANDITS WHO HAVE BEEN RUNNING AROUND HERE FOR SOME TIME.^ THE GUILD AND THE TRAINERS ARE IN THE CELLAR BELOW THIS BAR. BUT YOU NEED A PASSWORD TO GET PAST THE STONEHEAD. IF YOU BRING ME A CERTAIN THING I WILL TELL YOU THE WORD.\""
msgstr ""

#. Dialogue of NPC 003 (AMAN).
#. German: "\"JA, SEIT EIN PAAR WOCHEN PLÜNDERN FREMDE BANDITEN DIE STADT REGELRECHT AUS. VOR ALLEN DINGEN WIRFT IHR TREIBEN EIN SCHLECHTES LICHT AUF DIE DIEBESGILDE.^ MAN KANN DEN BEWOHNERN VON SPANNENBERG EINFACH NICHT KLARMACHEN, DASS WIR NICHTS DAMIT ZU TUN HABEN. DABEI HATTEN WIR FRÜHER EIN RICHTIG GUTES VERHÄLTNIS. JEDER HATTE SEIN EINKOMMEN, UND ES HAT DIE LEUTE NICHT GESTÖRT, WENN WIR UNSERER ARBEIT NACHGINGEN.\""
#: AllTexts/NPC_texts.amb/003/004.txt
msgctxt "AllTexts/NPC_texts.amb/003/004"
msgid "\"YES, FOR THE LAST FEW WEEKS SOME STRANGE BANDITS HAVE BEEN PLUNDERING THE TOWN. AND MORE THAN THAT, THEIR ACTIONS ARE CASTING THE GUILD OF THIEVES INTO A BAD LIGHT.^ WE SIMPLY CANNOT MAKE IT CLEAR TO THE CITIZENS OF SPANNENBERG THAT WE HAVE NOTHING TO DO WITH THE BANDITS. WE USED TO HAVE A REALLY GOOD RELATIONSHIP WITH THEM. EVERYONE HAS THEIR JOB AND IT DID NOT BOTHER THE PEOPLE THAT WE HAD OURS.\""
msgstr ""

#. Dialogue of NPC 003 (AMAN).
#. German: "\"UNSER FRIEDHOFSGÄRTNER BESITZT EINE BROSCHE, AN DER MIR VIEL LIEGT. ABER LEIDER KOMME ICH NICHT AN SIE HERAN, UND SCHON GAR NICHT, SEITDEM IHN STÄNDIG SKELETTE UND ZOMBIES UMGEBEN. WENN IHR MIR DIE BROSCHE BRINGT, WERDE ICH EUCH DAS LOSUNGSSWORT VERRATEN.\""
#: AllTexts/NPC_texts.amb/003/005.txt
msgctxt "AllTexts/NPC_texts.amb/003/005"
msgid "\"OUR GARDENER AT THE GRAVEYARD HAS A BROOCH WHICH MEANS A LOT TO ME. BUT UNFORTUNATELY I CANNOT GET AT IT, AND CERTAINLY NOT SINCE HE IS CONSTANTLY SURROUNDED BY SKELETONS AND ZOMBIES. IF YOU BRING ME THE BROOCH I WILL GIVE YOU THE PASSWORD.\""
msgstr ""

#. Dialogue of NPC 003 (AMAN).
#. German: "\"AH JA, GENAU DIESE BROSCHE WOLLTE ICH HABEN! GEBT SIE MIR, DANN VERRATE ICH EUCH DAS GEHEIME WORT!\""
#: AllTexts/NPC_texts.amb/003/006.txt
msgctxt "AllTexts/NPC_texts.amb/003/006"
msgid "\"OH YES, THAT IS EXACTLY THE BROOCH I WANTED! GIVE IT TO ME AND I WILL TELL YOU THE SECRET WORD!\""
msgstr ""

#. Dialogue of NPC 003 (AMAN).
#. German: "\"VIELEN DANK! DAS WORT LAUTET >SILK<. SO HIEß NÄMLICH DER GRÜNDER DER GILDE HIER IN SPANNENBERG.\""
#: AllTexts/NPC_texts.amb/003/007.txt
msgctxt "AllTexts/NPC_texts.amb/003/007"
msgid "\"MANY THANKS! THE WORD IS >SILK<. YOU SEE, THAT WAS THE NAME OF THE FOUNDER OF THE GUILD HERE IN SPANNENBERG.\""
msgstr ""

#. Dialogue of NPC 004 (OTRAM).
#. German: "DU SIEHST EINEN JUNGEN MANN MIT LANGEN BLONDEN HAAREN. ALS ER EUCH BEMERKT, LÄCHELT ER UND SIEHT EUCH FRAGEND AN."
#: AllTexts/NPC_texts.amb/004/000.txt
msgctxt "AllTexts/NPC_texts.amb/004/000"
msgid "YOU SEE A YOUNG MAN WITH LONG BLOND HAIR. WHEN HE NOTICES YOU HE SMILES AND LOOKS AT YOU QUESTIONINGLY."
msgstr ""

#. Dialogue of NPC 004 (OTRAM).
#. German: "\"ICH GRÜßE EUCH FREMDE UND HEIßE EUCH WILLKOMMEN IM STADTPARK VON SPANNENBERG! SETZT EUCH ZU MIR UND ENTSPANNT EUCH! ICH SAMMLE HIER KRAFT FÜR EINE LANGE, ANSTRENGENDE REISE.\""
#: AllTexts/NPC_texts.amb/004/001.txt
msgctxt "AllTexts/NPC_texts.amb/004/001"
msgid "\"WELCOME, STRANGERS, WELCOME TO THE TOWN PARK OF SPANNENBERG! PLEASE COME, SIT DOWN AND RELAX! I AM RESTING HERE BEFORE I START MY LONG AND STRENUOUS JOURNEY.\""
msgstr ""

#. Dialogue of NPC 004 (OTRAM).
#. German: "\"ICH WÜNSCHE EUCH VIEL GLÜCK! UND NEHMT EUCH VOR DEN BANDITEN IN ACHT AUF EURER REISE!\""
#: AllTexts/NPC_texts.amb/004/002.txt
msgctxt "AllTexts/NPC_texts.amb/004/002"
msgid "\"GOOD LUCK! AND WATCH OUT FOR THE BANDITS ON YOUR JOURNEY!\""
msgstr ""

#. Dialogue of NPC 004 (OTRAM).
#. German: "\"IST ER NICHT SCHÖN, UNSER STADTPARK? ZUR ZEIT IST ER DER EINZIGE ORT IN SPANNENBERG, AN DEM MAN NICHT VON BANDITEN UND RÄUBERN ÜBERFALLEN WIRD. DER FREIHERR GEORG SOLLTE WIRKLICH MAL ETWAS GEGEN DIESES GESINDEL UNTERNEHMEN!\""
#: AllTexts/NPC_texts.amb/004/003.txt
msgctxt "AllTexts/NPC_texts.amb/004/003"
msgid "\"IS IT NOT BEAUTIFUL, OUR TOWN PARK? AT THE MOMENT IT IS THE ONLY PLACE IN SPANNENBERG WHERE WE ARE NOT BEING ATTACKED BY BANDITS AND ROBBERS. BARON GEORGE SHOULD REALLY DO SOMETHING ABOUT THAT SCUM!\""
msgstr ""

#. Dialogue of NPC 004 (OTRAM).
#. German: "\"IHR FRAGT NACH MEINER REISE...^ NUN, ICH HABE VOR, MICH IN EINIGEN WOCHEN AUF DEN LANGEN WEG NACH NEWLAKE ZU MACHEN. ICH WILL DORT DER BRUDERSCHAFT TARBOS BEITRETEN.\""
#: AllTexts/NPC_texts.amb/004/004.txt
msgctxt "AllTexts/NPC_texts.amb/004/004"
msgid "\"YOU ASK ABOUT MY JOURNEY...^ WELL, IN A FEW WEEKS I INTEND TO START THE LONG JOURNEY TO NEWLAKE. I WANT TO JOIN THE BROTHERHOOD OF TARBOS THERE.\""
msgstr ""

#. Dialogue of NPC 004 (OTRAM).
#. German: "\"WAS, IHR KENNT NEWLAKE NICHT? ICH MUSS GESTEHEN, AUCH ICH WAR ERST EINMAL ALS KLEINER JUNGE MIT MEINEM VATER DORT. NACH DER GROßEN VERNICHTUNG GRÜNDETEN DIE ÜBERLEBENDEN VON TWINLAKE EINE NEUE STADT IM WALD NORDWESTLICH VON DEN RUINEN. SIE NANNTEN SIE NEWLAKE. HEUTE IST ES MIT ILLIEN, DER STADT DER ELFEN, EINE DER GRÖßTEN STÄDTE AUF DEN LYRAMIONISCHEN INSELN.\""
#: AllTexts/NPC_texts.amb/004/005.txt
msgctxt "AllTexts/NPC_texts.amb/004/005"
msgid "\"WHAT, YOU DO NOT KNOW NEWLAKE? I MUST ADMIT I WAS ONLY THERE ONCE WITH MY FATHER WHEN I WAS A LITTLE BOY. AFTER THE HUGE DISASTER THE SURVIVORS OF TWINLAKE ESTABLISHED A NEW TOWN IN THE FOREST TO THE NORTH WEST OF THE RUINS. THEY CALLED IT NEWLAKE. WITH ILLIEN, THE TOWN OF THE ELVES, IT IS TODAY ONE OF THE LARGEST TOWNS ON THE LYRAMION ISLANDS.\""
msgstr ""

#. Dialogue of NPC 004 (OTRAM).
#. German: "ALS IHR IHN NACH DER BRUDERSCHAFT FRAGT, BEKOMMT DER JUNGE MANN PLÖTZLICH GROßE AUGEN UND SAGT:^ \"TJA, DIE BRUDERSCHAFT. SEITDEM ICH VON IHR WEISS, WARTE ICH DARAUF, ALT GENUG ZU WERDEN, UM IHR BEIZUTRETEN. SIE HAT SICH DER AUFGABE VERSCHRIEBEN, DEN SARG VON TARBOS TAG UND NACHT MIT BANNSPRÜCHEN ZU BELEGEN, UM SO ZU VERHINDERN, DASS ER ERNEUT SEINE DUNKLE MACHT AUF LYRAMION AUSBREITET. ZU DIESEM ZWECK HABEN DIE MITGLIEDER EINEN GROßEN TEMPEL AUF DEM ROTEN AUGE VON TARBOS GEBAUT UND VERBRINGEN DORT IHR LEBEN DAMIT, DAS BÖSE VON UNSERER WELT FERNZUHALTEN.^ DAS DER SCHRECKLICHE LORD TARBOS IN DEN LETZEN SIEBZIG JAHREN NICHT WIEDER AUFGETAUCHT IST, HABEN WIR NUR DER BRUDERSCHAFT ZU VERDANKEN. DESHALB WERDE ICH NACH NEWLAKE GEHEN UND VERSUCHEN, AUCH AUFGENOMMEN ZU WERDEN.\""
#: AllTexts/NPC_texts.amb/004/006.txt
msgctxt "AllTexts/NPC_texts.amb/004/006"
msgid "AS YOU ASK HIM ABOUT THE BROTHERHOOD, THE YOUNG MAN'S EYES SUDDENLY WIDEN AND HE SAYS:^ \"YES, THE BROTHERHOOD. EVER SINCE I HEARD OF IT, I HAVE BEEN WAITING TO REACH THE AGE WHERE I CAN BECOME A MEMBER. THE BROTHERHOOD HAS TAKEN ON THE TASK OF CASTING SPELLS ON THE COFFIN OF TARBOS ALL DAY AND ALL NIGHT TO PREVENT HIM FROM SPREADING HIS EVIL DARK POWER OVER LYRAMION AGAIN. FOR THIS PURPOSE THE MEMBERS HAVE BUILT A HUGE TEMPLE ON THE RED EYE OF TARBOS AND SPEND THEIR LIFE THERE KEEPING THE EVIL AWAY FROM OUR WORLD.^ IT IS ONLY THANKS TO THE BROTHERHOOD THAT DREADFUL LORD TARBOS DID NOT REAPPEAR FOR THE LAST SEVENTY YEARS. SO I WILL GO TO NEWLAKE AND TRY TO BECOME A MEMBER.\""
msgstr ""

#. Dialogue of NPC 005 (SANDRA).
#. German: "IHR SEHT EINE ALTE FRAU, DIE EUCH FREUNDLICH ANLÄCHELT."
#: AllTexts/NPC_texts.amb/005/000.txt
msgctxt "AllTexts/NPC_texts.amb/005/000"
msgid "YOU SEE AN OLD WOMAN WHO SMILES AT YOU IN A FRIENDLY MANNER."
msgstr ""

#. Dialogue of NPC 005 (SANDRA).
#. Placeholders: ~SELF~ = the hero (the player character). The gender of these persons is unknown.
#. German: "\"WILLKOMMEN IM HAUS DER HEILER! ICH HEIßE SANDRA UND BIN DAS OBERHAUPT DER HEILER HIER IN SPANNENBERG.^ DICH, ~SELF~, HEIßE ICH BESONDERS WILLKOMMEN. ICH KANN MICH NOCH GUT AN DEINEN GROßVATER ERINNERN. ER HAT MIR VOR LANGER, LANGER ZEIT EINMAL SEHR GEHOLFEN, ALS ER MEINEN KATER VOR MONSTERN GERETTET HAT.^ SAGT, HABT IHR NICHT ZUFÄLLIG ETWAS VON MEINER TOCHTER SABINE GEHÖRT?\""
#: AllTexts/NPC_texts.amb/005/001.txt
msgctxt "AllTexts/NPC_texts.amb/005/001"
msgid "\"WELCOME TO THE HOUSE OF HEALERS! MY NAME IS SANDRA AND I AM THE HEAD OF THE HEALERS HERE IN SPANNENBERG.^ WELCOME ESPECIALLY TO YOU, ~SELF~. I REMEMBER YOUR GRANDFATHER WELL. A LONG LONG TIME AGO HE ONCE HELPED ME BY SAVING MY CAT FROM THE MONSTERS.^ TELL ME, HAVE YOU PERHAPS HEARD ANYTHING ABOUT MY DAUGHTER, SABINE?\""
msgstr ""

#. Dialogue of NPC 005 (SANDRA).
#. German: "\"ICH KANN EUCH NICHT GENUG DANKEN, DASS IHR MEINE TOCHTER AUS DEN KLAUEN VON LUMINOR BEFREIT HABT. DESHALB HABE ICH VATER ANTONIUS ANGEWIESEN, EUCH FÜR DIE HÄLFTE DER NORMALEN SÄTZE ZU VERSORGEN.\""
#: AllTexts/NPC_texts.amb/005/002.txt
msgctxt "AllTexts/NPC_texts.amb/005/002"
msgid "\"I CANNOT THANK YOU ENOUGH FOR RELEASING MY DAUGHTER FROM THE CLAWS OF LUMINOR. SO I HAVE ASKED FATHER ANTHONY TO SUPPLY YOU AT HALF THE NORMAL RATES.\""
msgstr ""

#. Dialogue of NPC 005 (SANDRA).
#. German: "\"GEHT IN FRIEDEN, MEINE KINDER, UND MÖGE GALA EUCH AUF EUREN WEGEN BESCHÜTZEN!\""
#: AllTexts/NPC_texts.amb/005/003.txt
msgctxt "AllTexts/NPC_texts.amb/005/003"
msgid "\"GO IN PEACE, MY CHILDREN, AND MAY GALA PROTECT YOU ON YOUR TRAVELS!\""
msgstr ""

#. Dialogue of NPC 005 (SANDRA).
#. German: "\"SIE IST HEILERIN WIE ICH UND LEITET DAS HAUS DER HEILER IN BURNVILLE AUF DER INSEL SÜDLICH VON UNS. LEIDER HABE ICH SEIT WOCHEN NICHTS MEHR VON IHR GEHÖRT, UND DESHALB MACHE ICH MIR JETZT GROßE SORGEN, DASS IHR ETWAS PASSIERT IST.^ ES WÄRE NETT VON EUCH, WENN IHR IN BURNVILLE NACH MEINER TOCHTER SCHAUEN KÖNNTET. ICH GEBE EUCH DIESEN SCHLÜSSEL HIER, ER PASST ZU DER TRUHE IN MEINEM ZIMMER. IN DER TRUHE WERDET IHR EIN PAAR DINGE FINDEN, DIE EUCH AUF EURER REISE NÜTZEN KÖNNEN. AUSSERDEM BEFINDET SICH DARIN EIN SCHLÜSSEL. DEN KÖNNT IHR VERWENDEN, UM DIE ABKÜRZUNG NACH BURNVILLE ZU ÖFFNEN. WENN IHR VOM STEG AUF DER NACHBARINSEL NACH SÜDEN GEHT, GELANGT IHR AN DEN TUNNEL.\""
#: AllTexts/NPC_texts.amb/005/004.txt
msgctxt "AllTexts/NPC_texts.amb/005/004"
msgid "\"SHE IS A HEALER, JUST LIKE ME, AND LEADS THE HOUSE OF HEALERS IN BURNVILLE ON THE ISLAND TO THE SOUTH OF US. UNFORTUNATELY I HAVE HEARD NOTHING MORE FROM HER FOR WEEKS AND THAT IS WHY I AM VERY WORRIED THAT SOMETHING HAS HAPPENED.^ IT WOULD BE NICE OF YOU IF YOU COULD CHECK ON MY DAUGHTER IN BURNVILLE. I WILL GIVE YOU THIS KEY. IT FITS THE CHEST IN MY ROOM. IN THE CHEST YOU WILL FIND A FEW THINGS WHICH COULD BE USEFUL TO YOU ON YOUR JOURNEY. YOU WILL ALSO FIND A KEY IN THE CHEST. YOU CAN USE IT TO OPEN THE SHORT-CUT TO BURNVILLE. IF YOU GO FROM THE QUAY SOUTHWARDS TO THE NEXT ISLAND YOU WILL REACH THE TUNNEL.\""
msgstr ""

#. Dialogue of NPC 005 (SANDRA).
#. German: "\"SABINE IST MEINE TOCHTER. SIE IST HEILERIN IN BURNVILLE.\""
#: AllTexts/NPC_texts.amb/005/005.txt
msgctxt "AllTexts/NPC_texts.amb/005/005"
msgid "\"SABINE IS MY DAUGHTER. SHE IS A HEALER IN BURNVILLE.\""
msgstr ""

#. Dialogue of NPC 005 (SANDRA).
#. German: "\"BURNVILLE IST EINE KLEINE STADT MITTEN IN DER WÜSTE AUF DER INSEL SÜDLICH VON HIER. DORT LEBEN VORWIEGEND KÜNSTLER UND HANDWERKER.\""
#: AllTexts/NPC_texts.amb/005/006.txt
msgctxt "AllTexts/NPC_texts.amb/005/006"
msgid "\"BURNVILLE IS A SMALL TOWN IN THE MIDDLE OF THE DESERT ON THE ISLAND TO THE SOUTH OF HERE. THE PEOPLE LIVING THERE ARE MAINLY ARTISTS AND TRADESMEN.\""
msgstr ""

#. Dialogue of NPC 005 (SANDRA).
#. German: "\"FALLS IHR MIR DEN NAMEN MEINES ALTEN KATERS SAGEN KÖNNT, WERDE ICH EUCH ETWAS WUNDERBARES BEIBRINGEN. NA, WISST IHR IHN?\""
#: AllTexts/NPC_texts.amb/005/007.txt
msgctxt "AllTexts/NPC_texts.amb/005/007"
msgid "\"IF YOU CAN TELL ME THE NAME OF MY OLD TOMCAT I WILL GIVE YOU SOMETHING WONDERFUL. WELL, DO YOU KNOW HIS NAME?\""
msgstr ""

#. Dialogue of NPC 005 (SANDRA).
#. German: "\"AH, IHR HABT ALSO VON DER GESCHICHTE GEHÖRT. NUN JA, JETZT IST ER SCHON SEIT LANGER ZEIT TOT, ABER IN DEN JAHREN, IN DENEN ER BEI MIR WAR, HAT ER MEINE KINDHEIT VERSÜßT.^ ICH MÖCHTE EUCH IM ANDENKEN AN FELIX EIN GESCHENK MACHEN.\"^ MIT DIESEN WORTEN BERÜHRT DIE ALTE SANDRA JEDEN VON EUCH AN DER SCHLÄFE UND SAGT DANACH:^ \"NUN KÖNNT IHR DIE SPRACHE DER TIERE VERSTEHEN. SETZT DIESE GABE NUR ZUM NUTZEN DER TIERE EIN, SONST WERDE ICH EUCH DAS FELL ÜBER DIE OHREN ZIEHEN!\""
#: AllTexts/NPC_texts.amb/005/008.txt
msgctxt "AllTexts/NPC_texts.amb/005/008"
msgid "\"AH, YOU HEARD THE STORY, DIDN'T YOU? WELL YES, HE HAS BEEN DEAD FOR A LONG TIME BUT IN THE YEARS WE WERE TOGETHER HE MADE MY CHILDHOOD VERY HAPPY.^ I WOULD LIKE TO GIVE YOU A PRESENT IN REMEMBRANCE OF FELIX.\"^ WITH THESE WORDS OLD SANDRA TOUCHES EACH OF YOU ON THE FOREHEAD AND SAYS:^ \"NOW YOU CAN UNDERSTAND THE LANGUAGE OF THE ANIMALS. USE THIS GIFT ONLY TO BENEFIT THE ANIMALS, OTHERWISE I WILL TURN YOU INSIDE OUT!\""
msgstr ""

#. Dialogue of NPC 006 (CLEMENTINE).
#. German: "IHR SEHT EINE FRAU IN MITTLEREN JAHREN. SIE HAT LANGES BRAUNES HAAR UND TRÄGT EINE LANGE WEIßE SCHÜRZE."
#: AllTexts/NPC_texts.amb/006/000.txt
msgctxt "AllTexts/NPC_texts.amb/006/000"
msgid "YOU SEE A WOMAN OF MIDDLE AGE. SHE HAS LONG BROWN HAIR AND IS WEARING A LONG WHITE APRON."
msgstr ""

#. Dialogue of NPC 006 (CLEMENTINE).
#. German: "\"HALLO, ICH GRÜßE EUCH! MEIN NAME IST CLEMENTINE. ICH BIN PFLEGERIN UND KÖCHIN HIER IM HAUS DER HEILER.^ BITTE, NEHMT EIN BISSCHEN RÜCKSICHT AUF SANDRA UND HÜTET EUCH DAVOR, IN DEN KELLER ZU GEHEN.\""
#: AllTexts/NPC_texts.amb/006/001.txt
msgctxt "AllTexts/NPC_texts.amb/006/001"
msgid "\"HELLO, WELCOME! MY NAME IS CLEMENTINE. I AM A CARER AND THE COOK HERE IN THE HOUSE OF HEALERS.^ PLEASE, SHOW A LITTLE CONSIDERATION TO SANDRA AND DO NOT GO INTO THE CELLAR.\""
msgstr ""

#. Dialogue of NPC 006 (CLEMENTINE).
#. German: "\"ICH WÜNSCHE EUCH NOCH EINEN ANGENEHMEN TAG!\""
#: AllTexts/NPC_texts.amb/006/002.txt
msgctxt "AllTexts/NPC_texts.amb/006/002"
msgid "\"HAVE A NICE DAY!\""
msgstr ""

#. Dialogue of NPC 006 (CLEMENTINE).
#. German: "\"SANDRA IST DIE LEITERIN DES HAUSES DER HEILER. SIE IST ZUR ZEIT SEHR BEDRÜCKT, DA SIE SEIT WOCHEN NICHTS MEHR VON IHRER TOCHTER SABINE GEHÖRT HAT.\""
#: AllTexts/NPC_texts.amb/006/003.txt
msgctxt "AllTexts/NPC_texts.amb/006/003"
msgid "\"SANDRA IS THE HEAD OF THE HOUSE OF HEALERS. AT THE MOMENT SHE IS VERY DEPRESSED BECAUSE SHE HAS HEARD NOTHING FROM HER DAUGHTER SABINE FOR MANY WEEKS.\""
msgstr ""

#. Dialogue of NPC 006 (CLEMENTINE).
#. German: "\"IHR SOLLTET NICHT IN DEN KELLER GEHEN, WEIL DORT DER VERRÜCKTE LEBT. DORT UNTEN HABEN WIR EINE ZELLE, IN DER WIR DIE SCHWERSTEN FÄLLE BETREUEN.\""
#: AllTexts/NPC_texts.amb/006/004.txt
msgctxt "AllTexts/NPC_texts.amb/006/004"
msgid "\"YOU SHOULD NOT GO INTO THE CELLAR BECAUSE THE MADMAN LIVES THERE. THERE IS A CELL DOWN THERE WHERE WE TREAT OUR MOST DIFFICULT CASES.\""
msgstr ""

#. Dialogue of NPC 006 (CLEMENTINE).
#. German: "\"SABINE IST DIE TOCHTER VON SANDRA. SIE LEITET DAS HAUS DER HEILER IN BURNVILLE. BURNVILLE IST EINE STADT MITTEN IN DER WÜSTE AUF DER INSEL SÜDLICH VON UNS.\""
#: AllTexts/NPC_texts.amb/006/005.txt
msgctxt "AllTexts/NPC_texts.amb/006/005"
msgid "\"SABINE IS THE DAUGHTER OF SANDRA. SHE HEADS THE HOUSE OF HEALERS AT BURNVILLE. BURNVILLE IS A TOWN IN THE MIDDLE OF THE DESERT ON THE ISLAND TO THE SOUTH OF US.\""
msgstr ""

#. Dialogue of NPC 006 (CLEMENTINE).
#. German: "\"SO, IHR WOLLT ALSO DIE GESCHICHTE DES VERRÜCKTEN HÖREN.^ WIE ICH VON MEINER VORGÄNGERIN GEHÖRT HABE, IST ER KURZ NACH DEM GROßEN UNGLÜCK AN UNSERE KÜSTE GESCHWEMMT WORDEN. DAS EINZIGE, WAS ER DAMALS BEI SICH HATTE, WAREN EINE KOSTBARE ZERRISSENE ROBE UND EIN SELTSAMES HALBES AMULETT. ICH GLAUBE DIE BEIDEN SACHEN LIEGEN JETZT IN EINER KISTE UNTEN IM KELLER.^ ER WURDE VON EINER BAUERNFAMILIE AUFGENOMMEN UND LEBTE DORT MEHRERE JAHRE, BIS DAS HAUS DER HEILER HIER IN SPANNENBERG GEGRÜNDET WURDE. IN DER VERGANGENEN ZEIT IST ER IMMER GEWALTTÄTIGER GEWORDEN. ERST LETZTES JAHR HAT ER ZWEI PFLEGER DURCH EINEN GROßEN FEUERBALL SCHWER VERLETZT. ER MUSS, BEVOR ER VERRÜCKT GEWORDEN IST, EINMAL EIN GROßER MAGIER GEWESEN SEIN. FALLS IHR IHN BESUCHT, DANN GEHT NICHT IN SEINE ZELLE. SPRECHT MIT IHM NUR DURCH DIE GITTERSTÄBE.^ GANZ IM VERTRAUEN GESAGT, DAS WIRKLICH UNHEIMLICHE AN IHM IST NICHT, DASS ER VERRÜCKT IST, SONDERN DASS ER SCHEINBAR KAUM ALTERT. IN DEN ZWANZIG JAHREN, DIE ICH HIER ARBEITE, HAT ER SICH KAUM VERÄNDERT.\""
#: AllTexts/NPC_texts.amb/006/006.txt
msgctxt "AllTexts/NPC_texts.amb/006/006"
msgid "\"WELL, YOU WANT TO HEAR THE STORY OF THE MAD MAN.^ AS I UNDERSTAND FROM MY PREDECESSOR, HE SWAM TO OUR COAST SHORTLY AFTER THE GREAT DISASTER. THE ONLY THING HE HAD WITH HIM AT THAT TIME WAS A TORN BUT COSTLY ROBE AND HALF OF A STRANGE AMULET. I BELIEVE BOTH THESE ITEMS ARE NOW KEPT IN A BOX DOWN IN THE CELLAR.^ HE WAS TAKEN IN BY A FARMER FAMILY AND LIVED THERE FOR SEVERAL YEARS UNTIL THE HOUSE OF HEALERS WAS ESTABLISHED HERE IN SPANNENBERG. IN THE PAST HE BECAME MORE AND MORE VIOLENT. ONLY LAST YEAR HE BADLY INJURED TWO CARERS WITH A HUGE FIREBALL. BEFORE HE WENT MAD HE MUST HAVE BEEN AN IMPORTANT MAGICIAN. IF YOU VISIT HIM, DO NOT GO INTO HIS CELL. SPEAK TO HIM ONLY THROUGH THE BARS.^ IN CONFIDENCE, THE REALLY STRANGE THING ABOUT HIM IS NOT THAT HE IS MAD BUT THAT HE HARDLY SEEMS TO AGE AT ALL. HE HAS NOT CHANGED IN THE TWENTY YEARS THAT I HAVE BEEN WORKING HERE.\""
msgstr ""

#. Dialogue of NPC 006 (CLEMENTINE).
#. German: "\"WER HÄTTE JEMALS FÜR MÖGLICH GEHALTEN, DASS TARBOS BEREITS ALL DIE JAHRE MITTEN UNTER UNS WEILT?\"^"
#: AllTexts/NPC_texts.amb/006/007.txt
msgctxt "AllTexts/NPC_texts.amb/006/007"
msgid "\"WHO WOULD HAVE THOUGHT THAT TARBOS WAS RIGHT HERE AMONGST US ALL THESE YEARS?\"^"
msgstr ""

#. Dialogue of NPC 007 (MADMAN).
#. German: "IHR SEHT EINEN ZIEMLICH HERUNTERGEKOMMENEN MANN IN MITTLEREN JAHREN. ER TRÄGT EINEN ALTEN, ZERLUMPTEN KITTEL. SEINE HAARE HÄNGEN IHM WILD INS GESICHT, UND EIN LANGER, DÜNNER SPEICHELFADEN LÄUFT AUS EINEM SEINER MUNDWINKEL."
#: AllTexts/NPC_texts.amb/007/000.txt
msgctxt "AllTexts/NPC_texts.amb/007/000"
msgid "YOU SEE A RATHER POOR MAN OF MIDDLE AGE. HE IS WEARING A TORN OLD APRON. HIS HAIR DANGLES UNTIDILY AROUND HIS FACE AND A LONG THIN STRAND OF SALIVA HANGS OUT OF THE CORNER OF HIS MOUTH."
msgstr ""

#. Dialogue of NPC 007 (MADMAN).
#. German: "\"AH, HAHI! BESUCHER IN MEINER BESCHEIDENEN HÜTTE, HAHA!^ IHR SEID GEKOMMEN, UM MICH ZU VERNICHTEN, JA? NIEMALS, HAHA, HIHI.^ VERSCHWINDET, BEVOR ICH EUCH ZU ASCHE VERWANDLE, HAHA, JA ASCHE.^ GEHT WEG, GEHT W... HAHO, HI!\""
#: AllTexts/NPC_texts.amb/007/001.txt
msgctxt "AllTexts/NPC_texts.amb/007/001"
msgid "\"AH, HA! VISITORS TO MY MODEST HUT, HA-HA!^ YOU CAME TO DESTROY ME, DIDN'T YOU? NEVER, HA-HA, HE-HE.^ DISAPPEAR, BEFORE I TURN YOU INTO ASH, HA-HA, YES, ASH.^ GO AWAY, GO AWAY, HA-HO, HI-HI!\""
msgstr ""

#. Dialogue of NPC 007 (MADMAN).
#. German: "\"HA, HA! JA, LAUFT NUR WEG! MIT MEINER MACHT WERDE ICH EUCH DENOCH ERREICHEN... JA ERREICHEN... NUR MYL... HAB ICH NIE ERREICHT! HAHA, HI...\""
#: AllTexts/NPC_texts.amb/007/002.txt
msgctxt "AllTexts/NPC_texts.amb/007/002"
msgid "\"HA, HA! YES, JUST RUN AWAY! I WILL STILL REACH YOU WITH MY POWER ... YES REACH ..., ONLY MYL... I NEVER REACHED! HA-HA, HI...\""
msgstr ""

#. Dialogue of NPC 007 (MADMAN).
#. German: "ALS IHR DEM VERRÜCKTEN DAS HALBE AMULETT ZEIGT, GEHT PLÖTZLICH EIN HAUCH VON ERKENNEN DURCH SEIN GESICHT. DOCH ES WIRD SCHNELL WIEDER VON SEINEM VERWIRRTEN GEIST ÜBERLAGERT."
#: AllTexts/NPC_texts.amb/007/003.txt
msgctxt "AllTexts/NPC_texts.amb/007/003"
msgid "AS YOU SHOW THE HALF OF THE AMULET TO THE MADMAN, A FLASH OF RECOGNITION LIGHTENS HIS FACE. BUT IT IS SOON REPLACED BY A CONFUSED LOOK."
msgstr ""

#. Dialogue of NPC 007 (MADMAN).
#. German: "ALS IHR IHM DAS T$A$R$B$O$S-AMULETT ZEIGT, STÖHNT ER PLÖTZLICH AUF, UND SEINE LANGEN, DÜNNEN ARME VERSUCHEN NACH DEM AMULETT ZU GREIFEN."
#: AllTexts/NPC_texts.amb/007/004.txt
msgctxt "AllTexts/NPC_texts.amb/007/004"
msgid "AS YOU SHOW HIM THE T$A$R$B$O$S AMULET, HE SUDDENLY SIGHS AND HIS LONG THIN ARMS REACH OUT FOR IT."
msgstr ""

#. Dialogue of NPC 007 (MADMAN).
#. German: "GIERIG GREIFT ER NACH DEM AMULETT UND HÄNGT ES SICH UM.^ ERST PASSIERT GAR NICHTS, DOCH DANN WIRD ER PLÖTZLICH VON KRÄMPFEN ERGRIFFEN. ALS DER ANFALL VORBEI IST, IST SEIN GESICHTSAUSDRUCK KLARER, UND DER VERRÜCKTE GLANZ IST AUS SEINEN AUGEN GEWICHEN. EINE WEILE LANG SCHEINT ER IN DIE STILLE DES KELLERS HINEINZULAUSCHEN, UND SEIN GESICHT ZEIGT, DASS ER SICH AN VIELE DINGE ERINNERT, DIE VERSCHÜTTET WAREN.^ DANN BRICHT ER URPLÖTZLICH SCHLUCHZEND IN EINER ECKE DER ZELLE ZUSAMMEN."
#: AllTexts/NPC_texts.amb/007/005.txt
msgctxt "AllTexts/NPC_texts.amb/007/005"
msgid "HE REACHES GREEDILY FOR THE AMULET AND PUTS IT ON.^ AT FIRST NOTHING AT ALL HAPPENS BUT THEN HE IS SUDDENLY ATTACKED BY CRAMPS. WHEN THE ATTACK IS OVER, HIS FACIAL EXPRESSION CLEARS AND THE MAD LOOK HAS GONE FROM HIS EYES. HE SEEMS TO LISTEN TO THE STILLNESS IN THE CELLAR FOR A LONG TIME AND HIS FACE SHOWS THAT HE IS REMEMBERING MANY THINGS WHICH WERE PREVIOUSLY OBSCURED FROM HIS MEMORY.^ THEN HE SUDDENLY COLLAPSES IN A SOBBING HEAP IN A CORNER OF THE CELL."
msgstr ""

#. Dialogue of NPC 008 (BARON GEORGE).
#. German: "IHR SEHT EINEN HOCHGEWACHSENEN ARISTROKRATISCH AUSSEHENDEN MANN IN MITTLEREN JAHREN. ER SIEHT EUCH NEUGRIERIG AN."
#: AllTexts/NPC_texts.amb/008/000.txt
msgctxt "AllTexts/NPC_texts.amb/008/000"
msgid "YOU SEE A TALL ARISTOCRATIC LOOKING MAN IN MIDDLE AGE. HE LOOKS AT YOU WITH CURIOSITY."
msgstr ""

#. Dialogue of NPC 008 (BARON GEORGE).
#. German: "\"ICH BIN FREIHERR GEORG SCHILD VON SPANNENBERG UND HEIßE EUCH HERZLICH IN MEINER STADT WILLKOMMEN!^ VIELLEICHT KÖNNT IHR MIR BEI EINEM MEINER PROBLEME HELFEN?! ES SOLL EUER SCHADEN NICHT SEIN.\""
#: AllTexts/NPC_texts.amb/008/001.txt
msgctxt "AllTexts/NPC_texts.amb/008/001"
msgid "\"I AM BARON GEORGE SCHILD VON SPANNENBERG AND I WELCOME YOU TO MY TOWN!^ PERHAPS YOU CAN HELP ME WITH ONE OF MY PROBLEMS?! YOU WON'T REGRET IT.\""
msgstr ""

#. Dialogue of NPC 008 (BARON GEORGE).
#. German: "\"ICH HOFFE, DASS EUCH GLÜCK BESCHIEDEN IST UND IHR MIR BEI MEINEN PROBLEMEN HELFEN KÖNNT!\""
#: AllTexts/NPC_texts.amb/008/002.txt
msgctxt "AllTexts/NPC_texts.amb/008/002"
msgid "\"I HOPE THAT YOU ARE LUCKY AND CAN HELP ME WITH MY PROBLEMS!\""
msgstr ""

#. Dialogue of NPC 008 (BARON GEORGE).
#. German: "\"NUN JA, ZUR ZEIT HABE ICH ES MIT ZWEI PROBLEMEN HIER IN SPANNENBERG ZU TUN.^^ ALS ERSTES SIND DA DIE ÜBERFÄLLE DER ORKS AUF MEINE BAUERN. VÖLLIG ÜBERRASCHEND KOMMEN SIE AUS DEN WESTLICHEN BERGEN UND PLÜNDERN DIE FELDER UND GEHÖFTE.^ FALLS IHR DIE ÜBERFÄLLE UNTERBINDEN KÖNNT UND MIR EINEN BEWEIS EURER TAT BRINGT, WERDE ICH EUCH GROßZÜGIG BELOHNEN.^ DES WEITEREN WIRD DIE STADT VON EINER BANDE VON BANDITEN GEPLAGT. DER ANFÜHRER SOLL EIN MANN NAMES SILBERHAND SEIN. ALL DIE JAHRE HATTE ICH EINE EINTRÄG... ÄH, EIN GUTES VERHÄLTNIS ZUR DIEBESGILDE VON SPANNENBERG. IHRE MITGLIEDER SIND, JEDENFALLS NACH IHREN REGELN, DISZIPLINIERT, UND SIE HABEN SOZUSAGEN NUR DAS NÖTIGSTE GESTOHLEN. DIE BÜRGER KONNTEN JEDENFALLS MIT IHNEN LEBEN.^ OBWOHL MIR DIE MEISTER DER GILDE VERSICHERN, DASS SIE NICHTS MIT DER DERZEITIGEN PLAGE ZU TUN HABEN, KANN ICH IHNEN DOCH NICHT GANZ GLAUBEN SCHENKEN, UND DIE BEVÖLKERUNG IST INZWISCHEN ZIEMLICH AUFGEBRACHT. VIELLEICHT KÖNNT IHR LICHT IN DIE SACHE BRINGEN.\""
#: AllTexts/NPC_texts.amb/008/003.txt
msgctxt "AllTexts/NPC_texts.amb/008/003"
msgid "\"WELL, YES, AT THE MOMENT I HAVE TWO PROBLEMS HERE IN SPANNENBERG.^^ THE FIRST ONE INVOLVES ORCS ATTACKING MY FARMERS. THEY SUDDENLY COME OUT OF THE MOUNTAINS TO THE WEST AND PLUNDER THE FIELDS AND THE FARMS.^ IF YOU COULD STOP THEIR ATTACKS AND BRING ME PROOF THAT YOU HAVE DONE IT, I WILL REWARD YOU GENEROUSLY.^ FURTHERMORE, THE TOWN IS PLAGUED BY A GANG OF BANDITS. THE LEADER IS SAID TO BE A MAN CALLED SILVERHAND. ALL THESE YEARS I HAD A GOOD ARRANGEMENT, UMM, I MEAN A GOOD RELATIONSHIP WITH THE GUILD OF THIEVES IN SPANNENBERG. THEIR MEMBERS ARE WELL DISCIPLINED, AT LEAST ACCORDING TO THEIR OWN RULES, AND THEY ONLY STOLE ABSOLUTE NECESSITIES, SO TO SPEAK. THE CITIZENS IN THE TOWN WERE CERTAINLY ABLE TO PUT UP WITH THEM.^ ALTHOUGH THE MASTERS OF THE GUILD PROMISE ME THAT THEY HAVE NOTHING TO DO WITH THE PLAGUE AT THIS TIME, I CANNOT QUITE BELIEVE THEM AND THE PEOPLE LIVING HERE ARE NOW RATHER UPSET. PERHAPS YOU CAN SPREAD SOME LIGHT ON THE MATTER.\""
msgstr ""

#. Dialogue of NPC 008 (BARON GEORGE).
#. German: "\"AH, IHR HABT ALSO AUCH SCHON VON DER GESCHICHTE MEINER FRAU GEHÖRT.^ ICH BIN FELSENFEST DAVON ÜBERZEUGT, DASS SIE DIE GANZE SACHE NUR GETRÄUMT HAT. WER IMMER MEINE AMTSKETTE AUCH GESTÖHLEN HAT, ES WAREN SICHERLICH KEINE BLAUEN UND GRÜNEN FEEN.^ APROPOS AMTSKETTE. FALLS IHR SIE FINDEN WÜRDET, HÄTTE ICH EINE FÜRSTLICHE BELOHNUNG FÜR EUCH.\""
#: AllTexts/NPC_texts.amb/008/004.txt
msgctxt "AllTexts/NPC_texts.amb/008/004"
msgid "\"OH, YOU ALREADY HEARD THE STORY ABOUT MY WIFE.^ I AM ABSOLUTELY CONVINCED THAT SHE ONLY DREAMED THE WHOLE THING. WHOEVER STOLE MY CHAIN OF OFFICE, THEY WERE CERTAINLY NO BLUE AND GREEN FAIRIES.^ AND TALKING ABOUT THE CHAIN OF OFFICE - IF YOU FIND IT, I WOULD HAVE A PRINCELY REWARD FOR YOU.\""
msgstr ""

#. Dialogue of NPC 008 (BARON GEORGE).
#. German: "\"SOSO, IHR HABT ALSO EINEN BRIEF VOM MEISTER DER FREMDEN BANDITEN. NUN DENN, SO GEBT IHN MIR!\""
#: AllTexts/NPC_texts.amb/008/005.txt
msgctxt "AllTexts/NPC_texts.amb/008/005"
msgid "\"SO, YOU HAVE A LETTER FROM THE LEADER OF THE STRANGE BANDITS. WELL THEN, GIVE IT TO ME!\""
msgstr ""

#. Dialogue of NPC 008 (BARON GEORGE).
#. German: "\"DAS IST ALSO DIE FALSCHE HAND DES MEISTERS DER FREMDEN BANDITEN?!^ GEBT SIE MIR, DANN SOLLT IHR DIE VERSPROCHENE BELOHNUNG ERHALTEN.\""
#: AllTexts/NPC_texts.amb/008/006.txt
msgctxt "AllTexts/NPC_texts.amb/008/006"
msgid "\"THAT IS THE FALSE HAND OF THE MASTER OF THE STRANGE BANDITS?!^ GIVE IT TO ME, AND YOU WILL HAVE THE REWARD AS PROMISED.\""
msgstr ""

#. Dialogue of NPC 008 (BARON GEORGE).
#. German: "\"DAS IST JA MEINE VERSCHWUNDENE AMTSKETTE! BITTE, GEBT SIE MIR ZURÜCK!\""
#: AllTexts/NPC_texts.amb/008/007.txt
msgctxt "AllTexts/NPC_texts.amb/008/007"
msgid "\"THAT IS MY CHAIN OF OFFICE, INDEED IT IS!, PLEASE, GIVE IT BACK TO ME!\""
msgstr ""

#. Dialogue of NPC 008 (BARON GEORGE).
#. German: "\"DIESES MONSTER WAR ALSO DER ANFÜHRER DER ORKS. ICH HABE MICH SCHON IMMER GEFRAGT, WARUM DIE ORKS SO VIELE NAHRUNGSMITTEL GESTOHLEN HABEN. BEI ALLEM, WAS ICH VOM APPETIT EINES RIESEN GEHÖRT HABE, SOLLTE MAN SICH DA NICHT WUNDERN.^ GEBT MIR DEN KOPF, UND DIE BELOHNUNG SOLL EUER SEIN!\""
#: AllTexts/NPC_texts.amb/008/008.txt
msgctxt "AllTexts/NPC_texts.amb/008/008"
msgid "\"SO THIS MONSTER WAS THE LEADER OF THE ORCS. I ALWAYS WONDERED WHY THE ORCS STOLE SO MUCH FOOD. WITH EVERYTHING I HAVE HEARD ABOUT THE APPETITE OF A GIANT, WE REALLY SHOULD NOT BE SURPRISED.^ GIVE ME THE HEAD AND THE REWARD WILL BE YOURS!\""
msgstr ""

#. Dialogue of NPC 008 (BARON GEORGE).
#. German: "DER FREIHERR NIMMT DEN BRIEF UND LIEST ZUNÄCHST EINIGE MINUTEN SCHWEIGEND.^ \"DER ALTE NAGIER SCHEINT EIN VERNÜFTIGER MANN ZU SEIN. ICH WERDE AUF SEINEN VORSCHLAG EINGEHEN UND IHN IN RUHE LASSEN, FALLS ER DIE STADT NICHT MEHR BELÄSTIGT.^ DA IHR DIE STADT VON DEN BANDITEN BEFREIT HABT, GEBE ICH EUCH HIERMIT DIE VERSPROCHENE BELOHNUNG.\"^ MIT DIESEN WORTEN HOLT DER FREIHERR EINEN GROßEN SCHLÜSSEL HERVOR UND ÜBERREICHT IHN EUCH."
#: AllTexts/NPC_texts.amb/008/009.txt
msgctxt "AllTexts/NPC_texts.amb/008/009"
msgid "THE BARON TAKES THE LETTER AND READS IT IN SILENCE FOR A FEW MINUTES.^ \"THE OLD MAGICIAN SEEMS TO BE A REASONABLE MAN. I WILL ACCEPT HIS PROPOSAL AND LEAVE HIM IN PEACE IF HE DOES NOT BOTHER THE TOWN ANY MORE.^ AS YOU HAVE FREED THE TOWN OF THE BANDITS, I AM GIVING YOU THE REWARD I PROMISED.\"^ WITH THESE WORDS THE BARON BRINGS OUT A HUGE KEY AND HANDS IT TO YOU."
msgstr ""

#. Dialogue of NPC 008 (BARON GEORGE).
#. German: "\"SOSO, DIESER BURSCHE STECKTE ALSO HINTER DEN DIEBSTÄHLEN! ICH HOFFE, DASS DIE STADT NACH SEINEM TOD VON DIESEN GANOVEN VERSCHONT BLEIBT. HIER HABT IHR DIE VERSPROCHEN BELOHNUNG.\"^ MIT DIESEN WORTEN ÜBERREICHT EUCH DER FREIHERR EINEN SCHLÜSSEL."
#: AllTexts/NPC_texts.amb/008/010.txt
msgctxt "AllTexts/NPC_texts.amb/008/010"
msgid "\"SO, THIS IS THE THUG RESPONSIBLE FOR THE THEFTS! I HOPE THAT THE TOWN WILL BE SAFE AFTER THE DEATH OF THIS ROBBER. HERE IS THE REWARD I PROMISED.\"^ WITH THESE WORDS THE BARON HANDS YOU A HUGE GOLD KEY."
msgstr ""

#. Dialogue of NPC 008 (BARON GEORGE).
#. German: "\"NACH DEM TOD DES RIESEN WERDEN DIE RESTLICHEN ORKS WOHL ABZIEHEN UND DIE BAUERN VON SPANNENBERG IN RUHE LASSEN.^ VIELEN DANK FÜR EURE HILFE, UND, BEVOR ICH ES VERGESSE, HIER DIESER SCHLÜSSEL PASST ZUR TRUHE MIT EURER BELOHNUNG!\""
#: AllTexts/NPC_texts.amb/008/011.txt
msgctxt "AllTexts/NPC_texts.amb/008/011"
msgid "\"AFTER THE DEATH OF THE GIANT THE REMAINING ORCS WILL PROBABLY DEPART AND LEAVE THE FARMERS OF SPANNENBERG IN PEACE.^ MANY THANKS FOR YOUR HELP AND, BEFORE I FORGET, THIS KEY HERE FITS THE CHEST WHERE YOU WILL FIND YOUR REWARD!\""
msgstr ""

#. Dialogue of NPC 008 (BARON GEORGE).
#. German: "MIT EINEM STOLZEN BLICK NIMMT DER FREIHERR SEINE AMTSKETTE ENTGEGEN UND HÄNGT SIE SICH UM.^ ALS IHR IHM DIE GESCHICHTE DER SYLPHEN ERZÄHLT, HÖRT ER EUCH ERSTAUNT UND AUFMERKSAM ZU. ANSCHLIEßEND SAGT ER:^ \"ICH MUSS SOFORT ZU MEINER FRAU UND MICH BEI IHR ENTSCHULDIGEN! WIE KONNTE ICH NUR BEHAUPTEN, SIE HÄTTE NUR GETRÄUMT? DOCH ZUVOR MÖCHTE ICH EUCH AUS DANK DIESE PERLE HIER SCHENKEN. ICH HABE SIE VOR JAHREN VON EINEM FISCHER ERHALTEN. ER SAGTE DAMALS, ES SEI EINE DER SELTENEN WINDPERLEN. ICH HOFFE, IHR KÖNNT SIE BESSER GEBRAUCHEN ALS ICH.\""
#: AllTexts/NPC_texts.amb/008/012.txt
msgctxt "AllTexts/NPC_texts.amb/008/012"
msgid "WITH A LOOK OF PRIDE THE BARON TAKES HIS CHAIN OF OFFICE AND PUTS IT ON.^ AS YOU TELL HIM THE STORY OF THE SYLPHS, HE LISTENS IN ASTONISHMENT. THEN HE SAYS:^ \"I MUST GO TO MY WIFE IMMEDIATELY AND APOLOGISE TO HER! HOW COULD I MAINTAIN SHE HAD ONLY DREAMED ALL THIS? BUT BEFORE I GO, I WOULD LIKE TO PRESENT YOU WITH THIS PEARL AS A GIFT. I RECEIVED IT FROM A FISHERMAN MANY YEARS AGO. HE SAID IT WAS ONE OF THE FEW WIND PEARLS. I HOPE YOU CAN USE IT BETTER THAN I HAVE.\""
msgstr ""

#. Dialogue of NPC 009 (LADY HEIDI).
#. German: "IHR SEHT EINE FRAU IN EINER ROBE AUS KOSTBAREM BROKAT UND SEIDE. SIE LÄCHELT EUCH AN."
#: AllTexts/NPC_texts.amb/009/000.txt
msgctxt "AllTexts/NPC_texts.amb/009/000"
msgid "YOU SEE A LADY WEARING A ROBE OF COSTLY BROCADE AND SILK. SHE SMILES AT YOU."
msgstr ""

#. Dialogue of NPC 009 (LADY HEIDI).
#. German: "\"ICH BIN LADY HEIDI, UND ICH HEIßE EUCH HERZLICH WILLKOMMEN IN SPANNENBERG!^ FALLS IHR EINE AUFGABE SUCHT, DANN SOLLTET IHR ZU MEINEN MANN GEHEN. ER BRAUCHT ZUR ZEIT EIN PAAR MUTIGE ABENTEURER.\""
#: AllTexts/NPC_texts.amb/009/001.txt
msgctxt "AllTexts/NPC_texts.amb/009/001"
msgid "\"I AM LADY HEIDI AND I WELCOME YOU TO SPANNENBERG!^ IF YOU ARE LOOKING FOR SOMETHING TO DO, YOU SHOULD GO AND TALK TO MY HUSBAND. HE NEEDS A FEW BRAVE ADVENTURERS AT THE MOMENT.\""
msgstr ""

#. Dialogue of NPC 009 (LADY HEIDI).
#. German: "\"ICH WÜNSCHE EUCH NOCH EINEN ANGENEHMEN AUFENTHALT IN SPANNENBERG, AUCH WENN DAS BEI DIESEN VIELEN BANDITENÜBERFÄLLEN EIN WENIG SCHWIERIG WERDEN KÖNNTE.\""
#: AllTexts/NPC_texts.amb/009/002.txt
msgctxt "AllTexts/NPC_texts.amb/009/002"
msgid "\"I HOPE YOU ENJOY YOUR STAY IN SPANNENBERG, EVEN IF IT COULD BECOME A LITTLE DIFFICULT WITH THE MANY ATTACKS BY THE BANDITS.\""
msgstr ""

#. Dialogue of NPC 009 (LADY HEIDI).
#. German: "\"MEIN MANN MEINT ZWAR, ICH HÄTTE MIR DIE GANZE SACHE NUR EINGEBILDET, DA IHR ABER AN DER GESCHICHTE INTERESSIERT SEID, WILL ICH SIE EUCH GERN ERZÄHLEN:^ VOR EIN PAAR TAGEN KONNTE ICH NACHTS NICHT SCHLAFEN, DESHALB BIN ICH AUFGESTANDEN UND HABE DURCH EIN FENSTER DIE BEIDEN MONDE BETRACHTET. NACH EINIGER ZEIT HABE ICH PLÖTZLICH EIN SELTSAME ERSCHEINUNG GESEHEN. EIN PAAR UNGEWÖHNLICHE GESCHÖPFE KAMEN AUF DAS HAUS ZUGEFLOGEN. SIE KAMEN MIR ZUERST VOR WIE ENGEL, DOCH ALS SIE DANN GANZ NAH WAREN, KONNTE ICH SEHEN, DASS ES FRAUEN WAREN. DAS MERKWÜRDIGE AN IHNEN WAREN ALLERDINGS IHRE BLAUE UND GRÜNE HAUT UND DIE GROßEN SCHILLERNDEN FLÜGEL.^ OBWOHL ICH DIE TÜR AN JENEM ABEND PERSÖNLICH VERSCHLOSSEN HATTE, STANDEN SIE EIN PAAR AUGENBLICKE SPÄTER IN DER EINGANGSHALLE. ICH HABE MICH VERSTECKT UND SIE DANN BEOBACHTET. SIE BENAHMEN SICH WIE KLEINE KINDER, SIE LACHTEN, WENN AUCH LEISE, UND SCHAUTEN SICH ALLES GANZ GENAU AN. VOR ALLEN DINGEN SCHIENEN ES IHNEN GLITZERNDE DINGE ANGETAN ZU HABEN. ICH SAH, WIE SIE MEHRERE SILBERLÖFFEL AUS DEM ESSZIMMER MITGEHEN LIEßEN. IM AUDIENZSAAL HABEN SIE DANN DIE AMTSKETTE MEINES MANNES GEFUNDEN, UND EINE DER GRÜNHÄUTIGEN HAT SIE EINGESTECKT. KURZ DARAUF HABEN SIE DANN DAS HAUS WIEDER VERLASSEN.^ ICH WARF MIR SCHNELL EINEN MANTEL ÜBER UND FOLGTE IHNEN SO GUT ES GING, NÄMLICH BIS ZU EINEM HÖHLENEINGANG WESTLICH VON HIER, UNGEFÄHR DORT, WO DER TEICH AN DEN KLEINEN VULKANHÜGEL GRENZT. WENN SIE ZIELSTREBIG DORTHIN GEFLOGEN WÄREN, HÄTTE ICH IHNEN NIE SO WEIT FOLGEN KÖNNEN, DOCH WIE GESAGT, SIE BENAHMEN SICH WIE KINDER, AUCH BEIM FLIEGEN. ALS SIE LANDETEN, NAHM EINE VON IHNEN ETWAS AUS EINEM ASTLOCH IN EINEM BAUM NEBEN DEM HÖHLENEINGANG, SO WIE WENN JEMAND SEINEN HAUSSCHLÜSSEL UNTER EINEM BLUMENTOPF HERVORHOLT.^ IN DIE HÖHLE BIN ICH IHNEN DANN ABER NICHT GEFOLGT, DENN ICH BEKAM ES DOCH MIT DER ANGST ZU TUN. ICH MACHTE, DASS ICH WIEDER NACH SPANNENBERG KAM.^ AM MORGEN HABE ICH DANN MEINEM MANN ALLES ERZÄHLT, DOCH ER MEINTE, ICH HÄTTE NUR GETRÄUMT UND DIE AMTSKETTE HÄTTEN DIE FREMDEN BANDITEN GESTOHLEN.\""
#: AllTexts/NPC_texts.amb/009/003.txt
msgctxt "AllTexts/NPC_texts.amb/009/003"
msgid "\"MY HUSBAND FEELS I DREAMED THE WHOLE THING BUT AS YOU ARE INTERESTED IN THE STORY, I AM PLEASED TO TELL YOU ABOUT IT:^ A FEW DAYS AGO I WAS UNABLE TO SLEEP AT NIGHT SO I GOT UP AND LOOKED THROUGH THE WINDOW AT THE TWO MOONS. SOME TIME LATER I SUDDENLY SAW A STRANGE APPARITION. SEVERAL UNUSUAL BEINGS CAME FLYING TOWARDS THE HOUSE. AT FIRST I THOUGHT THEY WERE ANGELS BUT WHEN THEY CAME QUITE CLOSE I COULD SEE THAT THEY WERE WOMEN. THE STRANGE THING ABOUT THEM, HOWEVER, WAS THAT THEIR SKIN WAS BLUE AND GREEN AND THEY HAD LARGE SHIMMERING WINGS.^ ALTHOUGH I PERSONALLY LOCKED THE FRONT DOOR THAT EVENING, A FEW MOMENTS LATER, THEY WERE SIMPLY STANDING IN THE ENTRANCE HALL. I HID AND WATCHED THEM. THEY BEHAVED LIKE SMALL CHILDREN, THEY LAUGHED QUIETLY AND LOOKED AT EVERYTHING WITH GREAT INTEREST. ABOVE ALL, THEY SEEMED TO BE FASCINATED WITH THINGS THAT GLISTENED OR SHONE. I SAW THEM TAKE SEVERAL SILVER SPOONS FROM THE DINING ROOM. THEN, IN THE CONFERENCE CHAMBER THEY FOUND MY HUSBAND'S CHAIN OF OFFICE AND ONE OF THE GREEN-SKINNED BEINGS HID IT AWAY. SHORTLY AFTERWARDS THEY LEFT THE HOUSE AGAIN.^ I QUICKLY PUT A COAT ON AND FOLLOWED THEM AS WELL AS I COULD, TO THE ENTRANCE OF A CAVE TO THE WEST OF HERE, CLOSE TO WHERE THE POND LIES AT THE FOOT OF THE SMALL VOLCANO. IF THEY HAD FLOWN DIRECTLY THERE I WOULD NEVER HAVE BEEN ABLE TO FOLLOW THEM THAT FAR BUT, AS I SAID, THEY BEHAVED LIKE CHILDREN, EVEN WHILE THEY WERE FLYING. WHEN THEY LANDED, ONE OF THEM TOOK SOMETHING OUT OF A HOLE IN A TREE NEXT TO THE ENTRANCE TO THE CAVE, JUST LIKE YOU MIGHT TAKE THE KEY TO YOUR HOUSE OUT FROM UNDER A PLANT POT.^ BUT I DID NOT FOLLOW THEM INTO THE CAVE BECAUSE I WAS AFRAID. I RETURNED TO SPANNENBERG.^ IN THE MORNING I TOLD MY HUSBAND EVERYTHING BUT HE THOUGHT I ONLY DREAMED IT AND THAT THE CHAIN OF OFFICE HAD BEEN STOLEN BY THE STRANGE BANDITS.\""
msgstr ""

#. Dialogue of NPC 009 (LADY HEIDI).
#. German: "\"ICH FREUE MICH, DASS ICH NICHT GETRÄUMT HABE UND DASS SYLVIA SICH GUT BEI UNS EINLEBT.\""
#: AllTexts/NPC_texts.amb/009/004.txt
msgctxt "AllTexts/NPC_texts.amb/009/004"
msgid "\"I AM PLEASED THAT I DID NOT DREAM IT ALL.\""
msgstr ""

#. Dialogue of NPC 010 (TOLIMAR).
#. German: "IHR SEHT EINEN RIESEN VON EINEM MANN. ER HAT MUSKULÖSE BEHAARTE ARME UND LÄCHELT EUCH BREIT GRINSEND AN."
#: AllTexts/NPC_texts.amb/010/000.txt
msgctxt "AllTexts/NPC_texts.amb/010/000"
msgid "YOU SEE A GIANT OF MAN. HE HAS MUSCULAR, HAIRY ARMS AND GRINS AT YOU WITH A BROAD SMILE."
msgstr ""

#. Dialogue of NPC 010 (TOLIMAR).
#. German: "\"WILLKOMMEN IN TOLIMAR'S PFERDEHANDLUNG! IHR WERDET HIER NUR DIE BESTEN RÖSSER FINDEN. WAS KANN ICH FÜR EUCH TUN?\""
#: AllTexts/NPC_texts.amb/010/001.txt
msgctxt "AllTexts/NPC_texts.amb/010/001"
msgid "\"WELCOME TO TOLIMAR'S HORSE STABLES! YOU WILL ONLY FIND THE BEST HORSES HERE. WHAT CAN I DO FOR YOU?\""
msgstr ""

#. Dialogue of NPC 010 (TOLIMAR).
#. German: "\"ICH HOFFE, ICH KONNTE EUCH ZU DIENSTEN SEIN.\""
#: AllTexts/NPC_texts.amb/010/002.txt
msgctxt "AllTexts/NPC_texts.amb/010/002"
msgid "\"I HOPE I CAN BE OF SERVICE TO YOU.\""
msgstr ""

#. Dialogue of NPC 010 (TOLIMAR).
#. German: "\"JA, KOMMT MAL MIT IN DEN STALL, DORT HABE ICH SECHS GANZ BESONDERS SCHNELLE SCHIMMEL. ICH DENKE, DIE KÖNNTEN EUCH ZUSAGEN. WENN JA, DANN BEZAHLT BITTE IM BÜRO AM ENDE DES STALLS.\""
#: AllTexts/NPC_texts.amb/010/003.txt
msgctxt "AllTexts/NPC_texts.amb/010/003"
msgid "\"YES, COME WITH ME TO THE STABLES, I HAVE SIX VERY FAST HORSES THERE. I THINK YOU WILL LIKE THEM. IF SO, PLEASE PAY FOR THEM IN THE OFFICE AT THE END OF THE STABLES.\""
msgstr ""

#. Dialogue of NPC 010 (TOLIMAR).
#. German: "\"SO, IHR BRAUCHT ALSO WERKZEUG? NUN, EIN EISENWARENHÄNDLER BIN ICH NICHT, ABER VIELEICHT KÖNNEN WIR EIN GESCHÄFT MACHEN.^ VOR EIN PAAR TAGEN HABEN SILBERHAND UND SEINE BANDITEN MEIN GESCHÄFT HIER AUSGERAUBT. VOR ALLEN DINGEN GRÄMT ES MICH, DASS SIE MEINE VIER GOLDENEN HUFEISEN MITGENOMMEN HABEN. WENN IHR MIR ALLE VIER WIEDER ZURÜCKBRINGT, DANN WILL ICH EUCH GERNE WERKZEUG GEBEN.\""
#: AllTexts/NPC_texts.amb/010/004.txt
msgctxt "AllTexts/NPC_texts.amb/010/004"
msgid "\"SO, YOU NEED TOOLS? WELL, I AM NOT AN IRONMONGER BUT PERHAPS WE CAN DO BUSINESS.^ A FEW DAYS AGO SILVERHAND AND HIS BANDITS ROBBED MY BUSINESS HERE. THE MAIN THING I AM SORRY ABOUT IS THAT THEY TOOK MY FOUR GOLDEN HORSE SHOES. IF YOU CAN RETURN ALL FOUR OF THEM TO ME, I WILL BE PLEASED TO GIVE YOU SOME TOOLS.\""
msgstr ""

#. Dialogue of NPC 010 (TOLIMAR).
#. German: "\"AH JA, DAS IST EINS MEINER EISEN. GEBT MIR ALLE VIER, UND IHR SOLLT EUER WERKZEUG HABEN!\""
#: AllTexts/NPC_texts.amb/010/005.txt
msgctxt "AllTexts/NPC_texts.amb/010/005"
msgid "\"OH YES, THAT IS ONE OF MY HORSE SHOES. GIVE ME ALL FOUR AND YOU WILL HAVE YOUR TOOLS!\""
msgstr ""

#. Dialogue of NPC 010 (TOLIMAR).
#. German: "\"ES TUT MIR LEID, ABER WIR HATTEN AUSGEMACHT, DASS IHR MIR ALLE VIER DER GOLDENEN HUFEISEN BRINGT.\""
#: AllTexts/NPC_texts.amb/010/006.txt
msgctxt "AllTexts/NPC_texts.amb/010/006"
msgid "\"I AM SORRY, BUT WE HAD AGREED THAT YOU WILL BRING ME ALL FOUR OF THE GOLDEN HORSE SHOES.\""
msgstr ""

#. Dialogue of NPC 010 (TOLIMAR).
#. German: "\"VIELEN DANK, DASS IHR DIE KOSTBAREN HUFEISEN GERETTET HABT! ICH HÄNGE SEHR AN IHNEN, DENN ES SIND MEINE GLÜCKSBRINGER, UND ICH HATTE SCHON ANGST, DIE BANDITEN WÜRDEN SIE EINSCHMELZEN.^ HIER HABT IHR EINE SCHAUFEL UND EINE SPITZHACKE. EIN BRECHEISEN LEGE ICH NOCH DAZU. DA SEHT IHR MAL, WIE GROßZÜGIG ICH BIN: IHR HABT FÜR SO WENIG GOLD SO VIEL EISEN VON MIR BEKOMMEN, HAHA.\""
#: AllTexts/NPC_texts.amb/010/007.txt
msgctxt "AllTexts/NPC_texts.amb/010/007"
msgid "\"MANY THANKS FOR SAVING MY VALUABLE HORSE SHOES! I AM VERY ATTACHED TO THEM BECAUSE THEY BRING ME LUCK AND I WAS AFRAID THE BANDITS WOULD MELT THEM DOWN.^ HERE IS A SHOVEL AND A PICKAXE. I WILL ADD A CROWBAR, TOO. SO YOU SEE HOW GENEROUS I AM: FOR SO LITTLE GOLD YOU HAVE GOT SO MUCH IRON FROM ME, HA-HA.\""
msgstr ""

#. Dialogue of NPC 011 (CAPTAIN TORLE).
#. German: "IHR SEHT EINEN ALTEN SEEBÄREN MIT LOCKENBART. ER TRÄGT EINE LEDERSCHÜRZE UND HÄLT EINEN HOBEL IN DER HAND."
#: AllTexts/NPC_texts.amb/011/000.txt
msgctxt "AllTexts/NPC_texts.amb/011/000"
msgid "YOU SEE AN OLD SEA CAPTAIN WITH A THICK BEARD. HE IS WEARING A LEATHER APRON AND IS HOLDING A WOOD PLANE IN HIS HAND."
msgstr ""

#. Dialogue of NPC 011 (CAPTAIN TORLE).
#. German: "\"ICH HEIßE MEINE RETTER HERZLICH AUF MEINER WERFT WILLKOMMEN! ICH HABE GERADE DIE ARBEIT AN EINEM NEUEN SCHIFF VOLLENDET, UND DAS MÖCHTE ICH EUCH ZUM DANK FÜR MEINE RETTUNG AUS DEN KLAUEN VON LUMINOR SCHENKEN. ES LIEGT JETZT AM ANLEGER SÜDWESTLICH VON SPANNENBERG. MÖGE EUCH SOBEK EWIG GEWOGEN SEIN!\""
#: AllTexts/NPC_texts.amb/011/001.txt
msgctxt "AllTexts/NPC_texts.amb/011/001"
msgid "\"WELCOME, SAVIOURS, WELCOME TO MY BOATYARD! I HAVE JUST FINISHED WORKING ON A NEW BOAT AND I WOULD LIKE TO MAKE YOU A GIFT OF IT IN THANKS FOR YOU SAVING ME FROM THE CLAWS OF LUMINOR. IT IS TIED TO THE QUAY AT THE SOUTH WEST OF SPANNENBERG. MAY SOBEK PROTECT YOU ALWAYS!\""
msgstr ""

#. Dialogue of NPC 011 (CAPTAIN TORLE).
#. German: "\"WILLKOMMEN AUF MEINER WERFT! BRAUCHT IHR VIELLEICHT NOCH EIN SCHIFF? ICH KANN EUCH GERN NOCH EINS ZUM FREUNDSCHAFTSPREIS VERKAUFEN. GEHT NUR DIE TREPPE NACH OBEN INS BÜRO!\""
#: AllTexts/NPC_texts.amb/011/002.txt
msgctxt "AllTexts/NPC_texts.amb/011/002"
msgid "\"WELCOME TO MY BOATYARD! DO YOU PERHAPS NEED A BOAT? I WILL BE PLEASED TO SELL YOU ONE AT A GOOD PRICE. GO UP THE STEPS INTO MY OFFICE!\""
msgstr ""

#. Dialogue of NPC 011 (CAPTAIN TORLE).
#. German: "\"MÖGE SOBEK EUCH NIE IN DIE TIEFE REIßEN, UND MÖGET IHR IMMER WIND IN EUREN SEGELN HABEN!\""
#: AllTexts/NPC_texts.amb/011/003.txt
msgctxt "AllTexts/NPC_texts.amb/011/003"
msgid "\"MAY SOBEK NEVER PULL YOU DOWN AND MAY YOU ALWAYS HAVE WIND IN YOUR SAILS!\""
msgstr ""

#. Dialogue of NPC 012 (WAT THE FISHER).
#. German: "IHR SEHT EINEN ALTEN FISCHER. ER HAT GERÖTETE AUGEN UND EINEN KUMMERVOLLEN BLICK."
#: AllTexts/NPC_texts.amb/012/000.txt
msgctxt "AllTexts/NPC_texts.amb/012/000"
msgid "YOU SEE AN OLD FISHERMAN. HIS EYES ARE RED AND HE LOOKS WORRIED."
msgstr ""

#. Dialogue of NPC 012 (WAT THE FISHER).
#. German: "\"LASST MICH BITTE IN FRIEDEN, MIR IST NICHT NACH UNTERHALTUNG ZUMUTE! ERST LETZTES JAHR HAT DAS SUMPFFIEBER MEINE FRAU GETÖTET, UND JETZT WIRD MEINE KLEINE TOCHTER STERBEN. ICH MUSS MICH JETZT UM SIE KÜMMERN, ALSO LASST MICH BITTE!\""
#: AllTexts/NPC_texts.amb/012/001.txt
msgctxt "AllTexts/NPC_texts.amb/012/001"
msgid "\"PLEASE LEAVE ME IN PEACE, I AM NOT IN THE MOOD FOR CONVERSATION! LAST YEAR THE SWAMP FEVER KILLED MY WIFE AND NOW MY LITTLE DAUGHTER IS DYING, TOO. I MUST LOOK AFTER HER, SO PLEASE LEAVE ME ALONE!\""
msgstr ""

#. Dialogue of NPC 012 (WAT THE FISHER).
#. German: "\"ICH STEHE TIEF IN EURER SCHULD, IHR HABT MEINER TOCHTER DAS LEBEN GERETTET UND SOMIT AUCH MEINS. WIE KANN ICH EUCH DAS JE VERGELTEN?^ NEHMT DIESE PERLE HIER! ICH HABE VOR JAHREN ZWEI VON DIESER ART GEFUNDEN UND EINE DEM FREIHERRN GESCHENKT. DIESE ZWEITE IST MEIN EINZIGER NENNENSWERTER BESITZ. DOCH WAS IST SIE GEGEN DAS LEBEN MEINER TOCHTER?\""
#: AllTexts/NPC_texts.amb/012/002.txt
msgctxt "AllTexts/NPC_texts.amb/012/002"
msgid "\"I AM IN YOUR DEBT, YOU SAVED MY DAUGHTER'S LIFE AND THEREFORE ALSO MY LIFE, TOO. HOW CAN I EVER REPAY YOU?^ TAKE THESE PEARLS! I FOUND TWO OF THEM MANY YEARS AGO AND GAVE THEM TO THE BARON. THIS SECOND ONE IS THE ONLY THING OF VALUE I POSSESS. BUT WHAT IS IT IN COMPARISON TO THE LIFE OF MY DAUGHTER?\""
msgstr ""

#. Dialogue of NPC 012 (WAT THE FISHER).
#. German: "\"AH, MEINE LIEBEN FREUNDE, KOMMT HEREIN UND NEHMT PLATZ! JETZT, DA MEINE TOCHTER DIE SCHLIMME KRANKHEIT HINTER SICH HAT, GEHT AUCH MEIN LEBEN WIEDER SEINEN GEREGELTEN GANG. ENDLICH KANN ICH AUCH WIEDER ZUM FISCHEN HINAUSFAHREN.\""
#: AllTexts/NPC_texts.amb/012/003.txt
msgctxt "AllTexts/NPC_texts.amb/012/003"
msgid "\"OH, MY DEAR FRIENDS, COME IN AND SIT DOWN! NOW THAT MY DAUGHTER HAS OVERCOME THAT TERRIBLE ILLNESS, MY LIFE WILL RETURN TO NORMAL. AT LAST I CAN GO FISHING AGAIN.\""
msgstr ""

#. Dialogue of NPC 012 (WAT THE FISHER).
#. German: "\"VIEL GLÜCK AUF EUREN WEGEN, UND MÖGE SOBEK DIE WOGEN FÜR EUCH GLÄTTEN!\""
#: AllTexts/NPC_texts.amb/012/004.txt
msgctxt "AllTexts/NPC_texts.amb/012/004"
msgid "\"GOOD LUCK ON YOUR TRAVELS AND MAY SOBEK SMOOTH THE SEAS FOR YOU!\""
msgstr ""

#. Dialogue of NPC 012 (WAT THE FISHER).
#. German: "\"JA, MEINE ARME SALLY, SIE HAT SICH DAS SCHRECKLICHE SUMPFFIEBER ZUGEZOGEN. ERST LETZTES JAHR IST MEINE GELIEBTE FRAU AN DIESER SCHRECKLICHEN KRANKHEIT GESTORBEN, UND NUN WIRD MIR AUCH MEINE EINZIGE TOCHTER GENOMMEN!^ WÜRDET IHR MIR WOHL DEN GROßEN GEFALLEN TUN UND IM HAUS DER HEILER VATER ANTONIUS FRAGEN, OB ES STIMMT, DASS ES EIN GEGENMITTEL GIBT? ICH WAR BEREITS DORT, ABER ICH TRAF DEN VATER NICHT AN, UND JETZT GEHT ES SALLY SCHON SO SCHLECHT, DASS ICH HIER NICHT MEHR FORT KANN.\""
#: AllTexts/NPC_texts.amb/012/005.txt
msgctxt "AllTexts/NPC_texts.amb/012/005"
msgid "\"YES, MY POOR SALLY, SHE GOT THE DREADFUL SWAMP FEVER. ONLY LAST YEAR MY BELOVED WIFE DIED FROM THE SAME TERRIBLE DISEASE AND NOW ALSO MY ONLY DAUGHTER WILL BE TAKEN FROM ME!^ PLEASE DO ME A GREAT FAVOUR AND ASK IN THE HOUSE OF THE HEALER, FATHER ANTHONY, IF IT IS TRUE THAT THERE IS AN ANTIDOTE? I HAVE BEEN THERE BUT DID NOT MEET FATHER ANTHONY AND NOW SALLY IS SO ILL THAT I DARE NOT LEAVE HER.\""
msgstr ""

#. Dialogue of NPC 012 (WAT THE FISHER).
#. German: "\"KURZ NACH DEM TOD MEINER FRAU HABE ICH ERFAHREN, DASS ES EIN GEGENMITTEL GEGEN DAS SUMPFFIEBER GEBEN SOLL. ES HIEß, VATER ANTONIUS AUS DEM HAUS DER HEILER WISSE, WIE MAN ES HERSTELLT. BITTE SUCHT IHN AUF UND FRAGT IHN DANACH, ES IST MEINE LETZTE HOFFNUNG!\""
#: AllTexts/NPC_texts.amb/012/006.txt
msgctxt "AllTexts/NPC_texts.amb/012/006"
msgid "\"SHORTLY AFTER MY WIFE DIED I HEARD THAT THERE IS SUPPOSED TO BE AN ANTIDOTE FOR THE SWAMP FEVER. PEOPLE SAY THAT FATHER ANTHONY FROM THE HOUSE OF HEALERS KNOWS HOW TO MAKE IT. PLEASE FIND HIM AND ASK HIM. THAT IS MY LAST HOPE!\""
msgstr ""

#. Dialogue of NPC 012 (WAT THE FISHER).
#. German: "\"IHR HABT ES TATSÄCHLICH! DEM HIMMEL SEI DANK! BITTE KOMMT SCHNELL MIT ZU MEINER TOCHTER UND LASST ES UNS IHR GEBEN!\""
#: AllTexts/NPC_texts.amb/012/007.txt
msgctxt "AllTexts/NPC_texts.amb/012/007"
msgid "\"YOU HAVE ACTUALLY GOT IT! THANKS BE TO HEAVEN! PLEASE COME IN QUICKLY TO MY DAUGHTER AND LET US GIVE IT TO HER!\""
msgstr ""

#. Dialogue of NPC 012 (WAT THE FISHER).
#. German: "\"BITTE VERABREICHT DAS MITTEL MEINER TOCHTER! VATER ANTONIUS HAT EUCH DOCH BESTIMMT GESAGT, WIE ES ANGEWENDET WIRD.\""
#: AllTexts/NPC_texts.amb/012/008.txt
msgctxt "AllTexts/NPC_texts.amb/012/008"
msgid "\"PLEASE GIVE THE ANTIDOTE TO MY DAUGHTER! FATHER ANTHONY PROBABLY TOLD YOU HOW IT IS TO BE ADMINISTERED.\""
msgstr ""

#. Dialogue of NPC 013 (SALLY).
#. German: "VOR EUCH STEHT SALLY, DIE JUNGE TOCHTER DES FISCHERS. SIE IST EIN HÜBSCHES MÄDCHEN, WENN AUCH NOCH ETWAS BLASS UM DIE NASE. ANSONSTEN SIND DIE SPUREN DER GEFÄHRLICHEN KRANKHEIT VÖLLIG VERSCHWUNDEN - NA JA, EIN PAAR PFUND ZULEGEN MUSS SIE WOHL NOCH."
#: AllTexts/NPC_texts.amb/013/000.txt
msgctxt "AllTexts/NPC_texts.amb/013/000"
msgid "BEFORE YOU STANDS SALLY, THE YOUNG DAUGHTER OF THE FISHERMAN. SHE IS A PRETTY GIRL, EVEN IF STILL A LITTLE PALE AROUND THE FACE. HOWEVER, IN OTHER RESPECTS ALL TRACE OF THE DANGEROUS DISEASE HAS COMPLETELY DISAPPEARED - BUT SHE PROBABLY NEEDS TO PUT ON A FEW POUNDS IN WEIGHT."
msgstr ""

#. Dialogue of NPC 013 (SALLY).
#. German: "\"IHR GUTEN MÄNNER! VATER HAT MIR ERZÄHLT, WELCHE MÜHEN IHR AUF EUCH GENOMMEN HABT, UM MIR DAS LEBEN ZU RETTEN. ICH KANN NICHT AUSDRÜCKEN, WIE DANKBAR ICH EUCH BIN.^ ICH WEISS, DASS ES NICHT ANGEMESSEN IST, ABER ICH MÖCHTE EUCH WENIGSTENS DIESEN RING SCHENKEN. ICH HABE IHN VOR EIN PAAR JAHREN VON MEINEM VATER BEKOMMEN. ER HAT IHN DAMALS IN EINEM GROßEN FISCH GEFUNDEN. DAS BESONDERE AN IHM IST, WENN MAN IHN UNTER WASSER HÄLT, DANN ERSCHEINT DER NAME SOBEK AUF DER EINEN SEITE.\""
#: AllTexts/NPC_texts.amb/013/001.txt
msgctxt "AllTexts/NPC_texts.amb/013/001"
msgid "\"YOU BRAVE MEN! FATHER TOLD ME WHAT AN EFFORT IT WAS FOR YOU TO SAVE MY LIFE. I CANNOT TELL YOU HOW GRATEFUL I AM.^ I KNOW THAT IT IS NOT NECESSARY, BUT I WOULD LIKE YOU TO AT LEAST TAKE THIS RING. MY FATHER GAVE IT TO ME A FEW YEARS AGO. HE FOUND IT ONCE IN A BIG FISH. THE STRANGE THING ABOUT IT IS IF YOU HOLD IT UNDER WATER, THE NAME SOBEK APPEARS ON ONE SIDE.\""
msgstr ""

#. Dialogue of NPC 013 (SALLY).
#. German: "\"OH, WIE SCHÖN, IHR SEID ES! SETZT EUCH, ICH FREUE MICH, DASS ICH SO LIEBEN BESUCH BEKOMME!^ VATER SAGT, DASS ICH BALD WIEDER AN DEN STRAND DARF, ABER ZUR ZEIT WILL ER, DASS ICH NOCH BEIM HAUS BLEIBE, BIS ICH MICH WIEDER RICHTIG ERHOLT HABE. EIGENTLICH GLAUBE ICH ABER, DASS ER MICH WEGEN SILBERHAND'S BANDITEN NOCH NICHT NACH DRAUßEN LÄSST.\""
#: AllTexts/NPC_texts.amb/013/002.txt
msgctxt "AllTexts/NPC_texts.amb/013/002"
msgid "\"OH, HOW NICE, IT'S YOU! SIT DOWN, I AM VERY HAPPY TO SEE YOU!^ FATHER SAYS THAT I MAY SOON GO TO THE BEACH BUT AT THE MOMENT HE SAYS I SHOULD STAY AT HOME UNTIL I HAVE RECOVERED COMPLETELY. HOWEVER, I ACTUALLY BELIEVE HE DOES NOT WANT TO LET ME OUT BECAUSE OF SILVERHAND'S BANDITS.\""
msgstr ""

#. Dialogue of NPC 013 (SALLY).
#. German: "\"LEBT WOHL! ICH HOFFE, IHR BESUCHT MICH BALD WIEDER!\""
#: AllTexts/NPC_texts.amb/013/003.txt
msgctxt "AllTexts/NPC_texts.amb/013/003"
msgid "\"FAREWELL! I HOPE YOU WILL VISIT ME AGAIN SOON!\""
msgstr ""

#. Dialogue of NPC 013 (SALLY).
#. German: "\"ICH HABE GEHÖRT, SILBERHAND SOLL DER ANFÜHRER DER FREMDEN BANDITEN SEIN. DER NAME SOLL VON EINER PROTHESE STAMMEN, DIE ER STATT DER LINKEN HAND HAT. ES HEIßT, DAS ER EINMAL ÜBER DEN MARKT IN SPANNENBERG GEGANGEN IST UND DASS EIN WINDSTOß SEINEN UMHANG HOCHWEHTE. IN DIESEM AUGENBLICK HAT EINE DER MARKTFRAUEN GESEHEN, DASS SEINE LINKE HAND AUS PUREM SILBER IST. SEITDEM HEIßT ER NUR NOCH SILBERHAND. WIE ER RICHTIG HEIßT, WEISS MAN ÜBERHAUPT NICHT, GLAUBE ICH.\""
#: AllTexts/NPC_texts.amb/013/004.txt
msgctxt "AllTexts/NPC_texts.amb/013/004"
msgid "\"I HAVE HEARD THAT SILVERHAND IS THE LEADER OF THE STRANGE BANDITS. THE NAME WAS GIVEN TO HIM BECAUSE OF HIS ARTIFICIAL LEFT HAND. IT IS SAID THAT HE WAS ONCE WALKING OVER THE MARKETPLACE IN SPANNENBERG WHEN A GUST OF WIND LIFTED HIS CLOAK. AT THAT MOMENT ONE OF THE MARKET WOMEN SAW THAT HIS LEFT HAND WAS MADE OF PURE SILVER. SINCE THEN HIS ONLY NAME IS SILVERHAND. WHAT HIS REAL NAME IS, NO-ONE KNOWS, I BELIEVE.\""
msgstr ""

#. Dialogue of NPC 014 (CANTH).
#. German: "IHR SEHT EINE JUNGE FRAU. SIE TRÄGT EINE LANGE KÜCHENSCHÜRZE UND HEBT DROHEND EINEN GROßEN KARTOFFELSTAMPFER."
#: AllTexts/NPC_texts.amb/014/000.txt
msgctxt "AllTexts/NPC_texts.amb/014/000"
msgid "YOU SEE A YOUNG WOMAN. SHE IS WEARING A LONG KITCHEN APRON AND WAVES A LARGE POTATO PEELER AT YOU IN A THREATENING GESTURE."
msgstr ""

#. Dialogue of NPC 014 (CANTH).
#. German: "\"OH, ES TUT MIR LEID! ICH ICH HOFFE, ICH HABE EUCH NICHT ERSCHRECKT, DASS HEIßT, EIGENTLICH WAR ICH SELBST ERSCHROCKEN ALS ICH EUCH PLÖTZLICH SAH. SEITDEM DIE WEINPOKALE GESTOHLEN WURDEN, BIN ICH VIELLEICHT ETWAS ÜBERVORSICHTIG.\""
#: AllTexts/NPC_texts.amb/014/001.txt
msgctxt "AllTexts/NPC_texts.amb/014/001"
msgid "\"OH, I AM SORRY! I HOPE I DID NOT FRIGHTEN YOU. IN FACT I WAS FRIGHTENED MYSELF WHEN I SAW YOU. SINCE THE WINE GOBLETS WERE STOLEN, I HAVE BEEN RATHER NERVOUS.\""
msgstr ""

#. Dialogue of NPC 014 (CANTH).
#. German: "\"LEBT WOHL UND HÜTET EUCH VOR DEN BANDITEN!\""
#: AllTexts/NPC_texts.amb/014/002.txt
msgctxt "AllTexts/NPC_texts.amb/014/002"
msgid "\"FAREWELL AND WATCH OUT FOR THE BANDITS!\""
msgstr ""

#. Dialogue of NPC 014 (CANTH).
#. German: "\"VOR EIN PAAR WOCHEN HAT MAN EINEN UNSERER GOLDENEN WEINPOKALE GESTOHLEN. ICH HÖRTE NACHTS EIN GERÄUSCH IM ESSZIMMER UND BIN AUFGESTANDEN. ALS ICH DIE TÜR ZUM ESSZIMMER ÖFFNETE, KONNTE ICH GERADE NOCH EINE GRÜNLICHE ERSCHEINUNG MIT LANGEN FLÜGELN SEHEN, DIE DURCH EIN GEÖFFNETES FENSTER FORTFLOG. JAJA, SIE FLOG, ICH WOLLTE AUCH MEINEN AUGEN NICHT TRAUEN, ABER ES WAR SO.^ AM ANDEREN MORGEN STELLTE ICH DANN FEST, DASS EINER DER WEINPOKALE FEHLTE. IHR MÜSST WISSEN, DIE POKALE STAMMEN VON UNSERER HOCHZEIT, UND WIR HÄNGEN SEHR AN IHNEN.^ EIN PAAR TAGE DARAUF IST DANN AUCH DER ZWEITE GESTOHLEN WORDEN. DIESMAL HAT MEIN MANN DEN DIEB GEHÖRT. ER IST LEISE AUFGESTANDEN UND KONNTE IHN AUCH STELLEN. ABER LEIDER WAREN SIE ZU ZWEIT. DER ANDERE KAM PLÖTZLICH VON HINTEN UND HAT MEINEM MANN EINE DICKE BEULE VERPASST.^ MEIN MANN MEINT JETZT NATÜRLICH, DASS AUCH DER ERSTE POKAL VON DIESEN BANDITEN GESTOHLEN WORDEN SEIN MUSS. ER SAGT, DA SIE BEIM ERSTEN EINBRUCH VON MIR VERTRIEBEN WURDEN, SIND SIE EINFACH EIN PAAR TAGE SPÄTER ERNEUT EINGESTIEGEN. DIE GRÜNE GESTALT, DIE ICH GESEHEN HABE, HÄLT ER FÜR EIN TYPISCH WEIBLICHES PHANTASIEPRODUKT. ABER WAS IMMER MEIN GELIEBTER EHEMANN AUCH SAGT, ICH BIN MIR GANZ SICHER, DASS ES EIN GEFLÜGELTES WESEN WAR, DAS DEN ERSTEN POKAL GESTOHLEN HAT.\""
#: AllTexts/NPC_texts.amb/014/003.txt
msgctxt "AllTexts/NPC_texts.amb/014/003"
msgid "\"A FEW WEEKS AGO THEY STOLE ONE OF OUR GOLDEN WINE GOBLETS. I HEARD A NOISE AT NIGHT IN THE DINING ROOM AND GOT UP. AS I OPENED THE DOOR TO THE DINING ROOM, I JUST SAW A GREEN FIGURE WITH LONG WINGS FLYING OFF THROUGH AN OPEN WINDOW. YES, YES, IT WAS FLYING. I DID NOT WANT TO BELIEVE MY EYES, BUT THAT WAS WHAT I SAW.^ THE NEXT MORNING I FOUND THAT ONE OF THE WINE GOBLETS WAS MISSING. I MUST TELL YOU WE HAD HAD THEM SINCE OUR WEDDING AND WERE VERY ATTACHED TO THEM.^ A FEW DAYS LATER THE SECOND ONE WAS ALSO STOLEN. THIS TIME MY HUSBAND HEARD THE THIEF. HE GOT UP QUIETLY AND WAS ABLE TO CHALLENGE HIM. BUT UNFORTUNATELY, THERE WERE TWO OF THEM. THE OTHER ONE ATTACKED MY HUSBAND FROM BEHIND AND BRUISED HIM BADLY.^ MY HUSBAND NOW NATURALLY BELIEVES THAT THE FIRST WINE GOBLET MUST ALSO HAVE BEEN STOLEN BY THESE BANDITS. HE SAYS THEY WERE DISTURBED ON THE FIRST OCCASION WHEN I CAME DOWNSTAIRS, AND SIMPLY CAME BACK A FEW DAYS LATER. HE BELIEVES THE GREEN FIGURE I SAW WAS SIMPLY A WOMAN'S IMAGINATION AT PLAY. BUT WHATEVER MY BELOVED HUSBAND SAYS, I AM QUITE CERTAIN THAT IT WAS A WINGED BEING THAT STOLE THE FIRST WINE GOBLET.\""
msgstr ""

#. Dialogue of NPC 014 (CANTH).
#. German: "\"ACH, IST ES ZU GLAUBEN? IHR HABT TATSÄCHLICH EINEN DER POKALE GEFUNDEN! BITTE, GEBT IHN MIR ODER BESSER: BRINGT IHN MEINEM MANN! ICH BIN SICHER, ER WIRD EUCH DAFÜR BELOHNEN.\""
#: AllTexts/NPC_texts.amb/014/004.txt
msgctxt "AllTexts/NPC_texts.amb/014/004"
msgid "\"AH, WOULD YOU BELIEVE IT? YOU ACTUALLY FOUND ONE OF THE WINE GOBLETS! PLEASE GIVE IT TO ME, OR BETTER STILL, TAKE IT TO MY HUSBAND! I AM SURE HE WILL REWARD YOU.\""
msgstr ""

#. Dialogue of NPC 014 (CANTH).
#. German: "\"SEID VIELMALS BEDANKT! DARF ICH EUCH ALS BELOHNUNG DIESE BROSCHE GEBEN? SIE IST NICHT OHNE WERT, UND ICH HABE SIE VON MEINER SCHWIEGERMUTTER, ABER EHRLICH GESAGT, SIE STEHT MIR NICHT BESONDERS.\""
#: AllTexts/NPC_texts.amb/014/005.txt
msgctxt "AllTexts/NPC_texts.amb/014/005"
msgid "\"MANY, MANY THANKS! AS A REWARD, MAY I GIVE YOU THIS BROOCH? IT IS QUITE VALUABLE. I HAVE IT FROM MY MOTHER-IN-LAW, BUT, TO BE HONEST, I DO NOT LIKE IT VERY MUCH.\""
msgstr ""

#. Dialogue of NPC 014 (CANTH).
#. German: "\"IHR HABT AUCH DEN ZWEITEN POKAL, DAS IST JA WUNDERBAR! ABER VIELEICHT BRINGT IHR IHN BESSER ZU MEINEM MANN, DENN ICH HABE LEIDER NICHTS MEHR, MIT DEM ICH EUCH BELOHNEN KÖNNTE.\""
#: AllTexts/NPC_texts.amb/014/006.txt
msgctxt "AllTexts/NPC_texts.amb/014/006"
msgid "\"YOU ALSO HAVE THE OTHER WINE GOBLET! THAT IS FABULOUS! BUT PERHAPS YOU SHOULD TAKE IT TO MY HUSBAND BECAUSE I HAVE NOTHING LEFT WITH WHICH I COULD REWARD YOU.\""
msgstr ""

#. Dialogue of NPC 015 (NORLAEL).
#. German: "IHR SEHT EINEN MANN UM DIE DREIßIG, DER NERVÖS MIT EINEM KÜCHENMESSER SPIELT. ER HAT EINEN DICKEN VERBAND AM KOPF UND SCHAUT EUCH GRIMMIG UND MISSTRAUISCH AN."
#: AllTexts/NPC_texts.amb/015/000.txt
msgctxt "AllTexts/NPC_texts.amb/015/000"
msgid "YOU SEE A MAN OF AROUND THIRTY YEARS OF AGE. HE IS PLAYING NERVOUSLY WITH A KITCHEN KNIFE. HE HAS A THICK BANDAGE AROUND HIS HEAD AND LOOKS AT YOU GRIMLY AND MISTRUSTFULLY."
msgstr ""

#. Dialogue of NPC 015 (NORLAEL).
#. German: "\"WAS WOLLT IHR HIER? GEHT MIR AUS DEN AUGEN, IHR SEHT DOCH, DASS ICH SCHLECHTE LAUNE HABE!\""
#: AllTexts/NPC_texts.amb/015/001.txt
msgctxt "AllTexts/NPC_texts.amb/015/001"
msgid "\"WHAT DO YOU WANT HERE? GO AWAY, YOU CAN SEE THAT I AM IN A BAD MOOD!\""
msgstr ""

#. Dialogue of NPC 015 (NORLAEL).
#. German: "\"NICHTS FÜR UNGUT, WIR GEHN JA SCHON.\""
#: AllTexts/NPC_texts.amb/015/002.txt
msgctxt "AllTexts/NPC_texts.amb/015/002"
msgid "\"NO OFFENCE, WE ARE ALREADY LEAVING.\""
msgstr ""

#. Dialogue of NPC 015 (NORLAEL).
#. German: "\"WIE ICH HÖRE, HAT MEINE FRAU EUCH IHRE VERSION VON DEM DIEBSTAHL ERZÄHLT. SIE GLAUBT FELSENFEST, DASS DER ERSTE POKAL VON EINEM KOBOLD ODER SO WAS GESTOHLEN WURDE, ABER DAS IST QUATSCH! ICH HABE BEIM ZWEITEN EINBRUCH SCHLIEßLICH DEN DIEB ÜBERRASCHT, UND DAS WAR ALLES ANDERE ALS EIN KOBOLD. ZUMINDEST DERJENIGE, DEN ICH SEHEN KONNTE, DER ANDERE KAM JA VON HINTEN.\""
#: AllTexts/NPC_texts.amb/015/003.txt
msgctxt "AllTexts/NPC_texts.amb/015/003"
msgid "\"AS I HEAR, MY WIFE TOLD YOU HER VERSION OF THE THEFT. SHE BELIEVES FIRMLY THAT THE FIRST WINE GOBLET WAS STOLEN BY A KOBOLD OR SOMETHING SIMILAR, BUT THAT IS RUBBISH! I SURPRISED THE THIEVES DURING THEIR SECOND BURGLARY AND THEY WERE NOTHING LIKE KOBOLDS. AT LEAST THE ONE I SAW. THE OTHER CAME FROM BEHIND ME, OF COURSE.\""
msgstr ""

#. Dialogue of NPC 015 (NORLAEL).
#. German: "\"JA, DAS IST EINER DER POKALE, DIE WIR ZUR HOCHZEIT BEKAMEN. GEBT IHN MIR BITTE, DAS HEIßT, IHR KÖNNT IHN AUCH ERST MEINER FRAU ZEIGEN, WENN IHR WOLLT.\""
#: AllTexts/NPC_texts.amb/015/004.txt
msgctxt "AllTexts/NPC_texts.amb/015/004"
msgid "\"YES, THAT IS ONE OF THE GOBLETS WHICH WE WERE GIVEN AS A WEDDING PRESENT. PLEASE GIVE IT TO ME, OR RATHER SHOW IT FIRST TO MY WIFE, IF YOU PREFER.\""
msgstr ""

#. Dialogue of NPC 015 (NORLAEL).
#. German: "\"VIELEN DANK! HIER, IHR HABT EUCH EINE BELOHNUNG VERDIENT.\"^ ER ZIEHT EINEN KLEINEN BEUTEL MIT GOLD HERVOR UND GIBT IHN EUCH."
#: AllTexts/NPC_texts.amb/015/005.txt
msgctxt "AllTexts/NPC_texts.amb/015/005"
msgid "\"MANY THANKS! HERE, YOU HAVE EARNED A REWARD.\"^ HE PULLS OUT A SMALL BAG OF GOLD AND GIVES IT TO YOU."
msgstr ""

#. Dialogue of NPC 015 (NORLAEL).
#. German: "\"VIELLEICHT IST ES BESSER, WENN IHR DIESEN POKAL MEINER FRAU GEBT, DENN ICH HABE GERADE NICHTS HIER, MIT DEM ICH EUCH BELOHNEN KÖNNTE.\""
#: AllTexts/NPC_texts.amb/015/006.txt
msgctxt "AllTexts/NPC_texts.amb/015/006"
msgid "\"PERHAPS IT WOULD BE BETTER IF YOU GAVE THIS GOBLET TO MY WIFE, FOR I HAVE NOTHING HERE WITH WHICH TO REWARD YOU.\""
msgstr ""

#. Dialogue of NPC 016 (NAGIER).
#. German: "IHR SEHT EINEN ALTEN MANN VOR EUCH, DER ABER GANZ UND GAR NICHT DEN EINDRUCK MACHT, SCHWACH UND GEBRECHLICH ZU SEIN. IM GEGENTEIL, ER BEWEGT SICH MIT GROßER GESCHMEIDIGKEIT."
#: AllTexts/NPC_texts.amb/016/000.txt
msgctxt "AllTexts/NPC_texts.amb/016/000"
msgid "YOU SEE AN OLD MAN AHEAD BUT HE DOES NOT GIVE THE IMPRESSION OF BEING WEAK AND FRAGILE. ON THE CONTRARY, HE MOVES WITH GREAT AGILITY."
msgstr ""

#. Dialogue of NPC 016 (NAGIER).
#. German: "\"ICH DANKE EUCH NOCHMALS, DASS IHR AUF MEINEN VORSCHLAG EINGEGANGEN SEID. BITTE BRINGT DIESEN BRIEF ZUM FREIHERR GEORG NACH SPANNENBERG. ICH HOFFE, DASS AUCH ER AUF MEIN ANGEBOT EINGEHT.^ UND BEVOR ICH ES VERGESSE: BITTE NEHMT DIESEN SCHLÜSSEL! ER PASST ZU DER TRUHE IN MEINEM SCHLAFRAUM. IHR FINDET DARIN GESTOHLENE GEGENSTÄNDE AUS SPANNENBERG. GEBT SIE BITTE IHREN RECHTMÄßIGEN BESITZERN ZURÜCK.\""
#: AllTexts/NPC_texts.amb/016/001.txt
msgctxt "AllTexts/NPC_texts.amb/016/001"
msgid "\"THANK YOU AGAIN FOR ACCEPTING MY PROPOSAL. PLEASE TAKE THIS LETTER TO BARON GEORGE OF SPANNENBERG. I HOPE HE WILL ALSO ACCEPT MY OFFER.^ AND BEFORE I FORGET: PLEASE TAKE THIS KEY! IT FITS THE CHEST IN MY BEDROOM. YOU'LL FIND SOME STOLEN ITEMS FROM SPANNENBERG IN THE CHEST. PLEASE RETURN THEM TO THEIR RIGHTFUL OWNERS.\""
msgstr ""

#. Dialogue of NPC 016 (NAGIER).
#. German: "\"WILLKOMMEN IN MEINER BESCHEIDENEN BEHAUSUNG! FALLS IHR ZUM TRAINIEREN GEKOMMEN SEID, DANN GEHT DOCH SCHON EINMAL IN DEN ÜBUNGSRAUM. ICH SCHICKE EUCH SOFORT EINEN TRAINER.\""
#: AllTexts/NPC_texts.amb/016/002.txt
msgctxt "AllTexts/NPC_texts.amb/016/002"
msgid "\"WELCOME TO MY MODEST HOME! IF YOU HAVE COME FOR TRAINING, PLEASE GO TO THE TRAINING ROOM. I WILL SEND A TRAINER TO YOU IMMEDIATELY.\""
msgstr ""

#. Dialogue of NPC 016 (NAGIER).
#. German: "\"VIEL GLÜCK AUF EUREN WEGEN, UND MÖGET IHR IMMER GUTGEFÜLLTE SCHATZTRUHEN FINDEN!\""
#: AllTexts/NPC_texts.amb/016/003.txt
msgctxt "AllTexts/NPC_texts.amb/016/003"
msgid "\"GOOD LUCK ON YOUR TRAVELS AND MAY YOU ALWAYS FIND CHESTS FULL OF TREASURE!\""
msgstr ""

#. Dialogue of NPC 017 (SARIEL).
#. German: "VOR EUCH STEHT EINE JUNGE FRAU MIT BLAUER HAUT UND LANGEN SCHIMMERNDEN FLÜGELN. SIE ZITTERT VOR ANGST UND STARRT EUCH MIT GROßEN AUGEN AN."
#: AllTexts/NPC_texts.amb/017/000.txt
msgctxt "AllTexts/NPC_texts.amb/017/000"
msgid "BEFORE YOU STANDS A YOUNG WOMAN WITH BLUE SKIN AND LONG SHIMMERING WINGS. SHE TREMBLES IN FEAR AND STARES AT YOU WITH WIDE EYES."
msgstr ""

#. Dialogue of NPC 017 (SARIEL).
#. German: "\"BITTE, TUT MIR NICHTS! ICH BIN SARIEL VON DER RASSE DER SYLPHEN. ICH BIN HIERGEBLIEBEN, WEIL ICH HILFE FÜR MEINE SCHWESTER BRAUCHE. HOFFENTLICH WAR DAS KEIN FEHLER, ABER IHR KAMT MIR NICHT WIE UNHOLDE VOR.\""
#: AllTexts/NPC_texts.amb/017/001.txt
msgctxt "AllTexts/NPC_texts.amb/017/001"
msgid "\"PLEASE, DO NOT HURT ME! I AM SARIEL FROM THE SYLPH PEOPLE. I STAYED HERE BECAUSE I NEED HELP FOR MY SISTER. HOPEFULLY THAT WAS NOT A MISTAKE, BUT YOU DO NOT LOOK LIKE DEVILS.\""
msgstr ""

#. Dialogue of NPC 017 (SARIEL).
#. German: "\"LEBT WOHL UND PASST AUF, DASS EUCH DIE ORKS NICHT ERWISCHEN!\""
#: AllTexts/NPC_texts.amb/017/002.txt
msgctxt "AllTexts/NPC_texts.amb/017/002"
msgid "\"FAREWELL AND MIND THE ORCS DO NOT GET YOU!\""
msgstr ""

#. Dialogue of NPC 017 (SARIEL).
#. German: "\"ICH BETE DARUM, DASS IHR MEINE SCHWESTER RETTEN KÖNNT.\"^ SIE BEWEGT IHRE FLÜGEL SCHNELL WIE EIN KOLIBRI, WODURCH EIN RÖTLICHER SCHIMMER UM SIE ERSCHEINT. DANN GLÜHT DIESER SCHIMMER EINEN MOMENT LANG GRELL AUF, UND ALS ER VERSCHWUNDEN IST, IST AUCH DIE SYLPHE FORT."
#: AllTexts/NPC_texts.amb/017/003.txt
msgctxt "AllTexts/NPC_texts.amb/017/003"
msgid "\"I PRAY THAT YOU CAN SAVE MY SISTER.\"^ SHE FLAPS HER WINGS RAPIDLY AND A RED SHIMMERING LIGHT APPEARS AROUND HER. THEN THE SHIMMERING LIGHT FLASHES BRIGHTLY FOR A MOMENT AND JUST AS IT DISAPPEARS, THE SYLPH IS GONE."
msgstr ""

#. Dialogue of NPC 017 (SARIEL).
#. German: "\"UM ZU VERSTEHEN, WO WIR HERKOMMEN, MÜSST IHR WISSEN, DASS ES AN DER STELLE, AN DER LYRAMION EXISTIERT, NOCH UNENDLICH VIELE ANDERE WELTEN IN ANDEREN EBENEN GIBT. SIE SIND NUR DURCH DÜNNE BARRIEREN VONEINANDER GETRENNT.^ WIR HABEN HERAUSGEFUNDEN, DASS WIR MIT DER MAGIE UNSERER FLÜGEL DIESE BARRIEREN ÜBERWINDEN KÖNNEN UND BESUCHEN NATÜRLICH DIE ANDEREN WELTEN. EURE GEFÄLLT UNS WEGEN DER VIELEN GLITZERNDEN DINGE, DIE ES HIER GIBT, DENN WIR LIEBEN ALLES WAS FUNKELT UND BLITZT. DOCH NUN IST MEINE SCHWESTER VON DIESEN SCHRECKLICHEN MONSTERN GEFANGEN WORDEN, UND WIR HABEN JETZT GROßE ANGST VOR EURER WELT.\""
#: AllTexts/NPC_texts.amb/017/004.txt
msgctxt "AllTexts/NPC_texts.amb/017/004"
msgid "\"TO UNDERSTAND WHERE WE COME FROM YOU MUST KNOW THAT AT THE SAME POINT WHERE LYRAMION EXISTS, THERE ARE AN INFINITE NUMBER OF OTHER WORLDS ON OTHER LEVELS. THEY ARE ONLY SEPARATED FROM EACH OTHER BY THIN BARRIERS.^ WE DISCOVERED THAT WE CAN OVERCOME THESE BARRIERS WITH THE MAGIC IN OUR WINGS, AND CAN NATURALLY VISIT THE OTHER WORLDS. YOUR WORLD APPEALS TO US BECAUSE OF THE MANY SHINY THINGS THERE ARE HERE, FOR WE LOVE ANYTHING WHICH SHINES AND SHIMMERS. BUT MY SISTER WAS CAPTURED BY THESE HORRIBLE MONSTERS AND WE ARE NOW VERY MUCH AFRAID OF YOUR WORLD.\""
msgstr ""

#. Dialogue of NPC 017 (SARIEL).
#. German: "\"MEINE SCHWESTER HEIßT SELENA. DIE MONSTER, DIE IHR ORKS NENNT, HABEN SIE ÜBERRASCHT UND IHR DIE FLÜGEL GEBROCHEN. WENN ICH STÄRKER WÄRE UND MIT WAFFEN UMGEHEN KÖNNTE, WÜRDE ICH SOFORT IN DIE ORKHÖHLEN GEHEN UND SIE BEFREIEN. ICH HOFFE NUR, DASS SIE ÜBERHAUPT NOCH LEBT!^ IHR SEID DOCH STARKE KRIEGER, KÖNNT IHR NICHT VERSUCHEN, SIE ZU RETTEN? ICH BRINGE EUCH AUCH UNSERE SPRACHE BEI, DENN SELENA VERSTEHT EURE SPRACHE SO GUT WIE GAR NICHT. KOMMT, ES GEHT GANZ EINFACH!\"^ NACHEINANDER LEGT SIE JEDEM VON EUCH IHRE HÄNDE AN DIE SCHLÄFEN UND SCHLIEßT DABEI KONZENTRIERT DIE AUGEN. DANN SAGT SIE AUF SYLPHISCH-UND ZU EURER ÜBERRASCHUNG VERSTEHT IHR JEDES WORT:^ \"ACH JA, BEVOR ICH ES VERGESSE: DIE ORKS HABEN GLEICH HINTER DEM EINGANG IHRER HÖHLE EINEN STEINERNEN KOPF IN DER WAND, DER OFFENBAR SO ETWAS WIE EIN TORWÄCHTER IST. ER SCHEINT SPRECHEN ZU KÖNNEN, ALLERDINGS KONNTE ICH NICHT VERSTEHEN, WAS ER GESAGT ODER GEFRAGT HAT. EINER DER ORKS HAT JEDENFALLS LAUT >OKNARD< GESAGT, BEVOR ALLE IN DER HÖHLE VERSCHWANDEN.\""
#: AllTexts/NPC_texts.amb/017/005.txt
msgctxt "AllTexts/NPC_texts.amb/017/005"
msgid "\"MY SISTER'S NAME IS SELENA. THE MONSTERS THAT YOU CALL ORCS SURPRISED HER AND BROKE HER WINGS. IF I WERE STRONGER AND COULD HANDLE WEAPONS I WOULD IMMEDIATELY GO INTO THE ORC CAVES AND FREE HER. I HOPE JUST THAT SHE IS STILL ALIVE!^ BUT YOU ARE STRONG WARRIORS, COULD YOU NOT TRY TO SAVE HER? I WILL ALSO TEACH YOU OUR LANGUAGE BECAUSE SELENA UNDERSTANDS ALMOST NOTHING OF YOUR LANGUAGE. COME, IT IS VERY EASY!\"^ SHE PLACES HER HANDS ON YOUR FOREHEADS, ONE AFTER THE OTHER, THEN CLOSES HER EYES AND CONCENTRATES. FINALLY, SHE SAYS IN THE SYLPHIAN LANGUAGE - AND TO YOUR SURPRISE YOU UNDERSTAND EVERY WORD:^ \"OH YES, BEFORE I FORGET: DIRECTLY BEHIND THE ENTRANCE TO THEIR CAVE THE ORCS HAVE A STONE HEAD IN THE WALL WHICH IS APPARENTLY GUARDING THE ENTRANCE. IT SEEMS TO BE ABLE TO SPEAK BUT I COULD NOT UNDERSTAND WHAT IT SAID OR ASKED. ONE OF THE ORCS CERTAINLY SAID >OKNARD<, BEFORE THEY ALL DISAPPEARED IN THE CAVE.\""
msgstr ""

#. Dialogue of NPC 018 (ALKEM).
#. German: "IHR SEHT EINEN ALTEN MANN MIT EINEM RUNENVERZIERTEN STOCK. ER SCHAUT EUCH LEICHT GEREIZT AN."
#: AllTexts/NPC_texts.amb/018/000.txt
msgctxt "AllTexts/NPC_texts.amb/018/000"
msgid "YOU SEE AN OLD MAN WITH A STICK DECORATED WITH RUNES. HE LOOKS AT YOU IN A SLIGHTLY AGITATED MANNER."
msgstr ""

#. Dialogue of NPC 018 (ALKEM).
#. German: "\"TUT MIR LEID, ABER SOLANGE ICH MEINEN RING NICHT WIEDERHABE, BLEIBEN BIBLIOTHEK UND LADEN GESCHLOSSEN.\""
#: AllTexts/NPC_texts.amb/018/001.txt
msgctxt "AllTexts/NPC_texts.amb/018/001"
msgid "\"I AM SORRY, BUT UNTIL I HAVE MY RING BACK, THE LIBRARY AND THE SHOP WILL REMAIN CLOSED.\""
msgstr ""

#. Dialogue of NPC 018 (ALKEM).
#. German: "\"HALLO, IHR JUNGEN HELDEN, SCHÖN EUCH ZU SEHEN! NOCHMALS VIELEN DANK, DASS IHR MIR MEINEN RING WIEDER HERBEIGESCHAFFT HABT, JETZT BIN ICH SOZUSAGEN WIEDER KOMPLETT.\""
#: AllTexts/NPC_texts.amb/018/002.txt
msgctxt "AllTexts/NPC_texts.amb/018/002"
msgid "\"HELLO, YOU YOUNG HEROES, IT IS NICE TO SEE YOU! THANK YOU AGAIN FOR RETURNING MY RING TO ME. I NOW FEEL COMPLETE AGAIN.\""
msgstr ""

#. Dialogue of NPC 018 (ALKEM).
#. German: "\"FALLS IHR ZUFÄLLIG AUF MEINEN RING STOßT, DANN BRINGT IHN MIR DOCH BITTE ZURÜCK. ICH FÜHLE MICH WIE AMPUTIERT OHNE IHN.\""
#: AllTexts/NPC_texts.amb/018/003.txt
msgctxt "AllTexts/NPC_texts.amb/018/003"
msgid "\"IF YOU FIND MY RING BY CHANCE, PLEASE BRING IT TO ME. I DO NOT FEEL WHOLE WITHOUT IT.\""
msgstr ""

#. Dialogue of NPC 018 (ALKEM).
#. German: "\"LEBT WOHL UND VERGESST NICHT: MEINE BIBLIOTHEK UND DER LADEN HABEN VON 8 BIS 20 UHR GEÖFFNET.\""
#: AllTexts/NPC_texts.amb/018/004.txt
msgctxt "AllTexts/NPC_texts.amb/018/004"
msgid "\"FAREWELL AND DO NOT FORGET: MY LIBRARY AND THE SHOP ARE OPEN FROM 8 AM TO 8 PM.\""
msgstr ""

#. Dialogue of NPC 018 (ALKEM).
#. German: "\"IN DER BIBLIOTHEK VERKAUFE ICH SPRUCHROLLEN DER ALCHEMIE. SIE HAT NORMALERWEISE VON 8 BIS 20 UHR GEÖFFNET.\""
#: AllTexts/NPC_texts.amb/018/005.txt
msgctxt "AllTexts/NPC_texts.amb/018/005"
msgid "\"IN THE LIBRARY I SELL MAGIC SCROLLS OF ALCHEMY. THE LIBRARY IS NORMALLY OPEN FROM 8 AM TO 8 PM.\""
msgstr ""

#. Dialogue of NPC 018 (ALKEM).
#. German: "\"IM LADEN KÖNNT IHR ALLE MÖGLICHEN TRÄNKE KAUFEN. ER IST VON 8 BIS 20 UHR AUF - JEDENFALLS WENN ICH MEINEN MAGISCHEN RING HABE.\""
#: AllTexts/NPC_texts.amb/018/006.txt
msgctxt "AllTexts/NPC_texts.amb/018/006"
msgid "\"YOU CAN BUY ALL KINDS OF DRINKS IN THE SHOP. IT IS OPEN FROM 8 AM TO 8 PM - AT LEAST WHEN I HAVE MY MAGIC RING.\""
msgstr ""

#. Dialogue of NPC 018 (ALKEM).
#. German: "\"MEIN UNERSETZLICHER ZAUBERRING IST MIR ABHANDEN GEKOMMEN. OHNE IHN KANN ICH WEDER SPRUCHROLLEN SCHREIBEN NOCH TRÄNKE ZUBEREITEN.^ VOR EIN PAAR WOCHEN WAR ICH AUF DER SUCHE NACH SELTENEN REAGENZIEN. DABEI BEGING ICH DEN FEHLER, IN DIE VERFALLENE KRYPTA ÖSTLICH VON HIER EINZUDRINGEN. ICH DACHTE, DASS ICH DORT EIN PAAR SELTENE PILZARTEN FINDEN KÖNNTE, DOCH LEIDER BIN ICH ZU UNVORSICHTIG GEWESEN. ICH HABE VERSEHENTLICH UNTOTE AUFGEWECKT, UND AUF DER FLUCHT GING DANN IRGENDWIE MEIN RING VERLOREN.^ IHR SEHT AUS WIE MÄNNER, DIE SICH TRAUEN, NACH IHM ZU SUCHEN, HABE ICH RECHT? KOMMT, SAGT JA - HIER IST DER SCHLÜSSEL ZUR KRYPTA.\""
#: AllTexts/NPC_texts.amb/018/007.txt
msgctxt "AllTexts/NPC_texts.amb/018/007"
msgid "\"I HAVE LOST MY IRREPLACEABLE MAGIC RING. WITHOUT IT I CAN NEITHER WRITE MAGIC SCROLLS OR PREPARE DRINKS.^ A FEW WEEKS AGO I WAS SEARCHING FOR STRANGE REAGENTS. I MADE THE MISTAKE OF ENTERING THE PARTLY-COLLAPSED CRYPT TO THE EAST OF HERE. I THOUGHT I COULD FIND A FEW STRANGE TYPES OF MUSHROOMS THERE BUT UNFORTUNATELY I WAS NOT CAREFUL ENOUGH. I ACCIDENTALLY WOKE THE UNDEAD AND I LOST MY RING SOMEHOW WHEN I WAS RUNNING AWAY.^ YOU LOOK LIKE MEN WHO COULD FIND IT, AM I RIGHT? COME ON, SAY YES - HERE IS THE KEY TO THE CRYPT.\""
msgstr ""

#. Dialogue of NPC 018 (ALKEM).
#. German: "\"WENN IHR EINEN INTERESSANTEN MANN KENNENLERNEN WOLLT, DANN GEHT DOCH MAL ZU MEINEM GÄSTEZIMMER. ICH HABE ZUR ZEIT EINEN MAGIER ZU BESUCH, DER, WENN ICH IHN RECHT VERSTANDEN HABE, EINE GRUPPE SUCHT, DER ER SICH ANSCHLIEßEN KANN. SICHERLICH KANN ER EUCH AUCH IN DER KRYPTA ZUR SEITE STEHEN.\""
#: AllTexts/NPC_texts.amb/018/008.txt
msgctxt "AllTexts/NPC_texts.amb/018/008"
msgid "\"IF YOU WANT TO GET TO KNOW AN INTERESTING MAN, GO TO MY ROOM. AT THE MOMENT I HAVE A MAGICIAN VISITING ME. IF I UNDERSTAND CORRECTLY, HE IS LOOKING FOR A GROUP HE CAN JOIN. HE CAN CERTAINLY HELP YOU IN THE CRYPT.\""
msgstr ""

#. Dialogue of NPC 018 (ALKEM).
#. German: "\"DEN SCHLÜSSEL ZU KYRPTA HABE ICH EUCH GEGEBEN. BITTE VERSUCHT, MEINEN RING ZU FINDEN!\""
#: AllTexts/NPC_texts.amb/018/009.txt
msgctxt "AllTexts/NPC_texts.amb/018/009"
msgid "\"I GAVE YOU THE KEY TO THE CRYPT. PLEASE TRY TO FIND MY RING!\""
msgstr ""

#. Dialogue of NPC 018 (ALKEM).
#. German: "\"IHR HABT MEINEN RING GEFUNDEN! WIE WUNDERVOLL! BITTE, GEBT IHN MIR ZURÜCK.\""
#: AllTexts/NPC_texts.amb/018/010.txt
msgctxt "AllTexts/NPC_texts.amb/018/010"
msgid "\"YOU HAVE FOUND MY RING! HOW WONDERFUL! PLEASE, GIVE IT BACK TO ME.\""
msgstr ""

#. Dialogue of NPC 018 (ALKEM).
#. German: "\"ICH DANKE EUCH SEHR! JETZT KANN ICH ENDLICH WIEDER MEINEM BERUF NACHGEHEN. ZUM DANK SOLLT IHR ETWAS BESONDERES BEKOMMEN!\"^ ER HEBT SEINEN STAB UND SCHWENKT IHN ÜBER EUREN KÖPFEN, WORAUF EIN GLITZERNDER STAUB ÜBER EUCH RIESELT. IHR HABT DAS SELTSAME EMPFINDEN, DASS IHR PLÖTZLICH IN DER LAGE SEID, NEUE FÄHIGKEITEN ZU LERNEN."
#: AllTexts/NPC_texts.amb/018/011.txt
msgctxt "AllTexts/NPC_texts.amb/018/011"
msgid "\"MANY, MANY THANKS! AT LAST I CAN CONTINUE MY WORK. LET ME GIVE YOU SOMETHING SPECIAL IN THANKS!\"^ HE RAISES HIS STICK AND SWINGS IT ABOVE YOUR HEAD, WHEREUPON GLISTENING DUST RAINS DOWN ON YOU. YOU HAVE A STRANGE FEELING THAT YOU ARE SUDDENLY ABLE TO LEARN NEW SKILLS."
msgstr ""

#. Dialogue of NPC 019 (MICHAEL).
#. German: "IHR SEHT EINEN JUNGEN MANN, DER EINE NICKELBRILLE MIT KLEINEN RUNDEN GLÄSERN TRÄGT. ER HAT ETLICHE GROßE PERGAMENTROLLEN UNTER DEN ARMEN UND SCHAUT EUCH ABWESEND AN."
#: AllTexts/NPC_texts.amb/019/000.txt
msgctxt "AllTexts/NPC_texts.amb/019/000"
msgid "YOU SEE A YOUNG MAN WEARING SPECTACLES WITH SMALL ROUND LENSES. HE HAS MANY LARGE ROLLS OF PARCHMENT IN HIS ARMS AND LOOKS AT YOU ABSENTLY. ␀ X"
msgstr ""

#. Dialogue of NPC 019 (MICHAEL).
#. German: "\"HALLO LEUTE! MEIN NAME IST MICHAEL HELLMICH. INTERESSIERT IHR EUCH FÜR KARTOGRAPHIE?\""
#: AllTexts/NPC_texts.amb/019/001.txt
msgctxt "AllTexts/NPC_texts.amb/019/001"
msgid "\"HELLO, PEOPLE! MY NAME IS MICHAEL HELLMICH. ARE YOU INTERESTED IN CARTOGRAPHY?\""
msgstr ""

#. Dialogue of NPC 019 (MICHAEL).
#. German: "\"MACHTS GUT, UND FALLS IHR EINE NEUE INSEL ODER SOWAS ENTDECKT, DANN WÄRE ICH EUCH DANKBAR, WENN IHR MIR DAVON BERICHTEN WÜRDET.\""
#: AllTexts/NPC_texts.amb/019/002.txt
msgctxt "AllTexts/NPC_texts.amb/019/002"
msgid "\"FAREWELL, AND IF YOU DISCOVER A NEW ISLAND OR SOMETHING SIMILAR I WOULD BE GRATEFUL IF YOU WOULD TELL ME ABOUT IT.\""
msgstr ""

#. Dialogue of NPC 019 (MICHAEL).
#. German: "\"ICH ZEICHNE KARTEN VON LYRAMION. ES WIRD ZEIT, DASS ENDLICH WIEDER EIN VERNÜFTIGER ATLAS VON LYRAMION ENTSTEHT. DESHALB SAMMLE ICH SEIT JAHREN INFORMATIONEN VON REISENDEN UND SEEFAHRERN.^ GERADE VOR EIN PAAR TAGEN HABE ICH DIE KARTE DER LYRAMIONISCHEN INSELN VOLLENDET, UND DIES HIER SIND DIE ERSTEN GEDRUCKTEN EXEMPLARE. WENN IHR WOLLT, KÖNNT IHR GERNE EINS DAVON HABEN. ICH KANN ALLERDINGS NICHT GARANTIEREN, DASS DIE KARTE VÖLLIG KOMPLETT IST.\""
#: AllTexts/NPC_texts.amb/019/003.txt
msgctxt "AllTexts/NPC_texts.amb/019/003"
msgid "\"I DRAW MAPS OF LYRAMION. IT IS HIGH TIME WE HAD AN ACCURATE ATLAS OF LYRAMION AGAIN. SO FOR YEARS I HAVE BEEN COLLECTING INFORMATION FROM TRAVELLERS AND SEAFARERS.^ JUST A FEW DAYS AGO I COMPLETED THE MAP OF THE LYRAMION ISLANDS AND HERE ARE THE FIRST FEW PRINTS. IF YOU LIKE, YOU CAN HAVE ONE. BUT I CANNOT GUARANTEE THAT THE MAP IS QUITE COMPLETE.\""
msgstr ""

#. Dialogue of NPC 019 (MICHAEL).
#. German: "\"ES TUT MIR WIRKLICH LEID, ABER DIE KARTEN SIND ALLE VERKAUFT, UND NEUE SIND NOCH NICHT FERTIG. FALLS IHR MEINE KARTE VERLOREN HABT, MÜSST IHR EUCH WOHL OHNE BEHELFEN.\""
#: AllTexts/NPC_texts.amb/019/004.txt
msgctxt "AllTexts/NPC_texts.amb/019/004"
msgid "\"I AM REALLY SORRY, BUT ALL THE MAPS HAVE BEEN SOLD AND THE NEW ONES ARE NOT READY YET. IF YOU HAVE LOST MY MAP, YOU WILL HAVE TO MANAGE WITHOUT IT.\""
msgstr ""

#. Dialogue of NPC 020 (DIETER).
#. German: "IHR SEHT EINEN DÜNNEN GROßEN MANN MIT VOLLBART. ER HAT EINEN TRIEFENDEN PINSEL IN DER HAND UND ZIEHT BEIM HINUNDHERGEHEN DAS LINKE BEIN NACH."
#: AllTexts/NPC_texts.amb/020/000.txt
msgctxt "AllTexts/NPC_texts.amb/020/000"
msgid "YOU SEE A TALL THIN MAN WITH A FULL BEARD. HE IS HOLDING A DRIPPING BRUSH IN HIS HAND AND DRAGS HIS LEFT LEG AFTER HIM AS WE WALKS BACK AND FORTH."
msgstr ""

#. Dialogue of NPC 020 (DIETER).
#. German: "\"WILLKOMMEN IN MEINEM BESCHEIDENEN ATELIER! MEIN NAME IST DIETER ROTTERMUND UND ICH BIN KUNSTMALER.\""
#: AllTexts/NPC_texts.amb/020/001.txt
msgctxt "AllTexts/NPC_texts.amb/020/001"
msgid "\"WELCOME TO MY MODEST STUDIO! MY NAME IS DIETER ROTTERMUND AND I AM AN ARTIST.\""
msgstr ""

#. Dialogue of NPC 020 (DIETER).
#. German: "\"VIEL GLÜCK AUF EUREN WEGEN! FALLS IHR EINMAL EINE BESONDERS HÜBSCHE SZENE ZU GESICHT BEKOMMT, DANN ERZÄHLT MIR DOCH BITTE DAVON.\""
#: AllTexts/NPC_texts.amb/020/002.txt
msgctxt "AllTexts/NPC_texts.amb/020/002"
msgid "\"GOOD LUCK ON YOUR TRAVELS! IF YOU DO SEE A PRETTY SIGHT, PLEASE TELL ME ABOUT IT.\""
msgstr ""

#. Dialogue of NPC 020 (DIETER).
#. German: "\"ICH MALE GROßE ÖLGEMÄLDE. VOR KURZER ZEIT HABE ICH EINE AUFTRAGSARBEIT FÜR DEN BARON VON NEWLAKE FERTIGGESTELLT. LEIDER HINDERT MICH MEINE BEINVERLETZUNG, DIE ICH MIR IM KERKER VON LUMINOR ZUGEZOGEN HABE, DARAN, DAS BILD SELBST NACH NEWLAKE ZU BRINGEN. DESHALB WÜRDE ICH EUCH GERNE UM DIESEN GEFALLEN BITTEN.^ HIER DIESES BILD IST ES. ES HEIßT >AMBERMOON<. GEBT ES EINFACH BEIM BARON AB; DAS MIT MEINER BEZAHLUNG IST SCHON GEREGELT. WIE ICH IHN EINSCHÄTZE, WIRD ER EUCH GROßZÜGIG BELOHNEN, WENN IHR IHM DAS BILD BRINGT.\""
#: AllTexts/NPC_texts.amb/020/003.txt
msgctxt "AllTexts/NPC_texts.amb/020/003"
msgid "\"I PAINT LARGE PICTURES IN OILS. A SHORT TIME AGO, I COMPLETED A COMMISSION FOR THE BARON OF NEWLAKE. UNFORTUNATELY THE LEG INJURY WHICH I SUFFERED IN LUMINOR'S PRISON IS STOPPING ME FROM TAKING THE PAINTING TO NEWLAKE MYSELF. SO I WOULD BE PLEASED IF YOU COULD DO ME THAT FAVOUR.^ HERE, THIS IS THE PICTURE. IT IS CALLED >AMBERMOON<. PLEASE JUST GIVE IT TO THE BARON. I HAVE ALREADY BEEN PAID FOR IT. I THINK HE WILL REWARD YOU GENEROUSLY WHEN YOU TAKE HIM THE PAINTING.\""
msgstr ""

#. Dialogue of NPC 020 (DIETER).
#. German: "\"ZUR ZEIT MALE ICH AN EINER SERIE VON BILDERN MIT DEN SCHÖNSTEN MOTIVEN LYRAMIONS.\""
#: AllTexts/NPC_texts.amb/020/004.txt
msgctxt "AllTexts/NPC_texts.amb/020/004"
msgid "\"AT THE MOMENT I AM PAINTING A SERIES OF PICTURES OF THE MOST BEAUTIFUL SIGHTS IN LYRAMION.\""
msgstr ""

#. Dialogue of NPC 021 (MILZOR).
#. German: "IHR SEHT EINEN KLEINEN DICKEN MANN VOR EUCH. ER TRÄGT EINE LANGE, MIT STERNEN ÜBERSÄTE ROBE UND HÄLT EIN STÜCK KREIDE IN DER HAND."
#: AllTexts/NPC_texts.amb/021/000.txt
msgctxt "AllTexts/NPC_texts.amb/021/000"
msgid "YOU SEE A SHORT FAT MAN AHEAD. HE IS WEARING A LONG ROBE DECORATED WITH STARS AND HAS A PIECE OF CHALK IN HIS HAND."
msgstr ""

#. Dialogue of NPC 021 (MILZOR).
#. German: "\"SAGT, WISST IHR ETWAS ÜBER MAGISCHE WÖRTER?\""
#: AllTexts/NPC_texts.amb/021/001.txt
msgctxt "AllTexts/NPC_texts.amb/021/001"
msgid "\"TELL ME, DO YOU KNOW ANYTHING ABOUT MAGIC WORDS?\""
msgstr ""

#. Dialogue of NPC 021 (MILZOR).
#. German: "\"FALLS IHR ETWAS ÜBER MAGISCHE WÖRTER HÖRT, DANN KOMMT DOCH BITTE WIEDER UND ERZÄHLT MIR DAVON!\""
#: AllTexts/NPC_texts.amb/021/002.txt
msgctxt "AllTexts/NPC_texts.amb/021/002"
msgid "\"IF YOU HEAR ANYTHING ABOUT MAGIC WORDS, PLEASE COME BACK AND TELL ME!\""
msgstr ""

#. Dialogue of NPC 021 (MILZOR).
#. German: "\"SEIT JAHREN SUCHE UND ERFORSCHE ICH MAGISCHE WÖRTER. ICH HABE BISHER IMMERHIN ZWEI STÜCK HERAUSGEFUNDEN. ABER LEIDER SCHEINEN SIE NUR VOR ETWA HUNDERT JAHREN WIRKSAM GEWESEN ZU SEIN.^ DAS EINE WAR >SCHNISM<. WENN MAN ES ANWENDETE, PASSIERTE ALLERDINGS NICHTS WEITER, ALS DAS EINE KÖRPERLOSE STIMME DUMME SPRÜCHE VON SICH GAB.^ WESENTLICH MACHTVOLLER MUSS >TEMPUS FUGIT< GEWESEN SEIN. WENN MAN DANACH NOCH >HELP< GERUFEN HAT, SOLL MAN ANGEBLICH FAST UNBEGRENZTE MACHT BESESSEN HABEN.^ AUCH IN UNSERER ZEIT SOLL ES WIEDER MAGISCHE WÖRTER DER MACHT GEBEN. ABER LEIDER WAR ES MIR NOCH NICHT VERGÖNNT, SIE HERAUSZUFINDEN. VIELLEICHT HABT IHR JA MEHR GLÜCK ALS ICH.^ FALLS IHR ÜBRIGENS INTERESSE AN MYSTIKER-SPRUCHROLLEN HABEN SOLLTET, DANN SUCHT DOCH MEINE BIBLIOTHEK AUF.\""
#: AllTexts/NPC_texts.amb/021/003.txt
msgctxt "AllTexts/NPC_texts.amb/021/003"
msgid "\"I HAVE BEEN RESEARCHING MAGICS WORD FOR MANY YEARS. I'VE FOUND TWO ALREADY BUT UNFORTUNATELY, THEY ONLY APPEAR TO HAVE BEEN EFFECTIVE ABOUT A HUNDRED YEARS AGO.^ THE FIRST ONE WAS >SCHNISM<. WHEN YOU USE IT, NOTHING HAPPENS EXCEPT FOR A DISEMBODIED VOICE SPEAKING WORDS WHICH DON'T MAKE SENSE.^ APPARENTLY >TEMPUS FUGIT< MUST HAVE BEEN MUCH MORE POWERFUL. IF AFTER SAYING THAT, YOU ALSO CALL >HELP<, APPARENTLY YOU HAVE ALMOST UNLIMITED POWERS.^ IT IS SAID THAT MAGIC WORDS WHICH GIVE YOU POWER ALSO EXIST IN OUR TIME. BUT UNFORTUNATELY I HAVE NOT BEEN ABLE TO FIND THEM. PERHAPS YOU WILL HAVE MORE LUCK THAN I.^ INCIDENTALLY, IF YOU ARE INTERESTED IN MYSTIC MAGIC SPELLS, PLEASE VISIT MY LIBRARY.\""
msgstr ""

#. Dialogue of NPC 021 (MILZOR).
#. German: "\"VOR UNGEFÄHR HUNDERT JAHREN SOLL ES EIN MÄCHTIGES MAGISCHES WORT GEWESEN SEIN.\""
#: AllTexts/NPC_texts.amb/021/004.txt
msgctxt "AllTexts/NPC_texts.amb/021/004"
msgid "\"IT IS SAID THAT APPROXIMATELY A HUNDRED YEARS AGO THIS WAS A POWERFUL MAGIC WORD.\""
msgstr ""

#. Dialogue of NPC 022 (THERESA).
#. German: "IHR SEHT EINE ÄLTERE FRAU, DIE EINEN EIGENARTIGEN, ABER SEHR PRAKTISCHEN BREITEN GÜRTEL TRÄGT. ER HAT ZAHLREICHE FÄCHER UND LASCHEN, IN DENEN DUTZENDE VON VERSCHIEDENARTIGEN WERKZEUGEN STECKEN."
#: AllTexts/NPC_texts.amb/022/000.txt
msgctxt "AllTexts/NPC_texts.amb/022/000"
msgid "YOU SEE AN OLDER WOMAN WEARING A STRANGE BUT VERY PRACTICAL WIDE BELT. IT HAS MANY POCKETS AND OPENINGS IN WHICH THERE ARE DOZENS OF DIFFERENT TYPES OF TOOLS."
msgstr ""

#. Dialogue of NPC 022 (THERESA).
#. German: "\"SEID WILLKOMMEN, FREMDE! ICH BIN THERESA GOLDSTEIN. HABT IHR VIELLEICHT INTERESSE AN BESONDEREN RINGEN ODER MÜSSEN IRGENDWELCHE EURER SCHMUCKSTÜCKE REPARIERT WERDEN?\""
#: AllTexts/NPC_texts.amb/022/001.txt
msgctxt "AllTexts/NPC_texts.amb/022/001"
msgid "\"WELCOME, STRANGERS! I AM THERESA. ARE YOU PERHAPS INTERESTED IN SPECIAL RINGS OR DO YOU NEED ANY OF YOUR JEWELLERY REPAIRED?\""
msgstr ""

#. Dialogue of NPC 022 (THERESA).
#. German: "\"LEBT WOHL.\""
#: AllTexts/NPC_texts.amb/022/002.txt
msgctxt "AllTexts/NPC_texts.amb/022/002"
msgid "\"FAREWELL! PLEASE COME AGAIN WHEN YOU ARE IN THE NEIGHBOURHOOD.\""
msgstr ""

#. Dialogue of NPC 022 (THERESA).
#. German: "\"ICH FERTIGE UNTER ANDEREM AUCH MAGISCHE RINGE AN. FALLS IHR INTERESSE AN SO ETWAS HABT, DANN KOMMT DOCH MAL IN MEINEM LADEN VORBEI.\""
#: AllTexts/NPC_texts.amb/022/003.txt
msgctxt "AllTexts/NPC_texts.amb/022/003"
msgid "\"AMONGST OTHER THINGS, I ALSO MAKE MAGIC RINGS. IF YOU ARE INTERESTED IN HAVING SOMETHING LIKE THAT, PLEASE COME TO MY SHOP.\""
msgstr ""

#. Dialogue of NPC 022 (THERESA).
#. German: "\"ICH KANN EUCH WOHL JEDES GEBROCHENE ODER SONSTWIE BESCHÄDIGTE SCHMUCKSTÜCK RICHTEN, SO DASS ES WIEDER WIE NEU AUSSIEHT.\""
#: AllTexts/NPC_texts.amb/022/004.txt
msgctxt "AllTexts/NPC_texts.amb/022/004"
msgid "\"I CAN PROBABLY REPAIR ANY BROKEN OR DAMAGED ITEM OF JEWELLERY FOR YOU SO THAT IT LOOKS AS GOOD AS NEW.\""
msgstr ""

#. Dialogue of NPC 022 (THERESA).
#. German: "\"OH, EIN SCHÖNES STÜCK! WENN IHR AUCH DIE ANDERE HÄLFTE HABT, DANN GEBT SIE MIR. ICH FÜGE DIE BEIDEN DANN WIEDER ZUSAMMEN.\""
#: AllTexts/NPC_texts.amb/022/005.txt
msgctxt "AllTexts/NPC_texts.amb/022/005"
msgid "\"OH, WHAT A BEAUTIFUL PIECE! IF YOU ALSO HAVE THE OTHER HALF, PLEASE GIVE IT TO ME. I WILL SOON JOIN THE TWO TOGETHER AGAIN.\""
msgstr ""

#. Dialogue of NPC 022 (THERESA).
#. German: "\"ES TUT MIR LEID, ABER ICH BRAUCHE SCHON BEIDE TEILE, UM DAS AMULETT WIEDERHERZUSTELLEN.\""
#: AllTexts/NPC_texts.amb/022/006.txt
msgctxt "AllTexts/NPC_texts.amb/022/006"
msgid "\"I AM SORRY BUT I NEED BOTH PARTS TO REPAIR THE AMULET.\""
msgstr ""

#. Dialogue of NPC 022 (THERESA).
#. German: "THERESA NIMMT BEIDE TEILE DES AMULETTS ENTGEGEN UND BEABEITET SIE AN IHREM WERKTISCH. ES DAUERT NICHT LANGE, DANN KOMMT SIE ZURÜCK UND GIBT EUCH DAS REPARIERTE AMULETT. MIT EINER MISCHUNG AUS ÄRGER UND ANGST IN DER STIMME SAGT SIE:^ \"DIESES AMULETT IST TEUFELSWERK! ICH WÜRDE NIE DEN NAMEN DES CHAOSGOTTES IN EIN AMULETT EINARBEITEN. LOS NEHMT ES, UND VERSCHWINDET SCHNELL AUS MEINER WERKSTATT!\""
#: AllTexts/NPC_texts.amb/022/007.txt
msgctxt "AllTexts/NPC_texts.amb/022/007"
msgid "THERESA TAKES BOTH PARTS OF THE AMULET AND WORKS ON THEM AT HER BENCH. IT DOES NOT TAKE LONG AND SHE RETURNS AND GIVES YOU THE REPAIRED AMULET AGAIN. WITH A MIXTURE OF ANNOYANCE AND FEAR IN HER VOICE SHE SAYS:^ \"THIS AMULET IS THE WORK OF THE DEVIL! I WOULD NEVER ENGRAVE THE NAME OF THE GOD OF CHAOS INTO A AMULET. TAKE IT, AND GO QUICKLY FROM MY WORKSHOP!\""
msgstr ""

#. Dialogue of NPC 022 (THERESA).
#. German: "\"BITTE NEHMT ES WEG, ICH WILL NICHTS DAMIT ZU TUN HABEN!\""
#: AllTexts/NPC_texts.amb/022/008.txt
msgctxt "AllTexts/NPC_texts.amb/022/008"
msgid "\"PLEASE TAKE IT AWAY, I DO NOT WANT ANYTHING TO DO WITH IT!\""
msgstr ""

#. Dialogue of NPC 023 (LEBAB).
#. German: "IHR SEHT EINEN MANN IN DER ROBE EINES MAGIERS. SEIN BLICK IST IN DIE FERNE GERICHTET, UND ER MACHT EINEN SEHR ZERSTREUTEN EINDRUCK."
#: AllTexts/NPC_texts.amb/023/000.txt
msgctxt "AllTexts/NPC_texts.amb/023/000"
msgid "YOU SEE A MAN WEARING THE ROBES OF A MAGICIAN. HE IS LOOKING INTO THE DISTANCE AND SEEMS VERY ABSENT-MINDED."
msgstr ""

#. Dialogue of NPC 023 (LEBAB).
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "\"UH, OH? BESUCHER? KUNDSCHAFT? WILLKOMMEN IN MEINEM TURM! EIN WUNDER, DASS IHR ZU MIR GELANGT SEID! IHR MÜSST WISSEN, DASS ICH ZUR ZEIT VON EINEM NEIDISCHEN MAGIER NAMES DREK BELAGERT WERDE.\"^ ~LEAD~ ERGREIFT DAS WORT UND BERICHTET:^ \"WERTER LEBAB, IHR BRAUCHT EUCH KEINE SORGEN MEHR ZU MACHEN! DREK IST TOT, UND DIE MEISTEN SEINER GARGYLEN SIND VERNICHTET.\"^ LEBAB BLICKT EINEN MOMENT LANG IRRITIERT AUF EUCH, SCHEINT SICH ABER RECHT SCHNELL AUF NEUE FAKTEN EINSTELLEN ZU KÖNNEN, DENN ER STELLT KEINE FRAGEN, SONDERN SAGT:^ \"OH JA, WIRKLICH SEHR INTERESSANT! DANN KANN ICH JA DEN EINGANG ZUM TELEPORTER IM ERSTEN GESCHOSS WIEDER FREILEGEN UND DIE STEINGOLEMS ABSCHALTEN.\""
#: AllTexts/NPC_texts.amb/023/001.txt
msgctxt "AllTexts/NPC_texts.amb/023/001"
msgid "\"UH, OH? VISITORS? CUSTOMERS? WELCOME TO MY TOWER! IT IS A WONDER THAT YOU REACHED ME! YOU SHOULD KNOW THAT AT THE MOMENT I AM HAVING TROUBLE WITH A JEALOUS MAGICIAN BY THE NAME OF DREK.\"^ ~LEAD~ STARTS TO SPEAK AND SAYS:^ \"DEAR LEBAB, YOU DON'T NEED TO WORRY ANY MORE! DREK IS DEAD, AND MOST OF HIS GARGOYLES HAVE BEEN DESTROYED.\"^ LEBAB LOOKS AT YOU FOR A MOMENT IN AN IRRITATED MANNER, BUT APPEARS TO HAVE ACCEPTED THESE FACTS, FOR HE DOES NOT ASK ANY QUESTIONS BUT JUST SAYS:^ \"OH YES, REALLY, VERY INTERESTING! THEN I CAN CLEAR THE ENTRANCE TO THE TELEPORTER ON THE FIRST FLOOR AGAIN AND SWITCH OFF THE STONE GOLEMS.\""
msgstr ""

#. Dialogue of NPC 023 (LEBAB).
#. German: "\"HERZLICH WILLKOMMEN IM TURM DER MAGIE! MÜSSEN EURE MAGISCHEN GEGENSTÄNDE AUFGELADEN WERDEN? DANN GEHT BITTE IN DAS BESCHWÖRUNGSZIMMER. MEINE TOCHTER MARION WIRD EUCH HELFEN KÖNNEN.\""
#: AllTexts/NPC_texts.amb/023/002.txt
msgctxt "AllTexts/NPC_texts.amb/023/002"
msgid "\"WELCOME TO THE MAGIC TOWER! DO YOUR MAGIC THINGS NEED RECHARGING? THEN PLEASE GO INTO THE CHAMBER OF SPELLS. MY DAUGHTER MARION WILL BE ABLE TO HELP YOU.\""
msgstr ""

#. Dialogue of NPC 023 (LEBAB).
#. German: "\"JAJA, LEBT WOHL!\""
#: AllTexts/NPC_texts.amb/023/003.txt
msgctxt "AllTexts/NPC_texts.amb/023/003"
msgid "\"YES, YES, FAREWELL!\""
msgstr ""

#. Dialogue of NPC 023 (LEBAB).
#. German: "\"DIESEN TURM HABE ICH GEBAUT, ALS ICH HERAUSGEFUNDEN HATTE, DASS DIE MAGISCHEN ENERGIEN IN DIESER HÖHE BESONDERS GROß SIND. EIN NUTZEN AUS DIESER ENTDECKUNG LIEGT IN DER MÖGLICHKEIT, MAGISCHE GEGENSTÄNDE, DEREN KRAFT ERSCHÖPFT IST, WIEDER AUFZULADEN.^ NATÜRLICH DARF NIEMALS JEMAND, DER BÖSES IM SINN FÜHRT, DIESE KRÄFTE IN SEINE HAND BEKOMMEN!\""
#: AllTexts/NPC_texts.amb/023/004.txt
msgctxt "AllTexts/NPC_texts.amb/023/004"
msgid "\"I BUILT THIS TOWER WHEN I FOUND THAT THE MAGIC POWER IS PARTICULARLY STRONG AT THIS HEIGHT. ONE USE FOR THIS DISCOVERY IS THE ABILITY TO RECHARGE MAGIC THINGS WHOSE POWER IS EXHAUSTED.^ NATURALLY NO-ONE WHO IS EVIL IN ANY WAY MAY GAIN CONTROL OF THIS POWER!\""
msgstr ""

#. Dialogue of NPC 023 (LEBAB).
#. German: "\"DER ARME DREK, SEINE GIER NACH MACHT HAT IHN IN DEN TOD GEFÜHRT. VOR EINIGEN JAHREN WAR ER MEIN LEHRLING. ALS ER MICH DANN IMMER MEHR BEDRÄNGTE, IHM DEN TURM ZU ÜBERLASSEN, HABE ICH IHN EINES TAGES RAUSGEWORFEN. SEITDEM BEKÄMPFTE ER MICH, WO ER NUR KONNTE.\""
#: AllTexts/NPC_texts.amb/023/005.txt
msgctxt "AllTexts/NPC_texts.amb/023/005"
msgid "\"POOR DREK, HIS GREED FOR POWER LED HIM TO HIS DEATH. A FEW YEARS AGO HE WAS MY APPRENTICE. BUT WHEN HE PRESSED ME MORE AND MORE TO LEAVE THE TOWER TO HIM, I THREW HIM OUT ONE DAY. SINCE THEN HE HAS BEEN FIGHTING ME WHEREVER HE CAN.\""
msgstr ""

#. Dialogue of NPC 024 (BORE).
#. German: "VOR EUCH STEHT EIN ZWERG. ER MACHT EINEN GEISTESABWESENDEN EINDRUCK UND BLICKT IMMER WIEDER ZUM HIMMEL."
#: AllTexts/NPC_texts.amb/024/000.txt
msgctxt "AllTexts/NPC_texts.amb/024/000"
msgid "BEFORE YOU STANDS A DWARF. HE LOOKS ABSENTMINDED, STARING UP AT THE SKY."
msgstr ""

#. Dialogue of NPC 024 (BORE).
#. German: "\"ALLE SIND WEG, ALLE FLOGEN DAVON, NUR MICH HABEN SIE NICHT MITGENOMMEN! WARUM HAT DÖNNER MICH NUR VERGESSEN?\""
#: AllTexts/NPC_texts.amb/024/001.txt
msgctxt "AllTexts/NPC_texts.amb/024/001"
msgid "\"THEY HAVE ALL GONE, THEY HAVE ALL FLOWN AWAY, ONLY I HAVE BEEN LEFT BEHIND! WHY DID DONNER SIMPLY FORGET ME?\""
msgstr ""

#. Dialogue of NPC 024 (BORE).
#. German: "\"JAJA, FLIEGT RUHIG AUCH WEG UND LASST DEN ALTEN BORE HIER ZURÜCK!\""
#: AllTexts/NPC_texts.amb/024/002.txt
msgctxt "AllTexts/NPC_texts.amb/024/002"
msgid "\"YES, YES, JUST FLY AWAY AND LEAVE THE OLD BORE HERE!\""
msgstr ""

#. Dialogue of NPC 024 (BORE).
#. German: "\"ICH WÄRE AUCH GERN MIT DEM GROßEN SCHIFF ZUM GRÜNEN JUWEL GEFLOGEN! ABER JETZT BIN ICH GANZ ALLEIN HIER IN GEMSTONE, JA, GANZ ALLEIN.\""
#: AllTexts/NPC_texts.amb/024/003.txt
msgctxt "AllTexts/NPC_texts.amb/024/003"
msgid "\"I WOULD ALSO HAVE LIKED TO FLY WITH THE BIG BOAT TO THE GREEN JEWEL! BUT NOW I AM ALONE HERE IN GEMSTONE, YES, TOTALLY ALONE.\""
msgstr ""

#. Dialogue of NPC 024 (BORE).
#. German: "ALS IHR DIESE WORTE SAGT, BEKOMMT BORE GROßE GLITZERNDE AUGEN, UND EIN SEHNSÜCHTIGER UND ZUGLEICH HABSÜCHTIGER AUSDRUCK TRITT IN SEIN GESICHT. FAST SABBERND VOR GIER UND ENTTÄUSCHUNG STAMMELT ER:^ \"JAJA, REICHTUM UND MACHT, GROßE MACHT! NUR ICH NICHT, WARUM ICH NICHT?\""
#: AllTexts/NPC_texts.amb/024/004.txt
msgctxt "AllTexts/NPC_texts.amb/024/004"
msgid "AS YOU SAY THESE WORDS, BORE'S EYES BECOME WIDE AND GLISTENING AND HIS FACE TAKES ON AN EXPRESSION OF GREED AND LONGING. ALMOST TREMBLING WITH DISAPPOINTMENT HE STUTTERS:^ \"YES, YES, RICHES AND POWER, GREAT POWER! BUT NOT I, AND WHY NOT I?\""
msgstr ""

#. Dialogue of NPC 024 (BORE).
#. German: "\"JA, EINST WAR ICH IN DÖNNER'S MINE BESCHÄFTIGT, ABER JETZT, WO ALLE WEG SIND, HAB ICH KEINE LUST MEHR, DORT ALLEINE ZU ARBEITEN. ICH HAB DEN SCHLÜSSEL AUF DER INSEL VOR DER MINE VERSTECKT. MAN MUSS NUR DIESEN STAB VOR DEM HÜGEL AUF DER INSEL IN DEN BODEN STECKEN.\"^ MIT DIESEN WORTEN HOLT ER EINEN HOLZSTAB AUS SEINEM KITTEL HERVOR. PLÖTZLICH MEINT ER WOHL, EIN GERÄUSCH VON OBEN ZU HÖREN, DENN ER REIßT DEN KOPF HOCH UND SUCHT SEHNSÜCHTIG DEN HIMMEL AB. DASS ER DEN STAB DABEI ZU BODEN FALLEN LÄSST, SCHEINT ER NICHT ZU BEMERKEN."
#: AllTexts/NPC_texts.amb/024/005.txt
msgctxt "AllTexts/NPC_texts.amb/024/005"
msgid "\"YES, I WAS ONCE EMPLOYED IN DONNER'S MINE, BUT NOW, NOW THEY HAVE ALL GONE, I AM NOT INTERESTED IN WORKING THERE ALONE. I HID THE KEY ON THE ISLAND IN FRONT OF THE MINE. YOU ONLY NEED TO STICK THIS ROD IN THE GROUND ON THE ISLAND IN FRONT OF THE HILL.\"^ WITH THESE WORDS HE PRODUCES A WOODEN ROD FROM HIS APRON. SUDDENLY HE SEEMS TO HEAR A NOISE FROM ABOVE BECAUSE HIS HEAD JERKS UP AND HIS EYES LONGINGLY SEARCH THE SKY. HE APPEARS NOT TO HAVE NOTICED THAT HE DROPPED THE ROD."
msgstr ""

#. Dialogue of NPC 024 (BORE).
#. German: "\"ICH HABE IN SEINER MINE GEARBEITET, ABER ER IST WEG, OHNE MICH MITZUNEHEMEN!\""
#: AllTexts/NPC_texts.amb/024/006.txt
msgctxt "AllTexts/NPC_texts.amb/024/006"
msgid "\"I WORKED IN HIS MINE BUT HE WENT, WITHOUT TAKING ME WITH HIM!\""
msgstr ""

#. Dialogue of NPC 025 (BRALUM).
#. German: "IHR STEHT VOR EINEM KLEINEN STÄMMIGEN GNOM, DER EUCH MIT STOLZEM BLICK ANSCHAUT."
#: AllTexts/NPC_texts.amb/025/000.txt
msgctxt "AllTexts/NPC_texts.amb/025/000"
msgid "YOU SEE BEFORE YOU A SMALL WELL-BUILT GNOME WHO LOOKS AT YOU WITH PRIDE."
msgstr ""

#. Dialogue of NPC 025 (BRALUM).
#. German: "\"AHA, BESUCH VON DEN GROßEN! SEID WILLKOMMEN IN DEN MINEN DER GNOME! ALLERDINGS KOMMT IHR NICHT GERADE ZU EINEM GÜNSTIGEN ZEITPUNKT, DENN NACH FAST ACHTZIG JAHREN DER RUHE HABEN WIR GERADE WIEDER MAL EIN PROBLEM.\""
#: AllTexts/NPC_texts.amb/025/001.txt
msgctxt "AllTexts/NPC_texts.amb/025/001"
msgid "\"AHA, VISITORS FROM THE BIG PEOPLE! WELCOME TO THE MINES OF THE GNOMES. BUT UNFORTUNATELY YOU ARE NOT COMING AT THE BEST TIME BECAUSE AFTER ALMOST EIGHTY YEARS OF PEACE, WE HAVE JUST FOUND ANOTHER PROBLEM.\""
msgstr ""

#. Dialogue of NPC 025 (BRALUM).
#. German: "\"LEBT WOHL UND MÖGE GEB, DER GOTT DER ERDE, EUCH BESCHÜTZEN!\""
#: AllTexts/NPC_texts.amb/025/002.txt
msgctxt "AllTexts/NPC_texts.amb/025/002"
msgid "\"FAREWELL AND MAY GEB, THE GOD OF THE EARTH, PROTECT YOU!\""
msgstr ""

#. Dialogue of NPC 025 (BRALUM).
#. German: "\"IHR WOLLT ETWAS ÜBER UNSER PROBLEM HÖREN? NA JA, ALSO, ETWAS NÖRDLICH VON HIER BEFINDET SICH EIN VERWUNSCHENES HAUS. BIS ZUR GROßEN FLUT LEBTE DORT EINE FIESE ALTE HEXE NAMENS MERA. WIR HABEN IMMER MIT IHR IM STREIT GELEGEN, DA SIE DIE EKELHAFTE ANGEWOHNHEIT HATTE, GNOME IN FRÖSCHE ZU VERWANDELN, UM SIE DANN IN IHREM TEICH AUSZUSETZEN. GEB SEI DANK IST SIE IN DEN FLUTEN ERSOFFEN. ICH KANN EUCH SAGEN, DAS WAR EIN RIESENFEST VOR HUNDERT JAHREN!^ NACH RELATIV LANGER ZEIT DER RUHE TAUCHTE VOR EIN PAAR MONATEN PLÖTZLICH EIN SELTSAMER MANN HIER AUF. ER STELLTE SICH ALS NERA, SOHN VON MERA, VOR UND VERLANGTE, DASS WIR DIE INSEL VERLASSEN. WIR HABEN UNS NATÜRLICH GEWEIGERT, UND SEITDEM HERRSCHT SOWAS WIE EIN KRIEG ZWISCHEN UNS. UND ICH KANN EUCH SAGEN, ER IST EIN SEHR ERNSTZUNEHMENDER GEGNER, DENN ER HAT GROßE ZAUBERKRÄFTE. ZUR ZEIT HABEN WIR EIN PATT: WIR SIND NICHT STARK GENUG, UM IHN ZU VERNICHTEN, ABER WIDERSTEHEN KONNTEN WIR IHM IMMERHIN.^ KÖNNTET IHR UNS NICHT EVENTUELL HELFEN, MIT IHM FERTIGZUWERDEN? ICH WÄRE BEREIT, EUCH GROßE SCHÄTZE ZU ÜBERLASSEN, WENN IHR UNS WIEDER ZU EINEM FRIEDLICHEN LEBEN VERHELFEN KÖNNTET.\""
#: AllTexts/NPC_texts.amb/025/003.txt
msgctxt "AllTexts/NPC_texts.amb/025/003"
msgid "\"DO YOU WANT TO HEAR A BIT ABOUT OUR PROBLEM? WELL, YES, TO THE NORTH OF HERE LIES A DERELICT HOUSE. BEFORE THE SEVERE FLOODS A WICKED OLD WITCH CALLED MERA LIVED THERE. WE WERE ALWAYS ARGUING WITH HER BECAUSE SHE HAD THE HORRIBLE HABIT OF TURNING GNOMES INTO FROGS AND THEN SETTING THEM LOOSE IN HER POND. THANKS TO GEB, SHE DROWNED IN THE FLOODS. I CAN TELL YOU, THERE WAS A HUGE PARTY THEN, ALL THOSE YEARS AGO!^ AFTER A RELATIVELY LONG PERIOD OF PEACE, A FEW MONTHS AGO A STRANGE MAN APPEARED HERE. HE INTRODUCED HIMSELF AS NERA, THE SON OF MERA, AND DEMANDED THAT WE LEAVE THE ISLAND. NATURALLY WE REFUSED AND SINCE THEN WE HAVE BEEN MORE OR LESS AT WAR WITH HIM. AND I CAN TELL YOU, HE IS AN OPPONENT TO BE TAKEN VERY SERIOUSLY, FOR HE HAS EXTENSIVE MAGIC POWERS. AT THE MOMENT OUR PROBLEM IS THAT WE ARE NOT STRONG ENOUGH TO DESTROY HIM. BUT WE ARE ABLE TO WITHSTAND HIM.^ PERHAPS YOU COULD HELP US TO DEAL WITH HIM? I WOULD BE PREPARED TO GIVE YOU GREAT TREASURES IF YOU COULD HELP US TO MAKE OUR LIFE A HAPPY ONE AGAIN.\""
msgstr ""

#. Dialogue of NPC 025 (BRALUM).
#. German: "\"NOCHMALS VIELEN, VIELEN DANK, DASS IHR UNS UNSEREN FRIEDEN WIEDER VERSCHAFFT HABT!\""
#: AllTexts/NPC_texts.amb/025/004.txt
msgctxt "AllTexts/NPC_texts.amb/025/004"
msgid "\"MANY, MANY THANKS FOR GIVING US PEACE AGAIN!\""
msgstr ""

#. Dialogue of NPC 025 (BRALUM).
#. German: "\"DAS IST DER NAME DES HEXENMEISTERS.\""
#: AllTexts/NPC_texts.amb/025/005.txt
msgctxt "AllTexts/NPC_texts.amb/025/005"
msgid "\"THAT IS THE NAME OF THE WITCH MASTER.\""
msgstr ""

#. Dialogue of NPC 025 (BRALUM).
#. German: "\"WUNDERBAR, IHR HABT UNSER PROBLEM ALSO AUS DER WELT GESCHAFFT! ICH HATTE GLEICH DEN EINDRUCK, DASS IHR DIE RICHTIGEN LEUTE FÜR SOWAS SEID. BITTE NEHMT DIESEN SCHLÜSSEL! ER GEHÖRT ZUR SCHATZKAMMER HIER IM HAUS. SUCHT EUCH AUS, WAS EUER HERZ BEGEHRT! IHR HABT ES VERDIENT.\""
#: AllTexts/NPC_texts.amb/025/006.txt
msgctxt "AllTexts/NPC_texts.amb/025/006"
msgid "\"WONDERFUL, YOU HAVE SOLVED OUR PROBLEM! STRAIGHT AWAY I HAD THE IMPRESSION THAT YOU WERE THE RIGHT PEOPLE FOR THIS JOB. PLEASE TAKE THIS KEY! IT BELONGS TO THE TREASURE CHAMBER HERE IN THE HOUSE. TAKE WHATEVER YOUR HEART DESIRES! YOU HAVE EARNED IT.\""
msgstr ""

#. Dialogue of NPC 025 (BRALUM).
#. German: "\"DER RING BEWEIST, DASS NERA VERNICHTET IST. ALSO IST EURE BELOHNUNG GERECHTFERTIGT.\""
#: AllTexts/NPC_texts.amb/025/007.txt
msgctxt "AllTexts/NPC_texts.amb/025/007"
msgid "\"THE RING PROVES THAT NERA HAS BEEN DESTROYED. SO YOUR REWARD IS JUSTIFIED.\""
msgstr ""

#. Dialogue of NPC 026 (NECROS).
#. German: "IHR SEHT EINEN SEHR ALTEN KATER, SEINE NACKENHAARE SIND GESTRÄUBT, UND ER BLICKT EUCH MIT GROßEN AUGEN AN. AUFFÄLLIG IST, DASS SEIN SCHWANZ HALB VERBRANNT IST."
#: AllTexts/NPC_texts.amb/026/000.txt
msgctxt "AllTexts/NPC_texts.amb/026/000"
msgid "YOU SEE A VERY OLD TOMCAT. THE HAIRS AROUND HIS NECK ARE STANDING ON END AND HE LOOKS AT YOU WITH WIDE EYES. YOU NOTICE THAT HALF HIS TAIL IS BURNED."
msgstr ""

#. Dialogue of NPC 026 (NECROS).
#. German: "\"AH, ENDLICH EINMAL JEMAND DER MICH VERSTEHT! DANN SEID IHR BESTIMMT MENSCHEN, DENEN ICH VERTRAUEN KANN. MIT MERA'S SOHN KOMME ICH NÄMLICH ÜBERHAUPT NICHT ZURECHT, DENN ER KANN KATZEN NICHT LEIDEN. ER HAT MICH AUS DEM HAUS GEWORFEN, IN DEM ICH IMMER GELEBT HABE. ZWAR HABE ICH IHM MEINE KRALLEN QUER DURCHS GESICHT GEZOGEN, ABER ER HAT SICH BÖSE GERÄCHT UND MIR MEINEN HALBEN SCHWANZ VERBRANNT.^ ICH WERDE EUCH VERRATEN, WO ER SEIN GEHEIMES VERSTECK HAT. DAMIT KANN ICH IHN FÜR MEINEN SCHWANZ BÜßEN LASSEN. BERÜHRT EINFACH DIE WAND IM KELLER SÜDLICH VOM TREPPENENDE.\""
#: AllTexts/NPC_texts.amb/026/001.txt
msgctxt "AllTexts/NPC_texts.amb/026/001"
msgid "\"AH, FINALLY SOMEONE WHO UNDERSTANDS ME! FOR YOU ARE CERTAINLY PEOPLE I CAN TRUST. I DO NOT GET ON WITH MERA'S SON AT ALL, FOR HE CANNOT BEAR CATS. HE THREW ME OUT OF THE HOUSE WHERE I LIVED. ALTHOUGH I CLAWED HIS FACE, HE TOOK HIS EVIL REVENGE AND BURNED OFF HALF MY TAIL.^ I WILL TELL YOU WHERE HE KEEPS HIS SECRET. SO THAT YOU CAN MAKE HIM PAY FOR MY TAIL. SIMPLY TOUCH THE WALL IN THE CELLAR TO THE SOUTH OF THE BOTTOM OF THE CELLAR STEPS.\""
msgstr ""

#. Dialogue of NPC 026 (NECROS).
#. German: "\"AUF WIEDERSEHEN, UND NEHMT EUCH VOR NERA IN ACHT, ER IST SEHR MÄCHTIG.\""
#: AllTexts/NPC_texts.amb/026/002.txt
msgctxt "AllTexts/NPC_texts.amb/026/002"
msgid "\"GOODBYE, AND BEWARE OF NERA, HE IS VERY POWERFUL.\""
msgstr ""

#. Dialogue of NPC 027 (NOREL).
#. German: "IHR SEHT EIN GROßEN STÄMMIGEN MANN VOR EUCH. ER TRÄGT DUNKLE LEDERKLEIDUNG UND HAT EINEN WILDEN GRAUEN BART. ER SCHAUT EUCH FRAGEND AN."
#: AllTexts/NPC_texts.amb/027/000.txt
msgctxt "AllTexts/NPC_texts.amb/027/000"
msgid "YOU SEE A LARGE WELL-BUILT MAN AHEAD. HE IS WEARING DARK LEATHER CLOTHING AND HAS AN UNKEMPT GREY BEARD. HE LOOKS AT YOU QUESTIONINGLY."
msgstr ""

#. Dialogue of NPC 027 (NOREL).
#. German: "\"SEID GEGRÜßT, FREMDE! WAS FÜHRT EUCH IN DEN WALD VON DARLOGNA? ICH BIN AUF DER SUCHE NACH MEINEM LEHRLING KAY. ER IST EUCH NICHT ZUFÄLLIG BEGEGNET, ODER?\""
#: AllTexts/NPC_texts.amb/027/001.txt
msgctxt "AllTexts/NPC_texts.amb/027/001"
msgid "\"WELCOME, STRANGERS! WHAT HAS BROUGHT YOU TO THE FOREST OF DARLOGNA? I AM LOOKING FOR MY APPRENTICE, KAY. PERHAPS YOU HAVE MET HIM?\""
msgstr ""

#. Dialogue of NPC 027 (NOREL).
#. German: "\"TRETET NÄHER! WILLKOMMEN IN MEINER HÜTTE!\""
#: AllTexts/NPC_texts.amb/027/002.txt
msgctxt "AllTexts/NPC_texts.amb/027/002"
msgid "\"COME CLOSER! WELCOME TO MY HUT!\""
msgstr ""

#. Dialogue of NPC 027 (NOREL).
#. German: "\"LEBT WOHL, UND NEHMT EUCH VOR DEM BIEST IN ACHT! FALLS IHR ETWAS VON KAY HÖREN SOLLTET, DANN GEBT MIR BITTE BESCHEID.\""
#: AllTexts/NPC_texts.amb/027/003.txt
msgctxt "AllTexts/NPC_texts.amb/027/003"
msgid "\"FAREWELL, AND BEWARE OF THE BEASTS! PLEASE TELL ME IF YOU HEAR ANYTHING ABOUT KAY.\""
msgstr ""

#. Dialogue of NPC 027 (NOREL).
#. German: "\"ALLES GUTE UND SICHERE WEGE WÜNSCHE ICH EUCH! HOFFEN WIR, DASS KAY DAS EINZIGE OPFER DIESER VERWÜNSCHUNG WAR!\""
#: AllTexts/NPC_texts.amb/027/004.txt
msgctxt "AllTexts/NPC_texts.amb/027/004"
msgid "\"ALL THE BEST, AND I HOPE YOUR JOURNEYS ARE SAFE AND SUCCESSFUL! LET US HOPE THAT KAY WAS THE ONLY VICTIM OF THIS CURSE!\""
msgstr ""

#. Dialogue of NPC 027 (NOREL).
#. German: "\"KAY IST MEIN LEHRLING. ES IST JETZT SCHON ETLICHE WOCHEN HER, DASS ER VERSCHWUNDEN IST. ICH HABE INZWISCHEN FAST DEN GANZEN WALD NACH IHM ABGESUCHT, ABER VERGEBLICH, ICH FAND NICHT MAL EINE SPUR VON IHM. ICH BEFÜRCHTE, DAS SCHRECKLICHE BIEST HAT IHN ERWISCHT.\""
#: AllTexts/NPC_texts.amb/027/005.txt
msgctxt "AllTexts/NPC_texts.amb/027/005"
msgid "\"KAY IS MY APPRENTICE. HE DISAPPEARED MANY WEEKS AGO. I HAVE SEARCHED FOR HIM THROUGH ALMOST THE ENTIRE FOREST, BUT IN VAIN. I FOUND NO TRACE OF HIM. I AM AFRAID THAT THE DREADFUL BEAST GOT HIM.\""
msgstr ""

#. Dialogue of NPC 027 (NOREL).
#. German: "\"KURZ NACHDEM KAY VERSCHWUNDEN IST, HABE ICH TOTES WILD GEFUNDEN, DAS DEN SPUREN NACH VON EINEM SCHRECKLICHEN UNGEHEUER GERISSEN WORDEN SEIN MUSS. ICH HABE ES BIS JETZT ABER NOCH NICHT AUFSPÜREN KÖNNEN. ICH VERMUTE, ES VERSTECKT SICH IN DER HÖHLE AM NORDENDE DER INSEL. FALLS IHR IN DIE NÄHE DER HÖHLE KOMMT, DANN PASST GANZ BESONDERS AUF.^ SOLLTET IHR TATSÄCHLICH AUF DAS UNGEHEUER STOßEN, DANN WÄRE ES SICHER VON VORTEIL, WENN EURE AUSRÜSTUNG NOCH EIN BISSCHEN BESSER WÄRE. HIER IST DER SCHLÜSSEL ZU MEINEM WAFFENSCHRANK; SUCHT EUCH AUS, WAS IHR FÜR NÜTZLICH HALTET.\""
#: AllTexts/NPC_texts.amb/027/006.txt
msgctxt "AllTexts/NPC_texts.amb/027/006"
msgid "\"SHORTLY AFTER KAY DISAPPEARED, I FOUND A DEAD WILD ANIMAL. JUDGING BY THE TRACKS IT MUST HAVE BEEN DRAGGED OFF BY A TERRIBLE MONSTER. BUT I WAS NOT ABLE TO FIND IT. I EXPECT IT IS HIDING IN THE CAVE AT THE NORTH END OF THE ISLAND. IF YOU GO NEAR THE CAVE, BE VERY CAREFUL.^ IF YOU ACTUALLY MEET THE MONSTER, IT WOULD BE BETTER IF YOU COULD IMPROVE YOUR ARMOUR A LITTLE. HERE IS THE KEY TO MY WEAPONS CUPBOARD. TAKE WHATEVER YOU FEEL MAY BE USEFUL.\""
msgstr ""

#. Dialogue of NPC 027 (NOREL).
#. German: "\"DAS BIEST MUSS UNGEHEUER STARK SEIN, DESHALB GEBT AUF EUCH ACHT!\""
#: AllTexts/NPC_texts.amb/027/007.txt
msgctxt "AllTexts/NPC_texts.amb/027/007"
msgid "\"THE BEAST MUST BE ENORMOUSLY STRONG, SO TAKE GREAT CARE!\""
msgstr ""

#. Dialogue of NPC 027 (NOREL).
#. German: "\"XENOBIL GEHÖRT ZU DEN TEUERSTEN HÖLZERN AUF GANZ LYRAMION, VOR ALLEM, WEIL ES GROßE MAGISCHE KRÄFTE HABEN SOLL. ICH KANN DAS ZWAR SELBST NICHT ÜBERPRÜFEN, ABER BEI MAGIERN IST DAS HOLZ ÄUßERST BEGEHRT.^ ES GIBT LEIDER NUR SEHR WENIGE XENOBIL-BÄUME, UND DIE WACHSEN AUCH NOCH UNGEWÖHNLICH LANGSAM, DAHER IST ES MIR UNMÖGLICH, DIE NACHFRAGE AUCH NUR ANNÄHREND ZU BEFRIEDIGEN.\""
#: AllTexts/NPC_texts.amb/027/008.txt
msgctxt "AllTexts/NPC_texts.amb/027/008"
msgid "\"XENOBIL IS ONE OF THE MOST VALUABLE TYPES OF WOOD ANYWHERE IN LYRAMION, MAINLY BECAUSE IT IS SAID TO HAVE GREAT MAGIC POWERS. I CANNOT CHECK THAT MYSELF, BUT MAGICIANS TREASURE THE WOOD VERY HIGHLY.^ UNFORTUNATELY THERE ARE ONLY A FEW XENOBIL TREES AND THEY GROW UNUSUALLY SLOWLY, SO IT IS NOT POSSIBLE FOR ME TO SATISFY THE DEMAND FOR THAT TYPE OF WOOD.\""
msgstr ""

#. Dialogue of NPC 027 (NOREL).
#. German: "\"DAS IST JA UNFASSBAR! KAY WAR DAS BIEST? MEIN GOTT, WELCH SCHRECKLICHER FLUCH MUSS AUF IHM GELASTET HABEN. MÖGE SEINE SEELE IN BALA'S REICH IHREN FRIEDEN FINDEN!^ NEHMT ZUM DANK FÜR EURE HILFE DIESEN STOCK. ER BESTEHT AUS DEM KOSTBAREN XENOBIL-HOLZ.\""
#: AllTexts/NPC_texts.amb/027/009.txt
msgctxt "AllTexts/NPC_texts.amb/027/009"
msgid "\"THAT IS ABSOLUTELY INCREDIBLE! KAY WAS THE BEAST HIMSELF? MY GOD, WHAT A TERRIBLE CURSE MUST HAVE BEEN PLACED ON HIM. MAY HIS SOUL FIND PEACE IN BALA'S REALMS!^ TAKE THIS STICK AS THANKS FOR YOUR HELP. IT IS MADE OF THE VALUABLE XENOBIL WOOD.\""
msgstr ""

#. Dialogue of NPC 027 (NOREL).
#. German: "\"DER ARME KAY, DAS AMULETT WAR SEIN GANZER STOLZ! ER HAT EINMAL ERZÄHLT, DASS ER ES VON EINEM GROßEN MAGIER BEKOMMEN HAT UND DASS ES MAGISCHE KRÄFTE BESITZT. DOCH OFFENSICHTLICH KONNTE ES IHN NICHT VOR DIESEM FLUCH BEWAHREN.\""
#: AllTexts/NPC_texts.amb/027/010.txt
msgctxt "AllTexts/NPC_texts.amb/027/010"
msgid "\"POOR KAY, THE AMULET WAS HIS PRIDE AND JOY! HE TOLD ME ONCE THAT IT WAS GIVEN TO HIM BY AN IMPORTANT MAGICIAN AND THAT IT POSSESSES MAGIC POWER. BUT APPARENTLY IT WAS NOT ABLE TO PROTECT HIM FROM THE CURSE.\""
msgstr ""

#. Dialogue of NPC 028 (PELANIS).
#. German: "IHR SEHT EINEN ALTEN, WEISE WIRKENDEN ELF. ER TRÄGT EIN KOSTBARES GEWAND UND BLICKT EUCH WOHLWOLLEND ENTGEGEN."
#: AllTexts/NPC_texts.amb/028/000.txt
msgctxt "AllTexts/NPC_texts.amb/028/000"
msgid "YOU SEE AN OLD WISE ELF. HE IS WEARING EXPENSIVE ROBES AND LOOKS AT YOU IN WELCOME."
msgstr ""

#. Dialogue of NPC 028 (PELANIS).
#. German: "\"WILLKOMMEN IN MEINEM PALAST!\""
#: AllTexts/NPC_texts.amb/028/001.txt
msgctxt "AllTexts/NPC_texts.amb/028/001"
msgid "\"WELCOME TO MY PALACE!\""
msgstr ""

#. Dialogue of NPC 028 (PELANIS).
#. German: "\"LEBT WOHL! MÖGE EUER SCHWERES VORHABEN GLÜCKLICH ENDEN!\""
#: AllTexts/NPC_texts.amb/028/002.txt
msgctxt "AllTexts/NPC_texts.amb/028/002"
msgid "\"FAREWELL! MAY YOUR DIFFICULT PROJECT END SUCCESSFULLY!\""
msgstr ""

#. Dialogue of NPC 028 (PELANIS).
#. German: "\"ALLES GUTE AUF EUREM WEG UND MÖGEN DIE ADLER IMMERDAR UNSERE FREUNDE SEIN!\""
#: AllTexts/NPC_texts.amb/028/003.txt
msgctxt "AllTexts/NPC_texts.amb/028/003"
msgid "\"I WISH YOU WELL ON YOUR WAY AND MAY THE EAGLES BE OUR EVERLASTING FRIENDS!\""
msgstr ""

#. Dialogue of NPC 028 (PELANIS).
#. German: "\"JA, WIR HABEN ZUR ZEIT GROßE SORGEN. VOR EINIGEN MONATEN KAM SANSRI, DIE SCHLANGENGÖTTIN, NACH ILLIEN. ZUNÄCHST WAR SIE GANZ UMGÄNGLICH, UND ICH LUD SIE IN DEN PALAST ZU EINEM FESTMAHL EIN. DABEI HAT SIE MICH DANN DAZU AUFGEFORDERT, IHR EINEN JUNGADLER ZU ÜBERLASSEN. ICH HABE NATÜRLICH ABGELEHNT, UND SIE IST WÜTEND WIE EINE FURIE AUS DEM PALAST GESTÜRZT.^ EIN PAAR TAGE SPÄTER HAT SIE SICH DANN FÜRCHTERLICH GERÄCHT: SIE HAT DEN ADLERHORST ÜBERFALLEN. ZUERST HAT SIE DIE WACHEN IN STEIN VERWANDELT UND DANN DIE ADLER. AM NÄCHSTEN TAG KAM EINE NACHRICHT VON IHR. DARIN TEILTE SIE UNS MIT, WENN SIE KEINEN DER ADLER BEKÄME, SOLLTEN AUCH WIR KEINE HABEN.^ WIR HABEN MIT ALLEN ERDENKLICHEN MAGISCHEN MITTELN VERSUCHT, DIE VERSTEINERUNG WIEDER AUFZUHEBEN, ABER LEIDER WAR ALLES VERGEBLICH. UNSERE GELEHRTEN MEINEN, NUR SANSRI'S BLUT KÖNNE DEN FLUCH VON DEN ADLERN UND WACHEN NEHMEN.\""
#: AllTexts/NPC_texts.amb/028/004.txt
msgctxt "AllTexts/NPC_texts.amb/028/004"
msgid "\"YES, WE ARE GREATLY CONCERNED AT THE MOMENT. SOME MONTHS AGO SANSRI, THE SNAKE GODDESS, CAME TO ILLIEN. AT FIRST SHE WAS QUITE NORMAL AND I INVITED HER TO A BANQUET AT THE PALACE. DURING THE BANQUET SHE ASKED ME TO GIVE HER A YOUNG EAGLE. NATURALLY I REFUSED AND SHE STORMED OUT OF THE PALACE IN RAGE!^ A FEW DAYS LATER SHE TOOK HER FEARSOME REVENGE: SHE ATTACKED THE EYRIE OF THE EAGLES. FIRST SHE TURNED THE GUARDS TO STONE AND THEN THE EAGLES THEMSELVES. THE NEXT DAY A MESSAGE ARRIVED FROM HER. SHE WARNED THAT IF SHE COULD NOT HAVE ANY OF THE EAGLES, WE WOULD NOT HAVE ANY EITHER.^ USING EVERY CONCEIVABLE BRANCH OF MAGIC, WE TRIED TO BRING THE STONE GUARDS BACK TO LIFE, BUT IT WAS ALL IN VAIN. OUR WISE MEN FEEL THAT ONLY SANSRI'S BLOOD CAN TAKE THE CURSE OFF THE EAGLES AND THE GUARDS.\""
msgstr ""

#. Dialogue of NPC 028 (PELANIS).
#. German: "\"IHR HABT MIT SANSRI GEKÄMPFT UND SIE TATSÄCHLICH BESIEGT?! UNFASSBAR, ICH BIN UNENDLICH GLÜCKLICH! BITTE GEBT MIR DAS BLUT, DAMIT ICH DIE ADLER UND DIE WÄCHTER VOM FLUCH BEFREIEN KANN.\""
#: AllTexts/NPC_texts.amb/028/005.txt
msgctxt "AllTexts/NPC_texts.amb/028/005"
msgid "\"YOU FOUGHT WITH SANSRI AND ACTUALLY BEAT HER?! INCREDIBLE, I AM DELIRIOUSLY HAPPY! PLEASE GIVE ME THE BLOOD SO THAT I CAN FREE THE EAGLES AND THE GUARDS FROM HER CURSE.\""
msgstr ""

#. Dialogue of NPC 028 (PELANIS).
#. German: "\"IHR HABT EUCH UNSERE EWIGE DANKBARKEIT VERDIENT. BITTE NEHMT DIESEN SCHLÜSSEL, ER ÖFFNET DIE TÜR ZUR SCHATZKAMMER. SUCHT AUS, WAS IMMER IHR FÜR ANGEMESSEN HALTET. AUßERDEM GEBE ICH EUCH DIESE FLÖTE. MIT IHR KÖNNT IHR EINEN ADLER RUFEN, DER EUCH ZU EUREM ZIEL FLIEGEN WIRD.\""
#: AllTexts/NPC_texts.amb/028/006.txt
msgctxt "AllTexts/NPC_texts.amb/028/006"
msgid "\"YOU HAVE EARNED OUR ETERNAL GRATITUDE. PLEASE TAKE THIS KEY, IT OPENS THE DOOR TO THE TREASURE CHAMBER. CHOOSE WHATEVER YOU FEEL IS REASONABLE. I WOULD ALSO LIKE TO GIVE YOU THIS FLUTE. YOU CAN CALL AN EAGLE WITH IT AND HE WILL FLY YOU TO YOUR DESTINATION.\""
msgstr ""

#. Dialogue of NPC 028 (PELANIS).
#. German: "\"DANK EUCH IST SANSRI'S FLUCH NUN VERGANGENHEIT.\""
#: AllTexts/NPC_texts.amb/028/007.txt
msgctxt "AllTexts/NPC_texts.amb/028/007"
msgid "\"THANKS TO YOU SANSRI'S CURSE IS FINALLY LIFTED.\""
msgstr ""

#. Dialogue of NPC 029 (MATTHIAS).
#. German: "IHR SEHT EINEN JUNGEN ELF. ER TRÄGT EINE ROBE, DIE MIT GOLDEN NOTEN BESTICKT IST, UND HÄLT EINE WUNDERSCHÖNE ELFENHARFE IN DER HAND."
#: AllTexts/NPC_texts.amb/029/000.txt
msgctxt "AllTexts/NPC_texts.amb/029/000"
msgid "YOU SEE A YOUNG ELF. HE IS WEARING A ROBE STITCHED WITH GOLD NOTES AND IS HOLDING A BEAUTIFUL ELF HARP IN HIS HANDS."
msgstr ""

#. Dialogue of NPC 029 (MATTHIAS).
#. German: "DER MEISTER SIEHT EUCH MIT EINEM DURCHDRINGENDEN BLICK AN UND HEBT SEINE HARFE. KURZ DARAUF DURCHFLIEßT EINE BEZAUBERNDE MUSIK DEN RAUM."
#: AllTexts/NPC_texts.amb/029/001.txt
msgctxt "AllTexts/NPC_texts.amb/029/001"
msgid "THE MASTER LOOKS AT YOU WITH A PENETRATING GLANCE AND RAISES HIS HARP. MAGICAL MUSIC THEN FILLS THE ROOM."
msgstr ""

#. Dialogue of NPC 029 (MATTHIAS).
#. German: "DER MEISTER SCHAUT EUCH TRAURIG AN UND LÄSST SEINE HARFE SINKEN. DAS ENDE DER MUSIK HINTERLÄSST EINE LEERE IM RAUM."
#: AllTexts/NPC_texts.amb/029/002.txt
msgctxt "AllTexts/NPC_texts.amb/029/002"
msgid "THE MASTER LOOKS AT YOU WITH SADNESS IN HIS EYES AND LOWERS HIS HARP. THE END OF THE MUSIC LEAVES AN EMPTINESS IN THE ROOM."
msgstr ""

#. Dialogue of NPC 029 (MATTHIAS).
#. German: "\"ELFENHARFEN SIND DIE WUNDERBARSTEN INSTRUMENTE AUF LYRAMION. SIE SPIELEN FAST WIE VON SELBST.^ HABT IHR VIELLEICHT INTERESSE AN EINER HARFE? ICH VERKAUFE EUCH EINE FÜR 10000 GOLD. DAS MAG SICH TEUER ANHÖREN, ABER BEDENKT, SOLCH EIN INSTRUMENT BEKOMMT IHR SONST NIRGENDWO!\""
#: AllTexts/NPC_texts.amb/029/003.txt
msgctxt "AllTexts/NPC_texts.amb/029/003"
msgid "\"ELF HARPS ARE THE MOST BEAUTIFUL INSTRUMENTS ON LYRAMION. THEY ALMOST PLAY THEMSELVES.^ PERHAPS YOU ARE INTERESTED IN A HARP? I WILL SELL YOU ONE FOR 10,000 PIECES OF GOLD. THAT MIGHT SEEM EXPENSIVE, BUT REMEMBER YOU CANNOT GET AN INSTRUMENT LIKE IT ANYWHERE ELSE!\""
msgstr ""

#. Dialogue of NPC 029 (MATTHIAS).
#. German: "\"HIER HABT HIER EINS DER EDLEN INSTRUMENTE. BENUTZT ES AUF EUREN REISEN, UND ES WIRD EUCH NIE AN ERQUICKENDER MUSIK FEHLEN.\""
#: AllTexts/NPC_texts.amb/029/004.txt
msgctxt "AllTexts/NPC_texts.amb/029/004"
msgid "\"HERE IS ONE OF THE NOBLE INSTRUMENTS. USE IT ON YOUR JOURNEYS AND YOU WILL NEVER BE SHORT OF LIVE MUSIC.\""
msgstr ""

#. Dialogue of NPC 029 (MATTHIAS).
#. German: "\"NANU, WIRKLICH SELTSAME HARFENSAITEN! AUS KRISTALL, WENN MICH NICHT ALLES TÄUSCHT. WENN IHR SIEBEN DIESER SAITEN UND EINE ELFENHARFE HABT, DANN KANN ICH EUCH DAS INSTRUMENT DAMIT BESPANNEN.\""
#: AllTexts/NPC_texts.amb/029/005.txt
msgctxt "AllTexts/NPC_texts.amb/029/005"
msgid "\"WELL, REALLY STRANGE HARP STRINGS. THEY ARE MADE OF CRYSTAL, UNLESS I AM MISTAKEN. IF YOU HAVE SEVEN OF THESE STRINGS AND AN ELF HARP, I CAN FIT THEM ON THE INSTRUMENT FOR YOU.\""
msgstr ""

#. Dialogue of NPC 029 (MATTHIAS).
#. German: "\"ES TUT MIR LEID, ABER ICH KANN EURE ELFENHARFE NUR BESPANNEN, WENN IHR MIR SIEBEN DIESER KRISTALLSAITEN BRINGT.\""
#: AllTexts/NPC_texts.amb/029/006.txt
msgctxt "AllTexts/NPC_texts.amb/029/006"
msgid "\"I AM SORRY, BUT I CAN ONLY FIT THE STRINGS TO YOUR ELF HARP IF YOU BRING ME SEVEN CRYSTAL STRINGS.\""
msgstr ""

#. Dialogue of NPC 029 (MATTHIAS).
#. German: "MATTHIAS NIMMT DIE SAITEN UND DIE ELFENHARFE ENTGEGEN UND BEGINNT MIT DER BESPANNUNG. BALD DARAUF SAGT ER:^ \"HIER HABT IHR SIE ZURÜCK. ICH MUSS EUCH ALLERDINGS WARNEN: DIE MUSIK DER HARFE IST JETZT TÖDLICH! WENN IHR SIE IM KAMPF BENUTZT, WIRD SIE DIE MEISTEN EURER GEGNER ZERSTÖREN. IHR SELBST SEID ALLERDINGS GEGEN IHRE DESTRUKTIVE MAGIE GEFEIT!\""
#: AllTexts/NPC_texts.amb/029/007.txt
msgctxt "AllTexts/NPC_texts.amb/029/007"
msgid "MATTHIAS TAKES THE STRINGS AND THE ELF HARP AND BEGINS TO FIT THE STRINGS. SHORTLY AFTERWARDS HE SAYS:^ \"WELL, THERE YOU ARE. BUT I MUST WARN YOU: THE MUSIC PLAYED ON THE HARP IS NOW DEADLY! IF YOU USE IT IN BATTLE, YOU WILL DESTROY MOST OF YOUR OPPONENTS. BUT YOU YOURSELVES ARE COMPLETELY SAFE FROM ITS DESTRUCTIVE MAGIC!\""
msgstr ""

#. Dialogue of NPC 030 (BARON KARSTEN).
#. German: "VOR EUCH STEHT EIN STÄMMIGER JUNGER MANN IN EINEM KOSTBAREN GEWAND. ER SCHAUT EUCH INTERESSIERT AN."
#: AllTexts/NPC_texts.amb/030/000.txt
msgctxt "AllTexts/NPC_texts.amb/030/000"
msgid "BEFORE YOU STANDS A THICKSET YOUNG MAN WEARING EXPENSIVE CLOTHES. HE LOOKS AT YOU WITH INTEREST."
msgstr ""

#. Dialogue of NPC 030 (BARON KARSTEN).
#. German: "\"WILLKOMMEN IN NEWLAKE! ICH HOFFE, IHR VERHALTET EUCH RUHIG UND MACHT KEINEN ÄRGER IN DER STADT.\""
#: AllTexts/NPC_texts.amb/030/001.txt
msgctxt "AllTexts/NPC_texts.amb/030/001"
msgid "\"WELCOME TO NEWLAKE! I HOPE YOU WILL BEHAVE YOURSELVES AND CAUSE NO TROUBLE IN THE TOWN.\""
msgstr ""

#. Dialogue of NPC 030 (BARON KARSTEN).
#. German: "\"ICH HEIßE EUCH HERZLICH WILLKOMMEN IN NEWLAKE! ICH HABE BEGONNEN, EIN BUCH ÜBER DIE AUFREGENDE GESCHICHTE LYRAMION'S ZU SCHREIBEN. ICH VERSPRECHE EUCH, IHR WERDET UNTER DEN ERSTEN SEIN, DIE EIN EXEMPLAR BEKOMMEN.\""
#: AllTexts/NPC_texts.amb/030/002.txt
msgctxt "AllTexts/NPC_texts.amb/030/002"
msgid "\"WELCOME, WELCOME TO NEWLAKE! I HAVE BEGUN TO WRITE A BOOK ABOUT THE EXCITING HISTORY OF LYRAMION. I PROMISE YOU WILL BE THE FIRST TO HAVE A COPY.\""
msgstr ""

#. Dialogue of NPC 030 (BARON KARSTEN).
#. German: "\"VERHALTET EUCH RUHIG ODER ICH SCHICKE EUCH MEINE WACHEN AUF DEN HALS!\""
#: AllTexts/NPC_texts.amb/030/003.txt
msgctxt "AllTexts/NPC_texts.amb/030/003"
msgid "\"BEHAVE YOURSELVES OR I WILL SEND MY GUARDS TO DEAL WITH YOU!\""
msgstr ""

#. Dialogue of NPC 030 (BARON KARSTEN).
#. German: "\"AUF WIEDERSEHEN, FREUNDE! WENN IHR MAL WIEDER IN DER NÄHE SEID, DANN MÜSST IHR MICH UNBEDINGT BESUCHEN UND MIR VON EUREN ABENTEUERN ERZÄHLEN, DAMIT ICH SIE AUFSCHREIBEN KANN!\""
#: AllTexts/NPC_texts.amb/030/004.txt
msgctxt "AllTexts/NPC_texts.amb/030/004"
msgid "\"GOODBYE, FRIENDS! IF YOU ARE EVER IN THE NEIGHBOURHOOD AGAIN, YOU MUST VISIT ME AND TELL ME OF YOUR ADVENTURES SO THAT I CAN WRITE THEM DOWN!\""
msgstr ""

#. Dialogue of NPC 030 (BARON KARSTEN).
#. German: "\"DIESE VERDAMMTE BRUDERSCHAFT BEREITET MIR KOPFSCHMERZEN. ICH WEISS WIRKLICH NICHT, WAS IHRE LEUTE DRÜBEN AUF DER TEMPELINSEL TREIBEN, ICH WEISS NUR, DASS ICH DEM BRATEN NICHT TRAUE. VOR EIN PAAR MONATEN HABE ICH VERSUCHT, EINEN SPION BEI IHNEN EINZUSCHLEUSEN, DOCH ER IST NIE WIEDER AUFGETAUCHT.^ EIN PAAR WOCHEN SPÄTER BEKAM ICH EINE NACHRICHT VON DEN FEINEN BRÜDERN. DER OBERPRIESTER TEILTE MIR MIT, DASS ICH MICH DOCH GEFÄLLIGST AUS DEN ANGELEGENHEITEN SEINES TEMPELS HERAUSHALTEN SOLLE. MAN HABE SCHON GENUG DAMIT ZU TUN, TARBOS IN SEINEM GEFÄNGNIS ZU HALTEN UND KÖNNE NICHT AUCH NOCH EINEN NEUGIERIGEN SCHNÜFFLER GEBRAUCHEN.^ ICH SAGE EUCH, WENN ICH MEHR MÄNNER UNTER WAFFEN HÄTTE UND DIE LEUTE VON LYRAMION DIESE BRUDERSCHAFT NICHT DERMAßEN VEREHREN WÜRDEN, DANN HÄTTE ICH DIE BANDE SCHON LÄNGST AUSGERÄUCHERT!^ VIELLEICHT GELINGT ES EUCH JA MAL, IN DEN TEMPEL ZU GELANGEN. MIR WÄRE SEHR DARAN GELEGEN, WENN IHR MIR DANN BERICHTEN WÜRDET, WAS SICH DORT EIGENTLICH ABSPIELT. DASS MIR INFORMATIONEN ÜBER DIE BRUDERSCHAFT BARE MÜNZE WERT SIND, MOTIVIERT EUCH VIELLEICHT...\""
#: AllTexts/NPC_texts.amb/030/005.txt
msgctxt "AllTexts/NPC_texts.amb/030/005"
msgid "\"THIS DAMMED BROTHERHOOD IS GIVING ME A HEADACHE. I REALLY DO NOT KNOW WHAT THEIR PEOPLE ARE DOING OVER THERE ON THE TEMPLE ISLAND. I ONLY KNOW THAT I DO NOT TRUST THEM. A FEW MONTHS AGO I TRIED TO SEND SOMEONE TO SPY ON THEM, BUT HE NEVER RETURNED.^ A FEW WEEKS LATER I RECEIVED A MESSAGE FROM THE FINE BROTHERHOOD. THE HEAD PRIEST ADVISED ME THAT I OUGHT NOT TO GET INVOLVED IN MATTERS CONCERNING HIS TEMPLE. HE SAID THEY ALREADY HAD ENOUGH TO DO TO KEEP TARBOS IN HIS PRISON AND DID NOT NEED A NOSEY SPY.^ I CAN TELL YOU, IF I HAD MORE MEN AND WEAPONS AND THE PEOPLE OF LYRAMION DID NOT HONOUR THIS BROTHERHOOD SO MUCH, I WOULD HAVE GOTTEN RID OF THAT GANG A LONG TIME AGO!^ PERHAPS YOU WILL SUCCEED IN REACHING THE TEMPLE. I WOULD BE VERY PLEASED TO HEAR YOUR REPORT ABOUT WHAT IS ACTUALLY GOING ON THERE. THE FACT THAT SUCH INFORMATION ABOUT THE BROTHERHOOD IS OF GREAT VALUE TO ME MAY PERHAPS MOTIVATE YOU ...\""
msgstr ""

#. Dialogue of NPC 030 (BARON KARSTEN).
#. German: "\"JA, DAS IST RICHTIG. ICH HABE DIE GRUFT VERSCHLOSSEN, WEIL SICH IN LETZTER ZEIT EINIGE MERKWÜRDIGE DINGE DORT ABSPIELTEN. AM LIEBSTEN WÜRDE ICH SIE ABER LIEBER HEUTE ALS MORGEN WIEDER ÖFFNEN, DENN DAS GRAB VON SHANDRA IST EINE WALLFAHRTSSTÄTTE. ZUR ZEIT KANN ICH DEN SCHLÜSSEL ZUR GRUFT JEDOCH NUR LEUTEN GEBEN, DENEN ICH FEST VERTRAUEN KANN.\""
#: AllTexts/NPC_texts.amb/030/006.txt
msgctxt "AllTexts/NPC_texts.amb/030/006"
msgid "\"YES, THAT IS RIGHT. I CLOSED THE CRYPT BECAUSE SOME STRANGE THINGS HAPPENED THERE RECENTLY. BUT IDEALLY I WOULD OPEN IT UP AGAIN TODAY, RATHER THAN TOMORROW, BECAUSE THE GRAVE OF SHANDRA IS VISITED BY MANY PEOPLE. BUT AT THE MOMENT I CAN ONLY GIVE THE KEY TO THE CRYPT TO PEOPLE I CAN REALLY TRUST.\""
msgstr ""

#. Dialogue of NPC 030 (BARON KARSTEN).
#. German: "\"ICH HABE EUCH DEN SCHLÜSSEL ZUR GRUFT BEREITS GEGEBEN. BITTE VERSUCHT, OB IHR DIE DINGE DORT UNTEN INS REINE BRINGEN KÖNNT!\""
#: AllTexts/NPC_texts.amb/030/007.txt
msgctxt "AllTexts/NPC_texts.amb/030/007"
msgid "\"I HAVE GIVEN YOU THE KEY TO THE CRYPT. PLEASE TRY TO SORT OUT WHAT IS GOING ON DOWN THERE!\""
msgstr ""

#. Dialogue of NPC 030 (BARON KARSTEN).
#. German: "\"MEISTER ROTTERMUND HAT EUCH DAMIT BEAUFTRAGT, MIR DAS BILD ZU BRINGEN?! DA MUSS ER GROßES VERTRAUEN IN EUCH HABEN, WENN ER EUCH EINE SOLCH WERTVOLLE ARBEIT ÜBERANTWORTET. WÜRDET IHR MIR DAS BILD BITTE GEBEN?\""
#: AllTexts/NPC_texts.amb/030/008.txt
msgctxt "AllTexts/NPC_texts.amb/030/008"
msgid "\"MASTER ROTTERMUND INSTRUCTED YOU TO BRING ME THE PICTURE?! HE MUST TRUST YOU A LOT IF HE MAKES YOU RESPONSIBLE FOR SUCH A VALUABLE ITEM. WOULD YOU PLEASE GIVE ME THE PICTURE!\""
msgstr ""

#. Dialogue of NPC 030 (BARON KARSTEN).
#. German: "\"SEID BEDANKT! HIER, NEHMT DIESES GOLD ALS LOHN FÜR DEN TRANSPORT. ER WAR SICHER NICHT UNPROBLEMATISCH.^ WENN EUCH MEISTER ROTTERMUND DAS BILD MITGEGEBEN HAT, MÜSST IHR SEHR VERTRAUENSWÜRDIG SEIN, DA KENNE ICH IHN GUT GENUG. VIELLEICHT SEID IHR DIE RICHTIGEN, UM EINS MEINER PROBLEME ZU LÖSEN.^ VOR EIN PAAR WOCHEN SIND MEHRERE UNTOTE AUS DER GRUFT VON NEWLAKE GESTIEGEN. MEINE WACHEN HABEN SIE NOCH RECHTZEITIG ENTDECKT UND KONNTEN SO DAS SCHLIMMSTE VERHINDERN, DOCH ICH MUSSTE DIE GRUFT DARAUFHIN VERSCHLIEßEN. DAS WÄRE WEITER NICHT SCHLIMM, DOCH ES HANDELT SICH UM DIE GRABSTÄTTE DES GROßEN SHANDRA, UND VIELE LEUTE PILGERN DORTHIN.^ WAS ICH BRAUCHE SIND EIN PAAR VERTRAUENSWÜRDIGE, MUTIGE MÄNNER, DIE DORT MAL NACH DEM RECHTEN SEHEN. AH JA, ICH MERKE SCHON AN EUREN MIENEN, DASS IHR MEINE BITTE NICHT ABSCHLAGT. HIER HABT IHR DEN SCHLÜSSEL ZUR GRUFT.\""
#: AllTexts/NPC_texts.amb/030/009.txt
msgctxt "AllTexts/NPC_texts.amb/030/009"
msgid "\"THANK YOU, THANK YOU! PLEASE TAKE THIS GOLD AS A REWARD. IT WAS CERTAINLY NOT AN EASY MATTER.^ IF MASTER ROTTERMUND GAVE YOU THE PICTURE, YOU MUST BE VERY TRUSTWORTHY, FOR I KNOW HIM WELL ENOUGH. PERHAPS YOU ARE THE RIGHT ONES TO SOLVE A PROBLEM FOR ME.^ A FEW WEEKS AGO SEVERAL UNDEAD ROSE OUT OF THE CRYPT IN NEWLAKE. MY GUARDS DISCOVERED THEM IN GOOD TIME AND SO WERE ABLE TO PREVENT THE WORST FROM HAPPENING, BUT I HAD TO SEAL THE CRYPT AGAIN. THAT WOULD NOT BE A PROBLEM, BUT THE CRYPT IS THE BURIAL PLACE OF SHANDRA, AND MANY PILGRIMS WANT TO GO THERE.^ WHAT I NEED ARE A FEW TRUSTWORTHY BRAVE MEN WHO CAN CHECK WHAT IS HAPPENING THERE. OH YES, I SEE IN YOUR FACES THAT YOU WILL NOT REFUSE. HERE IS THE KEY TO THE CRYPT.\""
msgstr ""

#. Dialogue of NPC 030 (BARON KARSTEN).
#. German: "AH JA, DAS SIND DIE ERSTEN TEXTE ZU MEINEM NEUEN BUCH. ICH HOFFE ES IN WENIGEN TAGEN ZU VOLLENDEN.^ LEGT ES DOCH BITTE IN MEINE TRUHE ZURÜCK."
#: AllTexts/NPC_texts.amb/030/010.txt
msgctxt "AllTexts/NPC_texts.amb/030/010"
msgid "OH YES, THESE ARE THE FIRST TEXTS OF MY NEW BOOK. I HOPE TO FINISH IT IN A FEW DAYS.^ PLEASE PUT IT BACK IN MY CHEST."
msgstr ""

#. Dialogue of NPC 031 (S'RELI).
#. German: "IHR SEHT EINE ÄLTERE MORAG-ECHSENFRAU. SIE LÄCHELT EUCH AN - JEDENFALLS INTERPRETIERT IHR DEN AUSDRUCK IHRES ECHSENGESICHTS OPTIMISTISCHERWEISE SO."
#: AllTexts/NPC_texts.amb/031/000.txt
msgctxt "AllTexts/NPC_texts.amb/031/000"
msgid "YOU SEE AN OLDER MORAG LIZARD WOMAN. SHE SMILES AT YOU - AT LEAST YOU INTERPRET THE EXPRESSION ON HER LIZARD FACE OPTIMISTICALLY AS A SMILE."
msgstr ""

#. Dialogue of NPC 031 (S'RELI).
#. German: "\"WILLKOMMEN IN MEINEM TURM! MÖCHTET IHR EINE REITECHSE KAUFEN?\""
#: AllTexts/NPC_texts.amb/031/001.txt
msgctxt "AllTexts/NPC_texts.amb/031/001"
msgid "\"WELCOME TO MY TOWER! DO YOU WANT TO BUY A RIDING LIZARD?\""
msgstr ""

#. Dialogue of NPC 031 (S'RELI).
#. German: "\"LEBT WOHL UND MÖGE EUCH NIE DAS WASSER AUSGEHEN!\""
#: AllTexts/NPC_texts.amb/031/002.txt
msgctxt "AllTexts/NPC_texts.amb/031/002"
msgid "\"FAREWELL AND MAY YOU NEVER RUN SHORT OF WATER!\""
msgstr ""

#. Dialogue of NPC 031 (S'RELI).
#. German: "\"JA, ICH ZÜCHTE REITECHSEN. ZUR ZEIT HABE ICH EIN FRISCH AUGEBILDETES TIER ANZUBIETEN. GEBT MIR 5000 GOLD, DANN IST ES EUER!\""
#: AllTexts/NPC_texts.amb/031/003.txt
msgctxt "AllTexts/NPC_texts.amb/031/003"
msgid "\"YES, I BREED RIDING LIZARDS. I HAVE A FRESHLY-TRAINED ANIMAL AVAILABLE AT THE MOMENT. GIVE ME 5,000 PIECES OF GOLD AND IT IS YOURS!\""
msgstr ""

#. Dialogue of NPC 031 (S'RELI).
#. German: "\"AH, ICH MACHE GERNE GESCHÄFTE MIT LEUTEN, DIE NICHT FEILSCHEN. EURE REITECHSE STEHT VOR DEM TURM FÜR EUCH BEREIT.\""
#: AllTexts/NPC_texts.amb/031/004.txt
msgctxt "AllTexts/NPC_texts.amb/031/004"
msgid "\"AH, I LIKE DOING BUSINESS WITH PEOPLE WHO KNOW WHAT THEY WANT. YOUR RIDING LIZARD IS READY FOR YOU IN FRONT OF THE TOWER.\""
msgstr ""

#. Dialogue of NPC 031 (S'RELI).
#. German: "\"ES TUT MIR LEID, ABER ZUR ZEIT HABE ICH KEIN TIER ZU VERKAUFEN. VIELLEICHT KOMMT IHR IN EINEM HALBEN MOREL NOCH EINMAL WIEDER...\""
#: AllTexts/NPC_texts.amb/031/005.txt
msgctxt "AllTexts/NPC_texts.amb/031/005"
msgid "\"I AM SORRY BUT AT THE MOMENT I DO NOT HAVE AN ANIMAL FOR SALE. PERHAPS YOU CAN COME BACK IN HALF A MOREL ...\""
msgstr ""

#. Dialogue of NPC 032 (S'RIEL).
#. German: "IHR SEHT EINEN GROßEN ECHSENMANN VOR EUCH AUF DEM BODEN LIEGEN. SEINE HAUT IST FAST VOLLSTÄNDIG VON EINEM GRAUEN AUSSCHLAG BEDECKT."
#: AllTexts/NPC_texts.amb/032/000.txt
msgctxt "AllTexts/NPC_texts.amb/032/000"
msgid "YOU SEE A LARGE LIZARD MAN BEFORE YOU, LYING ON THE GROUND. HIS SKIN IS ALMOST TOTALLY COVERED BY GREY FLECKS."
msgstr ""

#. Dialogue of NPC 032 (S'RIEL).
#. German: "\"MEINE FREUNDE... - ICH HOFFE ICH DARF EUCH SO NENNEN?! VERZEIHT MIR, DENN ICH WAR ES, DER EUCH AUS DEM FLUGSCHIFFHANGAR HERAUSTELEPORTIERTE. BEVOR IHR IRGENDETWAS SAGT, HÖRT MIR BITTE ZU, DENN ICH LIEGE IM STERBEN UND MUSS EUCH NOCH VIEL ERZÄHLEN!^ ALS ERSTES MÜSST IHR WISSEN, DASS UNSERE ZIVILISATION SCHON WESENTLICH LÄNGER EXISTIERT ALS EURE AUF LYRAMION. WIR HABEN SEHR FRÜH ERKANNT, DASS MAGIE UND TECHNIK ZUSAMMEN SEHR MÄCHTIGE DINGE ERSCHAFFEN KÖNNEN. DOCH DER DARAUS RESULTIERENDE ERFOLG HAT UNS IM UMGANG MIT WASSER LEICHTFERTIG WERDEN LASSEN UND UNS LETZTENDLICH DEN UNTERGANG GEBRACHT. UNSERE WELT WAR ZWAR IMMER SCHON SEHR TROCKEN, DOCH DASS ES JETZT SO SCHLIMM UM SIE STEHT, DAS HABEN WIR NUR UNS SELBST ZU VERDANKEN. WIR HABEN DAS WASSER MIT VOLLEN HÄNDEN VERSCHWENDET, OBWOHL ES SO KNAPP WAR. MEIN JETZIGER ZUSTAND IST EIN BEWEIS DAFÜR, DASS DAS UNSER GRÖßTER FEHLER WAR.^ WENN UNSERE KÖRPER MEHR ALS EINEN TAG LANG KEIN WASSER BEKOMMEN, DANN STERBEN WIR. WIR TROCKNEN VOLLSTÄNDIG AUS UND ZERFALLEN DANN ZU STAUB UND KNOCHEN. MIR KANN MAN JETZT NICHT MEHR HELFEN. SELBST WENN ICH JETZT WASSER BEKÄME WÜRDE ICH DENNOCH STERBEN.^ DER RAT VON MORAG, DEM AUCH ICH ANGEHÖRTE, KAM DESHALB AUF DIE IDEE, ETWAS ZU ENTWICKELN, DAS ES UNS ERMÖGLICHEN WÜRDE, ZU DEN ANDEREN HIMMELSKÖRPERN ZU GELANGEN. WIR SCHAFFTEN ES, UND VOR SEHR LANGER ZEIT FLOGEN WIR AUF DEN WALDMOND. DOCH WIR MUSSTEN UNS WIEDER VON DORT ZURÜCKZIEHEN, ALS IMMER MEHR VON UNS STARBEN.^ IM WASSER DES WALDMONDS BEFINDET SICH EINE SUBSTANZ, DIE UNS LANGSAM TÖTET. FÜR EUCH MENSCHEN UND DIE ANDEREN WESEN EURER WELT IST DAS WASSER ALLERDINGS UNGEFÄHRLICH. TROTZ UNSERES WISSENS GELANG ES UNS NICHT, DAS WASSER ZU REINIGEN, UND SO ZOGEN WIR UNS WIEDER NACH MORAG ZURÜCK. HIER WURDE DANN VOR HUNDERT JAHREN DER PLAN GEFASST, LYRAMION SEINES WASSERS ZU BERAUBEN.^ WIR HABEN VOR UNGEFÄHR ZWEI JAHRZEHNTEN MIT HILFE EURER ZWERGE EINE GROßE MASCHINERIE AUF LYRAMION ERBAUT, DIE IN ALLERNÄCHSTER ZEIT DAMIT BEGINNEN WIRD, DAS WASSER VON LYRAMION NACH MORAG ZU TRANSPORTIEREN, UND DAS WIRD DER ANFANG VOM ENDE FÜR EUCH SEIN.^ IN LETZTER ZEIT BEKAM ICH MEHR UND MEHR GEWISSENSBISSE DESWEGEN, UND VOR EIN PAAR TAGEN PLÄDIERTE ICH IM RAT DAFÜR, DEN GANZEN PLAN FALLENZULASSEN. ICH SCHLUG STATTDESSEN VOR, UNS DEN LEBEWESEN AUF LYRAMION ZU ERKENNEN ZU GEBEN UND UM ASYL ZU BITTEN.^ WIE IHR SEHT, WURDEN MEINE BEDENKEN NICHT GETEILT. JETZT SEID IHR DIE LETZTE HOFFNUNG FÜR LYRAMION. IHR MÜSST VERSUCHEN, DIE MASCHINE ZU ZERSTÖREN. ALLERDINGS BEFINDET SICH DER EINGANG AUF LYRAMION HINTER EINER KRISTALLWAND, DIE NUR DURCH BESONDERE TÖNE BESEITIGT WERDEN KANN. IHR MÜSST DAZU IN DIE PALÄSTE DER RATSMITGLIEDER HIER AUF MORAG EINDRINGEN. JEDER VON UNS BESITZT EINE KRISTALLENE HARFENSAITE. IHR MÜSST EUCH ALLE SIEBEN SAITEN BESORGEN UND SIE IN EINE HARFE EINSETZEN. DIESE HARFE IST DANN IN DER LAGE, DIE KRISTALLWAND ZU ZERSTÖREN. DANACH WIRD ES NUR AN EUCH LIEGEN, OB LYRAMION ÜBERLEBEN WIRD. WENN ES EUCH GELINGT, LÄSST SICH DAS WASSERPROBLEM VIELLEICHT AUF FRIEDLICHE ART REGELN.^ AH, MEINE ZEIT KOMMT! ICH WERDE NOCH DREI DINGE FÜR EUCH TUN BEVOR ICH STERBE: ZUM EINEN WERDE ICH EUCH DIE SPRACHE DER MORANER VERMITTELN. DANN WERDE ICH EINE ILLUSION ÜBER EUCH LEGEN, DURCH DIE EUCH JEDER FÜR MORANER HALTEN WIRD, ALLERDINGS WERDEN DIE RATSMITGLIEDER DAVON NICHT ZU TÄUSCHEN SEIN. UND SCHLIEßLICH WERDE ICH EUCH IN MEINEN PALAST TELEPORTIEREN. VON DORT AUS SOLLTET IHR EURE SUCHE NACH DEN HARFENSAITEN BEGINNEN...\"^ IHR SEHT WIE S'RIEL OFFENBAR MIT LETZTER KRAFT SEINE ARME HEBT, UND SOFORT SEID IHR VON EINEM HELLEN LICHT UMGEBEN. SCHWACH HÖRT IHR NOCH EINMAL SEINE STIMME:^ \"SEID AUF DER HUT! ES KÖNNTE SEIN, DASS DIE RATSMITGLIEDER IN MEINEM PALAST EINE FALLE FÜR EUCH ERRICHTET HABEN...\""
#: AllTexts/NPC_texts.amb/032/001.txt
msgctxt "AllTexts/NPC_texts.amb/032/001"
msgid "\"MY FRIENDS ... - I HOPE I CAN CALL YOU FRIENDS?! FORGIVE ME, FOR IT WAS I WHO TELEPORTED YOU OUT OF THE AIRSHIP HANGAR. BEFORE YOU SAY ANYTHING, PLEASE LISTEN, FOR I AM DYING AND HAVE MUCH TO TELL YOU!^ THE FIRST THING YOU MUST KNOW IS THAT OUR SITUATION HAS BEEN AS IT IS ON LYRAMION FOR MUCH LONGER THAN YOURS. WE DISCOVERED AT A VERY EARLY STAGE THAT MAGIC AND TECHNOLOGY TOGETHER CAN BE VERY POWERFUL. BUT THE SUCCESS WE ACHIEVED MADE US IRRESPONSIBLE IN THE WAY WE MISUSED WATER AND FINALLY RESULTED IN OUR DOWNFALL. OUR WORLD WAS ALWAYS VERY DRY BUT IT IS OUR OWN FAULT THAT IT BECAME AS BAD AS YOU NOW SEE. WE WASTED THE WATER ALTHOUGH IT WAS SO SCARCE AND PRECIOUS. MY CONDITION TODAY IS PROOF THAT THAT WAS OUR BIGGEST MISTAKE.^ IF OUR BODIES DO NOT GET ANY WATER FOR ONE DAY, WE DIE. WE DRY OUT COMPLETELY AND DECOMPOSE INTO JUST DUST AND BONES. NO-ONE CAN HELP ME NOW. EVEN IF I WERE GIVEN WATER, I WOULD STILL DIE.^ THE COMMITTEE OF MORAG, OF WHICH I AM A MEMBER, THEREFORE HAD THE IDEA OF DEVELOPING SOMETHING WHICH WOULD MAKE IT POSSIBLE FOR US TO TRAVEL TO OTHER PLANETS. WE MANAGED IT, AND AFTER A VERY LONG TIME WE FLEW TO THE FOREST MOON. BUT WE ALSO HAD TO RETREAT FROM THERE WHEN MORE AND MORE OF US DIED.^ THE WATER ON THE FOREST MOON CONTAINS A SUBSTANCE WHICH KILLS US SLOWLY. HOWEVER, IT IS NOT DANGEROUS TO YOU HUMANS AND THE OTHER BEINGS ON YOUR WORLD. DESPITE ALL OUR KNOWLEDGE WE WERE UNABLE TO PURIFY THE WATER AND SO WE HAD TO WITHDRAW TO MORAG. THEN, A HUNDRED YEARS AGO, IT WAS DECIDED THAT WE WOULD TAKE THE WATER FROM LYRAMION.^ WITH THE HELP OF YOUR DWARFS, APPROXIMATELY TWO DECADES AGO WE BUILT A HUGE MACHINE ON LYRAMION WHICH IN THE VERY NEAR FUTURE WILL START TO TRANSPORT THE WATER FROM LYARMION TO MORAG, AND THAT WILL BE THE BEGINNING OF THE END FOR YOU.^ RECENTLY I HAVE HAD MORE AND MORE FEELINGS OF GUILT AND A FEW DAYS AGO I PLEADED WITH THE COMMITTEE THAT WE SHOULD DROP THE WHOLE PLAN. INSTEAD I SUGGESTED WE SHOULD MAKE OURSELVES KNOWN TO THE BEINGS ON LYRAMION AND ASK FOR ASYLUM.^ AS YOU SEE, THEY DID NOT SHARE MY VIEWS. NOW YOU ARE THE LAST HOPE FOR LYRAMION. YOU MUST TRY TO DESTROY THE MACHINE. BUT THE ENTRANCE ON LYRAMION IS HIDDEN BEHIND A CRYSTAL WALL WHICH CAN ONLY BE REMOVED BY CERTAIN SOUNDS. TO REACH IT, YOU MUST ENTER THE PALACES OF THE MEMBERS OF THE COMMITTEE HERE ON MORAG. EACH OF US POSSESSES A CRYSTAL HARP STRING. YOU MUST COLLECT ALL SEVEN STRINGS AND FIT THEM TO A HARP. THIS HARP IS THEN ABLE TO DESTROY THE CRYSTAL WALL. IT THEN DEPENDS SOLELY ON YOU WHETHER LYRAMION WILL SURVIVE. IF YOU SUCCEED, THE PROBLEM WITH THE WATER CAN PERHAPS BE SETTLED AMICABLY.^ OH, MY TIME IS COMING! I WILL DO THREE THINGS FOR YOU BEFORE I DIE: FIRSTLY I WILL TEACH YOU THE LANGUAGE OF THE MORANIAN. THEN I WILL PUT A SPELL ON YOU SO THAT EVERYONE WILL THINK YOU ARE MORANIAN. HOWEVER, THAT WILL NOT FOOL THE MEMBERS OF THE COMMITTEE. AND FINALLY I WILL TELEPORT YOU TO MY PALACE. FROM THERE, YOU MUST START YOUR SEARCH FOR THE HARP STRINGS ...\"^ YOU SEE HOW S'RIEL RAISES HIS ARMS, EVIDENTLY WITH ONE LAST EFFORT, AND IMMEDIATELY YOU ARE SURROUNDED BY A BRIGHT LIGHT. ONE LAST TIME YOU HEAR HIS VOICE SAYING WEAKLY:^ \"BE CAREFUL! IT COULD BE THAT MEMBERS OF THE COMMITTEE SET A TRAP FOR YOU IN MY PALACE ...\""
msgstr ""

#. Dialogue of NPC 033 (S'GOLDAR).
#. German: "IHR SEHT EINEN ALTEN, UNTERSETZTEN MORANER."
#: AllTexts/NPC_texts.amb/033/000.txt
msgctxt "AllTexts/NPC_texts.amb/033/000"
msgid "YOU SEE A LITTLE OLD MORANIAN."
msgstr ""

#. Dialogue of NPC 033 (S'GOLDAR).
#. German: "\"WILLKOMMEN EDLE MORANER! FALLS IHR WEGEN EINES SANDBOOTS GEKOMMEN SEID, DANN MUSS ICH EUCH LEIDER ENTTÄUSCHEN. ZUR ZEIT IST NUR EINS FERTIG, UND DAS IST FÜR DAS RATSMITGLIED S'KAT RESERVIERT.\""
#: AllTexts/NPC_texts.amb/033/001.txt
msgctxt "AllTexts/NPC_texts.amb/033/001"
msgid "\"WELCOME, NOBLE MORANERS! IF YOU HAVE COME FOR A SAND BOAT THEN I MUST REGRETTABLY DISAPPOINT YOU. AT THE MOMENT ONLY ONE HAS BEEN FINISHED AND THAT IS RESERVED FOR S'KAT, A MEMBER OF THE COMMITTEE.\""
msgstr ""

#. Dialogue of NPC 033 (S'GOLDAR).
#. German: "\"SEID GEGRÜßT, DIENER DES S'KAT! FALLS EUER HERR EIN WEITERES SANDBOOT HABEN MÖCHTE, SO SAGT IHM, DASS ER SICH EINIGE MOREL GEDULDEN MUSS.\""
#: AllTexts/NPC_texts.amb/033/002.txt
msgctxt "AllTexts/NPC_texts.amb/033/002"
msgid "\"WELCOME, SERVANTS OF S'KAT! IF YOUR MASTER WOULD LIKE TO HAVE ANOTHER SAND BOAT, PLEASE TELL HIM THAT HE WILL HAVE TO BE PATIENT FOR SEVERAL MORELS.\""
msgstr ""

#. Dialogue of NPC 033 (S'GOLDAR).
#. German: "\"LEBT WOHL UND MÖGE DIE SONNE EUCH NICHT KOCHEN!\""
#: AllTexts/NPC_texts.amb/033/003.txt
msgctxt "AllTexts/NPC_texts.amb/033/003"
msgid "\"FAREWELL, AND MAY THE SUN NOT COOK YOU!\""
msgstr ""

#. Dialogue of NPC 033 (S'GOLDAR).
#. German: "\"AHA, DER EDLE S'KAT SCHICKT EUCH! ICH LASSE SEIN BOOT SOGLEICH NACH DRAUßEN BRINGEN. IHR KÖNNT ES VOR DEM TURM IN EMPFANG NEHMEN.\""
#: AllTexts/NPC_texts.amb/033/004.txt
msgctxt "AllTexts/NPC_texts.amb/033/004"
msgid "\"AHA, YOU HAVE COME FROM NOBLE S'KAT! I WILL HAVE HIS BOAT TAKEN OUTSIDE. IT WILL BE READY FOR YOU IN FRONT OF THE TOWER.\""
msgstr ""

#. Dialogue of NPC 033 (S'GOLDAR).
#. German: "\"DAS SANDBOOT FÜR EUREN HERRN STEHT DRAUßEN. EIN WEITERES HABE ICH ZUR ZEIT NICHT.\""
#: AllTexts/NPC_texts.amb/033/005.txt
msgctxt "AllTexts/NPC_texts.amb/033/005"
msgid "\"THE SAND BOAT FOR YOUR MASTER IS OUTSIDE. I HAVE NO OTHERS AT THE MOMENT.\""
msgstr ""

#. Dialogue of NPC 033 (S'GOLDAR).
#. German: "\"AH JA, DAS IST DIE NACHRICHT, DIE ICH S'KAT SCHICKTE. DANN MÜSST IHR SEINE DIENER SEIN. BITTE NEHMT DAS SANDBOOT DRAUßEN VOR DEM TURM IN EMPFANG.\""
#: AllTexts/NPC_texts.amb/033/006.txt
msgctxt "AllTexts/NPC_texts.amb/033/006"
msgid "\"OH, YES, THAT IS THE MESSAGE I SENT TO S'KAT. SO YOU MUST BE HIS SERVANTS. THE SAND BOAT IS READY FOR YOU OUTSIDE IN FRONT OF THE TOWER.\""
msgstr ""

#. Dialogue of NPC 034 (S'KREL).
#. German: "IHR SEHT EINEN ALTEN MORANER VOR EUCH. ER GEHT GEBÜCKT UND HAT GROßE GRAUE FLECKEN IM GESICHT."
#: AllTexts/NPC_texts.amb/034/000.txt
msgctxt "AllTexts/NPC_texts.amb/034/000"
msgid "YOU SEE AN OLD MORANIAN. HE IS BENT OVER AND HAS LARGE GREY FLECKS ON HIS FACE."
msgstr ""

#. Dialogue of NPC 034 (S'KREL).
#. German: "\"OH EDLE MORANER, WIE KOMME ICH ZU DER EHRE, DASS IHR MEINEN BESCHEIDENEN TURM BESUCHT? ICH KANN EUCH LEIDER KEIN WASSER ANBIETEN, DA ICH MIR KEINS MEHR LEISTEN KANN. WIE IHR AN MEINEN FLECKEN SEHT, WERDE ICH IN NICHT ALLZU LANGER ZEIT STERBEN.\""
#: AllTexts/NPC_texts.amb/034/001.txt
msgctxt "AllTexts/NPC_texts.amb/034/001"
msgid "\"OH, NOBLE MORANIANS, WHY AM I HONOURED WITH YOUR VISIT TO MY MODEST TOWER? UNFORTUNATELY I CANNOT OFFER YOU ANY WATER BECAUSE I HAVE VERY LITTLE LEFT. AS YOU CAN SEE FROM MY FLECKS, I WILL NOT LIVE FOR VERY MUCH LONGER.\""
msgstr ""

#. Dialogue of NPC 034 (S'KREL).
#. German: "\"SEID GEGRÜßT! HABT IHR SCHON ETWAS MIT DER SELTSAMEN KUGEL ANFANGEN KÖNNEN?\""
#: AllTexts/NPC_texts.amb/034/002.txt
msgctxt "AllTexts/NPC_texts.amb/034/002"
msgid "\"WELCOME! HAVE YOU BEEN ABLE TO DO ANYTHING WITH THE STRANGE BALL?\""
msgstr ""

#. Dialogue of NPC 034 (S'KREL).
#. German: "\"LEBT WOHL!\""
#: AllTexts/NPC_texts.amb/034/003.txt
msgctxt "AllTexts/NPC_texts.amb/034/003"
msgid "\"FAREWELL!\""
msgstr ""

#. Dialogue of NPC 034 (S'KREL).
#. German: "ALS DER ALTE MORANER EURE WASSERFLASCHE SIEHT, HOLT ER EINE KUGEL MIT EINEM GELBEN KREUZ AUS EINER TRUHE. ER HÄLT SIE EUCH ENTGEGEN UND SAGT EINDRINGLICH:^ \"OH HIMMEL ÜBER MORAG, IHR HABT WASSER! ICH MUSS UNBEDINGT ETWAS TRINKEN, SONST IST ES MIT MIR ZU ENDE. ÜBERLASST MIR DIE FLASCHE, DANN GEBE ICH EUCH DIESE MAGISCHE KUGEL DAFÜR! SIE IST SEIT GENERATIONEN IM BESITZ MEINER FAMILIE. MEIN GROßVATER ERZÄHLTE MIR, MAN KÖNNE DAMIT EIN TOR ZU EINER WELT ÖFFNEN, IN DER SELTSAME KATZENMENSCHEN LEBEN.\""
#: AllTexts/NPC_texts.amb/034/004.txt
msgctxt "AllTexts/NPC_texts.amb/034/004"
msgid "WHEN THE OLD MORANIAN SEES YOUR WATER FLASK, HE BRINGS A BALL WITH A YELLOW CROSS OUT OF A CHEST. HE HOLDS IT OUT TO YOU AND SAYS URGENTLY:^ \"OH HEAVENS OVER MORAG, YOU HAVE SOME WATER! I MUST DRINK SOMETHING OR I WILL DIE. PLEASE LEAVE ME THE FLASK AND I WILL GIVE YOU THIS MAGIC BALL FOR IT! IT HAS BEEN IN MY FAMILY FOR GENERATIONS. MY GRANDFATHER TOLD ME IT CAN BE USED TO OPEN A DOOR INTO A DIFFERENT WORLD IN WHICH STRANGE CAT PEOPLE LIVE.\""
msgstr ""

#. Dialogue of NPC 034 (S'KREL).
#. German: "\"SEID TAUSENDFACH BEDANKT! HIER, NEHMT DAS EINZIG WERTVOLLE, DAS ICH EUCH ANBIETEN KANN! ES IST DER SCHLÜSSEL ZU EINER WELT, IN DER WESEN LEBEN, DIE HALB MENSCH UND HALB KATZE SIND, SO ERZÄHLTE JEDENFALLS MEIN GROßVATER.\"^ ER GIBT EUCH EINE KUGEL, AUF DER EIN GELBES KREUZ SCHIMMERT."
#: AllTexts/NPC_texts.amb/034/005.txt
msgctxt "AllTexts/NPC_texts.amb/034/005"
msgid "\"A THOUSAND THANKS! HERE, TAKE THE ONLY VALUABLE THING I CAN OFFER! THIS IS THE KEY TO A WORLD WHERE BEINGS WHO ARE HALF HUMAN AND HALF CATS LIVE, AT LEAST MY GRANDFATHER TOLD ME SO.\"^ HE GIVES YOU A BALL BEARING A SHIMMERING YELLOW CROSS."
msgstr ""

#. Dialogue of NPC 035 (SANDIRE).
#. German: "EINE ERSTAUNLICH HOCHGEWACHSENE ELFIN BLICKT EUCH UNSCHLÜSSIG MIT IHREN GROßEN AUGEN AN."
#: AllTexts/NPC_texts.amb/035/000.txt
msgctxt "AllTexts/NPC_texts.amb/035/000"
msgid "AN ASTONISHINGLY TALL ELF GIRL LOOKS AT YOU UNDECIDEDLY WITH WIDE EYES."
msgstr ""

#. Dialogue of NPC 035 (SANDIRE).
#. German: "\"SEID GEGRÜßT, FREMDE! BITTE VERZEIHT MIR, WENN ICH EUCH MIT EINER BITTE BELÄSTIGE!^ GESTERN ABEND WURDE ICH VON BANDITEN AUSGERAUBT UND STEHE JETZT VÖLLIG OHNE GOLD DA, DABEI MUSS ICH DRINGEND MEINE REISE FORTSETZEN. ZUM GLÜCK HABEN DIE VERBRECHER MEIN MONSTERAUGE ÜBERSEHEN, UND MIR BLEIBT JETZT NUR DIE MÖGLICHKEIT ES ZU VERKAUFEN. SEHT HIER, ES IST DIESES MAGISCHE AUGE AUS SELTENEM KYRA-STEIN. ES DIENT DAZU, EINEM ZU ZEIGEN, OB MAN VON MONSTERN VERFOLGT WIRD, DAHER DER NAME.^ HABT IHR EVENTUELL INTERESSE DARAN? FÜR 5000 GOLD WÜRDE ICH ES EUCH ÜBERLASSEN.\""
#: AllTexts/NPC_texts.amb/035/001.txt
msgctxt "AllTexts/NPC_texts.amb/035/001"
msgid "\"WELCOME, STRANGERS! PLEASE FORGIVE ME IF I TROUBLE YOU WITH A REQUEST!^ YESTERDAY EVENING I WAS ROBBED BY BANDITS AND NOW HAVE NO GOLD LEFT AT ALL. BUT I MUST URGENTLY CONTINUE MY JOURNEY. FORTUNATELY THE THIEVES OVERLOOKED MY MONSTER EYE AND MY ONLY OPPORTUNITY NOW IS TO SELL IT. LOOK HERE, THIS IS THE MAGIC EYE MADE OF THE STRANGE KYRA STONE. IT IS USED TO SHOW YOU IF YOU ARE BEING FOLLOWED BY MONSTERS, HENCE THE NAME.^ ARE YOU PERHAPS INTERESTED? I WOULD GIVE IT TO YOU FOR 5,000 PIECES OF GOLD.\""
msgstr ""

#. Dialogue of NPC 035 (SANDIRE).
#. German: "\"SCHADE! FALLS IHR ES EUCH ANDERS ÜBERLEGT: SOLANGE ICH KEINEN KÄUFER GEFUNDEN HABE, FINDET IHR MICH WOHL ODER ÜBEL HIER AUF DEN STRAßEN. LEBT WOHL!\""
#: AllTexts/NPC_texts.amb/035/002.txt
msgctxt "AllTexts/NPC_texts.amb/035/002"
msgid "\"WHAT A SHAME! IF YOU CHANGE YOUR MIND, AS LONG AS I HAVE NOT FOUND A BUYER, YOU CAN PROBABLY FIND ME HERE ON THE STREETS. FAREWELL!\""
msgstr ""

#. Dialogue of NPC 035 (SANDIRE).
#. German: "\"IHR HELFT MIR WIRKLICH AUS DER KLEMME. HIER HABT IHR DAS MONSTERAUGE! JETZT KANN ICH MEINE REISE FORTSETZEN, UND IHR WERDET NUN IMMER WISSEN, WANN EUCH GEFAHR DROHT. SEID VIELMALS BEDANKT UND LEBT WOHL!\""
#: AllTexts/NPC_texts.amb/035/003.txt
msgctxt "AllTexts/NPC_texts.amb/035/003"
msgid "\"YOU ARE REALLY HELPING ME OUT OF A DIFFICULT SITUATION. HERE IS THE MONSTER EYE! NOW I CAN CONTINUE MY JOURNEY AND YOU WILL ALWAYS KNOW IF YOU ARE IN DANGER. MANY THANKS AGAIN AND FAREWELL!\""
msgstr ""

#. Dialogue of NPC 035 (SANDIRE).
#. German: "\"ES TUT MIR LEID, ABER ICH HATTE NUR DIESES EINE MONSTERAUGE. HOFFENTLICH WIRD ES MIR AUF MEINER REISE NICHT FEHLEN - NEIN, NICHTS FÜR UNGUT, ICH BIN EUCH SEHR DANKBAR, DASS IHR ES MIR ABGEKAUFT HABT.\""
#: AllTexts/NPC_texts.amb/035/004.txt
msgctxt "AllTexts/NPC_texts.amb/035/004"
msgid "\"I AM SORRY BUT I ONLY HAD THE ONE MONSTER EYE. HOPEFULLY I WILL NOT MISS IT ON MY JOURNEY - NO, NO OFFENCE, I AM VERY GRATEFUL THAT YOU BOUGHT IT FROM ME.\""
msgstr ""

#. Dialogue of NPC 035 (SANDIRE).
#. German: "\"NOCH EINMAL VIELEN DANK DAS IHR MIR GEHOLFEN HABT. VIELLEICHT SEHEN WIR UNS IN ILLIEN WIEDER?^ BIS DAHIN LEBT WOHL!\""
#: AllTexts/NPC_texts.amb/035/005.txt
msgctxt "AllTexts/NPC_texts.amb/035/005"
msgid "\"THANK YOU AGAIN FOR HELPING ME. PERHAPS WE WILL MEET AGAIN IN ILLIEN?^ FAREWELL UNTIL THEN!\""
msgstr ""

#. Dialogue of NPC 051 (DONNER).
#. German: "\"HO, REISENDE AUS DER HEIMAT! MIT VERLAUB, ICH HÄTTE NICHT GEGLAUBT, DASS ICH MICH NOCHMAL SO ÜBER DEN ANBLICK VON EUCH LANGBEINEN FREUEN WÜRDE. ABER SEIT ES UNS AUF DIESEN KOMPOSTHAUFEN VERSCHLAGEN HAT, IST BESUCH EIN WENIG SELTEN GEWORDEN.\""
#: AllTexts/NPC_texts.amb/051/000.txt
msgctxt "AllTexts/NPC_texts.amb/051/000"
msgid "\"HELLO, TRAVELLERS FROM HOME! IN TRUTH, I WOULD NOT HAVE BELIEVED I WOULD BE SO PLEASED TO SEE YOU LONG-LEGGED PEOPLE. BUT SINCE WE HAVE BEEN IMPRISONED ON THIS COMPOST HEAP, VISITORS HAVE BEEN VERY FEW.\""
msgstr ""

#. Dialogue of NPC 051 (DONNER).
#. Placeholders: ~SELF~ = the hero (the player character). The gender of these persons is unknown.
#. German: "\"OH, ICH BIN NATÜRLICH NICHT DER EINZIGE IN DOR KIREDON, DER DEN ALTEN ZEITEN NACHTRAUERT. ABER WENN ICH AN MEINE MINE UND DIE ZEIT IN GEMSTONE ZURÜCKDENKE, PACKT MICH DIE KALTE WUT.^ WEISST DU, ~SELF~, ICH HABE SOGAR DEINEN GROßVATER KENNENGELERNT. SICHER HAT ER DIR ERZÄHLT, DASS DER ALTE DÖNNER IHM ZU EINEM STÜCK DES AMBERSTAR VERHOLFEN HAT. GLÜCKLICHE ZEITEN WAREN DAS!^ DOCH DANN KAM DER AUFBRUCH. HIMMEL, UNSERE NAIVITÄT WURDE NUR VON UNSEREM STARRSINN ÜBERTROFFEN! UND KIRE, UNSER GROßER ANFÜHRER, WAR DER STURSTE VON ALLEN! ABER ICH SOLLTE FAIR BLEIBEN. ER HAT WIRKLICH DAS BESTE AUS UNSERER SITUATION GEMACHT. AUCH IHN HAT DAS SCHICKSAL HART BESTRAFT.\""
#: AllTexts/NPC_texts.amb/051/001.txt
msgctxt "AllTexts/NPC_texts.amb/051/001"
msgid "\"OH, I AM NATURALLY NOT THE ONLY ONE IN DOR KIREDON WHO MISSES THE OLD TIMES. BUT WHEN I THINK BACK TO MY MINE AND THE TIMES IN GEMSTONE, I GET VERY ANGRY.^ DO YOU KNOW, ~SELF~, I EVEN MET YOUR GRANDFATHER. CERTAINLY HE TOLD YOU THAT OLD DONNER HELPED HIM TO FIND A PIECE OF THE AMBERSTAR. THOSE WERE HAPPY TIMES!^ BUT THEN EVERYTHING CHANGED. HEAVENS, OUR NAIVETY WAS ONLY EXCEEDED BY OUR STUBBORNESS! AND KIRE, OUR GREAT LEADER, WAS THE MOST STUBBORN OF ALL! BUT I SHOULD BE FAIR - HE REALLY DID MAKE THE BEST OF OUR SITUATION. FATE HAS PUNISHED HIM VERY SEVERELY.\""
msgstr ""

#. Dialogue of NPC 051 (DONNER).
#. German: "\"ZEHN JAHRE IST ES NUN HER, DASS SICH KIRE MIT SEINEM SOHN KETNAR ÜBERWORFEN HAT. SEHT IHR, ER IST EIN GUTER ANFÜHRER, ABER BISWEILEN KANN ER GANZ SCHÖN HERRISCH UND UNGESTÜM SEIN. ALS KETNAR DAS HAUS VERLIESS, KONNTE KIRE'S FRAU DORINA DIESEN SCHLAG NICHT VERWINDEN. KURZE ZEIT SPÄTER VERSCHWAND SIE.^ KIRE VERSUCHT ES ZU ÜBERSPIELEN, ABER ICH GLAUBE, DASS ER NOCH HEUTE SCHWER AN DIESEM VERLUST ZU TRAGEN HAT.\""
#: AllTexts/NPC_texts.amb/051/002.txt
msgctxt "AllTexts/NPC_texts.amb/051/002"
msgid "\"IT IS NOW TEN YEARS SINCE KIRE HAD THE ARGUMENT WITH HIS SON, KETNAR. YOU SEE, HE IS A GOOD LEADER BUT OCCASIONALLY HE CAN BE QUITE DEMANDING AND UNREASONABLE. WHEN KETNAR LEFT THE HOUSE, KIRE'S WIFE DORINA COULD NOT BEAR THE SHOCK. A SHORT TIME LATER SHE, TOO, DISAPPEARED.^ KIRE ATTEMPTED TO PLAY THINGS DOWN, BUT I BELIEVE HE IS TODAY STILL SUFFERING BADLY FROM HIS LOSS.\""
msgstr ""

#. Dialogue of NPC 051 (DONNER).
#. German: "\"SCHÖN, MIT EUCH GESPROCHEN ZU HABEN. VIEL GLÜCK!\""
#: AllTexts/NPC_texts.amb/051/003.txt
msgctxt "AllTexts/NPC_texts.amb/051/003"
msgid "\"NICE TO TALK TO YOU. GOOD LUCK!\""
msgstr ""

#. Dialogue of NPC 051 (DONNER).
#. German: "\"SCHÖN, EUCH WIEDERZUSEHEN! WAS KANN ICH FÜR EUCH TUN?\""
#: AllTexts/NPC_texts.amb/051/004.txt
msgctxt "AllTexts/NPC_texts.amb/051/004"
msgid "\"NICE TO SEE YOU AGAIN! WHAT CAN I DO FOR YOU?\""
msgstr ""

#. Dialogue of NPC 051 (DONNER).
#. German: "\"IHR WISST JA, WIE ICH DARÜBER DENKE.\""
#: AllTexts/NPC_texts.amb/051/005.txt
msgctxt "AllTexts/NPC_texts.amb/051/005"
msgid "\"YOU KNOW WHAT I THINK ABOUT THAT.\""
msgstr ""

#. Dialogue of NPC 051 (DONNER).
#. German: "\"NUN, WIE SCHON GESAGT: MEINER MEINUNG NACH IST KIRE'S TRAUER ÜBER DEN BRUCH MIT SEINER FAMILIE IMMER NOCH TIEF.\""
#: AllTexts/NPC_texts.amb/051/006.txt
msgctxt "AllTexts/NPC_texts.amb/051/006"
msgid "\"WELL, AS WE ALREADY SAID, IN MY OPINION KIRE'S SADNESS ABOUT THE AGGRAVATION WITH HIS FAMILY IS STILL VERY CONSIDERABLE.\""
msgstr ""

#. Dialogue of NPC 051 (DONNER).
#. German: "VOR EUCH STEHT EIN ÄLTERER ZWERG. SEINE KRÄFTIGEN HÄNDE ZEUGEN VON EINEM LEBEN VOLLER HARTER ARBEIT."
#: AllTexts/NPC_texts.amb/051/007.txt
msgctxt "AllTexts/NPC_texts.amb/051/007"
msgid "BEFORE YOU STANDS AN OLDER DWARF. HIS STRONG HANDS SHOW HE HAS HAD A LIFE OF HARD WORK."
msgstr ""

#. Dialogue of NPC 052 (DOREB).
#. German: "EIN KAHLKÖPFIGER ZWERG MIT KRÄFTIGEN LACHFÄLTCHEN UM DIE AUGEN BLINZELT EUCH AN."
#: AllTexts/NPC_texts.amb/052/000.txt
msgctxt "AllTexts/NPC_texts.amb/052/000"
msgid "A BALD-HEADED DWARF WITH DEEP LINES OF LAUGHTER AROUND HIS EYES SMILES AT YOU."
msgstr ""

#. Dialogue of NPC 052 (DOREB).
#. German: "\"AH, DIE BERÜHMTEN REISENDEN! ICH HEIßE EUCH WILLKOMMEN IM GASTHOF GEMSTONE! EURE LANDUNG HAT WAHRLICH FÜR EINE MENGE AUFREGUNG GESORGT. MEINE GÄSTE SIND AUF MONATE HINAUS MIT GESPRÄCHSSTOFF VERSORGT!\""
#: AllTexts/NPC_texts.amb/052/001.txt
msgctxt "AllTexts/NPC_texts.amb/052/001"
msgid "\"OH, THE FAMOUS TRAVELLERS! WELCOME TO THE GEMSTONE INN! YOUR ARRIVAL HAS CAUSED GREAT EXCITEMENT. MY GUESTS WILL TALK ABOUT THIS FOR MANY MONTHS!\""
msgstr ""

#. Dialogue of NPC 052 (DOREB).
#. German: "\"DORINA HAT DAMALS VORGESCHLAGEN, UNSER HAUS NACH UNSERER ALTEN HEIMATSTADT ZU BENENNEN. MEINE FRAU UND ICH VERSUCHEN, DEN GÄSTEN ETWAS VON DER FRÖHLICHKEIT VERGANGENER TAGE WIEDERZUGEBEN.\""
#: AllTexts/NPC_texts.amb/052/002.txt
msgctxt "AllTexts/NPC_texts.amb/052/002"
msgid "\"DORINA SUGGESTED AT THAT TIME THAT WE SHOULD NAME OUR HOUSE AFTER OUR OLD HOME TOWN. MY WIFE AND I TRY TO GIVE OUR GUESTS SOMETHING OF THE HAPPINESS OF BYGONE TIMES.\""
msgstr ""

#. Dialogue of NPC 052 (DOREB).
#. German: "\"ACH SO, DORINA IST EINE KUSINE VON MIR, UND SIE IST, ODER BESSER WAR, KIRE'S FRAU. ES IST EINE SCHLIMME SACHE PASSIERT ZWISCHEN DEN BEIDEN, DAS IST JETZT SCHON ÜBER ZEHN JAHRE HER.^ BEVOR SIE VERSCHWAND, BESUCHTE SIE UNS OFT, WENN AUCH VORWIEGEND, UM MIT MEINEM DAMALS NEUGEBORENEN SOHN ZU SPIELEN. DIE GANZE SACHE IST EIN HERBER VERLUST FÜR UNS ALLE. NICHT NUR, DASS DORINA DIE LIEBENSWÜRDIGKEIT IN PERSON WAR - UNTER UNS, SIE WAR DIE BEGABTESTE MAGIERIN, DIE UNSER VOLK SEIT LANGEM HERVORGEBRACHT HAT.^ IHR SOLLTET MIT DEM ALTEN BROG ÜBER SIE SPRECHEN. ER IST NUN DER EINZIGE VON UNS, DER ÜBER KENNTNISSE DER GEHEIMEN KÜNSTE VERFÜGT. BROG IST EIN HÄUFIGER GAST BEI UNS, IHR WERDET IHN ABENDS HIER ANTREFFEN.\""
#: AllTexts/NPC_texts.amb/052/003.txt
msgctxt "AllTexts/NPC_texts.amb/052/003"
msgid "\"SO, DORINA IS A COUSIN OF MINE AND IS, OR BETTER WAS, KIRE'S WIFE. WHAT HAPPENED BETWEEN THEM WAS VERY UNFORTUNATE. IT TOOK PLACE MORE THAN TEN YEARS AGO.^ BEFORE SHE DISAPPEARED, SHE VISITED US VERY OFTEN, EVEN IF MAINLY TO PLAY WITH MY NEWBORN BABY SON. THE WHOLE THING IS A SAD LOSS FOR US ALL. NOT JUST THAT DORINA WAS A WONDERFUL PERSON - IN CONFIDENCE SHE WAS ALSO THE MOST GIFTED MAGICIAN OUR PEOPLE HAVE PRODUCED FOR MANY MANY YEARS.^ YOU OUGHT TO TALK TO OLD BROG ABOUT HER. HE IS NOW THE ONLY ONE OF US WHO KNOWS ABOUT THE SECRET ARTS. BROG IS A FREQUENT VISITOR HERE, YOU CAN MEET HIM IN THE EVENINGS.\""
msgstr ""

#. Dialogue of NPC 052 (DOREB).
#. German: "\"GEHABT EUCH WOHL! ICH HOFFE, EUCH BALD WIEDER BEI MIR BEGRÜßEN ZU KÖNNEN!\""
#: AllTexts/NPC_texts.amb/052/004.txt
msgctxt "AllTexts/NPC_texts.amb/052/004"
msgid "\"FAREWELL! I HOPE TO BE ABLE TO WELCOME YOU AGAIN HERE VERY SOON!\""
msgstr ""

#. Dialogue of NPC 052 (DOREB).
#. German: "\"ICH FREUE MICH, EUCH WIEDER BEI UNS ZU SEHEN!\""
#: AllTexts/NPC_texts.amb/052/005.txt
msgctxt "AllTexts/NPC_texts.amb/052/005"
msgid "\"I LOOK FORWARD TO SEEING YOU HERE AGAIN!\""
msgstr ""

#. Dialogue of NPC 052 (DOREB).
#. German: "\"WIR SIND NOCH IMMER DAS BESTE HAUS DER STADT. HA, HA, JA, HÖRT AUF! KOMMT MIR NICHT DAMIT, DASS WIR SCHLIEßLICH AUCH DAS EINZIGE SIND!\""
#: AllTexts/NPC_texts.amb/052/006.txt
msgctxt "AllTexts/NPC_texts.amb/052/006"
msgid "\"THIS IS STILL THE BEST TAVERN IN THE TOWN. HA, HA, YES, STOP! YOU DON'T NEED TO MENTION THAT WE ARE ALSO THE ONLY TAVERN HERE!\""
msgstr ""

#. Dialogue of NPC 052 (DOREB).
#. German: "\"JA, ICH WÜSSTE ZU GERN, WAS AUS IHR GEWORDEN IST. ICH HOFFE, BROG HAT EUCH WEITERHELFEN KÖNNEN.\""
#: AllTexts/NPC_texts.amb/052/007.txt
msgctxt "AllTexts/NPC_texts.amb/052/007"
msgid "\"YES, I WOULD LIKE TO KNOW WHAT HAPPENED TO HER. I HOPE BROG HAS BEEN ABLE TO HELP YOU FURTHER.\""
msgstr ""

#. Dialogue of NPC 052 (DOREB).
#. German: "\"WIR HABEN ES GESCHAFFT, AUS EINHEIMISCHEN PFLANZEN ECHTES ZWERGENBIER ZU BRAUEN! ES IST UNSER FAMILIENGEHEIMNIS. PROBIERT ES NUR!\""
#: AllTexts/NPC_texts.amb/052/008.txt
msgctxt "AllTexts/NPC_texts.amb/052/008"
msgid "\"WE HAVE MANAGED TO BREW SOME REAL DWARF ALE FROM A FEW OF THE PLANTS HERE. THIS IS OUR FAMILY SECRET. TRY SOME!\""
msgstr ""

#. Dialogue of NPC 052 (DOREB).
#. German: "\"IM NORDWESTLICHEN RAUM DES HAUSES KÖNNT IHR EUCH FÜR EINE ÜBERNACHTUNG EINTRAGEN.\""
#: AllTexts/NPC_texts.amb/052/009.txt
msgctxt "AllTexts/NPC_texts.amb/052/009"
msgid "\"IN THE NORTH WEST ROOM OF THE HOUSE YOU CAN REGISTER TO STAY HERE OVERNIGHT.\""
msgstr ""

#. Dialogue of NPC 052 (DOREB).
#. German: "\"ICH MÖCHTE EUCH IN NAMEN MEINER FAMILIE UNSEREN GANZ PERSÖNLICHEN DANK BEKUNDEN. DIE RÜCKKEHR DORINA'S IST EUCH ZU VERDANKEN, UND DAS WERDEN WIR NIE VERGESSEN!\""
#: AllTexts/NPC_texts.amb/052/010.txt
msgctxt "AllTexts/NPC_texts.amb/052/010"
msgid "\"I WOULD LIKE TO THANK YOU ON BEHALF OF MY ENTIRE FAMILY. IT IS THANKS TO YOU THAT DORINA HAS BEEN RETURNED TO US AND WE WILL NEVER FORGET THAT!\""
msgstr ""

#. Dialogue of NPC 053 (DARBOG).
#. German: "VOR EUCH STEHT EIN ROBUSTER ZWERG. ER IST IN STOFF UND LEDER GEKLEIDET, UND SEIN GESICHT IST SONNENGEBRÄUNT."
#: AllTexts/NPC_texts.amb/053/000.txt
msgctxt "AllTexts/NPC_texts.amb/053/000"
msgid "BEFORE YOU STANDS A ROTUND DWARF. HE IS DRESSED IN LEATHER AND CLOTH AND HIS FACE IS SUNBURNT."
msgstr ""

#. Dialogue of NPC 053 (DARBOG).
#. German: "\"GRÜßE, ABENTEURER! AUCH WIR IN DOR GRESTIN HABEN VON EURER LANDUNG VERNOMMEN.\""
#: AllTexts/NPC_texts.amb/053/001.txt
msgctxt "AllTexts/NPC_texts.amb/053/001"
msgid "\"WELCOME, ADVENTURERS! EVEN HERE IN DOR GRESTIN WE HEARD OF YOUR ARRIVAL.\""
msgstr ""

#. Dialogue of NPC 053 (DARBOG).
#. German: "\"ICH BIN HÄNDLER IN LEBENSMITTELN UND KOMME VON DORT. EINE WUNDERSCHÖNE STADT, KEINE FESTUNG WIE DOR KIREDON. LICHT, LUFT UND LEBEN! IHR SOLLTET DOR GRESTIN UNBEDINGT BESUCHEN! ES LIEGT SÜDWESTLICH VON HIER. ABER NEHMT EUCH IN ACHT, DIE WÄLDER SIND NICHT UNGEFÄHRLICH!\""
#: AllTexts/NPC_texts.amb/053/002.txt
msgctxt "AllTexts/NPC_texts.amb/053/002"
msgid "\"I SELL FOOD AND COME FROM THERE. IT IS A BEAUTIFUL TOWN, NOT A FORTRESS LIKE DOR KIREDON. LIGHT, AIR AND LIFE! YOU SHOULD DEFINITELY VISIT DOR GRESTIN! IT LIES TO THE SOUTH WEST OF HERE. BUT TAKE CARE, THE FORESTS ARE NOT EXACTLY SAFE!\""
msgstr ""

#. Dialogue of NPC 053 (DARBOG).
#. German: "\"WAR EIN NETTES GESPRÄCH, VIEL GLÜCK AUF EUREN WEGEN!\""
#: AllTexts/NPC_texts.amb/053/003.txt
msgctxt "AllTexts/NPC_texts.amb/053/003"
msgid "\"IT WAS NICE TO CHAT. GOOD LUCK ON YOUR TRAVELS!\""
msgstr ""

#. Dialogue of NPC 053 (DARBOG).
#. German: "\"DA SEID IHR JA WIEDER, ICH GRÜßE EUCH!\""
#: AllTexts/NPC_texts.amb/053/004.txt
msgctxt "AllTexts/NPC_texts.amb/053/004"
msgid "\"THERE YOU ARE AGAIN, WELCOME!\""
msgstr ""

#. Dialogue of NPC 053 (DARBOG).
#. German: "\"UNSERE GRÜNE STADT! ICH HOFFE, IHR HABT DOR GRESTIN EINEN BESUCH ABGESTATTET?!\""
#: AllTexts/NPC_texts.amb/053/005.txt
msgctxt "AllTexts/NPC_texts.amb/053/005"
msgid "\"OUR GREEN TOWN! I HOPE YOU VISITED DOR GRESTIN?!\""
msgstr ""

#. Dialogue of NPC 053 (DARBOG).
#. German: "\"DIE TORNAKS? NATÜRLICH KENNE ICH DIE BIESTER. EINE WAHRE PLAGE! WIR HATTEN AUCH IN DER GEGEND VON DOR GRESTIN EINIGE OPFER, BIS WIR ETWAS ENTDECKTEN, WAS UNS DIE VIECHER VOM LEIB HÄLT: JEDER VON UNS NIMMT AUF WEITE REISEN EIN TORNAK-EI MIT. SIE GREIFEN DANN TATSÄCHLICH NICHT AN; OFFENSICHTLICH WOLLEN SIE DAS EI NICHT GEFÄHRDEN.\""
#: AllTexts/NPC_texts.amb/053/006.txt
msgctxt "AllTexts/NPC_texts.amb/053/006"
msgid "\"THE TORNAKS? NATURALLY I KNOW THOSE BEASTS. A REAL PLAGUE! WE HAD SOME VICTIMS EVEN NEAR DOR GRESTIN, UNTIL WE DISCOVERED SOMETHING WHICH KEEPS THE BEASTS AWAY: EACH OF US TAKES A TORNAK EGG WITH US ON LONG JOURNEYS. THIS ACTUALLY STOPS THEM ATTACKING US. APPARENTLY THEY DO NOT WANT TO RISK DAMAGING THE EGG.\""
msgstr ""

#. Dialogue of NPC 053 (DARBOG).
#. German: "\"JA, AUCH ICH HABE IMMER EINS DER EIER DABEI. ES FÄLLT MIR SCHWER, ABER ICH MUSS EUCH UM VERSTÄNDNIS DAFÜR BITTEN, DASS ICH ES EUCH NICHT GEBEN KANN. MEINE RÜCKREISE WÄRE SONST ZU GEFÄHRLICH.\""
#: AllTexts/NPC_texts.amb/053/007.txt
msgctxt "AllTexts/NPC_texts.amb/053/007"
msgid "\"YES, I, TOO, ALWAYS HAVE ONE OF THOSE EGGS WITH ME. IT IS DIFFICULT, BUT I MUST ASK YOU TO UNDERSTAND I CANNOT GIVE YOU THE EGG. MY RETURN JOURNEY WOULD OTHERWISE BE TOO DANGEROUS.\""
msgstr ""

#. Dialogue of NPC 053 (DARBOG).
#. German: "\"DAS IST MEHR, ALS ICH SONST IM JAHR VERDIENE! VERDAMMT, IHR HABT MICH! ICH WERDE WOHL AUFPASSEN MÜSSEN, WO ICH MEINE FÜßE HINSETZE. NEHMT DAS EI!\""
#: AllTexts/NPC_texts.amb/053/008.txt
msgctxt "AllTexts/NPC_texts.amb/053/008"
msgid "\"THAT IS MORE THAN I EARN IN A WHOLE YEAR! DAMN, YOU HAVE GOT ME! I WILL PROBABLY HAVE TO WATCH WHERE I PUT MY FEET. TAKE THE EGG!\""
msgstr ""

#. Dialogue of NPC 053 (DARBOG).
#. German: "\"ICH HABE EUCH MEIN EI BEREITS VERKAUFT, UND MEHR ALS EINS NEHME ICH NIE MIT. WENN ICH'S RECHT BEDENKE, SOLLTE ICH DIE DINGER VIELLEICHT IN MEIN ANGEBOT AUFNEHMEN...\""
#: AllTexts/NPC_texts.amb/053/009.txt
msgctxt "AllTexts/NPC_texts.amb/053/009"
msgid "\"I HAVE SOLD YOU MY EGG, AND I NEVER TAKE MORE THAN ONE WITH ME. WHEN I THINK ABOUT IT, I SHOULD PERHAPS INCLUDE THOSE THINGS IN MY SALES OFFERS ...\""
msgstr ""

#. Dialogue of NPC 054 (BROG).
#. German: "EIN ALTER ZWERG. ER MACHT EHER DEN EINDRUCK EINES GELEHRTEN ALS DEN EINES PENSIONIERTEN MINENARBEITERS."
#: AllTexts/NPC_texts.amb/054/000.txt
msgctxt "AllTexts/NPC_texts.amb/054/000"
msgid "AN OLD DWARF. HE GIVES THE IMPRESSION OF BEING A LEARNED SCHOLAR RATHER THAN A RETIRED MINE WORKER."
msgstr ""

#. Dialogue of NPC 054 (BROG).
#. German: "\"SEID GEGRÜßT, LUFTSCHIFFREISENDE! WIEDER IST DIESE EINDRUCKSVOLLE MAGIE MISSBRAUCHT WORDEN, UM UNSCHULDIGE ZUM EWIGEN EXIL AUF DIESEN MOND ZU VERBANNEN.\""
#: AllTexts/NPC_texts.amb/054/001.txt
msgctxt "AllTexts/NPC_texts.amb/054/001"
msgid "\"WELCOME, AIRSHIP TRAVELLERS! THIS IMPRESSIVE MAGIC HAS BEEN ABUSED AGAIN TO BAN INNOCENT PEOPLE TO ETERNAL EXILE ON THIS MOON.\""
msgstr ""

#. Dialogue of NPC 054 (BROG).
#. German: "\"MEINE BESTEN WÜNSCHE BEGLEITEN EUCH.\""
#: AllTexts/NPC_texts.amb/054/002.txt
msgctxt "AllTexts/NPC_texts.amb/054/002"
msgid "\"I WISH YOU THE VERY BEST.\""
msgstr ""

#. Dialogue of NPC 054 (BROG).
#. German: "\"AH, DIE MAGIE! DIE FASZINATION DES GEHEIMEN WISSENS! WIE IHR MERKT, TEILE ICH NICHT DIE AUFFASSUNG MEINER VEREHRTEN MITBÜRGER: DIE MEISTEN HALTEN ZAUBEREI ALLER ART FÜR EINE UNWÜRDIGE KUNST ODER BRINGEN IHR BESTENFALLS IGNORANZ ENTGEGEN.^ WIE ICH MICH NACH EINEM ERFAHRUNGSAUSTAUSCH MIT KOMPETENTEN FACHLEUTEN SEHNE!\"^ ~INK 30~ ER BEGINNT EINE REGE KONVERSATION MIT DEN MAGIERN DER GRUPPE."
#: AllTexts/NPC_texts.amb/054/003.txt
msgctxt "AllTexts/NPC_texts.amb/054/003"
msgid "\"OH, THE MAGIC! THE FASCINATION OF SECRET KNOWLEDGE! AS YOU CAN SEE, I DO NOT SHARE THE OPINION HELD BY MY HONOURED ASSOCIATES: MOST OF THEM THINK ANY KIND OF MAGIC IS NOT A WORTHY ART-FORM AND AT BEST THEY TREAT IT WITH TOTAL DISDAIN.^ HOW I LONG FOR AN EXCHANGE OF INFORMATION WITH COMPETENT SPECIALISTS!\"^ ~INK 30~ HE BEGINS AN EXCITED CONVERSATION WITH THE MAGICIANS IN THE GROUP."
msgstr ""

#. Dialogue of NPC 054 (BROG).
#. German: "\"DORINA'S FORTGANG TRAF MICH TIEF, BESONDERS, DA MEIN BRUDER, DER HEILER, ZUR GLEICHEN ZEIT NACH DOR GRESTIN GING. IHR MÜSST WISSEN, DASS DORINA EINE IN UNSEREM VOLK UNGEWÖHNLICH STARKE BEGABUNG FÜR ILLUSIONSMAGIE HAT.^ IHR TALENT ENTWICKELTE SICH SO WEIT, DASS SIE DAUERHAFTE ILLUSIONSBILDER HERVORRUFEN KONNTE. NACHDEM SIE MIT MIR ZUSAMMEN GEÜBT HATTE, ZEIGTE SICH SOGAR, DASS SIE BEI VOLLER KONZENTRATION REALE MATERIE MAGISCH ZU ERSCHAFFEN VERMOCHTE. KIRE HASSTE MICH DAFÜR, ABER DA ICH SOWIESO ALS SELTSAMER KAUZ GELTE, KONNTE ER MICH SCHWER UNTER DRUCK SETZEN.^ WAS IST NUR AUS DORINA GEWORDEN? UNSER UNGLÜCK REIßT NICHT AB, SEIT WIR AUF DIESEM VERWÜNSCHTEN HIMMELSKÖRPER GESTRANDET SIND.\""
#: AllTexts/NPC_texts.amb/054/004.txt
msgctxt "AllTexts/NPC_texts.amb/054/004"
msgid "\"DORINA'S DEPARTURE DISTURBED ME DEEPLY, ESPECIALLY AS MY BROTHER, THE HEALER, WENT TO DOR GRESTIN AT THE SAME TIME. YOU SHOULD KNOW THAT DORINA HAS AN UNUSUALLY WELL DEVELOPED GIFT FOR MAGIC SPELLS AMONGST OUR PEOPLE.^ HER TALENT EXTENDED SO FAR THAT SHE COULD CREATE CONTINUOUS ILLUSIONS AND IMAGES. AFTER SHE PRACTISED WITH ME IT BECAME CLEAR THAT IF SHE CONCENTRATED TOTALLY SHE COULD ACTUALLY PRODUCE REAL MATERIALS BY MAGIC. KIRE HATED ME FOR THAT BUT SINCE THEY THINK I AM WEIRD ANYWAY, IT WAS DIFFICULT FOR HIM TO PUT PRESSURE ON ME.^ WHAT HAS BECOME OF DORINA NOW? OUR UNHAPPINESS CONTINUES SINCE WE WERE STRANDED ON THIS DAMN PLANET.\""
msgstr ""

#. Dialogue of NPC 054 (BROG).
#. German: "\"IHR WISST JA VON MEINER LEIDENSCHAFT FÜR DIE MAGIE. WIE SCHADE, DASS SO WENIGE MEINER MITBÜRGER SIE TEILEN!\""
#: AllTexts/NPC_texts.amb/054/005.txt
msgctxt "AllTexts/NPC_texts.amb/054/005"
msgid "\"YOU KNOW ABOUT MY LOVE FOR MAGIC. WHAT A SHAME THAT SO FEW OF THE PEOPLE HERE FEEL THE SAME!\""
msgstr ""

#. Dialogue of NPC 054 (BROG).
#. German: "\"WIE FROH WÄRE ICH, WENN DORINA ZU UNS ZURÜCKKEHRTE!\""
#: AllTexts/NPC_texts.amb/054/006.txt
msgctxt "AllTexts/NPC_texts.amb/054/006"
msgid "\"HOW HAPPY I WOULD BE IF DORINA RETURNED TO US!\""
msgstr ""

#. Dialogue of NPC 054 (BROG).
#. German: "\"MEINE FREUNDE, MEINE FREUDE ÜBER DORINA'S RÜCKKEHR IST MINDESTENS SO GROß WIE DIE VON KIRE! UND WIE ENORM SICH IHR TALENT ENTWICKELT HAT! WIE ICH HÖRTE, HATTET IHR DADURCH EINIGE PROBLEME...\""
#: AllTexts/NPC_texts.amb/054/007.txt
msgctxt "AllTexts/NPC_texts.amb/054/007"
msgid "\"MY FRIENDS, MY PLEASURE ABOUT DORINA RETURNING TO US IS AT LEAST AS GREAT AS KIRE'S! AND HOW SHE HAS DEVELOPED HER TALENTS! TREMENDOUSLY WELL! AS I HEARD, YOU HAD A FEW PROBLEMS BECAUSE OF THAT ...\""
msgstr ""

#. Dialogue of NPC 054 (BROG).
#. German: "\"JA, DIE STADT UNSERER NATURFREUNDE. DORT IST NUN MEIN BRUDER UND ERFORSCHT DIE HEILKRÄFTE DER EINHEIMISCHEN FLORA.\""
#: AllTexts/NPC_texts.amb/054/008.txt
msgctxt "AllTexts/NPC_texts.amb/054/008"
msgid "\"YES, THE TOWN OF OUR FRIENDS OF NATURE. MY BROTHER IS THERE NOW AND IS RESEARCHING THE HEALING FORCES OF THE LOCAL FLORA.\""
msgstr ""

#. Dialogue of NPC 055 (KIRE).
#. German: "EIN ROTBÄRTIGER ZWERG BLICKT EUCH UNTER SEINEM HELM HERVOR AN. ER TRÄGT EINE BLITZENDE, VOLLSTÄNDIGE ZEREMONIENRÜSTUNG."
#: AllTexts/NPC_texts.amb/055/000.txt
msgctxt "AllTexts/NPC_texts.amb/055/000"
msgid "A RED-BEARDED DWARF LOOKS AT YOU FROM UNDER HIS HELMET. HE IS WEARING A BRIGHTLY COLOURED CEREMONIAL UNIFORM."
msgstr ""

#. Dialogue of NPC 055 (KIRE).
#. Placeholders: ~SELF~ = the hero (the player character). The gender of these persons is unknown.
#. German: "\"WIE ICH SEHE, SEID IHR MEINER EINLADUNG GEFOLGT. ICH GRÜßE EUCH! HOFFENTLICH HADERT IHR NICHT MIT EUCH SELBST. DER GEDANKE DARAN, DEN REST EURES LEBENS HIER ZU VERBRINGEN, DARF EUCH NICHT VERZWEIFELN LASSEN! NUN BERICHTET MIR BITTE, WAS IN ALL DEN JAHREN AUF LYRAMION GESCHEHEN IST!\"^ ~INK 30~ ~SELF~ UND DIE ANDEREN ERZÄHLEN VON DEN GESCHEHNISSEN UND ABENTEUERN AUF DEN LYRAMIONISCHEN INSELN. KIRE NIMMT ALLES BEGIERIG IN SICH AUF UND SAGT ANSCHLIEßEND MIT KRATZIGER STIMME:^ ~INK 31~ \"WENN NUR DORINA DAS MITERLEBEN KÖNNTE!\""
#: AllTexts/NPC_texts.amb/055/001.txt
msgctxt "AllTexts/NPC_texts.amb/055/001"
msgid "\"AS I SEE, YOU ACCEPTED MY INVITATION. WELCOME! HOPEFULLY YOU HAVE NOT BEEN DELAYED. THE THOUGHT OF SPENDING THE REST OF YOUR LIFE HERE SHOULD NOT MAKE YOU DOUBT ANYTHING! BUT TELL ME WHAT HAS HAPPENED ON LYRAMION ALL THESE YEARS!\"^ ~INK 30~ ~SELF~ AND THE OTHERS TELL OF THE HAPPENINGS AND ADVENTURES ON THE ISLANDS OF LYRAMION. KIRE LISTENS TO EVERYTHING WITH GREAT INTEREST AND THEN SAYS IN A HOARSE VOICE:^ ~INK 31~ \"IF ONLY DORINA COULD EXPERIENCE THIS WITH US!\""
msgstr ""

#. Dialogue of NPC 055 (KIRE).
#. German: "\"SIE IST DER EIGENTLICHE GRUND, WARUM ICH MIT EUCH SPRECHEN WOLLTE. DOCH VORHER MÖCHTE ICH DARAUF HINWEISEN, DASS DIES EINE PRIVATANGELEGENHEIT IST: ICH VERLANGE STRENGSTE DISKRETION; NIEMAND DARF VON DIESEM GESPRÄCH ERFAHREN!^ DORINA IST MEINE FRAU. VOR NUNMEHR ZEHN JAHREN VERSCHWAND SIE UNTER RÄTSELHAFTEN UMSTÄNDEN, ABER ICH HABE ANHALTSPUNKTE DAFÜR, DASS SIE NOCH LEBT. MAN HAT SIE IN DEN WÄLDERN HINTER DEN SÜMPFEN SÜDLICH VON DOR GRESTIN, DIESEM UNKRAUTÜBERWUCHERTEN DORF, GESEHEN.^ ICH MÖCHTE, DASS IHR SIE AUSFINDIG MACHT UND IHR DIESE NACHRICHT ÜBERGEBT. HABT IHR ERFOLG, SO SOLL ES EUER SCHADEN NICHT SEIN!\"^ ~INK 30~ MIT DIESEN WORTEN ÜBERREICHT EUCH KIRE EINEN VERSIEGELTEN UMSCHLAG. EURE VORSICHTIGEN FRAGEN NACH DEN NÄHEREN UMSTÄNDEN VON DORINA'S VERSCHWINDEN BEANTWORTET ER MIT SCHWEIGENDEM KOPFSCHÜTTELN."
#: AllTexts/NPC_texts.amb/055/002.txt
msgctxt "AllTexts/NPC_texts.amb/055/002"
msgid "\"SHE IS THE REAL REASON WHY I WANTED TO SPEAK TO YOU. BUT FIRST I MUST POINT OUT THAT THIS IS A PRIVATE MATTER: I MUST DEMAND THE STRICTEST DISCRETION: NO-ONE MAY HEAR OF THIS CONVERSATION!^ DORINA IS MY WIFE. TEN YEARS AGO SHE DISAPPEARED UNDER STRANGE CIRCUMSTANCES BUT I HAVE FOUND EVIDENCE THAT SHE IS STILL ALIVE. SHE HAS BEEN SEEN IN THE FORESTS BEHIND THE SWAMPS TO THE SOUTH OF DOR GRESTIN, THAT VILLAGE COVERED IN WEEDS.^ I WOULD LIKE YOU TO FIND HER AND GIVE HER THIS MESSAGE. IF YOU ARE SUCCESSFUL, I WILL REWARD YOU HIGHLY!\"^ ~INK 30~ WITH THESE WORDS KIRE HANDS YOU A SEALED ENVELOPE. YOUR CAREFUL QUESTIONS ABOUT THE CIRCUMSTANCES OF DORINA'S DISAPPEARANCE ARE ANSWERED BY ONLY A SILENT SHAKE OF HIS HEAD."
msgstr ""

#. Dialogue of NPC 055 (KIRE).
#. German: "\"SEID GEGRÜßT! ICH HOFFE, IHR BEFASST EUCH MIT MEINER KLEINEN BITTE.\""
#: AllTexts/NPC_texts.amb/055/003.txt
msgctxt "AllTexts/NPC_texts.amb/055/003"
msgid "\"WELCOME! I HOPE YOU CAN COMPLY WITH MY LITTLE REQUEST.\""
msgstr ""

#. Dialogue of NPC 055 (KIRE).
#. German: "\"ES IST GESAGT, WAS ES ZU SAGEN GIBT. SUCHT SIE UND GEBT IHR DIE NACHRICHT!\""
#: AllTexts/NPC_texts.amb/055/004.txt
msgctxt "AllTexts/NPC_texts.amb/055/004"
msgid "\"WHAT IS TO BE SAID, HAS ALREADY BEEN SAID. FIND HER AND GIVE HER THE MESSAGE!\""
msgstr ""

#. Dialogue of NPC 055 (KIRE).
#. German: "~INK 30~ EIN VERÄNDERTER KIRE STEHT VOR EUCH. SEINE AUGEN SCHEINEN ZU LEUCHTEN, UND ER BEWEGT SICH LEICHT UND SCHWUNGVOLL. ER SAGT:^ ~INK 31~ \"MEINE FREUNDE! LASST EUCH DAFÜR DANKEN, DASS IHR MIT DORINA DIE FREUDE IN MEIN LEBEN ZURÜCKGEBRACHT HABT! UM MICH ERKENNTLICH ZU ZEIGEN, KANN ICH EUCH NUR ZWEI KLEINE SCHLÜSSEL BIETEN. DER EINE FÜHRT ZU MEINER SCHATZKAMMER: NEHMT, WAS EUCH GEFÄLLT!^ DER ANDERE SCHLÜSSEL ÖFFNET DAS TOR ZU UNSERER VERSUCHSMINE. ICH ÜBERLASSE IHN EUCH ZUSAMMEN MIT EINER SEHR VERTRAULICHEN INFORMATION. VOR EINIGEN TAGEN ENTDECKTEN WIR BEI NEUEN PROBEGRABUNGEN EIN TOR AUS MASSIVEM METALL. ALLE ÖFFNUNGSVERSUCHE BLIEBEN ERFOLGLOS, UND WEITERE GRABUNGEN WURDEN DURCH DIE INVASION DER TORNAKS IN DEN MINEN VERHINDERT. SCHAUT EUCH DAS TOR AN, WENN IHR WOLLT, VIELLEICHT KOMMT IHR HINTER SEIN GEHEIMNIS.\"^ ~INK 30~ KIRE'S AUSDRUCK WIRD FÜR EINEN MOMENT ETWAS ERNSTER.^ ~INK 31~ \"ICH WEISS, DASS IHR DIE HOFFNUNG NOCH NICHT AUFGEGEBEN HABT, DIESEN MOND WIEDER ZU VERLASSEN. JEDEN ANDEREN WÜRDE ICH FÜR DEN BLOßEN GEDANKEN VERHÖHNEN, ABER IHR SEID UNGEWÖHNLICHE LEUTE.^ MIR IST WOHL BEWUSST, DASS EUER KLEINES LUFTSCHIFF NICHT EIN GANZES, ODER VIELMEHR HALBES, VOLK TRANSPORTIEREN KANN. ABER ICH BITTE EUCH, AN UNS ZU DENKEN, FALLS IHR ES SCHAFFT, VON HIER ZU ENTKOMMEN.\"^^ \"ZUM SCHLUSS MÖCHTE ICH EUCH RATEN, MEINEN SOHN KETNAR IN DOR GRESTIN ZU BESUCHEN. RICHTET IHM SCHÖNE GRÜßE AUS UND SPRECHT IHN EINMAL AUF 'RUINEN' AN. MEINE KONTAKTE BESAGEN, DASS DIE WALDLÄUFER EINE SEHR INTERESSANTE ENTDECKUNG GEMACHT HABEN!\""
#: AllTexts/NPC_texts.amb/055/005.txt
msgctxt "AllTexts/NPC_texts.amb/055/005"
msgid "~INK 30~ A CHANGED KIRE STANDS BEFORE YOU. HIS EYES ARE SHINING AND HE MOVES EASILY AND WITH AGILITY. HE SAYS:^ ~INK 31~ \"MY FRIENDS! LET ME THANK YOU FOR RETURNING DORINA AND FOR BRINGING SUCH JOY INTO MY LIFE AGAIN! TO SHOW MY GRATITUDE I CAN ONLY OFFER YOU TWO SMALL KEYS. ONE FITS THE DOOR OF MY TREASURE CHAMBER, TAKE WHATEVER YOU LIKE!^ THE OTHER KEY OPENS THE DOOR TO OUR TEST MINE. I LEAVE IT TO YOU, TOGETHER WITH SOME VERY CONFIDENTIAL INFORMATION. A FEW DAYS AGO DURING SOME NEW TEST DIGGINGS WE DISCOVERED A DOOR MADE OF SOLID METAL. ALL ATTEMPTS TO OPEN IT FAILED AND FURTHER DIGGING WAS PREVENTED BY AN INVASION OF TORNAKS IN THE MINES. TAKE A LOOK AT THAT DOOR IF YOU LIKE, PERHAPS YOU CAN DISCOVER ITS SECRET.\"^ ~INK 30~ KIRE'S EXPRESSION BECOMES RATHER MORE SERIOUS FOR A MOMENT.^ ~INK 31~ \"I KNOW THAT YOU HAVE NOT GIVEN UP HOPE OF LEAVING THIS MOON AGAIN. ANYONE ELSE COULD NOT EVEN BEAR THE MERE THOUGHT, BUT YOU ARE EXTRAORDINARY PEOPLE.^ I AM AWARE THAT YOUR LITTLE AIRSHIP CANNOT CARRY A WHOLE PLANET FULL OF PEOPLE, OR EVEN HALF A PLANETFUL, BUT I WOULD ASK YOU TO THINK OF US IF YOU MANAGE TO GET AWAY FROM HERE.\"^^ \"AND FINALLY I WOULD ADVISE YOU TO VISIT MY SON KETNAR IN DOR GRESTIN. GIVE HIM MY BEST REGARDS AND SPEAK TO HIM ABOUT 'RUINS'. MY CONTACTS TELL ME THAT THE FOREST RUNNERS HAVE DISCOVERED SOMETHING VERY INTERESTING!\""
msgstr ""

#. Dialogue of NPC 055 (KIRE).
#. German: "\"GRÜßE, MEINE FREUNDE! ICH HOFFE, EURE UNTERNEHMUNGEN VERLAUFEN ERFOLGREICH!\""
#: AllTexts/NPC_texts.amb/055/006.txt
msgctxt "AllTexts/NPC_texts.amb/055/006"
msgid "\"WELCOME, MY FRIENDS! I HOPE YOUR EFFORTS ARE SUCCESSFUL!\""
msgstr ""

#. Dialogue of NPC 055 (KIRE).
#. German: "\"ES TUT MIR LEID, ABER DIE VERSUCHSMINE IST FREMDEN NICHT ZUGÄNGLICH.\""
#: AllTexts/NPC_texts.amb/055/007.txt
msgctxt "AllTexts/NPC_texts.amb/055/007"
msgid "\"I AM SORRY BUT THE TEST MINE IS CLOSED TO STRANGERS.\""
msgstr ""

#. Dialogue of NPC 055 (KIRE).
#. German: "\"ABER FREUNDE, ICH HABE EUCH DOCH BEREITS DEN SCHLÜSSEL ZUR MINE GEGEBEN!\""
#: AllTexts/NPC_texts.amb/055/008.txt
msgctxt "AllTexts/NPC_texts.amb/055/008"
msgid "\"BUT FRIENDS, I HAVE ALREADY GIVEN YOU THE KEY TO THE MINE!\""
msgstr ""

#. Dialogue of NPC 055 (KIRE).
#. German: "\"GEHABT EUCH WOHL!\""
#: AllTexts/NPC_texts.amb/055/009.txt
msgctxt "AllTexts/NPC_texts.amb/055/009"
msgid "\"FAREWELL!\""
msgstr ""

#. Dialogue of NPC 055 (KIRE).
#. German: "\"GLÜCK UND ERFOLG MÖGEN MIT EUCH SEIN!\""
#: AllTexts/NPC_texts.amb/055/010.txt
msgctxt "AllTexts/NPC_texts.amb/055/010"
msgid "\"GOOD LUCK AND MAY SUCCESS BE WITH YOU!\""
msgstr ""

#. Dialogue of NPC 055 (KIRE).
#. Placeholders: ~SELF~ = the hero (the player character). The gender of these persons is unknown.
#. German: "\"BROM IST, ODER VIELMEHR WAR, MEIN TAPFERSTER KRIEGER. ICH HABE IHN KURZ NACH UNSERER ANKUNFT BEAUFTRAGT, NACH EINER MÖGLICHKEIT ZU SUCHEN, DIESEN MOND ZU VERLASSEN. ICH NEHME AN, ER IST DABEI UMS LEBEN GEKOMMEN.\"^ ~INK 30~ ~SELF~ BERICHTET KIRE, DASS IHR BROM AN BORD EURES LUFTSCHIFFS GEFUNDEN HABT. KIRE WIRKT ÜBERRASCHT UND MEINT:^ ~INK 31~ \"OFFENSICHTLICH HAT ER SICH AN BORD GESCHLICHEN. WIE ER DORT HINGELANGT IST, KANN ICH MIR ALLERDINGS NICHT ERKLÄREN. DIE EINZIGE MÖGLICHKEIT, DIE MIR EINFÄLLT, LIEGT DARIN, DASS UNSERE VERWÜNSCHTEN AUFTRAGGEBER UNS INSGEHEIM EINEN BESUCH ABGESTATTET HABEN - WOMÖGLICH, UM SICH AN UNSEREM UNGLÜCK ZU WEIDEN. BROM WAR VIELLEICHT ZUR RECHTEN ZEIT AM RECHTEN ORT...! WENN ES SO WAR, DANN HAT ER DEN HÖCHSTMÖGLICHEN PREIS DAFÜR ZAHLEN MÜSSEN.\""
#: AllTexts/NPC_texts.amb/055/011.txt
msgctxt "AllTexts/NPC_texts.amb/055/011"
msgid "\"BROM IS, OR RATHER WAS, MY BRAVEST WARRIOR. SHORTLY AFTER OUR ARRIVAL I INSTRUCTED HIM TO FIND A WAY TO LEAVE THIS MOON. I ASSUME THAT WILL HAVE COST HIM HIS LIFE.\"^ ~INK 30~ ~SELF~ REPORTS TO KIRE THAT YOU FOUND BROM ON BOARD YOUR AIRSHIP. KIRE LOOKS SURPRISED AND SAYS:^ ~INK 31~ \"APPARENTLY HE CREPT ON BOARD. I CANNOT EXPLAIN HOW HE GOT THERE, HOWEVER. THE ONLY WAY I CAN IMAGINE IS THAT OUR DAMNED CUSTOMERS VISITED US SECRETLY - PERHAPS TO AMUSE THEMSELVES ABOUT OUR SORRY SITUATION. BROM WAS PERHAPS AT THE RIGHT PLACE AT THE RIGHT TIME ...! IF THAT WAS THE CASE, HE HAS HAD TO PAY THE ULTIMATE PRICE.\""
msgstr ""

#. Dialogue of NPC 055 (KIRE).
#. German: "\"WIE ICH BEREITS SAGTE, ER WAR EIN HELDENMÜTIGER KRIEGER.\""
#: AllTexts/NPC_texts.amb/055/012.txt
msgctxt "AllTexts/NPC_texts.amb/055/012"
msgid "\"AS I ALREADY SAID, HE WAS A HEROIC WARRIOR.\""
msgstr ""

#. Dialogue of NPC 056 (STORGAT).
#. German: "EIN GROB GEBAUTER ZWERG MIT WACHEM BLICK BEÄUGT EUCH AUFMERKSAM."
#: AllTexts/NPC_texts.amb/056/000.txt
msgctxt "AllTexts/NPC_texts.amb/056/000"
msgid "A COARSE LOOKING DWARF WITH WEEDY EYES STARES AT YOU INTENTLY."
msgstr ""

#. Dialogue of NPC 056 (STORGAT).
#. German: "\"ICH ENTBIETE EUCH MEINEN GRUß, IHR REISENDEN! MEINE NAME IST STORGAT, ICH BIN DER GRABUNGSLEITER DER VERSUCHSMINE VON DOR KIREDON.\""
#: AllTexts/NPC_texts.amb/056/001.txt
msgctxt "AllTexts/NPC_texts.amb/056/001"
msgid "\"GREETINGS, TRAVELLERS! MY NAME IS STORGAT, I AM THE HEAD OF THE DIGGING TEAM AT THE TEST MINE OF DOR KIREDON.\""
msgstr ""

#. Dialogue of NPC 056 (STORGAT).
#. German: "\"LEBT WOHL, REISENDE!\""
#: AllTexts/NPC_texts.amb/056/002.txt
msgctxt "AllTexts/NPC_texts.amb/056/002"
msgid "\"FAREWELL, TRAVELLERS!\""
msgstr ""

#. Dialogue of NPC 056 (STORGAT).
#. German: "\"VOR FAST FÜNFZEHN JAHREN, NACHDEM UNSER ÜBERLEBEN EINIGERMAßEN GESICHERT SCHIEN, BEGANNEN WIR MIT DER UNTERIRDISCHEN ERFORSCHUNG DES MONDES. DIE ERGEBNISSE WAREN ENTTÄUSCHEND: KAUM METALLE, EIN PAAR WENIGE MINERALE, EINIGE HÜBSCHE FARBIGE FELSSTRUKTUREN, DIE IHR JETZT ALS BODEN DES THRONSAALS BEWUNDERN KÖNNT, UND OFTMALS EIN PAAR BROCKEN NUTZLOSEN BERNSTEINS. AUGENBLICKLICH IST DIE MINE JEDOCH VERSCHLOSSEN.\""
#: AllTexts/NPC_texts.amb/056/003.txt
msgctxt "AllTexts/NPC_texts.amb/056/003"
msgid "\"ALMOST FIFTEEN YEARS AGO, WHEN IT SEEMED FAIRLY CERTAIN WE COULD SURVIVE, WE BEGAN TO EXAMINE THE UNDERGROUND PARTS OF THE MOON. THE RESULTS WERE DISAPPOINTING: NO METALS, JUST A FEW MINERALS, SOME PRETTY-COLOURED ROCK FORMATIONS WHICH YOU CAN NOW SEE AS THE FLOORING OF THE THRONE ROOM, AND OFTEN A FEW LUMPS OF USELESS AMBER. BUT THE MINE IS CLOSED AT THE MOMENT.\""
msgstr ""

#. Dialogue of NPC 056 (STORGAT).
#. German: "\"NUR KIRE IST ZUR VERGABE VON SCHLÜSSELN AUTORISIERT. FRAGT IHN DANACH, ABER ICH GLAUBE KAUM, DASS ER EINEN SCHLÜSSEL HERAUSGIBT, BESONDERS JETZT, DA DIESE TORNAK-BIESTER DIE MINE HEIMSUCHEN.\""
#: AllTexts/NPC_texts.amb/056/004.txt
msgctxt "AllTexts/NPC_texts.amb/056/004"
msgid "\"ONLY KIRE IS AUTHORISED TO ISSUE THE KEYS. YOU CAN ASK HIM FOR THEM BUT I HARDLY THINK HE WILL GIVE YOU THEM, ESPECIALLY NOW THAT THESE TORNAK BEASTS ARE GETTING INTO THE MINE.\""
msgstr ""

#. Dialogue of NPC 056 (STORGAT).
#. German: "\"DIE TORNAKS SIND BESTIEN! WIE FAST ALLE EINHEIMISCHEN TIERARTEN SIND ES FURCHTERREGENDE GEGNER, UND VOR EINIGER ZEIT SIND SO VIELE VON IHNEN IN DIE MINEN EINGEDRUNGEN, DASS WIR ZUM RÜCKZUG GEZWUNGEN WURDEN. AUSGERECHNET JETZT! ICH DACHTE DARAN, JEMANDEN AUS DOR GRESTIN UM RAT ZU FRAGEN, ABER KIRE LEHNT DIESEN VORSCHLAG STRIKT AB.\""
#: AllTexts/NPC_texts.amb/056/005.txt
msgctxt "AllTexts/NPC_texts.amb/056/005"
msgid "\"THE TORNAKS ARE BEASTS! LIKE ALMOST ALL THE LOCAL KINDS OF ANIMALS THEY ARE FEARFUL OPPONENTS AND A SHORT TIME AGO SO MANY OF THEM GOT INTO THE MINES THAT WE WERE FORCED TO WITHDRAW. AND NOW, OF ALL TIMES! I AM THINKING ABOUT ASKING THE ADVICE OF SOMEONE FROM DOR GRESTIN BUT KIRE REFUSES TO CONSIDER IT.\""
msgstr ""

#. Dialogue of NPC 056 (STORGAT).
#. German: "\"NUN, WIR KÖNNEN NICHT VIEL DAMIT ANFANGEN. MANCHMAL LASSEN WIR DAS ZEUG EINFACH LIEGEN.\""
#: AllTexts/NPC_texts.amb/056/006.txt
msgctxt "AllTexts/NPC_texts.amb/056/006"
msgid "\"WELL, WE CANNOT DO MUCH WITH THAT. SOMETIMES WE JUST LEAVE IT ALONE.\""
msgstr ""

#. Dialogue of NPC 056 (STORGAT).
#. German: "\"AH, DIE REISENDEN! AUCH ICH BIN FROH, DORINA WIEDER BEI UNS ZU WISSEN. WAS KANN ICH FÜR EUCH TUN?\""
#: AllTexts/NPC_texts.amb/056/007.txt
msgctxt "AllTexts/NPC_texts.amb/056/007"
msgid "\"OH, THE TRAVELLERS! I, TOO, AM VERY HAPPY THAT DORINA IS BACK WITH US AGAIN. WHAT CAN I DO FOR YOU?\""
msgstr ""

#. Dialogue of NPC 056 (STORGAT).
#. German: "\"SEID ABERMALS GEGRÜßT, REISENDE!\""
#: AllTexts/NPC_texts.amb/056/008.txt
msgctxt "AllTexts/NPC_texts.amb/056/008"
msgid "\"WELCOME AGAIN, TRAVELLERS!\""
msgstr ""

#. Dialogue of NPC 056 (STORGAT).
#. German: "\"WIE IHR WISST, IST DIE MINE AUGENBLICKLICH VERSCHLOSSEN.\""
#: AllTexts/NPC_texts.amb/056/009.txt
msgctxt "AllTexts/NPC_texts.amb/056/009"
msgid "\"AS YOU KNOW, THE MINE IS CLOSED AT THE MOMENT.\""
msgstr ""

#. Dialogue of NPC 056 (STORGAT).
#. German: "\"ICH BEDAURE, IHR MÜSST KIRE UM EINEN SCHLÜSSEL BITTEN.\""
#: AllTexts/NPC_texts.amb/056/010.txt
msgctxt "AllTexts/NPC_texts.amb/056/010"
msgid "\"I REGRET YOU MUST ASK KIRE FOR A KEY.\""
msgstr ""

#. Dialogue of NPC 056 (STORGAT).
#. German: "\"EINE SCHRECKLICHE BRUT, FÜRWAHR! WENN WIR NUR MEHR ÜBER SIE WÜSSTEN!\""
#: AllTexts/NPC_texts.amb/056/011.txt
msgctxt "AllTexts/NPC_texts.amb/056/011"
msgid "\"A DREADFUL BREED, IT'S TRUE! IF ONLY WE KNEW MORE ABOUT THEM!\""
msgstr ""

#. Dialogue of NPC 057 (DORINA).
#. German: "DIE ZWERGIN IST MITTLEREN ALTERS UND SCHAUT EUCH MIT EINEM AUSDRUCK MAßLOSER VERBLÜFFUNG AN."
#: AllTexts/NPC_texts.amb/057/000.txt
msgctxt "AllTexts/NPC_texts.amb/057/000"
msgid "THE DWARF WOMAN IS OF MIDDLE AGE AND LOOKS AT YOU WITH A TOTAL LACK OF COMPREHENSION."
msgstr ""

#. Dialogue of NPC 057 (DORINA).
#. German: "~INK 30~ ENDLICH STEHT IHR VOR DORINA. SIE IST EINE ZWERGIN MITTLEREN ALTERS MIT EINEM RUNDLICHEN GESICHT. HÄTTET IHR NICHT IHRE ILLUSIONEN UND REALEN ZAUBER KENNENGELERNT, WÜRDET IHR KAUM EINE BEGABTE MAGIERIN IN IHR VERMUTEN. MIT VOLLKOMMEN ÜBERRASCHTER MIENE SCHAUT SIE EUCH AN UND SAGT:^ ~INK 31~ \"BEI ALLEN GÖTTERN! WER SEID IHR? WIE SEID IHR HIER HEREINGEKOMMEN? IHR SEID KEINE ZWERGE! WO... WAS WOLLT IHR VON MIR?\""
#: AllTexts/NPC_texts.amb/057/001.txt
msgctxt "AllTexts/NPC_texts.amb/057/001"
msgid "~INK 30~ FINALLY YOU STAND BEFORE DORINA. SHE IS A DWARF WOMAN OF MIDDLE AGE WITH A ROUND FACE. IF YOU DID NOT KNOW ABOUT HER SPELLS AND HER REAL MAGIC, YOU WOULD NOT HAVE EXPECTED HER TO BE A GIFTED MAGICIAN. SHE LOOKS AT YOU IN COMPLETE SURPRISE AND SAYS:^ ~INK 31~ \"BY ALL THE GODS! WHO ARE YOU? HOW DID YOU GET IN HERE? YOU ARE NOT DWARFS! WHERE ...? WHAT DO YOU WANT FROM ME?\""
msgstr ""

#. Dialogue of NPC 057 (DORINA).
#. German: "\"JA, ABER...^ NEIN, ES IST BESSER, IHR GEHT WIEDER!\""
#: AllTexts/NPC_texts.amb/057/002.txt
msgctxt "AllTexts/NPC_texts.amb/057/002"
msgid "\"YES, BUT ...^ NO, IT IS BETTER YOU GO AGAIN!\""
msgstr ""

#. Dialogue of NPC 057 (DORINA).
#. German: "\"IHR SEID JA NOCH IMMER HIER! WAS IST LOS? WER HAT EUCH GESCHICKT? WARUM SEID IHR HIER?\""
#: AllTexts/NPC_texts.amb/057/003.txt
msgctxt "AllTexts/NPC_texts.amb/057/003"
msgid "\"YOU ARE STILL HERE! WHAT IS GOING ON? WHO SENT YOU? WHY ARE YOU HERE?\""
msgstr ""

#. Dialogue of NPC 057 (DORINA).
#. German: "~INK 30~ IHR ZEIGT DORINA DEN BRIEF UND SAGT IHR, VON WEM ER STAMMT.^ ~INK 31~ \"EIN BRIEF VON I H M ? UNGLAUBLICH! BITTE GEBT IHN MIR!\""
#: AllTexts/NPC_texts.amb/057/004.txt
msgctxt "AllTexts/NPC_texts.amb/057/004"
msgid "~INK 30~ YOU SHOW DORINA THE LETTER AND TELL HER WHO HAS SENT IT.^ ~INK 31~ \"A LETTER FROM HIM? INCREDIBLE! PLEASE GIVE IT TO ME!\""
msgstr ""

#. Dialogue of NPC 057 (DORINA).
#. German: "~INK 30~ IHR HALTET DORINA DEN VERSIEGELTEN BRIEF HIN UND BERICHTET, WIE IHR ZU EUREM BOTENAUFTRAG GEKOMMEN SEID.^ ~INK 31~ \"IHR SEID VON K I R E GESCHICKT WORDEN? DAS KANN ICH EUCH NICHT GLAUBEN! DER STURE KERL WÜRDE NIEMALS...\"^ ~INK 30~ TROTZ DIESER WORTE NIMMT DORINA DEN UMSCHLAG ENTGEGEN. SIE BEMÜHT SICH UM EINEN GLEICHMÜTIGEN EINDRUCK, ABER IHR SEHT IHRE FINGER LEICHT ZITTERN, ALS SIE DAS SIEGEL BRICHT. SIE ZIEHT DAS PERGAMENT HERVOR UND BEGINNT ZU LESEN.^ ~INK 31~ \"ER IST WIRKLICH VON IHM... SCHON ZEHN JAHRE... OH, IHR GÖTTER!\"^ ~INK 30~ WÄHREND DORINA IN DEN BRIEF VERSUNKEN DASTEHT, HUSCHEN DIE VIELFÄLTIGSTEN AUSDRÜCKE ÜBER IHR GESICHT. TRÄNEN LAUFEN ÜBER IHRE WANGEN, ABER SCHLIEßLICH SIEGT EIN LÄCHELN. SIE RINGT UM FASSUNG UND WENDET SICH EUCH ZU:^ ~INK 31~ \"ICH DANKE EUCH FÜR DIESE BOTSCHAFT, FREUNDE, OH, ICH DANKE EUCH! IHR WERDET NICHT VERSTEHEN, WIE EIN SIMPLER BRIEF MICH SO ERSCHÜTTERN KANN. DOCH ICH HABE ÜBER EIN JAHRHUNDERT AN KIRE'S SEITE GELEBT, UND ZUM ERSTEN MAL GESTEHT ER EINEN FEHLER EIN, ZEIGT ER EINSICHT UND REUE, JA, ER BITTET UM VERZEIHUNG, STELLT EUCH NUR VOR!^ WAS IST NUR MIT IHM PASSIERT? NUN, DAS IST LEICHT HERAUSZUFINDEN. LASST UNS AUFBRECHEN!\"^ ~INK 30~ DIESMAL IST DIE VERBLÜFFUNG AUF EURER SEITE: BLITZSCHNELL PACKT DORINA EIN PAAR HABSELIGKEITEN EIN UND SCHAUT EUCH DANN AUFFORDERND AN.^ IHR MACHT EUCH ZUSAMMEN AUF DEN WEG NACH DOR KIREDON."
#: AllTexts/NPC_texts.amb/057/005.txt
msgctxt "AllTexts/NPC_texts.amb/057/005"
msgid "~INK 30~ YOU HAND THE SEALED LETTER TO DORINA AND EXPLAIN HOW YOU CAME TO BE ACTING AS THE MESSENGER.^ ~INK 31~ \"YOU WERE SENT BY KIRE!? I CANNOT BELIEVE THAT! THAT STUBBORN CHAP WOULD NEVER ...\"^ ~INK 30~ DESPITE THESE WORDS DORINA ACCEPTS THE ENVELOPE. SHE TRIES TO LOOK CALM AND UNCONCERNED BUT YOU SEE HER HANDS TREMBLE SLIGHTLY AS SHE BREAKS THE SEAL. SHE PULLS OUT THE PARCHMENT AND BEGINS TO READ:^ ~INK 31~ \"IT REALLY IS FROM HIM ... TEN YEARS AGO ... OH, GOD!\"^ ~INK 30~ WHILE DORINA IS IMMERSED IN THE LETTER, MANY DIFFERENT EXPRESSIONS CROSS HER FACE. TEARS STREAM DOWN HER CHEEKS BUT ARE FINALLY REPLACED BY A SMILE. SHE TRIES TO COLLECT HERSELF AND TURNS TO YOU:^ ~INK 31~ \"THANK YOU FOR THIS MESSAGE, FRIENDS, OH THANK YOU SO VERY MUCH! YOU CANNOT BELIEVE HOW SUCH A SIMPLE LITTLE LETTER CAN MEAN SO MUCH. BUT I LIVED AT KIRE'S SIDE FOR MORE THAN A CENTURY AND FOR THE FIRST TIME HE ADMITS TO HAVING MADE A MISTAKE, SHOWING REGRET AND REMORSE. YES, HE ASKS MY FORGIVENESS, JUST IMAGINE!^ WHAT HAS HAPPENED TO HIM? WELL, IT IS EASY TO FIND OUT. LET US GO!\"^ ~INK 30~ THIS TIME IT IS YOU WHO ARE ASTONISHED! AS QUICK AS LIGHTNING DORINA PACKS A FEW BELONGINGS AND THEN STANDS LOOKING AT YOU WITH A FIRM EXPRESSION IN HER EYES.^ YOU COLLECT YOUR THINGS AND MAKE READY FOR YOUR DEPARTURE FOR DORE KIREDON."
msgstr ""

#. Dialogue of NPC 058 (KETNAR).
#. German: "IHR SEHT EINEN ENORM KRÄFTIG WIRKENDEN JÜNGEREN ZWERG VOR EUCH STEHEN. ER IST LEICHT UND ZWECKMÄßIG GEKLEIDET."
#: AllTexts/NPC_texts.amb/058/000.txt
msgctxt "AllTexts/NPC_texts.amb/058/000"
msgid "YOU SEE AN ENORMOUSLY STRONG YOUNG DWARF STANDING BEFORE YOU. HE IS ONLY LIGHTLY CLOTHED."
msgstr ""

#. Dialogue of NPC 058 (KETNAR).
#. German: "\"ICH FREUE MICH, EUCH KENNENZULERNEN, LUFTSCHIFFREISENDE! EIN SOLCHES EREIGNIS HAT SICH AUCH BEI UNS SCHNELL HERUMGESPROCHEN. ICH HEIßE EUCH WILLKOMMEN IN DOR GRESTIN!\""
#: AllTexts/NPC_texts.amb/058/001.txt
msgctxt "AllTexts/NPC_texts.amb/058/001"
msgid "\"I AM HAPPY TO MEET YOU, AIRSHIP TRAVELLERS! NEWS ABOUT SUCH MATTERS TRAVELS AROUND HERE QUICKLY. WELCOME TO DOR GRESTIN!\""
msgstr ""

#. Dialogue of NPC 058 (KETNAR).
#. German: "\"LEBT WOHL!\""
#: AllTexts/NPC_texts.amb/058/002.txt
msgctxt "AllTexts/NPC_texts.amb/058/002"
msgid "\"FAREWELL!\""
msgstr ""

#. Dialogue of NPC 058 (KETNAR).
#. German: "\"WIE GEFÄLLT EUCH UNSERE GRÜNE STADT? GRESTIN HEIßT IN EINEM ALTEN DIALEKT SOVIEL WIE 'NACHGIEBIG' ODER 'UMSCHLIEßEND'. SEIT DEM AUSZUG AUS DOR KIREDON VOR NUNMEHR ZEHN JAHREN VERSUCHEN WIR HIER, MIT DEN NATURGEWALTEN DES GRÜNEN MONDES ZU KOOPERIEREN, ANSTATT DAGEGEN ANZUKÄMPFEN. DER ERFOLG GIBT UNS RECHT: WIR HABEN VIEL GELERNT, UND MITTLERWEILE SIND KAUM NOCH OPFER ZU BEKLAGEN.\""
#: AllTexts/NPC_texts.amb/058/003.txt
msgctxt "AllTexts/NPC_texts.amb/058/003"
msgid "\"HOW DO YOU LIKE OUR GREEN TOWN? GRESTIN IS AN OLD DIALECT WORD MEANING SOMETHING LIKE 'VERSATILE' OR 'COMPREHENSIVE'. SINCE WE MOVED FROM DOR KIREDON TEN YEARS AGO WE HAVE BEEN TRYING TO CO-OPERATE WITH THE FORCES OF NATURE ON OUR GREEN MOON, INSTEAD OF FIGHTING THEM. OUR SUCCESS PROVES WE ARE RIGHT: WE HAVE LEARNED MUCH AND WE HAVE ONLY LOST VERY FEW PEOPLE.\""
msgstr ""

#. Dialogue of NPC 058 (KETNAR).
#. German: "\"SCHAUT EUCH HIER UM! BEDENKT, DASS IHR AUF DIESER WELT FÜR DEN REST EURER TAGE LEBEN WERDET! NEUE BÜRGER SIND UNS IMMER WILLKOMMEN, WENN SIE BEREIT SIND, ZU LERNEN, ANSTATT BLIND ZU KÄMPFEN.\""
#: AllTexts/NPC_texts.amb/058/004.txt
msgctxt "AllTexts/NPC_texts.amb/058/004"
msgid "\"LOOK AROUND HERE! REMEMBER THAT YOU WILL LIVE ON THIS WORLD FOR THE REST OF YOUR DAYS! NEW PEOPLE ARE ALWAYS WELCOME HERE IF THEY ARE PREPARED TO LEARN INSTEAD OF FIGHTING BLINDLY.\""
msgstr ""

#. Dialogue of NPC 058 (KETNAR).
#. German: "\"IHR HABT SCHWIERIGKEITEN MIT TORNAKS? NUN, ES GIBT EINE EINFACHE UND ZUGLEICH SCHWIERIGE METHODE, VON IHNEN IN RUHE GELASSEN ZU WERDEN: MAN TRÄGT EINS IHRER EIER BEI SICH! VERSUCHT, EINES DAVON IN EUREN BESITZ ZU BRINGEN.\""
#: AllTexts/NPC_texts.amb/058/005.txt
msgctxt "AllTexts/NPC_texts.amb/058/005"
msgid "\"YOU HAVE PROBLEMS WITH TORNAKS? WELL, THERE IS AN EASY AND AT THE SAME TIME A DIFFICULT WAY TO ENSURE THEY LEAVE YOU ALONE: YOU SIMPLY CARRY ONE OF THEIR EGGS WITH YOU! TRY TO GET ONE.\""
msgstr ""

#. Dialogue of NPC 058 (KETNAR).
#. German: "~INK 30~ DAS HEITERE, GELASSENE MIENENSPIEL KETNAR'S VERFINSTERT SICH, ALS ER DEN NAMEN HÖRT.^ ~INK 31~ \"KIRE? SEIN GEIST IST SO VERBARRIKADIERT, WIE DIE STADT, DIE ER REGIERT. SEIT DER ZEIT, DA WIR DOR KIREDON VERLIEßEN, HABE ICH IHN NICHT MEHR GESEHEN. ER IST MEIN VATER.\""
#: AllTexts/NPC_texts.amb/058/006.txt
msgctxt "AllTexts/NPC_texts.amb/058/006"
msgid "~INK 30~ THE HAPPY AND RELAXED EXPRESSION ON KETNAR'S FACE CHANGES WHEN HE HEARS THE NAME.^ ~INK 31~ \"KIRE? HIS SPIRIT IS AS BARRICADED UP AS THE TOWN HE GOVERNS. I HAVE NOT SEEN HIM SINCE WE LEFT DORE KIREDON. HE IS MY FATHER.\""
msgstr ""

#. Dialogue of NPC 058 (KETNAR).
#. German: "\"IHR SCHEINT GUT ÜBER MEINE FAMILIENVERHÄLTNISSE INFORMIERT ZU SEIN. DORINA IST MEINE MUTTER. NUR UM IHRETWILLEN BEREUTE ICH MANCHMAL DEN ZWIST MIT MEINEM VATER. SIE HAT SEHR UNTER KIRE'S UNEINSICHTIGKEIT GELITTEN. ES WAR SEHR RICHTIG VON IHR, IHM DEN RÜCKEN ZU KEHREN.\"^ ~INK 30~ KETNAR LÄSST SICH NICHT MEHR ÜBER DORINA ENTLOCKEN, ABER IHR GEWINNT DEN EINDRUCK, DASS ER SICH KEINE SORGEN ÜBER DEN VERBLEIB SEINER MUTTER MACHT."
#: AllTexts/NPC_texts.amb/058/007.txt
msgctxt "AllTexts/NPC_texts.amb/058/007"
msgid "\"YOU SEEM WELL INFORMED ABOUT MY FAMILY CIRCUMSTANCES. DORINA IS MY MOTHER. ONLY FOR HER DO I SOMETIMES REGRET THE DISAGREEMENT WITH MY FATHER. SHE SUFFERED UNDER KIRE'S INSENSITIVITY. IT WAS QUITE RIGHT OF HER TO TURN HER BACK.\"^ ~INK 30~ KETNAR WILL NOT SPEAK ANY MORE ABOUT DORINA BUT YOU HAVE THE IMPRESSION THAT HE IS WORRIED ABOUT HIS MOTHER."
msgstr ""

#. Dialogue of NPC 058 (KETNAR).
#. German: "~INK 30~ KETNAR MUSTERT EUCH MIT EINEM SCHARFEN BLICK.^ ~INK 31~ \"IHR WART BEI DEM BAUM? WAS VERANLASSTE EUCH, DORTHIN ZU GEHEN?\""
#: AllTexts/NPC_texts.amb/058/008.txt
msgctxt "AllTexts/NPC_texts.amb/058/008"
msgid "~INK 30~ KETNAR INSPECTS YOU WITH AN INTENSE LOOK.^ ~INK 31~ \"YOU WERE AT THE TREE? WHAT MADE YOU GO THERE?\""
msgstr ""

#. Dialogue of NPC 058 (KETNAR).
#. Placeholders: ~SELF~ = the hero (the player character). The gender of these persons is unknown.
#. German: "~INK 30~ IHR ZEIGT KETNAR DIE NACHRICHT KIRE'S UND ERZÄHLT IHM VON SEINER BITTE, DORINA AUFZUSUCHEN.^ ~INK 31~ \"EINE NACHRICHT VON DEM ALTEN DICKSCHÄDEL? WAS IMMER DARIN STEHT, ALLEIN DIE TATSACHE, DASS ER KONTAKT SUCHT, ERSTAUNT MICH ZUTIEFST. NUN GUT! UNTER DIESEN UMSTÄNDEN SOLLT IHR DAS WORT DER ÖFFNUNG WISSEN, ES LAUTET 'SCHNISM'. DER BAUM WIRD SICH EUCH DAMIT AUFTUN.\"^ ~INK 30~ ~SELF~ RICHTET EINEN FRAGENDEN BLICK AUF KETNAR. ER FÄHRT FORT:^ ~INK 31~ \"NEIN, ICH WEISS AUCH NICHT, WAS DAS WORT BEDEUTET.^ EINE WARNUNG MÖCHTE ICH EUCH NOCH ZUKOMMEN LASSEN: UNTERSCHÄTZT DIE MAGISCHEN FÄHIGKEITEN MEINER MUTTER NICHT! SIE HAT SICH GEGEN UNGEBETENEN BESUCH VON TIEREN UND ZWERGEN GUT GESICHERT.\""
#: AllTexts/NPC_texts.amb/058/009.txt
msgctxt "AllTexts/NPC_texts.amb/058/009"
msgid "~INK 30~ YOU SHOW KETNAR THE MESSAGE FROM KIRE AND TELL HIM OF HIS REQUEST TO FIND DORINA.^ ~INK 31~ \"A MESSAGE FROM THE STUBBORN OLD FOOL? WHATEVER IT SAYS, JUST THE FACT THAT HE IS WANTING TO MAKE CONTACT ASTONISHES ME, TOTALLY. WELL, OKAY! UNDER THESE CIRCUMSTANCES I WILL TELL YOU THE WORD WHICH OPENS IT UP. THE WORD IS 'SCHNISM'. THE TREE WILL OPEN UP FOR YOU.\"^ ~INK 30~ ~SELF~ DIRECTS A QUESTIONING LOOK AT KETNAR. HE CONTINUES:^ ~INK 31~ \"NO, I ALSO DO NOT KNOW WHAT THAT WORD MEANS.^ BUT LET ME GIVE YOU A WORD OF WARNING: DO NOT UNDERESTIMATE THE MAGICAL ABILITIES OF MY MOTHER! SHE HAS PROTECTED HERSELF WELL AGAINST UNWANTED VISITS BY ANIMALS AND DWARFS.\""
msgstr ""

#. Dialogue of NPC 058 (KETNAR).
#. German: "\"SEID GEGRÜßT UND ABERMALS WILLKOMMEN!\""
#: AllTexts/NPC_texts.amb/058/010.txt
msgctxt "AllTexts/NPC_texts.amb/058/010"
msgid "\"WELCOME, WELCOME BACK!\""
msgstr ""

#. Dialogue of NPC 058 (KETNAR).
#. German: "~INK 30~ BEI EUREM ANBLICK ERSCHEINT EIN LÄCHELN AUF KETNAR'S GESICHT.^ ~INK 31~ \"SCHÖN, EUCH ZU SEHEN! WIE ICH HÖRE, HABT IHR EINIGES DURCHGEMACHT, UM UNSEREN FAMILIENFRIEDEN WIEDERHERZUSTELLEN. BITTE NEHMT MEINEN TIEF EMPFUNDENEN DANK DAFÜR ENTGEGEN! ICH WERDE DEMNÄCHST MEINEM VATER EINEN BESUCH ABSTATTEN, DENN ICH KANN IMMER NOCH NICHT GANZ GLAUBEN, DASS ER SICH EINSICHTIG GEZEIGT HAT.\""
#: AllTexts/NPC_texts.amb/058/011.txt
msgctxt "AllTexts/NPC_texts.amb/058/011"
msgid "~INK 30~ AS HE CATCHES SIGHT OF YOU, A SMILE SPREADS ACROSS KETNAR'S FACE.^ ~INK 31~ \"NICE TO SEE YOU! AS I HEAR, YOU HAVE BEEN THROUGH QUITE A LOT IN YOUR ATTEMPTS TO BRING JOY TO OUR FAMILY AGAIN. PLEASE ACCEPT MY DEEPEST AND MOST GRATEFUL THANKS! I WILL VISIT MY FATHER SOON, FOR I STILL CANNOT QUITE BELIEVE THAT HE HAS SHOWN SUCH CONSIDERATION.\""
msgstr ""

#. Dialogue of NPC 058 (KETNAR).
#. German: "\"WIE SCHON GESAGT, VERSUCHT, AN EINS IHRER EIER ZU KOMMEN.\""
#: AllTexts/NPC_texts.amb/058/012.txt
msgctxt "AllTexts/NPC_texts.amb/058/012"
msgid "\"AS WE ALREADY SAID, TRY TO GET ONE OF THEIR EGGS.\""
msgstr ""

#. Dialogue of NPC 058 (KETNAR).
#. German: "\"ICH BIN VOLLER HOFFNUNG, DASS SICH NUN AUCH MEIN VERHÄLTNIS MIT KIRE BESSERT.\""
#: AllTexts/NPC_texts.amb/058/013.txt
msgctxt "AllTexts/NPC_texts.amb/058/013"
msgid "\"I AM FULL OF HOPE THAT MY RELATIONSHIP WITH KIRE WILL NOW IMPROVE.\""
msgstr ""

#. Dialogue of NPC 058 (KETNAR).
#. German: "\"MAN WIRD MICH NUN WOHL ÖFTER IN DOR KIREDON SEHEN. IMMERHIN MUSS ICH NUN NICHT MEHR IM GEHEIMEN ZU IHREM BAUM SCHLEICHEN, UM SIE ZU BESUCHEN.\""
#: AllTexts/NPC_texts.amb/058/014.txt
msgctxt "AllTexts/NPC_texts.amb/058/014"
msgid "\"THEY WILL NOW PROBABLY SEE ME IN DOR KIREDON MORE OFTEN. CERTAINLY I DO NOT NEED TO CREEP SECRETLY TO HER TREE IN ORDER TO VISIT HER.\""
msgstr ""

#. Dialogue of NPC 058 (KETNAR).
#. German: "\"NUN, DIESES WORT WERDET IHR WOHL SO SCHNELL NICHT WIEDER BENÖTIGEN...\""
#: AllTexts/NPC_texts.amb/058/015.txt
msgctxt "AllTexts/NPC_texts.amb/058/015"
msgid "\"WELL, YOU WILL NOT NEED THIS WORD AGAIN SO QUICKLY ...\""
msgstr ""

#. Dialogue of NPC 058 (KETNAR).
#. German: "~INK 30~ KETNAR TRÄGT EINEN BETONT GLEICHMÜTIGEN GESICHTSAUSDRUCK ZUR SCHAU.^ ~INK 31~ \"RUINEN? ICH WEISS NICHT, WOVON IHR SPRECHT.\"^ ~INK 30~ ER LÄSST SICH KEINE WEITEREN INFORMATIONEN ZU DIESEM THEMA ENTLOCKEN."
#: AllTexts/NPC_texts.amb/058/016.txt
msgctxt "AllTexts/NPC_texts.amb/058/016"
msgid "~INK 30~ KETNAR HAS A VERY CIRCUMSPECT EXPRESSION ON HIS FACE.^ ~INK 31~ \"RUINS? I DON'T KNOW WHAT YOU ARE TALKING ABOUT.\"^ ~INK 30~ HE GIVES NO MORE INFORMATION ON THIS SUBJECT."
msgstr ""

#. Dialogue of NPC 058 (KETNAR).
#. German: "\"ES KÖNNTE SEIN, DASS RANDOR, DER HÄNDLER, NOCH WELCHE DAVON HAT. VERSUCHT ES IN SEINEM LADEN IM OSTEN DER STADT.\""
#: AllTexts/NPC_texts.amb/058/017.txt
msgctxt "AllTexts/NPC_texts.amb/058/017"
msgid "\"IT COULD BE THAT RANDOR, THE DEALER, STILL HAS SOME. TRY IN HIS SHOP IN THE EAST PART OF THE TOWN.\""
msgstr ""

#. Dialogue of NPC 058 (KETNAR).
#. German: "\"FÜRWAHR, ES IST DAS SIEGEL MEINES VATERS! ÜBERGEBT DORINA DEN BRIEF, UND VERGESST NICHT DAS SELTSAME ÖFFNUNGSWORT: 'SCHNISM'\""
#: AllTexts/NPC_texts.amb/058/018.txt
msgctxt "AllTexts/NPC_texts.amb/058/018"
msgid "\"TRUE, THAT IS MY FATHER'S SEAL! PLEASE GIVE DORINA THE LETTER AND DO NOT FORGET THE STRANGE OPENING WORD: 'SCHNISM'.\""
msgstr ""

#. Dialogue of NPC 058 (KETNAR).
#. German: "\"ICH FRAGE EUCH ABERMALS, WAS IHR AN DEM BAUM ZU SUCHEN HABT?\""
#: AllTexts/NPC_texts.amb/058/019.txt
msgctxt "AllTexts/NPC_texts.amb/058/019"
msgid "\"I ASK YOU AGAIN, WHAT WERE YOU DOING AT THE TREE?\""
msgstr ""

#. Dialogue of NPC 058 (KETNAR).
#. German: "\"DAS ÖFFNUNGSWORT LAUTET 'SCHNISM'.\""
#: AllTexts/NPC_texts.amb/058/020.txt
msgctxt "AllTexts/NPC_texts.amb/058/020"
msgid "\"THE OPENING WORD IS 'SCHNISM'.\""
msgstr ""

#. Dialogue of NPC 058 (KETNAR).
#. German: "\"NUN, DA IHR MEINER FAMILIE EINEN SO GROßEN DIENST ERWIESEN HABT, WERDE ICH MIT EUCH EINS UNSERER BESTGEHÜTETEN GEHEIMNISSE TEILEN. VOR ZWEI JAHREN HAT EINER UNSERER FÄHIGSTEN KUNDSCHAFTER DIE ÜBERRESTE EINER ZIVILISATION ENTDECKT, DIE SCHON JAHRTAUSENDE VOR UNSERER LANDUNG HIER UNTERGEGANGEN SEIN MUSS.^ DREBLIN, SO SEIN NAME, FAND DIE RUINEN IN EINER DER GEFÄHRLICHSTEN GEGENDEN DES MONDES. ER IST DORTHIN ZURÜCKGEKEHRT, UM IHRE GEHEIMNISSE ZU ERFORSCHEN, ABER SCHON SEIT LANGER ZEIT IST ER ÜBERFÄLLIG. WENN IHR DIE RUINEN AUFSUCHEN WOLLT, SIE LIEGEN IN NORDWESTLICHER RICHTUNG VON DOR GRESTIN.\""
#: AllTexts/NPC_texts.amb/058/021.txt
msgctxt "AllTexts/NPC_texts.amb/058/021"
msgid "\"WELL, NOW YOU HAVE SHOWN MY FAMILY SUCH GREAT SERVICE, I WILL TELL YOU ONE OF OUR BEST KEPT SECRETS. TWO YEARS AGO ONE OF OUR MOST SKILFUL SCOUTS DISCOVERED THE REMAINS OF A CIVILISATION WHICH MUST HAVE COLLAPSED THOUSANDS OF YEARS BEFORE WE LANDED HERE.^ DREBLIN, FOR THAT IS HIS NAME, FOUND THE RUINS IN ONE OF THE MOST DANGEROUS PARTS OF THIS MOON. HE RETURNED THERE TO CHECK ON ITS SECRETS. BUT HE HAS BEEN OVERDUE BACK HERE FOR A LONG TIME. IF WE WANT TO FIND THE RUINS, THEY ARE TO THE NORTH-NORTHWEST OF DOR GRESTIN.\""
msgstr ""

#. Dialogue of NPC 058 (KETNAR).
#. German: "\"IHR HABT MEINE MUTTER NOCH GAR NICHT GEFUNDEN? NUN DENN, HALTET EUCH IN SÜDWESTLICHER RICHTUNG, WENN IHR DIE STADT VERLASST. GEBT ACHT IN DEN SÜMPFEN DORT! IHR ERREICHT DORINA DURCH EINE TÜR, DIE IN EINEN RIESIGEN BAUM EINGELASSEN IST.\""
#: AllTexts/NPC_texts.amb/058/022.txt
msgctxt "AllTexts/NPC_texts.amb/058/022"
msgid "\"YOU DID NOT FIND MY MOTHER AT ALL? WELL THEN, CONTINUE IN A SOUTH WESTERLY DIRECTION WHEN YOU LEAVE THE TOWN. TAKE CARE IN THE SWAMPS! YOU WILL REACH DORINA THROUGH A DOOR SET IN A HUGE TREE.\""
msgstr ""

#. Dialogue of NPC 059 (DRONGEB).
#. German: "VOR EUCH STEHT DER KOCH DES HAUSES. TRAUE NIE EINEM DÜNNEN KOCH, HEIßT ES; DARAN GEMESSEN, SIEHT ER S E H R VERTRAUENSWÜRDIG AUS."
#: AllTexts/NPC_texts.amb/059/000.txt
msgctxt "AllTexts/NPC_texts.amb/059/000"
msgid "BEFORE YOU STANDS THE HEAD COOK. NEVER TRUST A THIN COOK THEY SAY: IF THAT'S TRUE, HE LOOKS VERY TRUSTWORTHY."
msgstr ""

#. Dialogue of NPC 059 (DRONGEB).
#. German: "\"SEID GEGRÜßT! IHR MÜSST DIE NEUANKÖMMLINGE SEIN! ICH HOFFE, ES GEFÄLLT EUCH IN DOR GRESTIN.\""
#: AllTexts/NPC_texts.amb/059/001.txt
msgctxt "AllTexts/NPC_texts.amb/059/001"
msgid "\"WELCOME! YOU MUST BE THE NEW ARRIVALS! I HOPE YOU LIKE IT HERE IN DOR GRESTIN.\""
msgstr ""

#. Dialogue of NPC 059 (DRONGEB).
#. German: "\"MÖGE EUCH DAS GLÜCK BEGLEITEN.\""
#: AllTexts/NPC_texts.amb/059/002.txt
msgctxt "AllTexts/NPC_texts.amb/059/002"
msgid "\"MAY LUCK BE WITH YOU.\""
msgstr ""

#. Dialogue of NPC 059 (DRONGEB).
#. German: "\"EINE SCHÖNE STADT, NICHT WAHR? ICH BIN HIERHER GEKOMMEN, WEIL ICH FÜR MEIN LEBEN GERN MIT NEUEN ZUTATEN FÜR MEINE SPEISEN EXPERIMENTIERE. RIECHT NUR DIESE KRÄUTERPASTETEN!\"^ ~INK 30~ ER HÄLT EUCH EIN TABLETT VERFÜHRERISCH DUFTENDER PASTETEN UNTER DIE NASE."
#: AllTexts/NPC_texts.amb/059/003.txt
msgctxt "AllTexts/NPC_texts.amb/059/003"
msgid "\"A BEAUTIFUL TOWN, ISN'T IT? I CAME HERE BECAUSE I REALLY ENJOY EXPERIMENTING WITH NEW FOODSTUFFS. JUST SMELL THESE HERB PIES!\"^ ~INK 30~ HE HOLDS A TRAY OF APPETISING PIES UNDER YOUR NOSE."
msgstr ""

#. Dialogue of NPC 059 (DRONGEB).
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "\"ABER GERNE! HIER BITTE, BEDIENT EUCH!\"^ ~INK 30~ ~LEAD~ BEDANKT SICH UND NIMMT EINIGE DER KRÄUTERPASTETEN."
#: AllTexts/NPC_texts.amb/059/004.txt
msgctxt "AllTexts/NPC_texts.amb/059/004"
msgid "\"BUT OF COURSE! COME ALONG, HELP YOURSELF!\"^ ~INK 30~ ~LEAD~ GRATEFULLY ACCEPTS THE INVITATION AND TAKES SOME OF THE HERB PIES."
msgstr ""

#. Dialogue of NPC 059 (DRONGEB).
#. German: "\"ICH LEBE RECHT GERN HIER, NUR MANCHMAL VERMISSE ICH DAS BIER DES GASTHOFS IN DOR KIREDON.\""
#: AllTexts/NPC_texts.amb/059/005.txt
msgctxt "AllTexts/NPC_texts.amb/059/005"
msgid "\"I LIKE LIVING HERE, ONLY SOMETIMES I MISS THE ALE FROM THE INN IN DOR KIREDON.\""
msgstr ""

#. Dialogue of NPC 059 (DRONGEB).
#. German: "\"SEID GEGRÜßT! WIEDER IM HAUSE?!\""
#: AllTexts/NPC_texts.amb/059/006.txt
msgctxt "AllTexts/NPC_texts.amb/059/006"
msgid "\"WELCOME! HOW NICE TO SEE YOU AGAIN!\""
msgstr ""

#. Dialogue of NPC 059 (DRONGEB).
#. German: "\"DOREB, DER GASTWIRT VON DOR KIREDON, HAT ES TATSÄCHLICH GESCHAFFT, EIN GENIEßBARES BIER AUS DEN EINHEIMISCHEN PFLANZEN ZU BRAUEN? WAS WILL MAN MEHR.\""
#: AllTexts/NPC_texts.amb/059/007.txt
msgctxt "AllTexts/NPC_texts.amb/059/007"
msgid "\"DOREB, THE LANDLORD OF DOR KIREDON, ACTUALLY SUCCEEDED IN BREWING AN ENJOYABLE TYPE OF ALE FROM THE PLANTS GROWING AROUND HERE. WHAT ELSE DO WE NEED?\""
msgstr ""

#. Dialogue of NPC 060 (LEIRA).
#. German: "EINE JUNGE ZWERGENFRAU MUSTERT EUCH AUFMERKSAM."
#: AllTexts/NPC_texts.amb/060/000.txt
msgctxt "AllTexts/NPC_texts.amb/060/000"
msgid "A YOUNG DWARF WOMAN LOOKS AT YOU INQUISITIVELY."
msgstr ""

#. Dialogue of NPC 060 (LEIRA).
#. German: "\"ICH GRÜßE EUCH! VERZEIHT MEIN AUFDRINGLICHES STARREN, ABER ES IST SCHON LANGE HER, DASS ICH WELCHE VOM GROßEN VOLK GESEHEN HABE. MAN SPRICHT VIEL ÜBER EUCH, UND AUCH MEIN MANN KETNAR IST AN EINEM GESPRÄCH MIT EUCH INTERESSIERT. HABT IHR AUCH SCHON MIT KIRE GESPROCHEN?\""
#: AllTexts/NPC_texts.amb/060/001.txt
msgctxt "AllTexts/NPC_texts.amb/060/001"
msgid "\"WELCOME! PLEASE FORGIVE ME STARING BUT IT IS A LONG TIME SINCE I SAW PEOPLE OF YOUR SIZE. EVERYONE IS TALKING ABOUT YOU AND EVEN MY HUSBAND, KETNAR, WOULD LIKE TO TALK TO YOU. HAVE YOU ALREADY SPOKEN TO KIRE?\""
msgstr ""

#. Dialogue of NPC 060 (LEIRA).
#. German: "\"LEBT WOHL!\""
#: AllTexts/NPC_texts.amb/060/002.txt
msgctxt "AllTexts/NPC_texts.amb/060/002"
msgid "\"FAREWELL!\""
msgstr ""

#. Dialogue of NPC 060 (LEIRA).
#. German: "\"ICH FRAGE, WEIL ICH EIN WENIG AUF EIN LEBENSZEICHEN VON IHM HOFFE. IHR HABT SICHER SCHON DAVON GEHÖRT, DAS KETNAR DOR KIREDON IM STREIT MIT KIRE VERLIESS. VIELLEICHT SOLLTE ICH NICHT SO OFFEN DARÜBER REDEN, ABER ICH GLAUBE, ER VERMISST SEINE FAMILIE DOCH EIN WENIG.\""
#: AllTexts/NPC_texts.amb/060/003.txt
msgctxt "AllTexts/NPC_texts.amb/060/003"
msgid "\"I ASK, BECAUSE I WOULD HOPE TO HEAR FROM HIM AGAIN. YOU HAVE CERTAINLY ALREADY HEARD THAT KETNAR LEFT DOR KIREDON AFTER A DISAGREEMENT WITH KIRE. PERHAPS I SHOULD NOT SPEAK SO OPENLY ABOUT IT BUT I BELIEVE HE MISSES HIS FAMILY A LITTLE.\""
msgstr ""

#. Dialogue of NPC 060 (LEIRA).
#. German: "~INK 30~ IHR ZEIGT LEIRA DEN BRIEF UND BERICHTET VON EUREM GESPRÄCH MIT KIRE, SEINEN WUNSCH NACH DISKRETION IGNORIEREND. LEIRA LÄCHELT UND MEINT:^ ~INK 31~ \"ICH FREUE MICH ÜBER DIESE NACHRICHT. DAS IST IMMERHIN EIN ANFANG! SPRECHT KETNAR RUHIG AUF SEINE ELTERN AN UND ZEIGT IHM DEN BRIEF!\""
#: AllTexts/NPC_texts.amb/060/004.txt
msgctxt "AllTexts/NPC_texts.amb/060/004"
msgid "~INK 30~ YOU SHOW LEIRA THE LETTER AND TELL HER ABOUT YOUR CONVERSATION WITH KIRE, IGNORING HIS REQUEST FOR DISCRETION. LEIRA SMILES AND SAYS:^ ~INK 31~ \"I AM DELIGHTED ABOUT THIS NEWS. IT IS AT LEAST A BEGINNING! PLEASE TALK TO KETNAR ABOUT HIS PARENTS AND SHOW HIM THE LETTER!\""
msgstr ""

#. Dialogue of NPC 060 (LEIRA).
#. German: "\"SEID GEGRÜßT, ABENTEURER! SCHÖN, EUCH WIEDERZUSEHEN!\""
#: AllTexts/NPC_texts.amb/060/005.txt
msgctxt "AllTexts/NPC_texts.amb/060/005"
msgid "\"WELCOME, ADVENTURERS! NICE TO SEE YOU AGAIN!\""
msgstr ""

#. Dialogue of NPC 060 (LEIRA).
#. German: "\"WIE GESAGT, IN KETNAR'S INTERESSE HOFFE ICH, DASS SICH SEINE FAMILIE IRGENDWANN WIEDER NÄHERKOMMT.\""
#: AllTexts/NPC_texts.amb/060/006.txt
msgctxt "AllTexts/NPC_texts.amb/060/006"
msgid "\"AS I SAID, FOR KETNAR'S SAKE I HOPE THAT HIS FAMILY WILL GET BACK TOGETHER SOME TIME.\""
msgstr ""

#. Dialogue of NPC 060 (LEIRA).
#. German: "\"VERSÄUMT NICHT, KETNAR DIESEN BRIEF ZU ZEIGEN!\""
#: AllTexts/NPC_texts.amb/060/007.txt
msgctxt "AllTexts/NPC_texts.amb/060/007"
msgid "\"DO NOT FORGET TO SHOW KETNAR THIS LETTER!\""
msgstr ""

#. Dialogue of NPC 060 (LEIRA).
#. German: "\"ICH FINDE ES WUNDERVOLL, IN EINER STADT ZU LEBEN, DIE MAN SELBST MIT AUFGEBAUT HAT!\""
#: AllTexts/NPC_texts.amb/060/008.txt
msgctxt "AllTexts/NPC_texts.amb/060/008"
msgid "\"I FIND IT IS WONDERFUL LIVING IN A TOWN WHICH WE HELPED TO BUILD OURSELVES!\""
msgstr ""

#. Dialogue of NPC 061 (DORINA).
#. German: "DORINA STEHT LÄCHELND VOR EUCH, UND MAN SIEHT IHR AN, DASS SIE IHR EINSIEDLERDASEIN NICHT VERMISST."
#: AllTexts/NPC_texts.amb/061/000.txt
msgctxt "AllTexts/NPC_texts.amb/061/000"
msgid "DORINA STANDS SMILING BEFORE YOU AND YOU CAN SEE THAT SHE IS NOT MISSING HER LIFE IN THE WILDERNISS."
msgstr ""

#. Dialogue of NPC 061 (DORINA).
#. German: "\"NICHT PECH, SONDERN GLÜCK, MEIN GLÜCK WAR ES, DASS IHR AUF UNSEREM MOND GELANDET SEID. UM EUCH EIN WENIG VON DIESEM GLÜCK ABZUGEBEN, MÖCHTE ICH EUCH DIESE BROSCHE MIT AUF EUREN WEG GEBEN. UND NOCHMALS: DANKE, DASS IHR MIR DIESEN MOMENT GESCHENKT HABT!\""
#: AllTexts/NPC_texts.amb/061/001.txt
msgctxt "AllTexts/NPC_texts.amb/061/001"
msgid "\"NOT BAD LUCK, BUT GOOD LUCK. IT WAS JUST MY LUCK THAT YOU LANDED ON OUR MOON. TO SHARE A LITTLE OF THIS LUCK WITH YOU I WOULD LIKE TO GIVE YOU THIS BROOCH. AND AGAIN: THANK YOU FOR GIVING ME THIS MOMENT!\""
msgstr ""

#. Dialogue of NPC 061 (DORINA).
#. German: "\"AUF EIN BALDIGES WIEDERSEHEN!\""
#: AllTexts/NPC_texts.amb/061/002.txt
msgctxt "AllTexts/NPC_texts.amb/061/002"
msgid "\"I LOOK FORWARD TO SEEING YOU AGAIN SOON!\""
msgstr ""

#. Dialogue of NPC 061 (DORINA).
#. German: "\"WILLKOMMEN, FREUNDE! ICH FREUE MICH, EUCH WIEDERZUSEHEN.\""
#: AllTexts/NPC_texts.amb/061/003.txt
msgctxt "AllTexts/NPC_texts.amb/061/003"
msgid "\"WELCOME, FRIENDS! I AM DELIGHTED TO SEE YOU AGAIN.\""
msgstr ""

#. Dialogue of NPC 061 (DORINA).
#. German: "\"MEINEM MANN GEHT ES GUT. ES WÄRE DUMM, ANZUNEHMEN, DASS ALLE UNSERE SCHWIERIGKEITEN AUF EWIGE ZEITEN HINAUS BESEITIGT WÄREN, ABER DIE ERINNERUNG AN DEN SCHMERZ DER TRENNUNG WIRD UNS BEIDEN HELFEN, VERNÜNFTIG ZU BLEIBEN.\""
#: AllTexts/NPC_texts.amb/061/004.txt
msgctxt "AllTexts/NPC_texts.amb/061/004"
msgid "\"MY HUSBAND IS WELL, THANK YOU. IT WOULD BE SILLY TO ASSUME THAT OUR PROBLEMS HAVE BEEN SETTLED FOR ALL TIME, BUT THE MEMORY OF OUR PAIN AT OUR SEPARATION WILL HELP US BOTH TO STAY SENSIBLE.\""
msgstr ""

#. Dialogue of NPC 062 (DARLA).
#. German: "DIE ZWERGIN BETRACHTET VERSTOHLEN DIE HOCHGEWACHSENEN MITGLIEDER DER GRUPPE."
#: AllTexts/NPC_texts.amb/062/000.txt
msgctxt "AllTexts/NPC_texts.amb/062/000"
msgid "THE DWARF WOMAN SECRETIVELY EXAMINES THE TALL MEMBERS OF THE GROUP."
msgstr ""

#. Dialogue of NPC 062 (DARLA).
#. German: "\"OHO, LEUTE VOM GROßEN VOLK! IHR MÜSST DIE LUFTSCHIFFREISENDEN SEIN, VON DENEN MAN SICH ERZÄHLT. HABT IHR SCHON MIT KETNAR, UNSEREM OBERHAUPT, GESPROCHEN?\""
#: AllTexts/NPC_texts.amb/062/001.txt
msgctxt "AllTexts/NPC_texts.amb/062/001"
msgid "\"AHA, PEOPLE FROM THE BIG WORLD! YOU MUST BE THE AIRSHIP TRAVELLERS OF WHOM WE HAVE HEARD SO MUCH. HAVE YOU ALREADY SPOKEN WITH KETNAR, OUR LEADER?\""
msgstr ""

#. Dialogue of NPC 062 (DARLA).
#. German: "\"LEBT WOHL UND GENIEßT DEN AUFENTHALT IN UNSERER STADT!\""
#: AllTexts/NPC_texts.amb/062/002.txt
msgctxt "AllTexts/NPC_texts.amb/062/002"
msgid "\"FAREWELL, AND ENJOY YOUR STAY IN OUR TOWN!\""
msgstr ""

#. Dialogue of NPC 062 (DARLA).
#. German: "\"KETNAR HAT SICH SCHON SEIT DEM AUSZUG AUS DOR KIREDON ALS UNSER ANFÜHRER BEWÄHRT. ER IST SICHERLICH AN EINEM GESPRÄCH MIT EUCH INTERESSIERT. IHR FINDET IHN IN DER RATSHALLE IM SÜDWESTEN DER STADT, FALLS ER NICHT GERADE AUF REISEN IST.\""
#: AllTexts/NPC_texts.amb/062/003.txt
msgctxt "AllTexts/NPC_texts.amb/062/003"
msgid "\"KETNAR HAS BEEN SUCCESSFUL AS OUR LEADER SINCE WE LEFT DOR KIREDON. HE WOULD CERTAINLY BE INTERESTED IN TALKING WITH YOU. YOU WILL FIND HIM IN THE COUNCIL HALL AT THE SOUTH WEST OF TOWN, UNLESS HE IS AWAY AT THE MOMENT.\""
msgstr ""

#. Dialogue of NPC 062 (DARLA).
#. German: "\"NUN, ES KOMMT RECHT OFT VOR, DASS KETNAR FÜR ZWEI BIS DREI TAGE VERSCHWINDET, OHNE DASS JEMAND WÜSSTE, WOHIN. MAN MUNKELT, DASS ER SEINE MUTTER BESUCHT, DIE EIN EINSIEDLERDASEIN IN DEN WÄLDERN FÜHREN SOLL.\""
#: AllTexts/NPC_texts.amb/062/004.txt
msgctxt "AllTexts/NPC_texts.amb/062/004"
msgid "\"WELL, IT HAPPENS VERY OFTEN THAT KETNAR DISAPPEARS FOR A DAY OR TWO WITHOUT ANYONE KNOWING WHERE HE HAS GONE. THEY SAY HE VISITS HIS MOTHER WHO IS SAID TO HAVE SETTLED IN THE FORESTS.\""
msgstr ""

#. Dialogue of NPC 062 (DARLA).
#. German: "\"HABT IHR SCHON MIT IHM GESPROCHEN?\""
#: AllTexts/NPC_texts.amb/062/005.txt
msgctxt "AllTexts/NPC_texts.amb/062/005"
msgid "\"HAVE YOU SPOKEN WITH HIM YET?\""
msgstr ""

#. Dialogue of NPC 062 (DARLA).
#. German: "\"ES WÄRE MIR LIEB, WENN IHR KETNAR NICHT VERRIETET, DASS ICH ÜBER DIE GERÜCHTE GESPROCHEN HABE, DIE SEINE GEHEIMEN REISEN BETREFFEN.\""
#: AllTexts/NPC_texts.amb/062/006.txt
msgctxt "AllTexts/NPC_texts.amb/062/006"
msgid "\"I WOULD PREFER YOU NOT TO TELL KETNAR THAT I SPOKE ABOUT THE RUMOURS CONCERNING HIS SECRET TRAVELS.\""
msgstr ""

#. Dialogue of NPC 062 (DARLA).
#. German: "~INK 30~ SIE MACHT EINE WEITAUSHOLENDE GESTE UND MEINT:^ ~INK 31~ \"IST ES NICHT EINE WUNDERSCHÖNE STADT?\""
#: AllTexts/NPC_texts.amb/062/007.txt
msgctxt "AllTexts/NPC_texts.amb/062/007"
msgid "~INK 30~ SHE SWEEPS ROUND WITH HER ARM AND EXCLAIMS:^ ~INK 31~ \"IS THIS NOT A BEAUTIFUL TOWN?\""
msgstr ""

#. Dialogue of NPC 062 (DARLA).
#. German: "\"ICH GRÜßE EUCH! SEID IHR NOCH ODER SCHON WIEDER IN DER STADT?\""
#: AllTexts/NPC_texts.amb/062/008.txt
msgctxt "AllTexts/NPC_texts.amb/062/008"
msgid "\"WELCOME, ARE YOU STILL STAYING IN THE TOWN OR HAVE YOU COME BACK AGAIN?\""
msgstr ""

#. Dialogue of NPC 063 (FERRIN).
#. German: "IHR SEHT EINEN KRAFTSTROTZENDEN ZWERG, DER GEISTESABWESEND MIT EINEM MINDESTENS ZWANZIG KILO SCHWEREN HAMMER SPIELT. SEIN GESICHTSAUSDRUCK IST VERSCHLOSSEN."
#: AllTexts/NPC_texts.amb/063/000.txt
msgctxt "AllTexts/NPC_texts.amb/063/000"
msgid "YOU SEE A POWERFUL DWARF ABSENT-MINDEDLY PLAYING WITH A HAMMER WHICH WEIGHS AT LEAST TWENTY KILOGRAMS. THE EXPRESSION ON HIS FACE TELLS YOU NOTHING."
msgstr ""

#. Dialogue of NPC 063 (FERRIN).
#. German: "\"GRÜßE, ABENTEURER! ICH WÜRDE ES VORZIEHEN, IM AUGENBLICK MIT MEINER TRAUER ALLEIN ZU SEIN.\""
#: AllTexts/NPC_texts.amb/063/001.txt
msgctxt "AllTexts/NPC_texts.amb/063/001"
msgid "\"WELCOME, ADVENTURERS! I WOULD PREFER TO BE LEFT ALONE WITH MY SADNESS AT THE MOMENT.\""
msgstr ""

#. Dialogue of NPC 063 (FERRIN).
#. German: "\"LEBT WOHL!\""
#: AllTexts/NPC_texts.amb/063/002.txt
msgctxt "AllTexts/NPC_texts.amb/063/002"
msgid "\"FAREWELL!\""
msgstr ""

#. Dialogue of NPC 063 (FERRIN).
#. German: "~INK 30~ FERRIN WIRFT EUCH EINEN FINSTEREN BLICK ZU, SCHLIEßLICH HOLT ER TIEF ATEM UND REDET DOCH WEITER:^ ~INK 31~ \"NUN GUT! ICH SOLLTE KEINE CHANCE VERSÄUMEN. VIELLEICHT KÖNNT IHR HERAUSFINDEN, WAS PASSIERT IST.^ VOR VIER TAGEN IST MEINE KLEINE TOCHTER IM LAGERKELLER MEINES EIGENEN HAUSES VERSCHWUNDEN. SIE SOLLTE VON DORT ETWAS HERAUFHOLEN, WIE SCHON SO OFT. SIE KAM NIE WIEDER, IST SPURLOS VERSCHWUNDEN. ALLES SUCHEN WAR VERGEBENS. WIR FANDEN SPUREN VON KLAUENBEWEHRTEN PFOTEN, ABER KEINE DER VERFLUCHTEN BESTIEN WAR ZU SEHEN. WIR WISSEN NICHT, WAS PASSIERT IST, UND UNSERE HOFFNUNG WIRD TAG FÜR TAG GERINGER.\"^ ~INK 30~ ER SCHLIEßT DIE AUGEN UND FLÜSTERT NUR NOCH:^ ~INK 31~ \"ICH..., ICH SELBER HABE SIE DORT HINUNTERGESCHICKT.\"^ ~INK 30~ ER HÄNDIGT EUCH WORTLOS EINEN SCHLÜSSEL AUS."
#: AllTexts/NPC_texts.amb/063/003.txt
msgctxt "AllTexts/NPC_texts.amb/063/003"
msgid "~INK 30~ FERRIN LOOKS AT YOU BLACKLY AND FINALLY TAKES A DEEP BREATH AND CONTINUES:^ ~INK 31~ \"WELL, OKAY! I SHOULD NOT MISS AN OPPORTUNITY. PERHAPS YOU CAN FIND OUT WHAT HAS HAPPENED.^ FOUR DAYS AGO MY LITTLE DAUGHTER DISAPPEARED FROM THE STORAGE CELLAR AT MY OWN HOME. SHE WAS SUPPOSED TO FETCH SOMETHING, AS SO OFTEN. SHE NEVER RETURNED, SIMPLY DISAPPEARED WITHOUT TRACE. ALL OUR SEARCHING WAS IN VAIN. WE FOUND TRACKS LEFT BY FEET WITH CLAWS BUT NONE OF THE DAMNED BEASTS WERE TO BE SEEN. WE DON'T KNOW WHAT HAPPENED AND HOPE IS DYING DAY BY DAY.\"^ ~INK 30~ HE CLOSES HIS EYES AND JUST WHISPERS:^ ~INK 31~ \"I..., I SENT HER DOWN THERE MYSELF.\"^ ~INK 30~ HE HANDS YOU A KEY WITHOUT SAYING ANOTHER WORD."
msgstr ""

#. Dialogue of NPC 063 (FERRIN).
#. German: "\"DER KELLER ENTSTAND BEI EINER PROBEGRABUNG. DIE MINE WURDE JEDOCH NIE FERTIGESTELLT, UND SO HABE ICH DIE RÄUME ALS LAGER BENUTZT. IHR KÖNNT ES DURCH DEN KELLER ERREICHEN. NEHMT DIE TREPPE HINTER DER TÜR IM WESTLICHEN TEIL DES HAUSES. BITTE - VERSUCHT ETWAS ZU FINDEN! SELBST DIE SCHLECHTESTE NACHRICHT IST BESSER ALS DIESE UNGEWISSHEIT.\""
#: AllTexts/NPC_texts.amb/063/004.txt
msgctxt "AllTexts/NPC_texts.amb/063/004"
msgid "\"THE CELLAR WAS BUILT DURING A TEST DIGGING. BUT THE MINE WAS NEVER FINISHED AND SO I USED THE ROOMS FOR STORAGE. YOU CAN GO THROUGH THE CELLAR. TAKE THE STEPS BEHIND THE DOOR IN THE WEST PART OF THE HOUSE. PLEASE - TRY TO FIND SOMETHING! EVEN THE WORST NEWS IS BETTER THAN THIS UNCERTAINTY.\""
msgstr ""

#. Dialogue of NPC 063 (FERRIN).
#. German: "\"BITTE, HELFT ODER SCHWEIGT!\""
#: AllTexts/NPC_texts.amb/063/005.txt
msgctxt "AllTexts/NPC_texts.amb/063/005"
msgid "\"PLEASE, HELP OR KEEP SILENT!\""
msgstr ""

#. Dialogue of NPC 063 (FERRIN).
#. German: "\"ES GIBT NUR EINEN ZUGANG ZUM LAGER. ICH VERSTEHE NICHT, WAS PASSIERT IST. ICH VERSTEHE ES EINFACH NICHT.\""
#: AllTexts/NPC_texts.amb/063/006.txt
msgctxt "AllTexts/NPC_texts.amb/063/006"
msgid "\"THERE IS ONLY ONE ENTRANCE TO THE STORE ROOM. I DO NOT UNDERSTAND WHAT HAPPENED. I SIMPLY DON'T UNDERSTAND IT.\""
msgstr ""

#. Dialogue of NPC 063 (FERRIN).
#. German: "\"HABT IHR SCHON ETWAS HERAUSFINDEN KÖNNEN?\""
#: AllTexts/NPC_texts.amb/063/007.txt
msgctxt "AllTexts/NPC_texts.amb/063/007"
msgid "\"HAVE YOU BEEN ABLE TO FIND ANYTHING?\""
msgstr ""

#. Dialogue of NPC 063 (FERRIN).
#. German: "\"BITTE, LASST MICH ZUFRIEDEN! HABT IHR KEINEN RESPEKT VOR DER TRAUER EINES VATERS?\""
#: AllTexts/NPC_texts.amb/063/008.txt
msgctxt "AllTexts/NPC_texts.amb/063/008"
msgid "\"PLEASE, LEAVE ME IN PEACE! HAVE YOU NO CONSIDERATION FOR A FATHER IN MOURNING?\""
msgstr ""

#. Dialogue of NPC 064 (GADRIN).
#. German: "HIER STEHT EIN MUSKULÖSER ZWERG IN VOLLER KAMPFAUSRÜSTUNG."
#: AllTexts/NPC_texts.amb/064/000.txt
msgctxt "AllTexts/NPC_texts.amb/064/000"
msgid "HERE STANDS A MUSCULAR DWARF IN FULL BATTLE UNIFORM."
msgstr ""

#. Dialogue of NPC 064 (GADRIN).
#. German: "\"GRÜßE, ABENTEURER! SELBST MICH HIER UNTEN HAT DIE KUNDE EURER TATEN ERREICHT. ICH STEHE HIER WACHE, SEIT DIE TORNAKS DIE MINE ÜBERRANNT HABEN.\"^ ~INK 30~ ER WIRFT EINEN BLICK AUF DIE TÜR NEBEN SICH.^ ~INK 31~ \"DAS TOR ZU DEN UNTEREN MINEN IST DAS EINZIGE, WAS UNS VOR RAUBZÜGEN DER BESTIEN SCHÜTZT.\""
#: AllTexts/NPC_texts.amb/064/001.txt
msgctxt "AllTexts/NPC_texts.amb/064/001"
msgid "\"WELCOME, ADVENTURERS! NEWS OF YOUR DEEDS HAS EVEN REACHED ME DOWN HERE. I HAVE BEEN ON GUARD SINCE THE TORNAKS OVERRAN THE MINE.\"^ ~INK 30~ HE GLANCES AT THE DOOR NEXT TO HIM.^ ~INK 31~ \"THE DOOR TO THE BOTTOM MINES IS THE ONLY THING PROTECTING US AGAINST THE BEASTS.\""
msgstr ""

#. Dialogue of NPC 064 (GADRIN).
#. German: "\"MÖGE EUCH DAS GLÜCK AUF EUREM GEFAHRVOLLEN WEG TREU BLEIBEN!\""
#: AllTexts/NPC_texts.amb/064/002.txt
msgctxt "AllTexts/NPC_texts.amb/064/002"
msgid "\"MAY LUCK REMAIN WITH YOU ON YOUR HAZARDOUS JOURNEY!\""
msgstr ""

#. Dialogue of NPC 064 (GADRIN).
#. German: "\"IHR HABT SICHERLICH SCHON VON IHNEN GEHÖRT, SCHEUßLICHE BIESTER! EINES MORGENS TAUCHTEN DUTZENDE DAVON IN DEN MINEN AUF, SIE MÜSSEN SICH AUßERGEWÖHNLICH TIEFE GÄNGE GEGRABEN HABEN. SIE HABEN SICH SOFORT AUF UNS GESTÜRZT, ES GAB EINIGE TOTE. WIR HABEN UNS SCHLIEßLICH ZURÜCKGEZOGEN, UM WEITERE OPFER ZU VERMEIDEN.\""
#: AllTexts/NPC_texts.amb/064/003.txt
msgctxt "AllTexts/NPC_texts.amb/064/003"
msgid "\"YOU HAVE PROBABLY HEARD ABOUT THE HORRIBLE BEASTS! ONE MORNING DOZENS OF THEM APPEARED IN THE MINES, THEY MUST HAVE DUG EXTRAORDINARILY DEEP PASSAGES. THEY HURTLED STRAIGHT AT US, KILLING SOME OF US AT ONCE. WE THEN HAD TO WITHDRAW TO AVOID ANY FURTHER DEATHS.\""
msgstr ""

#. Dialogue of NPC 064 (GADRIN).
#. German: "\"NEHMT EUCH VOR DIESEN WILDGEWORDENEN TEUFELN NUR IN ACHT!\""
#: AllTexts/NPC_texts.amb/064/004.txt
msgctxt "AllTexts/NPC_texts.amb/064/004"
msgid "\"BEWARE OF THOSE WILD DEVILS!\""
msgstr ""

#. Dialogue of NPC 064 (GADRIN).
#. German: "\"IHR MÖCHTET WIRKLICH DURCH DAS TOR IN DIE UNTEREN MINEN? IHR SEID GEWARNT!\"^ ~INK 30~ ER ZIEHT DAS MASSIVE TOR IN DIE HÖHE.^ ~INK 31~ \"ICH WERDE DAS TOR HINTER EUCH SCHLIEßEN. SOLLTET IHR DEM TOLLHAUS DORT UNTEN ENTKOMMEN, SO KLOPFT KRÄFTIG! ICH WERDE ZUR STELLE SEIN, UM ZU ÖFFNEN.\""
#: AllTexts/NPC_texts.amb/064/005.txt
msgctxt "AllTexts/NPC_texts.amb/064/005"
msgid "\"YOU REALLY WANT TO GO THROUGH THE GATE INTO THE LOWER MINES? BE WARNED!\"^ ~INK 30~ HE PULLS UP THE MASSIVE DOOR.^ ~INK 31~ \"I WILL CLOSE THE DOOR BEHIND YOU. IF YOU ESCAPE THE MADHOUSE DOWN THERE, KNOCK LOUDLY! I WILL BE HERE TO OPEN IT FOR YOU.\""
msgstr ""

#. Dialogue of NPC 064 (GADRIN).
#. German: "\"DAS TOR IST OFFEN, DER WEG IN DIE GEFAHR IST FREI!\""
#: AllTexts/NPC_texts.amb/064/006.txt
msgctxt "AllTexts/NPC_texts.amb/064/006"
msgid "\"THE DOOR IS OPEN, THE WAY INTO DANGER IS CLEAR!\""
msgstr ""

#. Dialogue of NPC 064 (GADRIN).
#. German: "\"DIE VERSUCHSMINE WIRD VON KIRE UNTERHALTEN. NICHT, DASS SIE VIEL ABWERFEN WÜRDE, ABER WIR WISSEN NUN ZUMINDEST, DASS UNSER ANGEBLICHES PARADIES AUCH UNTERIRDISCH NICHT VIEL ZU BIETEN HAT. ES GIBT HIER KAUM VERWERTBARE METALLE UND NUR WENIG REIZVOLLE MINERALIEN.\""
#: AllTexts/NPC_texts.amb/064/007.txt
msgctxt "AllTexts/NPC_texts.amb/064/007"
msgid "\"THE TEST MINE IS MANAGED BY KIRE. IT IS NOT THAT IT WOULD PRODUCE MUCH BUT WE NOW AT LEAST KNOW THAT OUR ALLEGED PARADISE DOESN'T HAVE MUCH TO OFFER BELOW GROUND EITHER. THERE ARE HARDLY ANY VALUABLE METALS HERE AND JUST A FEW MINERALS.\""
msgstr ""

#. Dialogue of NPC 064 (GADRIN).
#. German: "\"WIE GESAGT, DIES IST KEINE ERGIEBIGE MINE. ICH BIN ABER GERN HIER UNTEN, FERN VON DEM LÄRM, DEN DIE TIERE MACHEN.\""
#: AllTexts/NPC_texts.amb/064/008.txt
msgctxt "AllTexts/NPC_texts.amb/064/008"
msgid "\"AS WE SAID, THIS IS NOT A VERY PRODUCTIVE MINE. BUT I LIKE IT DOWN HERE, AWAY FROM ALL THE NOISE THE ANIMALS MAKE.\""
msgstr ""

#. Dialogue of NPC 064 (GADRIN).
#. German: "\"AB UND ZU FINDEN WIR GROßE BROCKEN DAVON.\""
#: AllTexts/NPC_texts.amb/064/009.txt
msgctxt "AllTexts/NPC_texts.amb/064/009"
msgid "\"NOW AND AGAIN WE FIND LARGE LUMPS OF IT.\""
msgstr ""

#. Dialogue of NPC 064 (GADRIN).
#. German: "\"NEHMT EUCH DAVON, WAS IHR FINDEN KÖNNT. BERNSTEIN IST NICHT BESONDERS BEGEHRT.\""
#: AllTexts/NPC_texts.amb/064/010.txt
msgctxt "AllTexts/NPC_texts.amb/064/010"
msgid "\"TAKE WHAT YOU CAN FIND. AMBER IS NOTHING VERY SPECIAL.\""
msgstr ""

#. Dialogue of NPC 064 (GADRIN).
#. German: "\"SEID NOCHMALS GEGRÜßT, ABENTEURER!\""
#: AllTexts/NPC_texts.amb/064/011.txt
msgctxt "AllTexts/NPC_texts.amb/064/011"
msgid "\"WELCOME AGAIN, ADVENTURERS!\""
msgstr ""

#. Dialogue of NPC 065 (FERRIN).
#. German: "IHR SEHT EINEN KRAFTSTROTZENDEN ZWERG, DER FRÖHLICH MIT EINEM MINDESTENS ZWANZIG KILO SCHWEREN HAMMER SPIELT. NICHT EINMAL SEIN BART KANN SEIN STRAHLENDES LÄCHELN VERBERGEN."
#: AllTexts/NPC_texts.amb/065/000.txt
msgctxt "AllTexts/NPC_texts.amb/065/000"
msgid "YOU SEE A POWERFUL DWARF WHO IS PLAYING HAPPILY WITH A HAMMER WEIGHING AT LEAST TWENTY KILOGRAMS. NOT EVEN HIS THICK BEARD CAN HIDE HIS BROAD SMILE."
msgstr ""

#. Dialogue of NPC 065 (FERRIN).
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "\"IHR HABT UNS ZU DEN GLÜCKLICHSTEN ZWERGEN AUF DEM MOND GEMACHT, FREUNDE! WELCH EINE UNGLAUBLICHE GESCHICHTE, WELCH SELTSAME FÄHIGKEITEN SCHLUMMERN IN MEINER TOCHTER!^ DOCH LASST MICH EUCH ETWAS HANDFESTERES ALS UNSEREN DANK MIT AUF DEN WEG GEBEN.\"^ ~INK 30~ ER HOLT EINE KUNSTVOLL GEARBEITETE ARMBRUST HERVOR. SIE IST AUS DUNKLEM HOLZ UND EINEM SELTSAMEN METALL GEFERTIGT, DAS IN ALLEN FARBEN SCHILLERT.^ ~INK 31~ \"DIESES KLEINE SCHÄTZCHEN HABE ICH VOR KURZEM AUS DEN EDELSTEN HÖLZERN UND DEM LETZTEN REST LUMIDRA GEFERTIGT. DIESES METALL WURDE VON EINEM BERÜHMTEN URAHNEN MEINER FAMILIE MIT HILFE VON MAGIE ERZEUGT. DIE ARMBRUST IST LEICHT, VON JEDEM ZU HANDHABEN, UND DAS BESTE IST: SIE BENÖTIGT KEINE BOLZEN!\"^ ~INK 30~ MIT DIESEN WORTEN ÜBERGIBT ER ~LEAD~ DIE WAFFE. SIE IST ÜBERRASCHEND LEICHT UND LIEGT WUNDERBAR IN DER HAND."
#: AllTexts/NPC_texts.amb/065/001.txt
msgctxt "AllTexts/NPC_texts.amb/065/001"
msgid "\"YOU HAVE MADE US THE HAPPIEST DWARFS ON THE MOON, FRIENDS! WHAT AN INCREDIBLE STORY, WHAT STRANGE ABILITIES ARE SLUMBERING IN MY DAUGHTER!^ BUT LET ME GIVE YOU SOMETHING MORE SOLID BY WAY OF THANKS.\"^ ~INK 30~ HE PULLS OUT AN ARTISTICALLY WORKED BOW. IT IS MADE OF A DARK WOOD AND A STRANGE METAL WHICH SHIMMERS IN EVERY COLOUR.^ ~INK 31~ \"I MADE THIS LITTLE TREASURE A SHORT TIME AGO FROM THE BEST WOOD AND THE LAST REMAINS OF LUMIDRA. THIS METAL WAS PRODUCED BY MAGIC BY THE FAMOUS ANCESTORS OF MY FAMILY. THE BOW IS LIGHT IN WEIGHT, SO THAT ANYONE CAN USE IT, AND THE BEST THING IS, IT DOES NOT NEED A BOLT!\"^ ~INK 30~ WITH THESE WORDS HE HANDS THE WEAPON TO ~LEAD~. IT IS SURPRISINGLY LIGHT AND SITS WONDERFULLY SNUGLY IN HIS HAND."
msgstr ""

#. Dialogue of NPC 065 (FERRIN).
#. German: "\"LEBT WOHL! IHR SEID IMMER WILLKOMMEN IN MEINEM HAUS.\""
#: AllTexts/NPC_texts.amb/065/002.txt
msgctxt "AllTexts/NPC_texts.amb/065/002"
msgid "\"FAREWELL! YOU ARE ALWAYS WELCOME IN MY HOUSE.\""
msgstr ""

#. Dialogue of NPC 065 (FERRIN).
#. German: "\"SEID GEGRÜßT, MEINE FREUNDE! EUER ANBLICK MACHT MICH FROH!\""
#: AllTexts/NPC_texts.amb/065/003.txt
msgctxt "AllTexts/NPC_texts.amb/065/003"
msgid "\"WELCOME, MY FRIENDS! I AM PLEASED TO SEE YOU!\""
msgstr ""

#. Dialogue of NPC 065 (FERRIN).
#. German: "\"MEINER TOCHTER GEHT ES RECHT GUT. WIR MÜSSEN NUR HÖLLISCH AUFPASSEN: SIE WILL AB UND ZU IHRE 'FREUNDE' BESUCHEN, HA!\""
#: AllTexts/NPC_texts.amb/065/004.txt
msgctxt "AllTexts/NPC_texts.amb/065/004"
msgid "\"MY DAUGHTER IS VERY WELL. WE ONLY HAVE TO BE VERY CAREFUL - NOW AND AGAIN SHE WANTS TO VISIT HER 'FRIENDS', HA-HA!\""
msgstr ""

#. Dialogue of NPC 066 (ASRUB).
#. German: "EIN ÄLTERER ZWERG MIT HAGEREM GESICHT, DER IN EINE ART TUNIKA GEKLEIDET IST, STEHT VOR EUCH."
#: AllTexts/NPC_texts.amb/066/000.txt
msgctxt "AllTexts/NPC_texts.amb/066/000"
msgid "AN OLDER DWARF WITH A THIN FACE AND DRESSED IN A TYPE OF TUNIC STANDS BEFORE YOU."
msgstr ""

#. Dialogue of NPC 066 (ASRUB).
#. German: "\"WILLKOMMEN IN MEINEM HAUS, ABENTEURER VON LYRAMION! SOLLTET IHR MEINER MAGIE BEDÜRFEN, WENDET EUCH ZUVOR AN MEINE GEHILFIN.\""
#: AllTexts/NPC_texts.amb/066/001.txt
msgctxt "AllTexts/NPC_texts.amb/066/001"
msgid "\"WELCOME TO MY HOUSE, ADVENTURERS FROM LYRAMION! IF YOU NEED MY MAGIC, PLEASE SPEAK TO MY ASSISTANT FIRST.\""
msgstr ""

#. Dialogue of NPC 066 (ASRUB).
#. German: "\"LEBT WOHL, REISENDE!\""
#: AllTexts/NPC_texts.amb/066/002.txt
msgctxt "AllTexts/NPC_texts.amb/066/002"
msgid "\"FAREWELL, TRAVELLERS!\""
msgstr ""

#. Dialogue of NPC 066 (ASRUB).
#. German: "\"FÜR MICH STELLT DIE MAGIE KEIN ALLHEILMITTEL DAR. ICH BENUTZE SIE NUR IN SCHWEREN FÄLLEN ODER LASSE SIE MIR TEUER BEZAHLEN, DENN ICH HALTE VIEL VON DEN NATÜRLICHEN HEILKRÄFTEN DES KÖRPERS. AUßERDEM LEHRT DIE LANGWIERIGE HEILUNG, IN ZUKUNFT VORSICHTIGER DURCHS LEBEN ZU GEHEN.^ OFTMALS IST DER EINSATZ VON MAGIE JEDOCH GERECHTFERTIGT, WIE BEI DEM PATIENTEN IM BETTENSAAL, EINEM ARMEN KERL AUS DEN MINEN VON DOR KIREDON.\""
#: AllTexts/NPC_texts.amb/066/003.txt
msgctxt "AllTexts/NPC_texts.amb/066/003"
msgid "\"FOR ME, MAGIC CANNOT HEAL EVERYTHING. I ONLY USE IT IN DIFFICULT CASES OR CHARGE A LOT OF MONEY FOR IT, FOR I BELIEVE STRONGLY IN THE NATURAL HEALING POWER OF THE BODY. ALSO A LONG REHABILIATION TEACHES US TO BE MORE CAREFUL WITH LIFE IN THE FUTURE.^ OFTEN THE USE OF MAGIC IS JUSTIFIED, HOWEVER, AS FOR EXAMPLE ON THE PATIENT IN THE BEDROOM, A POOR CHAP FROM THE MINES OF DOR KIREDON.\""
msgstr ""

#. Dialogue of NPC 066 (ASRUB).
#. German: "\"WIE ICH BEREITS ERWÄHNTE, ICH ZIEHE ES VOR, MAGIE NUR IN FÄLLEN ANZUWENDEN, BEI DENEN NATÜRLICHE MITTEL NICHT MEHR HELFEN KÖNNEN.\""
#: AllTexts/NPC_texts.amb/066/004.txt
msgctxt "AllTexts/NPC_texts.amb/066/004"
msgid "\"AS I ALREADY MENTIONED, I PREFER TO USE MAGIC ONLY WHERE NATURAL MEANS CAN NO LONGER HELP.\""
msgstr ""

#. Dialogue of NPC 066 (ASRUB).
#. German: "\"IHR HABT MEINEN BRUDER GETROFFEN? ICH HOFFE, ES GEHT IHM GUT; ICH HABE IHN SCHON SEIT EIN PAAR MONATEN NICHT GESEHEN. ICH VERSUCHE IHN OFT ZU ÜBERREDEN, NACH DOR GRESTIN ÜBERZUSIEDELN, ABER ER FÜHLT SICH DEN BÜRGERN VON DOR KIREDON VERPFLICHTET.\""
#: AllTexts/NPC_texts.amb/066/005.txt
msgctxt "AllTexts/NPC_texts.amb/066/005"
msgid "\"YOU MET MY BROTHER? I HOPE HE IS WELL. I'VE NOT SEEN HIM FOR A FEW MONTHS. I OFTEN TRY TO TALK HIM INTO MOVING TO DOR GRESTIN BUT HE FEELS HE OWES IT TO THE PEOPLE OF DOR KIREDON TO STAY THERE.\""
msgstr ""

#. Dialogue of NPC 066 (ASRUB).
#. German: "\"NUN, ICH HOFFE, BALD WIEDER ZEIT FÜR EINEN BESUCH BEI MEINEM BRUDER ZU HABEN.\""
#: AllTexts/NPC_texts.amb/066/006.txt
msgctxt "AllTexts/NPC_texts.amb/066/006"
msgid "\"WELL, I HOPE TO HAVE TIME TO VISIT MY BROTHER SOON.\""
msgstr ""

#. Dialogue of NPC 066 (ASRUB).
#. German: "\"ER IST EINER DER ÜBERLEBENDEN DES TORNAK-ÜBERFALLS IN DER MINE VON DOR KIREDON. SEINE VERWANDTEN BRACHTEN IHN HIERHER, KEINE STUNDE ZU FRÜH. ICH KONNTE IHN GERADE NOCH VOR DEM TOD BEWAHREN. SPRECHT IHN RUHIG AN, ER IST INZWISCHEN ÜBER DEN BERG.\""
#: AllTexts/NPC_texts.amb/066/007.txt
msgctxt "AllTexts/NPC_texts.amb/066/007"
msgid "\"HE IS ONE OF THE SURVIVORS OF THE TORNAK ATTACK IN THE MINE AT DOR KIREDON. HIS RELATIVES BROUGHT HIM HERE, NOT A MINUTE TOO SOON. I WAS JUST ABLE TO SAVE HIM FROM DEATH. DO SPEAK TO HIM.\""
msgstr ""

#. Dialogue of NPC 066 (ASRUB).
#. German: "\"JA, SPRECHT NUR MIT IHM! EIN WENIG ABWECHSLUNG TUT IHM GUT.\""
#: AllTexts/NPC_texts.amb/066/008.txt
msgctxt "AllTexts/NPC_texts.amb/066/008"
msgid "\"YES, JUST SPEAK TO HIM! A LITTLE DISTRACTION WILL DO HIM GOOD.\""
msgstr ""

#. Dialogue of NPC 066 (ASRUB).
#. German: "\"SEID GEGRÜßT! WIE KANN ICH EUCH NOCHMALS BEHILFLICH SEIN?\""
#: AllTexts/NPC_texts.amb/066/009.txt
msgctxt "AllTexts/NPC_texts.amb/066/009"
msgid "\"WELCOME! HOW CAN I HELP AGAIN?\""
msgstr ""

#. Dialogue of NPC 066 (ASRUB).
#. German: "~INK 30~ DER ANFLUG EINES LÄCHELNS ZEIGT SICH AUF ASRUB'S GESICHT.^ ~INK 31~ \"JA, VIELE DER PFLANZEN UNSERES WALDMONDES ZEIGEN FÜRWAHR ERSTAUNLICHE WIRKUNG. SCHADE NUR, DASS ES SO GEFÄHRLICH IST, NACH IHNEN ZU SUCHEN. ES GIBT EINIGE EXTREM SELTENE KRÄUTER UND PILZE, DIE SOGAR PERMANENTE WIRKUNG AUF KÖRPER UND GEIST DESJENIGEN HABEN, DER SIE ZU SICH NIMMT!\"^ ~INK 30~ ASRUB ERZÄHLT BEGEISTERT WEITER UND BESCHREIBT ZAHLREICHE BESONDERE KRÄUTER. IHR MERKT EUCH SEINE AUSFÜHRUNGEN ÜBER WERTVOLLE PFLANZEN GENAU."
#: AllTexts/NPC_texts.amb/066/010.txt
msgctxt "AllTexts/NPC_texts.amb/066/010"
msgid "~INK 30~ THE TRACES OF A SMILE APPEAR ON ASRUB'S FACE.^ ~INK 31~ \"YES, MANY OF THE PLANTS ON OUR FOREST MOON TRULY HAVE ASTONISHING EFFECTS. IT IS JUST A SHAME THAT SEARCHING FOR THEM IS SO DANGEROUS. THERE ARE SOME VERY RARE HERBS AND MUSHROOMS WHICH SOMETIMES EVEN HAVE A PERMANENT EFFECT ON THE BODY AND SPIRIT OF THOSE WHO TAKE THEM!\"^ ~INK 30~ ASRUB CONTINUES ENTHUSIASTICALLY AND DESCRIBES NUMEROUS SPECIAL HERBS. YOU NOTE HIS STATEMENTS ABOUT VALUABLE PLANTS WITH GREAT INTEREST."
msgstr ""

#. Dialogue of NPC 066 (ASRUB).
#. German: "\"ICH HABE EUCH BEREITS ALLES ÜBER KRÄUTER GESAGT, WAS ICH WEISS.\""
#: AllTexts/NPC_texts.amb/066/011.txt
msgctxt "AllTexts/NPC_texts.amb/066/011"
msgid "\"I HAVE ALREADY TOLD YOU EVERYTHING I KNOW ABOUT HERBS.\""
msgstr ""

#. Dialogue of NPC 067 (GORBAN).
#. German: "EIN ÜBEL ZUGERICHTETER ZWERG LIEGT IN DIESEM BETT. ER ÖFFNET DIE AUGEN, ALS IHR NÄHERKOMMT."
#: AllTexts/NPC_texts.amb/067/000.txt
msgctxt "AllTexts/NPC_texts.amb/067/000"
msgid "A BADLY INJURED DWARF LIES IN THIS BED. HE OPENS HIS EYES AS YOU APPROACH."
msgstr ""

#. Dialogue of NPC 067 (GORBAN).
#. German: "~INK 30~ GORBAN BLICKT ERSTAUNT AUF DIE GRUPPE, UND SEINE SCHLÄFRIGKEIT FÄLLT VON IHM AB.^ ~INK 31~ \"ICH GRÜßE EUCH! WIE KOMMT IHR HIERHER, LEUTE AUS DEM GROßEN VOLK?\"^ ~INK 30~ IHR BERICHTET VON EURER FAHRT ZUM GRÜNEN MOND. GORBAN LAUSCHT FASZINIERT UND SAGT ANSCHLIEßEND:^ ~INK 31~ \"DA HABE ICH FÜRWAHR EINIGES VERPASST!\""
#: AllTexts/NPC_texts.amb/067/001.txt
msgctxt "AllTexts/NPC_texts.amb/067/001"
msgid "~INK 30~ GORBAN LOOKS AT THE GROUP IN ASTONISHMENT AND QUICKLY BECOMES WIDE AWAKE.^ ~INK 31~ \"WELCOME! HOW DID YOU GET HERE, GIANT PEOPLE?\"^ ~INK 30~ YOU TELL HIM OF YOUR JOURNEY TO THE GREEN MOON. GORBAN LISTENS IN FASCINATION AND THEN SAYS:^ ~INK 31~ \"I CERTAINLY MISSED SOMETHING, DIDN'T I!\""
msgstr ""

#. Dialogue of NPC 067 (GORBAN).
#. German: "\"LEBT WOHL! ICH HOFFE, EUCH WIDERFÄHRT NICHT SOVIEL PECH WIE MIR!\""
#: AllTexts/NPC_texts.amb/067/002.txt
msgctxt "AllTexts/NPC_texts.amb/067/002"
msgid "\"FAREWELL! I HOPE YOU HAVE BETTER LUCK THAN I!\""
msgstr ""

#. Dialogue of NPC 067 (GORBAN).
#. German: "\"DIESE BESTIEN! SIE HABEN MIR DIE SCHLIMMSTEN TAGE MEINES LEBENS BESCHERT! ICH HATTE SCHON EIN PAAR TAGE VOR DEM ÜBERFALL DAS GEFÜHL, DASS IN DER MINE ETWAS NICHT STIMMT. GEGENSTÄNDE VERSCHWANDEN, LEUCHTGLOBEN SIND ZERSCHMETTERT WORDEN. DIE URSACHE WAR JEDOCH NICHT ZU ENTDECKEN. ALS ICH EINES MORGENS EINEN GANG ERWEITERN WOLLTE, PASSIERTE ES: AN EINER STELLE WAR DAS GESTEIN UNGEWÖHNLICH WEICH UND KLEBRIG. DAHINTER ERWARTETE MICH EINE GANZE HORDE TORNAKS! ICH KANN ES MIR NUR SO ERKLÄREN, DASS SIE IHRE GÄNGE MANCHMAL WIEDER VERSCHLIEßEN.\"^ ~INK 30~ GORBAN SCHLIEßT DIE AUGEN ALS ER SICH AN DIE DARAUFOLGENDEN EREIGNISSE ERINNERT.^ ~INK 31~ \"JEDENFALLS STÜRZTEN SICH DIE BESTIEN SOFORT AUF MICH, UND DIE ANDEREN, SIE ÜBERFLUTETEN DIE MINE FÖRMLICH. ES WAR GRAUENHAFT...!\""
#: AllTexts/NPC_texts.amb/067/003.txt
msgctxt "AllTexts/NPC_texts.amb/067/003"
msgid "\"THOSE BEASTS! THEY WERE RESPONSIBLE FOR THE WORST DAY OF MY LIFE! A FEW DAYS BEFORE THE ATTACK I FELT THAT SOMETHING WAS WRONG IN THE MINE. THINGS WERE DISAPPEARING, LAMPS WERE SMASHED. WE COULD NOT DISCOVER WHY. THEN, ONE MORNING WHEN I WANTED TO GO ALONG A PASSAGEWAY, IT HAPPENED: AT ONE POINT THE ROCK WAS UNUSUALLY SOFT AND GLUEY. BEHIND IT WAS A WHOLE HORDE OF TORNAKS WAITING FOR ME! I CAN ONLY EXPLAIN IT BY SAYING THAT THEY MUST SOMEHOW SEAL THEIR PASSAGEWAYS AGAIN.\"^ ~INK 30~ GORBAN CLOSES HIS EYES AS IF REMEMBERING THE EVENTS THAT THEN HAPPENED.^ ~INK 31~ \"ANYWAY, THE BEASTS JUMPED ON ME RIGHT AWAY AND THE OTHERS POURED INTO THE MINE. IT WAS HORRIBLE ...!\""
msgstr ""

#. Dialogue of NPC 067 (GORBAN).
#. German: "\"SOBALD ICH WIEDER GANZ GENESEN BIN, WERDE ICH ERST EINMAL URLAUB NEHMEN. MIR IST GAR NICHT DANACH ZUMUTE, SCHON WIEDER IN DIE MINE ZU KLETTERN.\""
#: AllTexts/NPC_texts.amb/067/004.txt
msgctxt "AllTexts/NPC_texts.amb/067/004"
msgid "\"WHEN I HAVE RECOVERED FULLY, I WILL FIRST TAKE A HOLIDAY. I AM NOT READY YET TO GO BACK TO THE MINE.\""
msgstr ""

#. Dialogue of NPC 067 (GORBAN).
#. German: "\"SEID GEGRÜßT! WAS VERSCHAFFT MIR DIE EHRE EURES ABERMALIGEN BESUCHS?\""
#: AllTexts/NPC_texts.amb/067/005.txt
msgctxt "AllTexts/NPC_texts.amb/067/005"
msgid "\"WELCOME! TO WHAT DO I OWE THE PLEASURE OF YOUR VISIT AGAIN?\""
msgstr ""

#. Dialogue of NPC 067 (GORBAN).
#. German: "\"DIE MINE VON DOR KIREDON IST LEDIGLICH EINE VERSUCHSMINE. BISHER HABEN WIR NICHT VIEL LOHNENDES GEFUNDEN.\"^ ~INK 30~ BEI DIESEM SATZ BLICKT GORBAN ANGESTRENGT AUF DIE FINGERNÄGEL SEINER NICHT VERBUNDENEN HAND. MAN KÖNNTE MEINEN, DASS ER ETWAS VERSCHWEIGT."
#: AllTexts/NPC_texts.amb/067/006.txt
msgctxt "AllTexts/NPC_texts.amb/067/006"
msgid "\"THE MINE AT DOR KIREDON IS ONLY A TEST MINE. WE HAVE NOT FOUND MUCH OF VALUE YET.\"^ ~INK 30~ WITH THESE WORDS GORBAN STARES INTENTLY AT THE FINGERNAILS OF HIS ONE UNBANDAGED HAND. WE SENSE HE IS HOLDING SOMETHING BACK."
msgstr ""

#. Dialogue of NPC 067 (GORBAN).
#. German: "\"NUN, WIE ICH SCHON SAGTE, DIE MINE ENTHÄLT AUßER EIN PAAR DUTZEND TORNAKS NICHTS WEITER AUFREGENDES...\""
#: AllTexts/NPC_texts.amb/067/007.txt
msgctxt "AllTexts/NPC_texts.amb/067/007"
msgid "\"WELL, AS I SAID, APART FROM A FEW DOZEN TORNAKS THE MINE CONTAINS NOTHING EXCITING ...\""
msgstr ""

#. Dialogue of NPC 067 (GORBAN).
#. German: "\"ICH VERDANKE IHM MEIN LEBEN! ICH UND MEINE FAMILIE STEHEN TIEF IN SEINER SCHULD.\""
#: AllTexts/NPC_texts.amb/067/008.txt
msgctxt "AllTexts/NPC_texts.amb/067/008"
msgid "\"I OWE HIM MY LIFE! I AND MY FAMILY ARE DEEP IN HIS DEBT.\""
msgstr ""

#. Dialogue of NPC 068 (ADERIN).
#. German: "EIN JUNGER ELF STEHT VOR EUCH."
#: AllTexts/NPC_texts.amb/068/000.txt
msgctxt "AllTexts/NPC_texts.amb/068/000"
msgid "A YOUNG ELF STANDS BEFORE YOU."
msgstr ""

#. Dialogue of NPC 068 (ADERIN).
#. German: "~INK 30~ EIN JUNGER MANN MIT ELFENHAFTEN ZÜGEN SPRICHT EUCH AN. KEINER VON EUCH VERSTEHT JEDOCH SEINE SPRACHE, UND AUCH ALLE EUCH BEKANNTEN SPRACHEN FÜHREN ZU KEINER VERSTÄNDIGUNG. DA BIETET DER ELF JEDEM VON EUCH EINE KLEINE FRUCHT AN. ZÖGERND WERFT IHR EUCH EINIGE BLICKE ZU, ENTSCHEIDET EUCH ABER SCHLIEßLICH, DIE FRÜCHTE ANZUNEHMEN. DIE HÄNDE DES JUNGEN ELFEN FÜHREN KOMPLIZIERTE GESTEN AUS, ALS IHR ZU ESSEN BEGINNT. NACH EINIGER ZEIT BEGINNEN DIE WORTE EURES GESPRÄCHSPARTNERS MEHR UND MEHR SINN ZU MACHEN.^ ~INK 31~ \"ICH GRÜßE EUCH! ICH BIN ADERIN VOM VOLK DER ELFEN. WIR VERWENDEN DIESE FRÜCHTE UND DEN ZAUBER OFT, UM MIT, VERZEIHT MIR, TIEREN IN KONTAKT ZU TRETEN. SCHÖN, DASS SIE AUCH BEI INTELLIGENTEN WESEN WIRKUNG ZEIGEN! WO KOMMT IHR HER, DASS IHR KEINE DER BEKANNTEN SPRACHEN SPRECHT?\"^ ~INK 30~ IHR BERICHTET VON DER REISE DURCH DEN TELEPORTER UND ERKUNDIGT EUCH GESPANNT, WO IHR EUCH BEFINDET.^ ~INK 31~ \"NUN, IHR BEFINDET EUCH IN GADLON, DER ALTEN SCHULE DER MAGIE.\"^ ~INK 30~ AUF EURE FRAGE NACH EINER ETWAS ALLGEMEINEREN ORTSANGABE SAGT ADERIN:^ ~INK 31~ \"WIR SIND IN DER NÄHE VON PEGANA, AUF DEM HAUPTKONTINENT ONTAFLARETH.\"^ ~INK 30~ EUCH WIRD BEWUSST, DASS ES EUCH AUF EINE VÖLLIG ANDERE WELT VERSCHLAGEN HAT!"
#: AllTexts/NPC_texts.amb/068/001.txt
msgctxt "AllTexts/NPC_texts.amb/068/001"
msgid "~INK 30~ A YOUNG MAN WITH ELF-LIKE FEATURES SPEAKS TO YOU. BUT NO-ONE UNDERSTANDS HIS LANGUAGE AND ALL THE LANGUAGES YOU DO KNOW PRODUCE NO UNDERSTANDING AT ALL. THEN THE ELF OFFERS EACH OF YOU A SMALL FRUIT. HESITATING, YOU LOOK AT EACH OTHER BUT FINALLY DECIDE TO ACCEPT THE FRUIT. THE YOUNG ELF'S HANDS MAKE COMPLEX GESTURES AS YOU BEGIN TO EAT. AFTER A SHORT TIME THE WORDS HE SPEAKS START TO MAKE MORE AND MORE SENSE.^ ~INK 31~ \"WELCOME! I AM ADERIN, OF THE ELVES. WE USE THESE FRUITS AND THEIR MAGIC TO MAKE CONTACT WITH, FORGIVE ME, ANIMALS. IT IS GOOD THAT THEY ALSO HAVE AN EFFECT ON INTELLIGENT BEINGS! WHERE DO YOU COME FROM, FOR NOT ONE OF YOU SPEAKS ANY KNOWN LANGUAGE?\"^ ~INK 30~ YOU TELL HIM OF THE JOURNEY THROUGH THE TELEPORTER AND ASK EXCITEDLY WHERE YOU ARE.^ ~INK 31~ \"WELL, YOU ARE IN GADLON, THE OLD SCHOOL OF MAGIC.\"^ ~INK 30~ FOLLOWING YOUR QUESTION ABOUT A MORE GENERAL LOCATION ADERIN SAYS:^ ~INK 31~ \"WE ARE NEAR PEGANA, ON THE MAIN CONTINENT OF ONTAFLARETH.\"^ ~INK 30~ YOU REALISE YOU HAVE BEEN TRANSPORTED INTO A TOTALLY DIFFRENT WORLD!"
msgstr ""

#. Dialogue of NPC 068 (ADERIN).
#. German: "\"LEBT WOHL, BESUCHER AUS EINER ANDEREN WELT!\""
#: AllTexts/NPC_texts.amb/068/002.txt
msgctxt "AllTexts/NPC_texts.amb/068/002"
msgid "\"FAREWELL, VISITORS FROM ANOTHER WORLD!\""
msgstr ""

#. Dialogue of NPC 068 (ADERIN).
#. German: "\"SEID GEGRÜßT! KANN ICH EUCH NOCHMALS BEHILFLICH SEIN?\""
#: AllTexts/NPC_texts.amb/068/003.txt
msgctxt "AllTexts/NPC_texts.amb/068/003"
msgid "\"WELCOME! CAN I HELP YOU AGAIN?\""
msgstr ""

#. Dialogue of NPC 068 (ADERIN).
#. German: "\"NUN, HIER ENTSTEHT EIN ZENTRUM DES WISSENS ÜBER DIE NEUENTDECKTEN KÜNSTE DER ZAUBEREI. ICH BIN NEU HIER UND MÖCHTE MEIN LEBEN DER ERFORSCHUNG DER MAGIE WIDMEN.\""
#: AllTexts/NPC_texts.amb/068/004.txt
msgctxt "AllTexts/NPC_texts.amb/068/004"
msgid "\"WELL, THIS IS A CENTRE OF KNOWLEDGE FOR THE NEWLY-DISCOVERED ART OF MAGIC. I AM NEW HERE AND WOULD LIKE TO DEDICATE MY LIFE TO RESEARCH IN MAGIC.\""
msgstr ""

#. Dialogue of NPC 068 (ADERIN).
#. German: "\"IM AUGENBLICK WIRKT ALLES NOCH ETWAS VERFALLEN HIER, ABER DAS WIRD SICH BALD ÄNDERN.\""
#: AllTexts/NPC_texts.amb/068/005.txt
msgctxt "AllTexts/NPC_texts.amb/068/005"
msgid "\"AT THE MOMENT EVERYTHING SEEMS RATHER DILAPIDATED HERE BUT THAT WILL SOON CHANGE.\""
msgstr ""

#. Dialogue of NPC 068 (ADERIN).
#. German: "\"DIE AUSÜBUNG VON MAGIE WAR BEI UNS LANGE ZEIT VERPÖNT, ABER NUN BEGINNT EIN NEUES ZEITALTER DER ERFORSCHUNG DER GEHEIMEN KÜNSTE.\""
#: AllTexts/NPC_texts.amb/068/006.txt
msgctxt "AllTexts/NPC_texts.amb/068/006"
msgid "\"PRACTISING MAGIC WAS SCORNED BY OUR PEOPLE FOR A LONG TIME BUT NOW A NEW ERA HAS BEGUN, WITH RESEARCH INTO STRANGE AND SECRET ARTS.\""
msgstr ""

#. Dialogue of NPC 069 (BELLARD).
#. German: "IHR SEHT EINEN STÄMMIG GEBAUTEN MANN IN EINER ROBE."
#: AllTexts/NPC_texts.amb/069/000.txt
msgctxt "AllTexts/NPC_texts.amb/069/000"
msgid "YOU SEE A THICK-SET MAN WEARING A ROBE."
msgstr ""

#. Dialogue of NPC 069 (BELLARD).
#. German: "~INK 30~ DER MANN VOR EUCH IST IN EINE NEUE ROBE GEHÜLLT, DIE AUFFÄLLIG IN 'ZAUBERER'-MANIER GESTALTET IST. ER WIRFT EUCH EINEN STRENGEN BLICK ZU UND SPRICHT:^ ~INK 31~ \"FREMDE IN GADLON? WIE SEID IHR HIER HINEINGEKOMMEN?\"^ ~INK 30~ IHR ERZÄHLT AUCH IHM EURE GESCHICHTE.^ ~INK 31~ \"IHR HABT EUCH DURCH DIE ÜBUNGSHALLEN GESCHLAGEN?\"^ ~INK 30~ DIE TATSACHE, DASS IHR BESUCHER AUS EINER ANDEREN WELT SEID, BEEINDRUCKT IHN OFFENBAR WENIG.^ ~INK 31~ \"RINAKLES WIRD DAVON NICHT BEGEISTERT SEIN!\""
#: AllTexts/NPC_texts.amb/069/001.txt
msgctxt "AllTexts/NPC_texts.amb/069/001"
msgid "~INK 30~ THE MAN BEFORE YOU IS WEARING A NEW ROBE, EVIDENTLY DESIGNED TO SUIT THE STYLE OF A 'MAGICIAN'. HE LOOKS AT YOU STERNLY AND SAYS:^ ~INK 31~ \"STRANGERS IN GADLON? HOW DID YOU GET HERE?\"^ ~INK 30~ YOU TELL HIM YOUR STORY.^ ~INK 31~ \"YOU CAME THROUGH THE TRAINING ROOMS?\"^ ~INK 30~ THE FACT THAT YOU ARE VISITORS FROM ANOTHER WORLD APPARENTLY DOES NOT IMPRESS HIM VERY MUCH.^ ~INK 31~ \"RINAKLES WILL NOT BE PLEASED ABOUT THIS!\""
msgstr ""

#. Dialogue of NPC 069 (BELLARD).
#. German: "\"LEBT WOHL, UND BEHANDELT DIESE STÄTTE MIT EHRFURCHT!\""
#: AllTexts/NPC_texts.amb/069/002.txt
msgctxt "AllTexts/NPC_texts.amb/069/002"
msgid "\"FAREWELL, AND TREAT THIS PLACE WITH RESPECT!\""
msgstr ""

#. Dialogue of NPC 069 (BELLARD).
#. German: "\"GRÜßE, FREMDE!\""
#: AllTexts/NPC_texts.amb/069/003.txt
msgctxt "AllTexts/NPC_texts.amb/069/003"
msgid "\"GREETINGS, STRANGERS!\""
msgstr ""

#. Dialogue of NPC 069 (BELLARD).
#. German: "\"WIR HABEN DIE KELLERGESCHOSSE DIESES TURMS IM URSPRÜNGLICHEN ZUSTAND BELASSEN, INKLUSIVE SEINER BEWOHNER. SIE DIENEN FORTGESCHRITTENEN ADEPTEN ALS PRÜFUNGSRÄUME FÜR KAMPFZAUBER. HOFFENTLICH HABT IHR KEINE ALLZU GROßEN VERWÜSTUNGEN ANGERICHTET!\""
#: AllTexts/NPC_texts.amb/069/004.txt
msgctxt "AllTexts/NPC_texts.amb/069/004"
msgid "\"WE LEFT THE CELLARS IN THIS TOWER IN THEIR ORIGINAL CONDITION, INCLUDING THEIR INHABITANTS. THEY ARE USED BY ADVANCED AND ADEPT PEOPLE AS TRAINING ROOMS FOR PRACTISING MAGIC FOR COMBAT AND BATTLE. HOPEFULLY YOU HAVE NOT DONE TOO MUCH DAMAGE!\""
msgstr ""

#. Dialogue of NPC 069 (BELLARD).
#. German: "\"HALTET EUCH IN ZUKUNFT VON DEN ÜBUNGSHALLEN FERN!\""
#: AllTexts/NPC_texts.amb/069/005.txt
msgctxt "AllTexts/NPC_texts.amb/069/005"
msgid "\"IN FUTURE KEEP AWAY FROM THE TRAINING ROOMS!\""
msgstr ""

#. Dialogue of NPC 069 (BELLARD).
#. German: "\"RINAKLES IST DER EHRWÜRDIGE BEGRÜNDER UND DAS OBERHAUPT DIESER SCHULE. ER IST ENTSCHEIDEND AN DER REHABILITATION DER MAGIE BETEILIGT. IHR FINDET IHN IM OBERSTEN STOCKWERK DES TURMS.\""
#: AllTexts/NPC_texts.amb/069/006.txt
msgctxt "AllTexts/NPC_texts.amb/069/006"
msgid "\"RINAKLES IS THE HONOURABLE FOUNDER AND THE HEAD OF THIS SCHOOL. HE PLAYS A MAJOR PART IN THE REHABILITATION OF MAGICIANS. YOU WILL FIND HIM ON THE FIRST FLOOR IN THE TOWER.\""
msgstr ""

#. Dialogue of NPC 069 (BELLARD).
#. German: "\"ER IST SICHER AN EINEM GESPRÄCH MIT EUCH INTERESSIERT.\""
#: AllTexts/NPC_texts.amb/069/007.txt
msgctxt "AllTexts/NPC_texts.amb/069/007"
msgid "\"HE WOULD CERTAINLY BE INTERESTED IN TALKING TO YOU.\""
msgstr ""

#. Dialogue of NPC 069 (BELLARD).
#. German: "\"EINE EDLE UND ERSTREBENSWERTE KUNST.\""
#: AllTexts/NPC_texts.amb/069/008.txt
msgctxt "AllTexts/NPC_texts.amb/069/008"
msgid "\"A NOBLE AND VALUABLE ART.\""
msgstr ""

#. Dialogue of NPC 069 (BELLARD).
#. German: "EUER GEGENÜBER SPRICHT EINE FREMDE SPRACHE. EINIGE WORTE KOMMEN EUCH VAGE BEKANNT VOR, ABER IHR KÖNNT KEINEN SINN HERSTELLEN."
#: AllTexts/NPC_texts.amb/069/009.txt
msgctxt "AllTexts/NPC_texts.amb/069/009"
msgid "THE PERSON FACING YOU SPEAKS IN A STRANGE TONGUE. SOME OF THE WORDS APPEAR VAGUELY FAMILIAR BUT YOU CANNOT MAKE ANY SENSE OF WHAT IS SAID."
msgstr ""

#. Dialogue of NPC 070 (RINAKLES).
#. German: "EIN ÜBERRASCHEND JUNGER MANN MIT KRAUSEN HAAREN UND EINEM SPITZBART."
#: AllTexts/NPC_texts.amb/070/000.txt
msgctxt "AllTexts/NPC_texts.amb/070/000"
msgid "A SURPRISINGLY YOUNG MAN WITH CURLY HAIR AND A TRIM BEARD."
msgstr ""

#. Dialogue of NPC 070 (RINAKLES).
#. German: "~INK 30~ VOR EUCH STEHT EIN FÜR SEIN AMT VERBLÜFFEND JUNGER MANN. ER TRÄGT EINEN SPITZBART UND SEINE KLAREN AUGEN SCHAUEN EUCH OFFEN AN ALS ER SAGT:^ ~INK 31~ \"ICH GRÜßE EUCH, WILLKOMMEN IN DER SCHULE GADLON! WAS FÜHRT EUCH ZU MIR, FREMDE BESUCHER?\"^ ~INK 30~ ABERMALS SCHILDERT IHR EURE GESCHICHTE, UND RINAKLES AUSDRUCK WIRD IMMER ÜBERRASCHTER.^ ~INK 31~ \"ICH GEBE ZU, ICH EXPERIMENTIERE ZUR ZEIT MIT TRANSPORTZAUBERN UND DER MANIPULATION DER ANTIKEN TELEPORTER. ICH HÄTTE JEDOCH SCHWÖREN KÖNNEN, DASS DER KELLERTELEPORTER DEAKTIVIERT GEWESEN IST. UNGLAUBLICH!^ BITTE ERZÄHLT MIR VON EURER HEIMAT!\"^ ~INK 30~ IN EINEM LANGEN GESPRÄCH SCHILDERT IHR LYRAMION UND SEINE MONDE, SOWIE EURE ABENTEUER DORT. RINAKLES WISSENSDURST IST KAUM ZU STILLEN, UND IHR SEHT IHN SICH EIFRIG NOTIZEN MACHEN."
#: AllTexts/NPC_texts.amb/070/001.txt
msgctxt "AllTexts/NPC_texts.amb/070/001"
msgid "~INK 30~ BEFORE YOU STANDS A MAN WHO IS ASTONISHINGLY YOUNG FOR THE OFFICE HE HOLDS. HE WEARS A WELL-TRIMMED BEARD AND HIS CLEAR EYES LOOK AT YOU OPENLY AS HE SAYS:^ ~INK 31~ \"GREETINGS, WELCOME TO THE SCHOOL OF GADLON! WHAT BRINGS YOU HERE, STRANGE VISITORS?\"^ ~INK 30~ AGAIN YOU TELL YOUR STORY AND RINAKLES' EXPRESSION SHOWS MORE AND MORE SURPRISE.^ ~INK 31~ \"I ADMIT THAT I OCCASIONALLY EXPERIMENT WITH TRANSPORTATION MAGIC AND MANIPULATION OF THE ANTIQUATED TELEPORTER. BUT I COULD HAVE SWORN THAT THE CELLAR TELEPORTER WAS DE-ACTIVATED. INCREDIBLE!^ PLEASE TELL ME ABOUT YOUR HOME!\"^ ~INK 30~ IN A LONG STORY YOU DESCRIBE LYRAMION AND ITS MOONS AS WELL AS YOUR ADVENTURES THERE. RINAKLES' THIRST FOR KNOWLEDGE CAN HARDLY BE QUENCHED AND YOU SEE HIM HURRIEDLY MAKING NOTES."
msgstr ""

#. Dialogue of NPC 070 (RINAKLES).
#. German: "\"LEBT WOHL UND MÖGT IHR SICHER IN EURER FERNEN HEIMAT ANLANGEN!\""
#: AllTexts/NPC_texts.amb/070/002.txt
msgctxt "AllTexts/NPC_texts.amb/070/002"
msgid "\"FAREWELL AND MAY YOU RETURN SAFELY TO YOUR FARAWAY HOMELAND!\""
msgstr ""

#. Dialogue of NPC 070 (RINAKLES).
#. German: "\"SEID GEGRÜßT! WIE KANN ICH EUCH HELFEN?\""
#: AllTexts/NPC_texts.amb/070/003.txt
msgctxt "AllTexts/NPC_texts.amb/070/003"
msgid "\"WELCOME! HOW CAN I HELP YOU?\""
msgstr ""

#. Dialogue of NPC 070 (RINAKLES).
#. German: "~INK 30~ HÖFLICH WEIST IHR RINAKLES DARAUF HIN, DASS IN EUERER HEIMAT EINE DRINGENDE AUFGABE AUF EUCH WARTET UND DASS IHR DESHALB SO SCHNELL WIE MÖGLICH WIEDER DORTHIN ZURÜCKKEHREN MÖCHTET. RINAKLES MACHT EIN NACHDENKLICHES GESICHT, WIRFT EINEN BLICK AUF DEN TELEPORTER AN DER WESTWAND UND ERWIDERT:^ ~INK 31~ \"ICH KÖNNTE NATÜRLICH VERSUCHEN, DIESEN TELEPORTER ZU MODIFIZIEREN. LASST MICH SEHEN...\"^ ~INK 30~ ER NIMMT SEINE AUFZEICHNUNGEN ZUR HAND, STELLT EINIGE BERECHNUNGEN AN UND FÜHRT EINE KOMPLIZIERTE GESTENFOLGE AUS, DIE DEN TELEPORTER KURZ IN EINEM BLÄULICHEN LICHT ERGLÜHEN LÄSST.^ ~INK 31~ \"ICH MUSS EUCH JEDOCH WARNEN, DIE REISE KÖNNTE GEFÄHRLICH WERDEN! ICH HABE NOCH NICHT ALLE WISSENSBEREICHE DER TRANSPORTZAUBER VOLLSTÄNDIG GEMEISTERT. WENN IHR JEDOCH DAS RISIKO IN KAUF NEHMEN WOLLT...?\"^ ~INK 30~ ER WEIST AUF DEN TELEPORTER."
#: AllTexts/NPC_texts.amb/070/004.txt
msgctxt "AllTexts/NPC_texts.amb/070/004"
msgid "~INK 30~ YOU POLITELY POINT OUT TO RINAKLES THAT AN URGENT TASK AWAITS YOU AT HOME AND THAT YOU WOULD THEREFORE LIKE TO RETURN THERE AS QUICKLY AS POSSIBLE. RINAKLES FACE APPEARS THOUGHTFUL, HE GLANCES AT THE TELEPORTER STANDING AGAINST THE WEST WALL AND REPLIES:^ ~INK 31~ \"I COULD NATURALLY TRY TO MODIFY THIS TELEPORTER. LET ME SEE ...\"^ ~INK 30~ HE TAKES OUT HIS DRAWINGS, DOES SOME CALCULATIONS AND MAKES A COMPLEX SEQUENCE OF GESTURES WHICH SHORTLY AFTERWARDS MAKE THE TELEPORTER GLOW IN A BLUISH LIGHT.^ ~INK 31~ \"BUT I MUST WARN YOU, THE JOURNEY COULD BE HAZARDOUS! I HAVE NOT YET FULLY MASTERED ALL AREAS OF KNOWLEDGE INVOLVED IN TRANSPORTATION MAGIC. BUT IF YOU WANT TO TAKE THE RISK ...?\"^ ~INK 30~ HE POINTS TOWARDS THE TELEPORTER."
msgstr ""

#. Dialogue of NPC 070 (RINAKLES).
#. German: "\"NUN, FREUNDE, DER TELEPORTER IST BEREIT.\""
#: AllTexts/NPC_texts.amb/070/005.txt
msgctxt "AllTexts/NPC_texts.amb/070/005"
msgid "\"NOW, FRIENDS, THE TELEPORTER IS READY.\""
msgstr ""

#. Dialogue of NPC 070 (RINAKLES).
#. German: "\"WISST IHR, NOCH VOR KURZER ZEIT WAREN DIE LEHRE UND AUSÜBUNG VON MAGIE AUF UNSERER WELT GEÄCHTET. AUFGRUND EINER QUESTE, AN DER ICH NICHT GANZ UNBETEILIGT WAR, HAT SICH DIES GEÄNDERT. WIR HABEN MANNIGFALTIGE ABENTEUER UND FÄHRNISSE ÜBERLEBT UND AM ENDE DIE VERSCHOLLENE RASSE DER DRACHEN WIEDERENTDECKT. MIT IHRER HILFE WÄCHST DAS MAGISCHE WISSEN NUN WIEDER AN.\"^ ~INK 30~ RINAKLES AUSDRUCK WIRKT VORÜBERGEHEND VERTRÄUMT.^ ~INK 31~ \"ICH GLAUBE, ICH WERDE EINES TAGES UNSERE ERLEBNISSE NIEDERSCHREIBEN UND DAS BUCH 'DRAGONFLIGHT' NENNEN...\"^ ~INK 30~ ER GIBT SICH EINEN RUCK.^ ~INK 31~ \"WIE DEM AUCH SEI, ES IST MEIN ZIEL, HIER IN DIESEM ALTERTÜMLICHEN TURM EIN NEUES ZENTRUM DES WISSENS UND DES FORSCHENS ENTSTEHEN ZU LASSEN.\""
#: AllTexts/NPC_texts.amb/070/006.txt
msgctxt "AllTexts/NPC_texts.amb/070/006"
msgid "\"DO YOU KNOW, JUST A SHORT TIME AGO THE TEACHING AND PRACTISING OF MAGIC WAS HATED IN OUR WORLD. THIS CHANGED BECAUSE OF A QUEST IN WHICH I WAS NOT ENTIRELY UNINVOLVED. WE SURVIVED MANY DIFFERENT ADVENTURES AND DANGERS AND AT THE END RE-DISCOVERED THE EXTINCT RACE OF DRAGONS. WITH YOUR HELP OUR KNOWLEDGE OF MAGIC IS NOW EXPANDING AGAIN.\"^ ~INK 30~ RINAKLES' EXPRESSION TURNS DREAMY FOR A MOMENT.^ ~INK 31~ \"I BELIEVE THAT ONE DAY I WILL RECORD OUR EXPERIENCES. i SHALL NAME THE BOOK 'DRAGON FLIGHT'...\"^ ~INK 30~ HE SUDDENLY JERKS.^ ~INK 31~ \"HOWEVER THAT MAY BE, MY AIM IS TO CREATE A NEW CENTRE OF KNOWLEDGE AND RESEARCH IN THIS OLD TOWER.\""
msgstr ""

#. Dialogue of NPC 070 (RINAKLES).
#. German: "\"WIE GESAGT, ICH HOFFE, HIER EINE HOHE SCHULE DER MAGIE ENTSTEHEN ZU SEHEN.\""
#: AllTexts/NPC_texts.amb/070/007.txt
msgctxt "AllTexts/NPC_texts.amb/070/007"
msgid "\"AS WE SAID, I HOPE TO BE ABLE TO CREATE A HIGH SCHOOL OF MAGIC HERE.\""
msgstr ""

#. Dialogue of NPC 070 (RINAKLES).
#. German: "\"ES SIND GROßARTIGE WESEN! DIE DRACHEN SIND DAS ÄLTESTE VOLK UNSERER WELT, UND IHR WISSEN ÜBER DIE MAGIE IST VON GROßER TIEFE. NUN, DA SIE AUS IHREM EXIL ZURÜCKGEKEHRT SIND, GEHÖREN SIE ZU MEINEN REGELMÄßIGEN BESUCHERN.\""
#: AllTexts/NPC_texts.amb/070/008.txt
msgctxt "AllTexts/NPC_texts.amb/070/008"
msgid "\"THEY ARE TREMENDOUS BEINGS! THE DRAGONS ARE THE OLDEST RACE ON OUR WORLD AND THEIR KNOWLEDGE OF MAGIC IS VERY EXTENSIVE. NOW THAT THEY HAVE RETURNED FROM EXILE THEY ARE SOME OF MY REGULAR VISITORS.\""
msgstr ""

#. Dialogue of NPC 070 (RINAKLES).
#. Placeholders: ~SELF~ = the hero (the player character). The gender of these persons is unknown.
#. German: "~INK 30~ IHR SEHT RINAKLES VOLLKOMMEN VERBLÜFFT.^ ~INK 31~ \"IHR KENNT DIE NAMEN MEINER GEFÄHRTEN? IHR SEID IN DER TAT SEHR GEHEIMNISVOLLE REISENDE.\"^ ~INK 30~ ER WIRFT EINEN SELTSAMEN BLICK AUF ~SELF~.^ ~INK 31~ \"ICH BIN DIR SICHER NOCH NIE BEGEGNET, ~SELF~, UND HABE DOCH DAS GEFÜHL, DICH ZU KENNEN...\"^ ~INK 30~ SCHLIEßLICH SCHÜTTELT RINAKLES SEIN DEJA-VU-GEFÜHL AB UND FÄHRT FORT:"
#: AllTexts/NPC_texts.amb/070/009.txt
msgctxt "AllTexts/NPC_texts.amb/070/009"
msgid "~INK 30~ YOU SEE RINAKLES IS COMPLETELY SPEECHLESS.^ ~INK 31~ \"YOU KNOW THE NAMES OF MY PARTNERS? YOU ARE TRULY VERY SECRETIVE TRAVELLERS.\"^ ~INK 30~ HE LOOKS STRANGELY AT ~SELF~.^ ~INK 31~ \"I HAVE CERTAINLY NEVER MET YOU, ~SELF~, AND YET I FEEL AS IF I KNOW YOU ...\"^ ~INK 30~ FINALLY RINAKLES SHAKES OFF HIS FEELING OF DEJA-VU AND CONTINUES:"
msgstr ""

#. Dialogue of NPC 070 (RINAKLES).
#. German: "\"BLADUS IST AUF DEN SCHWINGEN EINES DRACHEN ZU SEINER HEIMATSTADT PORT PYLON ZURÜCKGEKEHRT. ICH BEWUNDERE SEINE AUSDAUER, DENN NACH UNSERER FEIER MIT VERTRETERN ALLER VÖLKER IN PEGANA HAT ER DORT WEITERE DREI TAGE IM MITTELPUNKT EINES FESTES GESTANDEN. MITTLERWEILE HAT IHN JEDOCH DIE UNRUHE WIEDER ERFASST. VOR GUT EINER WOCHE HAT ER MIR AUF DER DURCHREISE EINEN BESUCH ABGESTATTET. ER IST SCHON WIEDER AUF DER SUCHE NACH NEUEN ABENTEUERN. ALS OB WIR NICHT GENUG AUFREGUNG GEHABT HÄTTEN!\""
#: AllTexts/NPC_texts.amb/070/010.txt
msgctxt "AllTexts/NPC_texts.amb/070/010"
msgid "\"BLADUS RETURNED ON THE WINGS OF A DRAGON TO HIS HOME TOWN, PORT PYLON. I AM AMAZED AT HIS PERSISTENCE, FOR AFTER OUR CELEBRATION WITH REPRESENTATIVES OF ALL THE PEOPLES IN PEGANA HE SPENT THREE MORE DAYS AS THE CENTREPOINT OF A PARTY. BUT SINCE THEN HE HAS BECOME RESTLESS AGAIN. HE VISITED ME MORE THAN A WEEK AGO WHEN HE WAS PASSING THROUGH. HE IS LOOKING FOR MORE ADVENTURES AGAIN. AS IF WE DO NOT HAVE ENOUGH EXCITEMENT ALREADY!\""
msgstr ""

#. Dialogue of NPC 070 (RINAKLES).
#. German: "~INK 30~ RINAKLES LÄCHELT UND SEUFZT.^ ~INK 31~ \"UNSERE LIEBLICHE ELFENMAID! SIE IST ZUR DRACHENINSEL ZURÜCKGEKEHRT, DENN SIE FUNGIERT ALS EINE ART BOTSCHAFTERIN ZWISCHEN DEN DRACHEN UND IHREM VOLK. AUSSERDEM VERSUCHT SIE, IN DEN WÄLDERN DER INSEL DAS EINHORN WIEDERZUFINDEN, DAS WIR VON SEINEM FLUCH BEFREITEN.\""
#: AllTexts/NPC_texts.amb/070/011.txt
msgctxt "AllTexts/NPC_texts.amb/070/011"
msgid "~INK 30~ RINAKLES SMILES AND SIGHS.^ ~INK 31~ \"OUR DEAR ELF MAID! SHE RETURNED TO THE ISLAND OF THE DRAGONS, FOR SHE ACTS AS A KIND OF AMBASSADOR BETWEEN THE DRAGONS AND YOUR PEOPLE. ALSO, SHE IS TRYING TO FIND THE UNICORN IN THE FORESTS ON THE ISLAND WHICH WE RELEASED FROM HIS SPELL.\""
msgstr ""

#. Dialogue of NPC 070 (RINAKLES).
#. German: "\"DOBRANUR WEILT ZUR ZEIT NOCH BEI SEINEM GROßONKEL DAMBRANO IN PEGANA. ER LÄSST SICH ZEIT, UM SICH VON DEN FEIERN ZU ERHOLEN. ICH PERSÖNLICH GLAUBE, DASS MEIN ALTER FREUND NICHT SO RECHT WEISS, WELCHE RICHTUNG ER IN SEINEM LEBEN NUN EINSCHLAGEN SOLL. ZUR ZEIT VERSUCHT ER SICH BEI DAMBRANO AN WEITERFÜHRENDEN STUDIEN DER MAGIE. ICH HOFFE, DASS IHM DIES ERFÜLLUNG GIBT.\""
#: AllTexts/NPC_texts.amb/070/012.txt
msgctxt "AllTexts/NPC_texts.amb/070/012"
msgid "\"DOBRANUR IS STAYING WITH HIS GREAT-UNCLE, DAMBRANO, IN PEGANA AT THE MOMENT. HE IS TAKING TIME TO RECOVER FROM THE FESTIVITIES. I PERSONALLY BELIEVE MY OLD FRIEND DOES NOT IN FACT KNOW WHAT DIRECTION HE SHOULD TAKE IN HIS LIFE. AT THE MOMENT HE IS TRYING TO CONTINUE STUDYING MAGIC AT DAMBRANO. I HOPE HE FINDS IT SATISFYING.\""
msgstr ""

#. Dialogue of NPC 070 (RINAKLES).
#. German: "\"IHN HÄTTE VOR AUFREGUNG FAST DER SCHLAG GETROFFEN, ALS WIR MIT DEN DRACHEN NACH PEGANA ZURÜCKKEHRTEN! ER WAR GAR NICHT MEHR ZU BERUHIGEN UND MUSSTE NACH EINIGEN TAGEN MIT UNS UND DEN DRACHEN FÖRMLICH MIT GEWALT ZU EINER RUHEPAUSE GEZWUNGEN WERDEN! NUN BAUT AUCH DAMBRANO SEINE MAGISCHE FAKULTÄT WEITER AUS. IN DER TAT GIBT ES NUR EINEN GRUND, WARUM WIR DIES NICHT ZUSAMMEN TUN: HIER DRAUßEN IST ES MÖGLICH, UNGESTÖRT AUCH GRÖßERE EXPERIMENTE DURCHZUFÜHREN. VIELE BÜRGER PEGANA'S HABEN DOCH NOCH SCHEU VOR DER ÖFFENTLICHEN ANWENDUNG DER MAGIE.\""
#: AllTexts/NPC_texts.amb/070/013.txt
msgctxt "AllTexts/NPC_texts.amb/070/013"
msgid "\"HE ALMOST DIED OF EXCITEMENT WHEN WE RETURNED TO PEGANA WITH THE DRAGON! HE WOULD NOT CALM DOWN AND AFTER A FEW DAYS WITH THE DRAGON AND US HE HAD TO BE FORCED TO REST FOR A LITTLE WHILE! NOW ALSO DAMBRANO IS EXTENDING HIS MAGIC FACULTY. IN TRUTH THERE IS ONLY ONE REASON WHY WE DO NOT DO THIS TOGETHER: HERE ON THE OUTSIDE IT IS POSSIBLE FOR US TO CARRY OUT EVEN LARGER EXPERIMENTS WITHOUT INTERFERENCE. MANY OF THE PEOPLE OF PEGANA, HOWEVER, ARE AFRAID OF MAGIC BEING USED IN PUBLIC.\""
msgstr ""

#. Dialogue of NPC 070 (RINAKLES).
#. German: "\"VON DEM ALTEN PIRATENKÖNIG HABE ICH SCHON LANGE NICHTS MEHR GEHÖRT. ICH DENKE, ER HAT DAS LEBEN GENOSSEN, SEIT WIR IHN VON SEINEM QUÄLGEIST BEFREIT HABEN.\""
#: AllTexts/NPC_texts.amb/070/014.txt
msgctxt "AllTexts/NPC_texts.amb/070/014"
msgid "\"I'VE NOT HEARD ANY MORE FROM THE OLD KING OF PIRATES FOR A LONG TIME. I THINK HE MUST HAVE BEEN ENJOYING LIFE SINCE WE FREED HIM FROM HIS SUFFERING.\""
msgstr ""

#. Dialogue of NPC 070 (RINAKLES).
#. German: "\"OH, NETALDUR IST VOR EINIGER ZEIT AUF DER DRACHENINSEL AUFGETAUCHT UND DORT GEBLIEBEN. ER HAT ALTE FREUNDE UNTER DEN DRACHEN, UND ICH GLAUBE, ER HAT AUF DER INSEL EINE NEUE HEIMAT GEFUNDEN.\""
#: AllTexts/NPC_texts.amb/070/015.txt
msgctxt "AllTexts/NPC_texts.amb/070/015"
msgid "\"OH, NETALDUR APPEARED SOME TIME AGO ON THE ISLAND OF DRAGONS AND STAYED THERE. HE HAS SOME OLD FRIENDS AMONGST THE DRAGONS AND I BELIEVE HE HAS FOUND A NEW HOME ON THAT ISLAND.\""
msgstr ""

#. Dialogue of NPC 070 (RINAKLES).
#. German: "EUER GEGENÜBER SPRICHT EINE FREMDE SPRACHE. EINIGE WORTE KOMMEN EUCH VAGE BEKANNT VOR, ABER IHR KÖNNT KEINEN SINN AUSMACHEN."
#: AllTexts/NPC_texts.amb/070/016.txt
msgctxt "AllTexts/NPC_texts.amb/070/016"
msgid "THE PERSON OPPOSITE YOU SPEAKS A STRANGE LANGUAGE. SOME WORDS SEEM VAGUELY FAMILIAR BUT YOU CANNOT MAKE ANY SENSE OF WHAT IS BEING SAID."
msgstr ""

#. Text of a readable item (book, letter, scroll).
#. German: "SIE DÜRFEN VON NUN AN DIE RUNENTAFEL AUS DER PACKUNG BENUTZEN!"
#: AllTexts/Object_texts.amb/001/000.txt
msgctxt "AllTexts/Object_texts.amb/001/000"
msgid "FROM NOW ON YOU MAY USE THE TABLE OF RUNES INCLUDED IN THE PACKAGE!"
msgstr ""

#. Text of a readable item (book, letter, scroll).
#. German: "SIE DÜRFEN JETZT DIE LANDKARTE VON LYRAMION, DIE IN DER PACKUNG LIEGT, BENUTZEN!"
#: AllTexts/Object_texts.amb/001/001.txt
msgctxt "AllTexts/Object_texts.amb/001/001"
msgid "YOU MAY NOW USE THE MAP OF LYRAMION PROVIDED IN THE PACKAGE!"
msgstr ""

#. Text of a readable item (book, letter, scroll).
#. Placeholders: ~SELF~ = the hero (the player character). The gender of these persons is unknown.
#. German: "$T$E$S$T$A$M$E$N$T^^ HIERMIT VERMACHE ICH MEINEM ENKELKIND ~SELF~ ALLES, WAS ICH BESITZE:^ DAS HAUS MIT JEGLICHEM INVENTAR UND DAS LAND, AUF DEM ES GEBAUT IST. MEIN VERMÖGEN IST NICHT MEHR GROß, ABER ICH HOFFE, ES WIRD MEINEM ENKELKIND EINEN GUTEN BEGINN SEINER GEFAHRVOLLEN QUESTE ERMÖGLICHEN.^ P.S.^ MEIN LIEBES ENKELKIND!^ ICH MÖCHTE DIR NOCH EIN WEITERES GEHEIMNIS ANVERTRAUEN: HINTER DEM LINKEN KAMIN IM ESSZIMMER BEFINDET SICH EIN GEHEIMER RAUM.^ GLÜCK UND FRIEDEN AUF DEINEN WEGEN^ DEIN DICH LIEBENDER GROßVATER."
#: AllTexts/Object_texts.amb/001/002.txt
msgctxt "AllTexts/Object_texts.amb/001/002"
msgid "$L$A$S$T$$W$I$L$L$^^ I HEREBY LEAVE ALL MY WORLDLY GOODS AND EVERYTHING I POSSESS TO MY GRANDCHILD ~SELF~:^ THE HOUSE WITH EVERYTHING IT CONTAINS AND THE LAND ON WHICH IT IS BUILT. I AM NOT RICH BUT I HOPE IT WILL GIVE MY GRANDCHILD A GOOD START FOR HIS HAZARDOUS QUEST.^ P.S.^ MY DEAR GRANDCHILD!^ I WOULD LIKE TO LET YOU KNOW ANOTHER SECRET: IN THE DINING ROOM TO THE LEFT OF THE CHIMNEY THERE IS A SECRET ROOM.^ MAY LUCK AND PEACE BE WITH YOU ON YOUR TRAVELS.^ YOUR LOVING GRANDFATHER."
msgstr ""

#. Text of a readable item (book, letter, scroll).
#. German: "AUF DEN SCHMUTZIGEN ZETTEL SIND HASTIG EIN PAAR RUNEN GESCHRIEBEN WORDEN:^ ~RUN1~\"LINKS, RECHTS, MITTE, RECHTS\" ~NORM~"
#: AllTexts/Object_texts.amb/001/003.txt
msgctxt "AllTexts/Object_texts.amb/001/003"
msgid "A FEW RUNES HAVE BEEN SCRIBBLED HASTILY ON THE DIRTY NOTE:^ ~RUN1~\"LEFT, RIGHT, CENTRE, RIGHT\" ~NORM~"
msgstr ""

#. Text of a readable item (book, letter, scroll).
#. German: "AUF EIN PAAR SEITEN PERGAMENT HAT JEMAND IN WUNDERVOLLER HANDSCHRIFT FOLGENDES FESTGEHALTEN:^^ \"HEUTE IST EINE MEINER SCHLIMMSTEN BEFÜRCHTUNGEN WAHR GEWORDEN. IRGENDEINE URALTE DUNKLE MACHT HAT SICH AUS DEM ALTEN TURM DER SCHWARZMAGIER ERHOBEN, UM UNS ZU UNTERJOCHEN.^ HEUTE MORGEN TAUCHTE AM HIMMEL EIN RIESIGER ROTER DRACHE AUF. IM STURZFLUG KAM ER AUF BURNVILLE HERNIEDER UND STECKTE MIT SEINEM FEURIGEN ATEM ETLICHE DÄCHER IN BRAND. ALS DIE EINWOHNER AUS IHREN HÄUSERN GELAUFEN KAMEN, FING ER MIT DRÖHNENDER STIMME AN ZU SPRECHEN. ER SAGTE ETWA:^ 'HÖRET, IHR ARMSELIGEN WÜRMER! MEIN HERR, DER MEISTER DES FEUERS, HAT EUCH FÜR WÜRDIG BEFUNDEN, SEINE SKLAVEN ZU WERDEN. ER GIBT EUCH BIS MORGEN BEDENKZEIT. ICH WERDE DANN WIEDERKOMMEN UND EURE ANTWORT ENTGEGENNEHMEN.' DANN SCHLUG ER MIT SEINEN GEWALTIGEN FLÜGELN UND STIEG WIEDER EMPOR. DURCH DEN WINDSTOß WURDEN ETLICHE HÄUSER IHRES DACHES BERAUBT.^ WIR HABEN HEUTE ABEND BERATEN, UND ES WURDE BESCHLOSSEN, NICHT NACHZUGEBEN UND ZU KÄMPFEN.\"^^ \"UNSER WIDERSTANDSPLAN WAR EIN FEHLER. HEUTE FRÜH KAM DER DRACHE, WIE ANGEKÜNDIGT, ERNEUT. ALS WIR IHM DIE UNTERWERFUNG VERWEIGERTEN, BRÜLLTE ER LAUT AUF, UND PLÖTZLICH WAR DER HIMMEL VERDUNKELT VON DEN SCHWINGEN UNZÄHLIGER DRACHEN.^ IN WENIGER ALS EINER HALBEN STUNDE WAREN ALLE BEWOHNER AUßER MIR IN NETZEN GEFANGEN, VIELE HATTEN BRANDWUNDEN UND ANDERE VERLETZUNGEN. DIE DRACHEN FLOGEN MIT IHNEN FORT, ICH NEHME AN, ZUM TURM. DASS ICH IN MEINEM VERSTECK NICHT ENTDECKT WURDE, ERSCHEINT MIR IMMER NOCH UNFASSBAR. DOCH NUN BIN ICH RATLOS.\"^^ \"ICH HABE DIE LETZTE NACHT DAMIT VERBRACHT, NACHZUDENKEN, WAS ICH TUN KANN. AM MORGEN HABE ICH DANN BESCHLOSSEN, NACH SPANNENBERG ZU GEHEN UND MEINE MUTTER UM HILFE ZU BITTEN.\"^^ \"WELCHE SCHMACH! ICH HABE ES NOCH NICHT EINMAL GESCHAFFT, DEN TUNNEL ZU DURCHQUEREN. KURZ NACHDEM ICH IHN BETRETEN HATTE TRAT MIR EIN RIESE ENTGEGEN. ER LACHTE WIDERLICH UND SAGTE IN ETWA: 'LUMINOR, DER MEISTER DES FEUERS, HAT MICH BEAUFTRAGT, NIEMANDEN HIER DURCHZULASSEN. DOCH ER HAT NICHT GESAGT, DASS ICH DICH WIEDER ZIEHENLASSEN MUSS. DESHALB WIRST DU ALS MEIN ESSEN DIENEN.'^ ER HOB DIE ARME, UND RIESIGE FEUERBÄLLE FLOGEN AUF MICH ZU. NUR MIT MÜHE UND NOT BIN ICH DEM INFERNO ENTKOMMEN.\"^^ \"ICH HABE MICH WIEDER SOWEIT ERHOLT, WIE ES IN EINER NACHT GING. ICH WERDE MICH JETZT AUF DEN WEG ZUM TURM MACHEN. VIELLEICHT HABE ICH EIN CHANCE, DIE LEUTE VON BURNVILLE AUS DEN KLAUEN VON LUMINOR ZU BEFREIEN.^ MÖGE GALA MIR BEISTEHEN.^ SABINE^ OBERHEILERIN VON BURNVILLE\""
#: AllTexts/Object_texts.amb/001/004.txt
msgctxt "AllTexts/Object_texts.amb/001/004"
msgid "SOMEONE WROTE THE FOLLOWING IN BEAUTIFUL HANDWRITING ON A FEW PAGES OF PARCHMENT:^^ \"TODAY ONE OF MY GREATEST FEARS CAME TRUE. SOME ANCIENT DARK FORCE ROSE FROM THE OLD TOWER OF THE BLACK MAGICIANS TO OVERPOWER US.^ THIS MORNING A HUGE RED DRAGON APPEARED IN THE SKY. IT DIVED DOWN OVER BURNVILLE AND WITH ITS FIREY BREATH SET ALL THE ROOFS ALIGHT. AS THE INHABITANTS CAME RUNNING OUT OF THEIR HOUSES, IT ROARED, SAYING SOMETHING LIKE:^ \"LISTEN, YOU POOR LITTLE WORMS! MY MASTER, THE MASTER OF FIRE, HAS SEEN FIT TO MAKE YOU HIS SLAVES. HE GIVES YOU UNTIL TOMORROW TO CONSIDER. I SHALL RETURN THEN AND EXPECT YOUR ANSWER.\" THEN IT FLAPPED ITS MIGHTY WINGS AND ROSE HIGH UP IN THE SKY AGAIN. THE GALES IT CAUSED BLEW THE ROOFS OF SEVERAL OTHER HOUSES.^ WE HELD A MEETING THIS EVENING AND IT WAS DECIDED WE WILL NOT SURRENDER BUT WILL FIGHT.\"^^ \"OUR PLAN OF RESISTANCE WAS A MISTAKE. THE DRAGON RETURNED EARLY THIS MORNING, AS ANNOUNCED. WHEN WE REFUSED TO SURRENDER, IT ROARED LOUDLY AND SUDDENLY THE SKY DARKENED WITH THE WINGS OF THOUSANDS OF OTHER DRAGONS.^ IN LESS THAN HALF AN HOUR ALL THE INHABITANTS EXCEPT ME HAD BEEN CAUGHT IN NETS, MANY WERE BADLY BURNED AND HAD OTHER INJURIES AS WELL. THE DRAGONS FLEW OFF WITH THEM, PROBABLY TO THE TOWER. I STILL DO NOT UNDERSTAND HOW I WAS NOT DISCOVERED IN MY HIDING PLACE. BUT NOW I HAVE NO IDEA WHAT TO DO.\"^^ \"I SPENT LAST NIGHT THINKING ABOUT WHAT I CAN DO NOW. BY THE MORNING I DECIDED TO GO TO SPANNENBERG AND ASK MY MOTHER FOR HELP.\"^^ \"WHAT A PROBLEM! I DID NOT EVEN MANAGE TO GET THROUGH THE TUNNEL. SHORTLY AFTER I ENTERED IT A HUGE GIANT STEPPED FORWARD. HE LAUGHED REPULSIVELY AND SAID: 'LUMINOR, THE MASTER OF FIRE, HAS INSTRUCTED ME TO LET NO ONE THROUGH. BUT HE DID NOT SAY THAT I MUST LET YOU GO AGAIN. SO NOW YOU CAN SERVE AS MY DINNER.'^ HE RAISED HIS ARMS UP HIGH AND ENORMOUS BALLS OF FIRE HURTLED TOWARDS ME. I ONLY JUST ESCAPED THE INFERNO.\"^^ \"I RECOVERED AS WELL AS I COULD IN JUST ONE NIGHT. I WILL GO TO THE TOWER NOW. PERHAPS THERE IS CHANCE OF FREEING THE PEOPLE OF BURNVILLE FROM THE CLUTCHES OF LUMINOR.^ MAY GALA BE WITH ME.^ SABINE^ CHIEF HEALER OF BURNVILLE\""
msgstr ""

#. Text of a readable item (book, letter, scroll).
#. German: "DIES SCHEINT EIN SEHR ALTES BUCH ZU SEIN, DENN DIE SCHRIFT IST SO VERBLASST, DASS MAN SIE NICHT MEHR LESEN KANN. DIE EINZIGE PASSAGE, DIE SICH GERADE NOCH ENTZIFFERN LÄSST, IST DIESE:^^ \"DIE GEMEINE GROßE GIFTSPINNE ODER GIGANTEA ARACHNIA POISONIA ^ DIESE SPINNE HAT ZWEI NATÜRLICHE UND GEFÄHRLICHE EIGENSCHAFTEN:^ 1. IHR GIFT. DIESES WIRKT ZWAR NICHT SEHR SCHNELL, DOCH AUCH SEINE SCHLEICHENDE WIRKUNG IST LETZTEN ENDES TÖDLICH.^ 2. IHR NETZ. ES IST ZWAR NICHT KLEBRIG WIE DIE NETZE VIELER ANDERER SPINNEN, DAFÜR SIND SEINE FÄDEN SO GUT WIE GAR NICHT ZERSTÖRBAR. ES IST DURCHAUS MÖGLICH, DASS SO EIN NETZ EINEN ZUVOR PASSIERBAREN WEG UNDURCHDRINGLICH VERSPERRT. NUR MIT HILFE VON F.U.R (DIESES WORT KANN MAN KAUM NOCH LESEN) KANN ES VERNICHTET WERDEN. WOHL DEM, DER EINE .AC.E. (AUCH DIESES WORT IST FAST VÖLLIG VERSCHWUNDEN) ZUR HAND HAT. IN DER ZIVILISATION BEVORZUGT DIESE SPINNENART ALTE FEUCHTE KELLER ALS LEBENSRAUM.\""
#: AllTexts/Object_texts.amb/002/000.txt
msgctxt "AllTexts/Object_texts.amb/002/000"
msgid "THIS SEEMS TO BE A VERY OLD BOOK, FOR THE WORDS ARE SO FADED THAT YOU CAN HARDLY READ THEM. THE ONLY PASSAGE YOU CAN DECIPHER IS THE FOLLOWING:^^ \"THE COMMON GREATER POISON SPIDER OR GIGANTEA ARACHNIA POISONIA ^ THIS SPIDER HAS TWO NATURAL AND DANGEROUS CHARACTERISTICS:^ 1. ITS POISON. THIS DOES NOT TAKE EFFECT VERY QUICKLY BUT IS ALWAYS FATAL.^ 2. ITS WEB. IT IS NOT STICKY LIKE THE WEBS OF MANY OTHER SPIDERS BUT ITS THREADS ARE AS GOOD AS INDESTRUCTIBLE. IT IS EASILY POSSIBLE FOR SUCH A WEB TO MAKE ANY PASSAGEWAY TOTALLY INPENETRABLE. ONLY WITH THE AID OF F.R. (THIS WORD IS ALMOST ILLEGIBLE) CAN IT BE DESTROYED. PROBABLY BY SOMEONE WHO HAS A .OR.H (THIS WORD, TOO, HAS ALMOST TOTALLY DISAPPEARED). GENERALLY, THIS TYPE OF SPIDER LIKES TO LIVE IN OLD, DAMP CELLARS.\""
msgstr ""

#. Text of a readable item (book, letter, scroll).
#. German: "ES GESCHAH IN EINEM SCHRECKLICH HEIßEN SOMMER, DA FLOG EIN HALB VERDURSTETER PARADIESVOGEL ÜBERS LAND UND SUCHTE NACH WASSER. DOCH ER FAND KEINE NOCH SO KLEINE PFÜTZE, DENN DIE SONNE HATTE ALLE TEICHE UND SEEN VERTROCKNEN LASSEN. DOCH PLÖTZLICH ERSPÄHTE ER VOR EINEM BAUERNHAUS EINEN GROßEN BOTTICH, IN DEM KONNTE ER KÖSTLICHES WASSER BLITZEN SEHEN. ER LIEß SICH AUF DEM RAND DES BOTTICHS NIEDER, DOCH, OH GRAUS, SEIN SCHNABEL WAR NICHT LANG GENUG, UM DAS WASSER ZU ERREICHEN. NUN SAß ER DORT IN ALL SEINER PRACHT UND WÜRDE DOCH BALD VOR DURST STERBEN. SO NAH WAR DAS LEBEN UND DOCH ZU WEIT ENTFERNT!^ DA KAM EIN WARZENSCHWEIN UND SAGTE: \"ICH HABE AUS DER FERNE DEINE NOT MITANGESEHEN. ICH HELFE DIR, WENN DU MIR DEINE FEDERN GIBST, DAMIT AUCH ICH MICH MIT SCHÖNHEIT SCHMÜCKEN KANN.\" DER PARADIESVOGEL DACHTE KURZ NACH. DANN RISS ES SICH DIE FEDERN AUS UND GAB SIE DEM SCHWEIN. DIESES SAGTE: \"NIMM EIN PAAR STEINE UND WIRF SIE IN DEN EIMER, DANN WIRD DAS WASSER STEIGEN, UND DU WIRST TRINKEN KÖNNEN.\"^ GESAGT, GETAN. DER VOGEL PICKTE MIT LETZTER KRAFT VIELE STEINE AUF UND WARF SIE IN DEN BOTTICH. UND SIEHE DA, DAS WASSER STIEG UND ER KONNTE SEIN LEBEN RETTEN.^ UND DIE MORAL VON DER GESCHICHT? SCHÖNHEIT IST EINE ANGENEHME SACHE IM LEBEN, ABER MIT KLUGHEIT LEBT ES SICH LÄNGER!"
#: AllTexts/Object_texts.amb/002/001.txt
msgctxt "AllTexts/Object_texts.amb/002/001"
msgid "IT HAPPENED ONE DREADFULLY HOT SUMMER. A BIRD OF PARADISE, HALF DEAD FROM THIRST, WAS FLYING OVER THE LAND IN SEARCH OF SOMETHING TO DRINK. BUT IT DID NOT EVEN FIND A SMALL PUDDLE, FOR THE SUN HAD DRIED UP EVEN THE PONDS AND LAKES. SUDDENLY, IN FRONT OF A FARMHOUSE, IT SAW A LARGE WELL WITH SPARKLING WATER INSIDE IT. IT FLEW DOWN AND PERCHED ON THE EDGE OF THE WELL, REACHING DOWN TO DRINK THE WATER... OH DEAR, ITS BEAK WAS NOT LONG ENOUGH TO REACH THE WATER! SO IT SAT THERE IN ALL ITS BEAUTY AND WOULD SOON DIE OF THIRST. SO CLOSE TO LIFE AND YET SO FAR AWAY!^ THEN A WART HOG CAME BY AND SAID: \"I SAW YOUR DIFFICULTY FROM AFAR. I WILL HELP YOU IF YOU GIVE ME YOUR FEATHERS SO THAT I CAN DRESS MYSELF UP IN YOUR BEAUTY.\" THE BIRD OF PARADISE THOUGHT FOR A MOMENT. THEN IT TORE OUT ITS FEATHERS AND GAVE THEM TO THE HOG. THE HOG SAID: \"TAKE A FEW ROCKS AND DROP THEM INTO THE WELL. THIS WILL RAISE THE WATER LEVEL AND YOU WILL THEN BE ABLE TO DRINK.\"^ IN A FLASH, THE BIRD DID AS THE HOG SUGGESTED. WITH ONE LAST MIGHTY EFFORT IT PICKED UP LOTS OF ROCKS AND DROPPED THEM IN THE WATER WELL. AND, SURPRISE, SURPRISE, THE WATER LEVEL ROSE TO WITHIN HIS REACH. IT SAVED HIS LIFE.^ AND THE MESSAGE OF THIS STORY? BEAUTY IS NICE IN LIFE, BUT WITH INTELLIGENCE YOU LIVE LONGER!"
msgstr ""

#. Text of a readable item (book, letter, scroll).
#. German: "DIE SEITEN DES BUCHS SIND ZUM GRÖßTEN TEIL ZERSTÖRT, NUR DIE LETZTEN EINTRAGUNGEN KÖNNT IHR NOCH LESEN:^^ \"WIR HABEN HEUTE UNSERE ARBEIT AN DEN MASCHINEN IM UNTEREN TEIL DES TEMPELS DER BRUDERSCHAFT VOLLENDET. MICH STÖRT AN DER SACHE ZWAR IMMER NOCH, DASS WIR NICHT WISSEN, WOFÜR DIESE MASCHINEN NÜTZE SIND, ABER DAS IST JETZT BEDEUTUNGSLOS, DENN SCHLIEßLICH WIRD ALS LOHN FÜR UNSERE ARBEIT UNSER GRÖßTER TRAUM WAHR: WIR GELANGEN ZUM GRÜNEN JUWEL!^ MORGEN WERDEN ALLE ZWERGE VON GEMSTONE DAS SELTSAME SCHIFF DER BRUDERSCHAFT BESTEIGEN UND AUF EINE LANGE REISE GEHEN. DOCH OBWOHL ICH ÜBERGLÜCKLICH SEIN SOLLTE, BIN ICH ES NICHT. ZWEIFEL NAGEN AN MIR, OB WIR DAS RICHTIGE TUN. NUN, JETZT IST ES ZU SPÄT! DIE FREUDE DER ZWERGE, ZUM GRÜNEN JUWEL ZU KOMMEN, IST SO GROß, DASS ICH NICHTS MEHR TUN KÖNNTE, UM SIE AUFZUHALTEN.^ WAS MICH NACH WIE VOR STÖRT, IST, DASS DIE MITGLIEDER DER BRUDERSCHAFT IHRE KAPUZEN SO TIEF IM GESICHT TRAGEN, DASS MAN SIE NICHT ERKENNEN KANN. ICH KANN MICH NICHT ERINNERN, AUCH NUR EINEM VON IHNEN JE INS GESICHT GEBLICKT ZU HABEN.^^ SO, NUN VERLASSEN WIR GEMSTONE UND ÜBERLASSEN UNSERE STADT DER NATUR. MÖGE SIE MIT IHR TUN WAS IMMER SIE WILL.^^ KIRE, OBERHAUPT DER ZWERGE VON GEMSTONE\""
#: AllTexts/Object_texts.amb/002/002.txt
msgctxt "AllTexts/Object_texts.amb/002/002"
msgid "MOST PAGES OF THE BOOK HAVE BEEN DESTROYED, JUST THE LAST FEW ENTRIES ARE STILL LEGIBLE:^^ \"TODAY WE COMPLETED OUR WORK ON THE MACHINES IN THE LOWER PART OF THE TEMPLE OF THE BROTHERHOOD. THE THING WHICH STILL WORRIES ME ABOUT THIS IS THAT WE DO NOT KNOW WHAT THESE MACHINES CAN BE USED FOR. BUT THAT IS NOW IRRELEVANT, AS THE REWARD FOR OUR WORK WILL MAKE OUR GREATEST DREAM COME TRUE: WE WILL REACH THE GREEN JEWEL! TOMORROW ALL THE DWARFS OF GEMSTONE WILL CLIMB ON BOARD THE STRANGE SHIP OF THE BROTHERHOOD AND START THEIR LONG JOURNEY. BUT ALTHOUGH I SHOULD BE DELIGHTED, I AM NOT. I DOUBT WHETHER WE ARE DOING THE RIGHT THING. BUT NOW IT IS TOO LATE! THE JOY THE DWARFS ARE FEELING ABOUT GETTING TO THE GREEN JEWEL IS SO GREAT THAT I COULD DO NOTHING ELSE TO STOP THEM.^ THE THING WHICH STILL TROUBLES ME IS THAT THE MEMBERS OF THE BROTHERHOOD WEAR THEIR COWLS SO LOW OVER THEIR FACES THAT ONE CAN'T SEE THEIR FACES. I CANNOT REMEMBER EVER HAVING LOOKED ONE OF THEM IN THE FACE.^^ SO, NOW WE ARE LEAVING GEMSTONE AND MUST HAND OVER OUR TOWN TO THE FORCES OF NATURE. MAY NATURE DO WITH IT WHATEVER SHE WISHES.^^ KIRE, CHIEF OF THE DWARFS OF GEMSTONE.\""
msgstr ""

#. Text of a readable item (book, letter, scroll).
#. German: "~INK 29~ AUS DER SCHRIFTROLLE GEHT HERVOR, DASS ES SICH HIER UM DIE AUFZEICHNUNGEN EINES WALDLÄUFERS MIT NAMEN DREBLIN HANDELT:^^ ~INK 31~ \"HATTE MÜHE, DIE RUINEN WIEDERZUFINDEN. DIES IST WAHRLICH EINER DER GEFÄHRLICHSTEN TEILE DES WALDES. IM EINGANGSBEREICH IST ES MIR ERWARTUNGSGEMÄß NICHT GELUNGEN, WEITER ALS BIS ZU DEM MASSIVEN GRÜNEN METALLTOR VORZUSTOßEN. NUN IST ES AN DER ZEIT, DIE KLETTERAUSRÜSTUNG ZU ERPROBEN.\"^^ \"GESCHAFFT! DIE AUSRÜSTUNG ERMÖGLICHTE ES MIR, DIE AUßENWAND DES TURMS ZU ERKLIMMEN. KONNTE KURZEN BLICK AUF EINIGE SELTSAME WANDZEICHNUNGEN WERFEN, DANN ZWANG MICH EIN RUDEL GIZZEKS ZUM RÜCKZUG DURCH EINE BODENÖFFNUNG.\"^^ \"ES IST MIR GELUNGEN, MICH UNTER EINE METALLPLATTE DURCH EINE ZWEITE ÖFFNUNG ZU ZWÄNGEN. BIN NUN TIEF IN DIE ANTIKE ANLAGE EINGEDRUNGEN. KONNTE BISHER NICHTS WERTVOLLES FINDEN, EINIGE TORE VERSPERREN DEN WEG ZU UNERFORSCHTEN TEILEN DER RUINEN. AUCH HIER SIND VIELE WÄNDE MIT FREMDARTIGEN SYMBOLEN BEDECKT. HÖRE GERÄUSCHE. HOFFENTLICH FOLGEN MIR DIE GIZZEKS NICHT.\"^^ \"DIE SYMBOLE SCHEINEN MIR VON GRÖßTER WICHTIGKEIT ZU SEIN; MAN FINDET SIE AUCH NEBEN DEN TOREN. DIE KUGELN AUF DEN TOREN KÖNNEN EINGEDRÜCKT WERDEN, ES PASSIERT JEDOCH NICHTS.^ OFFENBAR HANDELT ES SICH BEI DEN SYMBOLEN UM EIN ZAHLENSYSTEM. DREIECKE KÖNNTEN ZAHLEN SYMBOLISIEREN. BEDEUTUNG DER RUNDEN SYMBOLE UNBEKANNT: VIELLEICHT MULTIPLIKATOREN? WERDEN NEBENEINANDERSTEHENDE SYMBOLE EINFACH ADDIERT? WAHRSCHEINLICH. ROTE DREIECKE KÖNNTEN ZAHL 1 SEIN; ORANGE MÜSSTE DEMN\"^^ ~INK 29~ HIER BRICHT DIE SCHRIFT MIT EINEM STRICH QUER ÜBER DAS PERGAMENT AB."
#: AllTexts/Object_texts.amb/003/000.txt
msgctxt "AllTexts/Object_texts.amb/003/000"
msgid "~INK 29~ THE SCROLLS SHOW THAT THESE ARE THE RECORDS OF A FOREST RUNNER BY THE NAME OF DREBLIN:^^ ~INK 31~ \"IT WAS AN EFFORT TO FIND THE RUINS AGAIN. THIS IS TRULY ONE OF THE MOST DANGEROUS PARTS OF THE FOREST. AS EXPECTED, AT THE ENTRANCE I WAS NOT ABLE TO GET ANY FURTHER THAN THE MASSIVE GREEN METAL GATE. SO NOW IT IS TIME TO TRY OUT THE CLIMBING EQUIPMENT.\"^^ \"DONE IT! THE EQUIPMENT ENABLED ME TO CLIMB THE OUTSIDE WALL OF THE TOWER. I WAS ABLE TO LOOK BRIEFLY AT SOME OF THE STRANGE WALL DRAWINGS BUT THEN A GROUP OF GIZZEKS FORCED ME TO WITHDRAW THROUGH AN OPENING IN THE GROUND.\"^^ \"I SUCCEEDED IN FORCING MYSELF THROUGH A SECOND OPENING UNDER A METAL PLATE. I HAVE NOW REACHED A DEEP PART OF THE OLD SYSTEM. I HAVE NOT FOUND ANYTHING VALUABLE YET, SOME DOORS BLOCK THE WAY TO OTHER PARTS OF THE RUINS. AND HERE, TOO, MANY OF THE WALLS ARE DECORATED WITH STRANGE SYMBOLS. I HEAR NOISES. HOPEFULLY THE GIZZEKS ARE NOT FOLLOWING ME.\"^^ \"THE SYMBOLS APPEAR TO BE VERY IMPORTANT; THEY ARE ALSO FOUND NEXT TO THE DOORS. THE SPHERES ON THE DOORS CAN BE DEPRESSED, BUT NOTHING HAPPENS.^ APPARENTLY THE SYMBOLS REPRESENT A SYSTEM OF NUMBERS. TRIANGLES COULD SYMBOLISE NUMBERS. THE ROUND SYMBOLS ARE UNKNOWN, PERHAPS THEY ARE MULTIPLIERS? ARE SYMBOLS NEXT TO EACH OTHER SIMPLY TO BE ADDED TOGETHER? PROBABLY. RED TRIANGLES COULD BE THE NUMBER 1. ORANGE WOULD THEN HAVE TO BE...\"^^ ~INK 29~ THIS IS WHERE THE LETTERS STOP AS IF A LINE HAD BEEN DRAWN STRAIGHT ACROSS THE PARCHMENT."
msgstr ""

#. Text of a readable item (book, letter, scroll).
#. German: "DIE SEITEN SIND MIT UNVERSTÄNDLICHEN SCHRIFTZEICHEN GEFÜLLT, DIE ZU KEINER DER BEKANNTEN SPRACHEN GEHÖREN."
#: AllTexts/Object_texts.amb/003/001.txt
msgctxt "AllTexts/Object_texts.amb/003/001"
msgid "THE PAGES ARE FULL OF INCOMPREHENSIBLE SYMBOLS AND CHARACTERS WHICH DO NOT BELONG TO ANY KNOWN LANGUAGE. ␀ "
msgstr ""

#. Text of a readable item (book, letter, scroll).
#. German: "ABHANDLUNG ÜBER DIE WINDTORE VON LYRAMION^ VON THONION DEM GELEHRTEN^^ 1.WAS SIND WINDTORE?^ DIE WINDTORE WURDEN VOR VIELEN HUNDERT JAHREN VON EINEM BEGNADETEN MAGIER UND ERFINDER ERDACHT. SIE DIENTEN - UND DIENEN AUCH HEUTE NOCH - DAZU, SCHNELL GROßE ENTFERNUNGEN AUF LYRAMION ZU ÜBERBRÜCKEN. HEUTE GIBT ES NOCH ZWÖLF, BEZIEHUNGSWEISE VIERUNDZWANZIG WINDTORE AUF LYRAMION. EIN TOR ALLEIN FUNKTIONIERT NICHT. JEDESMAL, WENN MAN EINS DER TORE BENUTZEN WILL, MUSS AM ZIELORT EIN AKTIVIERTES TOR SEIN.^^ 2.WAS BRAUCHT MAN UM SIE ZU BENUTZEN?^ DIE BEFÖRDERUNG DURCH DIE WINDTORE WIRD NUR EINGELEITET, WENN MAN EINE SOGENANNTE WINDKETTE IN GEBRAUCH HAT. HEUTZUTAGE GIBT ES NUR NOCH SEHR WENIGE VON DIESEN KETTEN. ALLERDINGS GIBT ES EINE MÖGLICHKEIT, NEUE KETTEN HERZUSTELLEN. AUF DER INSEL DER WINDE GIBT ES DEN WINDSCHREIN. IN DIESEM BEFINDEN SICH ZWEI ALTÄRE. WENN MAN AM RECHTEN ALTAR EINE PERLMUTTKETTE SOWIE ZWÖLF WINDPERLEN MITEINANDER IN VERBINDUNG BRINGT, ENTSTEHT EINE NEUE WINDKETTE.^^ 3.WAS TUN, WENN EIN TOR ZERSTÖRT WURDE?^ DER ERFINDER DER TORE HAT AUCH EINE MÖGLICHKEIT ENTWICKELT, ZERSTÖRTE TORE OHNE MÜHE WIEDER ZU ERRICHTEN. DAZU BRAUCHT MAN EINEN STAB AUS DEM SELTENEN XENOBIL-HOLZ UND EINE NORMALE GEMME. DEN STAB BENUTZT MAN AM LINKEN ALTAR IM WINDSCHREIN. ER VERSCHMILZT MIT DER GEMME UND IST DANACH EIN STAB DES AUFBAUS. WENN MAN DIESEN IN DIE NÄHE EINES DEFEKTEN TORES BRINGT, SO WIRD DIESES WIEDER AUFGERICHTET."
#: AllTexts/Object_texts.amb/004/000.txt
msgctxt "AllTexts/Object_texts.amb/004/000"
msgid "REPORT ON THE WIND GATES OF LYRAMION^ BY THONION THE SCHOLAR^^ 1. WHAT ARE WIND GATES?^ WIND GATES WERE CONCEIVED BY A GIFTED MAGICIAN AND INVENTOR MANY HUNDREDS OF YEARS AGO. THEY SERVED - AND STILL SERVE TODAY - TO QUICKLY BRIDGE GREAT DISTANCES ON LYRAMION. TODAY THERE ARE STILL TWELVE, OR MORE CORRECTLY, TWENTY FOUR WIND GATES ON LYRAMION. A GATE CANNOT OPERATE BY ITSELF. EACH TIME ONE WISHES TO USE ONE OF THE GATES, THERE MUST ALSO BE ANOTHER GATE ACTIVE AT THE INTENDED DESTINATION.^^ 2. WHAT DOES ONE NEED TO USE THEM?^ TRANSPORTATION THROUGH THE WIND GATES IS ONLY POSSIBLE IF YOU HAVE A SO-CALLED WIND CHAIN IN USE. TODAY THERE ARE VERY FEW OF THESE CHAINS LEFT. BUT IT IS POSSIBLE TO MANUFACTURE NEW CHAINS. ON THE ISLAND OF WINDS THERE IS THE WIND SHRINE. IT HAS TWO ALTARS. IF YOU JOIN TOGETHER A CHAIN OF MOTHER OF PEARL AS WELL AS TWELVE WIND PEARLS ON THE RIGHT ALTAR, THIS WILL CREATE A NEW WIND CHAIN.^^ 3. WHAT DOES ONE DO IF A GATE IS DESTROYED?^ THE INVENTOR OF THE GATES ALSO DEVELOPED THE ABILITY TO REPAIR DAMAGED GATES EASILY. TO DO SO YOU NEED A ROD MADE OF RARE XENOBIL WOOD AND A NORMAL GEM. THE ROD IS USED AT THE LEFT ALTAR IN THE WIND SHRINE. IT MELTS WITH THE GEM AND THEN BECOMES A ROD OF CONSTRUCTION. IF THIS IS MOVED CLOSE TO A DEFECTIVE GATE, IT IS REPAIRED AGAIN."
msgstr ""

#. Text of a readable item (book, letter, scroll).
#. German: "DAS PERGAMENT, AUF WELCHES DAS REZEPT GESCHRIEBEN WURDE, IST SEHR ALT.^^ DÄMONENSCHLAF^ EINE REZEPTUR VON MEISTER ZENDRO, SEINES ZEICHENS SCHWARZMAGIER^ ES GIBT EINE BESONDERE ART VON DÄMONEN, DIE SOGENANNTEN WÄCHTERDÄMONEN. KEIN STERBLICHES WESEN IST JE AN EINEM SOLCHEN WÄCHTER VORBEIGEKOMMEN. SIE GREIFEN NUR AN, WENN JEMAND AN DEN ORT WILL, DEN SIE BEWACHEN. SIE SIND SO MÄCHTIG, DASS SELBST DER GRÖßTE MAGIER AUF LYRAMION KEINE CHANCE GEGEN EINEN SOLCHEN DÄMON HAT.^ ALLERDINGS HABE ICH, ZENDRO, NUN EINEN WEG GEFUNDEN, SIE IN IHRE HÖLLE ZURÜCKZUSCHICKEN. DAZU MUSS MAN SIE EINSCHLÄFERN, DENN WENN SIE SCHLAFEN, VERLIEREN SIE IHREN HALT IN LYRAMION UND WERDEN ZURÜCK IN DIE HÖLLE GESCHLEUDERT. ZU MEINEM BEDAUERN MUSSTE ICH FESTSTELLEN, DASS NORMALE SCHLAFSPRÜCHE KEINE WIRKUNG ZEIGEN. DESHALB HABE ICH EIN MITTEL ENTWICKELT, WELCHES MAN IHNEN VERABREICHEN MUSS. MAN BENÖTIGT DAFÜR:^^ EIN BLATT VON DER FEUERDISTEL^ EIN STÜCK FEUERSTEIN^ EINE BLÜTE DER SUMPFLILIE^ EINEN ROTPILZ^ EINEN BLAUPILZ^ EIN KALMIR-KRAUT^^ UND EINE LEERE PHIOLE^ MAN BENUTZT DIESES REZEPT AN EINEM KESSEL EINER HEXE ODER HEXENMEISTERS, UND HÄLT BESTANDTEILE BEREIT. ALLERDINGS MUSS MAN DARAUF ACHTEN, DASS^^ HIER BRICHT DER TEXT AB."
#: AllTexts/Object_texts.amb/004/001.txt
msgctxt "AllTexts/Object_texts.amb/004/001"
msgid "THE PARCHMENT ON WHICH THE RECIPE IS WRITTEN IS VERY OLD.^^ DEMON SLEEP^ A RECIPE BY MASTER ZENDRO, BLACK MAGICIAN^ THERE IS A SPECIAL TYPE OF DEMON, THE SO-CALLED GUARDIAN DEMON. NO MORTAL BEING HAS EVER GOT PAST SUCH A GUARD. THEY ONLY ATTACK IF SOMEONE WANTS TO GET INTO THE PLACE THEY ARE PROTECTING. THEY ARE SO POWERFUL THAT EVEN THE GREATEST MAGICIAN ON LYRAMION HAS NO CHANCE AGAINST THEM.^ BUT I, ZENDRO, HAVE NOW FOUND A WAY TO SEND THEM BACK TO THEIR CAVES. TO DO THIS, YOU MUST PUT THEM TO SLEEP, FOR WHEN THEY ARE ASLEEP THEY LOSE THEIR HOLD ON LYRAMION AND ARE DRAGGED BACK INTO THEIR HELL. UNFORTUNATELY I FOUND THAT NORMAL SLEEP SPELLS HAVE NO EFFECT. FOR THIS REASON I DEVELOPED A POTION WHICH BE GIVEN TO THEM. FOR THIS POTION YOU NEED:^^ ONE LEAF FROM THE FIRE THISTLE^ ONE PIECE OF FLINT STONE^ ONE PETAL FROM THE SWAMP LILY^ ONE RED MUSHROOM^ ONE BLUE MUSHROOM^ ONE KALMIR HERB^^ AND AN EMPTY PHIAL^ THIS RECIPE IS TO BE BREWED IN THE CAULDRON OF A WITCH OR A WITCH MASTER AND YOU MUST ALWAYS HAVE THE RIGHT INGREDIENTS TO HAND. BUT YOU MUST ENSURE THAT...^^ THIS IS WHERE THE TEXT BREAKS OFF."
msgstr ""

#. Text of a readable item (book, letter, scroll).
#. German: "NUR DIE ERSTE SEITE DES DICKEN BUCHS IST BESCHRIEBEN:^ ~RUN1~\"ES WARD EINMAL...\"~NORM~"
#: AllTexts/Object_texts.amb/004/002.txt
msgctxt "AllTexts/Object_texts.amb/004/002"
msgid "ONLY THE FIRST PAGE OF THE THICK BOOK HAS ANY WRITING ON IT:^ ~RUN1~\"ONCE UPON A TIME ...\"~NORM~"
msgstr ""

#. Text of a readable item (book, letter, scroll).
#. German: "DER LETZTE PALADIN^ VOR DER GROßEN FLUT GAB ES DERER VIELE; NACH DER FLUT BLIEB NUR EINER AM LEBEN: SEIN NAME IST GRYBAN. SEIN LEBEN DEM LICHT GEWEIHT, LIEß ER SICH VON MÄCHTIGEN MAGIERN IN EINEN LANGEN SCHLAF SENKEN. NUN RUHT ER IN EINEM BETT AUS MARMOR AUF DER FESTE GODSBANE UND WARTET AUF DEN TAG, AN DEM ER WIEDER GEBRAUCHT WIRD, UM GEGEN DAS DUNKLE ZU KÄMPFEN."
#: AllTexts/Object_texts.amb/004/003.txt
msgctxt "AllTexts/Object_texts.amb/004/003"
msgid "THE LAST PALADIN^ BEFORE THE GREAT FLOOD THERE WERE MANY: AFTER THE FLOOD ONLY ONE IS STILL ALIVE: HIS NAME IS GRYBAN. HIS LIFE IS DEDICATED TO LIGHT AND HE WAS PUT TO ETERNAL SLEEP BY THE MIGHTY MAGICIANS. NOW HE RESTS ON A BED OF MARBLE AT THE FORTRESS OF GODSBANE AND AWAITS THE DAY WHEN HE IS NEEDED AGAIN TO FIGHT AGAINST THE DARKNESS."
msgstr ""

#. Text of a readable item (book, letter, scroll).
#. German: "ES GIBT VIELE WIRKSAME KRÄUTER AUF LYRAMION. MÖGEN HIER DIE DREI WICHTIGSTEN GENANNT SEIN:^ - DIE SUMPFLILIE: SIE WÄCHST NUR IN EINEM KLEINEN SUMPF NORDÖSTLICH DES ALCHEMISTENTURMS. BISHER HAT SIE SICH GEGEN JEDE BEKANNTE ART VON GIFT ALS HILFREICH ERWIESEN.^ - DAS KALMIRKRAUT: DIESES KRAUT WÄCHST AUF EINER INSEL IN DEM KÜNSTLICHEN SEE SÜDLICH VON LEBAB'S TURM. ES IST ALLGEMEINE ERFAHRUNG, DASS ES SICH GUT ZUM HEILEN VON KRANKHEITEN EIGNET.^ - DIE FEUERDISTEL: DIESE SELTENE FARNART WÄCHST NUR AUF EINER GRASHÜGELGRUPPE AM NÖRDLICHEN ENDE VON MERA'S INSEL. ES GILT ALS ERWIESEN, DASS SIE BLINDHEIT HEILEN KANN."
#: AllTexts/Object_texts.amb/004/004.txt
msgctxt "AllTexts/Object_texts.amb/004/004"
msgid "THERE ARE MANY EFFECTIVE HERBS ON LYRAMION. THESE ARE THE THREE MOST IMPORTANT ONES:^ - THE SWAMP LILY: THIS ONLY GROWS IN A SMALL SWAMP TO THE NORTH EAST OF THE TOWER OF THE ALCHEMISTS. IN THE PAST IT HAS PROVED HELPFUL AGAINST EVERY KNOWN TYPE OF POISON.^ - THE KALMIR HERB: THIS HERB GROWS ON AN ISLAND IN THE ARTIFICIAL LAKE TO THE SOUTH OF THE TOWER OF LEBAB. IT IS GENERALLY ACKNOWLEDGED THAT IT IS GOOD AT HEALING DISEASE.^ - THE FIRE THISTLE: THIS STRANGE PLANT ONLY GROWS ON A NUMBER OF GRASS-COVERED HILLS AT THE NORTHERN END OF MERA'S ISLAND. IT HAS BEEN KNOWN TO HEAL BLINDNESS."
msgstr ""

#. Text of a readable item (book, letter, scroll).
#. Placeholders: ~SELF~ = the hero (the player character). The gender of these persons is unknown.
#. German: "DIE MEISTEN DER EINTRAGUNGEN SIND IN EINER SELTSAMEN SCHRIFT AUFGEZEICHNET, DIE IHR NICHT LESEN KÖNNT. NUR DIE FOLGENDEN PASSAGEN SIND IN LYRAMIONISCH GESCHRIEBEN:^^ \"OH, MEISTER S'LORWIN, EUER PLAN MIT DEN ZWERGEN HAT HERVORRAGEND FUNKTIONIERT. SIE WAREN BEREIT, JAHRELANG FÜR IHRE TRÄUME ZU ARBEITEN. SIE HABEN DIE MASCHINE FERTIGGESTELLT, UND ICH HABE SIE MIT DEM FLIEGENDEN SCHIFF ZUM VERSEUCHTEN WALDMOND GEBRACHT.^ HA, DIESE KLEINEN NARREN, ZU GLAUBEN DER MOND SEI EIN EINZIGER GROßER EDELSTEIN! DEMENTSPRECHEND WAR IHRE VERWUNDERUNG, ALS ICH SIE DORT ABLUD. ICH HATTE KEINE SCHWIERIGKEIT, ZU FLÜCHTEN UND SIE DORT ZURÜCKZULASSEN. JETZT, DA KEINE ZWERGE MEHR AUF LYRAMION SIND, WIRD AUCH NIEMAND VON UNSEREN PLÄNEN ERFAHREN.\"^^ \"GEEHRTER MEISTER S'LORWIN, ICH HABE MIR, WIE BEFOHLEN, DIE GRABKAMMER DES ABGESTÜRZTEN MONDES ANSCHAUEN WOLLEN, ABER LEIDER HINDERTE MICH EINE TÜR AM EINDRINGEN IN DIE KAMMER. AUF DER TÜR IST DIE ABBILDUNG EINES ZWÖLFZACKIGEN STERNS. ICH VERMUTE, DASS MAN EINEN SOLCHEN STERN BRAUCHT, UM SIE ZU ÖFFNEN.^ ZU EURER VERMUTUNG, DASS ES EIN GOTTÄHNLICHES WESEN NAMENS TARBOS GIBT, KANN ICH NUR SAGEN, DASS ES BIS JETZT NICHT AUFGETAUCHT IST. DOCH DIE LEGENDEN UM TARBOS HABEN UNS SEHR GEHOLFEN, UNSEREN PLAN GEHEIMZUHALTEN, DENN NIEMAND AUF LYRAMION ZWEIFELTE DARAN, DASS OHNE UNSERE BRUDERSCHAFT DIESER TARBOS LÄNGST WIEDER AUF LYRAMION WÜTEN WÜRDE.\"^^ \"OH, MEISTER S'LORWIN, ICH HABE EINE GUTE NACHRICHT FÜR EUCH! DIE ARBEITEN SIND VOLLENDET, UND DIE MASCHINE HAT IHRE ARBEIT BEGONNEN. IN EIN PAAR MONATEN WIRD SIE UNSERE WELT WIEDER FRUCHTBAR MACHEN. ALLERDINGS WIRD LYRAMION VERÖDEN, ABER DAS SOLL NICHT UNSERE SORGE SEIN. WIR SIND DIE MÄCHTIGEREN, DAHER SIND WIR AUCH DIE WERTVOLLEREN!\"^^ \"MEISTER S'LORWIN, ICH HABE IN ERFAHRUNG GEBRACHT, DASS EINE GRUPPE VON ABENTEURERN UNSERE PLÄNE ZU STÖREN VERSUCHT. IN GEWISSER MENSCH NAMENS ~SELF~ SOLL DIE GRUPPE LEITEN. SOLL ~SEX1~ DOCH KOMMEN! SELBST WENN ~SEX1~ AM WACHDÄMON VORBEIKOMMEN SOLLTE, WAS NICHT GELINGEN KANN, DANN BEKÄME ~SEX1~ ES IMMER NOCH MIT MIR ZU TUN.\""
#: AllTexts/Object_texts.amb/005/000.txt
msgctxt "AllTexts/Object_texts.amb/005/000"
msgid "MOST OF THE ENTRIES ARE WRITTEN USING STRANGE SYMBOLS WHICH YOU CANNOT READ. ONLY THE FOLLOWING PASSAGES ARE WRITTEN IN LYRAMIONIC:^^ \"OH, MASTER S'LORWIN, YOUR PLAN WITH THE DWARFS SUCCEEDED BEAUTIFULLY. THEY WERE PREPARED TO WORK FOR YEARS TOWARD THEIR DREAM. THEY COMPLETED THE MACHINE AND I TOOK THEM ON THE FLYING SHIP TO THE CONTAMINATED FOREST MOON.^ HA, THOSE LITTLE FOOLS, TO BELIEVE THE MOON WAS JUST ONE ENORMOUS JEWEL! THEY WERE REALLY QUITE SURPRISED WHEN I DUMPED THEM THERE. IT WAS NOT DIFFICULT FOR ME TO GET AWAY AND LEAVE THEM BEHIND. NOW THAT THERE ARE NO MORE DWARFS HERE ON LYRAMION, NO ONE WILL HEAR OF OUR PLANS.\"^^ \"MASTER S'LORWIN, AS INSTRUCTED, I WANTED TO EXAMINE THE BURIAL CHAMBER ON THE MOON WHICH CRASHED DOWN, BUT UNFORTUNATELY A DOOR STOPPED ME ENTERING THE CHAMBER. THE DOOR BEARS THE IMAGE OF A TWELVE-POINTED STAR. I EXPECT WE NEED SUCH A STAR TO OPEN THE DOOR.^ WITH REGARD TO YOUR ASSUMPTION THAT THERE IS A GODLIKE BEING BY THE NAME OF TARBOS I CAN ONLY SAY THAT I HAVE NOT MET HIM YET. BUT THE LEGENDS ABOUT TARBOS HAVE BEEN OF GREAT HELP TO US IN KEEPING OUR PLAN SECRET, FOR NO-ONE ON LYRAMION DOUBTED THAT TARBOS WOULD HAVE PLAGUED LYRAMION AGAIN A LONG TIME AGO IF IT HAD NOT BEEN FOR OUR BROTHERHOOD.\"^^ \"OH, MASTER S'LORWIN, I HAVE GREAT NEWS FOR YOU! THE WORK IS FINISHED AND THE MACHINE HAS BEGUN OPERATION. IN A FEW MONTHS IT WILL MAKE OUR WORLD FERTILE AGAIN. OF COURSE, THAT WILL MEAN THE END FOR LYRAMION, BUT WHO CARES! WE ARE THE MIGHTY ONES, AND THEREFORE WE ARE ALSO THE MORE VALUABLE ONES!\"^^ \"MASTER S'LORWIN, I HAVE HEARD THAT A BAND OF ADVENTURERS ARE TRYING TO DISRUPT OUR PLANS. A CERTAIN ~SELF~ IS SAID TO LEAD THE GROUP. JUST LET HIM COME HERE! EVEN IF HE SHOULD GET PAST THE GUARD DEMON, WHICH HE SIMPLY CANNOT, HE STILL HAS TO DEAL WITH ME.\""
msgstr ""

#. Text of a readable item (book, letter, scroll).
#. German: "BROM, MEIN TAPPFERER KRIEGER, HIERMIT ERTEILE ICH DIR EINE WICHTIGE AUFGABE: DURCHSTREIFE UNSERE NEUE WELT UND HALTE NACH EINEM DIESER FLUGSCHIFFE AUSSCHAU! WENN ES IRGENDWIE MACHBAR IST, DANN SCHLEICHE DICH AUF EINS DIESER SCHIFFE UND VERSUCHE, AUF LYRAMION HILFE ZU BEKOMMEN. VIELLEICHT SCHAFFEN WIR ES MIT DEINER HILFE, AUS DIESEM SCHRECKLICHEN WALD ZU ENTKOMMEN.^ ICH HABE EINEN DIESER NAVSTEINE BEISEITE SCHAFFEN KÖNNEN. ER IST IN DER ALTEN ZWERGENMINE VERSTECKT. DU BRAUCHST ACHT VERSCHIEDENE STEINE, UM DEN WEG IN DIE SCHATZKAMMER DER ZWERGENMINE FREIZUBEKOMMEN:^^ 1.TOPAS^ 2.RUBIN^ 3.SMARAGD^ 4.ERDSTEIN^ 5.BERGKRISTALL^ 6.REGENBOGENSTEIN^ 7.DIAMANT^ 8.BERNSTEIN^^ VIEL GLÜCK^ KIRE"
#: AllTexts/Object_texts.amb/005/001.txt
msgctxt "AllTexts/Object_texts.amb/005/001"
msgid "BROM, MY BRAVE WARRIOR, LET ME GIVE YOU AN IMPORTANT JOB: SCOUT AROUND OUR NEW WORLD AND WATCH OUT FOR ONE OF THOSE AIRSHIPS! IF POSSIBLE, GET ON BOARD ONE OF THESE SHIPS AND TRY TO GET HELP ON LYRAMION. PERHAPS WITH YOUR ASSISTANCE WE WILL SUCCEED IN GETTING AWAY FROM THIS DREADFUL FOREST.^ I WAS ABLE TO PUT ONE OF THESE NAVIGATION STONES TO ONE SIDE. IT IS HIDDEN IN THE OLD DWARF MINE. YOU NEED EIGHT DIFFERENT STONES TO CLEAR THE WAY INTO THE TREASURE CHAMBERS OF THE DWARF MINE:^^ 1. TOPAZ^ 2. RUBY^ 3. EMERALD^ 4. EARTH STONE^ 5. QUARTZ CRYSTAL^ 6. RAINBOW STONE^ 7. DIAMOND^ 8. AMBER GEM^^ GOOD LUCK! KIRE"
msgstr ""

#. Text of a readable item (book, letter, scroll).
#. German: "AUF DEM PERGAMENT SIND WICHTIGE ORTE UND DEREN KOORDINATEN AUF MORAG AUFGEZEICHNET:^^ DIE STADT S'ANGRILA BEI 22,133^ DER PALAST DES S'RIEL BEI 187,91^ DER PALAST DES S'OREL BEI 33,179^ DER PALAST DES S'ARIN BEI 87,26^ DER PALAST DES S'ENDAR BEI 175,127^ DER PALAST DES S'TROG BEI 15,83^ DER PALAST DES S'KAT BEI 127,182^ DER PALAST DES S'LORWIN BEI 127,82"
#: AllTexts/Object_texts.amb/005/002.txt
msgctxt "AllTexts/Object_texts.amb/005/002"
msgid "IMPORTANT PLACES AND THEIR COORDINATES ON MORAG ARE WRITTEN ON THE PARCHMENT:^^ THE TOWN OF S'ANGRILA AT 22.133^ THE PALACE OF S'RIEL AT 187.91^ THE PALACE OF S'OREL AT 33.179^ THE PALACE OF S'ARIN AT 87.26^ THE PALACE OF S'ENDAR AT 175.127^ THE PALACE OF S'TROG AT 15.83^ THE PALACE OF S'KAT AT 127.182^ THE PALACE OF S'LORWIN AT 127.82"
msgstr ""

#. Text of a readable item (book, letter, scroll).
#. German: "SEHR GEEHRTES RATSMITGLIED S'KAT, EUER BESTELLTES SANDBOOT IST FERTIGGESTELLT. SCHICKT DOCH BITTE EINEN EURER DIENER MIT DIESER NACHRICHT ZU MIR. MEIN TURM BEFINDET SICH, WIE IHR WISST, BEI 184,189.^^ S'GOLDAR"
#: AllTexts/Object_texts.amb/005/003.txt
msgctxt "AllTexts/Object_texts.amb/005/003"
msgid "DEAR S'KAT, MEMBER OF THE COUNCIL, THE SAND BOAT YOU ORDERED IS FINISHED. PLEASE SEND ONE OF YOUR SERVANTS TO ME WITH THIS MESSAGE. AS YOU KNOW, MY TOWER IS LOCATED AT 184.189.^^ S'GOLDAR"
msgstr ""

