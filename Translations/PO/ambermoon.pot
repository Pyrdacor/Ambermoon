msgid "YOU NOTICE A FEW SMALL MUSHROOMS BECAUSE THEY ARE GLOWING BRIGHTLY. ASRUB SPOKE VERY ENTHUSIASTICALLY ABOUT THEM IN HIS LESSON."
msgstr ""

#. Text 006 of map 304.
#. German: "DIE GRUPPE WIRD ANGEGRIFFEN! IHR BEMERKT DIE HERVORRAGEND GETARNTEN BESTIEN ERST, ALS IHR FAST IN SIE HINEINLAUFT."
#: AllTexts/3Map_texts.amb/304/006.txt
msgctxt "AllTexts/3Map_texts.amb/304/006"
msgid "THE GROUP IS BEING ATTACKED! YOU ONLY NOTICE THE BEAUTIFULLY CLAMOUFLAGED BEASTS WHEN YOU ALMOST RUN RIGHT INTO THEM."
msgstr ""

#. Text 007 of map 304.
#. German: "DEM SCHLAMMIGEN BODEN ENTSTEIGEN PLÖTZLICH ZAHLREICHE HUNGRIGE SUMPFBEWOHNER."
#: AllTexts/3Map_texts.amb/304/007.txt
msgctxt "AllTexts/3Map_texts.amb/304/007"
msgid "SUDDENLY LOTS OF HUNGRY BOG-DWELLERS CLAMBER OUT OF THE SLUDGY GROUND."
msgstr ""

#. Text 008 of map 304.
#. German: "SOBALD IHR DER SELTSAMEN PFLANZE NAHEKOMMT, PEITSCHEN IHRE TENTAKEL AUF EUCH EIN. DIE SPITZEN DER AUSWÜCHSE BRENNEN WIE FEUER."
#: AllTexts/3Map_texts.amb/304/008.txt
msgctxt "AllTexts/3Map_texts.amb/304/008"
msgid "AS SOON AS YOU GET CLOSE TO THE STRANGE PLANT, ITS TENTACLES SHOOT OUT TOWARDS YOU. THE TIPS OF ITS BRANCHES BURN LIKE FIRE. ␀ "
msgstr ""

