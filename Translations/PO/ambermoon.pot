msgstr ""

#. Dialogue of party member 006 (MONIKA).
#. German: "HALLO!^ ICH BIN DIE FIGUR VON MONIKA KRAWINKEL, DER GRAFIKERIN VON AMBERMOON."
#: AllTexts/Party_texts.amb/006/001.txt
msgctxt "AllTexts/Party_texts.amb/006/001"
