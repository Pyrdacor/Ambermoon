#. Text 012 of map 325.
#. German: "~INK 30~ ALS IHR NÄHER AN DIE TÜR IN DEM RIESIGEN BAUM TRETET, ERTÖNT EINE LANGSAME, KNARRENDE STIMME:^ ~INK 31~ \"SAGE DAS WORT!\""
#: AllTexts/3Map_texts.amb/325/012.txt
msgctxt "AllTexts/3Map_texts.amb/325/012"
msgid "~INK 30~ AS YOU MOVE CLOSER TO THE DOOR, A SLOW CREAKY VOICE IN THE HUGE TREE SAYS:^ ~INK 31~ \"SAY THE WORD!\""
msgstr ""

#. Text 013 of map 325.
#. German: "~INK 30~ DIE HÖLZERNE STIMME SAGT:^ ~INK 31~ \"TRITT NÄHER, GELIEBTER SOHN!\""
