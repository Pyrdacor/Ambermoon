msgid "IT'S A SHAME I MUST LEAVE THE GROUP!^ IF YOU NEED ME, YOU WILL FIND ME IN THE THALION OFFICE."
msgstr ""

#. Dialogue of party member 007 (TAR THE DARK).
#. German: "IHR SEHT EINEM MANN IN MITTLEREN JAHREN. ER SCHAUT EUCH TRAURIG AN, UND IHR MEINT TAUSEND JAHRE QUALEN IN SEINEM GESICHT ZU ERKENNEN."
#: AllTexts/Party_texts.amb/007/000.txt
msgctxt "AllTexts/Party_texts.amb/007/000"
msgid "YOU SEE A MIDDLE AGED MAN. HE LOOKS AT YOU SADLY AND YOU SENSE A THOUSAND YEARS OF SUFFERING IN HIS EXPRESSION."
msgstr ""

#. Dialogue of party member 007 (TAR THE DARK).
#. German: "MIT LEISER, TRAURIGER STIMME SAGT DER MANN:^ \"KOMMT RUHIG NÄHER, DAS BÖSE IST VON MIR GEWICHEN! JETZT BIN ICH WIEDER WIE DER KLEINE JUNGE, DER ICH VOR LANGER ZEIT WAR. JETZT BIN ICH WIEDER TAR.^ EINST WAR ICH LORD TARBOS, DER GOTT DES CHAOS, UND ICH HABE SOVIEL SCHULD UND SÜNDE AUF MICH GELADEN, DASS ICH AUF DER STELLE MEINEM BLUTIGEN LEBEN EIN ENDE SETZEN SOLLTE. DOCH WIE SOLL ICH DANN DIE SCHULD BEGLEICHEN, DIE ICH AUF MICH GELADEN HABE? WIE KANN MIR LYRAMION JEMALS VERGEBEN FÜR DIE WUNDEN, DIE ICH IHM ZUGEFÜGT HABE?^ WIE ICH SEHE, SEIT IHR DABEI, LYRAMION VOR EINER GROßEN GEFAHR ZU RETTEN. BITTE, LASST MICH TEILHABEN UND MEIN LEBEN IN DEN DIENST DIESER GUTEN TAT STELLEN! BITTE NEHMT MICH IN EURE GRUPPE AUF!\""
#: AllTexts/Party_texts.amb/007/001.txt
msgctxt "AllTexts/Party_texts.amb/007/001"
msgid "IN A QUIET, SAD VOICE THE MAN SAYS:^ \"PLEASE COME CLOSER, THE EVIL HAS LEFT ME! TODAY I AM JUST LIKE THE LITTLE BOY I WAS A LONG TIME AGO. NOW I AM TAR AGAIN.^ ONCE I WAS LORD TARBOS, THE GOD OF CHAOS, AND I BROUGHT SO MUCH EVIL, SIN AND SUFFERING TO EVERYONE THAT I WANTED TO PUT AN END TO MY BLOODY LIFE. BUT HOW CAN I SETTLE THE DEBT I HAVE INCURRED. HOW CAN LYRAMION EVER FORGIVE ME FOR THE WOUNDS I HAVE CAUSED?^ AS I SEE, YOU ARE ABOUT TO SAVE LYRAMION FROM A GREAT DANGER. PLEASE LET ME JOIN YOU AND DEDICATE MY LIFE TO THIS GOOD DEED! PLEASE LET ME JOIN YOUR GROUP!\""
msgstr ""

#. Dialogue of party member 007 (TAR THE DARK).
#. German: "\"ICH HOFFE ZUTIEFST, DASS ICH EINST MEINE SCHULD AN LYRAMION BEGLEICHEN KANN.\""
#: AllTexts/Party_texts.amb/007/002.txt
msgctxt "AllTexts/Party_texts.amb/007/002"
msgid "\"I SINCERELY HOPE THAT I CAN SETTLE MY DEBT WITH LYRAMION.\""
msgstr ""

#. Dialogue of party member 007 (TAR THE DARK).
#. German: "\"ICH STEHE TIEF IN EURER SCHULD, DA IHR ES MIR ERMÖGLICHT, LYRAMION ZU HELFEN. ICH DANKE EUCH DAFÜR, DASS ICH EUCH BEGLEITEN DARF.\""
#: AllTexts/Party_texts.amb/007/003.txt
msgctxt "AllTexts/Party_texts.amb/007/003"
msgid "\"I AM DEEP IN YOUR DEBT, FOR YOU ARE ALLOWING ME TO HELP LYRAMION. THANK YOU FOR LETTING ME ACCOMPANY YOU.\""
msgstr ""

#. Dialogue of party member 007 (TAR THE DARK).
#. German: "\"ICH WERDE IN MEINE ZELLE NACH SPANNENBERG GEHEN UND DORT ÜBER MEINE VERFEHLUNGEN MEDITIEREN. FALLS IHR MICH JEMALS WIEDER BRAUCHT, DANN FINDET IHR MICH DORT.\""
#: AllTexts/Party_texts.amb/007/004.txt
msgctxt "AllTexts/Party_texts.amb/007/004"
msgid "\"I WILL GO TO MY CELL IN SPANNENBERG AND MEDITATE ABOUT MY MISDEEDS. IF YOU EVER NEED ME AGAIN, YOU WILL FIND ME THERE.\""
msgstr ""

#. Dialogue of party member 008 (EGIL).
#. German: "DU SIEHST EINEN JUNGEN KÄMPFER IN EINEM KETTENHEMD. ER HÖRT AUF, SEIN SCHWERT ZU POLIEREN UND BLICKT DICH FRAGEND AN."
#: AllTexts/Party_texts.amb/008/000.txt
msgctxt "AllTexts/Party_texts.amb/008/000"
msgid "YOU SEE A YOUNG WARRIOR WEARING A TUNIC OF CHAIN MAIL. HE STOPS POLISHING HIS SWORD AND LOOKS AT YOU QUESTIONINGLY."
msgstr ""

#. Dialogue of party member 008 (EGIL).
#. German: "\"ICH GRÜßE EUCH! MEIN NAME IST EGIL, HABT IHR VIELLEICHT LUST EUCH MIR ANZUSCHLIEßEN, UM ETWAS GEGEN DIE ORKS ODER BANDITEN ZU UNTERNEHMEN?\""
#: AllTexts/Party_texts.amb/008/001.txt
msgctxt "AllTexts/Party_texts.amb/008/001"
msgid "\"WELCOME! MY NAME IS EGIL. PERHAPS YOU WOULD LIKE TO JOIN ME TO DO SOMETHING ABOUT THE ORCS AND THE BANDITS?\""
msgstr ""

#. Dialogue of party member 008 (EGIL).
#. German: "\"HALLO KAMERAD, WAS KANN ICH FÜR DICH TUN?\""
#: AllTexts/Party_texts.amb/008/002.txt
msgctxt "AllTexts/Party_texts.amb/008/002"
msgid "\"HELLO, COMRADE, WHAT CAN I DO FOR YOU?\""
msgstr ""

#. Dialogue of party member 008 (EGIL).
#. German: "\"LASST UNS LOSZIEHEN UND MIT DEM BANDITENUNWESEN AUFRÄUMEN!\"^ ER RÜCKT SEIN GEPÄCK ZURECHT UND WENDET SICH ZUM GEHEN."
#: AllTexts/Party_texts.amb/008/003.txt
msgctxt "AllTexts/Party_texts.amb/008/003"
msgid "\"LET'S GET GOING AND DRIVE THE BANDITS AWAY!\"^ HE TAKES HIS BELONGINGS AND TURNS TO GO."
msgstr ""

#. Dialogue of party member 008 (EGIL).
#. German: "\"ICH HOLE EBEN MEINE SACHEN, DANN KANN ES LOSGEHEN!\""
#: AllTexts/Party_texts.amb/008/004.txt
msgctxt "AllTexts/Party_texts.amb/008/004"
msgid "\"I WILL JUST GET MY THINGS, THEN WE CAN START!\""
msgstr ""

#. Dialogue of party member 008 (EGIL).
#. German: "\"FALLS IHR MAL WIEDER EINEN KÄMPFER ZU EURER UNTERSTÜTZUNG BRAUCHT, DANN FINDET IHR MICH IM HAUS DER TRAINER IN SPANNENBERG. VIEL GLÜCK!\"^ MIT DIESEN WORTEN NIMMT ER SEINEN RUCKSACK UND MACHT SICH AUF DEN WEG."
#: AllTexts/Party_texts.amb/008/005.txt
msgctxt "AllTexts/Party_texts.amb/008/005"
msgid "\"IF YOU NEED A WARRIOR TO ASSIST YOU, YOU WILL FIND ME IN THE HOUSE OF TRAINERS AT SPANNENBERG. GOOD LUCK!\"^ WITH THESE WORDS HE TAKES HIS RUCKSACK AND MOVES OFF."
msgstr ""

#. Dialogue of party member 008 (EGIL).
#. German: "\"SEIT EINIGER ZEIT ÜBERFÄLLT EIN ORKSTAMM MIT SCHÖNER REGELMÄßIGKEIT DIE BAUERN VON SPANNENBERG. DER FREIHERR GEORG HAT EINE GROßE BELOHNUNG VERSPROCHEN, FALLS JEMAND DIESER PLAGE EIN ENDE MACHT.\""
#: AllTexts/Party_texts.amb/008/006.txt
msgctxt "AllTexts/Party_texts.amb/008/006"
msgid "\"FOR SOME TIME NOW A BAND OF ORCS HAVE BEEN ATTACKING THE FARMERS OF SPANNENBERG AT REGULAR INTERVALS. BARON GEORGE HAS OFFERED A BIG REWARD IF ANYONE CAN PUT A STOP TO THIS PLAGUE.\""
msgstr ""

#. Dialogue of party member 008 (EGIL).
#. German: "\"DIE DIEBE DER GILDE VON SPANNENBERG HABEN WENIGSTENS SOWAS WIE EINE ZUNFTEHRE IM LEIB, ABER DIE BANDITEN, DIE SEIT EINIGER ZEIT DIE GEGEND HEIMSUCHEN, SIND NICHTS ALS EINE MÖRDERBANDE. ICH HABE VOR, IHR GEHEIMES QUARTIER AUSFINDIG ZU MACHEN UND DIE BELOHNUNG ZU KASSIEREN, DIE DER FREIHERR AUSGESETZT HAT. GERÜCHTEN ZUFOLGE SOLL DIESES BANDITENNEST MITTEN IN DER WÜSTE NÖRDLICH VON SPANNENBERG SEIN.\""
#: AllTexts/Party_texts.amb/008/007.txt
msgctxt "AllTexts/Party_texts.amb/008/007"
msgid "\"THE THIEVES AT THE GUILD IN SPANNENBERG AT LEAST HAVE SOMETHING AKIN TO HONOUR AMONGST THEM, BUT THE BANDITS WHO HAVE BEEN DOING THEIR DIRTY DEEDS HERE FOR SOME TIME ARE NOTHING MORE THAN A GANG OF MURDERERS. I INTEND TO FIND THEIR SECRET HEADQUARTERS AND COLLECT THE REWARD THE BARON HAS OFFERED. RUMOUR HAS IT THAT THE BANDITS HAVE THEIR CAMP IN THE MIDDLE OF THE DESERT TO THE NORTH OF SPANNENBERG.\""
msgstr ""

#. Dialogue of party member 008 (EGIL).
#. German: "\"ICH WERDE SCHON NOCH LEUTE FINDEN, DIE MICH IN MEINEM KAMPF GEGEN DIE ORKS UND BANDITEN UNTERSTÜTZEN WERDEN.\" VERBITTERT WENDET ER SICH VON EUCH AB."
#: AllTexts/Party_texts.amb/008/008.txt
msgctxt "AllTexts/Party_texts.amb/008/008"
msgid "\"I WILL FIND PEOPLE WHO WILL HELP ME IN MY FIGHT AGAINST THE ORCS AND BANDITS.\" HE TURNS AWAY WITH A BITTER LOOK IN HIS EYES."
msgstr ""

#. Dialogue of party member 009 (SELENA).
#. German: "IHR SEHT EINE GRÜNHÄUTIGE FRAU. SIE HAT MEHRFACH GEBROCHENE FLÜGEL AUF DEM RÜCKEN."
#: AllTexts/Party_texts.amb/009/000.txt
msgctxt "AllTexts/Party_texts.amb/009/000"
msgid "YOU SEE A WOMAN WITH GREEN SKIN. THE WINGS ON HER BACK ARE BROKEN IN MANY PLACES."
msgstr ""

#. Dialogue of party member 009 (SELENA).
#. German: "\"OH, WAS FÜR EIN GLÜCK, IHR SPRECHT MEINE SPRACHE! ICH HATTE SCHON ALLE HOFFNUNG AUFGEGEBEN UND SAH MICH BEREITS IM KOCHTOPF DIESES FURCHTBAREN RIESEN. ICH BIN EUCH UNENDLICH DANKBAR.^ TROTZDEM, MIT MEINEN GEBROCHENEN FLÜGELN IST MIR DER RÜCKWEG IN MEINE WELT ENDGÜLTIG VERSPERRT. ICH WEISS NICHT, WAS ICH JETZT MACHEN SOLL. KANN ICH NICHT BEI EURER GRUPPE BLEIBEN? ICH BIN ALS DIEB NICHT UNGESCHICKT.\""
#: AllTexts/Party_texts.amb/009/001.txt
msgctxt "AllTexts/Party_texts.amb/009/001"
msgid "\"OH, WHAT LUCK, YOU SPEAK MY LANGUAGE! I HAD GIVEN UP ALL HOPE AND FELT I WOULD END UP BEING BOILED BY THIS TERRIBLE GIANT. I AM ETERNALLY GRATEFUL.^ NEVERTHELESS, I CANNOT MAKE MY WAY BACK TO MY OWN WORLD BECAUSE MY WINGS ARE BROKEN. I DON'T KNOW WHAT I SHOULD DO NOW. CAN I NOT STAY WITH YOUR GROUP? I AM QUITE A GOOD THIEF.\""
msgstr ""

#. Dialogue of party member 009 (SELENA).
#. German: "\"AH, MEINE RETTER! ES IST SCHÖN EUCH WIEDERZUSEHEN.\""
#: AllTexts/Party_texts.amb/009/002.txt
msgctxt "AllTexts/Party_texts.amb/009/002"
msgid "\"AH, MY SAVIOURS! IT IS NICE TO SEE YOU AGAIN.\""
msgstr ""

#. Dialogue of party member 009 (SELENA).
#. German: "\"NUN, ICH WERDE VERSUCHEN, DIE ORKHÖHLE ZU VERLASSEN. FALLS IHR MICH SUCHEN SOLLTET, DANN FINDET IHR MICH IN DER HÖHLE SÜDLICH VON HIER.\"^ MIT DIESEN WORTEN VERLÄSST SIE DIE ZELLE."
#: AllTexts/Party_texts.amb/009/003.txt
msgctxt "AllTexts/Party_texts.amb/009/003"
msgid "\"WELL, I WILL TRY TO GET OUT OF THE ORC CAVE. IF YOU SHOULD NEED ME, YOU WILL FIND ME IN THE CAVE SOUTH OF HERE.\"^ WITH THESE WORDS SHE LEAVES THE CELL."
msgstr ""

#. Dialogue of party member 009 (SELENA).
#. German: "\"ES WAR NETT, MIT EUCH ZU REDEN.\""
#: AllTexts/Party_texts.amb/009/004.txt
msgctxt "AllTexts/Party_texts.amb/009/004"
msgid "\"IT WAS NICE TO TALK TO YOU.\""
msgstr ""

#. Dialogue of party member 009 (SELENA).
#. German: "\"VIELEN DANK, DASS ICH EUCH BEGLEITEN DARF. WAS SOLL ICH SONST AUCH GANZ ALLEIN IN DIESER FREMDEN WELT TUN?\""
#: AllTexts/Party_texts.amb/009/005.txt
msgctxt "AllTexts/Party_texts.amb/009/005"
msgid "\"THANK YOU FOR ALLOWING ME TO ACCOMPANY YOU. WHAT COULD I HAVE DONE ALONE IN THIS STRANGE WORLD?\""
msgstr ""

#. Dialogue of party member 009 (SELENA).
#. German: "\"SCHADE, DASS ICH EURE GRUPPE VERLASSEN SOLL. FALLS IHR MICH DOCH NOCH MAL BRAUCHEN SOLLTET, DANN FINDET IHR MICH IN DER SYLPHEN-HÖHLE.\""
#: AllTexts/Party_texts.amb/009/006.txt
msgctxt "AllTexts/Party_texts.amb/009/006"
msgid "\"IT IS A SHAME THAT I HAVE TO LEAVE YOUR GROUP. IF YOU NEED ME AGAIN, YOU WILL FIND ME IN THE CAVE OF THE SYLPHS.\""
msgstr ""

#. Dialogue of party member 009 (SELENA).
#. German: "\"SO HEIßT MEINE SCHWESTER. ICH WERDE SIE NIE MEHR WIEDERSEHEN.\""
#: AllTexts/Party_texts.amb/009/007.txt
msgctxt "AllTexts/Party_texts.amb/009/007"
msgid "\"THAT IS THE NAME OF MY SISTER. I WILL NEVER SEE HER AGAIN.\""
msgstr ""

#. Dialogue of party member 010 (NELVIN).
#. German: "VOR DIR STEHT EIN JUNGER MAGIER. ER TRÄGT EINE LANGE ROBE UND SIEHT DICH STOLZ AN."
#: AllTexts/Party_texts.amb/010/000.txt
msgctxt "AllTexts/Party_texts.amb/010/000"
msgid "BEFORE YOU STANDS A YOUNG MAGICIAN. HE IS WEARING A LONG ROBE AND LOOKS AT YOU PROUDLY."
msgstr ""

#. Dialogue of party member 010 (NELVIN).
#. German: "\"SEID GEGRÜßT! ICH HEIßE NELVIN UND ÜBE DEN EDLEN BERUF DES MAGIERS AUS.\""
#: AllTexts/Party_texts.amb/010/001.txt
msgctxt "AllTexts/Party_texts.amb/010/001"
msgid "\"WELCOME! MY NAME IS NELVIN AND I AM IN THE NOBLE PROFESSION OF MAGICIAN.\""
msgstr ""

#. Dialogue of party member 010 (NELVIN).
#. Placeholders: ~SELF~ = the hero (the player character). The gender of these persons is unknown.
#. German: "\"WOMIT KANN ICH EUCH ZU DIENSTEN SEIN ~SELF~?\""
#: AllTexts/Party_texts.amb/010/002.txt
msgctxt "AllTexts/Party_texts.amb/010/002"
msgid "\"HOW MAY I BE OF SERVICE TO YOU, NOBLE ~SELF~?\""
msgstr ""

#. Dialogue of party member 010 (NELVIN).
#. German: "\"MÖGE EUCH DIE MAGIE IMMERDAR DIENSTBAR SEIN!\""
#: AllTexts/Party_texts.amb/010/003.txt
msgctxt "AllTexts/Party_texts.amb/010/003"
msgid "\"MAY MAGIC ALWAYS BE ON YOUR SIDE!\""
msgstr ""

#. Dialogue of party member 010 (NELVIN).
#. German: "\"ICH HABE DAS HANDWERK DER DESTRUKTIONSMAGIE BEI MEINEM VEREHRTEN MEISTER TRASRIC GELERNT. VOR UNGEFÄHR EINEM JAHR IST ER IN DEN EWIGEN SCHLAF EINGEGANGEN. MÖGE BALA SEINER SEELE GNÄDIG SEIN!^ AN SEINEM TOTENBETT HAT ER MIR VON DEM TURM DER EINSTIGEN SCHWARZMAGIER ERZÄHLT UND MIR GERATEN, MICH AUF DEN WEG DORTHIN ZU MACHEN. ER SAGTE, DASS DORT NOCH ALTE SPRUCHROLLEN UND ANDERE MAGISCHE DINGE ZU FINDEN SEIEN. ER GAB MIR ETWAS, DAS ER DIE SPHÄRE DER ÖFFNUNG NANNTE. MIT IHR SOLL MAN IN EINEM HAUS IN DER NÄHE DES TURMS EINEN MECHANISMUS IN GANG SETZEN KÖNNEN, DER DEN EINGANG ZUM TURM ÖFFNET.^ ZUR ZEIT SUCHE ICH NACH EINER GRUPPE, DIE MIT MIR ZUSAMMEN DEN TURM AUFSUCHT, DENN ALLEINE BIN ICH FÜR SO EINE REISE NICHT GERÜSTET.\""
#: AllTexts/Party_texts.amb/010/004.txt
msgctxt "AllTexts/Party_texts.amb/010/004"
msgid "\"I LEARNED THE SKILLS OF DESTRUCTIVE MAGIC FROM MY DEAR MASTER, TRASRIC. AROUND A YEAR AGO HE ENTERED THE REALMS OF ETERNAL SLEEP. MAY BALA GUARD HIS SOUL WITH KINDNESS!^ ON HIS DEATHBED HE TOLD ME OF THE TOWER OF THE OLD BLACK MAGICIANS AND ADVISED ME TO MAKE MY WAY THERE. HE SAID THAT I WOULD FIND OLD MAGIC SCROLLS AND OTHER MAGICAL THINGS THERE. HE GAVE ME SOMETHING WHICH HE CALLED THE SPHERE OF OPENING. APPARENTLY IT CAN BE USED IN A HOUSE CLOSE TO THE TOWER TO START A MECHANISM WHICH OPENS THE ENTRANCE DOORS TO THE TOWER.^ AT THE MOMENT I AM LOOKING FOR A GROUP TO JOIN ME TO FIND THE TOWER, BECAUSE I AM NOT EQUIPPED WELL ENOUGH MYSELF FOR SUCH A JOURNEY ON MY OWN.\""
msgstr ""

#. Dialogue of party member 010 (NELVIN).
#. German: "ER ZEIGT EUCH EIN GROßE, SCHWACH BLÄULICH LEUCHTENDE KUGEL."
#: AllTexts/Party_texts.amb/010/005.txt
msgctxt "AllTexts/Party_texts.amb/010/005"
msgid "HE SHOWS YOU A LARGE BALL WHICH GLOWS WITH A BLUISH LIGHT."
msgstr ""

#. Dialogue of party member 010 (NELVIN).
#. German: "\"ICH FÜHLE MICH GEEHRT UND NEHME EUER ANGEBOT GERNE AN.\""
#: AllTexts/Party_texts.amb/010/006.txt
msgctxt "AllTexts/Party_texts.amb/010/006"
msgid "\"I AM VERY HONOURED AND PLEASED TO ACCEPT YOUR OFFER.\""
msgstr ""

#. Dialogue of party member 010 (NELVIN).
#. German: "\"SCHADE, DASS SICH UNSERE WEGE HIER TRENNEN! FALLS IHR MICH SUCHT, ICH WERDE MICH IM GÄSTEZIMMER DES EDLEN ALKEM EINQUARTIEREN.\""
#: AllTexts/Party_texts.amb/010/007.txt
msgctxt "AllTexts/Party_texts.amb/010/007"
msgid "\"IT'S A SHAME THAT WE MUST PART HERE! IF YOU NEED ME I WILL BE STAYING AS A GUEST OF THE NOBLE ALCHEMIST.\""
msgstr ""

#. Dialogue of party member 011 (SABINE).
#. German: "IHR SEHT EINE JUNGE FRAU IN EINER WEIßEN ROBE VOR EUCH. SIE SIEHT EUCH MIT EINEM ERFREUTEN LÄCHELN AN."
#: AllTexts/Party_texts.amb/011/000.txt
msgctxt "AllTexts/Party_texts.amb/011/000"
msgid "YOU SEE BEFORE YOU A YOUNG WOMAN WEARING A WHITE ROBE."
msgstr ""

#. Dialogue of party member 011 (SABINE).
#. German: "\"ICH HÄTTE KAUM ZU HOFFEN GEWAGT, DASS ICH HILFE ERHALTE. DER FEUERDÄMON LUMINOR HÄLT ALLE BEWOHNER VON BURNVILLE HIER IN DER FOLTERKAMMER GEFANGEN. VIELLEICHT SOLLTEN WIR UNS ZUSAMMENTUN. GEMEINSAM SCHAFFEN WIR ES WOHL EHER, DIE LEUTE ZU BEFREIEN.^ ICH HABE GESEHEN, DASS LUMINOR PERSÖNLICH DEN SCHLÜSSEL ZU DEN ZELLEN BEI SICH TRÄGT. SOWEIT ICH HERAUSGEFUNDEN HABE, LEBT ER IN EINEM DER OBEREN STOCKWERKE DES TURMS.\""
#: AllTexts/Party_texts.amb/011/001.txt
msgctxt "AllTexts/Party_texts.amb/011/001"
msgid "\"I HARDLY DARED HOPE THAT HELP WOULD COME. THE FIRE DEMON LUMINOR IS HOLDING ALL THE INHABITANTS OF BURNVILLE AS PRISONERS HERE IN THE TORTURE CHAMBER. PERHAPS WE SHOULD GET TOGETHER, FOR TOGETHER WE WILL BE BETTER ABLE TO FREE THE PEOPLE.^ I SAW THAT LUMINOR PERSONALLY HOLDS THE KEY TO THE CELLS. AS FAR AS I KNOW, HE LIVES ON ONE OF THE UPPER FLOORS IN THE TOWER.\""
msgstr ""

#. Dialogue of party member 011 (SABINE).
#. German: "\"SCHÖN, EUCH LEBEND WIEDERZUSEHEN! WIR HATTEN WIRKLICH GLÜCK, DASS SO VIELE DER BEWOHNER VON BURNVILLE DIE TORTUREN HIER ÜBERLEBT HABEN.\""
#: AllTexts/Party_texts.amb/011/002.txt
msgctxt "AllTexts/Party_texts.amb/011/002"
msgid "\"IT'S NICE TO SEE YOU AGAIN ALIVE! WE WERE VERY LUCKY THAT SO MANY OF THE INHABITANTS OF BURNVILLE SURVIVED THE TORTURE.\""
msgstr ""

#. Dialogue of party member 011 (SABINE).
#. German: "\"WIE IHR WOLLT! WENN ICH MICH EUCH NICHT ANSCHLIEßEN KANN, DANN WERDE ICH EBEN AUF EIGENE FAUST VERSUCHEN, DIE LEUTE ZU BEFREIEN!\"^ MIT TRÄNEN IM GESICHT LÄUFT SIE ZUR ZELLENTÜR UND RÜTTELT VERZWEIFELT AN DEN EISENSTÄBEN."
#: AllTexts/Party_texts.amb/011/003.txt
msgctxt "AllTexts/Party_texts.amb/011/003"
msgid "\"WHATEVER YOU WANT! IF I CANNOT JOIN YOU, I WILL HAVE TO TRY TO FREE THE PEOPLE BY MYSELF!\"^ WITH TEARS IN HER EYES SHE RUNS TO THE CELL DOOR AND RATTLES THE IRON BARS IN DESPERATION."
msgstr ""

#. Dialogue of party member 011 (SABINE).
#. German: "\"LEBT WOHL! FALLS IHR JEMALS PFLEGE NÖTIG HABT, DANN KOMMT IN DIE KAPELLE. ICH WERDE MEINE HEILER ANWEISEN, EUCH BESONDERS GÜNSTIG ZU BEHANDELN.\""
#: AllTexts/Party_texts.amb/011/004.txt
msgctxt "AllTexts/Party_texts.amb/011/004"
msgid "\"FAREWELL! IF YOU EVER NEED SUCCOUR, COME TO THE CHAPEL. I WILL INSTRUCT MY HEALERS TO TREAT YOU WITH SPECIAL CARE.\""
msgstr ""

#. Dialogue of party member 011 (SABINE).
#. German: "\"LASST UNS GEHEN UND DIESEN LUMINOR FINDEN, DAMIT WIR DIESE ARMEN LEUTE HIER RAUSHOLEN KÖNNEN!\""
#: AllTexts/Party_texts.amb/011/005.txt
msgctxt "AllTexts/Party_texts.amb/011/005"
msgid "\"LET US GO AND FIND LUMINOR SO THAT WE CAN GET THE POOR PEOPLE OUT!\""
msgstr ""

#. Dialogue of party member 011 (SABINE).
#. German: "\"DIE VERWUNDETEN SIND VERSORGT. NICHTS HINDERT MICH, EUCH ZU BEGLEITEN.\""
#: AllTexts/Party_texts.amb/011/006.txt
msgctxt "AllTexts/Party_texts.amb/011/006"
msgid "\"THE WOUNDED ARE BEING TREATED. THERE IS NOTHING TO STOP ME ACCOMPANYING YOU.\""
msgstr ""

#. Dialogue of party member 011 (SABINE).
#. German: "\"WIRKLICH SCHADE! ICH DENKE, ZUSAMMEN HÄTTEN WIR EINE CHANCE GEHABT, LUMINOR ZU VERNICHTEN UND DIE GEFANGENEN ZU BEFREIEN.^ FALLS IHR MICH SUCHT, DANN FINDET IHR MICH IN MEINEM HAUS IN BURNVILLE. ICH WERDE VON DORT AUS VERSUCHEN, HILFE ZU BEKOMMEN.\""
#: AllTexts/Party_texts.amb/011/007.txt
msgctxt "AllTexts/Party_texts.amb/011/007"
msgid "\"IT'S A REAL SHAME! I THINK THAT TOGETHER WE WOULD HAVE HAD A CHANCE OF DESTROYING LUMINOR AND RELEASING THE PRISONERS.^ IF YOU NEED ME, YOU WILL FIND ME AT MY HOME IN BURNVILLE. I WILL TRY TO GET HELP FROM THERE.\""
msgstr ""

#. Dialogue of party member 011 (SABINE).
#. German: "\"SCHADE, DASS ICH EUCH SCHON VERLASSEN MUSS! FALLS IHR MICH SUCHT, DANN FINDET IHR MICH IM HAUS DER HEILER IN BURNVILLE.\""
#: AllTexts/Party_texts.amb/011/008.txt
msgctxt "AllTexts/Party_texts.amb/011/008"
msgid "\"IT'S A SHAME I MUST LEAVE YOU! IF YOU NEED ME, YOU WILL FIND ME AT THE HOUSE OF HEALERS IN BURNVILLE.\""
msgstr ""

#. Dialogue of party member 011 (SABINE).
#. German: "\"MÖGE GALA UNS IN UNSERER MISSION BEISTEHEN!\""
#: AllTexts/Party_texts.amb/011/009.txt
msgctxt "AllTexts/Party_texts.amb/011/009"
msgid "\"MAY GALA ASSIST US ON OUR MISSION!\""
msgstr ""

#. Dialogue of party member 012 (VALDYN).
#. German: "VOR EUCH STEHT EIN SELTSAMES WESEN, HALB MENSCH HALB KATZE. ES SCHAUT EUCH MIT WÜTEND FUNKELNDEN AUGEN AN."
#: AllTexts/Party_texts.amb/012/000.txt
msgctxt "AllTexts/Party_texts.amb/012/000"
msgid "BEFORE YOU STANDS A STRANGE BEING, HALF HUMAN AND HALF CAT. HE LOOKS AT YOU WITH EYES GLITTERING WITH RAGE."
msgstr ""

#. Dialogue of party member 012 (VALDYN).
#. German: "\"GRRRR, WO BIN ICH HIER GELANDET? SEID IHR DARAN SCHULD? GERADE WOLLTE ICH MEINE VERSTEINERTE FREUNDIN VON IHREM FLUCH BEFREIEN, DOCH GERADE ALS ICH IHR DAS AMULETT UMLEGEN WOLLTE, TRAF MICH EIN GEWALTIGER BLITZ.\""
#: AllTexts/Party_texts.amb/012/001.txt
msgctxt "AllTexts/Party_texts.amb/012/001"
msgid "\"GRRRR, WHERE HAVE I LANDED? IS IT YOUR FAULT? I WAS JUST ABOUT TO RELEASE MY PETRIFIED GIRLFRIEND FROM A CURSE BUT JUST AS I WANTED TO HANG THE AMULET AROUND HER NECK, I WAS HIT BY AN ENORMOUS FLASH OF LIGHTNING.\""
msgstr ""

#. Dialogue of party member 012 (VALDYN).
#. German: "\"SCHNURRR, FREUNDE! SCHÖN EUCH WIEDERZUSEHEN! HABT IHR EINE MÖGLICHKEIT GEFUNDEN, WIE ICH NACH HAUSE ZURÜCKKEHREN KANN?\""
#: AllTexts/Party_texts.amb/012/002.txt
msgctxt "AllTexts/Party_texts.amb/012/002"
msgid "\"EXCELLENT, MY FRIENDS! IT IS NICE TO SEE YOU AGAIN! HAVE YOU FOUND A WAY FOR ME TO RETURN HOME?\""
msgstr ""

#. Dialogue of party member 012 (VALDYN).
#. German: "\"ICH VERSTEHE, DASS IHR MICH NICHT ABSICHTLICH AUS MEINER WELT GERISSEN HABT. DESHALB WERDE ICH EUCH AM LEBEN LASSEN. UND JETZT ENTSCHULDIGT MICH, ICH MUSS UNBEDINGT EINEN WEG FINDEN, UM NACH HAUSE ZU KOMMEN.\""
#: AllTexts/Party_texts.amb/012/003.txt
msgctxt "AllTexts/Party_texts.amb/012/003"
msgid "\"I UNDERSTAND THAT YOU DID NOT TAKE ME FROM MY OWN WORLD INTENTIONALLY. SO I WILL LET YOU LIVE. AND NOW, PLEASE EXCUSE ME BECAUSE I SIMPLY MUST FIND A WAY TO GO HOME.\""
msgstr ""

#. Dialogue of party member 012 (VALDYN).
#. German: "\"JEDERZEIT GESPRÄCHSBEREIT, SCHNURRR!\""
#: AllTexts/Party_texts.amb/012/004.txt
msgctxt "AllTexts/Party_texts.amb/012/004"
msgid "\"READY TO TALK AT ALL TIMES!\""
msgstr ""

#. Dialogue of party member 012 (VALDYN).
#. German: "\"VOR EIN PAAR TAGEN HABE ICH EINEN MÄCHTIGEN MAGIER GETÖTET. ER HATTE EIN KOSTBARES JUWEL, DAS LIONHEART, GESTOHLEN UND MEINE GEFÄHRTIN VERSTEINERT.\"^^ ~INK 30~ ERLEBE AUCH DU DIE ABENTEUER VON VALDYN! SPIELE \"LIONHEART\"!"
#: AllTexts/Party_texts.amb/012/005.txt
msgctxt "AllTexts/Party_texts.amb/012/005"
msgid "\"I KILLED A POWERFUL MAGICIAN A FEW DAYS AGO. HE STOLE A VALUABLE JEWEL, THE LIONHEART, AND TURNED MY LADY FRIEND TO STONE.\"^^ ~INK 30~ YOU, TOO, CAN EXPERIENCE THE ADVENTURES OF VALDYN! PLAY \"LIONHEART\" TODAY!"
msgstr ""

#. Dialogue of party member 012 (VALDYN).
#. German: "VALDYN HÄLT DAS AMULETT HOCH, DAS IHR KURZ ZUVOR IN DER LICHTKUGEL GESEHEN HABT. DANN SAGT ER:^ \"ICH HABE ES IN MEINEM ABENTEUER GEFUNDEN. ICH HOFFTE, ICH KÖNNTE DAMIT DEN FLUCH VON MEINER FREUNDIN NEHMEN.\""
#: AllTexts/Party_texts.amb/012/006.txt
msgctxt "AllTexts/Party_texts.amb/012/006"
msgid "VALDYN LIFTS UP HIGH THE NECKLACE WHICH YOU SAW EARLIER IN THE SPHERE OF LIGHT. THEN HE SAYS:^ \"I FOUND IT DURING MY ADVENTURE. I HOPED I COULD USE IT TO REMOVE THE CURSE FROM MY GIRLFRIEND.\""
msgstr ""

#. Dialogue of party member 012 (VALDYN).
#. German: "\"KNURRR, IHR WOLLT, DASS ICH MICH EUCH ANSCHLIEßE? NUN WARUM NICHT, VIELLEICHT FINDEN WIR JA EINE MÖGLICHKEIT, WIE ICH ZURÜCKKEHREN KANN.\""
#: AllTexts/Party_texts.amb/012/007.txt
msgctxt "AllTexts/Party_texts.amb/012/007"
msgid "\"ROWR, YOU WANT ME TO JOIN YOU? WELL, WHY NOT? PERHAPS WE WILL FIND A WAY FOR ME TO RETURN.\""
msgstr ""

#. Dialogue of party member 012 (VALDYN).
#. German: "\"SCHNURR, NATÜRLICH BEGLEITE ICH EUCH WIEDER!\""
#: AllTexts/Party_texts.amb/012/008.txt
msgctxt "AllTexts/Party_texts.amb/012/008"
msgid "\"RRR, NATURALLY I WILL ACCOMPANY YOU AGAIN!\""
msgstr ""

#. Dialogue of party member 012 (VALDYN).
#. German: "\"ICH WERDE MIR EIN ZIMMER IN DER TAVERNE IN BURNVILLE NEHMEN. ICH WILL IN DER NÄHE DES TURMS BLEIBEN. VIELLEICHT FINDE ICH JA EINEN WEG NACH HAUSE.\""
#: AllTexts/Party_texts.amb/012/009.txt
msgctxt "AllTexts/Party_texts.amb/012/009"
msgid "\"I WILL TAKE A ROOM AT THE INN IN BURNVILLE. I WANT TO STAY NEAR THE TOWER. PERHAPS I WILL FIND A WAY HOME.\""
msgstr ""

#. Dialogue of party member 013 (TARGOR).
#. German: "IHR SEHT EINEN KLEINEN GNOM. ER TRÄGT EIN LANGE ROBE MIT MYSTISCHEN SYMBOLEN."
#: AllTexts/Party_texts.amb/013/000.txt
msgctxt "AllTexts/Party_texts.amb/013/000"
msgid "YOU SEE A SMALL GNOME. HE IS WEARING A LONG ROBE MARKED WITH MYSTICAL SYMBOLS."
msgstr ""

#. Dialogue of party member 013 (TARGOR).
#. German: "\"ICH GRÜßE EUCH FREMDE! SAGT MAL, SEHE ICH DAS RICHTIG, DASS EUCH NOCH EIN MYSTIKER IN EURER GRUPPE FEHLT? ICH HÄTTE ZEIT UND WÜRDE MICH FREUEN, WENN IHR MICH AUFNEHMT.\""
#: AllTexts/Party_texts.amb/013/001.txt
msgctxt "AllTexts/Party_texts.amb/013/001"
msgid "\"WELCOME, STRANGERS! TELL ME, AM I CORRECT IN ASSUMING YOU NEED A MYSTIC IN YOUR GROUP? I WOULD HAVE THE TIME AND WOULD BE PLEASED IF YOU WOULD LET ME JOIN YOU.\""
msgstr ""

#. Dialogue of party member 013 (TARGOR).
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "\"HALLO ~LEAD~! WAS KANN ICH FÜR DICH TUN?\""
#: AllTexts/Party_texts.amb/013/002.txt
msgctxt "AllTexts/Party_texts.amb/013/002"
msgid "\"HELLO ~LEAD~! WHAT CAN I DO FOR YOU?\""
msgstr ""

#. Dialogue of party member 013 (TARGOR).
#. German: "\"ES WAR NETT, SICH MIT DIR ZU UNTERHALTEN.\""
#: AllTexts/Party_texts.amb/013/003.txt
msgctxt "AllTexts/Party_texts.amb/013/003"
msgid "\"IT WAS NICE TO CHAT WITH YOU.\""
msgstr ""

#. Dialogue of party member 013 (TARGOR).
#. German: "\"EINEN KLEINEN MOMENT, ICH HOLE EBEN MEINE SACHEN AUS MEINEM ZIMMER, DANN KANN ES LOSGEHEN!\""
#: AllTexts/Party_texts.amb/013/004.txt
msgctxt "AllTexts/Party_texts.amb/013/004"
msgid "\"JUST A MOMENT. I WILL FETCH MY THINGS FROM MY ROOM AND THEN WE CAN GET GOING!\""
msgstr ""

#. Dialogue of party member 013 (TARGOR).
#. German: "\"WIRKLICH SCHADE, DASS ICH EURE GRUPPE VERLASSEN SOLL. FALLS IHR MICH MAL WIEDER GEBRAUCHEN KÖNNT, DANN SCHAUT DOCH IM >SCHACHT< VORBEI!\""
#: AllTexts/Party_texts.amb/013/005.txt
msgctxt "AllTexts/Party_texts.amb/013/005"
msgid "\"IT'S A REAL SHAME THAT I SHOULD LEAVE YOUR GROUP. IF YOU NEED ME AGAIN, PLEASE LOOK IN THE >SHAFT<!\""
msgstr ""

#. Dialogue of party member 014 (LEONARIA).
#. German: "IHR SEHT EINE ELFE. SIE TRÄGT DIE ROBE DER ALCHEMISTEN UND EINEN GÜRTEL, IN DEM VIELE KLEINE PHIOLEN STECKEN."
#: AllTexts/Party_texts.amb/014/000.txt
msgctxt "AllTexts/Party_texts.amb/014/000"
msgid "YOU SEE AN ELF WOMAN. SHE IS WEARING THE ROBES OF AN ALCHEMIST AND A BELT CARRYING MANY SMALL PHIALS."
msgstr ""

#. Dialogue of party member 014 (LEONARIA).
#. German: "\"MEIN NAME IST LEONARIA, UND ICH HEIßE EUCH WILLKOMMEN!\""
#: AllTexts/Party_texts.amb/014/001.txt
msgctxt "AllTexts/Party_texts.amb/014/001"
msgid "\"MY NAME IS LEONARIA, AND I WELCOME YOU!\""
msgstr ""

#. Dialogue of party member 014 (LEONARIA).
#. German: "\"MEINE LIEBEN FREUNDE, HERZLICH WILLKOMMEN IN ILLIEN!\""
#: AllTexts/Party_texts.amb/014/002.txt
msgctxt "AllTexts/Party_texts.amb/014/002"
msgid "\"MY DEAR FRIENDS, WELCOME TO ILLIEN!\""
msgstr ""

#. Dialogue of party member 014 (LEONARIA).
#. German: "\"LEBT WOHL!\""
#: AllTexts/Party_texts.amb/014/003.txt
msgctxt "AllTexts/Party_texts.amb/014/003"
msgid "\"FAREWELL!\""
msgstr ""

#. Dialogue of party member 014 (LEONARIA).
#. German: "\"ICH HOFFE, IHR BESUCHT MICH BALD WIEDER EINMAL.\""
#: AllTexts/Party_texts.amb/014/004.txt
msgctxt "AllTexts/Party_texts.amb/014/004"
msgid "\"I HOPE YOU WILL VISIT ME AGAIN SOON.\""
msgstr ""

#. Dialogue of party member 014 (LEONARIA).
#. German: "\"MHH, ICH SUCHE ZUR ZEIT IN DER TAT NACH EINER GRUPPE, DER ICH MICH ANSCHLIEßEN KANN. ICH DENKE, ALS ALCHEMISTIN WÜRDE ICH GANZ GUT ZU EUCH PASSEN. ALSO GUT, ICH WERDE MICH EUCH ANSCHLIEßEN!\""
#: AllTexts/Party_texts.amb/014/005.txt
msgctxt "AllTexts/Party_texts.amb/014/005"
msgid "\"MMHH, IT IS TRUE THAT I AM LOOKING TO JOIN A GROUP AT THE MOMENT. I THINK THAT AS AN ALCHEMIST I COULD BE QUITE USEFUL TO YOU. VERY WELL, I WILL JOIN YOU!\""
msgstr ""

#. Dialogue of party member 014 (LEONARIA).
#. German: "\"IHR WOLLT, DASS ICH DIE GRUPPE VERLASSE?! NUN GUT, ICH GEHE ZURÜCK NACH ILLIEN. FRAGT IN DER TAVERNE DORT NACH MIR, FALLS IHR MICH WIEDER BRAUCHT.\""
#: AllTexts/Party_texts.amb/014/006.txt
msgctxt "AllTexts/Party_texts.amb/014/006"
msgid "\"YOU WANT ME TO LEAVE THE GROUP?! VERY WELL, I WILL RETURN TO ILLIEN. IF YOU EVER NEED ME AGAIN, ASK FOR ME AT THE INN.\""
msgstr ""

#. Dialogue of party member 015 (GRYBAN).
#. German: "IHR SEHT EINEN HOCHGEWACHSENEN MANN IN STRAHLENDER RÜSTUNG. EIN LANGES, FUNKELNDES ZWEIHANDSCHWERT HÄNGT AN SEINER LINKEN SEITE."
#: AllTexts/Party_texts.amb/015/000.txt
msgctxt "AllTexts/Party_texts.amb/015/000"
msgid "YOU SEE A TALL MAN WEARING SHINING ARMOUR. A LONG GLISTENING DOUBLE-HANDED SWORD HANGS AT HIS LEFT HIP."
msgstr ""

#. Dialogue of party member 015 (GRYBAN).
#. German: "\"ICH SEHE DUNKLE WOLKEN ÜBER LYRAMION UND WEISS, DASS MEINE BESTIMMUNG IN EURER GRUPPE LIEGT. BITTE NEHMT MICH MIT!\""
#: AllTexts/Party_texts.amb/015/001.txt
msgctxt "AllTexts/Party_texts.amb/015/001"
msgid "\"I CAN SEE DARK CLOUDS OVER LYRAMION AND I KNOW THAT I AM DESTINED TO JOIN YOUR GROUP. PLEASE TAKE ME WITH YOU!\""
msgstr ""

#. Dialogue of party member 015 (GRYBAN).
#. German: "\"IHR MÜSST EUCH BEEILEN, WENN IHR LYRAMION RETTEN WOLLT! EINE MACHT, DIE NICHT VON DIESER WELT IST, STEHT KURZ DAVOR, LYRAMION ZU VERNICHTEN.\""
#: AllTexts/Party_texts.amb/015/002.txt
msgctxt "AllTexts/Party_texts.amb/015/002"
msgid "\"YOU MUST HURRY IF YOU WANT TO SAVE LYRAMION! A POWER WHICH IS NOT OF THIS WORLD IS ABOUT TO DESTROY IT!\""
msgstr ""

#. Dialogue of party member 015 (GRYBAN).
#. German: "\"IHR HABT EINE WEISE ENTSCHEIDUNG GETROFFEN. MEINE ERFAHRUNG UND KRAFT WERDEN FÜR EUCH VON GROßEM NUTZEN SEIN!\"^ MIT DIESEN WORTEN WIRD GRYBAN MITGLIED EURER GRUPPE."
#: AllTexts/Party_texts.amb/015/003.txt
msgctxt "AllTexts/Party_texts.amb/015/003"
msgid "\"YOU HAVE MADE A WISE DECISION. MY EXPERIENCE AND POWER WILL BE OF GREAT BENEFIT TO YOU!\"^ WITH THESE WORDS GRYBAN BECOMES A MEMBER OF YOUR GROUP."
msgstr ""

#. Dialogue of party member 015 (GRYBAN).
#. German: "\"ES IST ÄUßERST TÖRICHT VON EUCH, DASS IHR AUF MICH IN DER STUNDE DER GRÖßTEN GEFAHR VERZICHTEN WOLLT. ABER ES IST EUER ENTSCHLUSS, UND SO WIRD ES GESCHEHEN! FALLS IHR ANDEREN SINNES WERDET, DANN FINDET IHR MICH IN GODSBANE.\""
#: AllTexts/Party_texts.amb/015/004.txt
msgctxt "AllTexts/Party_texts.amb/015/004"
msgid "\"IT IS VERY UNWISE OF YOU TO TRY TO DO WITHOUT ME AT THE HOUR OF YOUR GREATEST NEED. BUT THAT IS YOUR DECISION AND SO THAT IS HOW IT SHALL BE! IF YOU CHANGE YOUR MIND, YOU WILL FIND ME IN GODSBANE.\""
msgstr ""

