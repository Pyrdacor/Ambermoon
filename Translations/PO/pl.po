#. Text 012 of map 325.
#. German: "~INK 30~ ALS IHR NÄHER AN DIE TÜR IN DEM RIESIGEN BAUM TRETET, ERTÖNT EINE LANGSAME, KNARRENDE STIMME:^ ~INK 31~ \"SAGE DAS WORT!\""
#: AllTexts/3Map_texts.amb/325/012.txt
msgctxt "AllTexts/3Map_texts.amb/325/012"
msgid "~INK 30~ AS YOU MOVE CLOSER TO THE DOOR, A SLOW CREAKY VOICE IN THE HUGE TREE SAYS:^ ~INK 31~ \"SAY THE WORD!\""
msgstr "~INK 30~ GDY ZBLIŻASZ SIĘ DO DRZWI, POWOLNY SKRZYPIĄCY GŁOS W OGROMNYM DRZEWIE MÓWI:^ ~INK 31~ \"POWIEDZ SŁOWO!\"."

#. Text 013 of map 325.
#. German: "~INK 30~ DIE HÖLZERNE STIMME SAGT:^ ~INK 31~ \"TRITT NÄHER, GELIEBTER SOHN!\""
#: AllTexts/3Map_texts.amb/325/013.txt
msgctxt "AllTexts/3Map_texts.amb/325/013"
msgid "~INK 30~ THE WOODEN VOICE SAYS:^ ~INK 31~ \"COME CLOSER, BELOVED SON!\""
msgstr "~INK 30~ DREWNIANY GŁOS MÓWI:^ ~INK 31~ \"PODEJDŹ BLIŻEJ, UMIŁOWANY SYNU!\"."

#. Text 014 of map 325.
#. German: "EUER WORT WIRD DURCH SCHWEIGEN QUITTIERT. DAS TOR BLEIBT GESCHLOSSEN."
#: AllTexts/3Map_texts.amb/325/014.txt
msgctxt "AllTexts/3Map_texts.amb/325/014"
msgid "YOUR WORD IS ACKNOWLEDGED ONLY BY SILENCE. THE GATE REMAINS CLOSED. ␀ "
msgstr "TWOJE SŁOWO JEST WITANE TYLKO CISZĄ. BRAMA POZOSTAJE ZAMKNIĘTA.    "

