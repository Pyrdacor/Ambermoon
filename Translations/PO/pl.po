msgstr "ZAUWAŻASZ KILKA MAŁYCH GRZYBÓW, PONIEWAŻ ŚWIECĄ ONE JASNO. ASRUB MÓWIŁ O NICH BARDZO ENTUZJASTYCZNIE NA SWOJEJ LEKCJI."

#. Text 006 of map 315.
#. German: "DIE GRUPPE WIRD ANGEGRIFFEN! IHR BEMERKT DIE HERVORRAGEND GETARNTEN BESTIEN ERST, ALS IHR FAST IN SIE HINEINLAUFT."
#: AllTexts/3Map_texts.amb/315/006.txt
msgctxt "AllTexts/3Map_texts.amb/315/006"
msgid "THE GROUP IS BEING ATTACKED! YOU ONLY NOTICE THE BEAUTIFULLY CLAMOUFLAGED BEASTS WHEN YOU ALMOST RUN RIGHT INTO THEM."
msgstr "GRUPA JEST ATAKOWANA! ZAUWAŻASZ PIĘKNIE ZAMASKOWANE BESTIE DOPIERO WTEDY, GDY PRAWIE NA NIE WPADASZ."

#. Text 007 of map 315.
#. German: "DEM SCHLAMMIGEN BODEN ENTSTEIGEN PLÖTZLICH ZAHLREICHE HUNGRIGE SUMPFBEWOHNER."
#: AllTexts/3Map_texts.amb/315/007.txt
msgctxt "AllTexts/3Map_texts.amb/315/007"
msgid "SUDDENLY LOTS OF HUNGRY BOG-DWELLERS CLAMBER OUT OF THE SLUDGY GROUND."
msgstr "NAGLE MNÓSTWO GŁODNYCH MIESZKAŃCÓW BAGIEN WYCHODZI Z GRZĘZAWISKA."

#. Text 008 of map 315.
#. German: "SOBALD IHR DER SELTSAMEN PFLANZE NAHEKOMMT, PEITSCHEN IHRE TENTAKEL AUF EUCH EIN. DIE SPITZEN DER AUSWÜCHSE BRENNEN WIE FEUER."
#: AllTexts/3Map_texts.amb/315/008.txt
msgctxt "AllTexts/3Map_texts.amb/315/008"
msgid "AS SOON AS YOU GET CLOSE TO THE STRANGE PLANT, ITS TENTACLES SHOOT OUT TOWARDS YOU. THE TIPS OF ITS BRANCHES BURN LIKE FIRE."
msgstr "GDY TYLKO ZBLIŻYSZ SIĘ DO DZIWNEJ ROŚLINY, JEJ MACKI STRZELAJĄ W TWOJĄ STRONĘ. KOŃCÓWKI JEJ GAŁĘZI PŁONĄ JAK OGIEŃ."

#. Text 010 of map 315.
#. German: "VOR EUCH RAGEN WÄNDE AUS MASSIVEM HARTHOLZ IN DIE HÖHE. DAS SCHWERE STADTTOR WIRD AUF EUER RUFEN HIN GEÖFFNET."
#: AllTexts/3Map_texts.amb/315/010.txt
msgctxt "AllTexts/3Map_texts.amb/315/010"
msgid "WALLS OF SOLID HARDWOOD TOWER OVER YOU. WHEN YOU SHOUT, THE HEAVY TOWN GATES OPEN."
msgstr "ŚCIANY Z LITEGO DREWNA GÓRUJĄ NAD TOBĄ. KIEDY KRZYCZYSZ, CIĘŻKIE BRAMY MIASTA OTWIERAJĄ SIĘ."

#. Text 011 of map 315.
#. German: "KAUM NÄHERT IHR EUCH DEN SCHWEREN HOLZTOREN DER STADT, DA WERDEN DIESE AUCH SCHON AUFGERISSEN, UND EINE MENGE VON AUFGEREGTEN ZWERGEN STRÖMT EUCH ENTGEGEN. EURE LANDUNG IST D I E SENSATION!^ MAN GELEITET EUCH INS INNERE DER STADT..."
#: AllTexts/3Map_texts.amb/315/011.txt
msgctxt "AllTexts/3Map_texts.amb/315/011"
msgid "AS YOU APPROACH THE SOLID WOODEN TOWN GATES, THEY ARE THROWN OPEN AND A GROUP OF EXCITED DWARVES RUNS TOWARDS YOU. YOUR ARRIVAL IS A SENSATION!^ THEY ACCOMPANY YOU INTO THE TOWN ..."
msgstr "GDY ZBLIŻASZ SIĘ DO SOLIDNYCH DREWNIANYCH BRAM MIASTA, ZOSTAJĄ ONE OTWARTE, A GRUPA PODEKSCYTOWANYCH KRASNOLUDÓW BIEGNIE W TWOJĄ STRONĘ. TWOJE PRZYBYCIE JEST SENSACJĄ! ^ TOWARZYSZĄ CI W WEJŚCIU DO MIASTA ..."

#. Text 012 of map 315.
#. German: "ALS IHR ZUM ERSTEN MAL EINEN FUß AUF DIE GRÜNE WELT SETZT, PASSIERT ETWAS SEHR MERKWÜRDIGES: EIN BÄRTIGER, ZWEI METER GROßER DÄMON ERSCHEINT IN EINER RAUCHWOLKE UND STÜRZT SICH WUTENTBRANNT AUF EUREN HEXENBESEN! ER WIRFT EINEN VERÄCHTLICHEN BLICK AUF DAS TRANSPORTMITTEL, BEVOR ER DEN BESEN WIEDER UND WIEDER IN KLEINSTE STÜCKE ZERBRICHT. MIT EINEM ZUFRIEDENEN GRINSEN AUF DEM GESICHT VERSCHWINDET DER SELTSAME DÄMON. DER HEXENBESEN IST NUR NOCH EIN HÄUFCHEN HOLZSPLITTER."
#: AllTexts/3Map_texts.amb/315/012.txt
msgctxt "AllTexts/3Map_texts.amb/315/012"
msgid "AS YOU SET FOOT ON THE GREEN WORLD FOR THE FIRST TIME, SOMETHING VERY STRANGE HAPPENS: A RED-BEARDED DEMON, NINE FEET TALL, APPEARS IN A CLOUD OF SMOKE AND THROWS HIMSELF IN A RAGE ON YOUR BROOMSTICK! HE LOOKS AT IT IN DISGUST AND THEN SMASHES IT INTO TINY PIECES. WITH A SATISFIED GRIN ON HIS FACE THE STRANGE DEMON DISAPPEARS. THE BROOMSTICK IS JUST A PILE OF SPLINTERS. ␀ "
msgstr "KIEDY PO RAZ PIERWSZY STAWIASZ STOPĘ NA ZIELONYM ŚWIECIE, DZIEJE SIĘ COŚ BARDZO DZIWNEGO: CZERWONOBRODY DEMON O WZROŚCIE DZIEWIĘCIU STÓP POJAWIA SIĘ W CHMURZE DYMU I RZUCA SIĘ Z WŚCIEKŁOŚCIĄ NA TWOJĄ MIOTŁĘ! PATRZY NA NIĄ Z OBRZYDZENIEM, A NASTĘPNIE ROZBIJA JĄ NA DROBNE KAWAŁKI. Z ZADOWOLONYM UŚMIECHEM NA TWARZY DZIWNY DEMON ZNIKA. Z MIOTŁY ZOSTAJE TYLKO KUPKA DRZAZG.    "

#. Text 000 of map 316. The name of the map.
#. German: "KIRE'S MOND"
#: AllTexts/3Map_texts.amb/316/000.txt
msgctxt "AllTexts/3Map_texts.amb/316/000"
msgid "KIRE'S MOON"
msgstr "KSIĘŻYC KIRE"

#. Text 001 of map 316.
#. German: "DANK ASRUB'S BESCHREIBUNG WERDET IHR AUF EIN AROMATISCH RIECHENDES KRAUT AUFMERKSAM."
#: AllTexts/3Map_texts.amb/316/001.txt
msgctxt "AllTexts/3Map_texts.amb/316/001"
msgid "THANKS TO ASRUB'S DESCRIPTION, YOU ARE ON THE LOOK-OUT FOR AN AROMATIC HERB."
msgstr "DZIĘKI OPISOWI ASRUBA JESTEŚ NA TROPIE AROMATYCZNEGO ZIOŁA."

#. Text 002 of map 316.
#. German: "DIESE LEUCHTENDEN BLÜTEN SIND VON ASRUB ALS SEHR WIRKUNGSVOLL BESCHRIEBEN WORDEN."
#: AllTexts/3Map_texts.amb/316/002.txt
msgctxt "AllTexts/3Map_texts.amb/316/002"
msgid "THESE BRIGHT FLOWERS WERE DESCRIBED BY ASRUB AS BEING VERY EFFECTIVE."
msgstr "TE JASNE KWIATY ZOSTAŁY OPISANE PRZEZ ASRUBA JAKO BARDZO SKUTECZNE."

#. Text 003 of map 316.
#. German: "EINIGE LÄNGLICHE BLÄTTER WACHSEN HIER. ASRUB ERWÄHNTE SIE ALS WERTVOLL."
#: AllTexts/3Map_texts.amb/316/003.txt
msgctxt "AllTexts/3Map_texts.amb/316/003"
msgid "THERE ARE SOME LONG THIN LEAVES GROWING HERE. ASRUB SAID THEY ARE VALUABLE."
msgstr "ROSNĄ TU DŁUGIE, CIENKIE LIŚCIE. ASRUB POWIEDZIAŁ, ŻE SĄ CENNE."

#. Text 004 of map 316.
#. German: "IHR ERINNERT EUCH AN DIE WORTE VON ASRUB. DIESE BLAUEN HALME KAMEN IN SEINER LEKTION ÜBER BESONDERE KRÄUTER VOR."
#: AllTexts/3Map_texts.amb/316/004.txt
msgctxt "AllTexts/3Map_texts.amb/316/004"
msgid "YOU REMEMBER ASRUB'S WORDS. THESE BLUE STALKS WERE MENTIONED IN HIS LESSON ABOUT SPECIAL HERBS."
msgstr "PAMIĘTASZ SŁOWA ASRUBA. TE NIEBIESKIE ŁODYGI ZOSTAŁY WSPOMNIANE W JEGO LEKCJI O SPECJALNYCH ZIOŁACH."

#. Text 005 of map 316.
#. German: "EINIGE KLEINE PILZE FALLEN EUCH DURCH IHR INTENSIVES GLÄNZEN AUF. ASRUB ÄUßERTE SICH IN SEINER LEKTION SEHR POSITIV ÜBER SIE."
#: AllTexts/3Map_texts.amb/316/005.txt
msgctxt "AllTexts/3Map_texts.amb/316/005"
msgid "YOU NOTICE A FEW SMALL MUSHROOMS BECAUSE THEY ARE GLOWING BRIGHTLY. ASRUB SPOKE VERY ENTHUSIASTICALLY ABOUT THEM IN HIS LESSON."
msgstr "ZAUWAŻASZ KILKA MAŁYCH GRZYBÓW, PONIEWAŻ ŚWIECĄ ONE JASNO. ASRUB MÓWIŁ O NICH BARDZO ENTUZJASTYCZNIE NA SWOJEJ LEKCJI."

