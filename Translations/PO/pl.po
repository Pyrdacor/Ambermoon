#. Extro text. Lines must not be much longer than the English ones. A leading _ is the large font, $ and $$ mark the translator lines.
#: ExtroTexts/000/000/000.txt
msgctxt "ExtroTexts/000/000/000"
msgid "Rocks fall from the ceiling, crashing on the"
msgstr "Skały spadają z sufitu, rozbijając się o"

#. Extro text. Lines must not be much longer than the English ones. A leading _ is the large font, $ and $$ mark the translator lines.
#: ExtroTexts/000/000/001.txt
msgctxt "ExtroTexts/000/000/001"
msgid "floor around you, as you run from the"
msgstr "podłogę wokół ciebie, gdy wybiegasz z"

#. Extro text. Lines must not be much longer than the English ones. A leading _ is the large font, $ and $$ mark the translator lines.
#: ExtroTexts/000/000/002.txt
msgctxt "ExtroTexts/000/000/002"
msgid "machine room and up the stairway leading"
msgstr "maszynowni i po schodach prowadzących"

#. Extro text. Lines must not be much longer than the English ones. A leading _ is the large font, $ and $$ mark the translator lines.
#: ExtroTexts/000/000/003.txt
msgctxt "ExtroTexts/000/000/003"
msgid "to the surface."
msgstr "na powierzchnię."

#. Extro text. Lines must not be much longer than the English ones. A leading _ is the large font, $ and $$ mark the translator lines.
#: ExtroTexts/000/001/000.txt
msgctxt "ExtroTexts/000/001/000"
msgid "Everyone manages to escape the inferno"
msgstr "zniszczonej maszyny."

#. Extro text. Lines must not be much longer than the English ones. A leading _ is the large font, $ and $$ mark the translator lines.
#: ExtroTexts/000/001/001.txt
msgctxt "ExtroTexts/000/001/001"
msgid "caused by the escaping energy of the"
msgstr "Wszystkim udaje się uciec z piekła"

#. Extro text. Lines must not be much longer than the English ones. A leading _ is the large font, $ and $$ mark the translator lines.
#: ExtroTexts/000/001/002.txt
msgctxt "ExtroTexts/000/001/002"
msgid "destroyed machine."
msgstr "spowodowanego przez uciekającą energię"

#. Extro text. Lines must not be much longer than the English ones. A leading _ is the large font, $ and $$ mark the translator lines.
#: ExtroTexts/000/002/000.txt
msgctxt "ExtroTexts/000/002/000"
msgid "The explosions grow stronger and stronger"
msgstr "aż cała wyspa się trzęsie."

#. Extro text. Lines must not be much longer than the English ones. A leading _ is the large font, $ and $$ mark the translator lines.
#: ExtroTexts/000/002/001.txt
msgctxt "ExtroTexts/000/002/001"
msgid "until the entire island is shaking."
msgstr "Eksplozje stają się coraz silniejsze"

#. Extro text. Lines must not be much longer than the English ones. A leading _ is the large font, $ and $$ mark the translator lines.
#: ExtroTexts/000/003/000.txt
msgctxt "ExtroTexts/000/003/000"
msgid "You decide to call a giant eagle so that you"
msgstr "tak szybko, jak to możliwe."

#. Extro text. Lines must not be much longer than the English ones. A leading _ is the large font, $ and $$ mark the translator lines.
#: ExtroTexts/000/003/001.txt
msgctxt "ExtroTexts/000/003/001"
msgid "can leave the Temple of the Brotherhood as"
msgstr "Postanawiasz wezwać gigantycznego orła,"

#. Extro text. Lines must not be much longer than the English ones. A leading _ is the large font, $ and $$ mark the translator lines.
#: ExtroTexts/000/003/002.txt
msgctxt "ExtroTexts/000/003/002"
msgid "quickly as possible."
msgstr "aby opuścić Świątynię Bractwa"

#. Extro text. Lines must not be much longer than the English ones. A leading _ is the large font, $ and $$ mark the translator lines.
#: ExtroTexts/000/004/000.txt
msgctxt "ExtroTexts/000/004/000"
msgid "The eagle's mighty wings have hardly"
msgstr "Potężne skrzydła orła ledwie cię"

#. Extro text. Lines must not be much longer than the English ones. A leading _ is the large font, $ and $$ mark the translator lines.
#: ExtroTexts/000/004/001.txt
msgctxt "ExtroTexts/000/004/001"
msgid "carried you up when half of the temple"
msgstr "uniosły cię w górę, gdy połowa świątyni"

#. Extro text. Lines must not be much longer than the English ones. A leading _ is the large font, $ and $$ mark the translator lines.
#: ExtroTexts/000/004/002.txt
msgctxt "ExtroTexts/000/004/002"
msgid "is torn apart by a huge detonation!"
msgstr "zostaje rozerwana przez ogromną detonację!"

#. Extro text. Lines must not be much longer than the English ones. A leading _ is the large font, $ and $$ mark the translator lines.
#: ExtroTexts/000/004/003.txt
msgctxt "ExtroTexts/000/004/003"
msgid "All of you hold your breath as the airship-"
msgstr "Wszyscy wstrzymują oddech, gdy hangar"

#. Extro text. Lines must not be much longer than the English ones. A leading _ is the large font, $ and $$ mark the translator lines.
#: ExtroTexts/000/004/004.txt
msgctxt "ExtroTexts/000/004/004"
msgid "hangar trembles and slides into the earth."
msgstr "sterowca drży i osuwa się na ziemię."

#. Extro text. Lines must not be much longer than the English ones. A leading _ is the large font, $ and $$ mark the translator lines.
#: ExtroTexts/000/005/000.txt
msgctxt "ExtroTexts/000/005/000"
msgid "But then the destructive energies of the"
msgstr "Ale potem niszczycielska energia maszyny"

#. Extro text. Lines must not be much longer than the English ones. A leading _ is the large font, $ and $$ mark the translator lines.
#: ExtroTexts/000/005/001.txt
msgctxt "ExtroTexts/000/005/001"
msgid "Morag machine dwindle and peace returns."
msgstr "Morag słabnie i powraca spokój."

#. Extro text. Lines must not be much longer than the English ones. A leading _ is the large font, $ and $$ mark the translator lines.
#: ExtroTexts/000/005/002.txt
msgctxt "ExtroTexts/000/005/002"
msgid "Oily smoke rises from the subterranean"
msgstr "Oleisty dym unosi się z podziemnego"

#. Extro text. Lines must not be much longer than the English ones. A leading _ is the large font, $ and $$ mark the translator lines.
#: ExtroTexts/000/005/003.txt
msgctxt "ExtroTexts/000/005/003"
msgid "temple complex."
msgstr "kompleksu świątynnego."

#. Extro text. Lines must not be much longer than the English ones. A leading _ is the large font, $ and $$ mark the translator lines.
#: ExtroTexts/000/006/000.txt
msgctxt "ExtroTexts/000/006/000"
msgid "The airship is slightly tilted, but unharmed!"
msgstr "Sterowiec jest lekko przechylony, ale bez uszkodzeń!"

#. Extro text. Lines must not be much longer than the English ones. A leading _ is the large font, $ and $$ mark the translator lines.
#: ExtroTexts/000/007/000.txt
