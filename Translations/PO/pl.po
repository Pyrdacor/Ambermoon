#. Extro text. Lines must not be much longer than the English ones. A leading _ is the large font, $ and $$ mark the translator lines.
#: ExtroTexts/001/000/000.txt
msgctxt "ExtroTexts/001/000/000"
msgid "The spectacular end of the Brotherhood of"
msgstr "Spektakularny koniec Bractwa"

#. Extro text. Lines must not be much longer than the English ones. A leading _ is the large font, $ and $$ mark the translator lines.
#: ExtroTexts/001/000/001.txt
msgctxt "ExtroTexts/001/000/001"
msgid "Tarbos quickly attracts the attention of the"
msgstr "Tarbos szybko przyciągnął uwagę"

#. Extro text. Lines must not be much longer than the English ones. A leading _ is the large font, $ and $$ mark the translator lines.
#: ExtroTexts/001/000/002.txt
msgctxt "ExtroTexts/001/000/002"
msgid "leaders of both humans and elves."
msgstr "przywódców ludzi i elfów."

#. Extro text. Lines must not be much longer than the English ones. A leading _ is the large font, $ and $$ mark the translator lines.
