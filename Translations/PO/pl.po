msgstr "{0} zadał {1} punktów obrażeń!"

#. User interface: FormatMessages.
#. German: "Jeder bekommt {0} Erfahrungspunkte."
#: AllTexts/Text.amb/FormatMessages/021.txt
msgctxt "AllTexts/Text.amb/FormatMessages/021"
msgid "Everyone receives {0} experience points."
msgstr "Każdy otrzymuje {0} punktów doświadczenia."

#. User interface: FormatMessages.
#. German: "{0} zaubert den {1} - Spruch!"
#: AllTexts/Text.amb/FormatMessages/022.txt
msgctxt "AllTexts/Text.amb/FormatMessages/022"
msgid "{0} casts the {1} - spell!"
msgstr "{0} rzuca zaklęcie {1}!"

#. User interface: FormatMessages.
#. German: "{0} beschwört den {1} - Zauber aus {2}!"
#: AllTexts/Text.amb/FormatMessages/023.txt
msgctxt "AllTexts/Text.amb/FormatMessages/023"
msgid "{0} casts the {1} - spell from the {2}!"
msgstr "{0} rzuca zaklęcie {1} - z {2}!"

#. User interface: FormatMessages.
#. German: "{0} ist nicht die richtige Antwort."
#: AllTexts/Text.amb/FormatMessages/024.txt
msgctxt "AllTexts/Text.amb/FormatMessages/024"
msgid "{0} is not the right answer."
msgstr "{0} nie jest właściwą odpowiedzią."

#. User interface: FormatMessages.
#. German: "Das"
#: AllTexts/Text.amb/FormatMessages/025.txt
msgctxt "AllTexts/Text.amb/FormatMessages/025"
