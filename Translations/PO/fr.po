#. Dialogue of party member 002 (NETSRAK).
#. German: "DU SIEHST EINEN MÄCHTIGEN SCHWARZMAGIER."
#: AllTexts/Party_texts.amb/002/000.txt
msgctxt "AllTexts/Party_texts.amb/002/000"
msgid "YOU SEE A POWERFUL BLACK MAGICIAN."
msgstr "VOUS APERCEVEZ UN PUISSANT MAGICIEN NOIR."

#. Dialogue of party member 002 (NETSRAK).
#. German: "HALLO!^ ICH BIN DIE FIGUR VON KARSTEN KÖPER, DEM DESIGNER VON AMBERMOON."
#: AllTexts/Party_texts.amb/002/001.txt
msgctxt "AllTexts/Party_texts.amb/002/001"
msgid "HELLO!^ I AM THE FIGURE OF KARSTEN KOEPER, THE DESIGNER OF AMBERMOON."
msgstr "BONJOUR!^ JE SUIS LE PERSONNAGE DE KARSTEN KOEPER, LE CREATEUR D'AMBERMOON."

#. Dialogue of party member 002 (NETSRAK).
#. German: "ES WAR NETT MIT DIR ZU SPRECHEN."
#: AllTexts/Party_texts.amb/002/002.txt
msgctxt "AllTexts/Party_texts.amb/002/002"
msgid "IT WAS NICE TO SPEAK TO YOU."
msgstr "C'ETAIT SYMPA DE DISCUTER AVEC VOUS."

#. Dialogue of party member 002 (NETSRAK).
#. German: "ES IST MIR EINE GROßE EHRE, DICH IN DEINEM ABENTEUER ZU BEGLEITEN."
#: AllTexts/Party_texts.amb/002/003.txt
msgctxt "AllTexts/Party_texts.amb/002/003"
msgid "IT IS A GREAT HONOUR FOR ME TO ACCOMPANY YOU IN YOUR ADVENTURE."
msgstr "C'EST UN GRAND HONNEUR POUR MOI DE VOUS ACCOMPAGNER DANS VOTRE AVENTURE."

#. Dialogue of party member 002 (NETSRAK).
#. German: "SCHADE DAS ICH DIE GRUPPE VERLASSEN MUSS!^ FALLS DU MICH SUCHST, DANN FINDEST DU MICH IM THALION BÜRO."
#: AllTexts/Party_texts.amb/002/004.txt
msgctxt "AllTexts/Party_texts.amb/002/004"
msgid "IT'S A SHAME THAT I MUST LEAVE THE GROUP!^. IF YOU NEED ME, YOU WILL FIND ME IN THE THALION OFFICE."
msgstr "C'EST DOMMAGE QU'IL FAILLE QUE JE QUITTE LE GROUPE!^. SI VOUS AVEZ BESOIN DE MOI, VOUS POURREZ ME TROUVER AU BUREAU THALION."

#. Dialogue of party member 003 (MANDO).
#. German: "DU SIEHST EINEN FLINKEN DIEB."
#: AllTexts/Party_texts.amb/003/000.txt
msgctxt "AllTexts/Party_texts.amb/003/000"
msgid "YOU SEE A HANDSOME THIEF, OBVIOUSLY OF ENORMOUS SKILL."
msgstr "VOUS APERCEVEZ UN VOLEUR HORS PAIR, DOTE MANIFESTEMENT D'UN TALENT HORS NORME."

#. Dialogue of party member 003 (MANDO).
#. German: "HALLO!^ ICH BIN DIE FIGUR VON JURIE HORNEMAN, DEM PROGRAMMIERER VON AMBERMOON."
#: AllTexts/Party_texts.amb/003/001.txt
msgctxt "AllTexts/Party_texts.amb/003/001"
msgid "HELLO!^ I AM THE FIGURE OF JURIE HORNEMAN, THE PROGRAMMER OF AMBERMOON."
msgstr "BONJOUR!^ JE SUIS LE PERSONNAGE DE JURIE HORNEMAN, LE PROGRAMMEUR D'AMBERMOON."

#. Dialogue of party member 003 (MANDO).
#. German: "ES WAR NETT MIT DIR ZU SPRECHEN."
#: AllTexts/Party_texts.amb/003/002.txt
msgctxt "AllTexts/Party_texts.amb/003/002"
msgid "IT WAS NICE TO SPEAK WITH YOU."
msgstr "C'ETAIT SYMPA DE PARLER AVEC VOUS."

#. Dialogue of party member 003 (MANDO).
#. German: "ES IST MIR EINE GROßE EHRE, DICH IN DEINEM ABENTEUER ZU BEGLEITEN."
#: AllTexts/Party_texts.amb/003/003.txt
msgctxt "AllTexts/Party_texts.amb/003/003"
msgid "IT IS A GREAT HONOUR FOR ME TO ACCOMPANY YOU IN YOUR ADVENTURE."
msgstr "C'EST UN GRAND HONNEUR POUR MOI DE VOUS ACCOMPAGNER DANS VOTRE AVENTURE."

#. Dialogue of party member 003 (MANDO).
#. German: "SCHADE DAS ICH DIE GRUPPE VERLASSEN MUSS!^ FALLS DU MICH SUCHST, DANN FINDEST DU MICH IM THALION BÜRO."
#: AllTexts/Party_texts.amb/003/004.txt
msgctxt "AllTexts/Party_texts.amb/003/004"
msgid "WHAT?! YOU DARE TO SUGGEST THAT I LEAVE? VERY WELL, BUT DON'T COME CRAWLING BACK WHEN THE GOING GETS TOUGH!"
msgstr "QUOI?! VOUS OSEZ ME DEMANDER DE PARTIR? TRES BIEN, MAIS NE VENEZ PAS PLEURER EN RAMPANT QUAND CA COMMENCERA A CHAUFFER!"

#. Dialogue of party member 004 (ERIK).
#. German: "DU SIEHST EINEN KRÄFTIGEN ZWERGENKRIEGER."
#: AllTexts/Party_texts.amb/004/000.txt
msgctxt "AllTexts/Party_texts.amb/004/000"
