msgid "Elf"
msgstr "Elfe"

#. User interface: LanguageNames.
#. German: "Zwergisch"
#: AllTexts/Text.amb/LanguageNames/002.txt
msgctxt "AllTexts/Text.amb/LanguageNames/002"
msgid "Dwarvish"
msgstr "Nanique"

#. User interface: LanguageNames.
