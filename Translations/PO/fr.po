msgctxt "AllTexts/3Map_texts.amb/327/007"
msgid "SUDDENLY LOTS OF HUNGRY BOG-DWELLERS CLAMBER OUT OF THE SLUDGY GROUND."
msgstr "SOUDAIN TOUT UN TAS D'INSECTES DES MARAIS AFFAMES SORTENT DU SOL VASEUX."

#. Text 008 of map 327.
#. German: "SOBALD IHR DER SELTSAMEN PFLANZE NAHEKOMMT, PEITSCHEN IHRE TENTAKEL AUF EUCH EIN. DIE SPITZEN DER AUSWÜCHSE BRENNEN WIE FEUER."
#: AllTexts/3Map_texts.amb/327/008.txt
msgctxt "AllTexts/3Map_texts.amb/327/008"
msgid "AS SOON AS YOU GET CLOSE TO THE STRANGE PLANT, ITS TENTACLES SHOOT OUT TOWARDS YOU. THE TIPS OF ITS BRANCHES BURN LIKE FIRE."
msgstr "DES QUE VOUS APPROCHEZ L'ETRANGE PLANTE, SES TENTACULES FONDENT A TOUTE VITESSE SUR VOUS. LES EXTREMITES DE SES BRANCHES BRULENT COMME LE FEU."

