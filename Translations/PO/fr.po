msgid "Morag"
msgstr "Moranien"

#. User interface: LanguageNames.
#. German: "Tiersprache"
#: AllTexts/Text.amb/LanguageNames/007.txt
msgctxt "AllTexts/Text.amb/LanguageNames/007"
msgid "Animal"
msgstr "Animal"

#. User interface: Messages.
#. German: "Darüber weiss ich nichts besonderes zu erzählen."
#: AllTexts/Text.amb/Messages/000.txt
msgctxt "AllTexts/Text.amb/Messages/000"
msgid "I don't know what you are talking about."
msgstr "Je ne sais pas de quoi vous parlez."

#. User interface: Messages.
#. German: "Das Betriebsystem hat keinen Speicher zur Verfügung."
#: AllTexts/Text.amb/Messages/001.txt
msgctxt "AllTexts/Text.amb/Messages/001"
msgid "The OS has run out of memory."
msgstr "L'OS est a court de memoire."

#. User interface: Messages.
#. German: "Datei wird bereits benutzt."
#: AllTexts/Text.amb/Messages/002.txt
msgctxt "AllTexts/Text.amb/Messages/002"
msgid "File is in use."
msgstr "Le fichier est utilise."

#. User interface: Messages.
#. German: "Datei existiert bereits."
#: AllTexts/Text.amb/Messages/003.txt
msgctxt "AllTexts/Text.amb/Messages/003"
msgid "File already exists."
msgstr "Le fichier existe deja."

#. User interface: Messages.
#. German: "Verzeichnis nicht gefunden."
#: AllTexts/Text.amb/Messages/004.txt
msgctxt "AllTexts/Text.amb/Messages/004"
msgid "Directory not found."
msgstr "Repertoire non trouve."

#. User interface: Messages.
#. German: "Datei nicht gefunden."
#: AllTexts/Text.amb/Messages/005.txt
msgctxt "AllTexts/Text.amb/Messages/005"
msgid "File not found."
msgstr "Fichier non trouve."

#. User interface: Messages.
#. German: "Datei zu groß."
#: AllTexts/Text.amb/Messages/006.txt
msgctxt "AllTexts/Text.amb/Messages/006"
msgid "File too large."
msgstr "Fichier trop gros."

#. User interface: Messages.
#. German: "Ungültiger Dateiname."
#: AllTexts/Text.amb/Messages/007.txt
msgctxt "AllTexts/Text.amb/Messages/007"
msgid "Invalid filename."
msgstr "Nom de fichier invalide."

#. User interface: Messages.
#. German: "Objekt hat nicht den erforderlichen Typus."
#: AllTexts/Text.amb/Messages/008.txt
msgctxt "AllTexts/Text.amb/Messages/008"
msgid "Object not of required type."
msgstr "Objet non coforme au type demande."

#. User interface: Messages.
#. German: "Datenträger ist nicht validiert."
#: AllTexts/Text.amb/Messages/009.txt
msgctxt "AllTexts/Text.amb/Messages/009"
msgid "Disk is not validated."
msgstr "Le disque n'est pas valide."

#. User interface: Messages.
#. German: "Seek - Fehler."
#: AllTexts/Text.amb/Messages/011.txt
msgctxt "AllTexts/Text.amb/Messages/011"
msgid "Seek error."
msgstr "Erreur lors de la recherche."

#. User interface: Messages.
#. German: "Datenträger ist voll."
#: AllTexts/Text.amb/Messages/012.txt
msgctxt "AllTexts/Text.amb/Messages/012"
msgid "Disk is full."
msgstr "Le disque est plein."

#. User interface: Messages.
#. German: "Unvollständiger Lesevorgang."
#: AllTexts/Text.amb/Messages/013.txt
msgctxt "AllTexts/Text.amb/Messages/013"
msgid "Incomplete read."
msgstr "Lecture incomplete."

#. User interface: Messages.
#. German: "Datei ist schreibgeschützt."
#: AllTexts/Text.amb/Messages/014.txt
msgctxt "AllTexts/Text.amb/Messages/014"
msgid "File is protected from writing."
msgstr "Le fichier est protege en ecriture."

#. User interface: Messages.
#. German: "Datei ist lesegeschützt."
#: AllTexts/Text.amb/Messages/015.txt
msgctxt "AllTexts/Text.amb/Messages/015"
msgid "File is protected from reading."
msgstr "Le fichier est protege en lecture."

#. User interface: Messages.
#. German: "Keine DOS-Disk."
#: AllTexts/Text.amb/Messages/016.txt
msgctxt "AllTexts/Text.amb/Messages/016"
msgid "Not a DOS disk."
msgstr "Ce n'est pas un disque DOS."

#. User interface: Messages.
#. German: "Unvollständiger Schreibvorgang."
#: AllTexts/Text.amb/Messages/017.txt
msgctxt "AllTexts/Text.amb/Messages/017"
msgid "Incomplete write."
msgstr "Ecriture incomplete."

#. User interface: Messages.
#. German: "Geben Sie die Kampfpositionen für Ihre Gruppenmitglieder vor."
#: AllTexts/Text.amb/Messages/018.txt
msgctxt "AllTexts/Text.amb/Messages/018"
msgid "Enter the battle positions for your party members."
msgstr "Entrez les positions de combat des membres de votre groupe."

#. User interface: Messages.
#. German: "Welche Spruchrolle soll gelesen werden?"
#: AllTexts/Text.amb/Messages/019.txt
msgctxt "AllTexts/Text.amb/Messages/019"
msgid "Which scroll do you want to read?"
msgstr "Quel parchemin voulez-vous lire?"

#. User interface: Messages.
#. German: "Dies ist keine Spruchrolle!"
#: AllTexts/Text.amb/Messages/020.txt
msgctxt "AllTexts/Text.amb/Messages/020"
msgid "That's not a spell-scroll!"
msgstr "Ce n'est pas un parchemin de sort!"

#. User interface: Messages.
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "~LEAD~ kann Zaubersprüche dieser Klasse nicht lernen."
#: AllTexts/Text.amb/Messages/021.txt
msgctxt "AllTexts/Text.amb/Messages/021"
msgid "~LEAD~ can't learn spells of this spell class."
msgstr "~LEAD~ ne peut pas apprendre les sorts de cette classe de sorts."

#. User interface: Messages.
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "~LEAD~ schafft es, den Zauber zu lernen. Die Spruchrolle zerfällt zu Staub."
#: AllTexts/Text.amb/Messages/022.txt
msgctxt "AllTexts/Text.amb/Messages/022"
msgid "~LEAD~ manages to learn the spell. The scroll crumbles to dust."
msgstr "~LEAD~ a reussi a apprendre le sort. Le parchemin tombe en poussiere."

#. User interface: Messages.
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "~LEAD~'s Versuch, den Zauberspruch zu lernen, schlägt fehl. Die Spruchrolle löst sich auf."
#: AllTexts/Text.amb/Messages/023.txt
msgctxt "AllTexts/Text.amb/Messages/023"
msgid "~LEAD~ is unable to understand the spell. The scroll disintegrates."
msgstr "~LEAD~ est incapable d'apprendre le sort. Le parchemin se desintegre."

#. User interface: Messages.
#. German: "Die Gruppe ruht 8 Stunden."
#: AllTexts/Text.amb/Messages/024.txt
msgctxt "AllTexts/Text.amb/Messages/024"
msgid "The party rests for eight hours."
msgstr "Le groupe se repose pendant huit heures."

#. User interface: Messages.
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "~LEAD~ hat nicht genug Lernpunkte, um diesen Spruch zu lernen."
#: AllTexts/Text.amb/Messages/025.txt
msgctxt "AllTexts/Text.amb/Messages/025"
msgid "~LEAD~ does not have enough learning points to learn this spell."
msgstr "~LEAD~ ne possede pas assez de points d'apprentissage pour apprendre ce sort."

#. User interface: Messages.
#. German: "Zu wenig SP!"
#: AllTexts/Text.amb/Messages/026.txt
msgctxt "AllTexts/Text.amb/Messages/026"
msgid "Not enough SP!"
msgstr "PS insuffisants!"

#. User interface: Messages.
#. German: "Falsches Einsatzgebiet!"
#: AllTexts/Text.amb/Messages/027.txt
msgctxt "AllTexts/Text.amb/Messages/027"
msgid "Wrong area!"
msgstr "Mauvais endroit!"

#. User interface: Messages.
#. German: "Welchen Gegenstand wegwerfen?"
#: AllTexts/Text.amb/Messages/028.txt
msgctxt "AllTexts/Text.amb/Messages/028"
msgid "Which item do you want to drop?"
msgstr "Quel objet voulez-vous jeter?"

#. User interface: Messages.
#. German: "Dieser Gegenstand ist wichtig!"
#: AllTexts/Text.amb/Messages/029.txt
msgctxt "AllTexts/Text.amb/Messages/029"
msgid "You'll need this item!"
msgstr "Vous aurez besoin de cet objet!"

#. User interface: Messages.
#. German: "Welchen Gegenstand benutzen?"
#: AllTexts/Text.amb/Messages/030.txt
msgctxt "AllTexts/Text.amb/Messages/030"
msgid "Which item do you want to use?"
msgstr "Quel objet voulez-vous utiliser?"

#. User interface: Messages.
#. German: "Welchen Gegenstand untersuchen?"
#: AllTexts/Text.amb/Messages/031.txt
msgctxt "AllTexts/Text.amb/Messages/031"
msgid "Which item do you want to examine?"
msgstr "Quel objet voulez-vous examiner?"

#. User interface: Messages.
#. German: "Wieviel Gold soll weg?"
#: AllTexts/Text.amb/Messages/032.txt
msgctxt "AllTexts/Text.amb/Messages/032"
msgid "Drop how much gold?"
msgstr "En jeter combien?"

#. User interface: Messages.
#. German: "Wieviel Nahrung weg?"
#: AllTexts/Text.amb/Messages/033.txt
msgctxt "AllTexts/Text.amb/Messages/033"
msgid "Drop how much food?"
msgstr "En jeter combien?"

#. User interface: Messages.
#. German: "Kann nicht bereit gemacht werden."
#: AllTexts/Text.amb/Messages/034.txt
msgctxt "AllTexts/Text.amb/Messages/034"
msgid "This cannot be equipped."
msgstr "Ceci ne peut pas etre utilise."

#. User interface: Messages.
#. Placeholders: ~INVN~ = the party member whose inventory is open. The gender of these persons is unknown.
#. German: "~INVN~ hat dafür die falsche Klasse!"
#: AllTexts/Text.amb/Messages/035.txt
msgctxt "AllTexts/Text.amb/Messages/035"
msgid "~INVN~ has the wrong class to equip this item."
msgstr "~INVN~ n'a pas la classe requise pour faire usage de cet objet."

#. User interface: Messages.
#. Placeholders: ~INVN~ = the party member whose inventory is open. The gender of these persons is unknown.
#. German: "~INVN~ hat dafür das falsche Geschlecht!"
#: AllTexts/Text.amb/Messages/036.txt
msgctxt "AllTexts/Text.amb/Messages/036"
msgid "~INVN~ is of the wrong sex to use this item."
msgstr "~INVN~ n'est pas du genre requis pour pouvoir utiliser cet objet."

#. User interface: Messages.
#. Placeholders: ~INVN~ = the party member whose inventory is open. The gender of these persons is unknown.
#. German: "~INVN~ hat nicht genug Hände frei."
#: AllTexts/Text.amb/Messages/037.txt
msgctxt "AllTexts/Text.amb/Messages/037"
msgid "~INVN~ does not have enough hands free."
msgstr "~INVN~ n'a plus assez de mains libres."

#. User interface: Messages.
#. Placeholders: ~INVN~ = the party member whose inventory is open. The gender of these persons is unknown.
#. German: "~INVN~ hat nicht genug Finger frei."
#: AllTexts/Text.amb/Messages/038.txt
msgctxt "AllTexts/Text.amb/Messages/038"
msgid "~INVN~ does not have enough ring-fingers free."
msgstr "~INVN~ n'a plus assez de doigts libres."

#. User interface: Messages.
#. German: "Eine Rast wäre zu gefährlich: Es befindet sich ein Angreifer in der Nähe!"
#: AllTexts/Text.amb/Messages/039.txt
msgctxt "AllTexts/Text.amb/Messages/039"
msgid "Resting is too dangerous : there are monsters in the vicinity!"
msgstr "Se reposer est trop dangereux : il y a des monstres qui rodent dans les environs!"

#. User interface: Messages.
#. German: "Wieviele wegwerfen?"
#: AllTexts/Text.amb/Messages/040.txt
msgctxt "AllTexts/Text.amb/Messages/040"
msgid "Drop how many?"
msgstr "En jeter combien?"

#. User interface: Messages.
#. German: "Die magische Flugscheibe kann hier nicht benutzt werden."
#: AllTexts/Text.amb/Messages/041.txt
msgctxt "AllTexts/Text.amb/Messages/041"
msgid "You cannot use the magic disc here."
msgstr "Vous ne pouvez pas utiliser le disque magique ici."

#. User interface: Messages.
#. German: "Dieser Gegenstand ist verflucht!"
#: AllTexts/Text.amb/Messages/042.txt
msgctxt "AllTexts/Text.amb/Messages/042"
msgid "This item is cursed!"
msgstr "Cet objet est maudit!"

#. User interface: Messages.
#. German: "Dieser Gegenstand erfüllt nun einen speziellen Zweck."
#: AllTexts/Text.amb/Messages/043.txt
msgctxt "AllTexts/Text.amb/Messages/043"
msgid "This item now fulfills a special purpose."
msgstr "Cet objet possede a present un but precis."

#. User interface: Messages.
#. German: "An wen übergeben?"
#: AllTexts/Text.amb/Messages/044.txt
msgctxt "AllTexts/Text.amb/Messages/044"
msgid "Whom do you want to give it to?"
msgstr "A qui voulez-vous donner ceci?"

#. User interface: Messages.
#. German: "Nicht während des Kampfes!"
#: AllTexts/Text.amb/Messages/045.txt
msgctxt "AllTexts/Text.amb/Messages/045"
msgid "You cannot equip this in combat."
msgstr "Vous ne pouvez pas vous servir de ceci au combat."

#. User interface: Messages.
#. Placeholders: ~INVN~ = the party member whose inventory is open. The gender of these persons is unknown.
#. German: "~INVN~ bläst auf der Flöte und ein hoher, klarer Ton entsteht. Nach kurzer Zeit erscheint ein majestätischer Riesenadler und fliegt auf Euch zu."
#: AllTexts/Text.amb/Messages/046.txt
msgctxt "AllTexts/Text.amb/Messages/046"
msgid "~INVN~ blows on the flute. A high, clear tone comes out. After a short while you see a majestic giant eagle flying towards you."
msgstr "~INVN~ souffle dans la flute. Un son clair et haut perche se fait entendre. Apres un court moment vous voyez un aigle geant majestueux voler vers vous."

#. User interface: Messages.
#. German: "Wirklich wegwerfen?"
#: AllTexts/Text.amb/Messages/047.txt
msgctxt "AllTexts/Text.amb/Messages/047"
msgid "Do you really want to drop it?"
msgstr "Voulez-vous vraiment jeter ceci?"

#. User interface: Messages.
#. German: "Derselbe Gegenstand ist schon in Gebrauch."
#: AllTexts/Text.amb/Messages/048.txt
msgctxt "AllTexts/Text.amb/Messages/048"
msgid "The same item is already in use."
msgstr "Le meme objet est deja utilise."

#. User interface: Messages.
#. German: "Das Gold wirklich wegwerfen?"
#: AllTexts/Text.amb/Messages/049.txt
msgctxt "AllTexts/Text.amb/Messages/049"
msgid "Do you really want to drop the gold?"
msgstr "Voulez-vous vraiment jeter l'or?"

#. User interface: Messages.
#. German: "Die Rationen wirklich wegwerfen?"
#: AllTexts/Text.amb/Messages/050.txt
msgctxt "AllTexts/Text.amb/Messages/050"
msgid "Do you really want to drop the food?"
msgstr "Voulez-vous vraiment jeter de la nourriture?"

#. User interface: Messages.
#. German: "Es ist dunkel. Ihr könnt den Weg zurück nicht finden."
#: AllTexts/Text.amb/Messages/051.txt
msgctxt "AllTexts/Text.amb/Messages/051"
msgid "It is dark. You are unable to find your way back."
msgstr "Il fait sombre. Vous etes incapable de retrouver votre chemin de retour."

#. User interface: Messages.
#. German: "Wieviel Gold geben?"
#: AllTexts/Text.amb/Messages/052.txt
msgctxt "AllTexts/Text.amb/Messages/052"
msgid "Give how much gold?"
msgstr "En donner combien?"

#. User interface: Messages.
#. German: "Wieviel Nahrung geben?"
#: AllTexts/Text.amb/Messages/053.txt
msgctxt "AllTexts/Text.amb/Messages/053"
msgid "Give how much food?"
msgstr "En donner combien?"

#. User interface: Messages.
#. German: "Wieviele nehmen?"
#: AllTexts/Text.amb/Messages/054.txt
msgctxt "AllTexts/Text.amb/Messages/054"
msgid "Take how many?"
msgstr "En prendre combien?"

#. User interface: Messages.
#. German: "Wohin damit?"
#: AllTexts/Text.amb/Messages/055.txt
msgctxt "AllTexts/Text.amb/Messages/055"
msgid "Where do you want to move it to?"
msgstr "Ou voulez-vous deplacer ceci?"

#. User interface: Messages.
#. German: "Nicht im Kampf entfernbar."
#: AllTexts/Text.amb/Messages/056.txt
msgctxt "AllTexts/Text.amb/Messages/056"
msgid "You cannot un-equip this in combat."
msgstr "Vous ne pouvez pas ranger ceci lors d'un combat."

#. User interface: Messages.
#. Placeholders: ~SUBJ~ = the party member the text is about; ~SEX2~ = his/her of ~SUBJ~; ~SEX1~ = he/she of ~SUBJ~. The gender of these persons is unknown.
#. German: "~SUBJ~ öffnet ~SEX2~ Augen.^~SEX1~ schaut sich um und sagt \"Schönen Dank auch!\""
#: AllTexts/Text.amb/Messages/057.txt
msgctxt "AllTexts/Text.amb/Messages/057"
msgid "~SUBJ~ opens ~SEX2~ eyes.^~SEX1~ looks up and says \"What's for dinner?\""
msgstr "~SUBJ~ ouvre ses eyes.^~SEX1~ regarde et dit \"Y a quoi a diner?\""

#. User interface: Messages.
#. German: "Hier ist eine runde Scheibe im Boden eingelassen."
#: AllTexts/Text.amb/Messages/058.txt
msgctxt "AllTexts/Text.amb/Messages/058"
msgid "You can discern a round disk in the floor."
msgstr "Vous pouvez discerner un disque rond sur le sol."

#. User interface: Messages.
#. German: "Hier ist eine Falle zu erkennen!"
#: AllTexts/Text.amb/Messages/059.txt
msgctxt "AllTexts/Text.amb/Messages/059"
msgid "You notice a trap!"
msgstr "Vous remarquez un piege!"

#. User interface: Messages.
#. German: "Programm wirklich verlassen?"
#: AllTexts/Text.amb/Messages/060.txt
msgctxt "AllTexts/Text.amb/Messages/060"
msgid "Do you really want to quit?"
msgstr "Voulez-vous vraiment quitter?"

#. User interface: Messages.
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "~LEAD~ beherrscht diesen Zauber bereits."
#: AllTexts/Text.amb/Messages/061.txt
msgctxt "AllTexts/Text.amb/Messages/061"
msgid "~LEAD~ already knows this spell."
msgstr "~LEAD~ connait deja ce sort."

#. User interface: Messages.
#. German: "Gebrochene Gegenstände sind nicht benutzbar."
#: AllTexts/Text.amb/Messages/062.txt
msgctxt "AllTexts/Text.amb/Messages/062"
msgid "You cannot use broken items."
msgstr "Vous ne pouvez pas utiliser d'objets brises."

#. User interface: Messages.
#. German: "Kann hier nicht benutzt werden."
#: AllTexts/Text.amb/Messages/063.txt
msgctxt "AllTexts/Text.amb/Messages/063"
msgid "You cannot use that here."
msgstr "Vous ne pouvez pas utiliser ca ici."

#. User interface: Messages.
#. German: "Ihr levitiert. Tolle Sache."
#: AllTexts/Text.amb/Messages/064.txt
msgctxt "AllTexts/Text.amb/Messages/064"
msgid "You levitate. Big deal."
msgstr "Vous levitez. La belle affaire."

#. User interface: Messages.
#. German: "Welche Nummer?"
#: AllTexts/Text.amb/Messages/065.txt
msgctxt "AllTexts/Text.amb/Messages/065"
msgid "Which number?"
msgstr "Quel nombre?"

#. User interface: Messages.
#. German: "Es ist unmöglich, durch Wände zu springen!"
#: AllTexts/Text.amb/Messages/066.txt
msgctxt "AllTexts/Text.amb/Messages/066"
msgid "You cannot jump through walls!"
msgstr "Vous ne pouvez pas sauter a travers les murs!"

#. User interface: Messages.
#. German: "Wer soll transportiert werden?"
#: AllTexts/Text.amb/Messages/067.txt
msgctxt "AllTexts/Text.amb/Messages/067"
msgid "Which party member should be blinked?"
msgstr "Quel membre doit etre aveugle?"

#. User interface: Messages.
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "~LEAD~ hat die Tür geöffnet."
#: AllTexts/Text.amb/Messages/068.txt
msgctxt "AllTexts/Text.amb/Messages/068"
msgid "~LEAD~ has opened the door."
msgstr "~LEAD~ a ouvert la porte."

#. User interface: Messages.
#. German: "Ein seltsames Geräusch ertönt."
#: AllTexts/Text.amb/Messages/069.txt
msgctxt "AllTexts/Text.amb/Messages/069"
msgid "You hear a strange sound."
msgstr "Vous entendez un bruit etrange."

#. User interface: Messages.
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "~LEAD~ hat die Tür aufgeschlossen."
#: AllTexts/Text.amb/Messages/070.txt
msgctxt "AllTexts/Text.amb/Messages/070"
msgid "~LEAD~ has unlocked the door."
msgstr "~LEAD~ a deverouille la porte."

#. User interface: Messages.
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "~LEAD~ entdeckt eine Falle!"
#: AllTexts/Text.amb/Messages/071.txt
msgctxt "AllTexts/Text.amb/Messages/071"
msgid "~LEAD~ discovers a trap!"
msgstr "~LEAD~ a decouvert un piege!"

#. User interface: Messages.
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "~LEAD~ kann keine Falle finden."
#: AllTexts/Text.amb/Messages/072.txt
msgctxt "AllTexts/Text.amb/Messages/072"
msgid "~LEAD~ doesn't discover any traps."
msgstr "~LEAD~ n'a decouvert aucun piege."

#. User interface: Messages.
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "~LEAD~ schafft es, die Falle zu entschärfen!"
#: AllTexts/Text.amb/Messages/073.txt
msgctxt "AllTexts/Text.amb/Messages/073"
msgid "~LEAD~ manages to disarm the trap."
msgstr "~LEAD~ a reussi a desarmer le piege."

#. User interface: Messages.
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "~LEAD~ öffnet das Schloss mit Hilfe eines Dietrichs."
#: AllTexts/Text.amb/Messages/074.txt
msgctxt "AllTexts/Text.amb/Messages/074"
msgid "~LEAD~ unlocks the door using the lockpick."
msgstr "~LEAD~ a deverouille la porte en utilisant le passe-partout."

#. User interface: Messages.
#. German: "Der Dietrich zerbricht."
#: AllTexts/Text.amb/Messages/075.txt
msgctxt "AllTexts/Text.amb/Messages/075"
msgid "The lockpick breaks."
msgstr "Le passe-partout s'est brise."

#. User interface: Messages.
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "~LEAD~ schafft es nicht, das Schloss zu knacken."
#: AllTexts/Text.amb/Messages/076.txt
msgctxt "AllTexts/Text.amb/Messages/076"
msgid "~LEAD~ is unable to pick the lock."
msgstr "~LEAD~ ne peut pas crocheter la serrure."

#. User interface: Messages.
#. German: "Mit was soll das Schloss geöffnet werden?"
#: AllTexts/Text.amb/Messages/077.txt
msgctxt "AllTexts/Text.amb/Messages/077"
msgid "With which item do you want to open the door?"
msgstr "Avec quel objet voulez-vous ouvrir la porte?"

#. User interface: Messages.
#. German: "Mit was soll die Truhe geöffnet werden?"
#: AllTexts/Text.amb/Messages/078.txt
msgctxt "AllTexts/Text.amb/Messages/078"
msgid "With which item do you want to open the chest?"
msgstr "Avec quel objet voulez-vous ouvrir le coffre?"

#. User interface: Messages.
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "~LEAD~ hat die Truhe aufgeschlossen."
#: AllTexts/Text.amb/Messages/079.txt
msgctxt "AllTexts/Text.amb/Messages/079"
msgid "~LEAD~ has unlocked the chest."
msgstr "~LEAD~ a deverouille le coffre."

#. User interface: Messages.
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "~LEAD~ hat die Truhe geöffnet."
#: AllTexts/Text.amb/Messages/080.txt
msgctxt "AllTexts/Text.amb/Messages/080"
msgid "~LEAD~ has opened the chest."
msgstr "~LEAD~ a ouvert le coffre."

#. User interface: Messages.
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "~LEAD~ öffnet die Truhe mit einem Dietrich."
#: AllTexts/Text.amb/Messages/081.txt
msgctxt "AllTexts/Text.amb/Messages/081"
msgid "~LEAD~ unlocks the chest using the lockpick."
msgstr "~LEAD~ a deverouille le coffre en utilisant le passe-partout."

#. User interface: Messages.
#. German: "Damit kann die Tür nicht aufgeschlossen werden."
#: AllTexts/Text.amb/Messages/082.txt
msgctxt "AllTexts/Text.amb/Messages/082"
msgid "This item doesn't open the door."
msgstr "Cet objet ne peut pas ouvrir la porte."

#. User interface: Messages.
#. German: "Damit kann die Truhe nicht aufgeschlossen werden."
#: AllTexts/Text.amb/Messages/083.txt
msgctxt "AllTexts/Text.amb/Messages/083"
msgid "This item doesn't open the chest."
msgstr "Cet objet ne peut pas ouvrir le coffre."

#. User interface: Messages.
#. German: "Welcher Gegenstand soll in die Truhe gelegt werden?"
#: AllTexts/Text.amb/Messages/084.txt
msgctxt "AllTexts/Text.amb/Messages/084"
msgid "Which item do you want to put in the chest?"
msgstr "Quel objet voulez-vous mettre dans le coffre?"

#. User interface: Messages.
#. German: "Wieviele verstauen?"
#: AllTexts/Text.amb/Messages/085.txt
msgctxt "AllTexts/Text.amb/Messages/085"
msgid "Store how many?"
msgstr "En stocker combien?"

#. User interface: Messages.
#. German: "Wieviel Gold verstauen?"
#: AllTexts/Text.amb/Messages/086.txt
msgctxt "AllTexts/Text.amb/Messages/086"
msgid "Store how much gold?"
msgstr "En stocker combien?"

#. User interface: Messages.
#. German: "Wieviel Essen verstauen?"
#: AllTexts/Text.amb/Messages/087.txt
msgctxt "AllTexts/Text.amb/Messages/087"
msgid "Store how much food?"
msgstr "En stocker combien?"

#. User interface: Messages.
#. German: "Es kann nicht mehr Gold in die Kiste gelegt werden."
#: AllTexts/Text.amb/Messages/088.txt
msgctxt "AllTexts/Text.amb/Messages/088"
msgid "You can't put any more gold in the chest."
msgstr "Vous ne pouvez plus mettre d'or dans le coffre."

#. User interface: Messages.
#. German: "Mehr Rationen können nicht in die Truhe gelegt werden."
#: AllTexts/Text.amb/Messages/089.txt
msgctxt "AllTexts/Text.amb/Messages/089"
msgid "You can't put any more food in the chest."
msgstr "Vous ne pouvez plus mettre de nourriture dans le coffre."

#. User interface: Messages.
#. German: "Niemand kann soviel tragen."
#: AllTexts/Text.amb/Messages/090.txt
msgctxt "AllTexts/Text.amb/Messages/090"
msgid "No-one can carry that much."
msgstr "Personne ne peut porter autant."

#. User interface: Messages.
#. German: "Die Truhe ist voll."
#: AllTexts/Text.amb/Messages/091.txt
msgctxt "AllTexts/Text.amb/Messages/091"
msgid "The chest is full."
msgstr "Le coffre est plein."

#. User interface: Messages.
#. German: "Die Truhe ist nun voll."
#: AllTexts/Text.amb/Messages/092.txt
msgctxt "AllTexts/Text.amb/Messages/092"
msgid "The chest is now full."
msgstr "Le coffre est plein a present."

#. User interface: Messages.
#. German: "Ein Schreib-/Lesefehler ist aufgetreten."
#: AllTexts/Text.amb/Messages/093.txt
msgctxt "AllTexts/Text.amb/Messages/093"
msgid "A read/write error has occurred."
msgstr "Un erreur de lecture ecriture s'est produite."

#. User interface: Messages.
#. German: "Spielstand wirklich laden?"
#: AllTexts/Text.amb/Messages/094.txt
msgctxt "AllTexts/Text.amb/Messages/094"
msgid "Do you really want to load?"
msgstr "Voulez-vous vraiment charger cette partie?"

#. User interface: Messages.
#. German: "Alten Spielstand wirklich überschreiben?"
#: AllTexts/Text.amb/Messages/095.txt
msgctxt "AllTexts/Text.amb/Messages/095"
msgid "Do you really want to save over the old saved game?"
msgstr "Voulez-vous vraiment sauver sur l'ancienne partie sauvee?"

#. User interface: Messages.
#. German: "Welchen Spielstand speichern?"
#: AllTexts/Text.amb/Messages/096.txt
msgctxt "AllTexts/Text.amb/Messages/096"
msgid "Save which saved game?"
msgstr "Sauver sur quelle partie sauvee?"

#. User interface: Messages.
#. German: "Was? Du willst mich auf diesem von den Göttern vergessenen Mond zurücklassen? Niemals!"
#: AllTexts/Text.amb/Messages/097.txt
msgctxt "AllTexts/Text.amb/Messages/097"
msgid "What?! And leave me on this accursed planet?! No way!"
msgstr "Quoi?! Et me laisser sur cette planete maudite?! Pas question!"

#. User interface: Messages.
#. German: "Tote können nicht fortgeschickt werden."
#: AllTexts/Text.amb/Messages/098.txt
msgctxt "AllTexts/Text.amb/Messages/098"
msgid "You cannot send dead people away."
msgstr "Vous ne pouvez pas renvoyer des gens qui sont morts."

#. User interface: Messages.
#. German: "Einem Verrückten kann man keine Anweisungen geben."
#: AllTexts/Text.amb/Messages/099.txt
msgctxt "AllTexts/Text.amb/Messages/099"
msgid "Crazy persons do not respond to your commands."
msgstr "Les personnes atteintes de folie n'obeissent plus a vos ordres."

#. User interface: Messages.
#. German: "Versteinerte Leute tun sich schwer mit dem Heimweg."
#: AllTexts/Text.amb/Messages/100.txt
msgctxt "AllTexts/Text.amb/Messages/100"
msgid "Petrified people have trouble getting home."
msgstr "Les gens petrifies ont des problÃ¨mes pour rentrer chez eux."

#. User interface: Messages.
#. German: "Ihr schlaft bis zum Morgengrauen."
#: AllTexts/Text.amb/Messages/101.txt
msgctxt "AllTexts/Text.amb/Messages/101"
msgid "You sleep until dawn."
msgstr "Vous dormez jusqu'a l'aube."

#. User interface: Messages.
#. German: "Etwas mehr könnte es schon sein..."
#: AllTexts/Text.amb/Messages/102.txt
msgctxt "AllTexts/Text.amb/Messages/102"
msgid "How about some more?"
msgstr "Que diriez-vous de plus?"

#. User interface: Messages.
#. German: "Mit wem reden?"
#: AllTexts/Text.amb/Messages/103.txt
msgctxt "AllTexts/Text.amb/Messages/103"
msgid "Who do you want to talk to?"
msgstr "A qui voulez-vous parler?"

#. User interface: Messages.
#. German: "Selbstgespräche sind kein gutes Zeichen geistiger Stabilität!"
#: AllTexts/Text.amb/Messages/104.txt
msgctxt "AllTexts/Text.amb/Messages/104"
msgid "Talking to yourself is a sign of madness!"
msgstr "Se parler a soi-meme est un signe de folie!"

#. User interface: Messages.
#. German: "Diese Person scheint zu schlafen."
#: AllTexts/Text.amb/Messages/105.txt
msgctxt "AllTexts/Text.amb/Messages/105"
msgid "This person seems to be asleep."
msgstr "Cette personne semble etre assoupie."

#. User interface: Messages.
#. German: "Ihr sprecht nicht dieselbe Sprache."
#: AllTexts/Text.amb/Messages/106.txt
msgctxt "AllTexts/Text.amb/Messages/106"
msgid "You do not speak the same language."
msgstr "Vous ne parlez pas la meme langue."

#. User interface: Messages.
#. German: "Tut mir leid, aber darüber weiss ich nichts besonderes."
#: AllTexts/Text.amb/Messages/107.txt
msgctxt "AllTexts/Text.amb/Messages/107"
msgid "I don't know anything special about that."
msgstr "Je ne sais rien de particulier a ce sujet."

#. User interface: Messages.
#. German: "Was soll vorgezeigt werden?"
#: AllTexts/Text.amb/Messages/108.txt
msgctxt "AllTexts/Text.amb/Messages/108"
msgid "Which item do you want to show?"
msgstr "Quel objet voulez-vous montrer?"

#. User interface: Messages.
#. German: "Welcher Gegenstand soll übergeben werden?"
#: AllTexts/Text.amb/Messages/109.txt
msgctxt "AllTexts/Text.amb/Messages/109"
msgid "Which item do you want to give?"
msgstr "Quel objet voulez vous donner?"

#. User interface: Messages.
#. German: "Wieviel Gold übergeben?"
#: AllTexts/Text.amb/Messages/110.txt
msgctxt "AllTexts/Text.amb/Messages/110"
msgid "Give how much gold?"
msgstr "En donner combien?"

#. User interface: Messages.
#. German: "Wieviel Rationen geben?"
#: AllTexts/Text.amb/Messages/111.txt
msgctxt "AllTexts/Text.amb/Messages/111"
msgid "Give how much food?"
msgstr "En donner combien?"

#. User interface: Messages.
#. German: "Ich bin nicht an Eurem Gold interessiert."
#: AllTexts/Text.amb/Messages/112.txt
msgctxt "AllTexts/Text.amb/Messages/112"
msgid "I am not interested in your gold."
msgstr "Je ne suis pas interesse par votre or."

#. User interface: Messages.
#. German: "Die Rationen interessieren mich nicht."
#: AllTexts/Text.amb/Messages/113.txt
msgctxt "AllTexts/Text.amb/Messages/113"
msgid "I am not interested in your food."
msgstr "Je ne suis pas interesse par votre nourriture."

#. User interface: Messages.
#. German: "Dieser Gegenstand ist mir gleichgültig."
#: AllTexts/Text.amb/Messages/114.txt
msgctxt "AllTexts/Text.amb/Messages/114"
msgid "This item does not interest me."
msgstr "Cet objet ne m'interesse pas."

#. User interface: Messages.
#. German: "Ich möchte Eurer Gruppe nicht beitreten."
#: AllTexts/Text.amb/Messages/115.txt
msgctxt "AllTexts/Text.amb/Messages/115"
msgid "I do not want to join your party."
msgstr "Je ne veux pas me joindre Ã  votre groupe."

#. User interface: Messages.
#. German: "Nun gut, ich werde mich auf den Weg machen."
#: AllTexts/Text.amb/Messages/116.txt
msgctxt "AllTexts/Text.amb/Messages/116"
msgid "Very well, I shall leave."
msgstr "Tres bien, je m'en vais."

#. User interface: Messages.
#. German: "Seid gegrüsst!"
#: AllTexts/Text.amb/Messages/117.txt
msgctxt "AllTexts/Text.amb/Messages/117"
msgid "Hello!"
msgstr "Bonjour!"

#. User interface: Messages.
#. German: "Lebt wohl!"
#: AllTexts/Text.amb/Messages/118.txt
msgctxt "AllTexts/Text.amb/Messages/118"
msgid "Good-bye!"
msgstr "Au revoir!"

#. User interface: Messages.
#. Placeholders: ~SELF~ = the hero (the player character). The gender of these persons is unknown.
#. German: "Ja, ~SELF~, was gibt es?"
#: AllTexts/Text.amb/Messages/119.txt
msgctxt "AllTexts/Text.amb/Messages/119"
msgid "Yes, ~SELF~, what is it?"
msgstr "Oui ~SELF~, qui y a-t'il?"

#. User interface: Messages.
#. German: "Du bist nicht in der Lage, Gespräche zu führen."
#: AllTexts/Text.amb/Messages/120.txt
msgctxt "AllTexts/Text.amb/Messages/120"
msgid "You are not capable of conversation."
msgstr "Vous ne pouvez pas parler."

#. User interface: Messages.
#. German: "Die Gruppe ist bereits komplett."
#: AllTexts/Text.amb/Messages/121.txt
msgctxt "AllTexts/Text.amb/Messages/121"
msgid "The party is full."
msgstr "Le groupe est au complet."

#. User interface: Messages.
#. German: "Willkommen! Möchtet ihr die Fähigkeit zu kritischen Treffern trainieren?"
#: AllTexts/Text.amb/Messages/122.txt
msgctxt "AllTexts/Text.amb/Messages/122"
msgid "Welcome! Do you want to train making critical hits?"
msgstr "Bienvenue! Voulez-vous vous entrainer aux coups fatals?"

#. User interface: Messages.
#. German: "Seid gegrüsst. Wie kann ich Euch mit meinen Heilkräften behilflich sein?"
#: AllTexts/Text.amb/Messages/123.txt
msgctxt "AllTexts/Text.amb/Messages/123"
msgid "Welcome! How can my healing powers assist you?"
msgstr "Bienvenue! En quoi mes pouvoirs de guerison peuvent-ils vous aider?"

#. User interface: Messages.
#. German: "Willkommen. Möchtet Ihr mehr über Eure geheimnisvollen Artefakte wissen?"
#: AllTexts/Text.amb/Messages/124.txt
msgctxt "AllTexts/Text.amb/Messages/124"
msgid "Welcome! Do you want me to examine some of your mysterious artefacts?"
msgstr "Bienvenue! Voulez-vous que j'examine certains de vos mysterieux artefactes?"

#. User interface: Messages.
#. German: "Seid gegrüsst. Möchtet Ihr die Energie Eurer magischen Gegenstände auffrischen?"
#: AllTexts/Text.amb/Messages/125.txt
msgctxt "AllTexts/Text.amb/Messages/125"
msgid "Welcome! Do you want to recharge your magical objects?"
msgstr "Bienvenue! Voulez-vous recharger vos objets magiques?"

#. User interface: Messages.
#. German: "Willkommen! Kann ich Euch ein gemütliches ZImmer anbieten?"
#: AllTexts/Text.amb/Messages/126.txt
msgctxt "AllTexts/Text.amb/Messages/126"
msgid "Welcome! What brings you to my fine inn?"
msgstr "Bienvenue! Qu'est-ce qui vous amene dans ma bonne auberge?"

#. User interface: Messages.
#. German: "Willkommen! Ihr kommt gerade zur rechten Zeit, um von meinen günstigen Angeboten zu profitieren!"
#: AllTexts/Text.amb/Messages/127.txt
msgctxt "AllTexts/Text.amb/Messages/127"
msgid "Welcome! You have come just in time to profit from my incredible bargains!"
msgstr "Bienvenue! Vous arrivez juste a temps pour profiter de mes affaires incroyables!"

#. User interface: Messages.
#. German: "Seid gegrüsst! Meine leckeren Nahrungsmittel werden Eure Reisen zum Vergnügen machen!"
#: AllTexts/Text.amb/Messages/128.txt
msgctxt "AllTexts/Text.amb/Messages/128"
msgid "Welcome! Do you want some tasty food to sustain you on your quests?"
msgstr "Bienvenue! Voulez-vous de la nourriture bien goutue pour vous sustenter durant vos quetes?"

#. User interface: Messages.
#. German: "Willkommen. Ihr möchtet Euer Wissen über die Magie mehren?"
#: AllTexts/Text.amb/Messages/129.txt
msgctxt "AllTexts/Text.amb/Messages/129"
msgid "Welcome! Do you want to extend your knowledge of magical spells?"
msgstr "Bienvenue! Voulez-vous etendre votre savoir sur les sorts magiques?"

#. User interface: Messages.
#. German: "Grüsse, Ihr Reisenden! Wie wäre es mit einem stabilen Floss?"
#: AllTexts/Text.amb/Messages/130.txt
msgctxt "AllTexts/Text.amb/Messages/130"
msgid "Welcome! How about one of my fine rafts?"
msgstr "Bienvenue! Que diriez-vous d'un de mes radeaux de qualite?"

#. User interface: Messages.
#. German: "Willkommen! Benötigt Ihr ein Schiff?"
#: AllTexts/Text.amb/Messages/131.txt
msgctxt "AllTexts/Text.amb/Messages/131"
msgid "Welcome! Do you need a ship?"
msgstr "Bienvenue! Avez-vous besoin d'un navire?"

#. User interface: Messages.
#. German: "Seid gegrüsst. Werft einen Blick auf meine vorzüglichen Reitpferde!"
#: AllTexts/Text.amb/Messages/132.txt
msgctxt "AllTexts/Text.amb/Messages/132"
msgid "Welcome! I see you are in need of some fine horses!"
msgstr "Bienvenue! Je vois que vous avez besoin de bons chevaux!"

#. User interface: Messages.
#. German: "Nachdem der Kampf vorüber ist, durchsucht Ihr, was von Euren Gegnern zurückgelassen wurde."
#: AllTexts/Text.amb/Messages/133.txt
msgctxt "AllTexts/Text.amb/Messages/133"
msgid "After the battle you look through the items your enemies left behind."
msgstr "Apres la bataille, vous passez en revue les objets que vos ennemis ont laisses derriere eux."

#. User interface: Messages.
#. German: "Niemand hat Erfahrungspunkte hinzugewonnen."
#: AllTexts/Text.amb/Messages/134.txt
msgctxt "AllTexts/Text.amb/Messages/134"
msgid "No-one receives any experience points."
msgstr "Personne ne recoit de points d'experience."

#. User interface: Messages.
#. German: "Welcher Gegenstand soll verkauft werden?"
#: AllTexts/Text.amb/Messages/135.txt
msgctxt "AllTexts/Text.amb/Messages/135"
msgid "Which item do you want to sell?"
msgstr "Quel objet desirez-vous vendre?"

#. User interface: Messages.
#. German: "Wieviel verkaufen?"
#: AllTexts/Text.amb/Messages/136.txt
msgctxt "AllTexts/Text.amb/Messages/136"
msgid "Sell how many?"
msgstr "En vendre combien?"

#. User interface: Messages.
#. German: "Der Rückweg ist zu gefährlich: Ein Gegner ist in der Nähe!"
#: AllTexts/Text.amb/Messages/137.txt
msgctxt "AllTexts/Text.amb/Messages/137"
msgid "The way back is too dangerous : there's a monster in the vicinity!"
msgstr "Le chemin retour est trop dangereux : il y a un ou des monstres dans les environs!"

#. User interface: Messages.
#. German: "Bitte entfernen Sie den Schreibschutz der Spielstand-Diskette. (Schreibschutzfenster muss ZU sein)"
#: AllTexts/Text.amb/Messages/138.txt
msgctxt "AllTexts/Text.amb/Messages/138"
msgid "Please remove the write protection from the saved-game-disk. (The write-protection-window must be closed)"
msgstr "Veuillez retirer la protection en ecriture du disque de sauvegarde. (La fenetre de protection en ecriture doit etre obturee)"

#. User interface: Messages.
#. German: "Die Gruppe kann nicht alles Gold tragen!^Trotzdem verlassen?"
#: AllTexts/Text.amb/Messages/139.txt
msgctxt "AllTexts/Text.amb/Messages/139"
msgid "You cannot carry all the gold!^Leave anyway?"
msgstr "Vous ne pouvez pas porter tout l'or!^Partir quand meme?"

#. User interface: Messages.
#. German: "Dafür gebe ich "
#: AllTexts/Text.amb/Messages/140.txt
msgctxt "AllTexts/Text.amb/Messages/140"
msgid "For this I will give you "
msgstr "Contre ceci je vous donne "

#. User interface: Messages.
#. German: "Wirklich dorthin gehen?"
#: AllTexts/Text.amb/Messages/141.txt
msgctxt "AllTexts/Text.amb/Messages/141"
msgid "Do you really want to go there?"
msgstr "Vous voulez vraiment aller la-bas?"

#. User interface: Messages.
#. German: " flüchtet!"
#: AllTexts/Text.amb/Messages/142.txt
msgctxt "AllTexts/Text.amb/Messages/142"
msgid " flees!"
msgstr " s'envole!"

#. User interface: Messages.
#. German: "Position ist bereits erreicht!"
#: AllTexts/Text.amb/Messages/143.txt
msgctxt "AllTexts/Text.amb/Messages/143"
msgid "You are already there!"
msgstr "Vous y etes deja!"

#. User interface: Messages.
#. German: "Dieser Ort kann später schnell erreicht werden."
#: AllTexts/Text.amb/Messages/144.txt
msgctxt "AllTexts/Text.amb/Messages/144"
msgid "You will be able to return to this point later."
msgstr "Vous pourrez revenir sur ce lieu plus tard."

#. User interface: Messages.
#. German: "Bedauerlicherweise kaufe ich im Augenblick nichts mehr an, aber werft doch bitte einen Blick auf mein umfangreiches Warenangebot!"
#: AllTexts/Text.amb/Messages/145.txt
msgctxt "AllTexts/Text.amb/Messages/145"
msgid "Ah, sadly I cannot buy anymore. But I would be happy to sell you some of my fine wares!"
msgstr "Ah, malheureusement je ne peux plus rien acheter. Mais je serais heureux de vous vendre certains de mes marchandises de qualite!"

#. User interface: Messages.
#. German: "Was soll gekauft werden?"
#: AllTexts/Text.amb/Messages/146.txt
msgctxt "AllTexts/Text.amb/Messages/146"
msgid "Which item do you want to buy?"
msgstr "Quel objet voulez-vous acheter?"

#. User interface: Messages.
#. German: "Wieviel kaufen?"
#: AllTexts/Text.amb/Messages/147.txt
msgctxt "AllTexts/Text.amb/Messages/147"
msgid "Buy how many?"
msgstr "En acheter combien?"

#. User interface: Messages.
#. German: "Das würde folgendes kosten:^"
#: AllTexts/Text.amb/Messages/148.txt
msgctxt "AllTexts/Text.amb/Messages/148"
msgid "This will cost you:^"
msgstr "Ceci vous coutera:^"

#. User interface: Messages.
#. German: "Welches meiner vorzüglichen Angebote würdet Ihr gerne einer näheren Betrachtung unterziehen?"
#: AllTexts/Text.amb/Messages/149.txt
msgctxt "AllTexts/Text.amb/Messages/149"
msgid "Which of my fine articles would you like to examine more closely?"
msgstr "Lequel de mes articles de qualite souhaitez-vous examiner de plus pres?"

#. User interface: Messages.
#. German: "Eure Mittel scheinen mir nicht ausreichend zu sein!"
#: AllTexts/Text.amb/Messages/150.txt
msgctxt "AllTexts/Text.amb/Messages/150"
msgid "You do not seem to have enough money!"
msgstr "On dirait que vous n'avez pas assez d'argent!"

#. User interface: Messages.
#. German: "Eine Übernachtung für Euch alle kostet "
#: AllTexts/Text.amb/Messages/151.txt
msgctxt "AllTexts/Text.amb/Messages/151"
msgid "Your stay will cost "
msgstr "Votre sejour vous coutera "

#. User interface: Messages.
#. German: "Eines meiner fabelhaften Flösse wechselt seinen Besitzer für den unerheblichen Preis von "
#: AllTexts/Text.amb/Messages/152.txt
msgctxt "AllTexts/Text.amb/Messages/152"
msgid "I will give you one of my fabulous rafts for the insignificant price of "
msgstr "Je vais vous donner un de mes fabuleux radeau pour la modique somme de "

#. User interface: Messages.
#. German: "Eines meiner hochseetüchtigen Schiffe kostet "
#: AllTexts/Text.amb/Messages/153.txt
msgctxt "AllTexts/Text.amb/Messages/153"
msgid "One of my fine ships will cost you "
msgstr "Un de mes beaux navires vous coutera "

#. User interface: Messages.
#. German: "Meine edlen Rösser kosten Euch "
#: AllTexts/Text.amb/Messages/154.txt
msgctxt "AllTexts/Text.amb/Messages/154"
msgid "My noble horses will cost you "
msgstr "Mes nobles chevaux vous couteront "

#. User interface: Messages.
#. German: "Welchen Gegenstand soll ich Euch verzaubern?"
#: AllTexts/Text.amb/Messages/155.txt
msgctxt "AllTexts/Text.amb/Messages/155"
msgid "Which item do you want me to enchant?"
msgstr "Quel objet voulez-vous que je vous ensorcelle?"

#. User interface: Messages.
#. German: "Wieviel Rationen abgeben?"
#: AllTexts/Text.amb/Messages/156.txt
msgctxt "AllTexts/Text.amb/Messages/156"
msgid "Move how much food?"
msgstr "En deplacer combien?"

#. User interface: Messages.
#. German: "Wieviel Essen kaufen?"
#: AllTexts/Text.amb/Messages/157.txt
msgctxt "AllTexts/Text.amb/Messages/157"
msgid "Buy how much food?"
msgstr "En acheter combien?"

#. User interface: Messages.
#. German: "Dieser Vorrat kostet "
#: AllTexts/Text.amb/Messages/158.txt
msgctxt "AllTexts/Text.amb/Messages/158"
msgid "This amount of food will cost you "
msgstr "Cette quantite de nourriture vous coutera "

#. User interface: Messages.
#. German: "Die Gruppe teilt sich die Rationen auf, aber es ist noch etwas übrig."
#: AllTexts/Text.amb/Messages/159.txt
msgctxt "AllTexts/Text.amb/Messages/159"
msgid "You divide the food, but there is still some left."
msgstr "Vous partagez la nourriture, mais il en reste encore."

#. User interface: Messages.
#. German: "Ihr teilt Euch die Rationen auf."
#: AllTexts/Text.amb/Messages/160.txt
msgctxt "AllTexts/Text.amb/Messages/160"
msgid "You divide the food equally."
msgstr "Vous partagez equitablement la nourriture."

#. User interface: Messages.
#. German: "Den Rest der Nahrung liegenlassen?"
#: AllTexts/Text.amb/Messages/161.txt
msgctxt "AllTexts/Text.amb/Messages/161"
msgid "Do you want to leave the rest of the food here?"
msgstr "Voulez-vous laisser le reste de la nourriture ici?"

#. User interface: Messages.
#. German: "Möchtet Ihr gehen, ohne Eure Einkäufe mitzunehmen?"
#: AllTexts/Text.amb/Messages/162.txt
msgctxt "AllTexts/Text.amb/Messages/162"
msgid "Do you want to leave the articles you bought?"
msgstr "Voulez-vous laisser les articles que vous avez achete?"

#. User interface: Messages.
#. German: "Dieser Gegenstand hat soviel magisches Potential wie ein Suppenlöffel. Behelligt mich nicht mit solchem Plunder."
#: AllTexts/Text.amb/Messages/163.txt
msgctxt "AllTexts/Text.amb/Messages/163"
msgid "This item has as much magical potential as an ordinary spoon. Do not bother me with trinkets."
msgstr "Cet objet possede autant de potentiel magique qu'une cuillere ordinaire. Ne m'ennuyez pas avec des bibelots."

#. User interface: Messages.
#. German: "Dieser Gegenstand vibriert bereits förmlich vor Magie. Es ist nicht ratsam, ihn weiter zu verzaubern."
#: AllTexts/Text.amb/Messages/164.txt
msgctxt "AllTexts/Text.amb/Messages/164"
msgid "This item is already as filled with magic as can be. I don't perform miracles, you know."
msgstr "Cet objet est deja pourvu en magie autant qu'il le peut. Je ne fais pas de miracles, vous savez."

#. User interface: Messages.
#. German: "Leider ist dieser Gegenstand schon zu oft verzaubert worden. Selbst ich kann nun keine Zauber mehr darauf legen."
#: AllTexts/Text.amb/Messages/165.txt
msgctxt "AllTexts/Text.amb/Messages/165"
msgid "Sadly, this item has been enchanted once too often. Even I cannot replenish it's magical powers."
msgstr "Malheureusement, cet objet a ete ensorcelle une fois de trop. Meme moi je ne peux pas lui redonner ses pouvoirs magiques."

#. User interface: Messages.
#. German: "Das Verzaubern dieses Gegenstandes kostet "
#: AllTexts/Text.amb/Messages/166.txt
msgctxt "AllTexts/Text.amb/Messages/166"
msgid "Enchanting this item will cost you "
msgstr "Ensorceller cet objet vous coutera "

#. User interface: Messages.
#. German: "Wisset, dass dieser Gegenstand zum letzten Male verzaubert werden konnte! "
#: AllTexts/Text.amb/Messages/167.txt
msgctxt "AllTexts/Text.amb/Messages/167"
msgid "This was the last time the item could be enchanted."
msgstr "C'etait la derniere fois que cet objet pouvait etre ensorcelle."

#. User interface: Messages.
#. German: "Wieviele Magieladungen?"
#: AllTexts/Text.amb/Messages/168.txt
msgctxt "AllTexts/Text.amb/Messages/168"
msgid "How many charges?"
msgstr "Combien de recharges?"

#. User interface: Messages.
#. German: "Welchen Gegenstand soll ich für Euch untersuchen?"
#: AllTexts/Text.amb/Messages/169.txt
msgctxt "AllTexts/Text.amb/Messages/169"
msgid "Which item do you want me to examine?"
msgstr "Quel objet voulez-vous que j'examine?"

#. User interface: Messages.
#. German: "Dieser Gegenstand wurde bereits untersucht!"
#: AllTexts/Text.amb/Messages/170.txt
msgctxt "AllTexts/Text.amb/Messages/170"
msgid "This item has already been examined!"
msgstr "Cet objet a deja ete examine!"

#. User interface: Messages.
#. German: "Ich analysiere diesen Gegenstand zum Preis von "
#: AllTexts/Text.amb/Messages/171.txt
msgctxt "AllTexts/Text.amb/Messages/171"
msgid "I will examine this item for "
msgstr "J'examinerais cet objet pour "

#. User interface: Messages.
#. German: "Wieviele LP?"
#: AllTexts/Text.amb/Messages/172.txt
msgctxt "AllTexts/Text.amb/Messages/172"
msgid "How many LP?"
msgstr "Combien de PV?"

#. User interface: Messages.
#. German: "Die Heilung dieser Lebenpunkte kostet "
#: AllTexts/Text.amb/Messages/173.txt
msgctxt "AllTexts/Text.amb/Messages/173"
msgid "Healing these life-points will cost you "
msgstr "Soigner ces points de vie vous coutera "

#. User interface: Messages.
#. German: "Welche Kondition soll ich heilen?"
#: AllTexts/Text.amb/Messages/174.txt
msgctxt "AllTexts/Text.amb/Messages/174"
msgid "Which condition do you want me to heal?"
msgstr "Quel etat voulez-vous que je soigne?"

#. User interface: Messages.
#. German: "Ihr seid völlig erschöpft!"
#: AllTexts/Text.amb/Messages/175.txt
msgctxt "AllTexts/Text.amb/Messages/175"
msgid "You are completely exhausted!"
msgstr "Vous etes completement epuise!"

#. User interface: Messages.
#. German: "Seit Eurer letzten Rast ist noch nicht viel Zeit vergangen, deshalb würde Euch der Schlaf nichts bringen."
#: AllTexts/Text.amb/Messages/176.txt
msgctxt "AllTexts/Text.amb/Messages/176"
msgid "Since it is such a short time since you last slept, resting would have no effect."
msgstr "Etant donne que vous avez dormi il y a peu de temps, se reposer n'aurait aucun effet."

#. User interface: Messages.
#. German: "Die Heilung dieser Kondition kostet "
#: AllTexts/Text.amb/Messages/177.txt
msgctxt "AllTexts/Text.amb/Messages/177"
msgid "Healing this condition will cost you "
msgstr "Soigner cet etat vous coutera "

#. User interface: Messages.
#. German: "Für das Entfernen verfluchter Gegenstände berechne ich "
#: AllTexts/Text.amb/Messages/178.txt
msgctxt "AllTexts/Text.amb/Messages/178"
msgid "Removing cursed items will cost you "
msgstr "Oter la malediction d'un objet vous coutera "

#. User interface: Messages.
#. German: "Wie oft trainieren?"
#: AllTexts/Text.amb/Messages/179.txt
msgctxt "AllTexts/Text.amb/Messages/179"
msgid "Train how often?"
msgstr "S'entrainer?"

#. User interface: Messages.
#. German: "Das Training kostet "
#: AllTexts/Text.amb/Messages/180.txt
msgctxt "AllTexts/Text.amb/Messages/180"
msgid "Training will cost you "
msgstr "S'entrainer vous coutera "

#. User interface: Messages.
#. German: "Du hast nicht genügend Trainingspunkte!"
#: AllTexts/Text.amb/Messages/181.txt
msgctxt "AllTexts/Text.amb/Messages/181"
msgid "You don't have enough training points!"
msgstr "Vous n'avez pas assez de points d'entrainement!"

#. User interface: Messages.
#. German: "Nach dem Training hat sich die entsprechende Fähigkeit spürbar verbessert."
#: AllTexts/Text.amb/Messages/182.txt
msgctxt "AllTexts/Text.amb/Messages/182"
msgid "After the training, your skill has increased noticably."
msgstr "Apres l'entrainement, votre habilete s'est amelioree de maniere remarquable."

#. User interface: Messages.
#. German: "Willkommen! Möchtest Du Deine Attacke trainieren?"
#: AllTexts/Text.amb/Messages/183.txt
msgctxt "AllTexts/Text.amb/Messages/183"
msgid "Welcome! Do you want to practice some attacking?"
msgstr "Bienvenue! Voulez-vous pratiquer l'attaque?"

#. User interface: Messages.
#. German: "Sei gegrüsst! Möchtest Du das Parieren üben?"
#: AllTexts/Text.amb/Messages/184.txt
msgctxt "AllTexts/Text.amb/Messages/184"
msgid "Welcome! Do you want to practice some parrying?"
msgstr "Bienvenue! Voulez-vous pratiquer la parade?"

#. User interface: Messages.
#. German: "Willkommen! Wie wäre es mit etwas Schwimmunterricht?"
#: AllTexts/Text.amb/Messages/185.txt
msgctxt "AllTexts/Text.amb/Messages/185"
msgid "Welcome! Do you want to improve your swimming?"
msgstr "Bienvenue! Voulez-vous ameliorer votre nage?"

#. User interface: Messages.
#. German: "Willkommen! Möchtest Du besser im Auffinden von Fallen werden?"
#: AllTexts/Text.amb/Messages/186.txt
msgctxt "AllTexts/Text.amb/Messages/186"
msgid "Welcome! Do you want to get better at finding traps?"
msgstr "Bienvenue! Voulez-vous devenir meilleur en decouverte de pieges?"

#. User interface: Messages.
#. German: "Willkommen! Ich biete Euch Training im Entschärfen von Fallen an!"
#: AllTexts/Text.amb/Messages/187.txt
msgctxt "AllTexts/Text.amb/Messages/187"
msgid "Welcome! Do you want to get better at disarming traps?"
msgstr "Bienvenue! Voulez-vous devenir meilleur en desarmement de pieges?"

#. User interface: Messages.
#. German: "Grüsse! Willst Du besser im Knacken von Schlössern werden?"
#: AllTexts/Text.amb/Messages/188.txt
msgctxt "AllTexts/Text.amb/Messages/188"
msgid "Welcome! Do you want to practice some lock-picking?"
msgstr "Bienvenue! Voulez-vous pratiquer le crochetage?"

#. User interface: Messages.
#. German: "Seid gegrüsst! Möchtet Ihr Eure Suchfähigkeiten verbessern?"
#: AllTexts/Text.amb/Messages/189.txt
msgctxt "AllTexts/Text.amb/Messages/189"
msgid "Welcome! Do you want to improve your searching?"
msgstr "Bienvenue! Voulez-vous ameliorer votre recherche?"

#. User interface: Messages.
#. German: "Willkommen! Möchtest Du es leichter haben, Spruchrollen zu lernen?"
#: AllTexts/Text.amb/Messages/190.txt
msgctxt "AllTexts/Text.amb/Messages/190"
msgid "Welcome! Do you want to get better at reading spell-scrolls?"
msgstr "Bienvenue! Voulez-vous devenir meilleur en lecture de parchemins de sort?"

#. User interface: Messages.
#. German: "Seid gegrüsst. Möchtest Du sicherer im Anwenden der magischen Künste werden?"
#: AllTexts/Text.amb/Messages/191.txt
msgctxt "AllTexts/Text.amb/Messages/191"
msgid "Welcome! Do you want to get better at using magic?"
msgstr "Bienvenue! Voulez-vous devenir meilleur a l'utilisation de la magie?"

#. User interface: Messages.
#. German: "Lebenspunkte sind jetzt :"
#: AllTexts/Text.amb/Messages/193.txt
msgctxt "AllTexts/Text.amb/Messages/193"
msgid "Life-points are now :"
msgstr "Points de vie          :"

#. User interface: Messages.
#. German: "Spruchpunkte sind nun :"
#: AllTexts/Text.amb/Messages/194.txt
msgctxt "AllTexts/Text.amb/Messages/194"
msgid "Power-points are now :"
msgstr "Points de sorts        :"

#. User interface: Messages.
#. German: "Jetzige Spruchlernpunkte :"
#: AllTexts/Text.amb/Messages/195.txt
msgctxt "AllTexts/Text.amb/Messages/195"
msgid "Spell-learn-points are now :"
msgstr "Points d'apprentissage :"

#. User interface: Messages.
#. German: "Trainingspunkte sind nun :"
#: AllTexts/Text.amb/Messages/196.txt
msgctxt "AllTexts/Text.amb/Messages/196"
msgid "Training points are now :"
msgstr "Points d'entrainement  :"

#. User interface: Messages.
#. German: "Attacken pro Runde sind nun :"
#: AllTexts/Text.amb/Messages/197.txt
msgctxt "AllTexts/Text.amb/Messages/197"
msgid "Attacks per round are now :"
msgstr "Attaques par tour      :"

#. User interface: Messages.
#. German: "Nächster Level bei :"
#: AllTexts/Text.amb/Messages/198.txt
msgctxt "AllTexts/Text.amb/Messages/198"
msgid "Next level at :"
msgstr "Niveau suivant a       :"

#. User interface: Messages.
#. German: "Maximaler Level wurde erreicht!"
#: AllTexts/Text.amb/Messages/199.txt
msgctxt "AllTexts/Text.amb/Messages/199"
msgid "Maximum level has been reached!"
msgstr "Le niveau maximum a ete atteint!"

#. User interface: Messages.
#. German: "Ein Angriff! Wollt Ihr kämpfen?"
#: AllTexts/Text.amb/Messages/200.txt
msgctxt "AllTexts/Text.amb/Messages/200"
msgid "You are being attacked! Do you want to fight?"
msgstr "Vous etes attaques! Voulez-vous combattre?"

#. User interface: Messages.
#. German: "Wohin bewegen?"
#: AllTexts/Text.amb/Messages/201.txt
msgctxt "AllTexts/Text.amb/Messages/201"
msgid "Where do you want to move to?"
msgstr "Ou voulez-vous vous deplacer?"

#. User interface: Messages.
#. German: "Du kannst nirgendwo hin!"
#: AllTexts/Text.amb/Messages/202.txt
msgctxt "AllTexts/Text.amb/Messages/202"
msgid "There is nowhere you can move to!"
msgstr "Vous ne pouvez aller nulle part!"

#. User interface: Messages.
#. German: "Eure Flucht misslingt!"
#: AllTexts/Text.amb/Messages/203.txt
msgctxt "AllTexts/Text.amb/Messages/203"
msgid "You couldn't escape!"
msgstr "Vous ne pouvez pas vous echapper!"

#. User interface: Messages.
#. German: "Du hast keine Munition!"
#: AllTexts/Text.amb/Messages/204.txt
msgctxt "AllTexts/Text.amb/Messages/204"
msgid "You don't have any ammunition!"
msgstr "Vous n'avez pas de munition!"

#. User interface: Messages.
#. German: "Was angreifen?"
#: AllTexts/Text.amb/Messages/205.txt
msgctxt "AllTexts/Text.amb/Messages/205"
msgid "What do you want to attack?"
msgstr "Que voulez-vous attaquer?"

#. User interface: Messages.
#. Placeholders: ~LEAD~ = the active party member. The gender of these persons is unknown.
#. German: "~LEAD~ kann niemanden erreichen!"
#: AllTexts/Text.amb/Messages/206.txt
msgctxt "AllTexts/Text.amb/Messages/206"
msgid "~LEAD~ cannot reach anyone!"
msgstr "~LEAD~ ne peut atteindre personne!"

#. User interface: Messages.
#. German: "Dieser Gegenstand ist gebrochen!"
#: AllTexts/Text.amb/Messages/207.txt
msgctxt "AllTexts/Text.amb/Messages/207"
msgid "This item is broken!"
msgstr "Cet objet est brise!"

#. User interface: Messages.
#. German: "Willkommen! Soll ich etwas für Euch reparieren?"
#: AllTexts/Text.amb/Messages/208.txt
msgctxt "AllTexts/Text.amb/Messages/208"
msgid "Welcome! Do you want me to repair something?"
msgstr "Bienvenue! Voulez-vous que je repare quelque chose?"

#. User interface: Messages.
#. German: "Welchen Gegenstand soll ich reparieren?"
#: AllTexts/Text.amb/Messages/209.txt
msgctxt "AllTexts/Text.amb/Messages/209"
msgid "Which item do you want me to repair?"
msgstr "Quel objet voulez-vous que je repare?"

#. User interface: Messages.
#. German: "Ich kaufe kein zerbrochenes Zeug!"
#: AllTexts/Text.amb/Messages/210.txt
msgctxt "AllTexts/Text.amb/Messages/210"
msgid "I won't buy any broken stuff!"
msgstr "Je n'acheterais aucun machin brise ou casse!"

#. User interface: Messages.
#. German: " verfehlt das Ziel!"
#: AllTexts/Text.amb/Messages/211.txt
msgctxt "AllTexts/Text.amb/Messages/211"
msgid " missed the target!"
msgstr " a rate sa cible!"

#. User interface: Messages.
#. German: " kann den magischen Rüstschutz nicht durchdringen!"
#: AllTexts/Text.amb/Messages/212.txt
msgctxt "AllTexts/Text.amb/Messages/212"
msgid " cannot penetrate the magical aura!"
msgstr " ne peut pas penetrer l'aura magique!"

#. User interface: Messages.
#. German: "'s Angriff schlägt fehl!"
#: AllTexts/Text.amb/Messages/213.txt
msgctxt "AllTexts/Text.amb/Messages/213"
msgid "'s attack failed!"
msgstr ": echec de l'attaque!"

#. User interface: Messages.
#. German: "'s Attacke wurde abgewehrt!"
#: AllTexts/Text.amb/Messages/214.txt
msgctxt "AllTexts/Text.amb/Messages/214"
msgid "'s attack was deflected!"
msgstr ": l'attaque a ete deviee!"

#. User interface: Messages.
#. German: "'s Attacke richtete keinen Schaden an!"
#: AllTexts/Text.amb/Messages/215.txt
msgctxt "AllTexts/Text.amb/Messages/215"
msgid " attacked but did no damage!"
msgstr " a attaque mais n'a fait aucun degat!"

#. User interface: Messages.
#. German: " hat einen kritischen Treffer gelandet!"
#: AllTexts/Text.amb/Messages/216.txt
msgctxt "AllTexts/Text.amb/Messages/216"
msgid " has made a critical hit!"
msgstr " a porte un coup fatal!"

#. User interface: Messages.
#. German: " hat die letzte Munition verbraucht!"
#: AllTexts/Text.amb/Messages/217.txt
msgctxt "AllTexts/Text.amb/Messages/217"
msgid " has used the last ammunition!"
msgstr " a utilise ses dernieres munitions!"

#. User interface: Messages.
#. German: "Du kannst Dich nicht bewegen."
#: AllTexts/Text.amb/Messages/218.txt
msgctxt "AllTexts/Text.amb/Messages/218"
msgid "You cannot move."
msgstr "Vous ne pouvez pas bouger."

#. User interface: Messages.
#. German: "Zu weit entfernt."
#: AllTexts/Text.amb/Messages/219.txt
msgctxt "AllTexts/Text.amb/Messages/219"
msgid "It's too far away."
msgstr "C'est trop loin."

#. User interface: Messages.
#. German: "Du bist nicht in der Lage, etwas anzugreifen."
#: AllTexts/Text.amb/Messages/220.txt
msgctxt "AllTexts/Text.amb/Messages/220"
msgid "You are incapable of attacking."
msgstr "Vous ne pouvez pas attaquer."

#. User interface: Messages.
#. German: "Jemand geht bereits dorthin."
#: AllTexts/Text.amb/Messages/221.txt
msgctxt "AllTexts/Text.amb/Messages/221"
msgid "Someone is already going there."
msgstr "Quelqu'un est deja entrain d'aller ici."

#. User interface: Messages.
#. German: "Die Gruppe braucht einen neuen Anführer."
#: AllTexts/Text.amb/Messages/222.txt
msgctxt "AllTexts/Text.amb/Messages/222"
msgid "Select a new leader."
msgstr "Choisissez un nouveau chef."

#. User interface: Messages.
#. German: "Ihr werdet müde."
#: AllTexts/Text.amb/Messages/224.txt
msgctxt "AllTexts/Text.amb/Messages/224"
msgid "You are getting tired."
msgstr "Vous etes fatigues."

#. User interface: Messages.
#. German: "Wieviele Stunden warten?"
#: AllTexts/Text.amb/Messages/225.txt
msgctxt "AllTexts/Text.amb/Messages/225"
msgid "Wait how many hours?"
msgstr "Passer combien d'heures?"

#. User interface: Messages.
#. German: "Eure Gegner rücken vor!"
#: AllTexts/Text.amb/Messages/226.txt
msgctxt "AllTexts/Text.amb/Messages/226"
msgid "The monsters advance!"
msgstr "Les monstres avancent!"

#. User interface: Messages.
#. German: "Ich bräuchte etwas mehr Nahrung."
#: AllTexts/Text.amb/Messages/227.txt
msgctxt "AllTexts/Text.amb/Messages/227"
msgid "Some more food wouldn't be bad."
msgstr "Un peu plus de nourriture ne ferait pas de mal."

#. User interface: Messages.
#. German: " bewegt sich!"
#: AllTexts/Text.amb/Messages/228.txt
msgctxt "AllTexts/Text.amb/Messages/228"
msgid " moves!"
msgstr " se deplace!"

#. User interface: Messages.
#. German: "'s Ziel wurde blockiert!"
#: AllTexts/Text.amb/Messages/229.txt
msgctxt "AllTexts/Text.amb/Messages/229"
msgid "'s way was blocked!"
msgstr " a ete bloque sur sa trajectoire!"

#. User interface: Messages.
#. German: "Welchen Spielstand laden?"
#: AllTexts/Text.amb/Messages/230.txt
msgctxt "AllTexts/Text.amb/Messages/230"
msgid "Load which saved game?"
msgstr "Charger quelle partie sauvee?"

#. User interface: Messages.
#. German: " hat die Waffe weggeworfen."
#: AllTexts/Text.amb/Messages/231.txt
msgctxt "AllTexts/Text.amb/Messages/231"
msgid " has dropped a weapon."
msgstr " a laisse tomber une arme."

#. User interface: Messages.
#. German: " weicht zurück!"
#: AllTexts/Text.amb/Messages/232.txt
msgctxt "AllTexts/Text.amb/Messages/232"
msgid " retreats!"
msgstr " se replie!"

#. User interface: Messages.
#. German: "Die Gruppe rückt vor!"
#: AllTexts/Text.amb/Messages/233.txt
msgctxt "AllTexts/Text.amb/Messages/233"
msgid "The party advances!"
msgstr "Le groupe avance!"

#. User interface: Messages.
#. German: "Optionen :"
#: AllTexts/Text.amb/Messages/234.txt
msgctxt "AllTexts/Text.amb/Messages/234"
msgid "Options :"
msgstr "Options :"

#. User interface: Messages.
#. German: "Wer ist die Zielperson?"
#: AllTexts/Text.amb/Messages/235.txt
msgctxt "AllTexts/Text.amb/Messages/235"
msgid "Which party member will be your target?"
msgstr "Quel membre du groupe sera votre cible?"

#. User interface: Messages.
#. German: "Auf welches Monster?"
#: AllTexts/Text.amb/Messages/236.txt
msgctxt "AllTexts/Text.amb/Messages/236"
msgid "Which monster will be your target?"
msgstr "Quel monstre sera votre cible?"

#. User interface: Messages.
#. German: "Auf wessen Gegenstand?"
#: AllTexts/Text.amb/Messages/237.txt
msgctxt "AllTexts/Text.amb/Messages/237"
msgid "Whose item will be your target?"
msgstr "Quel objet sera votre cible?"

#. User interface: Messages.
#. German: "Auf welche Reihe von Kameraden?"
#: AllTexts/Text.amb/Messages/238.txt
msgctxt "AllTexts/Text.amb/Messages/238"
msgid "Which row of party members will be your target?"
msgstr "Quelle rangee des membres du groupe sera votre cible?"

#. User interface: Messages.
#. German: "Auf welche Reihe von Monstern?"
#: AllTexts/Text.amb/Messages/239.txt
msgctxt "AllTexts/Text.amb/Messages/239"
msgid "Which row of monsters will be your target?"
msgstr "Quelle rangee de monstres sera votre cible?"

#. User interface: Messages.
#. German: "Welcher Gegenstand ist das Ziel?"
#: AllTexts/Text.amb/Messages/240.txt
msgctxt "AllTexts/Text.amb/Messages/240"
msgid "Which item will be your target?"
msgstr "Quel objet sera votre cible?"

#. User interface: Messages.
#. German: "Falsche Welt!"
#: AllTexts/Text.amb/Messages/241.txt
msgctxt "AllTexts/Text.amb/Messages/241"
msgid "Wrong world!"
msgstr "Mauvais monde!"

#. User interface: Messages.
#. German: "'s Zauber ist misslungen!"
#: AllTexts/Text.amb/Messages/242.txt
msgctxt "AllTexts/Text.amb/Messages/242"
msgid "'s spell failed!"
msgstr ": echec du sort!"

#. User interface: Messages.
#. Placeholders: ~INVN~ = the party member whose inventory is open. The gender of these persons is unknown.
#. German: "~INVN~ hat die falsche Klasse, um den Gegenstand zu benutzen!"
#: AllTexts/Text.amb/Messages/243.txt
msgctxt "AllTexts/Text.amb/Messages/243"
msgid "~INVN~ has the wrong class to use this item!"
msgstr "~INVN~ ne possede pas la classe requise pour pouvoir utiliser cet objet!"

#. User interface: Messages.
#. German: "Du befindest Dich am falschen Ort, um diesen Gegenstand zu benutzen!"
#: AllTexts/Text.amb/Messages/244.txt
msgctxt "AllTexts/Text.amb/Messages/244"
msgid "You are in the wrong place to use this item!"
msgstr "Vous etes au mauvais endroit pour utiliser cet objet!"

#. User interface: Messages.
#. German: "Dieser Gegenstand kann nicht in dieser Welt benutzt werden!"
#: AllTexts/Text.amb/Messages/245.txt
msgctxt "AllTexts/Text.amb/Messages/245"
msgid "You cannot use this item in this world!"
msgstr "Vous ne pouvez pas utiliser cet objet dans ce monde!"

#. User interface: Messages.
#. German: " hat den Spruch abgewehrt!"
#: AllTexts/Text.amb/Messages/246.txt
msgctxt "AllTexts/Text.amb/Messages/246"
msgid " has deflected the spell!"
msgstr " a devie le sort!"

#. User interface: Messages.
#. German: " ist gegen diesen Spruchtyp immun!"
#: AllTexts/Text.amb/Messages/247.txt
msgctxt "AllTexts/Text.amb/Messages/247"
msgid " is immune to this spell type!"
msgstr " est immunise contre ce type de sort!"

#. User interface: Messages.
#. German: "Der Zauber ist misslungen."
#: AllTexts/Text.amb/Messages/248.txt
msgctxt "AllTexts/Text.amb/Messages/248"
msgid "The spell failed."
msgstr "Le sort a echoue."

#. User interface: Messages.
#. Placeholders: ~SUBJ~ = the party member the text is about. The gender of these persons is unknown.
#. German: "~SUBJ~ ist nicht tot!"
#: AllTexts/Text.amb/Messages/249.txt
msgctxt "AllTexts/Text.amb/Messages/249"
msgid "~SUBJ~ is not dead!"
msgstr "~SUBJ~ n'est pas mort!"

#. User interface: Messages.
#. Placeholders: ~SUBJ~ = the party member the text is about. The gender of these persons is unknown.
#. German: "~SUBJ~ kann nicht wiederbelebt werden!"
#: AllTexts/Text.amb/Messages/250.txt
msgctxt "AllTexts/Text.amb/Messages/250"
msgid "~SUBJ~ cannot be resurrected!"
msgstr "~SUBJ~ ne peut pas ressusciter!"

#. User interface: Messages.
#. Placeholders: ~SUBJ~ = the party member the text is about. The gender of these persons is unknown.
#. German: "~SUBJ~ ist nicht zu Asche zerfallen!"
#: AllTexts/Text.amb/Messages/251.txt
msgctxt "AllTexts/Text.amb/Messages/251"
msgid "~SUBJ~ is not ash!"
msgstr "~SUBJ~ n'est pas en cendre!"

#. User interface: Messages.
#. Placeholders: ~SUBJ~ = the party member the text is about. The gender of these persons is unknown.
#. German: "~SUBJ~ ist nicht zu Staub zerfallen!"
#: AllTexts/Text.amb/Messages/252.txt
msgctxt "AllTexts/Text.amb/Messages/252"
msgid "~SUBJ~ is not dust!"
msgstr "~SUBJ~ n'est pas en poussiere!"

#. User interface: Messages.
#. Placeholders: ~SUBJ~ = the party member the text is about. The gender of these persons is unknown.
#. German: "~SUBJ~'s Asche ist zu einer Leiche geworden!"
#: AllTexts/Text.amb/Messages/253.txt
msgctxt "AllTexts/Text.amb/Messages/253"
msgid "~SUBJ~'s ashes have been changed to a body!"
msgstr "Les cendres de ~SUBJ~ se sont transformees en un corps!"

#. User interface: Messages.
#. Placeholders: ~SUBJ~ = the party member the text is about. The gender of these persons is unknown.
#. German: "~SUBJ~'s Staub ist zu Asche geworden!"
#: AllTexts/Text.amb/Messages/254.txt
msgctxt "AllTexts/Text.amb/Messages/254"
msgid "~SUBJ~'s dust has been changed to ashes!"
msgstr "La poussiere de ~SUBJ~ a ete changee en cendres!"

#. User interface: Messages.
#. Placeholders: ~SUBJ~ = the party member the text is about. The gender of these persons is unknown.
#. German: "~SUBJ~'s Asche zerfällt zu Staub!"
#: AllTexts/Text.amb/Messages/255.txt
msgctxt "AllTexts/Text.amb/Messages/255"
msgid "~SUBJ~'s ashes fall to dust!"
msgstr "Les cendres de ~SUBJ~ tombent en poussiere!"

#. User interface: Messages.
#. Placeholders: ~SUBJ~ = the party member the text is about. The gender of these persons is unknown.
#. German: "~SUBJ~'s Leiche geht in Flammen auf und hinterlässt ein Aschehäuflein!"
#: AllTexts/Text.amb/Messages/256.txt
msgctxt "AllTexts/Text.amb/Messages/256"
msgid "~SUBJ~'s body burns up, leaving a small heap of ashes!"
msgstr "Le corps de ~SUBJ~ brule, en laissant un petit tas de cendres!"

#. User interface: Messages.
#. German: "Dieser Gegenstand ist bereits voller magischer Energie!"
#: AllTexts/Text.amb/Messages/257.txt
msgctxt "AllTexts/Text.amb/Messages/257"
msgid "This item is already fully charged with magical energy!"
msgstr "Cet objet est deja entierement charge d'energie magique!"

#. User interface: Messages.
#. German: "Dieser Spruch kann nur in Städten und Dungeons angewandt werden!"
#: AllTexts/Text.amb/Messages/258.txt
msgctxt "AllTexts/Text.amb/Messages/258"
msgid "You can only use this spell in cities or dungeons!"
msgstr "Vous ne pouvez utiliser ce sort que dans les villes ou les donjons!"

#. User interface: Messages.
#. Placeholders: ~CAST~ = the caster of a spell. The gender of these persons is unknown.
#. German: "~CAST~ markiert auf magischem Wege die augenblickliche Position."
#: AllTexts/Text.amb/Messages/259.txt
msgctxt "AllTexts/Text.amb/Messages/259"
msgid "~CAST~ magically marks this position."
msgstr "~CAST~ marque magiquement cette position."

#. User interface: Messages.
#. German: "Ihr kehrt zu der markierten Position zurück."
#: AllTexts/Text.amb/Messages/260.txt
msgctxt "AllTexts/Text.amb/Messages/260"
msgid "You return to the position you marked before."
msgstr "Vous revenez a la position que vous aviez marque precedemment."

#. User interface: Messages.
#. Placeholders: ~CAST~ = the caster of a spell. The gender of these persons is unknown.
#. German: "~CAST~ hat keine Position markiert!"
#: AllTexts/Text.amb/Messages/261.txt
msgctxt "AllTexts/Text.amb/Messages/261"
msgid "~CAST~ hasn't marked a position!"
msgstr "~CAST~ n'a pas marque de position!"

#. User interface: Messages.
#. German: "Versteinerte Monster können nicht verletzt werden!"
#: AllTexts/Text.amb/Messages/262.txt
msgctxt "AllTexts/Text.amb/Messages/262"
msgid "You cannot damage petrified monsters!"
msgstr "Vous ne pouvez pas faire de degats sur des monstres petrifies!"

#. User interface: Messages.
#. German: " ist gegen diesen Spruch immun!"
#: AllTexts/Text.amb/Messages/263.txt
msgctxt "AllTexts/Text.amb/Messages/263"
msgid " is immune to this spell!"
msgstr " est immunise contre ce sort!"

#. User interface: Messages.
#. German: "Dies ist kein magischer Gegenstand."
#: AllTexts/Text.amb/Messages/264.txt
msgctxt "AllTexts/Text.amb/Messages/264"
msgid "This is not a magical item."
msgstr "Ceci n'est pas un objet magique."

#. User interface: Messages.
#. German: "Dieser Gegenstand hat keine magischen Ladungen mehr."
#: AllTexts/Text.amb/Messages/265.txt
msgctxt "AllTexts/Text.amb/Messages/265"
msgid "This item has no charges left."
msgstr "Cet objet n'a plus aucune charge restante."

#. User interface: Messages.
#. German: "Wohin transportieren?"
#: AllTexts/Text.amb/Messages/266.txt
msgctxt "AllTexts/Text.amb/Messages/266"
msgid "Where do you want to blink to?"
msgstr "Ou voulez-vous vous rendre invisible?"

#. User interface: Messages.
#. German: " ist transportiert worden!"
#: AllTexts/Text.amb/Messages/267.txt
msgctxt "AllTexts/Text.amb/Messages/267"
msgid " has been blinked!"
msgstr " a ete rendu invisible!"

#. User interface: Messages.
#. German: " kann nicht transportiert werden!"
#: AllTexts/Text.amb/Messages/268.txt
msgctxt "AllTexts/Text.amb/Messages/268"
msgid " cannot be blinked!"
msgstr " ne peut etre invisible!"

#. User interface: Messages.
#. German: "Dieser Gegenstand lässt sich nicht duplizieren."
#: AllTexts/Text.amb/Messages/269.txt
msgctxt "AllTexts/Text.amb/Messages/269"
msgid "This item cannot be duplicated."
msgstr "Cet objet ne peut pas etre duplique."

#. User interface: Messages.
#. German: "Man kann hier an nichts hochklettern."
#: AllTexts/Text.amb/Messages/270.txt
msgctxt "AllTexts/Text.amb/Messages/270"
msgid "You cannot climb up here."
msgstr "Vous ne pouvez pas monter ici."

#. User interface: Messages.
#. German: "Dieser Gegenstand ist nicht gebrochen!"
#: AllTexts/Text.amb/Messages/271.txt
msgctxt "AllTexts/Text.amb/Messages/271"
msgid "This item isn't broken!"
msgstr "Cet objet n'est pas brise!"

#. User interface: Messages.
#. German: "Es gibt keinen Platz mehr für den neuen Gegenstand."
#: AllTexts/Text.amb/Messages/272.txt
msgctxt "AllTexts/Text.amb/Messages/272"
msgid "There was no more room for the item."
msgstr "Il n'y avait plus de place pour cet objet."

#. User interface: Messages.
#. German: "Es gibt keine verfluchten Gegenstände."
#: AllTexts/Text.amb/Messages/273.txt
msgctxt "AllTexts/Text.amb/Messages/273"
msgid "No cursed items were found."
msgstr "Aucun objet maudit n'a ete trouve."

#. User interface: Messages.
#. German: "Wie soll ich etwas reparieren, das einwandfrei in Ordnung ist?"
#: AllTexts/Text.amb/Messages/274.txt
msgctxt "AllTexts/Text.amb/Messages/274"
msgid "If it ain't broke, don't fix it!"
msgstr "Si c'est pas casse, faut pas le reparer!"

#. User interface: Messages.
#. German: "Die Reperatur kostet "
#: AllTexts/Text.amb/Messages/275.txt
msgctxt "AllTexts/Text.amb/Messages/275"
msgid "I will repair this item for "
msgstr "Je reparerai cet objet pour "

#. User interface: Messages.
#. Placeholders: ~CAST~ = the caster of a spell. The gender of these persons is unknown.
#. German: "Störungen im magischen Äther verhindern, dass ~CAST~ eine klare Vision bekommt."
#: AllTexts/Text.amb/Messages/276.txt
msgctxt "AllTexts/Text.amb/Messages/276"
msgid "Magical disturbances prevent ~CAST~ from getting a clear view."
msgstr "Des perturbations magiques empechent ~CAST~ d'avoir une vision claire."

#. User interface: Messages.
#. German: "Akzeptieren Sie diesen Charakter?"
#: AllTexts/Text.amb/Messages/277.txt
msgctxt "AllTexts/Text.amb/Messages/277"
msgid "Are you happy with this character?"
msgstr "Etes-vous satisfait de ce personnage?"

#. User interface: Messages.
#. German: "Du kennst noch keine Zaubersprüche."
#: AllTexts/Text.amb/Messages/278.txt
msgctxt "AllTexts/Text.amb/Messages/278"
msgid "You don't know any spells yet."
msgstr "Vous ne connaissez encore aucun sort."

#. User interface: Messages.
#. German: " hat Glück und entkommt der Falle!"
#: AllTexts/Text.amb/Messages/279.txt
msgctxt "AllTexts/Text.amb/Messages/279"
msgid " is lucky and escapes the trap!"
msgstr " a de la chance et esquive le piege!"

#. User interface: Messages.
#. German: "Du bist zu einer Parade nicht in der Lage."
#: AllTexts/Text.amb/Messages/280.txt
msgctxt "AllTexts/Text.amb/Messages/280"
msgid "You are incapable of parrying."
msgstr "Vous etes incapable de parer."

#. User interface: Messages.
#. German: "Ich wünsche wohl zu ruhen!"
#: AllTexts/Text.amb/Messages/281.txt
msgctxt "AllTexts/Text.amb/Messages/281"
msgid "I wish you a good night's stay."
msgstr "Je vous souhaite une agreable nuitee."

#. User interface: Messages.
#. German: "Der Gegenstand bewirkt hier nichts."
#: AllTexts/Text.amb/Messages/282.txt
msgctxt "AllTexts/Text.amb/Messages/282"
msgid "This item cannot be used here."
msgstr "Cet objet ne peut pas etre utilise ici."

#. User interface: Messages.
#. German: "Ihr müsst zu Fuß unterwegs sein, um einen Riesenadler zu rufen."
#: AllTexts/Text.amb/Messages/283.txt
msgctxt "AllTexts/Text.amb/Messages/283"
msgid "You must be on foot to call a giant eagle."
msgstr "Vous devez etre a pied pour appeler un aigle geant."

#. User interface: Messages.
#. German: "Wer ist die Zielperson?"
#: AllTexts/Text.amb/Messages/284.txt
msgctxt "AllTexts/Text.amb/Messages/284"
msgid "Use it on whom?"
msgstr "Utiliser ceci sur qui?"

#. User interface: Messages.
#. German: "Daran bin ich nicht interessiert."
#: AllTexts/Text.amb/Messages/285.txt
msgctxt "AllTexts/Text.amb/Messages/285"
msgid "I am not interested in this trinket."
msgstr "Je ne suis pas interesse par ce bibelot."

#. User interface: Messages.
#. Placeholders: ~SUBJ~ = the party member the text is about; ~SEX2~ = his/her of ~SUBJ~. The gender of these persons is unknown.
#. German: "~SUBJ~ erlaubt keinen Blick in ~SEX2~ Besitztümer."
#: AllTexts/Text.amb/Messages/286.txt
msgctxt "AllTexts/Text.amb/Messages/286"
msgid "~SUBJ~ does not allow you to look in ~SEX2~ backpack."
msgstr "~SUBJ~ ne vous permet pas de regarder dans le sac a dos de ~SEX2~."

#. User interface: Messages.
#. German: "Möchtet Ihr diese Gegenstände nicht mitnehmen?"
#: AllTexts/Text.amb/Messages/287.txt
msgctxt "AllTexts/Text.amb/Messages/287"
msgid "Don't you want to take these items with you?"
msgstr "Ne voulez-vous pas prendre ces objets avec vous?"

#. User interface: Messages.
#. German: "Ein Angreifer ist der Nähe! Warten wäre jetzt nicht sehr empfehlenswert!"
#: AllTexts/Text.amb/Messages/288.txt
msgctxt "AllTexts/Text.amb/Messages/288"
msgid "A monster is in the vicinity! Waiting is not recommended!"
msgstr "Il y a un ou des monstres dans les environs! Attendre n'est pas recommande!"

#. User interface: Messages.
#. German: "Störungen im magischen Äther verhindern, dass der Kartenzeichner verwendet werden kann."
#: AllTexts/Text.amb/Messages/289.txt
msgctxt "AllTexts/Text.amb/Messages/289"
msgid "Magical disturbances render the automapper useless."
msgstr "Des perturbations magiques rendent l'automapper inutile."

#. User interface: Messages.
#. Placeholders: ~LEAD~ = the active party member; ~SEX1~ = he/she of ~SUBJ~. The gender of these persons is unknown.
#. German: "Dunkelheit umgibt ~LEAD~`s schmerzgepeinigte Sinne bevor ~SEX1~ als letztes Mitglied der Gruppe in die Ewigkeit von Bala`s Reich eintritt. Ist dies das Ende aller Abenteuer?"
#: AllTexts/Text.amb/Messages/290.txt
msgctxt "AllTexts/Text.amb/Messages/290"
msgid "Darkness embraces ~LEAD~`s pain-filled senses before ~SEX1~ enters Bala's realm as the last member of the party. Is this the end of all adventures?"
msgstr "Les tenebres enlassent les sens emplis de douleur de ~LEAD~ avant qu'~SEX1~ entre dans le royaume de Bala en tant que dernier membre du groupe. Est-ce la fin de toutes les aventures?"

#. User interface: Messages.
#. German: "Möchten Sie einen Spielstand laden oder das Spiel verlassen?"
#: AllTexts/Text.amb/Messages/291.txt
msgctxt "AllTexts/Text.amb/Messages/291"
msgid "Do you want to load a saved game or quit the game?"
msgstr "Voulez-vous charger une partie sauvee ou bien quitter le jeu?"

#. User interface: Messages.
#. German: "Da noch keine Spielstände gespeichert wurden, können Sie lediglich den Startspielstand laden.^Soll der Startspielstand geladen werden?"
#: AllTexts/Text.amb/Messages/292.txt
msgctxt "AllTexts/Text.amb/Messages/292"
msgid "Because no games were saved yet, you can only load the initial saved game.^Is this alright ?"
msgstr "Parce qu'aucune partie n'a encore ete sauvee, vous ne pouvez que charger la sauvegarde initiale.^Est-ce d'accord ?"

#. User interface: Messages.
#. German: "Spielstände nicht löschen?"
#: AllTexts/Text.amb/Messages/293.txt
msgctxt "AllTexts/Text.amb/Messages/293"
msgid "Don't delete saved games?"
msgstr "Ne pas effacer les parties sauvees?"

#. User interface: Messages.
#: AllTexts/Text.amb/Messages/294.txt
msgctxt "AllTexts/Text.amb/Messages/294"
msgid "Turn on, tune in and drop out."
msgstr "Allumer, regler et envoyer."

