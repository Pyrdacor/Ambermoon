#: AllTexts/Text.amb/ItemTypeNames/019.txt
msgctxt "AllTexts/Text.amb/ItemTypeNames/019"
msgid "Transportation"
msgstr "Transport"

#. User interface: LanguageNames.
#. German: "Mensch"
#: AllTexts/Text.amb/LanguageNames/000.txt
