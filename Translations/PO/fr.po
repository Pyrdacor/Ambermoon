msgstr ""

#. Remake text (Tutorial texts). Translate only the text; keep {0} placeholders and ^ line breaks.
#: Remake/Tutorial texts/002
msgctxt "Remake/Tutorial texts/002"
msgid "the game. If you are on the main screen you can toggle the buttons by pressing the "
msgstr ""

#. Remake text (Tutorial texts). Translate only the text; keep {0} placeholders and ^ line breaks.
#: Remake/Tutorial texts/003
msgctxt "Remake/Tutorial texts/003"
msgid "right mouse button while hovering the area or hitting the Return key. It will unlock "
msgstr ""

#. Remake text (Tutorial texts). Translate only the text; keep {0} placeholders and ^ line breaks.
#: Remake/Tutorial texts/004
msgctxt "Remake/Tutorial texts/004"
msgid "additional functions."
msgstr ""

#. Remake text (Tutorial texts). Translate only the text; keep {0} placeholders and ^ line breaks.
#: Remake/Tutorial texts/005
msgctxt "Remake/Tutorial texts/005"
msgid "You can also use the NumPad on your keyboard to control those buttons. The layout "
msgstr ""

#. Remake text (Tutorial texts). Translate only the text; keep {0} placeholders and ^ line breaks.
#: Remake/Tutorial texts/006
msgctxt "Remake/Tutorial texts/006"
msgid "is exactly as the in-game buttons. So hitting the key 7 will be equivalent to pressing "
msgstr ""

#. Remake text (Tutorial texts). Translate only the text; keep {0} placeholders and ^ line breaks.
#: Remake/Tutorial texts/007
msgctxt "Remake/Tutorial texts/007"
msgid "the upper left button (the eye)."
msgstr ""

#. Remake text (Tutorial texts). Translate only the text; keep {0} placeholders and ^ line breaks.
#: Remake/Tutorial texts/008
msgctxt "Remake/Tutorial texts/008"
msgid "In the upper area you see the character portraits. You can click on them to select the "
msgstr ""

#. Remake text (Tutorial texts). Translate only the text; keep {0} placeholders and ^ line breaks.
#: Remake/Tutorial texts/009
msgctxt "Remake/Tutorial texts/009"
msgid "active player or right click them to open the inventories. The keyboard keys 1-6 will select "
msgstr ""

#. Remake text (Tutorial texts). Translate only the text; keep {0} placeholders and ^ line breaks.
#: Remake/Tutorial texts/010
msgctxt "Remake/Tutorial texts/010"
msgid "a player as well and keys F1-F6 will open the inventories."
msgstr ""

#. Remake text (Tutorial texts). Translate only the text; keep {0} placeholders and ^ line breaks.
#: Remake/Tutorial texts/011
msgctxt "Remake/Tutorial texts/011"
msgid "You can move on maps by using the mouse, keys W, A, S, D or the cursor keys. In 2D you can "
msgstr ""

#. Remake text (Tutorial texts). Translate only the text; keep {0} placeholders and ^ line breaks.
#: Remake/Tutorial texts/012
msgctxt "Remake/Tutorial texts/012"
msgid "right click on the map to change the cursor into an action cursor to interact with objects "
msgstr ""

#. Remake text (Tutorial texts). Translate only the text; keep {0} placeholders and ^ line breaks.
#: Remake/Tutorial texts/013
msgctxt "Remake/Tutorial texts/013"
msgid "or characters like NPCs."
msgstr ""

#. Remake text (Tutorial texts). Translate only the text; keep {0} placeholders and ^ line breaks.
#: Remake/Tutorial texts/014
msgctxt "Remake/Tutorial texts/014"
msgid "Now I'm quiet. Have fun playing Ambermoon!"
msgstr ""

