/// The byte of ISO-8859-1 for a character above U+00FF: its best-fit replacement, else '?'.
uint8 Latin1BestFit(int codePoint)
{
    int low = 0;
    int high = _BestFitCharacters.Length - 1;
    while (low <= high)
    {
        int middle = (low + high) / 2;
        if (codePoint < _BestFitCharacters[middle])
            high = middle - 1;
        else if (codePoint > _BestFitCharacters[middle])
            low = middle + 1;
        else
            return _BestFitBytes[middle];
    }
    return (uint8)'?';
}
