// the byte of a character in a code page of the tables above; -1 if the code page has no table
int _CodePageByte(int codePage, int character)
{
    switch (codePage)
    {
        case 437: return _Lookup(_CodePage437Characters, _CodePage437Bytes, character);
        case 850: return _Lookup(_CodePage850Characters, _CodePage850Bytes, character);
        case 852: return _Lookup(_CodePage852Characters, _CodePage852Bytes, character);
        case 866: return _Lookup(_CodePage866Characters, _CodePage866Bytes, character);
        case 1250: return _Lookup(_CodePage1250Characters, _CodePage1250Bytes, character);
        case 1251: return _Lookup(_CodePage1251Characters, _CodePage1251Bytes, character);
        case 1252: return _Lookup(_CodePage1252Characters, _CodePage1252Bytes, character);
        case 28592: return _Lookup(_CodePage28592Characters, _CodePage28592Bytes, character);
        case 28605: return _Lookup(_CodePage28605Characters, _CodePage28605Bytes, character);
        default: return -1;
    }
}

int _Lookup(ReadOnlySlice<uint16> characters, ReadOnlySlice<uint8> bytes, int character)
{
    int low = 0;
    int high = characters.Length - 1;
    while (low <= high)
    {
        int middle = (low + high) / 2;
        if (character < characters[middle])
            high = middle - 1;
        else if (character > characters[middle])
            low = middle + 1;
        else
            return bytes[middle];
    }
    return '?';
}
